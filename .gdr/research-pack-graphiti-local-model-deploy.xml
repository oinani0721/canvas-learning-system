    @property
    def vault_id(self) -> str:
        """Story 1.9 + Phase B0.4 (Round-5 路径 A): Derive vault_id.

        Priority order (Round-5 A2):
        1. .canvas-config.yaml `vault_id` field (explicit, schema_version >= 2.0)
