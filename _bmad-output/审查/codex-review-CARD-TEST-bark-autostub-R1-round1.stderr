   210	
   211	def _legacy_text_judge(rc: int, out: str) -> bool:
   212	    """第八批 (HEAD 2cacbb0c) 的文本判据, 逐行重写用于对照。
   213	
   214	    摘要唯一性 + 形态 + `^E ...$` 整行锚定 + 「E 行前 1500 字符窗口含
   215	    conftest.py」。它判 True 而 R1 判 FAIL, 就是 (e) 关掉的那条通路。"""
   216	    summaries = [m.group(1) for line in out.splitlines() if (m := re.match(_LEGACY_SUMMARY, line.strip()))]
   217	    shape_ok = (
   218	        len(summaries) == 1
   219	        and re.fullmatch(r"1 failed(, \d+ warnings?)?", summaries[0]) is not None
   220	        and " no tests ran" not in out
   221	        and "= ERRORS =" not in out
   222	    )
   223	    m = re.search(_LEGACY_PATTERN, out, re.MULTILINE)
   224	    regex_ok = m is not None
   225	    src_ok = bool(m) and _LEGACY_SRC_HINT in out[max(0, m.start() - 1500) : m.start()]
   226	    return rc == 1 and shape_ok and regex_ok and src_ok
