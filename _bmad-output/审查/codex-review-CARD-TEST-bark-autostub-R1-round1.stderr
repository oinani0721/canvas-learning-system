     2	"""(c) 门: 冷启动 + teardown 之后 send_bark.KEY_FILE 不得残留失效临时路径。
     3	
     4	判据必须在 fixture teardown **之后**看, 所以不能写成一条 pytest 测试 ——
     5	本脚本在一个全新解释器里:
     6	  1. 先确认 send_bark 尚未加载 (冷启动前提, 否则整条判据空转);
     7	  2. 在进程内跑 `bark_coldstart_probe::test_coldstart_keyfile_redirected`
     8	     (该探针模块顶层不 import scripts, 守卫那次 import 才是本进程首次加载);
     9	  3. 该跑必须绿 —— 绿了才证明冷启动分支真的被走到;
    10	  4. 然后直接读 sys.modules["send_bark"].KEY_FILE, 要求它等于本进程的真实
    11	     默认值, 且不带守卫 tmp 目录痕迹、不指向已消失的目录。
    12	
    13	背景 (为什么这道门不是多余的): round-3 提的「冷启动残留」在第八批被改成
    14	「先手动复位真实默认再打桩」, 但复位值是在 `patcher.setenv("BARK_KEY_FILE",
    15	tmp)` **之后**读 `os.environ["BARK_KEY_FILE"]` 拿的 —— 读到的就是 tmp 路径
    16	本身, 复位退化成原地赋值, MonkeyPatch 记下的「原值」仍是 tmp。形态对、语义
    17	空转, 而当时没有任何门能发现。本脚本就是那道门。
    18	
    19	全程只比较路径字符串, 从不读取真实 key 文件内容。
    20	"""
    21	
    22	import os
    23	import sys
    24	from pathlib import Path
    25	
    26	OK = "BARK-KEYFILE-RESIDUE: OK"
    27	BAD = "BARK-KEYFILE-RESIDUE: RESIDUE"
    28	NODEID = "tests/regression/bark_coldstart_probe.py::test_coldstart_keyfile_redirected"
    29	
    30	
    31	def main() -> int:
    32	    backend = Path(__file__).resolve().parents[1]
    33	    os.chdir(backend)
    34	    if "send_bark" in sys.modules:
    35	        print(f"{BAD} 冷启动前提破坏: 进入本脚本时 send_bark 已加载")
    36	        return 1
    37	
    38	    env_before = os.environ.get("BARK_KEY_FILE")
    39	    expected = Path(env_before or Path.home() / ".config" / "canvas-review" / "bark.key")
    40	
    41	    import pytest
    42	
    43	    rc = pytest.main(["-p", "no:cacheprovider", "-q", NODEID])
    44	    if int(rc) != 0:
    45	        print(f"{BAD} 布防跑未绿 (pytest rc={int(rc)}) — 冷启动分支未被证明走到, 残留判据无意义")
    46	        return 1
    47	
    48	    send_bark = sys.modules.get("send_bark")
    49	    if send_bark is None:
    50	        print(f"{BAD} send_bark 未进入 sys.modules — 守卫并没有真的 import 它")
    51	        return 1
    52	
    53	    kf = Path(send_bark.KEY_FILE)
    54	    problems = []
    55	    if kf != expected:
    56	        problems.append(f"KEY_FILE={kf} 不等于本进程真实默认 {expected}")
    57	    if "bark-guard-" in str(kf):
    58	        problems.append("KEY_FILE 仍带守卫 tmp 目录痕迹 (bark-guard-*)")
    59	    if not kf.parent.is_dir():
    60	        problems.append(f"KEY_FILE 的父目录已不存在 ({kf.parent}) — 典型的已删 tmp 残留")
    61	    if os.environ.get("BARK_KEY_FILE") != env_before:
    62	        problems.append(f"env BARK_KEY_FILE 未恢复 (现 {os.environ.get('BARK_KEY_FILE')!r}, 原 {env_before!r})")
    63	
    64	    if problems:
    65	        for p in problems:
    66	            print(f"{BAD} {p}")
    67	        return 1
    68	    print(f"{OK} KEY_FILE={kf} (= 真实默认, 无 tmp 残留, env 已恢复)")
    69	    return 0
