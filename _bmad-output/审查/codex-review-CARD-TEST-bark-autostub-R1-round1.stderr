    30	KEY_FILE = Path(
    31	    os.environ.get("BARK_KEY_FILE")
    32	    or Path.home() / ".config" / "canvas-review" / "bark.key"
    33	)
    34	DEFAULT_SERVER = "https://api.day.app"
    35	TIMEOUT_S = 10
    36	RETRIES = 2
    37	
    38	#: 唯一网络出口缝 (CARD-TEST-bark-autostub): 生产路径常规行为不变;
    39	#: 唯一可观察差异 = import 后对 urllib.request.urlopen 的重绑不再被观察
    40	_urlopen = urllib.request.urlopen
    41	
    42	
    43	#: hash 域后缀形态 — 用于把「原样域」与「hash 域」分开, 保证两域不重叠
    44	_HASH_TAIL = re.compile(r"-[0-9a-f]{16}$")
    45	#: key 主体安全上限 (Codex-C1a HIGH: NAME_MAX=255, 232 字节合法目录名会让
    46	#: daily-review.<key>.state.json 超限; 100 + 1 + 16 + 前后缀 ≪ 255)
    47	_KEY_MAX_BYTES = 100
    48	
    49	
    50	def vault_key(vault_id: str) -> str:
    51	    """vault 目录名 → 文件名/通知 id 安全 key (CARD-C1a 命名空间规则唯一定义点)。
    52	
    53	    两域设计 (Codex-C1a B2/H1 处置):
    54	      原样域 — ASCII 短名 (canvas-vault) 原样返回; 但排除恰好长得像 hash 域
    55	               后缀 (-<16hex> 结尾) 的名字与超长名;
    56	      hash 域 — 其余 (中文库名 / 超长名 / 撞后缀形态) slug 化并追加 sha256
    57	               前 16 hex (64 bit — 8 hex 时 2^16 生日构造即可撞, 已实测)。
    58	    两域互不重叠 → 不同目录名撞 key 只剩 64bit hash 碰撞一条路。state 文件名
    59	    (daily_review_run.state_path) / push.sh 锁 / Bark 有效 id 共用本函数,
    60	    同一 vault 三处 key 恒等 (push.sh 经 python 调用本函数, 不再 basename)。
    61	    """
    62	    # 目录名按字面精确处理, 不裁剪空白 — str.strip() 会吞 Unicode 空白,
    63	    # 令 "foo" 与 "foo\xa0" 两个不同目录名撞 key (Codex-C1a round2 实测)
    64	    raw = str(vault_id or "").rstrip("/").rsplit("/", 1)[-1] or "vault"
    65	    safe = re.sub(r"[^0-9A-Za-z._-]", "-", raw).strip("-.")
    66	    if (safe == raw and not _HASH_TAIL.search(raw)
    67	            and len(raw.encode("utf-8")) <= _KEY_MAX_BYTES):
    68	        return safe
    69	    digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]
    70	    return f"{(safe or 'vault')[:_KEY_MAX_BYTES]}-{digest}"
    71	
    72	
    73	def load_key() -> tuple[str, str] | None:
    74	    """读 key 文件 → (server, device_key)。兼容整段 URL 或裸 key。
    75	
    76	    Code-Review L4: 格式不合法 (贴了裸域名/空串) 按未配置处理并给具体
    77	    提示, 不进重试循环报误导性的 net= 错误。
    78	    """
    79	    if not KEY_FILE.exists():
    80	        print("bark skip(未配置) — 写入 ~/.config/canvas-review/bark.key 后启用")
    81	        return None
    82	    raw = KEY_FILE.read_text(encoding="utf-8").strip().rstrip("/")
    83	    if raw.startswith("http"):
    84	        server, _, key = raw.rpartition("/")
    85	    else:
    86	        server, key = DEFAULT_SERVER, raw
    87	    if not re.fullmatch(r"[A-Za-z0-9_-]{8,64}", key) or not server.startswith("http"):
    88	        print("bark skip(key格式不合法 — 应为 Bark app 复制的推送 key)")
    89	        return None
    90	    return (server, key)
    91	
    92	
    93	def send(notification: dict, vault_id: str | None = None) -> int:
    94	    cfg = load_key()
    95	    if cfg is None:
    96	        return 2
    97	    server, device_key = cfg
    98	    noti_id = notification["id"]
    99	    group = notification.get("group", "canvas复习")
   100	    if vault_id:
   101	        # CARD-C1a: vault 维度只在 send 侧组合 — payload.notification.id 的值
   102	        # 是 A2 冻结契约不可改; 有效去重 id / 分组在这里追加 vault, 防第二
   103	        # vault 同日同 id 覆盖第一 vault 的手机通知。vault_id 缺省 (旧 payload)
   104	        # 走原样 id, 加性兼容。
   105	        noti_id = f"{noti_id}-{vault_key(vault_id)}"
   106	        group = f"{group}·{vault_id}"
   107	    body = json.dumps(
   108	        {
   109	            "device_key": device_key,
   110	            "title": notification["title"],
   111	            "body": notification["body"],
   112	            "group": group,
   113	            "id": noti_id,
   114	        },
   115	        ensure_ascii=False,
   116	    ).encode("utf-8")
   117	
   118	    last_err = "unknown"
   119	    for attempt in range(1 + RETRIES):
   120	        if attempt:
   121	            time.sleep(2 * attempt)
   122	        req = urllib.request.Request(
   123	            f"{server}/push", data=body,
   124	            headers={"Content-Type": "application/json; charset=utf-8"},
   125	            method="POST",
   126	        )
   127	        try:
   128	            with _urlopen(req, timeout=TIMEOUT_S) as resp:
   129	                http = resp.status
   130	                try:
   131	                    code = json.loads(resp.read().decode("utf-8")).get("code")
   132	                except (json.JSONDecodeError, UnicodeDecodeError):
   133	                    code = None
   134	            if http == 200 and code == 200:
   135	                print(f"bark accepted http={http} code={code}")
   136	                return 0
   137	            last_err = f"http={http} code={code}"
   138	        except urllib.error.HTTPError as e:
   139	            last_err = f"http={e.code}"
   140	        except (urllib.error.URLError, TimeoutError, OSError) as e:
   141	            last_err = f"net={type(e).__name__}"
   142	    print(f"bark failed {last_err}")  # 永不打印 key/URL
   143	    return 1
   144	
   145	
   146	def main():
   147	    ap = argparse.ArgumentParser(description="Bark 推送 (payload 不进命令行)")
   148	    ap.add_argument("--payload", required=True, help="今日复习.json 路径")
   149	    args = ap.parse_args()
   150	    payload = json.loads(Path(args.payload).read_text(encoding="utf-8"))
   151	    noti = payload.get("notification")
   152	    if not noti:
   153	        print("bark skip(无可推内容)")
   154	        return 2
   155	    return send(noti, payload.get("vault_id"))
   156	
   157	
   158	if __name__ == "__main__":
   159	    sys.exit(main())

