    51	#: 守卫会碰的进程级全局 —— 用于「布防前 vs 全部 teardown 后」的还原对账。
    52	#: 只用 __module__/__qualname__ 与代理配置这类**结构指纹**, 不用 id():
    53	#: 对象回收后 id 可能被复用, 拿它当相等判据是自证 (看起来还原了)。
    54	_PROXY_ENV_KEYS = (
    55	    "http_proxy",
    56	    "https_proxy",
    57	    "ftp_proxy",
    58	    "all_proxy",
    59	    "no_proxy",
    60	    "HTTP_PROXY",
    61	    "HTTPS_PROXY",
    62	    "FTP_PROXY",
    63	    "ALL_PROXY",
    64	    "NO_PROXY",
    65	    "BARK_KEY_FILE",
    66	)
    67	
    68	
    69	def _fn_id(fn):
    70	    return f"{getattr(fn, '__module__', '?')}.{getattr(fn, '__qualname__', repr(fn))}"
    71	
    72	
    73	def _opener_fingerprint():
    74	    op = urllib.request._opener
    75	    if op is None:
    76	        return None
    77	    return {
    78	        "handlers": sorted(h.__class__.__name__ for h in op.handlers),
    79	        "proxies": [getattr(h, "proxies", None) for h in op.handlers if h.__class__.__name__ == "ProxyHandler"],
    80	    }
    81	
    82	
    83	def _globals_snapshot():
    84	    import importlib
    85	
    86	    snap = {
    87	        "opener": _opener_fingerprint(),
    88	        "urlopen": _fn_id(urllib.request.urlopen),
    89	        "getproxies": _fn_id(urllib.request.getproxies),
    90	        "subprocess_run": _fn_id(subprocess.run),
    91	        "importlib_reload": _fn_id(importlib.reload),
    92	        "env": {k: os.environ.get(k) for k in _PROXY_ENV_KEYS},
    93	    }
    94	    if sys.platform == "darwin":
    95	        try:
    96	            import _scproxy
    97	
    98	            snap["scproxy_get_proxies"] = _fn_id(_scproxy._get_proxies)
    99	        except ImportError:
   100	            pass
   101	    if hasattr(urllib.request, "_get_proxies"):
   102	        snap["urllib_get_proxies"] = _fn_id(urllib.request._get_proxies)
   103	    return snap
   104	
   105	
   106	def pytest_collection_finish(session):
   107	    """基线取在「所有测试模块都已 import、但一条测试都还没跑」的时刻 ——
   108	    探针模块自己的 import 期副作用 (敌对代理态) 已经在里面, 于是这条对账
   109	    问的正是「守卫把它动过的东西还回去了没有」, 而不是「进程有没有被改过」。"""
   110	    _GLOBALS["before"] = _globals_snapshot()
   111	
   112	
   113	def _fileloc(entry):
   114	    loc = getattr(entry, "reprfileloc", None)
   115	    if loc is None:
   116	        return None
   117	    return {"path": loc.path, "lineno": loc.lineno}
   118	
   119	
   120	def pytest_runtest_logreport(report):
   121	    rec = {
   122	        "nodeid": report.nodeid,
   123	        "when": report.when,
   124	        "outcome": report.outcome,
   125	    }
   126	    longrepr = getattr(report, "longrepr", None)
   127	    crash = getattr(longrepr, "reprcrash", None)
   128	    if crash is not None:
   129	        rec["crash_path"] = crash.path
   130	        rec["crash_lineno"] = crash.lineno
   131	        rec["crash_message"] = crash.message
   132	    tb = getattr(longrepr, "reprtraceback", None)
   133	    if tb is not None:
   134	        rec["frames"] = [f for f in (_fileloc(e) for e in getattr(tb, "reprentries", [])) if f]
   135	    _RECORDS.append(rec)
   136	
   137	
   138	def pytest_collectreport(report):
   139	    if report.outcome == "failed":
   140	        _RECORDS.append({"nodeid": report.nodeid, "when": "collect", "outcome": "failed"})
   141	
   142	
   143	def pytest_sessionfinish(session, exitstatus):
   144	    out = os.environ.get("BARK_NEGCTL_REPORT")
   145	    if not out:
   146	        return
   147	    with open(out, "w", encoding="utf-8") as fh:
   148	        json.dump(
   149	            {
   150	                "exitstatus": int(exitstatus),
   151	                "reports": _RECORDS,
   152	                "globals_before": _GLOBALS.get("before"),
   153	                "globals_after": _globals_snapshot(),
   154	            },
   155	            fh,
   156	            ensure_ascii=False,
   157	            indent=1,
   158	        )

