   263	def test_proxy_first_hop_stays_loopback(monkeypatch):
   264	    """F 门 (armed, 行为): 模块 import 期就已存在的敌对「已建 opener」
   265	    (ProxyHandler 指向 127.0.0.1:63128) 不得把 loopback 请求转出机 ——
   266	    首跳必须是 loopback discard 端口本身。
   267	
   268	    这是 (b) 的行为门: 判据锚 (host, port) 二元组而不是只锚 host ——
   269	    本机系统代理实测就是 127.0.0.1:1082, 与兜底目标同主机不同端口, 只比
   270	    host 会两形态同值 = 假门。
   271	    建连在 socket.create_connection 层被拦并抛 OSError, 布防/卸甲两形态
   272	    都不会真建连、不出机 (63128 也不监听)。
   273	    两段各自承重不同的层: 第一段 (已建 opener) 承重 ⑤d, 第二段 (现场新建
   274	    opener) 承重 ⑤a/⑤b/⑤c —— 变异任一层, 本门都会红在对应那一段。"""
   275	    hops = []
   276	
   277	    def _intercept(address, *a, **kw):
   278	        hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   279	        raise OSError(61, "blocked by bark_egress_probe (first-hop gate)")
   280	
   281	    monkeypatch.setattr(socket, "create_connection", _intercept)
   282	    opener = urllib.request._opener
   283	    assert opener is not None, "BARK-GATE-F-NOOPENER: _opener 为空, 前置态未建立"
   284	    try:
   285	        opener.open("http://127.0.0.1:9/push", timeout=1)
   286	    except urllib.error.URLError:
   287	        pass
   288	
   289	    assert hops, "BARK-GATE-F-NOHOP: 未观察到任何建连尝试"
   290	    assert hops[0] == ("127.0.0.1", 9), (
   291	        f"BARK-GATE-F-FIRSTHOP: 代理首跳未被中和 (首跳 {hops[0]!r}, 期望 ('127.0.0.1', 9))"
   292	    )
   293	
   294	    # 第二段: 现场新建的 opener —— 这是 `_opener is None` 时 urlopen 走的路
   295	    # (reload(urllib.request) 之后就是这个状态)。build_opener() 会在此刻读
   296	    # getproxies(), 于是这段behaviorally 覆盖的是「系统/环境代理」向量,
   297	    # 与上面「已建 opener」向量互补, 合起来才是完成条件 (b) 的两条。
   298	    fresh_hops = []
   299	
   300	    def _intercept_fresh(address, *a, **kw):
   301	        fresh_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   302	        raise OSError(61, "blocked by bark_egress_probe (fresh-opener gate)")
   303	
   304	    monkeypatch.setattr(socket, "create_connection", _intercept_fresh)
   305	    try:
   306	        urllib.request.build_opener().open("http://127.0.0.1:9/push", timeout=1)
   307	    except urllib.error.URLError:
   308	        pass
   309	
   310	    assert fresh_hops, "BARK-GATE-F-NOFRESHHOP: 新建 opener 未观察到任何建连尝试"
   311	    assert fresh_hops[0] == ("127.0.0.1", 9), (
   312	        f"BARK-GATE-F-FRESHHOP: 新建 opener 的首跳被代理接管 (首跳 {fresh_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   313	    )
   314	    _assert_no_real_egress()
