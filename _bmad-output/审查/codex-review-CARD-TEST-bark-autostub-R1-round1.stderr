   229	def _apply(mut) -> str:
   230	    path: Path = mut["file"]
   231	    original = path.read_bytes()
   232	    before = sha256(original).hexdigest()
   233	    text = original.decode("utf-8")
   234	    n = text.count(mut["old"])
   235	    if n != 1:
   236	        raise SystemExit(f"[{mut['id']}] 锚点命中 {n} 次 (必须恰好 1) — 锚点漂移, 中止")
   237	    mutated = text.replace(mut["old"], mut["new"])
   238	    if "extra_old" in mut:
   239	        n2 = mutated.count(mut["extra_old"])
   240	        if n2 != 1:
   241	            raise SystemExit(f"[{mut['id']}] 第二锚点命中 {n2} 次 (必须恰好 1) — 锚点漂移, 中止")
   242	        mutated = mutated.replace(mut["extra_old"], mut["extra_new"])
   243	    _INFLIGHT[path] = original
   244	    path.write_text(mutated, encoding="utf-8")
   245	    return before
   246	
   247	
   248	def _restore(mut, before: str) -> bool:
   249	    path: Path = mut["file"]
   250	    path.write_bytes(_INFLIGHT.pop(path))
   251	    after = sha256(path.read_bytes()).hexdigest()
   252	    same = before == after
   253	    print(f"[{mut['id']}] 还原逐字节一致: {'YES' if same else 'NO!!'} ({after})")
   254	    return same
   255	
