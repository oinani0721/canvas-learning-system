   129	def snapshot(root: Path) -> dict:
   130	    """全树取证: 每个条目 (sha256 | "dir") + st_mtime_ns + st_mode。
   131	    ⛔ 只对**不含产物**的树使用 —— 产物落在树内会让本快照自证其罪式失效。"""
   132	    out: dict[str, tuple] = {}
   133	    for p in sorted(root.rglob("*")):
   134	        st = p.lstat()
   135	        if p.is_symlink():
   136	            digest = "symlink:" + os.readlink(p)
   137	        elif p.is_dir():
   138	            digest = "dir"
   139	        else:
   140	            digest = hashlib.sha256(p.read_bytes()).hexdigest()
   141	        out[str(p.relative_to(root))] = (digest, st.st_mtime_ns, st.st_mode)
   142	    return out
