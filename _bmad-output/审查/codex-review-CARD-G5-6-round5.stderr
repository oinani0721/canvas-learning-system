   392	# ───────────────────────────── 时间 ─────────────────────────────
   393	
   394	
   395	def parse_now(raw: str) -> datetime:
   396	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   397	    try:
   398	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   399	    except ValueError as e:
   400	        raise SystemExit(
   401	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   402	        ) from e
   403	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   404	
   405	
   406	def _epoch_s(dt: datetime) -> float:
   407	    return dt.timestamp()
   408	
   409	
   410	def days_between(now_s: float, then_s: float) -> int:
   411	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   412	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   413	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   414	    return int(round(now_s - then_s)) // 86400
   415	
   416	
   417	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   418	UNREPRESENTABLE = "unrepresentable"
   419	
   420	
   421	def _fmt(sec: float, tz, pattern: str) -> str:
   422	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   423	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   424	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   425	    **不**伪造一个看似正常的时间。"""
   426	    try:
   427	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   428	    except (OverflowError, OSError, ValueError):
   429	        return UNREPRESENTABLE
   430	
   431	
   432	def fmt_utc(sec: float) -> str:
   433	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   434	
   435	
   436	def fmt_local(sec: float) -> str:
   437	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
