+
+def init(case):
+    (ROOT / case / 'vault' / '_待处理').mkdir(parents=True, exist_ok=True)
+
+for case in ('B3','H1','H2','H3','H4','REG_AI_CASE','REG_URL_ALIAS','REG_AI_NBSP','REG_ALL'):
