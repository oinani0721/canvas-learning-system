   199	
   200	def run_gate(gate: str) -> subprocess.CompletedProcess:
   201	    return subprocess.run(
   202	        [
   203	            str(WT / "backend/.venv/bin/pytest"),
   204	            f"{TESTFILE}::{gate}",
   205	            "-q",
   206	            "-p",
   207	            "no:cacheprovider",
   208	        ],
   209	        cwd=WT / "backend",
   210	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   211	        capture_output=True,
   212	        text=True,
   213	    )
   214	
   215	
   216	def main() -> int:
   217	    pristine = SCRIPT.read_bytes()
   218	    BACKUP.write_bytes(pristine)
   219	    results = []
   220	    ok = True
   221	    for name, old, new, gate in MUTATIONS:
   222	        content = SCRIPT.read_text(encoding="utf-8")
   223	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   224	        mutated = content.replace(old, new, 1)
   225	        if name.startswith("M5"):
   226	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   227	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   228	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   229	            mutated = mutated.replace(looks_old, looks_rev, 1)
   230	        assert mutated != content, f"{name}: 替换后内容未变化"
   231	        SCRIPT.write_text(mutated, encoding="utf-8")
   232	        try:
   233	            r = run_gate(gate)
   234	            out = r.stdout + r.stderr
   235	            failed_marker = f"FAILED {TESTFILE}::{gate}"
   236	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   237	            results.append((name, gate, r.returncode, killed))
   238	            if not killed:
   239	                ok = False
   240	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   241	                print(out[-1500:])
   242	        finally:
   243	            SCRIPT.write_bytes(pristine)
   244	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   245	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   246	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   247	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
   248	    print()
   249	    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
   250	          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
   251	    return 0 if ok else 1
   252	
   253	
   254	if __name__ == "__main__":
   255	    sys.exit(main())

