+ 'R99_深度调研.md': '# 调研\n\n本文由 AI 生成\n\n正文一。\n正文二。\n',
+ '英文行尾.md': '# Report\n\nGenerated by AI\n\nBody one.\nBody two.\n',
+ '英文机构.md': '# Lab\n\nGenerated by AI Lab researchers\n\nBody one.\nBody two.\n',
+ '英文真实但空格.md': '# Report\n\nGenerated by AI for internal review\n\nBody one.\nBody two.\n',
+ 'IPv6.md': '---\nsource: https://[::1]:8443/x\n---\n',
+ '大写scheme.md': '---\nsource: HTTPS://Upper.Test/x\n---\n',
+ 'IDN.md': '---\nsource: https://例え.テスト/x\n---\n',
+ '空值tags骨架.md': '---\ntags:\n---\n# 标题\n',
+ '时间戳骨架.md': '---\ncreated: 2026-01-01T00:00:00+08:00\n---\n# 标题\n',
+ '引号source.md': '---\nsource: "https://quoted.test/x"\n---\n',
+ 'tab-source.md': '---\nsource:\thttps://tab.test/x\n---\n',
+ '冒号前空格source.md': '---\nsource : https://space.test/x\n---\n',
+ '正常四反关闭.md': '````python\n\n   ```` \t\n# 标题\n',
+ '正常波浪关闭.md': '~~~~python\n\n~~~~~\n# 标题\n',
+ '纯空骨架.md': '---\ntitle: t\n---\n\n# 标题\n\n<!-- 注释 -->\n',
+ '非法source空.md': '---\nsource: https://:443/x\n---\n',
+ '未解析行空.md': '---\ntitle: t\nsource:https://x\n---\n',
+ '未闭合注释.md': '<!-- 忘记闭合\n# keep\n',
+ 'AI嫌疑空.md': '---\ngenerator: Generated by AI on March\n---\n',
+}
+for name, text in cases.items():
+    write('REG_ALL', '_待处理/' + name, text)
