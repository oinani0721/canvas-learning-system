   711	# ───────────────────────────── 扫描 ─────────────────────────────
   712	
   713	
   714	def read_text_or_none(p: Path) -> str | None:
   715	    try:
   716	        return p.read_bytes().decode("utf-8")
   717	    except (OSError, UnicodeDecodeError):
   718	        return None
   719	
   720	
   721	def scan_corpus(
   722	    vault: Path, excluded_roots: list[str]
   723	) -> tuple[dict[str, list[str]], list[tuple[str, str]], dict]:
   724	    """库内 .md 语料：→ (归一化正文 → [相对路径…], [(路径, 正文)…], 统计)。
   725	
   726	    排除：一切隐藏目录、`outputs/`、收件箱子树、产物目录子树。
   727	    ⛔ **空正文不进重复索引** —— 否则库内任意两个空骨架互为「正本」，会撑出一条
   728	    有后果的建议删，其证据是「两个都是空的」。C3 虽然先命中，但索引本身必须先干净：
   729	    门要防的是未来次序调整时的静默失效，不只是当下这一次。
   730	    """
   731	    by_body: dict[str, list[str]] = {}
   732	    bodies: list[tuple[str, str]] = []
   733	    stats = {
   734	        "files_scanned": 0,
   735	        "files_indexed": 0,
   736	        "skipped_empty_body": 0,
   737	        "skipped_symlink": 0,
   738	        "skipped_unreadable": 0,
   739	        "truncated": False,
   740	        "file_cap": CORPUS_FILE_CAP,
   741	    }
   742	    for dirpath, dirnames, filenames in os.walk(vault):
   743	        dirnames[:] = sorted(
   744	            d
   745	            for d in dirnames
   746	            if not d.startswith(".")
   747	            and d not in CORPUS_EXCLUDED_DIR_NAMES
   748	            and os.path.realpath(os.path.join(dirpath, d)) not in excluded_roots
   749	        )
   750	        for fn in sorted(filenames):
   751	            if not fn.endswith(".md"):
   752	                continue
   753	            if stats["files_scanned"] >= CORPUS_FILE_CAP:
   754	                # ⛔ 不在此处 return —— 早退会绕过下面的排序尾巴, 让"截断"与"未截断"
   755	                # 两条路径产出形态不同的索引。置位后跳出全部循环, 走同一个出口。
   756	                stats["truncated"] = True
   757	                dirnames.clear()
   758	                break
   759	            p = Path(dirpath) / fn
   760	            stats["files_scanned"] += 1
   761	            if p.is_symlink():
   762	                stats["skipped_symlink"] += 1
   763	                continue
   764	            text = read_text_or_none(p)
   765	            if text is None:
   766	                stats["skipped_unreadable"] += 1
   767	                continue
   768	            if not has_substantive_content(text):
   769	                stats["skipped_empty_body"] += 1
   770	                continue
   771	            body = dup_body(text)
   772	            if not body:
   773	                stats["skipped_empty_body"] += 1
   774	                continue
   775	            rel = p.relative_to(vault).as_posix()
   776	            by_body.setdefault(body, []).append(rel)
   777	            bodies.append((rel, body))
   778	            stats["files_indexed"] += 1
   779	        if stats["truncated"]:
   780	            break
   781	    for v in by_body.values():
   782	        v.sort()
   783	    bodies.sort()
   784	    return by_body, bodies, stats
   785	
   786	
   787	def near_duplicates(
   788	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
   789	) -> list[dict]:
   790	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
   791	    if not body:
   792	        return []
   793	    a_lines = body.split("\n")
   794	    la = len(body)
   795	    hits: list[tuple[float, str]] = []
   796	    for rel, other in corpus_bodies:
   797	        if other == body:
   798	            continue  # 逐字相等归 C4，不重复计入疑似
   799	        lb = len(other)
   800	        if la > NEAR_DUP_BODY_CHAR_CAP or lb > NEAR_DUP_BODY_CHAR_CAP:
   801	            scan["skipped_oversize"] += 1
   802	            continue
   803	        if not (1 / NEAR_DUP_LEN_RATIO <= (lb / la if la else 0) <= NEAR_DUP_LEN_RATIO):
   804	            scan["skipped_length_prefilter"] += 1
   805	            continue
   806	        scan["compared_pairs"] += 1
   807	        sm = difflib.SequenceMatcher(None, a_lines, other.split("\n"), autojunk=False)
   808	        if sm.real_quick_ratio() < NEAR_DUP_RATIO or sm.quick_ratio() < NEAR_DUP_RATIO:
   809	            continue
   810	        r = sm.ratio()
   811	        if r >= NEAR_DUP_RATIO:
   812	            hits.append((r, rel))
   813	    hits.sort(key=lambda x: (-x[0], x[1]))
   814	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
