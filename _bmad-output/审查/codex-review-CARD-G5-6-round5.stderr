  1618	def validate_product_filename(label: str) -> None:
  1619	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  1620	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  1621	    for suffix in (".json", ".md"):
  1622	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  1623	        if n > MAX_FILENAME_BYTES:
  1624	            raise SystemExit(
  1625	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  1626	                f"inbox-preview-{label}{suffix}"
  1627	            )
