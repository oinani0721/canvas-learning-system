   168	
   169	def _load_split_preview():
   170	    """加载复用来源。⛔ 缺失即拒绝运行：本引擎的写侧防御全部来自它，
   171	    退化成「自己简单写一下」等于在安全面上开一个没人审过的旁路。"""
   172	    if not _SP_PATH.is_file():
   173	        raise SystemExit(
   174	            "✗ 复用来源缺失，拒绝以未加固的写侧运行。需要文件: "
   175	            f"{_SP_PATH}\n"
   176	            "  （本引擎的 out-dir symlink 守卫 / O_NOFOLLOW 准入 / 双产物原子发布"
   177	            " 全部复用该模块，不做本地降级副本。）"
   178	        )
   179	    spec = importlib.util.spec_from_file_location("_g56_split_preview", _SP_PATH)
   180	    mod = importlib.util.module_from_spec(spec)
   181	    # ⛔ 零写侧的第一现场（Codex 审查实证抓出）：`exec_module` 默认会在被导入模块
   182	    # 旁边写 `__pycache__/*.pyc` —— 那是往 **vault 里**、而且是**另一条车道的
   183	    # board-split 目录里**落文件。零写侧不是"不改用户的 md"，是"除 out-dir 外
   184	    # 一个字节都不落"。原先的零写快照抓不到它: fixture 树里根本没有真实 skills 目录，
   185	    # 而 live 快照跑的时候 .pyc 早已存在且是最新的, 于是"没有变化"= 假绿。
   186	    prev = sys.dont_write_bytecode
   187	    sys.dont_write_bytecode = True
   188	    try:
   189	        spec.loader.exec_module(mod)
   190	    finally:
   191	        sys.dont_write_bytecode = prev
   192	    return mod
   193	
