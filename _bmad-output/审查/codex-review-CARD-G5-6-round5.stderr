+write('H4', '节点/甲本.md', body)
+write('H4', '归档/乙本.md', body)
+write('H4', '_待处理/第三份.md', body)
+
+write('REG_AI_CASE', '_待处理/全小写AI声明.md', '---\ngenerator: generated by ai\n---\n')
+write('REG_AI_CASE', '_待处理/全大写AI声明.md', '---\ngenerator: GENERATED BY AI\n---\n')
