   329	def test_c4_empty_body_never_enters_dup_index(tmp_path):
   330	    """空正文不得互为「正本」—— 否则两个空骨架会互相支撑出一条有后果的建议删。"""
   331	    vault, out = base_vault(tmp_path)
   332	    mk(vault / "节点" / "库内空壳.md", "---\ntitle: x\n---\n\n# 只有标题\n", age_days=40)
   333	    mk(vault / "_待处理" / "收件箱空壳.md", "---\ntitle: y\n---\n\n# 只有标题\n", age_days=2)
   334	
   335	    assert run_cli(vault, out).returncode == 0
   336	    it = load_json(out)["items"][0]
   337	    assert it["criterion"] == "C3_empty_or_skeleton"
   338	    assert it["exact_duplicate_of"] is None, "空正文不得进重复索引"
