   266	def test_c3_empty_and_skeleton_positive_and_negative(tmp_path):
   267	    """C3: 0 字节 / 剥离后无正文的骨架 → 建议删; 有正文者不得命中。"""
   268	    vault, out = base_vault(tmp_path)
   269	    inbox = vault / "_待处理"
   270	    mk(inbox / "未命名 5.md", "", age_days=9)
   271	    mk(inbox / "空骨架.md", "---\ntitle: t\n---\n\n# 标题\n\n## 小节\n\n- \n- \n\n<!-- 注释 -->\n", age_days=8)
   272	    mk(inbox / "有正文.md", "# 标题\n\n这里有真正的正文内容。\n还有第二行。\n", age_days=7)
   273	
   274	    assert run_cli(vault, out).returncode == 0
   275	    data = load_json(out)
   276	
   277	    zero = item_by_name(data, "未命名 5.md")
   278	    assert zero["criterion"] == "C3_empty_or_skeleton"
   279	    assert zero["verdict"] == "建议删"
   280	    assert "0 字节" in zero["basis"]
   281	
   282	    skel = item_by_name(data, "空骨架.md")
   283	    assert skel["criterion"] == "C3_empty_or_skeleton"
   284	    assert skel["verdict"] == "建议删"
   285	
   286	    body = item_by_name(data, "有正文.md")
   287	    assert body["criterion"] != "C3_empty_or_skeleton"
   288	    assert body["verdict"] != "建议删"
