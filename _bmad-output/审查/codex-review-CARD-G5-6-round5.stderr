   410	def days_between(now_s: float, then_s: float) -> int:
   411	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   412	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   413	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   414	    return int(round(now_s - then_s)) // 86400
