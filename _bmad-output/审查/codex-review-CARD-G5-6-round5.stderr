+    p.write_text(text, encoding='utf-8')
+
+def init(case):
+    (ROOT / case / 'vault' / '_待处理').mkdir(parents=True, exist_ok=True)
+
+for case in ('B3','H1','H2','H3','H4','REG_AI_CASE','REG_URL_ALIAS','REG_SOURCE_ALIAS','REG_AI_NBSP','REG_ALL'):
+    init(case)
+
+write('B3', '_待处理/四反引号.md', '````\n```\n# keep\n````\n')
+
+write('H1', '_待处理/空host端口.md', '---\nsource: https://:443/x\n---\n\n正文甲一。\n正文甲二。\n')
+write('H1', '_待处理/空host用户.md', '---\nsource: https://user@/x\n---\n\n正文乙一。\n正文乙二。\n')
+
+write('H2', '_待处理/版权话题.md', '# AI 生成内容的版权问题\n\n话题正文一。\n话题正文二。\n')
+write('H2', '_待处理/由字版权话题.md', '# 由 AI 生成内容的版权问题\n\n话题正文三。\n话题正文四。\n')
+write('H2', '_待处理/评测话题.md', '# Deep Research 生成质量评测\n\n评测正文一。\n评测正文二。\n')
+
+write('H3', '_待处理/裸URL行.md', '---\nhttp://example.com/path\n---\n')
+
+body = '同一段被存过两次的正文。\n第二行。\n'
+write('H4', '节点/甲本.md', body)
+write('H4', '归档/乙本.md', body)
+write('H4', '_待处理/第三份.md', body)
+
+write('REG_AI_CASE', '_待处理/全小写AI声明.md', '---\ngenerator: generated by ai\n---\n')
+write('REG_AI_CASE', '_待处理/全大写AI声明.md', '---\ngenerator: GENERATED BY AI\n---\n')
+write('REG_URL_ALIAS', '_待处理/坏url别名空.md', '---\nurl: https://:443/x\n---\n')
+write('REG_SOURCE_ALIAS', '_待处理/坏Source别名空.md', '---\nSource: https://:443/x\n---\n')
+write('REG_AI_NBSP', '_待处理/NBSP英文AI空.md', '---\ngenerator: Generated\u00a0by\u00a0AI\n---\n')
+
+# Broader connected regression matrix.
+cases = {
+ 'DR正例.md': '# 报告\n\n> 本文由 Deep Research 生成\n\n正文一。\n正文二。\n',
