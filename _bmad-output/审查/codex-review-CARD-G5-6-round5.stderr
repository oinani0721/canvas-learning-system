@@ -0,0 +1,76 @@
+from pathlib import Path
+
+ROOT = Path('/private/tmp/card-g5-6b-codex-audit.3XRBIM/cases')
+
+def write(case, rel, text):
+    p = ROOT / case / 'vault' / rel
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(text, encoding='utf-8')
+
+def init(case):
+    (ROOT / case / 'vault' / '_待处理').mkdir(parents=True, exist_ok=True)
+
+for case in ('B3','H1','H2','H3','H4','REG_AI_CASE','REG_ALL'):
+    init(case)
+
+write('B3', '_待处理/四反引号.md', '````\n```\n# keep\n````\n')
+
+write('H1', '_待处理/空host端口.md', '---\nsource: https://:443/x\n---\n\n正文甲一。\n正文甲二。\n')
+write('H1', '_待处理/空host用户.md', '---\nsource: https://user@/x\n---\n\n正文乙一。\n正文乙二。\n')
+
+write('H2', '_待处理/版权话题.md', '# AI 生成内容的版权问题\n\n话题正文一。\n话题正文二。\n')
+write('H2', '_待处理/由字版权话题.md', '# 由 AI 生成内容的版权问题\n\n话题正文三。\n话题正文四。\n')
+write('H2', '_待处理/评测话题.md', '# Deep Research 生成质量评测\n\n评测正文一。\n评测正文二。\n')
+
+write('H3', '_待处理/裸URL行.md', '---\nhttp://example.com/path\n---\n')
+
+body = '同一段被存过两次的正文。\n第二行。\n'
+write('H4', '节点/甲本.md', body)
+write('H4', '归档/乙本.md', body)
+write('H4', '_待处理/第三份.md', body)
+
+write('REG_AI_CASE', '_待处理/全小写AI声明.md', '---\ngenerator: generated by ai\n---\n')
+write('REG_AI_CASE', '_待处理/全大写AI声明.md', '---\ngenerator: GENERATED BY AI\n---\n')
+
+# Broader connected regression matrix.
+cases = {
+ 'DR正例.md': '# 报告\n\n> 本文由 Deep Research 生成\n\n正文一。\n正文二。\n',
+ 'R99_深度调研.md': '# 调研\n\n本文由 AI 生成\n\n正文一。\n正文二。\n',
+ '英文行尾.md': '# Report\n\nGenerated by AI\n\nBody one.\nBody two.\n',
+ '英文机构.md': '# Lab\n\nGenerated by AI Lab researchers\n\nBody one.\nBody two.\n',
+ '英文真实但空格.md': '# Report\n\nGenerated by AI for internal review\n\nBody one.\nBody two.\n',
+ 'IPv6.md': '---\nsource: https://[::1]:8443/x\n---\n',
+ '大写scheme.md': '---\nsource: HTTPS://Upper.Test/x\n---\n',
+ 'IDN.md': '---\nsource: https://例え.テスト/x\n---\n',
+ '空值tags骨架.md': '---\ntags:\n---\n# 标题\n',
+ '时间戳骨架.md': '---\ncreated: 2026-01-01T00:00:00+08:00\n---\n# 标题\n',
+ '引号source.md': '---\nsource: "https://quoted.test/x"\n---\n',
+ 'tab-source.md': '---\nsource:\thttps://tab.test/x\n---\n',
+ '冒号前空格source.md': '---\nsource : https://space.test/x\n---\n',
+ '正常四反关闭.md': '````python\n\n   ```` \t\n# 标题\n',
+ '正常波浪关闭.md': '~~~~python\n\n~~~~~\n# 标题\n',
+ '纯空骨架.md': '---\ntitle: t\n---\n\n# 标题\n\n<!-- 注释 -->\n',
+ '非法source空.md': '---\nsource: https://:443/x\n---\n',
+ '未解析行空.md': '---\ntitle: t\nsource:https://x\n---\n',
+ '未闭合注释.md': '<!-- 忘记闭合\n# keep\n',
+ 'AI嫌疑空.md': '---\ngenerator: Generated by AI on March\n---\n',
+}
+for name, text in cases.items():
+    write('REG_ALL', '_待处理/' + name, text)
+
+for case in ('REG_H2','REG_H1','REG_H3','REG_B3','REG_GUARDS'):
+    init(case)
+
+for name in ('DR正例.md','R99_深度调研.md','英文行尾.md','英文机构.md','英文真实但空格.md'):
+    write('REG_H2', '_待处理/' + name, cases[name])
+for name in ('IPv6.md','大写scheme.md','IDN.md'):
+    write('REG_H1', '_待处理/' + name, cases[name])
+for name in ('空值tags骨架.md','时间戳骨架.md','引号source.md','tab-source.md','冒号前空格source.md'):
+    write('REG_H3', '_待处理/' + name, cases[name])
+for name in ('正常四反关闭.md','正常波浪关闭.md'):
+    write('REG_B3', '_待处理/' + name, cases[name])
+for name in ('纯空骨架.md','非法source空.md','未解析行空.md','未闭合注释.md','AI嫌疑空.md'):
+    write('REG_GUARDS', '_待处理/' + name, cases[name])
