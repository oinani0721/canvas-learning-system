  1631	    ap = argparse.ArgumentParser(
  1632	        description="待处理盘点提名 preview（只读, CARD-G5-6）"
  1633	    )
  1634	    ap.add_argument("--vault", required=True, help="vault 根目录")
  1635	    ap.add_argument(
  1636	        "--now", required=True, help="基准时刻 ISO-8601（裸时间按 Asia/Shanghai 解释）"
  1637	    )
  1638	    ap.add_argument(
  1639	        "--inbox-dir",
  1640	        default=None,
  1641	        help=f"收件箱目录（缺省 <vault>/{DEFAULT_INBOX_NAME}）。"
  1642	        "显式给定却不存在 = 拒绝；缺省路径不存在 = 空仓回执",
  1643	    )
  1644	    ap.add_argument(
  1645	        "--out-dir",
  1646	        default=None,
