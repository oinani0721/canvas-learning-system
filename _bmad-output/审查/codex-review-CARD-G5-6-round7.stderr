  1317	    # 正向对照: 真正的 frontmatter source 键仍走 C1
  1318	    mk(
  1319	        vault / "_待处理" / "真source.md",
  1320	        "---\nsource: http://example.com/path\n---\n\n正文一。\n正文二。\n",
  1321	        age_days=2,
  1322	    )
