   380	
   381	def compute_inbox_stable_id(rel_path: str) -> str:
   382	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   383	
   384	    编码纪律复用 `split_preview.compute_stable_id`（长度前缀载荷，对任意字节单射），
   385	    命名空间经 heading-path 槽位注入，返回值改挂自有前缀 —— 见文件头「身份空间
   386	    不可互换」。**不**把 mtime/size/内容进键：那样一改正文就换身份，diff 无意义。
   387	    """
   388	    raw = _SP.compute_stable_id(rel_path, [INBOX_ID_NAMESPACE], 1, INBOX_ID_BASIS)
   389	    return INBOX_ID_PREFIX + raw[len(_SP.STABLE_ID_PREFIX) :]
   390	
   440	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   441	
   442	
   443	def frontmatter_span(lines: list[str]) -> int:
   444	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   445	
   446	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   447	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   448	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   449	    行号是给人核对用的，偏了就等于没有。
   450	    """
   451	    if not lines or lines[0].strip() != "---":
   452	        return 0
   453	    end = None
   454	    for i in range(1, len(lines)):
   455	        if lines[i].strip() in ("---", "..."):
   456	            end = i
   457	            break
   458	    if end is None:
   459	        return 0  # 缺闭合 → 视为无 frontmatter
   460	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   461	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   462	    # 空文件的删除提名，比不提名坏得多。
   463	    for ln in lines[1:end]:
   464	        t = ln.strip()
   465	        if not t or t.startswith("#"):
   466	            continue  # 空行与 YAML 注释不作数
   467	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   468	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   469	
   470	
   471	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   472	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   473	    lines = text.splitlines()
   474	    n = frontmatter_span(lines)
   475	    return (lines[1 : n - 1] if n else []), lines[n:]
   476	
   477	
   478	def frontmatter_map(fm_lines: list[str]) -> dict:
   479	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   480	    out: dict[str, str] = {}
   481	    for ln in fm_lines:
   482	        m = _FM_KEY_RE.match(ln)
   483	        if not m:
   484	            continue
   485	        val = (m.group(2) or "").strip()
   486	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   487	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   488	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   489	        val = re.sub(r"\s+#.*$", "", val).strip()
   490	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   491	            val = val[1:-1]
   492	        out.setdefault(m.group(1), val)
   493	    return out
   494	
   495	
   496	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   497	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   498	
   499	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   500	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   501	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   502	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   503	    分隔行由状态机精确标记，内容行一律是内容。
   504	
   505	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   506	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   507	
   508	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   509	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   510	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   511	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   512	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   513	    """
   514	    _, rest = split_frontmatter(text)
   515	    rows: list[tuple[str, str]] = []
   516	    in_fence = False
   517	    fence_char = ""
   518	    fence_len = 0
   519	    in_comment = False
   520	    for ln in rest:
   521	        m = _FENCE_RE.match(ln)
   522	        if m and not in_comment:
   523	            tok = m.group(1)
   524	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   525	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   526	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   527	            # 的 info string 允许反引号，不受此限。
   528	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   529	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   530	                rows.append((ln, "fence"))
   531	                continue
   532	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   533	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   534	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   535	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   536	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   537	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   538	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   539	            # 在 CommonMark 里是围栏内容）。
   540	            if (
   541	                tok[0] == fence_char
   542	                and len(tok) >= fence_len
   543	                and all(c in " \t" for c in ln[m.end() :])
   544	            ):
   545	                in_fence, fence_char, fence_len = False, "", 0
   546	                rows.append((ln, "fence"))
   547	                continue
   548	        if in_fence:
   549	            rows.append((ln, "code"))
   550	            continue
   551	        kept, rem = "", ln
   552	        while rem:
   553	            if in_comment:
   554	                i = rem.find("-->")
   555	                if i < 0:
   556	                    break
   557	                rem, in_comment = rem[i + 3 :], False
   558	            else:
   559	                i = rem.find("<!--")
   560	                if i < 0:
   561	                    kept += rem
   562	                    break
   563	                kept += rem[:i]
   564	                rem, in_comment = rem[i + 4 :], True
   565	        rows.append((kept, "text"))
   566	    return rows, in_comment
   567	
   568	
   569	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   570	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   571	    三态细节见 `_classify_lines_typed`。"""
   572	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   573	
   574	
   575	def dup_body(text: str) -> str:
   576	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   577	
   578	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   579	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   580	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   581	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   582	    有后果的提名，依据必须逐字。
   583	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   584	    """
   585	    parts: list[str] = []
   586	    for ln, is_code in _classify_lines(text):
   587	        if not is_code and _HEADING_RE.match(ln):
   588	            continue
   589	        t = ln.rstrip()
   590	        if not t:
   591	            continue
   592	        parts.append(nfc(t))
   593	    return "\n".join(parts)
   594	
   595	
   596	def has_substantive_content(text: str) -> bool:
   597	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   598	
   599	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   600	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   601	    合用一个函数正是 Codex BLOCKER 的根因。
   602	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   603	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   604	    （round-3 自审 B3-3）。
   605	    """
   606	    for ln, kind in _classify_lines_typed(text)[0]:
   607	        if kind == "code":
   608	            if ln.strip():
   609	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   610	            continue
   611	        if kind == "fence":
   612	            continue
   613	        if _HEADING_RE.match(ln):
   614	            continue
   615	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   616	        if t and not _ONLY_STRUCT_RE.match(t):
   617	            return True
   618	    return False
   619	
   620	
   621	def skeleton_note(text: str, size: int) -> str:
   622	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   623	
   624	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   625	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   626	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   627	    """
   628	    if size == 0:
   629	        return "0 字节空文件"
   630	    rows = _classify_lines_typed(text)[0]
   631	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   632	    struct = sum(
   633	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   634	    )
   635	    fences = sum(1 for _, k in rows if k == "fence")
   636	    return (
   637	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   638	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   639	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   640	    )
   641	
   642	
   643	def head_window(text: str) -> list[tuple[int, str]]:
   644	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   645	    lines = text.splitlines()
   646	    n = frontmatter_span(lines)
   647	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   648	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   649	        win.append((n + j + 1, ln))
   650	    return win
   651	
   652	
   653	def _norm_ai_line(ln: str) -> str:
   654	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   655	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   656	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   657	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   658	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   659	    return " ".join(ln.split()).casefold()
   660	
   661	
   662	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   663	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   664	
   665	#: ⛔ 护栏级 AI 信号（词边界，不依赖枚举表）：文本含独立词「AI」即算嫌疑。
   666	#: 有限标记表无论怎么扩都追不上自然语言的肯定式声明（round-6 BLOCKER-1：
   667	#: `This report was generated by an AI system` 不含任何表项，双层全盲，
   668	#: 无正文时掉进 C3 建议删）。本信号只降 C6 不裁决 —— C2 确定命中仍走
   669	#: 有限表 + 边界规则（宽匹配会给话题提及发确定归档，那是硬猜）。
   670	_AI_WORD_RE = re.compile(r"\bAI\b", re.IGNORECASE)
   671	
   672	
   673	def _find_marker_pos(ln: str, marker: str) -> int:
   674	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   675	
   676	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   677	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   678	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   679	    行内更靠后的真命中。
   680	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   681	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   682	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   683	    只认行尾或标点；漏判方向落 C6，安全。"""
   684	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   685	    start = 0
   686	    while (i := ln.find(marker, start)) >= 0:
   687	        j = i + len(marker)
   688	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   689	            return i
   690	        if not ascii_ending and ln[j].isspace():
   691	            return i
   692	        start = i + 1
   693	    return -1
   694	
   695	
   696	def find_ai_marker(text: str) -> tuple[int, str] | None:
   697	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   698	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   699	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   700	    —— 行号准确，文本保真。"""
   701	    for lineno, ln in head_window(text):
   702	        norm = _norm_ai_line(ln)
   703	        hits = [
   704	            (pos, -len(nm), orig)
   705	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   706	            if (pos := _find_marker_pos(norm, nm)) >= 0
   707	        ]
   708	        if hits:
   709	            _, _, marker = min(hits)
   710	            return lineno, marker
   711	    return None
   712	
   713	
   714	def raw_ai_marker(text: str) -> str | None:
   715	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   716	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
   717	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
   718	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
   719	    返回原表原文（uncertain_reason 展示用）。"""
   720	    for _, ln in head_window(text):
   721	        norm = _norm_ai_line(ln)
   722	        for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
   723	            if nm in norm:
   724	                return orig
   725	    return None
   726	
   727	
   728	def round_of(name: str) -> str | None:
   729	    m = _ROUND_RE.search(name)
   730	    return m.group(1) if m else None
   731	
   732	
   733	def round_type(name: str) -> str | None:
   734	    for pat, typ in ROUND_SUBPATTERNS:
   735	        if pat in name:
   736	            return typ
   737	    return None
   738	
