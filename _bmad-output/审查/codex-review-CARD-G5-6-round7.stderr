   989	    def _looks_like_source_value(v: str) -> bool:
   990	        """URL 前缀形态判定（⛔ 不要求可机判合法）：`https://:443/x` 这类损坏
   991	        URL 同样是来源声明 —— round-5 审查 BLOCKER-2 实证 `Source: <坏URL>` 曾
   992	        因值不合法穿透信号③b 被建议删。大小写不敏感。
   993	        ⛔ 先剥一层 Markdown autolink 角括号：`<https://…>` 是常见剪藏写法，
   994	        曾因首字符是 `<` 穿透本判定（round-6 BLOCKER-2）。"""
   995	        t = v.strip()
   996	        if t.startswith("<") and t.endswith(">"):
   997	            t = t[1:-1].strip()
   998	        return t.casefold().startswith(("http://", "https://"))
