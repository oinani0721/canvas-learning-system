   740	# ───────────────────────────── 扫描 ─────────────────────────────
   741	
   742	
   743	def read_text_or_none(p: Path) -> str | None:
   744	    try:
   745	        return p.read_bytes().decode("utf-8")
   746	    except (OSError, UnicodeDecodeError):
   747	        return None
   748	
   749	
   750	def scan_corpus(
   840	        if r >= NEAR_DUP_RATIO:
   841	            hits.append((r, rel))
   842	    hits.sort(key=lambda x: (-x[0], x[1]))
   843	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
   844	
   845	
   846	# ───────────────────────── 逐份提名（判据次序即本函数结构） ─────────────────────────
   847	
   848	
   849	def nominate(
   850	    item: dict,
   851	    text: str | None,
   852	    dup_index: dict[str, list[str]],
   853	    corpus_bodies: list[tuple[str, str]],
   854	    scan: dict,
   855	    batch_body_counts: dict[str, int],
   856	) -> dict:
   857	    """对一件材料出提名。**次序即 CRITERIA_ORDER**，先命中者定 verdict；
   858	    后续判据的证据仍全量附上（conflicts / exact_duplicate_of / near_duplicates）。"""
   859	    name = item["name"]
   860	    conflicts: list[dict] = []
   861	
   862	    if text is None:
   863	        # 非 UTF-8（PDF/图片等）：除 0 字节外无任何可机械判读的信号 → 不猜。
   864	        if item["size_bytes"] == 0:
   865	            return _fill(
   866	                item,
   867	                "C3_empty_or_skeleton",
   868	                V_DELETE,
   869	                None,
   870	                None,
   871	                "0 字节空文件",
   872	                True,
   873	                conflicts=conflicts,
   874	            )
   875	        return _fill(
   876	            item,
   877	            "C6_undecided",
   878	            V_UNSURE,
   879	            None,
   880	            None,
   881	            "非 UTF-8 文本，本引擎不解析其正文",
   882	            False,
   883	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
   884	            ask=UNDECIDED_ASK,
   885	            conflicts=conflicts,
   886	        )
   887	
   888	    fm_lines = split_frontmatter(text)[0]
   889	    fm = frontmatter_map(fm_lines)
   890	    typed_rows, unclosed_comment = _classify_lines_typed(text)
   891	    del typed_rows
   892	    substantive = has_substantive_content(text)
   893	    body = dup_body(text) if substantive else ""
   894	    rnd = round_of(name)
   895	    # C3 护栏信号（显式偏差 15）：frontmatter 里「看着像键但不被键正则认」的行。
   896	    unparsed_fm = [
   897	        ln.strip()
   898	        for ln in fm_lines
   899	        if ln.strip() and not ln.strip().startswith("#") and not _FM_KEY_RE.match(ln)
   900	    ]
   901	    # 未消化信号之四：边界规则拒掉的 AI 自述嫌疑（裸子串在场即算，见 raw_ai_marker）。
   902	    ai_suspect = raw_ai_marker(text)
   903	    # 未消化信号之六（round-6 BLOCKER-1）：独立词「AI」结构性信号 —— 不依赖
   904	    # 枚举表，frontmatter 值或文头任一行含独立词 AI 即算嫌疑。
   905	    ai_word_hit = next(
   906	        (
   907	            v
   908	            for v in [*fm.values(), *[ln for _, ln in head_window(text)]]
   909	            if _AI_WORD_RE.search(v)
   910	        ),
   911	        None,
   912	    )
   913	
   914	    # ── 后置证据（不参与次序，但必须全量呈现） ──
   915	    exact_all = sorted(dup_index.get(body, [])) if body else []
   916	    exact_of = exact_all[0] if exact_all else None
   917	    exact_others = exact_all[1:]
   918	    near = near_duplicates(body, corpus_bodies, scan)
   919	    within_batch = bool(body) and batch_body_counts.get(body, 0) > 1
   920	    if within_batch:
   921	        conflicts.append(
   922	            {
