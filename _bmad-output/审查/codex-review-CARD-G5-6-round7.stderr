  1606	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1607	    assert skeleton["verdict"] == "建议删"
  1608	    primary = item_by_name(data, "source键书签.md")
  1609	    assert primary["criterion"] == "C1_source_url"
