   656	    mk(inbox / "空的.md", "", age_days=9)
   657	    mk(inbox / "骨架.md", "# 只有标题\n\n## 二级\n", age_days=8)
   658	    mk(inbox / "重复的.md", body, age_days=7)
   659	    mk(inbox / "普通的.md", "# 普通\n\n一些内容。\n再一行。\n", age_days=6)
   660	    lines = [f"共同第 {i} 行。" for i in range(1, 41)]
