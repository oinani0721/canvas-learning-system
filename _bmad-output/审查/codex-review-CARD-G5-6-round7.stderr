  1560	    assert any(c["kind"] == "exact_duplicate_under_other_verdict" for c in it["conflicts"]), "重复证据必须挂冲突留痕"
  1561	    assert "unique.example" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1562	    dup = item_by_name(data, "无来源重复.md")
