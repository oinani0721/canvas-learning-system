   689	# ───────────────────────── C. 零写快照 ─────────────────────────
   690	
   691	
   692	def test_no_bytecode_cache_written_into_vault_skills(tmp_path):
   693	    """⛔ 零写侧的第一现场（Codex 审查实证）: importlib 加载兄弟模块默认会在
   694	    **board-split 目录**里写 `__pycache__/*.pyc` —— 既是往 vault 落文件, 也是
   695	    伸手进另一条车道的地盘。
   696	
   697	    (d) tmp 隔离重构 (CARD-G5-6b): 不再 rmtree checkout 里的 `__pycache__`
   698	    (裁判不该动被测 checkout 的任何目录项), 改为把两个脚本按**同一相对布局**
   699	    拷进 tmp (SCRIPT 的 `_SP_PATH` 由 `__file__` 推导, 布局一致副本才能定位
   700	    它自己的 split_preview 副本), 在副本上跑 CLI 与 importlib 加载, 断言副本树
   701	    下零 `__pycache__`。副本 sha256 必须等于 checkout 原件 —— 否则门测的是副本
   702	    不是被测物。CLI 子进程**显式剥掉 PYTHONDONTWRITEBYTECODE**: 裁判命令带着
   703	    它跑时, 子进程继承该变量会让 SCRIPT 内部的 dont_write_bytecode 保护永远
   704	    不被考验(门空转); 在副本树上剥掉它, 内部保护成为唯一防线, 删掉保护当场
   705	    在副本树留下缓存 → 门变红。
   706	    """
   707	    skills_copy = tmp_path / "skills"
   708	    for src in (SCRIPT, SPLIT_SCRIPT):
   709	        dst = skills_copy / src.relative_to(SKILLS)
   710	        dst.parent.mkdir(parents=True, exist_ok=True)
   711	        shutil.copy2(src, dst)
   712	        assert hashlib.sha256(dst.read_bytes()).hexdigest() == hashlib.sha256(src.read_bytes()).hexdigest(), (
   713	            f"副本与 checkout 原件不一致: {src}"
   714	        )
   715	    script_copy = skills_copy / SCRIPT.relative_to(SKILLS)
   716	
   717	    vault, out = base_vault(tmp_path)
   718	    env = {k: v for k, v in os.environ.items() if k != "PYTHONDONTWRITEBYTECODE"}
   719	    r = subprocess.run(
   720	        [
   721	            sys.executable,
   722	            str(script_copy),
   723	            "--vault",
   724	            str(vault),
   725	            "--out-dir",
   726	            str(out),
   727	            "--now",
   728	            NOW_ISO,
   729	        ],
   730	        capture_output=True,
   731	        text=True,
   732	        env=env,
   733	    )
   734	    assert r.returncode == 0, r.stderr[-300:]
   735	
   736	    spec = importlib.util.spec_from_file_location("inbox_preview_tmpcopy", script_copy)
   737	    mod = importlib.util.module_from_spec(spec)
   738	    _exec_no_bytecode(spec, mod)
   739	    assert mod._SP_PATH == skills_copy / SPLIT_SCRIPT.relative_to(SKILLS), (
   740	        "副本没有解析到副本树里的 split_preview —— 布局与 checkout 不一致"
   741	    )
   742	
   743	    caches = sorted(p.relative_to(skills_copy) for p in skills_copy.rglob("__pycache__"))
   744	    assert not caches, f"运行/导入在副本树落下了字节码缓存: {caches}"
   745	
