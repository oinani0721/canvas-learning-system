  1300	def test_bare_ai_markers_are_removed_from_table():
  1301	    """⛔ H2 回归(表锁): 裸词「AI 生成」「AI生成」是「由 AI 生成」「由AI生成」的
  1302	    严格子串; 截断形态「本文由 AI」「本报告由 AI」被「由 AI 生成」覆盖断言形态 ——
  1303	    从表中删除不丢任何带断言锚的命中, 只丢话题提及类误命中。"""
  1304	    mod = load_module()
  1305	    assert "AI 生成" not in mod.AI_MARKERS
  1306	    assert "AI生成" not in mod.AI_MARKERS
  1307	    assert "本文由 AI" not in mod.AI_MARKERS
  1308	    assert "本报告由 AI" not in mod.AI_MARKERS
