/bin/zsh -lc "python3 -c 'from pathlib import Path
root=Path(\"/private/tmp/card-g56b-root.j8tjIQ/cases\")
def put(case, rel, data):
 p=root/case/\"vault\"/rel; p.parent.mkdir(parents=True, exist_ok=True); p.write_bytes(data)
for case in (\"B3\",\"H1\",\"H2\",\"H3\",\"H4\"):
 (root/case/\"vault\"/\"原白板\").mkdir(parents=True, exist_ok=True)
 (root/case/\"vault\"/\"节点\").mkdir(parents=True, exist_ok=True)
 (root/case/\"vault\"/\"_待处理\").mkdir(parents=True, exist_ok=True)
put(\"B3\", \"_待处理/四反引号.md\", \""'````'"\\n"'```'"\\n# keep\\n"'````'"\\n\".encode())
put(\"H1\", \"_待处理/空host端口.md\", \"---\\nsource: https://:443/x\\n---\\n\\n正文甲一。\\n正文甲二。\\n\".encode())
put(\"H1\", \"_待处理/空host用户.md\", \"---\\nsource: https://user@/x\\n---\\n\\n正文乙一。\\n正文乙二。\\n\".encode())
put(\"H2\", \"_待处理/版权话题.md\", \"# AI 生成内容的版权问题\\n\\n话题正文一。\\n话题正文二。\\n\".encode())
put(\"H2\", \"_待处理/由字版权话题.md\", \"# 由 AI 生成内容的版权问题\\n\\n话题正文三。\\n话题正文四。\\n\".encode())
put(\"H2\", \"_待处理/评测话题.md\", \"# Deep Research 生成质量评测\\n\\n评测正文一。\\n评测正文二。\\n\".encode())
put(\"H3\", \"_待处理/裸URL行.md\", \"---\\nhttp://example.com/path\\n---\\n\".encode())
body=\"同一段被存过两次的正文。\\n第二行。\\n\".encode()
put(\"H4\", \"节点/甲本.md\", body)
put(\"H4\", \"归档/乙本.md\", body)
put(\"H4\", \"_待处理/第三份.md\", body)
print(root)'" in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-v6-inbox
