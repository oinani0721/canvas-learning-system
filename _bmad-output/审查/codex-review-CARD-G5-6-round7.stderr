  1490	# ───────────────────────── 人读 MD（纯自渲染，只消费 JSON dict） ─────────────────────────
  1491	
  1492	
  1493	def render_md(d: dict) -> str:
  1494	    L: list[str] = []
  1495	    L.append(f"# 待处理盘点 preview · {d['label']}")
  1496	    L.append("")
  1497	    L.append(f"> {d['not_executed_disclaimer']}")
  1498	    L.append(
  1499	        f"> 基准时刻 `--now`：{d['now_local']}（Asia/Shanghai）· schema v{d['schema_version']}"
  1500	    )
  1501	    L.append("")
  1502	    L.append("## 一、回执")
  1503	    L.append("")
  1504	    L.append(d["receipt"])
  1505	    L.append("")
  1506	    L.append(f"- 上次清仓：**不可得** —— {d['last_cleanup_note']}")
  1507	    c = d["corpus"]
  1508	    L.append(
  1509	        f"- 语料库：扫描 {c['files_scanned']} 份 .md，进重复索引 {c['files_indexed']} 份"
  1510	        f"（空正文 {c['skipped_empty_body']} 份不进索引 · symlink {c['skipped_symlink']} · "
  1511	        f"不可读 {c['skipped_unreadable']}）"
  1512	        + (
  1513	            "　⚠️ **已达扫描上限被截断**，「无重复」仅代表已扫部分"
  1514	            if c["truncated"]
  1515	            else ""
  1516	        )
  1517	    )
  1518	    L.append("")
  1519	
  1520	    L.append(f"## 二、本批提名（{len(d['items'])} 件，最旧优先）")
  1521	    L.append("")
  1522	    if not d["items"]:
  1523	        L.append("_（本批无材料）_")
  1524	    else:
  1525	        L.append("| # | 文件 | 年龄 | 建议去向 | 提名类型 | 判据 | 依据 | 冲突 |")
  1526	        L.append("|---|---|---|---|---|---|---|---|")
  1527	        for it in d["items"]:
  1528	            conflict = (
  1529	                "；".join(f"{x['kind']}" for x in it["conflicts"])
  1530	                if it["conflicts"]
  1531	                else "—"
  1532	            )
  1533	            target = f"（→ {it['target_hint']}）" if it["target_hint"] else ""
  1534	            L.append(
  1535	                "| {i} | {n} | {a} 天 | {v}{t} | {ty} | {c} | {b} | {cf} |".format(
  1536	                    i=it["index"],
  1537	                    n=md_cell(it["name"]),
  1538	                    a=it["age_days"],
  1539	                    v=md_cell(it["verdict"]),
  1540	                    t=md_cell(target),
  1541	                    ty=md_cell(it["nomination_type"] or "—"),
  1542	                    c=md_cell(it["criterion"]),
  1543	                    b=md_cell(it["basis"]),
  1544	                    cf=md_cell(conflict),
  1545	                )
  1546	            )
  1547	    L.append("")
  1548	
  1549	    unsure = [it for it in d["items"] if not it["confident"]]
  1550	    L.append(f"## 三、拿不准（{len(unsure)} 件 · 需你一句话）")
  1551	    L.append("")
  1552	    if not unsure:
  1553	        L.append("_（本批无拿不准条目）_")
  1554	    else:
  1555	        for it in unsure:
  1556	            L.append(f"- **{it['index']}. {it['name']}** —— {it['uncertain_reason']}")
  1557	            L.append(f"  - 请回一句：{it['ask']}")
  1558	    L.append("")
  1559	
  1560	    dups = [
  1561	        it for it in d["items"] if it["exact_duplicate_of"] or it["near_duplicates"]
  1562	    ]
  1563	    L.append("## 四、重复线索")
  1564	    L.append("")
  1565	    if not dups:
  1566	        L.append("_（本批未发现逐字重复或疑似高相似）_")
  1567	    else:
  1568	        for it in dups:
  1569	            if it["exact_duplicate_of"]:
  1570	                if it["exact_duplicate_others"]:
  1571	                    # ⛔ basis 已声明「哪一份算正本不可判」—— 人读 MD 不得再钦定
  1572	                    # 「正本 `字典序首项`」（round-2 H4：JSON 与 MD 自相矛盾）。
  1573	                    # 路径**不加反引号**：路径本身含反引号时 code span 会错配吃掉
  1574	                    # 字符，渲染出一个不存在的文件名（round-3 自审 H4-1）。
  1575	                    all_dups = [
  1576	                        it["exact_duplicate_of"],
  1577	                        *it["exact_duplicate_others"],
  1578	                    ]
  1579	                    L.append(
  1580	                        f"- **{it['name']}** · 与库内 {len(all_dups)} 份文件"
  1581	                        "逐字相同："
  1582	                        + "、".join(p.replace("`", "\\`") for p in all_dups)
  1583	                        + " —— 哪一份是正本不可判"
  1584	                        "（exact_duplicate_of 仅为字典序代表）"
  1585	                    )
