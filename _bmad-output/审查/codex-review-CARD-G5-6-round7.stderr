   176	def test_c1_source_url_positive_and_negative(tmp_path):
   177	    """C1: frontmatter source 为 http(s) URL → 一手快照·留原地; 非 URL 不得命中。"""
   178	    vault, out = base_vault(tmp_path)
   179	    inbox = vault / "_待处理"
   180	    mk(
   680	    vault, out = base_vault(tmp_path)
   681	    mk(vault / "_待处理" / "x.md", "# X\n\n正文一。\n正文二。\n", age_days=2)
   682	    assert run_cli(vault, out).returncode == 0
   683	    scan = load_json(out)["near_dup_scan"]
   684	    for key in ("ratio_threshold", "body_char_cap", "compared_pairs", "skipped_oversize", "skipped_length_prefilter"):
   685	        assert key in scan, f"near_dup_scan 缺 {key}"
   686	    assert scan["ratio_threshold"] >= 0.9
