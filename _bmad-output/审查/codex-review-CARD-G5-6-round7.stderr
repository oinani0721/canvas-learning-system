  1590	                    )
  1591	            for n in it["near_duplicates"]:
  1592	                L.append(
  1593	                    f"- **{it['name']}** · 疑似（ratio {n['ratio']}）→ `{n['path']}`"
  1594	                    "　— 疑似不等于重复，**不建议删**，需你确认"
  1595	                )
  1596	    s = d["near_dup_scan"]
  1597	    L.append("")
  1598	    L.append(
  1599	        f"> 近似比对：阈值 {s['ratio_threshold']}，实比 {s['compared_pairs']} 对；"
  1600	        f"因体积跳过 {s['skipped_oversize']} 对、因长度差跳过 {s['skipped_length_prefilter']} 对。"
  1601	        f"{s['note']}"
  1602	    )
  1603	    L.append("")
  1604	
  1605	    sl = d["sleeping"]
  1606	    L.append(f"## 五、Sleeping 台账（{sl['count']} 件）")
  1607	    L.append("")
  1608	    if not sl["items"]:
  1609	        L.append("_（Sleeping/ 未建立或为空）_")
  1610	    else:
  1611	        L.append("| 文件 | 睡了几天 | 起算依据 | 满 30 天 |")
  1612	        L.append("|---|---|---|---|")
  1613	        for x in sl["items"]:
  1614	            L.append(
  1615	                f"| {md_cell(x['name'])} | {x['slept_days']} | {md_cell(x['slept_at_source'])} "
  1616	                f"| {'⚠️ 是' if x['over_30d'] else '否'} |"
  1617	            )
  1618	    L.append("")
  1619	
  1620	    dfr = d["inventory"]["deferred"]
  1621	    L.append(f"## 六、本批之外（{len(dfr)} 件，本次不提名）")
  1622	    L.append("")
  1623	    if not dfr:
  1624	        L.append("_（无积压）_")
