   236	
   237	def run_gate(gate: str) -> subprocess.CompletedProcess:
   238	    return subprocess.run(
   239	        [
   240	            str(WT / "backend/.venv/bin/pytest"),
   241	            f"{TESTFILE}::{gate}",
   242	            "-q",
   243	            "-p",
   244	            "no:cacheprovider",
   245	        ],
   246	        cwd=WT / "backend",
   247	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   248	        capture_output=True,
   249	        text=True,
   250	    )
   251	
   252	
   253	def main() -> int:
   254	    pristine = SCRIPT.read_bytes()
   255	    BACKUP.write_bytes(pristine)
   256	    results = []
   257	    ok = True
   258	    for name, old, new, gate in MUTATIONS:
   259	        content = SCRIPT.read_text(encoding="utf-8")
   260	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   261	        mutated = content.replace(old, new, 1)
   262	        if name.startswith("M7"):
   263	            m7b_old = "url_bearing_keys = [k for k, v in fm.items() if v and _looks_like_source_value(v)]"
   264	            assert m7b_old in mutated, "M7: 信号③b 原串不在场"
   265	            mutated = mutated.replace(m7b_old, "url_bearing_keys = []", 1)
   266	        if name.startswith(("M17", "M19")):
   267	            m6_old = "        if ai_word_hit:"
   268	            assert m6_old in mutated, f"{name}: 信号⑥原串不在场"
   269	            mutated = mutated.replace(m6_old, "        if False and ai_word_hit:", 1)
   270	        if name.startswith("M5"):
   271	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   272	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   273	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   274	            mutated = mutated.replace(looks_old, looks_rev, 1)
   275	        assert mutated != content, f"{name}: 替换后内容未变化"
   276	        SCRIPT.write_text(mutated, encoding="utf-8")
   277	        try:
   278	            r = run_gate(gate)
   279	            out = r.stdout + r.stderr
   280	            failed_marker = f"FAILED {TESTFILE}::{gate}"
   281	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   282	            results.append((name, gate, r.returncode, killed))
   283	            if not killed:
   284	                ok = False
   285	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   286	                print(out[-1500:])
   287	        finally:
   288	            SCRIPT.write_bytes(pristine)
   289	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   290	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   291	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   292	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
   293	    print()
   294	    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
   295	          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
   296	    return 0 if ok else 1
   297	
   298	
   299	if __name__ == "__main__":
   300	    sys.exit(main())

