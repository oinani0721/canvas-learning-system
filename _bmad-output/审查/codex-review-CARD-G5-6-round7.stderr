  1180	def test_url_without_host_is_not_primary_record(tmp_path):
  1181	    """⛔ H1 回归: `https://:443/x`、`https://user@/x` 没有 host —— 能过纯正则,
  1182	    但 `urlsplit(...).hostname` 为空, 不构成「一手来源」的机械证据。"""
  1183	    vault, out = base_vault(tmp_path)
  1184	    inbox = vault / "_待处理"
  1185	    mk(
  1186	        inbox / "空host端口.md",
  1187	        "---\nsource: https://:443/x\n---\n\n正文甲一。\n正文甲二。\n",
  1188	        age_days=4,
  1189	    )
  1190	    mk(
  1191	        inbox / "空host用户.md",
  1192	        "---\nsource: https://user@/x\n---\n\n正文乙一。\n正文乙二。\n",
  1193	        age_days=3,
  1194	    )
  1195	    # 正向对照: 带端口/查询/锚点的正常 URL 仍是一手来源
  1196	    mk(
  1197	        inbox / "带端口正常.md",
  1198	        "---\nsource: https://example.com:8443/a?b=c#d\n---\n\n正文丙一。\n正文丙二。\n",
  1199	        age_days=2,
  1200	    )
  1201	
  1202	    assert run_cli(vault, out).returncode == 0
  1203	    data = load_json(out)
  1204	    for name in ("空host端口.md", "空host用户.md"):
  1205	        it = item_by_name(data, name)
  1206	        assert it["criterion"] != "C1_source_url", name
  1207	        assert it["nomination_type"] != "primary-record", name
  1208	        # ⛔ round-4 MEDIUM: 只排除 C1 曾放过「C3 删除」类回归 —— 负例必须
  1209	        # 同时钉住「没有破坏性提名、不自信、无去向」
  1210	        assert it["verdict"] != "建议删", name
  1211	        assert it["confident"] is False, name
  1212	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1213	    pos = item_by_name(data, "带端口正常.md")
  1214	    assert pos["criterion"] == "C1_source_url"
  1215	    assert pos["nomination_type"] == "primary-record"
