  1529	def test_unparsed_source_with_duplicate_body_is_not_suggested_for_deletion(tmp_path):
  1530	    """⛔ round-4 BLOCKER-2: 非标准 source × 正文与库内逐字重复 → 不得建议删。
  1531	
  1532	    C4 只证明「剥掉 frontmatter 后正文相等」, 不证明「整个文件多余」—— 这份
  1533	    还带着一个独有的来源声明(冒号后无空格, 键正则不认)。来源信息必须在建议里
  1534	    摆到台面上; 摆不出来就不许删。护栏拦在 C4 出口, 降 C6 且重复证据留痕。"""
  1535	    vault, out = base_vault(tmp_path)
  1536	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1537	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1538	    mk(
  1539	        vault / "_待处理" / "带来源重复.md",
  1540	        "---\ntitle: 剪藏\nsource:https://unique.example/a\n---\n" + body,
  1541	        age_days=3,
  1542	    )
  1543	    # 正向对照: 无 source 的重复件 → 仍 C4 建议删 (护栏不得误伤存量判据)
  1544	    mk(vault / "_待处理" / "无来源重复.md", body, age_days=2)
  1545	    # 带普通元数据键的重复件 → 仍 C4 建议删, 但元数据必须挂冲突留痕
  1546	    mk(
  1547	        vault / "_待处理" / "带标签重复.md",
  1548	        "---\ntags: [剪藏, 待整理]\n---\n" + body,
  1549	        age_days=1,
  1550	    )
  1551	
  1552	    assert run_cli(vault, out).returncode == 0
  1553	    data = load_json(out)
  1554	    it = item_by_name(data, "带来源重复.md")
