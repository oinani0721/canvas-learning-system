   846	# ───────────────────────── 逐份提名（判据次序即本函数结构） ─────────────────────────
   847	
   848	
   849	def nominate(
   850	    item: dict,
   851	    text: str | None,
   852	    dup_index: dict[str, list[str]],
   853	    corpus_bodies: list[tuple[str, str]],
   854	    scan: dict,
   855	    batch_body_counts: dict[str, int],
   856	) -> dict:
   857	    """对一件材料出提名。**次序即 CRITERIA_ORDER**，先命中者定 verdict；
   858	    后续判据的证据仍全量附上（conflicts / exact_duplicate_of / near_duplicates）。"""
   859	    name = item["name"]
   860	    conflicts: list[dict] = []
   861	
   862	    if text is None:
   863	        # 非 UTF-8（PDF/图片等）：除 0 字节外无任何可机械判读的信号 → 不猜。
   864	        if item["size_bytes"] == 0:
   865	            return _fill(
   866	                item,
   867	                "C3_empty_or_skeleton",
   868	                V_DELETE,
   869	                None,
   870	                None,
   871	                "0 字节空文件",
   872	                True,
   873	                conflicts=conflicts,
   874	            )
   875	        return _fill(
   876	            item,
   877	            "C6_undecided",
   878	            V_UNSURE,
   879	            None,
   880	            None,
   881	            "非 UTF-8 文本，本引擎不解析其正文",
   882	            False,
   883	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
   884	            ask=UNDECIDED_ASK,
   885	            conflicts=conflicts,
   886	        )
   887	
   888	    fm_lines = split_frontmatter(text)[0]
   889	    fm = frontmatter_map(fm_lines)
   890	    typed_rows, unclosed_comment = _classify_lines_typed(text)
   891	    del typed_rows
   892	    substantive = has_substantive_content(text)
   893	    body = dup_body(text) if substantive else ""
   894	    rnd = round_of(name)
   895	    # C3 护栏信号（显式偏差 15）：frontmatter 里「看着像键但不被键正则认」的行。
   896	    unparsed_fm = [
   897	        ln.strip()
   898	        for ln in fm_lines
   899	        if ln.strip() and not ln.strip().startswith("#") and not _FM_KEY_RE.match(ln)
   900	    ]
   901	    # 未消化信号之四：边界规则拒掉的 AI 自述嫌疑（裸子串在场即算，见 raw_ai_marker）。
   902	    ai_suspect = raw_ai_marker(text)
   903	    # 未消化信号之六（round-6 BLOCKER-1）：独立词「AI」结构性信号 —— 不依赖
   904	    # 枚举表，frontmatter 值或文头任一行含独立词 AI 即算嫌疑。
   905	    ai_word_hit = next(
   906	        (
   907	            v
   908	            for v in [*fm.values(), *[ln for _, ln in head_window(text)]]
   909	            if _AI_WORD_RE.search(v)
   910	        ),
   911	        None,
   912	    )
   913	
   914	    # ── 后置证据（不参与次序，但必须全量呈现） ──
   915	    exact_all = sorted(dup_index.get(body, [])) if body else []
   916	    exact_of = exact_all[0] if exact_all else None
   917	    exact_others = exact_all[1:]
   918	    near = near_duplicates(body, corpus_bodies, scan)
   919	    within_batch = bool(body) and batch_body_counts.get(body, 0) > 1
   920	    if within_batch:
   921	        conflicts.append(
   922	            {
   923	                "kind": "duplicate_within_batch",
   924	                "detail": "本批内另有正文逐字相同的材料 —— 谁是正本在只读侧不可判，"
   925	                "故不产出建议删，请你指定保留哪一份",
   926	            }
   927	        )
   928	
   929	    def finish(criterion, verdict, ntype, target, basis, confident, **kw):
   930	        if exact_of and criterion != "C4_exact_duplicate":
   931	            conflicts.append(
   932	                {
   933	                    "kind": "exact_duplicate_under_other_verdict",
   934	                    "detail": f"正文与 {exact_of} 逐字相同，但按判据次序本件归 {criterion}"
   935	                    "（次序不因重复而改变，证据在此留痕）",
   936	                }
   937	            )
   938	        if near and criterion != "C6_undecided":
   939	            conflicts.append(
   940	                {
   941	                    "kind": "near_duplicate_suspected",
   942	                    "detail": "疑似与 "
   943	                    + "、".join(f"{n['path']}(ratio {n['ratio']})" for n in near)
   944	                    + " 高相似 —— 疑似不改提名、更不建议删，需你一句话确认",
   945	                }
   946	            )
   947	        return _fill(
   948	            item,
   949	            criterion,
   950	            verdict,
   951	            ntype,
   952	            target,
   953	            basis,
   954	            confident,
   955	            exact_of=exact_of,
   956	            exact_others=exact_others,
   957	            near=near,
   958	            conflicts=conflicts,
   959	            **kw,
   960	        )
   961	
   962	    # ── C1 source URL ──
   963	    src = fm.get("source", "")
   964	    if src and _is_primary_source_url(src):
   965	        return finish(
   966	            "C1_source_url",
   967	            V_STAY,
   968	            "primary-record",
   969	            None,
   970	            f"frontmatter source 为一手 URL：{src}",
   971	            True,
   972	        )
   973	
   974	    # ── C2 AI 自述 ──
   975	    hit = find_ai_marker(text)
   976	    if hit:
   977	        lineno, marker = hit
   978	        target = f"R{rnd}/" if rnd else DR_TARGET
   979	        return finish(
   980	            "C2_ai_self_declared",
   981	            V_ARCHIVE,
   982	            "secondary-synthesis",
   983	            target,
   984	            f"文头第 {lineno} 行自述「{marker}」"
   985	            + (f"；文件名带 R{rnd}_ 故归轮次目录" if rnd else ""),
   986	            True,
   987	        )
   988	
   989	    def _looks_like_source_value(v: str) -> bool:
   990	        """URL 前缀形态判定（⛔ 不要求可机判合法）：`https://:443/x` 这类损坏
   991	        URL 同样是来源声明 —— round-5 审查 BLOCKER-2 实证 `Source: <坏URL>` 曾
   992	        因值不合法穿透信号③b 被建议删。大小写不敏感。
   993	        ⛔ 先剥一层 Markdown autolink 角括号：`<https://…>` 是常见剪藏写法，
   994	        曾因首字符是 `<` 穿透本判定（round-6 BLOCKER-2）。"""
   995	        t = v.strip()
   996	        if t.startswith("<") and t.endswith(">"):
   997	            t = t[1:-1].strip()
   998	        return t.casefold().startswith(("http://", "https://"))
   999	
  1000	    # 信号③b：非 source 键名但值是 URL 形态（url:/URL:/Source: 等剪藏工具
  1001	    # 常见键名 —— round-5 自审 F2 实证它们曾穿透全部信号被建议删且 URL 零留痕；
  1002	    # 值损坏的别名见 `_looks_like_source_value`）。
  1003	    # 合法 source 键在此不可能出现（C1 已先行返回）。⚠️ C1 仍只认字面 source 键
  1004	    # （R8 稿约定）；本信号只把这类来源摆上台面降 C6，不扩大 C1。
  1005	    url_bearing_keys = [k for k, v in fm.items() if v and _looks_like_source_value(v)]
  1006	
  1007	    def undigested_reason() -> str | None:
  1008	        """⛔ 「未消化信号」统一护栏（显式偏差 15）：C3/C4 是仅有的两个产出
  1009	        「建议删」的判据，命中时若文件带有引擎未能完全消化的结构信号 ——
  1010	        未闭合注释 / 解析不成的 frontmatter 行 / 来源声明（source 键或任意
  1011	        URL 形态键值）/ 睡眠台账键 / AI 自述嫌疑 —— 一律降 C6 拿不准。
  1012	        判据收窄漏掉的文件曾掉进这两个判据被建议删（round-3 自审 H1-1/H3-1 +
  1013	        round-4 BLOCKER-1/BLOCKER-2 + round-5 自审 F2/F3 实证）；
  1014	        「安全」是路径属性：必须拦在两个出口，而不是只拦 C3。"""
  1015	        if unclosed_comment:
  1016	            return "文件以未闭合的 HTML 注释结尾（`<!--` 没等到 `-->`），哪些内容被吞掉引擎猜不了"
