   749	    这种不成立要跑两次才看得见, 所以在入口直接拒绝。"""
   750	    vault, _ = base_vault(tmp_path)
  1120	    data = load_json(out)
  1121	    assert data["schema_version"] == 1
  1122	    assert data["id_namespace"] == "inbox-item/v1"
  1123	    assert data["not_executed_disclaimer"]
