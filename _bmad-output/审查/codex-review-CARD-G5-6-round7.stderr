  1358	def test_md_multi_canonical_declares_undecidable_not_crowned(tmp_path):
  1359	    """⛔ H4 回归: JSON basis 声明「哪一份算正本不可判」时, 人读 MD §四不得再
  1360	    钦定「正本 `字典序首项`」—— 那与 basis 自相矛盾。单正本时 MD 仍明确给出
  1361	    正本路径 (正向对照同测, 防修过头)。只改 MD 渲染, JSON schema v1 冻结。"""
  1362	    vault, out = base_vault(tmp_path)
  1363	    body = "同一段被存过两次的正文。\n第二行。\n"
  1364	    mk(vault / "节点" / "甲本.md", body, age_days=40)
  1365	    (vault / "归档").mkdir()
  1366	    mk(vault / "归档" / "乙本.md", body, age_days=39)
  1367	    mk(vault / "_待处理" / "第三份.md", body, age_days=2)
  1368	    single = "只存过一次的正文。\n它的第二行。\n"
  1369	    mk(vault / "节点" / "唯一正本.md", single, age_days=40)
  1370	    mk(vault / "_待处理" / "唯一副本.md", single, age_days=3)
  1371	
  1372	    assert run_cli(vault, out).returncode == 0
  1373	    md = products(out)[1].read_text(encoding="utf-8")
  1374	    multi_line = next(ln for ln in md.splitlines() if ln.startswith("- **第三份.md**"))
  1375	    assert "不可判" in multi_line, f"MD 钦定了正本: {multi_line}"
  1376	    assert "正本 `" not in multi_line, multi_line
  1377	    assert "另有副本" not in multi_line, multi_line
  1378	    # 不可判 ≠ 不给线索: 两个候选路径都要向人呈现
  1379	    assert "节点/甲本.md" in multi_line and "归档/乙本.md" in multi_line
  1380	    single_line = next(ln for ln in md.splitlines() if ln.startswith("- **唯一副本.md**"))
  1381	    assert "正本 `节点/唯一正本.md`" in single_line
  1382	
