  1169	def test_missing_markdown_it_is_config_error(tmp_path, monkeypatch):
  1170	    """Codex round-8 M1: markdown_it 缺包 = 配置/环境错误 → LintConfigError (CLI rc=3),
  1171	    不许裸 ModuleNotFoundError 崩成 rc=1。sys.modules[name]=None 触发 import 语义的
  1172	    ImportError, 精准模拟缺包。"""
  1173	    import builtins
  1174	
  1175	    real_import = builtins.__import__
  1176	
  1177	    def fake_import(name, *a, **k):
  1178	        if name == "markdown_it" or name.startswith("markdown_it."):
  1179	            raise ImportError("simulated missing markdown_it")
  1180	        return real_import(name, *a, **k)
  1181	
  1182	    monkeypatch.setattr(builtins, "__import__", fake_import)
  1183	    setattr(vl, "_md", None)  # 重置 lazy 缓存
  1184	    with pytest.raises(vl.LintConfigError):
  1185	        vl._md_parser()
  1186	    with pytest.raises(vl.LintConfigError):
  1187	        vl.run_checks(_clean_vault(tmp_path / "v"), TODAY)  # run_checks 接线: 冒泡 → main 退 3
  1188	        # (须含 orphan_nodes —— mdit 只在 _wikilink_targets; 空目录 fail-fast 走不到)
  1189	    setattr(vl, "_md", None)  # 还原缓存, 防污染后续用例
     1	#!/bin/bash
     2	# CARD-G8-2 (BATCH-2026-09-01-第八批) — 变异负验证 (串行, 还原逐字节比对)
     3	# 判据 (Codex round-1 HIGH-7 收紧): rc==1 **且** 输出里出现指定门的 FAILED 行。
     4	#   rc∈{2,3,4} (usage/collection/internal error) = 指定门根本没跑 = 不算 KILLED;
     5	#   rc=5 (收集为空) 也不算。每轮输出存 transcript 进 evidence, 不再只有自报。
     6	# 教训锚 (MEMORY): 变异脚本必须串行; str.replace 不命中不报错 → 每处替换断言命中数;
     7	#                  EXIT trap 还原; bash 是 PIPESTATUS; argv 里的 \n 是字面两字符;
     8	#                  判据是"指定门红"不是"某处有失败"。
     9	set -u
    10	cd "$(dirname "$0")/../../.." || exit 9   # → LANE 根
    11	LANE="$PWD"
    12	SCRIPT="backend/scripts/vault_lint.py"
    13	TRANS_DIR="_bmad-output/审查/evidence-g82/mutation-transcripts"
    14	mkdir -p "$TRANS_DIR"
    15	PYTHONDONTWRITEBYTECODE=1
    16	export PYTHONDONTWRITEBYTECODE
    17	
    18	mutate_and_test() {
    19	  # $1=变异名 $2=python替换表达式(old|||new, \n 字面量) $3=pytest -k 表达式(指定门)
    20	  local name="$1" repl="$2" gate="$3" rc out
    21	  out="$TRANS_DIR/$name.txt"
    22	  cp "$SCRIPT" "$SCRIPT.bak-g82"
    23	  trap 'cp "$SCRIPT.bak-g82" "$SCRIPT" 2>/dev/null; rm -f "$SCRIPT.bak-g82"' EXIT INT TERM
    24	
    25	  python3 - "$repl" <<'PYEOF'
    26	import sys
    27	repl = sys.argv[1]
    28	def _conv(s):
    29	    # \\Q = 源码字面 \\n 的转义 (round-6 M16/M22 锚含正则 "\\n\\n" 字面,
    30	    #  不能被无差别换行转换吞掉)
    31	    return s.replace("\\Q", "\x00").replace("\\n", "\n").replace("\x00", "\\n")
    32	old, new = (_conv(s) for s in repl.split("|||"))
    33	p = "backend/scripts/vault_lint.py"
    34	src = open(p, encoding="utf-8").read()
    35	n = src.count(old)
    36	assert n == 1, f"替换锚必须恰命中 1 次, 实际 {n}: {old!r}"
    37	open(p, "w", encoding="utf-8").write(src.replace(old, new))
    38	PYEOF
    39	  if [ $? -ne 0 ]; then
    40	    echo "MUTANT $name: REPLACE-FAILED (锚不唯一/不命中) — 脚本缺陷, 不算通过"
    41	    cp "$SCRIPT.bak-g82" "$SCRIPT"; rm -f "$SCRIPT.bak-g82"
    42	    exit 9
    43	  fi
    44	
    45	  ( cd backend && .venv/bin/pytest tests/unit/test_vault_lint.py -q -p no:cacheprovider -k "$gate" ) > "$out" 2>&1
    46	  rc=$?
    47	  # 还原 + 逐字节比对 (先还原再判定, 防中途退出留毒)
    48	  cp "$SCRIPT.bak-g82" "$SCRIPT"
    49	  if ! cmp -s "$SCRIPT" "$SCRIPT.bak-g82"; then echo "MUTANT $name: RESTORE-MISMATCH"; exit 9; fi
    50	  rm -f "$SCRIPT.bak-g82"
    51	
    52	  # 判据: rc==1 且 **指定的那道门** 出现在 FAILED 行里 (HIGH-7: 光 rc!=0 不算)
    53	  if [ "$rc" -eq 1 ] && grep -q "FAILED tests/unit/test_vault_lint.py::.*${gate%% and *}" "$out"; then
    54	    echo "MUTANT $name: KILLED (rc=1, 指定门 [$gate] 的 FAILED 行在 transcript) ✓"
    55	  elif [ "$rc" -eq 0 ]; then
    56	    echo "MUTANT $name: SURVIVED (rc=0 — 指定门 [$gate] 没抓住) ❌"
    57	    FAILED="$FAILED $name"
    58	  else
    59	    echo "MUTANT $name: NOT-KILLED-BY-GATE (rc=$rc, 指定门 [$gate] 无 FAILED 行 — 收集错/别的错, 不算杀) ❌"
    60	    FAILED="$FAILED $name"
    61	  fi
    62	  tail -1 "$out"
    63	}
    64	
    65	FAILED=""
    66	echo "== CARD-G8-2 变异负验证 round-8 (串行; 判据 = 指定门的 FAILED 行) =="
    67	
