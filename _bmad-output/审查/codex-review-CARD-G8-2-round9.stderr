    22	ENV PYTHONPATH="/app:/app/src:${PYTHONPATH}"
    23	
    24	# Expose FastAPI port
    25	EXPOSE 8001
    26	
    27	# Start uvicorn
    28	CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]

