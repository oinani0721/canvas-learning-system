   471	def check_orphan_nodes(vault: Path) -> CheckResult:
   472	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   473	
   474	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   475	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   476	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   477	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   478	
   479	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   480	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   481	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   482	
   483	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   484	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   485	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   486	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   487	    """
   488	    node_root = vault / NODE_DIR
   489	    notes: list[str] = []
   490	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   491	
   492	    if not node_root.is_dir():
   493	        return CheckResult(
   494	            name="orphan_nodes",
   495	            status=FAIL,
   496	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   497	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   498	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   499	            details={"nodes_scanned": 0, "inbound_targets": 0},
   500	        )
   501	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   502	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   503	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   504	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   505	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   506	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   507	    inbound: dict[str, set[str]] = {}
   508	    nodes: list[Path] = []
   509	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   510	        srcs, src_blind = _walk_md(vault / src_dir)
   511	        for rel, why in src_blind.items():
   512	            blind[f"{src_dir}/{rel}"] = why
   513	        if src_dir == NODE_DIR:
   514	            nodes = srcs
   515	        for src in srcs:
   516	            blocked = _scan_block_reason(vault, src)
   517	            if blocked:
   518	                blind[src.relative_to(vault).as_posix()] = blocked
   519	                continue
   520	            text = _read_text(src)
   521	            if text is None:
   522	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   523	                continue
   524	            _fm, body = _split_frontmatter(text)
   525	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   526	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   527	            src_phys = os.path.realpath(src)
   528	            for target in _wikilink_targets(body):
   529	                inbound.setdefault(target, set()).add(src_phys)
   530	
   531	    findings: list[Finding] = []
   532	    for node in nodes:
   533	        own = node.relative_to(vault).as_posix()
   534	        blocked = _scan_block_reason(vault, node)
   535	        if blocked:
   536	            blind[own] = blocked
   537	            continue
   538	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   539	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   540	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   541	        #    realpath 归并, 不得绕过自身排除。
   542	        own_phys = os.path.realpath(node)
   543	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   544	        if sources:
   545	            continue
   546	        text = _read_text(node)
   547	        if text is None:
   548	            blind[own] = "unreadable"
   549	            continue
   550	        fm, _body = _split_frontmatter(text)
   551	        if _fm_scalar(fm, "source_board"):
   552	            continue
   553	        findings.append(
   554	            Finding(
   555	                own,
   556	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   557	                f"(自身出链不计), 且 frontmatter 无 source_board",
   558	            )
   559	        )
   560	
   561	    if blind:
   562	        notes.append(
   563	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   564	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   565	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   566	        )
   567	    notes.append(
   568	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   569	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   570	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   571	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   572	    )
   573	    status = WARN if (findings or blind) else OK
   574	    return CheckResult(
   575	        name="orphan_nodes",
   576	        status=status,
   577	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
