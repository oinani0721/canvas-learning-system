   440	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   441	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   442	
   443	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   444	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   445	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   446	    文件级检查), 再补两层本检查需要的:
   447	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   448	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   449	    """
   450	    if not root.is_dir():
   451	        return [], {}
   452	    blind: dict[str, str] = {}
   453	    dirs, files, cvr_blind = cvr._walk_vault(root)
   454	    for rel, why in cvr_blind:
   455	        blind[rel] = f"枚举盲区: {why}"
   456	    for d in dirs:
   457	        if d.is_symlink():
   458	            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
   459	    mds = sorted(f for f in files if f.suffix.lower() == ".md")
   460	    return mds, blind
   960	        "ineligible": {"placeholder": []},
   961	    }
   962	    (outside / "outputs" / "今日复习.json").write_text(json.dumps(payload), encoding="utf-8")
   963	    root = tmp_path / "v"
   964	    root.mkdir()
   965	    (root / "outputs").symlink_to(outside / "outputs", target_is_directory=True)
   966	    status, error, _gen = vl._projection_status(root, TODAY)
   967	    assert status == "corrupt", f"越界投影必须 corrupt, 实为 {status} ({error})"
   968	    assert "越出 vault" in (error or "") or "symlink" in (error or "")
   969	    # ⛔ 如实登记: 越界面本实现比 oracle **严** (oracle 不查越界直接读) —— 同源锁只锁
   970	    #    合法 v3 投影 (§「不比什么」), 这一分叉方向 = 更安全, 不做伪装对齐。
