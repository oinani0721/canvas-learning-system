  1113	# 3g. round-8 整改 —— AUTO 盲化等行数改写 (保 fence 连续性) / map 回原文转义判定
  1114	# ---------------------------------------------------------------------------
  1115	def test_auto_fence_cross_keeps_fence_state(tmp_path):
  1116	    """Codex round-8 H1: AUTO 段吞掉 fence opener 后, 跨段 fence 内的 [[A]] 不得
  1117	    被当正文入链 (切分逐段解析时代的 false-green)。等行数盲化保留 fence 标记行,
  1118	    整文解析 fence 状态连续 → A 报孤儿。"""
  1119	    root = tmp_path / "v"
  1120	    _node(root, "A")
  1121	    board_body = (
  1122	        "<!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py · source\n"
  1123	        "     note -->\n"
  1124	        "~~~text\n"
  1125	        "<!-- /AUTO-GENERATED -->\n"
  1126	        "[[A]]\n"
  1127	        "~~~\n"
  1128	    )
  1129	    _board(root, "板", board_body)
  1130	    res = vl.check_orphan_nodes(root)
  1131	    subjects = [f.subject for f in res.findings]
  1132	    assert "节点/A.md" in subjects, f"跨段 fence 状态丢失, [[A]] 被当入链: {res.findings}"
  1133	
