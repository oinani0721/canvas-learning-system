  1158	def test_html_entity_brackets_fail_closed(tmp_path):
  1159	    """Codex round-8 H3b: `&#91;&#91;A&#93;&#93;` 实体解码后的 [[ 在原文中无裸 [[ ——
  1160	    不采纳 (fail-closed 多报孤儿方向); Obsidian 实体行为未定, 差异登记「不比什么」。"""
  1161	    root = tmp_path / "v"
  1162	    _node(root, "A")
  1163	    _board(root, "板", "&#91;&#91;A&#93;&#93;\n")
  1164	    res = vl.check_orphan_nodes(root)
  1165	    subjects = [f.subject for f in res.findings]
  1166	    assert "节点/A.md" in subjects, f"实体形式被当真链接: {res.findings}"
