   300	def _split_frontmatter(text: str) -> tuple[str, str]:
   301	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   302	    m = _FRONTMATTER.match(text)
   303	    return (m.group(1), m.group(2)) if m else ("", text)
   304	
   305	
   306	def _fm_scalar(fm: str, key: str) -> str | None:
   307	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   308	
   309	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   310	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   311	    ⛔ YAML null 语义 (Codex round-1 MEDIUM-1b + round-2 MEDIUM-1): 只认**裸** null 字面
   312	    (null/Null/NULL/~), 且必须在剥引号**之前**判 —— `source_board: "null"` 是字面
   313	    字符串 "null" (YAML 引号 = 强制字符串), 不是 null。不含 "none": PyYAML 把
   314	    `none` 解析为普通字符串, 吞掉它 = 比 YAML 更宽 = 会误豁免真的叫 "none" 的值。
   315	    """
   316	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   317	    if not matches:
   318	        return None
   319	    v = matches[-1].strip()
   320	    if v in ("null", "Null", "NULL", "~"):
   321	        return None  # 裸 null 字面 (先于剥引号 —— 引号包裹的是字符串, 不是 null)
   322	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   323	        v = re.sub(r"\s+#.*$", "", v)
   324	    v = v.strip().strip('"').strip("'")
   325	    return v or None
   326	
   327	
   328	def _norm_key(name: str) -> str:
   329	    """入链匹配键: NFC 归一 + casefold。
   330	
   331	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   332	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   333	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   334	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   335	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   336	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   337	    (假阴)。该权衡进验收单「不比什么」表。
   338	    """
   339	    return unicodedata.normalize("NFC", name).casefold().strip()
   340	
   341	
   342	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   343	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   344	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   345	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   346	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   347	
