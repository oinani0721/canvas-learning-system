     2	# Story 1.1: Docker environment setup
     3	# Python 3.11-slim for minimal image size
     4	
     5	FROM python:3.11-slim
     6	
     7	WORKDIR /app
     8	
     9	# Install system dependencies (curl for healthcheck, build tools for some pip packages)
    10	RUN apt-get update && \
    11	    apt-get install -y --no-install-recommends curl build-essential zlib1g-dev && \
    12	    rm -rf /var/lib/apt/lists/*
