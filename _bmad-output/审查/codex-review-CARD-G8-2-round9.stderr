   169	@dataclass
   170	class CheckResult:
   171	    """单个检查的结论。
   172	
   173	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   174	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   175	    """
   176	
   177	    name: str
   178	    status: str  #: ok | warn | fail
   179	    summary: str
   180	    findings: list[Finding] = field(default_factory=list)
   181	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   182	    notes: list[str] = field(default_factory=list)
   183	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   184	    details: dict[str, Any] = field(default_factory=dict)
   185	
   186	
   187	@dataclass
   188	class LintReport:
   189	    vault: str
   190	    today: str
   191	    checks: list[CheckResult]
   192	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   193	    skipped: list[str] = field(default_factory=list)
   194	
   195	
   196	def exit_code(report: LintReport) -> int:
   197	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   198	    statuses = {c.status for c in report.checks}
   199	    if FAIL in statuses:
   200	        return EXIT_FAIL
   201	    if WARN in statuses:
   202	        return EXIT_WARN
   203	    return EXIT_OK
   204	
   205	
   206	def report_to_json(report: LintReport) -> dict[str, Any]:
   207	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   208	    return {
   209	        "vault": report.vault,
   210	        "today": report.today,
   211	        "summary": {
   212	            "exit_code": exit_code(report),
   213	            "checks_run": [c.name for c in report.checks],
   214	            "checks_skipped": list(report.skipped),
   215	            "status_counts": {s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)},
   216	        },
   217	        "checks": [
   218	            {
   219	                "name": c.name,
   220	                "status": c.status,
   221	                "summary": c.summary,
   222	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   223	                "notes": list(c.notes),
   224	                "details": dict(c.details),
   225	            }
   226	            for c in report.checks
   227	        ],
   228	    }
   229	
   230	
   231	def render_text(report: LintReport, *, color: bool = True) -> str:
   232	    """文本视图 —— 只读 `report`, 与 `report_to_json` 同源。
   233	
   234	    每个检查恰一行机读状态行 `{TAG} <name> status=<status> ...`, 同源门据此解析比对。
   235	    """
   236	
   237	    def c(code: str, s: str) -> str:
   238	        return f"{code}{s}{RESET}" if color else s
   239	
   240	    hue = {OK: GREEN, WARN: YELLOW, FAIL: RED}
   241	    out: list[str] = [
   242	        f"{c(DIM, 'vault')} {report.vault}",
   243	        f"{c(DIM, 'today')} {report.today} ({_DISPLAY_TZ_NAME})",
   244	    ]
   245	    for chk in report.checks:
   246	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   247	        for note in chk.notes:
   248	            out.append(f"    {c(DIM, 'note  ' + note)}")
   249	        for fd in chk.findings:
   250	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   251	    for name in report.skipped:
   252	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   253	    rc = exit_code(report)
   254	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   255	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   256	    return "\n".join(out)
