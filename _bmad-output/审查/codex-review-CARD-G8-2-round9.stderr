   796	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   797	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
   798	    "projection_freshness": "outputs/今日复习.json 的 generated_at 是否过期",
   799	}
   800	
   801	
   802	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   803	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   804	    if not vault.is_dir():
   805	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   806	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   807	    checks: list[CheckResult] = []
   808	    for name in selected:
   809	        if name == "orphan_nodes":
   810	            checks.append(check_orphan_nodes(vault))
   811	        elif name == "raw_derived_confusion":
   812	            checks.append(check_raw_derived(vault))
   813	        elif name == "projection_freshness":
   814	            checks.append(check_projection_freshness(vault, today))
   815	    return LintReport(
   816	        vault=str(vault),
   817	        today=today.isoformat(),
   818	        checks=checks,
   819	        skipped=[n for n in CHECKS if n not in selected],
   820	    )
   821	
   822	
   823	def _utcnow() -> datetime:
   824	    """时钟缝 (Codex round-1 MEDIUM-2): 唯一的取当前时刻处, 测试 patch 它来锁
   825	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   826	    return datetime.now(timezone.utc)
   827	
   828	
   829	def resolve_today(now: str | None) -> date:
   830	    """`--now` → 上海本地日。
   831	
   832	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   833	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   834	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   835	    """
   836	    if now is None:
   837	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   838	    try:
   839	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   840	    except ValueError as exc:
   841	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   842	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   843	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   844	    try:
   845	        return dt.astimezone(_TZ_SHANGHAI).date()
   846	    except (OverflowError, OSError) as exc:
   847	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   848	
   849	
   850	_EPILOG = f"""
   851	检查项与状态分级 (ok/warn/fail 的判定规则, Codex round-1 MEDIUM-4 要求写进 --help):
   852	  orphan_nodes            {CHECKS["orphan_nodes"]}
   853	                            warn = 有孤儿或有扫描盲区 (symlink/不可读, 盲区里的文件未参与判定);
   854	                            fail = `节点/` 目录不存在 (检查没查成, 不是零孤儿)
   855	  raw_derived_confusion   {CHECKS["raw_derived_confusion"]}
   856	                            warn = 有混淆 finding (G1/G2/G3/G4/G9 或 回顾-* 缺 type: recap),
   857	                            或存在扫描盲区 (G8/G10/G11 / recap 越界拒读 —— "没查全" ≠ "没问题");
   858	                            本检查无 fail 态
   859	  projection_freshness    {CHECKS["projection_freshness"]}
   860	                            warn = stale (今天还没跑推送) 或 no_projection;
   861	                            fail = corrupt (投影文件坏, 下游拿不到数据)
   862	
   863	退出码:
   864	  0  全部检查 ok
   865	  2  有 warn、无 fail
   866	  1  有 fail
   867	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法 /
   868	      参数用法错误)
   869	
   870	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   871	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   872	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   873	   "vault 有问题" 与 "lint 没跑成"。参数用法错误也归 3 (Codex round-1 HIGH-6:
   874	   argparse 默认 exit(2) 会与"有 warn"撞码)。
   875	
   876	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   877	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   878	"""
   879	
   880	
   881	class _LintArgumentParser(argparse.ArgumentParser):
   882	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   883	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   884	
   885	    def error(self, message: str):  # type: ignore[override]
   886	        self.print_usage(sys.stderr)
   887	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   888	        raise SystemExit(EXIT_CONFIG)
   889	
   890	
   891	def main(argv: list[str] | None = None) -> int:
   892	    ap = _LintArgumentParser(
   893	        prog="vault_lint.py",
   894	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   895	        epilog=_EPILOG,
   896	        formatter_class=argparse.RawDescriptionHelpFormatter,
   897	    )
   898	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   899	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   900	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   901	    ap.add_argument(
   902	        "--only",
   903	        action="append",
   904	        choices=sorted(CHECKS),
   905	        default=None,
   906	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   907	    )
   908	    args = ap.parse_args(argv)
   909	
   910	    try:
   911	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   912	    except LintConfigError as exc:
   913	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   914	        return EXIT_CONFIG
   915	
   916	    if args.json:
   917	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   918	    else:
   919	        print(render_text(report, color=sys.stdout.isatty()))
   920	    return exit_code(report)
   921	
   922	
   923	if __name__ == "__main__":
   924	    sys.exit(main())
