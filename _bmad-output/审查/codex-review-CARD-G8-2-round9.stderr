    89	#    指定门: 同源锁 SUMMARIZE 组 (活 oracle 比对出分叉)
    90	mutate_and_test "M5-非str不corrupt" \
    91	  '    if not isinstance(gen, str):\n        return "corrupt", f"generated_at 应为字符串, 实为 {type(gen).__name__}", None|||    if False:\n        pass' \
    92	  "test_freshness_lock_with_live_oracle and SUMMARIZE"
