  1147	def test_escaped_brackets_are_not_wikilink(tmp_path):
  1148	    """Codex round-8 H3a (Obsidian 规则): `\\[\\[A\\]\\]` 转义方括号不生成链接 ——
  1149	    不得采纳为 A 的入链 (真无链 baseline = A 报孤儿)。"""
  1150	    root = tmp_path / "v"
  1151	    _node(root, "A")
  1152	    _board(root, "板", "\\[\\[A\\]\\]\n")
  1153	    res = vl.check_orphan_nodes(root)
  1154	    subjects = [f.subject for f in res.findings]
  1155	    assert "节点/A.md" in subjects, f"转义方括号被当真链接: {res.findings}"
