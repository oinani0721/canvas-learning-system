  1135	def test_unclosed_auto_segment_blinds_to_eof(tmp_path):
  1136	    """Codex round-8 H2: 未闭合 AUTO 段到 EOF 不得降级成普通正文 —— 机器成员
  1137	    [[A]] 必须保持盲, A 报孤儿。"""
  1138	    root = tmp_path / "v"
  1139	    _node(root, "A")
  1140	    board_body = "<!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py · source\n     note -->\n- [[A]]\n"
  1141	    _board(root, "板", board_body)
  1142	    res = vl.check_orphan_nodes(root)
  1143	    subjects = [f.subject for f in res.findings]
  1144	    assert "节点/A.md" in subjects, f"未闭合 AUTO 段降级, 机器成员豁免了 A: {res.findings}"
