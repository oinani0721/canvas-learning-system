   349	def _blind_auto_lines(body: str) -> str:
   350	    """AUTO-GENERATED 哨兵段内的行替换为单行 HTML 注释（等行数），其余行原样。
   351	
   352	    ⛔ r8 H1/H2 教训：**按段切分再逐段解析会丢失跨段 Markdown 状态**（AUTO 段吞掉
   353	    fence opener 后，剩余段重新 parse 会把 fence 内的 [[A]] 当正文）；未闭合 AUTO 段
   354	    到 EOF 被降级成普通正文同样制造假绿。等行数盲化保持 Markdown 连续性：
   355	      - AUTO 段内普通行（成员列表/NOTE/END）→ `<!--x-->` 注释行，mdit 天然忽略；
   356	      - AUTO 段内的 fence 标记行**原样保留** —— 它们控制 fence 开合状态, 保证
   357	        AUTO 段吞掉的 fence opener 仍能在整文解析中正确开合（r8 H1 反例）;
   358	      - 未闭合 AUTO 段到 EOF（r8 H2）→ 所有行都已盲化, 机器成员不泄漏。
   359	    """
   360	    out_lines: list[str] = []
   361	    in_auto = False
   362	    for line in body.splitlines(keepends=True):
   363	        stripped = line.strip()
   364	        if in_auto:
   365	            if re.match(r"^(`{3,}|~{3,})", stripped):
   366	                out_lines.append(line)  # fence 标记行原样保留, 维持开合状态
   367	            else:
   368	                out_lines.append("<!--x-->\n" if line.endswith("\n") else "<!--x-->")
   369	            if _AUTO_END_RE.match(stripped):
   370	                in_auto = False
   371	            continue
   372	        if _AUTO_BEGIN_RE.match(stripped):
   373	            in_auto = True
   374	            out_lines.append("<!--x-->\n" if line.endswith("\n") else "<!--x-->")
   375	            continue
   376	        out_lines.append(line)
   377	    return "".join(out_lines)
   378	
   379	
   380	def _wikilink_targets(body: str) -> set[str]:
   381	    """正文里全部 wikilink 的 basename 集合（已归一）—— **token 流法**。
   382	
   383	    ⛔ round-7 终局重构（r8 H1/H2 再修）：rounds 2-7 手写的 Markdown 剥除/区间解析
   384	      （正则反向引用 → maximal run 配对 → 字符偏移区间 → AUTO 切分逐段解析）每轮
   385	      修复都开新洞。重演 G8-1 的核心教训「不重新实现解析」：
   386	      - `_blind_auto_lines` 先把 AUTO 哨兵段盲化为等行数注释行（**保留 fence 标记
   387	        行**以维持 Markdown 连续性）；
   388	      - 整文喂 **markdown-it-py**（venv 既有依赖 4.0.0, 各轮审查的对照裁判）：
   389	        block 级 fence/code_block/html_block 整块不扫；inline 级只扫 `text` children；
   390	        closer 等长 / 转义反引号 / maximal run / 跨段落 / 容器嵌套全部库内正确处理。
   391	
   392	    ⛔ r8 H3：text.content 是 mdit **解码后**的文本 —— 原文 `\\[\\[A\\]\\]`（反斜杠
   393	       转义, Obsidian 不生成链接）与 `&#91;&#91;`（HTML 实体）解码后都变成 "[[A]]"。
   394	       破解：inline token 的 `map` 给出所在**原文行区间**, 采纳前回原文行确认存在
   395	       **未被反斜杠转义**的 `[[`（`(?<!\\\\)\\[\\[`）; 实体形式原文无裸 `[[`, 同样
   396	       不采纳（方向 = 多报孤儿, 人工核真伪, 见「不比什么」）。
   397	
   398	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   399	    （`_WIKILINK` + `wikilink_basename`）与 `board_manifest_service.py:132`
   400	    （`resolve_node_id`）—— 三者本就同规则。
   401	
   402	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   403	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   404	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   405	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   406	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   407	
   408	    覆盖形态（各有测试用例）：`[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   409	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`（含 `.MD` 大写）。**不**覆盖：AUTO 哨兵段
   410	    （含未闭合到 EOF）、fenced/indented code、行内 code、HTML 注释/块、blockquote/list
   411	    容器内的 code、转义反引号、跨行 `[[..]]`、空 `[[]]`、`\\[\\[` 转义方括号、HTML 实体
   412	    形式的 `[[`。
   413	    """
   414	    blinded = _blind_auto_lines(body)
   415	    src_lines = body.splitlines()
   416	    md = _md_parser()
   417	    out: set[str] = set()
   418	    for token in md.parse(blinded):
   419	        if token.type != "inline" or not token.children:
   420	            continue  # fence/code_block/html_block 等 block 级: 整块不扫
   421	        token_map = token.map or [0, 1]
   422	        for child in token.children:
   423	            if child.type != "text" or "[[" not in child.content:
   424	                continue  # code_inline/html_inline/softbreak 等: 不扫
   425	            # ⛔ r8 H3: 采纳前回**原文行**确认裸 `[[`（未转义）—— content 已被
   426	            # mdit 解码, 转义/实体形态的假 [[ 在这一步被拒。
   427	            has_raw_open = any(
   428	                re.search(r"(?<!\\)\[\[", src_lines[i]) for i in range(token_map[0], min(token_map[1], len(src_lines)))
   429	            )
   430	            if not has_raw_open:
   431	                continue
   432	            for m in _WIKILINK.finditer(child.content):
   433	                inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   434	                inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   435	                if inner:
   436	                    out.add(_norm_key(inner))
   437	    return out
   438	
