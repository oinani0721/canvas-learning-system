  2904	def test_round8_stable_scored_at(vault):
  2905	    """三个时刻各答一个问题（round-8 的 3 条 BLOCKER 都源于把它们混在一起）：
  2906	
  2907	    · `recorded_at`        = 这条日志行**何时写的**（每次续跑都变）
  2908	    · `payload.review_time` = **A3 采用后**的业务时刻（≤W 时被推成 W+1s）
  2909	    · `payload.scored_at`   = **原始**稳定业务时刻（评分那一刻记一次，续跑不变）
  2910	
  2911	    envelope 比 `scored_at`，不比 `review_time` —— 后者被 A3 改过。
  2912	
  2913	    ⚠️ **这组门补的是 round-8 MEDIUM 指出的测试盲区**：此前 181 次 `_payload()`
  2914	    调用只有 11 次显式传 `review_time`，且所有首写都令 `review_time == ts`，
  2915	    于是「首写用了哪个时刻」这个区别**在测试数据里根本不存在**，3 条 BLOCKER 全绿。
  2916	    """
  2917	    LED = vault / "learning_events.jsonl"
  2918	
  2919	    def _fresh():
  2920	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2921	        LED.unlink(missing_ok=True)
  2922	
  2923	    # ── B① 首写也必须用稳定业务时刻（此前只有重试 candidate 用，首写仍用 ts）
  2924	    _fresh()
  2925	    w0 = (vault / NODE_REL).read_text(encoding="utf-8")
  2926	    r1 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts="2026-08-01T10:05:00Z", review_time=TS1))
  2927	    assert r1.returncode == 0, r1.stderr[:300]
  2928	    row = list(_ledger_lines(vault))[0]
  2929	    assert row["recorded_at"] == "2026-08-01T10:05:00Z", "recorded_at = 日志行何时写的"
  2930	    assert row["payload"]["scored_at"] == TS1, f"scored_at = 原始稳定业务时刻: {row['payload']}"
  2931	    # 模拟 append 后崩溃 → 以**同样的稳定时刻**续跑，必须能恢复
  2932	    (vault / NODE_REL).write_text(w0, encoding="utf-8")
  2933	    r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts="2026-08-01T10:06:00Z", review_time=TS1))
  2934	    assert r2.returncode == 0, f"崩溃后按原始稳定时刻续跑必须可恢复: {r2.stderr[:300]}"
  2935	    assert len(_ledger_lines(vault)) == 1, "续跑不得新增账本行"
  2936	    assert _run_validator(vault).returncode == 0
  2937	
  2938	    # ── B② A3 生效时（时刻 ≤ W）采用值与原始值分离，续跑仍可恢复
  2939	    _fresh()
  2940	    assert _run_writer_settled(vault, _payload(event_id="E0#q1", ts=TS1, review_time=TS1)).returncode == 0
  2941	    w1 = (vault / NODE_REL).read_text(encoding="utf-8")
  2942	    assert _run_writer_settled(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1)).returncode == 0
  2943	    last = list(_ledger_lines(vault))[-1]
  2944	    assert last["payload"]["review_time"] == "2026-08-01T10:00:01Z", f"A3 应把采用值推成 W+1s: {last['payload']}"
  2945	    assert last["payload"]["scored_at"] == TS1, "原始时刻不受 A3 影响"
  2946	    (vault / NODE_REL).write_text(w1, encoding="utf-8")
  2947	    r3 = _run_writer_settled(vault, _payload(event_id="E1#q1", ts="2026-08-01T10:10:00Z", review_time=TS1))
  2948	    assert r3.returncode == 0, f"A3 采用值不进等价面，续跑必须可恢复: {r3.stderr[:300]}"
  2949	
  2950	    # ── B③ 缺稳定时刻必须 fail-closed，**不回抄 durable**
  2951	    _fresh()
  2952	    base = _payload(event_id="板A#q1", ts=TS1)
  2953	    del base["review_time"]
  2954	    rb = _run_writer(vault, base)
  2955	    assert rb.returncode != 0, "缺稳定业务时刻不得回抄 durable（那会让整条修复失效）"
  2956	    assert "缺稳定业务时刻" in rb.stderr, rb.stderr[:250]
  2957	    assert not LED.exists() or not _ledger_lines(vault), "不得先落账"
  2958	
  2959	    # ── 验伪：同 ID **换了业务时刻**仍必须被识别
  2960	    _fresh()
  2961	    v0 = (vault / NODE_REL).read_text(encoding="utf-8")
  2962	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  2963	    (vault / NODE_REL).write_text(v0, encoding="utf-8")
  2964	    rx = _run_writer_settled(
  2965	        vault, _payload(event_id="板A#q1", ts="2026-12-31T10:00:00Z", review_time="2026-12-31T10:00:00Z")
  2966	    )
  2967	    assert rx.returncode != 0, "同 ID 承载另一业务时刻必须冲突"
  2968	    assert "envelope 冲突" in rx.stderr, rx.stderr[:250]
