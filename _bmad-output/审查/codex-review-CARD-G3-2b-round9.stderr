   151	RESULTS: list[tuple[str, bool, str]] = []
   152	
   153	
   154	def check(tag: str, ok: bool, detail: str) -> None:
   155	    RESULTS.append((tag, ok, detail))
   156	    print(f"  [{'PASS' if ok else 'FAIL'}] {tag}: {detail}")
   157	
