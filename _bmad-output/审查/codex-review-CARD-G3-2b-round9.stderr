   633	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   634	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   635	def _bridge(fm_text, gn, ab, ts, rating=None):
   636	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   637	    if rating is not None:
   638	        payload_in["rating"] = rating
   639	    try:
   640	        _r = subprocess.run(
   641	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   642	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   643	    except Exception as _e:
   644	        return None, str(_e)
   645	    try:
   646	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   647	    except ValueError:
   648	        _out = {}
   649	    if _r.returncode == 2:
   650	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
