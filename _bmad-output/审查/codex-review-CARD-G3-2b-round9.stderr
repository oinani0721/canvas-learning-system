   174	
   175	#: A7 上界分两档 (round-7 MEDIUM: 原实现把一个上界通用到所有时间字段,
   176	#: 导致合法 review_time=9000 产出的 due=9000-01-09 反被判 degraded)
   177	#: ① review 域上界 — 调度会在其上叠加 interval, A3 还要 +1s。
   178	#: ⚠️ round-9 闭包修正: `review_time` 与 `fsrs_last_review`(W) **同域同界且
   179	#: 均须严格小于**该值 —— 否则合法的 review_time=9000 写出 W=9000 后,
   180	#: 分类器立刻判 degraded (合法事件确定性制造残缺卡)。
   181	REVIEW_INPUT_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   182	#: ② 一般时间戳上界 (recorded_at/effective_at/fsrs_due 等) — 只拦 UTC
   183	#: 归一化本身会溢出的极端值, 不施加 review 输入的保守上界
   184	TIMESTAMP_MAX = datetime(9500, 1, 1, tzinfo=timezone.utc)
   185	#: 可调度数值域 (§6.2 三态)。
   186	#: ⚠️ round-7: stability **无 36500 上界** — FSRS 封顶的是 interval 不是
   187	#: stability (实测连续 7 次 Easy 后 S=68949 > 36500, 原规则会误报合法卡)。
   188	#: ⚠️ round-8: 但"任意有限正数"又过宽 — S=1.797e308 判 normal 而真实
   189	#: bridge 抛 OverflowError(float infinity to integer)。
   190	#: 取 1e9 天(约 274 万年)作**语义合理性上界**, 方向 fail-closed:
   191	#:   - 技术可执行边界更高(实测 1e100 仍可执行, 1.797e308 才溢出);
   192	#:   - 但真实语义远低于此(Easy 链实测 7 万量级, maximum_interval 封顶
   193	#:     36500 天), 超过 1e9 天必是数据损坏;
   194	#:   - 因此 1e9~1e100 区间**虽技术可执行仍判 degraded** — 有意的保守偏差
   195	#:     (停下来要人工确认), 不是误判。
   196	STABILITY_MAX = 1e9
   197	DIFFICULTY_RANGE = (1.0, 10.0)
   198	#: 纯整数词法 (round-7: float() 判整数会让 "1.0" 通过, 而 bridge 的
   199	#: int("1.0") 实测抛 ValueError)
   200	_INT_LEXEME_RE = re.compile(r"^[+-]?\d+$")
   201	
   202	
   203	def _finite_number(value: object) -> Optional[float]:
   204	    """有限实数 (排除 bool / NaN / ±Inf / 不可解析) → float; 否则 None。"""
   205	    if isinstance(value, bool) or value is None:
   206	        return None
   207	    try:
   208	        if isinstance(value, (int, float)):
   209	            # round-9 MEDIUM: float(10**309) 抛 OverflowError — 须 fail-closed
   210	            number = float(value)
  1190	            prelude.extend(scan_problems)
  1191	    try:
  1192	        return prelude + _verify_proof_level(
  1193	            proof, applicable, scan=scan, ledger_raw=ledger_raw, ledger_vault_id=ledger_vault_id
  1194	        )
  1195	    except RecursionError:
  1196	        return prelude + [f"ancestor_proof 链过深, 递归耗尽栈 (上限 {PROOF_MAX_DEPTH} 层) — 疑似自引用或异常构造"]
  1197	
