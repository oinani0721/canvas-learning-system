   203	def r2():
   204	    print("\n── R2 (BLOCKER) 小数秒 / 非 UTC durable review_time → 必须 fail-closed ──")
   205	    for bad, why in (("2026-08-01T10:00:00.500Z", "小数秒"), ("2026-08-01T18:00:00+08:00", "非 UTC")):
   206	        v = new_vault(f"r2-{why}")
   207	        assert run(v).returncode == 0
   208	        base = rows(v)[0]
   209	        (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   210	        t = json.loads(json.dumps(base))
   211	        t["payload"]["review_time"] = bad
   212	        t["effective_at"] = bad
   213	        write_rows(v, t)
   214	        s = sha(v / NODE_REL)
   215	        r = run(v)
   216	        check(
   217	            f"R2/{why}-dup路径",
   218	            r.returncode != 0 and why in r.stderr and sha(v / NODE_REL) == s,
   219	            f"rc={r.returncode} 节点零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   220	        )
   221	        rf = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   222	        check(
   223	            f"R2/{why}-foreign pending 路径",
   224	            rf.returncode != 0 and why in rf.stderr and len(rows(v)) == 1,
   225	            f"rc={rf.returncode} 账本={len(rows(v))}行",
   226	        )
   227	
