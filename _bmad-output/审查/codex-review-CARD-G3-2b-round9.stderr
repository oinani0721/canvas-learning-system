    62	def new_vault(tag: str, node_text: str = NODE_V0) -> Path:
    63	    vault = CE_ROOT / tag / "repo" / "canvas-vault"
    64	    repo = vault.parent
    65	    (vault / "节点").mkdir(parents=True)
    66	    (vault / ".claude" / "scripts").mkdir(parents=True)
    67	    (repo / "backend" / "scripts").mkdir(parents=True)
    68	    (repo / "backend" / ".venv").symlink_to(WT / "backend" / ".venv", target_is_directory=True)
    69	    (repo / "backend" / "scripts" / "validate_learning_events.py").symlink_to(VALIDATOR)
    70	    (vault / ".claude" / "scripts" / "fsrs_bridge.py").symlink_to(VAULT_SCRIPTS / "fsrs_bridge.py")
    71	    (vault / ".claude" / "scripts" / "decay_beta.py").symlink_to(VAULT_SCRIPTS / "decay_beta.py")
    72	    (vault / ".canvas-config.yaml").write_text(CONFIG, encoding="utf-8")
    73	    (vault / NODE_REL).write_text(node_text, encoding="utf-8")
    74	    return vault
    75	
    76	
    77	def run(vault: Path, **over):
    78	    payload = {
    79	        "node": NODE_REL,
    80	        "grade_norm": 0.752,
    81	        "ts": TS1,
    82	        # 稳定业务时刻（检验白板 Step 3 的 scored_at）。默认与 ts 同值；
    83	        # 只改 ts 表示「同一次评分的续跑」，同时给 event_id 表示「另一次评分」。
    84	        "review_time": TS1,
    85	        "event_id": EID,
    86	        "exam_board": "检验白板/测试检验-2026-08-01-1000.md",
    87	        "question_id": "q1",
    88	        "source_board": "[[原白板/CS 61B]]",
    89	        "self_confidence_raw": "半懂",
    90	        "self_confidence_norm": 0.5,
    91	        "abandoned": False,
    92	        "callout": "",
    93	    }
    94	    if "ts" in over and "review_time" not in over and "event_id" in over:
    95	        payload["review_time"] = over["ts"]
    96	    payload.update(over)
    97	    pfile = vault.parent / "payload.json"
    98	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    99	    return subprocess.run(
   100	        [sys.executable, "-c", CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))],
   101	        capture_output=True,
   102	        text=True,
   103	        timeout=180,
   104	        cwd=str(vault),
   105	        env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"),
   106	    )
   107	
   108	
   109	def run_settled(vault: Path, **over):
   110	    """跑写点；若因「A2 恢复先落定」被要求重跑，就再跑一次并返回合并结果。
   111	
   112	    存在 foreign pending 时写点会先把恢复结果原子发布、再以非零码退出要求重跑
   113	    （Codex round-3 BLOCKER 的修法：恢复与新写不在同一次运行里混做）。
   114	    """
   115	    r = run(vault, **over)
   116	    if r.returncode != 0 and "恢复已落定" in r.stderr:
   117	        r2 = run(vault, **over)
   118	        return subprocess.CompletedProcess(r2.args, r2.returncode, r.stdout + r2.stdout, r.stderr + r2.stderr)
   119	    return r
   120	
   121	
   122	def rows(vault: Path):
   123	    p = vault / "learning_events.jsonl"
   124	    return [json.loads(x) for x in p.read_text(encoding="utf-8").splitlines() if x.strip()] if p.exists() else []
   125	
   126	
   127	def write_rows(vault: Path, *recs, trailing_lf=True):
   128	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs)
   129	    (vault / "learning_events.jsonl").write_text(text if trailing_lf else text[:-1], encoding="utf-8")
   130	
   131	
   132	def sha(p: Path) -> str:
   133	    return hashlib.sha256(p.read_bytes()).hexdigest()
   134	
   135	
   136	def fsrs_fields(vault: Path) -> dict:
   137	    fm = (vault / NODE_REL).read_text(encoding="utf-8").split("---\n")[1]
   138	    out = {}
   139	    for k in ("fsrs_due", "fsrs_state", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   140	        m = re.search(rf'^{k}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   141	        if m:
   142	            out[k] = m.group(1)
   143	    return out
   144	
   145	
   146	def last_line(text: str) -> str:
   147	    lines = text.strip().splitlines()
   148	    return lines[-1][:110] if lines else ""
   149	
