    26	FIXTURE_ROOT = Path("/private/tmp/card-g3-2b-fixture")
    27	CE_ROOT = FIXTURE_ROOT / "counterexamples"
    28	MARKER = ".g32b-fixture-marker"
    29	WT = Path(__file__).resolve().parents[2]
    30	SKILL = WT / "canvas-vault" / ".claude" / "skills" / "quiz-answer" / "SKILL.md"
    31	VAULT_SCRIPTS = WT / "canvas-vault" / ".claude" / "scripts"
    32	VALIDATOR = WT / "backend" / "scripts" / "validate_learning_events.py"
    33	SCHEMA_DOC = WT / "docs" / "learning-events-schema-v1.md"
