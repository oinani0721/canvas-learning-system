  1472	def validate_record(record: object, manifest: Optional[dict] = None, vault_id: Optional[str] = None) -> list[str]:
  1473	    """单条 v1 记录的违规清单 (空 = 合规); 便捷入口, 丢弃 warnings。"""
  1474	    return validate_record_full(record, manifest, vault_id)[0]
