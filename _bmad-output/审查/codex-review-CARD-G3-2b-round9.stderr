   353	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   354	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   355	# 出现重复时停下, 不猜)。误报方向 fail-closed (顶格错位文本会被当键) 可接受。
   356	FSRS_KEYS = ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review")
   357	_watched = ("type", "source_board", "mastery_score", "mastery", "mastery_level",
   358	            "mastery_a", "mastery_b", "attempt_count", "last_examined", "calibration_log") + FSRS_KEYS
