  2971	def test_round8_high_findings(vault):
  2972	    """H① 无 marker 历史行的 out_of_order 无契约语义；H② 校准 header 容 YAML
  2973	    尾注释；H③ event_id 空白门只管本节点。"""
  2974	    LED = vault / "learning_events.jsonl"
  2975	
  2976	    # ── H① 无 marker 的历史行带 out_of_order 不得被当补录通道
  2977	    def _chain(e1_count):
  2978	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2979	        LED.unlink(missing_ok=True)
  2980	        for eid, ts in (("E1#q1", TS1), ("L2#q1", "2026-08-01T11:00:00Z"), ("L3#q1", "2026-08-01T12:00:00Z")):
  2981	            assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts, review_time=ts)).returncode == 0
  2982	        rows = list(_ledger_lines(vault))
  2983	        rows[0]["payload"]["attempt_count"] = e1_count
  2984	        rows[1]["payload"] = {"exam_board": "旧板", "note": "无 count", "out_of_order": True}
  2985	        rows[2]["payload"] = {"exam_board": "旧板", "note": "有 count", "attempt_count": 3}
  2986	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
