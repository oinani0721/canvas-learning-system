   355	def n1_n5():
   356	    """round-1 后续：Codex 正文被内容过滤器拦下，按 stderr 保留的推理标题线索
   357	    逐条实测出的五个残留面（4 条复现为真缺陷 + 1 条诊断不精确）。"""
   358	    print("\n── N1 (BLOCKER) 标 out_of_order 但 review_time > W：被伪装成乱序的真实后继 ──")
   359	    v = new_vault("n1")
   360	    late = _pending_row(out_of_order=True, review_time="2026-08-05T10:00:00Z")
   361	    late["effective_at"] = "2026-08-05T10:00:00Z"
   362	    write_rows(v, late)
   363	    s = sha(v / NODE_REL)
   364	    r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   365	    check(
   366	        "N1/伪装成乱序的后继",
   367	        r.returncode != 0 and "伪装成乱序的真实后继" in r.stderr and sha(v / NODE_REL) == s,
   368	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   369	    )
   370	    for bad in (False, "true", 1):
   371	        write_rows(v, _pending_row(out_of_order=bad))
   372	        rb = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   373	        # round-5 后完整校验前移到乱序分流之前 ⇒ 坏形态先被**校验器本体**拦
   374	        # (两侧同口径), 写点自己的形态门成了其后的第二道。两种拒因都算达标,
   375	        # 但必须点名是这两者之一 —— 不能退化成「随便什么理由拒了都行」。
   376	        _why_ok = ("形态非法" in rb.stderr) or ("out_of_order 唯一合法值" in rb.stderr)
   377	        check(f"N1/形态 {bad!r} 非法", rb.returncode != 0 and _why_ok, f"rc={rb.returncode} | {last_line(rb.stderr)}")
   378	    (v / "learning_events.jsonl").unlink()
   379	    assert run(v).returncode == 0
