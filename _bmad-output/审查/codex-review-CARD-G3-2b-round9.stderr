   422	def _fm_has_event(fm_text, ev_id):
   423	    # ⛔ 容 YAML 尾注释 (Codex round-8 HIGH): `calibration_log: # keep` 是**合法
   424	    # YAML**, 而原正则要求行尾必须干净 ⇒ 找不到 header ⇒ F1 假阴性 ⇒ 同 ID 重跑
   425	    # 报「FSRS 已应用但缺校准记录」, 两阶段续跑**永久停住**(实测账本仍 1 行、
   426	    # 节点不再变化)。
   427	    mcal = re.search(r'^calibration_log:[ \t]*(?:#[^\n]*)?$', fm_text, re.M)
   428	    if not mcal:
   429	        return False
   430	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   431	        if ln and not ln[0].isspace():
   432	            break
   433	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   434	        if mm:
   435	            v = mm.group(1).strip()
   436	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   437	                try:
   438	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   439	                except ValueError:
   440	                    pass
   441	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   442	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   443	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   444	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   445	                v = v[1:-1].replace("''", "'")
   446	            if v == ev_id:
   447	                return True
   448	    return False
   449	
   450	# ── G3-2 账本读取 (parsed)。⚠️ 单写者前提 (G3-3 前无锁): 同一 vault 内不得
   451	# 并行运行任何两个 quiz-answer (账本 per-vault 共享文件, 与是否同节点无关,
   452	# schema §6.2 A4.5) — 本块无任何互斥, 并行会在「读-算-写」间隙双写/丢失。
   453	# 尾行截断 (崩溃产物, §二 截断自愈) → 跳过并留痕, 由追加前 LF 守卫隔离;
   454	# 中间坏行 = 真实损坏 → fail-closed 人工介入。
   455	# Codex round-3 MEDIUM (R7): 「可容忍的截断」必须同时满足 ①是最后一行 ②文件
   456	# **不以 LF 结尾**。带终止 LF 的坏末行是**完整写入后损坏**的行 (write 已整行
   457	# 提交), 不是被腰斩的半行 — 旧实现只看「最后一行解析失败」, 于是真实损坏被
   458	# 当截断容忍, writer 照常 rc=0 追加并推进节点。EOF 的 LF 状态是区分二者的
   459	# 唯一机械证据, 读取时必须保留。
   460	# ⛔ 必须二进制读: 文本模式的 universal newlines 会把裸 \r 与 \r\n 都读成 \n,
   480	    # 截断」, 可那个坏行明明**后面还跟着东西**, 它是完整落盘后损坏的。
   481	    # split 后: 该行索引 < len-1 ⟺ 它后面还有片段 ⟺ 它有终止 LF。
   482	    # ⛔ 空行与校验器同口径拒收 (Codex round-6 MEDIUM): 校验器
