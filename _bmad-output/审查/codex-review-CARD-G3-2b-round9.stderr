    35	NODE_REL = "节点/测试节点.md"
    36	TS1 = "2026-08-01T10:00:00Z"
    37	EID = "测试检验-2026-08-01-1000#q1"
    38	NODE_V0 = (
    39	    '---\ntype: concept\nmastery_score: 0.5\ntitle: 测试节点\nsource_board: "[[原白板/CS 61B]]"\n---\n测试节点正文。\n'
    40	)
    41	#: 含 idle 状态 + W 远晚于评分时刻（A3 把 review_time 推到 W+1s）
    42	NODE_IDLE_A3 = (
    43	    "---\ntype: concept\nmastery_score: 0.5\nmastery_a: 3.0\nmastery_b: 3.0\n"
    44	    'attempt_count: 2\nlast_examined: "2026-07-01T00:00:00Z"\n'
    45	    "fsrs_due: 2026-12-11T13:56:58Z\nfsrs_state: 2\nfsrs_stability: 10.0\n"
    46	    "fsrs_difficulty: 5.0\nfsrs_last_review: 2026-12-01T10:00:00Z\ntitle: 测试节点\n"
    47	    "---\n测试节点正文。\n"
    48	)
    49	CONFIG = '# CARD-G3-2b fixture\nvault_id: "canvas-vault-测试"\nsubject: cs-61b\n'
    50	
    51	_TEXT = SKILL.read_text(encoding="utf-8")
    52	_BLOCKS = [
    53	    b
    54	    for b in re.findall(r"python3 - <<'PYEOF'\n(.*?)\nPYEOF", _TEXT, re.DOTALL)
    55	    if 'P = "/tmp/quiz-answer-payload.json"' in b
    56	]
    57	if len(_BLOCKS) != 1:
    58	    sys.exit(f"[g32b-ce] SKILL.md 应恰有 1 个主写点 PYEOF 块, 实见 {len(_BLOCKS)} — 拒跑")
    59	CODE = _BLOCKS[0]
