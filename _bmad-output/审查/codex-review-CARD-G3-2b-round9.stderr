   667	    return re.sub(
   668	        r"^calibration_log:[ \t]*\[[ \t]*\][ \t]*(#[^\n]*)?$",
   669	        lambda m: "calibration_log:" + (" " + m.group(1) if m.group(1) else ""),
   670	        fm_text, count=1, flags=re.M,
   671	    )
