  1548	def validate_file(path: Path) -> tuple[list[str], list[str]]:
  1549	    """整文件校验 → (violations, warnings), 均按行号升序。
  1550	
  1551	    逐行二进制读+独立 UTF-8 解码: 单行坏字节序列 = 该行违规,
  1552	    不中断其余行的校验 (Codex round-1: 原 text-mode 读会炸 traceback)。
  1553	    """
  1554	    violations: list[str] = []
  1555	    warnings: list[str] = []
  1556	    seen_ids: dict[str, int] = {}
  1557	    manifest = _golden_manifest()
  1558	    vault_id = _vault_id_of(path)
  1559	
  1560	    with open(path, "rb") as f:
  1561	        for lineno, raw in enumerate(f, 1):
  1562	            try:
  1563	                decoded = raw.decode("utf-8")
  1564	            except UnicodeDecodeError as e:
  1565	                violations.append(f"LINE {lineno}: 非法 UTF-8 字节序列 (offset {e.start}) — 疑似损坏行")
  1566	                continue
  1567	            # 只剥行尾 CR/LF: str.strip() 会连 RFC 8259 禁止的控制字符
  1568	            # (U+001C-1F 等) 一并洗掉, 让敌对行伪装成合法 JSON (Codex round-2 HIGH)
  1569	            line = decoded.rstrip("\r\n")
  1570	            if not line.strip():
  1571	                violations.append(f"LINE {lineno}: 空行 (append-only JSONL 不应出现)")
  1572	                continue
  1573	            try:
  1574	                record = _strict_loads(line)
  1575	            except json.JSONDecodeError as e:
  1576	                violations.append(f"LINE {lineno}: JSON 解析失败 ({e.msg}) — 疑似截断/损坏行")
  1577	                continue
  1578	            except _NonStandardJSON as e:
  1579	                violations.append(f"LINE {lineno}: {e}")
  1580	                continue
  1581	            except ValueError as e:
  1582	                # 超长整数字面量 (int_max_str_digits) 等 stdlib 限额 —
  1583	                # 该行判违规, 不炸整个校验 (Codex round-2 MEDIUM)
  1584	                violations.append(f"LINE {lineno}: JSON 值超出解析限额 ({e})")
  1585	                continue
  1586	            except RecursionError:
  1587	                # 深层嵌套 (round-3 MEDIUM: ~50 万层曾栈溢出并静默中断后续行)
  1588	                violations.append(f"LINE {lineno}: JSON 嵌套过深, 超出解析器递归上限 — 疑似构造行")
  1589	                continue
  1590	
  1591	            # 前向兼容分流 (§一): 未知 int 版本 → 只 WARN, 完全跳过 v1 形状校验
  1592	            # (仍登记 event_id 唯一性 — 幂等键跨版本恒定, append_event 不看版本查重)
  1593	            if isinstance(record, dict):
  1594	                version = record.get("event_version")
  1595	                unknown_version = (
  1596	                    isinstance(version, int) and not isinstance(version, bool) and version != EVENT_VERSION
  1597	                )
  1598	            else:
  1599	                unknown_version = False
  1600	
  1601	            if unknown_version:
  1602	                warnings.append(
  1603	                    f"LINE {lineno}: event_version={version} != {EVENT_VERSION} — "
  1604	                    "前向兼容跳过形状校验 (读方须容忍未知版本)"
  1605	                )
  1606	                # round-21 Codex MEDIUM: §一 路由信封是**跨版本义务**, 优先于
  1607	                # "v2 可删除/改名任一顶层字段"。此前 schema 写了"必须保留", 主体
  1608	                # 却对未知版本整行跳过、只发 WARN —— 规范说必须却没有门, 于是
  1609	                # 「proof scanner 拒绝、主体裁判接受」并存。前向兼容跳过的是
  1610	                # **形状校验**, 不包括信封本身。
  1611	                for key, ok in (
  1612	                    ("event_id", isinstance(record.get("event_id"), str) and bool(record["event_id"])),
  1613	                    ("node_id", isinstance(record.get("node_id"), str)),
  1614	                ):
  1615	                    if not ok:
  1616	                        violations.append(
  1617	                            f"LINE {lineno}: 未知版本记录缺少路由信封键 {key} "
  1618	                            f"(§一: event_id/event_version/node_id 任何版本都必须保留, "
  1619	                            f"否则读方无法判定归属)"
  1620	                        )
  1621	            else:
  1622	                line_problems, line_warnings = validate_record_full(record, manifest, vault_id)
  1623	                for problem in line_problems:
  1624	                    violations.append(f"LINE {lineno}: {problem}")
  1625	                for warning in line_warnings:
  1626	                    warnings.append(f"LINE {lineno}: {warning}")
  1627	
  1628	            if isinstance(record, dict):
  1629	                event_id = record.get("event_id")
  1630	                if isinstance(event_id, str) and event_id:
  1631	                    if event_id in seen_ids:
  1632	                        violations.append(
  1633	                            f"LINE {lineno}: event_id {event_id!r} 重复 "
  1634	                            f"(首见 LINE {seen_ids[event_id]}) — 幂等键必须全文件唯一"
  1635	                        )
  1636	                    else:
  1637	                        seen_ids[event_id] = lineno
  1638	
  1639	    return violations, warnings
  1640	
