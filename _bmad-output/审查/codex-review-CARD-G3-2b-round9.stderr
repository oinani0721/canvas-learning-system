  1199	def _instant(value: object) -> Optional[datetime]:
  1200	    """已过 _parse_ts 的串 → 绝对瞬间 (用于跨字段语义比较: 'Z' 与 '+00:00'
  1201	    是同一瞬间的两种写法, 不得因原字符串不等而误判 — round-3 MEDIUM)。"""
  1202	    if not isinstance(value, str):
  1203	        return None
  1204	    text = value[:-1] + "+00:00" if value.endswith("Z") else value
  1205	    try:
  1206	        return datetime.fromisoformat(text)
  1207	    except ValueError:
  1208	        return None
  1209	
  1210	
  1211	#: 正常 (非降级) 形状: 版本 = PEP 440 数字点版; hash = 64 hex (sha256)
  1212	_VERSION_RE = re.compile(r"^\d+(\.\d+)*$")
  1213	_HASH_RE = re.compile(r"^[0-9a-f]{64}$")
  1214	
  1215	#: review/1 扩展只许挂在这两类复习事件上 (round-3 HIGH: 曾可挂 session_archived)
  1216	REVIEW_EVENT_TYPES = frozenset({"answer_scored", "answer_abandoned"})
  1217	
  1218	#: §6.1 扩展必填键 — 出现其中任一即视为"意图写扩展行", 缺 marker 判违规
  1219	REVIEW_EXT_KEYS = frozenset(
  1220	    {"vault_id", "concept_id", "rating", "review_time", "fsrs_library_version", "fsrs_params_hash"}
  1221	)
  1222	
  1223	
  1224	def _looks_like_review_ext(payload: dict) -> bool:
  1225	    """payload 带扩展键但无合法 marker → 视为规避扩展校验的写法。
  1226	
  1227	    历史行 payload 只有 grade_norm/exam_board/attempt_count, 不含这些键,
  1228	    因此对存量零误报 (round-3: 去掉 marker 曾等于免检)。
  1229	    """
  1230	    return bool(REVIEW_EXT_KEYS & set(payload.keys()))
