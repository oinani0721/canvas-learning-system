   707	        _e_id = str(ev.get("event_id") or "")
   708	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   709	        _e_qid, _e_scr, scn_ = "null", "null", None
   710	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   711	              f'    ts: {q_(ts_str)}\n'
   712	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   713	              f'    question_id: {_e_qid}\n'
   714	              f'    self_confidence_raw: {_e_scr}\n'
   715	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   716	              f'    grade_norm: {_e_gn}\n'
   717	              f'    abandoned: {"true" if _e_ab else "false"}')
   718	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   719	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
