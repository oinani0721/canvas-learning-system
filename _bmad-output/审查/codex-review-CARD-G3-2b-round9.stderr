  3006	
  3007	    # ── H③ 空白 event_id 门只管本节点（别节点的合法存量行不得阻塞整个 vault）
  3008	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3009	    LED.unlink(missing_ok=True)
  3010	    _write_ledger(
