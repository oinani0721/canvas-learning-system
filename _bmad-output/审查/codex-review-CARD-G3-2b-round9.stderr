  1725	    # ⚠️ 原写法是「源码里有 resolve() 和 MARKER 这两个词」—— 审查实测：把
  1726	    # _guard_target() 函数体整体挖空、连调用点一起删掉，两条断言**仍全真**
  1727	    # （resolve() 在该文件另有无关出现：WT = Path(__file__).resolve()...）。
  1728	    # 断言必须绑定被审对象本身：直接**调用守卫**，看它在两种攻击形态下是否拒。
  1729	    import importlib.util as _ilu
  1730	
  1731	    _spec = _ilu.spec_from_file_location(
  1732	        "g32b_build_fixture_gate", WT / "backend" / "scripts" / "g32b_build_fixture.py"
  1733	    )
  1734	    _mod = _ilu.module_from_spec(_spec)
  1735	    _spec.loader.exec_module(_mod)
