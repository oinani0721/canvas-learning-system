   289	def r5():
   290	    print("\n── R5 (HIGH) scored rating 与 grade_norm 不自洽 → apply 前必须拒绝 ──")
   291	    v = new_vault("r5")
   292	    s = sha(v / NODE_REL)
   293	    for bad in (4, 2):
   294	        write_rows(v, _pending_row(rating=bad))
   295	        r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   296	        check(
   297	            f"R5/rating={bad} vs grade_norm=0.75(契约3)",
   298	            r.returncode != 0 and "不自洽" in r.stderr and sha(v / NODE_REL) == s and len(rows(v)) == 1,
   299	            f"rc={r.returncode} 账本={len(rows(v))}行 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   300	        )
   301	    write_rows(v, _pending_row())
   302	    r = run_settled(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   303	    check("R5/验伪-契约值3 照常重放", r.returncode == 0 and len(rows(v)) == 2, f"rc={r.returncode}")
   304	
   305	
   306	def r6():
   307	    print("\n── R6 (MEDIUM) 身份键归属与 candidate 构造裁决必须回写冻结 schema §6.2 ──")
   308	    doc = SCHEMA_DOC.read_text(encoding="utf-8")
   309	    seg = doc[doc.index("duplicate 命中后的状态推进门") : doc.index("**A5 整秒精度")]
   310	    missing = [
   311	        n
   312	        for n in (
   313	            "fsrs_library_version",
   314	            "fsrs_params_hash",
   315	            "排除出 envelope 等价面",
   316	            "golden manifest 绑定门",
   317	            "candidate 必须独立字面构造",
   318	            "多一键、少一键或值不同",
   319	        )
   320	        if n not in seg
   321	    ]
   322	    check("R6/§6.2 duplicate 门段落", not missing, f"缺失条款={missing or '无'}")
   323	    a5 = doc[doc.index("**A5 整秒精度") : doc.index("**三态语义")]
   324	    check("R6/§6.2 A5 消费侧强制", "A2 消费侧同样机械强制" in a5 and "禁止消费时顺手归一化" in a5, "已回写")
   325	    check("R6/§6.2 A4.5 截断判据", "可容忍的截断 vs 完整损坏" in doc and "不以 LF 结尾" in doc, "已回写")
   326	
   327	
   328	def r7():
   329	    print("\n── R7 (MEDIUM) 坏末行: 带 LF = 完整损坏(拒) / 无 LF = 截断(容忍) ──")
   330	    v = new_vault("r7")
   331	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   332	    good["event_id"] = "quiz:旧板"
   333	    good["effective_at"] = "2026-07-01T10:00:00Z"
   334	    good["node_id"] = "别的节点"
   335	    bad = '{"event_id": "quiz:损坏行", "event_version": 1, "event_type": "answer_sc'
   336	    ledger = v / "learning_events.jsonl"
   337	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad + "\n", encoding="utf-8")
   338	    s = sha(v / NODE_REL)
   339	    r = run(v)
   340	    check(
   341	        "R7/坏末行带终止 LF → fail-closed",
   342	        r.returncode != 0 and "完整写入的损坏行" in r.stderr and sha(v / NODE_REL) == s,
   343	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   344	    )
   345	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
   346	    rf = run(v)
   347	    lines = [x for x in ledger.read_text(encoding="utf-8").splitlines() if x.strip()]
   348	    check(
   349	        "R7/同一坏行去掉 LF → 仍按截断隔离",
   350	        rf.returncode == 0 and "截断尾行" in rf.stdout and len(lines) == 3,
   351	        f"rc={rf.returncode} 账本={len(lines)}行 (坏行隔离, 新事件独立成行)",
   352	    )
