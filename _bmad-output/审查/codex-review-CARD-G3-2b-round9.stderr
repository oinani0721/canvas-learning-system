   493	    _last_idx = max((i for i, x in enumerate(_byte_lines) if x.strip()), default=-1)
   494	    _ends_with_lf = _last_idx >= 0 and _last_idx < len(_byte_lines) - 1
   495	    _n_lines = len([x for x in _byte_lines if x.strip()])
   496	    for _ln, _bline in enumerate((x for x in _byte_lines if x.strip()), 1):
   497	        try:
   498	            _line = _bline.decode("utf-8-sig" if _ln == 1 else "utf-8")
   499	        except UnicodeDecodeError as _ue:
   500	            if _ln == _n_lines and not _ends_with_lf:
   501	                print(f"[quiz-answer] 账本第 {_ln} 行为截断尾行 (崩溃产物: 半个多字节字符且无终止 LF) — 追加时 LF 守卫隔离, 不阻塞本次评分")
   502	                continue
   503	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行含非 UTF-8 字节 ({_ue}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   504	        try:
   505	            # ⛔ 不得 .strip() —— 又一次「洗值」分叉 (Codex round-5 线索):
   506	            # `\x0c`(换页) 是 **Python** 眼里的空白但**不是 JSON 空白**
   507	            # (RFC 8259 只认 space/tab/CR/LF)。strip 掉它后 json.loads 成功,
   508	            # 而校验器不 strip、直接判 `Extra data` ⇒ 写点 rc=0 / 校验器 rc=1,
   509	            # 又是**漏网**方向。JSON 自己允许的空白 json.loads 会处理, 不需要我们代劳。
   510	            # ⛔ parse_constant 与校验器同口径 (Codex round-6 HIGH): 默认
