   229	def r3():
   230	    print("\n── R3 (HIGH) E1→E2→重跑 E1 → 必须 no-op, 不得误报冲突 ──")
   231	    v = new_vault("r3")
   232	    assert run(v).returncode == 0
   233	    assert run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md").returncode == 0
   234	    atts = [x["payload"]["attempt_count"] for x in rows(v)]
   235	    s = sha(v / NODE_REL)
   236	    r = run(v, ts="2026-09-01T12:00:00Z")  # 原样重跑 E1
   237	    check(
   238	        "R3/历史事件重跑",
   239	        r.returncode == 0 and "幂等跳过" in r.stdout and sha(v / NODE_REL) == s and len(rows(v)) == 2,
   240	        f"durable attempts={atts} rc={r.returncode} 节点未改={sha(v / NODE_REL) == s} "
   241	        f"账本={len(rows(v))}行 | {last_line(r.stdout)[:90]}",
   242	    )
   243	    rf = run(v, ts="2026-09-01T12:00:00Z", abandoned=True)
   244	    check("R3/验伪-换事实仍冲突", rf.returncode != 0 and "envelope 冲突" in rf.stderr, f"rc={rf.returncode}")
   245	
