   159	def r1():
   160	    print("\n── R1 (BLOCKER) durable payload 未知额外键 → 必须 envelope 冲突 ──")
   161	    v = new_vault("r1")
   162	    assert run(v).returncode == 0
   163	    base = rows(v)[0]
   164	    # ⚠️ `out_of_order` 现被更早的语义门接管 (见 n1_n5 的 N1) —— 只有**合法
   165	    # 乱序形态** (review_time ≤ W) 的该键才会走到 envelope 门。保 W 不回滚地
   166	    # 测它, R1 的原始穿透链仍被覆盖: 本次评分事实里没有这个键, 键集不等即冲突。
   167	    base_oo = json.loads(json.dumps(base))
   168	    base_oo["payload"]["out_of_order"] = True  # review_time == W ⇒ 合法乱序
   169	    write_rows(v, base_oo)
   170	    r_oo = run(v, ts="2026-09-01T07:00:00Z")
   171	    check(
   172	        "R1/out_of_order (合法乱序形态, 走 envelope 门)",
   173	        r_oo.returncode != 0 and "envelope 冲突" in r_oo.stderr and len(rows(v)) == 1,
   174	        f"rc={r_oo.returncode} 账本={len(rows(v))}行 | {last_line(r_oo.stderr)}",
   175	    )
   176	    for key, val, desc in (("note", "外部注入", "任意未知键"),):
   177	        (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 崩溃窗口①
   178	        t = json.loads(json.dumps(base))
   179	        t["payload"][key] = val
   180	        write_rows(v, t)
   181	        r = run(v)
   182	        check(
   183	            f"R1/{desc}",
   184	            r.returncode != 0 and "envelope 冲突" in r.stderr,
   185	            f"rc={r.returncode} fsrs_fields={fsrs_fields(v) or '{}'} 账本={len(rows(v))}行 | {last_line(r.stderr)}",
   186	        )
   187	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   188	    t = json.loads(json.dumps(base))
   189	    t["payload"].pop("exam_board")
   190	    write_rows(v, t)
   191	    r = run(v)
   192	    check("R1/缺固定生产键", r.returncode != 0 and "envelope 冲突" in r.stderr, f"rc={r.returncode}")
   193	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   194	    write_rows(v, base)
   195	    r = run(v)
   196	    check(
   197	        "R1/验伪-原样行仍可恢复",
   198	        r.returncode == 0 and fsrs_fields(v).get("fsrs_last_review") == TS1,
   199	        f"rc={r.returncode} W={fsrs_fields(v).get('fsrs_last_review')}",
   200	    )
   201	
