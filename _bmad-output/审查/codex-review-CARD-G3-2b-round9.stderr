   584	def _apply_mastery(fm_text, biz_ts, gn=None):
   585	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   586	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   587	    old = None
   588	    for key in ("mastery_score", "mastery", "mastery_level"):
   589	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   590	        if mo:
   591	            old = float(mo.group(1)); break
   592	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   593	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   594	    if ma and mb:
   595	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   596	    elif old is not None:
   597	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   598	    else:
   599	        a_, b_ = PRIOR_A, PRIOR_B
   600	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   601	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   602	    days_idle = 0.0
   603	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   604	    if mle:
   605	        try:
   606	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
