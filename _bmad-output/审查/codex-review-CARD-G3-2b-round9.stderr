  1740	            p.unlink()
  1741	        elif p.exists():
  1742	            subprocess.run(["rm", "-rf", str(p)], check=True)
  1743	    victim.mkdir()
  1744	    _orig_root = _mod.FIXTURE_ROOT
  1745	    try:
  1746	        # ① symlink 劫持：目标是指向别处的软链 ⇒ 守卫必须拒
  1747	        probe.symlink_to(victim, target_is_directory=True)
  1748	        _mod.FIXTURE_ROOT = probe
  1749	        with pytest.raises(SystemExit) as ei:
  1750	            _mod._guard_target()
  1751	        assert "resolve" in str(ei.value) or "拒跑" in str(ei.value), str(ei.value)
  1752	        probe.unlink()
  1753	        # ② 陌生目录（无 marker）⇒ 守卫必须拒，绝不 rmtree 别人的目录
  1754	        probe.mkdir()
  1755	        (probe / "别人的重要文件.txt").write_text("不该被删", encoding="utf-8")
  1756	        _mod.FIXTURE_ROOT = probe
  1757	        with pytest.raises(SystemExit) as ei2:
  1758	            _mod._guard_target()
  1759	        assert "标记文件" in str(ei2.value) or "拒绝删除" in str(ei2.value), str(ei2.value)
  1760	        assert (probe / "别人的重要文件.txt").exists(), "守卫拒跑时不得动目标目录"
  1761	        # ③ 验伪：带 marker 的自己的目录必须放行（否则这门是「恒拒」的假门）
  1762	        (probe / _mod.MARKER).write_text("x", encoding="utf-8")
  1763	        _mod._guard_target()
