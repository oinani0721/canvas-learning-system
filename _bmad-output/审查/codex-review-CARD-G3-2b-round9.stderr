   689	        # ⛔ 正常路径也必须存**完整**账本 event_id (Codex round-6 BLOCKER):
   690	        # round-5 我只把 foreign 分支改成存完整 id, 正常分支仍存裸 `eid` ——
   691	        # 两条路径写进 calibration_log 的键**不是同一个东西**。实测漏算链:
   692	        # 先提交 event_id="quiz:K" ⇒ 账本行是 `quiz:quiz:K` 而校准记的是 `quiz:K`;
   693	        # 再提交另一个事件 `K`(完整 id 也是 `quiz:K`) ⇒ F1 命中那条校准、判「已完整
   694	        # 应用」而幂等跳过, **那次评分静默不入账**(rc=0, attempt 停在 1)。
   695	        # 修一半比不修更危险: 它把不一致藏进了「已经修过」的地方。
   696	        _e_id, _e_pl = evid, p
   697	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   698	        _e_qid = q_(p.get("question_id", "q1"))
   699	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   700	    else:
   701	        _e_pl = ev.get("payload") or {}
   702	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
   703	        # 剥完之后 `quiz:K` 与 `K` 变成同一个键, F1 判定无法区分 —— 实测账本 3 次
   704	        # 评分只记 2 条校准、attempt 停在 2, **一次复习静默消失且 rc=0 无提示**。
   705	        # (另两种 attempt 排列恰好被序数门兜住而 fail-closed —— 那是巧合不是设计,
   706	        #  「被别的门兜住」不等于缺陷不存在。)
   707	        _e_id = str(ev.get("event_id") or "")
   708	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   709	        _e_qid, _e_scr, scn_ = "null", "null", None
   710	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   711	              f'    ts: {q_(ts_str)}\n'
   712	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   713	              f'    question_id: {_e_qid}\n'
   714	              f'    self_confidence_raw: {_e_scr}\n'
   715	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   716	              f'    grade_norm: {_e_gn}\n'
   717	              f'    abandoned: {"true" if _e_ab else "false"}')
   718	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   719	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   720	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   721	    # 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   722	    mcal_ = re.search(r'^calibration_log:', fm_text, re.M)
   723	    if mcal_:
   724	        lines_ = fm_text.split("\n")
