   264	def _pending_row(**over):
   265	    row = {
   266	        "event_id": "quiz:板A#q1",
   267	        "event_version": 1,
   268	        "event_type": "answer_scored",
   269	        "node_id": "测试节点",
   270	        "recorded_at": TS1,
   271	        "effective_at": TS1,
   272	        "payload": {
   273	            "schema_ext": "review/1",
   274	            "vault_id": "canvas_vault_测试",
   275	            "concept_id": "测试节点",
   276	            "rating": 3,
   277	            "grade_norm": 0.75,
   278	            "review_time": TS1,
   279	            "fsrs_library_version": "degraded:historic-run",
   280	            "fsrs_params_hash": "degraded:historic-run",
   281	            "exam_board": "检验白板/板A.md",
   282	            "attempt_count": 1,
   283	        },
   284	    }
   285	    row["payload"].update(over)
   286	    return row
