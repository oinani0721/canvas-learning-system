  2795	def test_round7_findings(vault):
  2796	    """round-7 的问题逐条锁住。其中 M① 是我 round-6「保留 W 兜底」引入的 ——
  2797	    「更安全的兜底」让 calibration 判据**没有真正生效**。
  2798	    """
  2799	    LED = vault / "learning_events.jsonl"
  2800	
  2801	    def _fresh():
  2802	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2803	        LED.unlink(missing_ok=True)
  2804	
  2805	    # ── B① 校准 token 必须反查所有来源；exact 命中也不得绕过歧义检查
  2806	    _fresh()
  2807	    assert _run_writer_settled(vault, _payload(event_id="quiz:K", ts=TS1)).returncode == 0
