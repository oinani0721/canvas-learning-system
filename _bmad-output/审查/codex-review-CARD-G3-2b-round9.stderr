   340	class _DupKey(Exception):
   341	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   342	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   343	
   344	
   345	def _no_dup_keys(pairs):
   346	    _seen = set()
   347	    for _k, _ in pairs:
   348	        if _k in _seen:
   349	            raise _DupKey(repr(_k))
   350	        _seen.add(_k)
   351	    return dict(pairs)
