   279	def _ensure_fsrs() -> bool:
   280	    try:
   281	        import fsrs  # noqa: F401
   282	        return True
   283	    except ImportError:
   284	        venv_py = _venv_python()
   285	        if os.environ.get("FSRS_BRIDGE_REEXEC") != "1" and venv_py:
   286	            os.environ["FSRS_BRIDGE_REEXEC"] = "1"
   287	            os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
   288	        return False
   289	
   290	
   291	def main() -> int:
   292	    if not _ensure_fsrs():
   293	        print(json.dumps({"error": "fsrs_unavailable — backend/.venv 缺失或未装 fsrs"}))
   294	        return 3
   295	    p = json.load(sys.stdin)
   296	    try:
   297	        out = review(
   298	            fields_from_frontmatter(p.get("fm", "")),
   299	            float(p.get("grade_norm", 0.0)),
   300	            bool(p.get("abandoned")),
   301	            p["ts"],
   302	            rating=p.get("rating"),
   303	        )
   304	    except ValueError as e:
   305	        # G3-2: naive/越界/非法 rating 等输入缺陷 —— 拒绝并 stdout 明说,
   306	        # 不静默降级。exit 2 = 输入错误 (区别于 3 = fsrs 不可用)。
   307	        print(json.dumps({"error": f"invalid_input — {e}"}, ensure_ascii=False))
   308	        return 2
   309	    print(json.dumps(out, ensure_ascii=False))
   310	    return 0
   311	
   312	
   313	if __name__ == "__main__":
   314	    sys.exit(main())
