  3023	    rf = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3024	    assert rf.returncode == 0, f"别节点的合法存量行不得阻塞整个 vault: {rf.stderr[:300]}"
