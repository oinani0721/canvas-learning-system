   568	# ---------------------------------------------------------------------------
   569	# 检查 3 — projection_freshness
   570	# ---------------------------------------------------------------------------
   571	def _is_stale(generated_at: Any, today: date) -> bool:
   572	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   573	
   574	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   575	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   576	    都按 stale 降级, 绝不逃逸成异常。
   577	    """
   578	    stale = True
   579	    try:
   580	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   581	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   582	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   583	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   584	        stale = True
   585	    return stale
   586	
   587	
   588	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   589	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   590	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。
   591	
   592	    ⛔ corrupt 面**比 oracle 窄**, 如实声明: oracle 在 stale 判定之前还要过
   593	       `_summarize()` 的严格 v3 形状门禁 (schema_version==3 / 五个容器形状 /
   594	       boards·buckets 对账 / 非有限数拒收…), 任何不符即 corrupt。本函数**不复制**
   595	       那几百行 (复制必漂, 且 W6 独占该文件), 只覆盖四类:
   596	       读不出 / 不是 JSON object / 缺 generated_at 键 / generated_at 非字符串
   597	       (最后这类的同语义是实测钉的: int 20260831 → oracle=corrupt, 不是 stale)。
   598	       故同源锁只在**合法 v3 投影**上成立; 其余形状垃圾面两侧可能分歧
   599	       (oracle=corrupt, 本函数可能=stale/ok) —— 验收单「不比什么」表登记。
   600	    """
   601	    proj = vault.joinpath(*_PROJECTION_REL)
   602	    raw = _read_text(proj)
   603	    if raw is None:
   604	        if not proj.exists():
   605	            return "no_projection", None, None
   606	        return "corrupt", "读取失败 (非 UTF-8 / 权限)", None
   607	    try:
   608	        payload = json.loads(raw)
   609	    except (ValueError, RecursionError) as e:
   610	        return "corrupt", f"{type(e).__name__}: {str(e)[:200]}", None
   611	    if not isinstance(payload, dict):
   612	        return "corrupt", "投影根节点不是 JSON object", None
   613	    if "generated_at" not in payload:
   614	        return "corrupt", "投影缺 generated_at 字段", None
   615	    gen = payload["generated_at"]
   616	    # oracle 的 `_summarize` (:678-680) 对非字符串 generated_at 抛 ValueError → corrupt
   617	    # (实测: int 20260831 → oracle=corrupt 而非 stale)。必须同语义, 否则同源锁在此分叉。
   618	    if not isinstance(gen, str):
   619	        return "corrupt", f"generated_at 应为字符串, 实为 {type(gen).__name__}", None
   620	    return ("stale" if _is_stale(gen, today) else "ok"), None, gen
   621	
   622	
   623	def check_projection_freshness(vault: Path, today: date) -> CheckResult:
   624	    """`outputs/今日复习.json` 的 generated_at 是否是上海本地的今日。
   625	
   626	    状态分级 (**待用户裁决**):
   627	      ok            → ok
   628	      stale         → warn  (只是今天还没跑推送, 不是坏)
   629	      no_projection → warn  (该 vault 从没跑过推送 —— 新 vault 的正常初态)
   630	      corrupt       → fail  (投影文件坏了, 下游 Web UI / 推送会拿不到数据 = 真故障)
   631	    """
   632	    status, error, gen = _projection_status(vault, today)
   633	    mapped = {"ok": OK, "stale": WARN, "no_projection": WARN, "corrupt": FAIL}[status]
   634	    detail = {
   635	        "ok": f"generated_at={gen!r} 是 {today} 的投影",
   636	        "stale": f"generated_at={gen!r} 不是 {today} ({_DISPLAY_TZ_NAME}) 的投影",
   637	        "no_projection": f"{'/'.join(_PROJECTION_REL)} 不存在 —— 该 vault 尚未跑过推送",
   638	        "corrupt": f"投影不可用: {error}",
   639	    }[status]
   640	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   641	    return CheckResult(
   642	        name="projection_freshness",
   643	        status=mapped,
   644	        summary=f"projection_status={status}",
   645	        findings=findings,
   646	        notes=[
   647	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   648	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   649	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   650	            "只判 读不出/非 object/缺 generated_at",
   651	        ],
   652	        details={"projection_status": status, "generated_at": gen, "error": error},
   653	    )
   654	
