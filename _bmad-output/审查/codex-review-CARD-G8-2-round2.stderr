    66	def fm_scalar(fm: str, key: str) -> str | None:
    67	    """顶层标量取值。`^key:` 不容前导空白 → 天然排除嵌套同名键。
    68	
    69	    ⛔ 取**最后一个**同名 key (与 YAML / 后端一致): 重复 key 时 YAML 后者胜,
    70	    取第一个会让脚本与后端读到不同值 (RAG-S2.6 审查 M10 同族)。
    71	    ⛔ 剥行内注释: `mastery_score: 0.75  # 手动校准` 在真 YAML 里是 0.75,
    72	    不剥就 float() 失败 → 掌握度显示成「—」而后端显示 0.75 (审查 H4)。
    73	    """
    74	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
    75	    if not matches:
    76	        return None
    77	    v = matches[-1].strip()
    78	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
    79	        v = re.sub(r"\s+#.*$", "", v)  # 行内注释 (引号包裹的值里 # 不算注释)
    80	    v = v.strip().strip('"').strip("'")
    81	    return v or None
    82	
