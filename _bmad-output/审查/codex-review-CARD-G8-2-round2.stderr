from __future__ import annotations
import json, os, shutil, subprocess, tempfile
from pathlib import Path

lane = Path.cwd()
py = lane / 'backend/.venv/bin/python'
script = lane / 'backend/scripts/vault_lint.py'
audit_root = Path(tempfile.mkdtemp(prefix='card-g82-r2-audit-'))
print(f'AUDIT_TMP={audit_root}')

def run(argv, *, cwd=None, strip_env=False):
    env = dict(os.environ)
    if strip_env:
        env.pop('PYTHONDONTWRITEBYTECODE', None)
        env.pop('PYTHONPYCACHEPREFIX', None)
    else:
        env['PYTHONDONTWRITEBYTECODE'] = '1'
        env.pop('PYTHONPYCACHEPREFIX', None)
    p = subprocess.run([str(py), *map(str, argv)], cwd=cwd, env=env, text=True, capture_output=True, timeout=120)
    return p

def cli(root, only='orphan_nodes'):
    p = run([script, '--vault', root, '--only', only, '--now', '2026-09-01T00:00:00+08:00', '--json'])
    payload = None
    try: payload = json.loads(p.stdout)
    except Exception: pass
    if payload:
        check = payload['checks'][0]
        print(json.dumps({'rc': p.returncode, 'name': check['name'], 'status': check['status'], 'findings': [x['subject'] for x in check['findings']], 'details': check['details']}, ensure_ascii=False, sort_keys=True))
    else:
        print(json.dumps({'rc': p.returncode, 'stdout': p.stdout[-300:], 'stderr': p.stderr[-300:]}, ensure_ascii=False))
    return p, payload

def node(root, name='x', body='正文\\n', extra=''):
    p = root / '节点' / f'{name}.md'; p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text('---\\ntype: concept\\n' + extra + '---\\n' + body, encoding='utf-8')

def board(root, body, name='板'):
    p = root / '原白板' / f'{name}.md'; p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text('---\\ntype: whiteboard\\n---\\n' + body, encoding='utf-8')

# BLOCKER-1 exact direct --help copy experiment.
for mode in ('direct-help', 'module-import'):
    d = audit_root / mode; d.mkdir()
    shutil.copy2(script, d / 'vault_lint.py')
    shutil.copy2(lane / 'backend/scripts/check_vault_doc_roles.py', d / 'check_vault_doc_roles.py')
    if mode == 'direct-help':
        p = run([d / 'vault_lint.py', '--help'], cwd=d, strip_env=True)
    else:
        p = run(['-c', f\"import sys; sys.path.insert(0, {str(d)"'!r}); import vault_lint"], cwd=d, strip_env=True)
    pycs = sorted(x.relative_to(d).as_posix() for x in d.rglob('"'*.pyc'))
    print(f'{mode}: rc={p.returncode} pyc_count={len(pycs)} pycs={pycs}')

# round-1 exact orphan fixtures.
print('CASE external-file-symlink-orphan')
r = audit_root/'external-file'; node(r); outside=audit_root/'outside.md'; outside.write_text('- [[x]]\\n',encoding='utf-8'); q=r/'原白板'/'external.md'; q.parent.mkdir(parents=True); q.symlink_to(outside); cli(r)

print('CASE auto-single-fence-inline-html-multiline')
variants = {
 'auto': '<"'!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py · 真相源 = 节点 frontmatter source_board'"\\n- [[x]]\\n<"'!-- /AUTO-GENERATED -->'"\\n',
 'fenced': '"'```txt'"\\n[[x]]\\n"'```'"\\n',
 'inline': '"'`[[x]]`'"\\n',
 'html': '<"'!-- [[x]] -->'"\\n',
 'multiline': '[[\\nx\\n]]\\n',
}
for name, body in variants.items():
    print(' variant='+name); r=audit_root/('v-'+name); node(r); board(r,body); cli(r)

print('CASE missing-node-dir')
r=audit_root/'missing-node'; r.mkdir(); cli(r)
print('CASE nonutf-node')
r=audit_root/'nonutf'; q=r/'节点'/'bad.md'; q.parent.mkdir(parents=True); q.write_bytes(b'\\xff\\xfe---\\n'); cli(r)

print('CASE uppercase-md')
r=audit_root/'upper'; node(r); board(r,'[[X.MD]]\\n'); cli(r)
print('CASE source-board-scalars')
for label, scalar in [('null','null'),('tilde','~'),('none','none'),('quoted-null','\"null\"')]:
    print(' scalar='+label); r=audit_root/('scalar-'+label); node(r,extra=f'source_board: {scalar}\\n'); cli(r)
print('CASE subdir-crosslink')
r=audit_root/'subdir'; node(r,'d1/A',body='[[d2/a]]\\n'); node(r,'d2/a'); cli(r)

# Newly introduced/adjoining surfaces.
print('CASE inline-double-backtick-code')
r=audit_root/'inline-double'; node(r); board(r,'"'``[[x]]``'"\\n'); cli(r)
print('CASE four-backtick-fence-with-short-run')
r=audit_root/'fence-four'; node(r); board(r,'"'````txt'"\\n"'``` not a valid close for 4'"\\n[[x]]\\n"'````'"\\n'); cli(r)
print('CASE auto-begin-inside-fence-with-real-link-after')
r=audit_root/'auto-in-fence'; node(r); board(r,'"'```txt'"\\n<"'!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py'"\\n"'```'"\\n[[x]]\\n'); cli(r)
print('CASE auto-block-containing-fence')
r=audit_root/'fence-in-auto'; node(r); board(r,'<"'!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py'"\\n"'```txt'"\\n[[x]]\\n"'```'"\\n<"'!-- /AUTO-GENERATED -->'"\\n'); cli(r)

print('CASE broken-file-symlink-node')
r=audit_root/'broken-link'; (r/'节点').mkdir(parents=True); (r/'节点'/'lost.md').symlink_to(audit_root/'does-not-exist.md'); cli(r)
print('CASE top-level-board-dir-symlink-escape')
r=audit_root/'board-dir-link'; node(r); outdir=audit_root/'outside-boards'; outdir.mkdir(); (outdir/'external.md').write_text('[[x]]\\n',encoding='utf-8'); (r/'原白板').symlink_to(outdir, target_is_directory=True); cli(r)
print('CASE top-level-node-dir-symlink-escape')
r=audit_root/'node-dir-link'; r.mkdir(); outnodes=audit_root/'outside-nodes'; outnodes.mkdir(); (outnodes/'x.md').write_text('---\\ntype: concept\\nsource_board: \"[[external]]\"\\n---\\n',encoding='utf-8'); (r/'节点').symlink_to(outnodes, target_is_directory=True); cli(r)

print('CASE recap-file-symlink-raw-derived')
r=audit_root/'recap-link'; r.mkdir(); outside_recap=audit_root/'outside-recap.md'; outside_recap.write_text('---\\ntype: recap\\n---\\noutside\\n',encoding='utf-8'); q=r/'outputs'/'回顾-outside.md'; q.parent.mkdir(); q.symlink_to(outside_recap); cli(r, 'raw_derived_confusion')

print('CASE argparse')
p=run([script]); print(f'no-args rc={p.returncode} stderr_tail={p.stderr.strip().splitlines()[-1] if p.stderr.strip() else \"\"}')
r=audit_root/'arg-v'; r.mkdir(); p=run([script,'--vault',r,'--only','no_such_check']); print(f'bad-only rc={p.returncode} stderr_tail={p.stderr.strip().splitlines()[-1] if p.stderr.strip() else \"\"}')
p=run([script,'--help']); print(f'help rc={p.returncode}')
p=run([script,'--version']); print(f'version-unsupported rc={p.returncode}')
