   721	def test_live_vault_readonly_and_runs():
   722	    if not _LIVE_VAULT.is_dir():
   723	        pytest.skip(f"live vault 不可达: {_LIVE_VAULT}")
   724	    before = _vault_digest(_LIVE_VAULT)
   725	    report = vl.run_checks(_LIVE_VAULT, TODAY)
   726	    assert _vault_digest(_LIVE_VAULT) == before, "live vault 被改动 —— 零写铁律被打破"
   727	    assert vl.exit_code(report) in (0, 1, 2)
   728	    # 卡文裁判 2 的单测侧缩影: rc 与 JSON summary 一致
