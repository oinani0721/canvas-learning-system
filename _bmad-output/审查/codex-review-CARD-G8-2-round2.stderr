   483	def test_resolve_today_default_is_shanghai_not_host_local(monkeypatch):
   484	    """Codex round-1 MEDIUM-2: 锁死默认分支 (无 --now) 的时区语义。
   485	    本宿主 (+08:00) 的 host 日与上海日恒相同, 物理时刻区分不出 —— 故 patch
   486	    _TZ_SHANGHAI 为 UTC 做结构判别: 默认分支的结果必须**跟随那个时区对象**。
   487	    date.today() / astimezone() 宿主本地 等变异对 _TZ_SHANGHAI 不敏感 → 本用例红。"""
   488	    monkeypatch.setattr(vl, "_utcnow", lambda: datetime(2026, 8, 31, 23, 0, tzinfo=timezone.utc))
   489	    monkeypatch.setattr(vl, "_TZ_SHANGHAI", timezone.utc)
   490	    assert vl.resolve_today(None) == date(2026, 8, 31), (
   491	        "默认分支必须经过 _TZ_SHANGHAI 时区换算 (patch 成 UTC 后结果必须随之变化); "
   492	        "若实现退回 date.today()/宿主本地, 此处会得到 09-01"
   493	    )
