   479	def check_raw_derived(vault: Path) -> CheckResult:
   480	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   481	
   482	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   483	
   484	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   485	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   486	      G2 未登记根级文件    同上, 根级面
   487	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   488	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   489	                          正是"raw-derived 混淆"的机械定义
   490	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   491	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   492	
   493	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   494	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   495	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   496	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   497	                 **本次未验证**, 报告逐次声明
   498	
   499	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   500	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。

exec
/bin/zsh -lc "nl -ba backend/scripts/vault_lint.py | sed -n '501,788p'" in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-w9-lint
 succeeded in 0ms:
   501	    """
   502	    try:
   503	        data = cvr.load_rules()
   504	    except cvr.ConfigError as exc:
   505	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   506	    try:
   507	        res = cvr.scan(data, vault, with_probe=False)
   508	    except cvr.ConfigError as exc:
   509	        raise LintConfigError(str(exc)) from exc
   510	
   511	    findings = [
   512	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   513	        for fd in res.findings
   514	        if fd.code in CONFUSION_CODES and fd.blocking
   515	    ]
   516	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   517	
   518	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   519	    recap_bad = 0
   520	    for md in _iter_md(vault):
   521	        if not md.name.startswith(RECAP_PREFIX):
   522	            continue
   523	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   524	        ftype = cvr.read_frontmatter_type(md, parser=None)
   525	        if ftype != "recap":
   526	            recap_bad += 1
   527	            findings.append(
   528	                Finding(
   529	                    md.relative_to(vault).as_posix(),
   530	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   531	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   532	                )
   533	            )
   534	
   535	    notes: list[str] = [
   536	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   537	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   538	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   539	    ]
   540	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   541	    if blind:
   542	        notes.append(
   543	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   544	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   545	        )
   546	    if exempted:
   547	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   548	    for msg in res.info:
   549	        notes.append(f"台账扫描 info: {msg}")
   550	
   551	    return CheckResult(
   552	        name="raw_derived_confusion",
   553	        status=WARN if findings else OK,
   554	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   555	        findings=findings,
   556	        notes=notes,
   557	        details={
   558	            "files_seen": res.files_seen,
   559	            "dirs_seen": res.dirs_seen,
   560	            "codes_counted": list(CONFUSION_CODES),
   561	            "recap_missing_type": recap_bad,
   562	            "blind_spots": len(blind),
   563	            "probe_skipped": res.probe_skipped,
   564	        },
