   656	# ---------------------------------------------------------------------------
   657	# runner
   658	# ---------------------------------------------------------------------------
   659	#: 检查注册表 —— name → (说明, 是否需要 today)
   660	CHECKS: dict[str, str] = {
   661	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   662	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
   663	    "projection_freshness": "outputs/今日复习.json 的 generated_at 是否过期",
   664	}
   665	
   666	
   667	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   668	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   669	    if not vault.is_dir():
   670	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   671	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   672	    checks: list[CheckResult] = []
   673	    for name in selected:
   674	        if name == "orphan_nodes":
   675	            checks.append(check_orphan_nodes(vault))
   676	        elif name == "raw_derived_confusion":
   677	            checks.append(check_raw_derived(vault))
   678	        elif name == "projection_freshness":
   679	            checks.append(check_projection_freshness(vault, today))
   680	    return LintReport(
   681	        vault=str(vault),
   682	        today=today.isoformat(),
   683	        checks=checks,
   684	        skipped=[n for n in CHECKS if n not in selected],
   685	    )
   686	
   687	
   688	def _utcnow() -> datetime:
   689	    """时钟缝 (Codex round-1 MEDIUM-2): 唯一的取当前时刻处, 测试 patch 它来锁
   690	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   691	    return datetime.now(timezone.utc)
   692	
   693	
   694	def resolve_today(now: str | None) -> date:
   695	    """`--now` → 上海本地日。
   696	
   697	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   698	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   699	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   700	    """
   701	    if now is None:
   702	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   703	    try:
   704	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   705	    except ValueError as exc:
   706	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   707	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   708	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   709	    try:
   710	        return dt.astimezone(_TZ_SHANGHAI).date()
   711	    except (OverflowError, OSError) as exc:
   712	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   713	
   714	
   715	_EPILOG = f"""
   716	检查项与状态分级 (ok/warn/fail 的判定规则, Codex round-1 MEDIUM-4 要求写进 --help):
   717	  orphan_nodes            {CHECKS['orphan_nodes']}
   718	                            warn = 有孤儿或有扫描盲区 (symlink/不可读, 盲区里的文件未参与判定);
   719	                            fail = `节点/` 目录不存在 (检查没查成, 不是零孤儿)
   720	  raw_derived_confusion   {CHECKS['raw_derived_confusion']}
   721	                            warn = 有混淆 finding (G1/G2/G3/G4/G9 或 回顾-* 缺 type: recap);
   722	                            本检查无 fail 态
   723	  projection_freshness    {CHECKS['projection_freshness']}
   724	                            warn = stale (今天还没跑推送) 或 no_projection;
   725	                            fail = corrupt (投影文件坏, 下游拿不到数据)
   726	
   727	退出码:
   728	  0  全部检查 ok
   729	  2  有 warn、无 fail
   730	  1  有 fail
   731	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法 /
   732	      参数用法错误)
   733	
   734	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   735	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   736	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   737	   "vault 有问题" 与 "lint 没跑成"。参数用法错误也归 3 (Codex round-1 HIGH-6:
   738	   argparse 默认 exit(2) 会与"有 warn"撞码)。
   739	
   740	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   741	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   742	"""
   743	
   744	
   745	class _LintArgumentParser(argparse.ArgumentParser):
   746	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   747	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   748	
   749	    def error(self, message: str):  # type: ignore[override]
   750	        self.print_usage(sys.stderr)
   751	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   752	        raise SystemExit(EXIT_CONFIG)
   753	
   754	
   755	def main(argv: list[str] | None = None) -> int:
   756	    ap = _LintArgumentParser(
   757	        prog="vault_lint.py",
   758	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   759	        epilog=_EPILOG,
   760	        formatter_class=argparse.RawDescriptionHelpFormatter,
   761	    )
   762	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   763	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   764	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   765	    ap.add_argument(
   766	        "--only",
   767	        action="append",
   768	        choices=sorted(CHECKS),
   769	        default=None,
   770	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   771	    )
   772	    args = ap.parse_args(argv)
   773	
   774	    try:
   775	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   776	    except LintConfigError as exc:
   777	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   778	        return EXIT_CONFIG
   779	
   780	    if args.json:
   781	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   782	    else:
   783	        print(render_text(report, color=sys.stdout.isatty()))
   784	    return exit_code(report)
   785	
   786	
   787	if __name__ == "__main__":
   788	    sys.exit(main())

