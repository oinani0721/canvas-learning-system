   137	@dataclass(frozen=True)
   138	class Finding:
   139	    subject: str  #: 出问题的 vault 相对路径 / 主体
   140	    detail: str
   141	
   142	
   143	@dataclass
   144	class CheckResult:
   145	    """单个检查的结论。
   146	
   147	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   148	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   149	    """
   150	
   151	    name: str
   152	    status: str  #: ok | warn | fail
   153	    summary: str
   154	    findings: list[Finding] = field(default_factory=list)
   155	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   156	    notes: list[str] = field(default_factory=list)
   157	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   158	    details: dict[str, Any] = field(default_factory=dict)
   159	
   160	
   161	@dataclass
   162	class LintReport:
   163	    vault: str
   164	    today: str
   165	    checks: list[CheckResult]
   166	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   167	    skipped: list[str] = field(default_factory=list)
   168	
   169	
   170	def exit_code(report: LintReport) -> int:
   171	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   172	    statuses = {c.status for c in report.checks}
   173	    if FAIL in statuses:
   174	        return EXIT_FAIL
   175	    if WARN in statuses:
   176	        return EXIT_WARN
   177	    return EXIT_OK
   178	
   179	
   180	def report_to_json(report: LintReport) -> dict[str, Any]:
   181	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   182	    return {
   183	        "vault": report.vault,
   184	        "today": report.today,
   185	        "summary": {
   186	            "exit_code": exit_code(report),
   187	            "checks_run": [c.name for c in report.checks],
   188	            "checks_skipped": list(report.skipped),
   189	            "status_counts": {
   190	                s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)
   191	            },
   192	        },
   193	        "checks": [
   194	            {
   195	                "name": c.name,
   196	                "status": c.status,
   197	                "summary": c.summary,
   198	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   199	                "notes": list(c.notes),
   200	                "details": dict(c.details),
   201	            }
   202	            for c in report.checks
   203	        ],
   204	    }
   205	
   206	
   207	def render_text(report: LintReport, *, color: bool = True) -> str:
   208	    """文本视图 —— 只读 `report`, 与 `report_to_json` 同源。
   209	
   210	    每个检查恰一行机读状态行 `{TAG} <name> status=<status> ...`, 同源门据此解析比对。
   211	    """
   212	
   213	    def c(code: str, s: str) -> str:
   214	        return f"{code}{s}{RESET}" if color else s
   215	
   216	    hue = {OK: GREEN, WARN: YELLOW, FAIL: RED}
   217	    out: list[str] = [
   218	        f"{c(DIM, 'vault')} {report.vault}",
   219	        f"{c(DIM, 'today')} {report.today} ({_DISPLAY_TZ_NAME})",
   220	    ]

exec
/bin/zsh -lc "nl -ba backend/scripts/vault_lint.py | sed -n '221,500p'" in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-w9-lint
 succeeded in 0ms:
   221	    for chk in report.checks:
   222	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   223	        for note in chk.notes:
   224	            out.append(f"    {c(DIM, 'note  ' + note)}")
   225	        for fd in chk.findings:
   226	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   227	    for name in report.skipped:
   228	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   229	    rc = exit_code(report)
   230	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   231	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   232	    return "\n".join(out)
