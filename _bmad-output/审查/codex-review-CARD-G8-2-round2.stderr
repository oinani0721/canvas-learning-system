   695	def test_help_lists_checks_and_exit_semantics():
   696	    env = dict(os.environ)
   697	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   698	    proc = subprocess.run(
   699	        [sys.executable, str(SCRIPT), "--help"], capture_output=True, text=True, env=env, timeout=60
   700	    )
   701	    assert proc.returncode == 0
   702	    out = proc.stdout
   703	    for name in vl.CHECKS:
   704	        assert name in out, f"--help 缺检查名 {name}"
   705	    for token in ("0", "2", "1", "3"):
   706	        assert token in out
   707	    assert "warn" in out and "fail" in out and "配置/环境错误" in out
   708	    # Codex round-1 MEDIUM-4: 分级规则必须出现在 --help, 不能只活在源码里
   709	    assert "节点/" in out and "不存在" in out, "--help 缺 orphan 的 fail 分级规则"
   710	    assert "corrupt" in out and "stale" in out, "--help 缺 freshness 的分级规则"
   711	    assert "scan 盲区" in out or "盲区" in out, "--help 缺 orphan 盲区降 warn 的规则"
   712	    assert "dont_write_bytecode" in out.lower(), "--help 缺零写兜底声明"
