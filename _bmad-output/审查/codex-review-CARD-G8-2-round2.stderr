   496	# ---------------------------------------------------------------------------
   497	# 4. freshness 同源锁 —— 活 oracle 比对 + 实测快照锚
   498	# ---------------------------------------------------------------------------
   499	#: probe-B 2026-09-01 对真实 _vault_entry 的实测矩阵 (today=2026-08-31)。
   500	#: 机制列来自逐条归因: DATE_COMPARE / REGEX_REJECT / ASTIMEZONE_RAISE(OverflowError) /
   501	#: SUMMARIZE_TYPE_REJECT —— stale 一档盖 3 种机制, 只锁 status 对机制层变异是盲的,
   502	#: 故 h2/h3 (唯二触达 OverflowError 兜底的用例) 必须在场。
   503	FRESHNESS_MATRIX = [
   504	    # (generated_at, 期望 oracle status, 机制)
   505	    ("2026-08-31T09:05:05+08:00", "ok", "DATE_COMPARE"),
   506	    ("2026-08-30T09:05:05+08:00", "stale", "DATE_COMPARE 昨日"),
   507	    ("2026-08-31T01:05:05Z", "ok", "DATE_COMPARE Z 后缀"),
   508	    ("2026-08-30T23:00:00Z", "ok", "DATE_COMPARE 跨午夜: UTC 昨日 23:00 = 上海今日"),
   509	    ("2026-08-31T00:30:00+08:00", "ok", "DATE_COMPARE 上海今日凌晨"),
   510	    ("2026-08-31T17:05:05Z", "stale", "DATE_COMPARE 上海日翻篇: UTC 17:05 = 上海次日"),
   511	    ("2026-09-01T00:30:00+08:00", "stale", "DATE_COMPARE 次日"),
   512	    ("2026-08-31", "stale", "REGEX_REJECT 纯日期"),
   513	    ("2026-08-31T09:05:05", "stale", "REGEX_REJECT 无时区"),
   514	    ("", "stale", "REGEX_REJECT 空串"),
   515	    ("20260831", "stale", "REGEX_REJECT 数字串"),
   516	    ("+9999-08-31T09:05:05+08:00", "stale", "REGEX_REJECT 年份越界"),
   517	    ("2026-08-31T09:05:05+08:60", "stale", "REGEX_REJECT 非法分钟"),
   518	    ("2026-08-31T09:05:05+15:00", "stale", "REGEX_REJECT 越界时区偏移"),
   519	    ("9999-12-31T23:59:59+00:00", "stale", "ASTIMEZONE_RAISE OverflowError"),
   520	    ("0001-01-01T00:00:00+14:00", "stale", "ASTIMEZONE_RAISE OverflowError"),
   521	    (20260831, "corrupt", "SUMMARIZE_TYPE_REJECT 非字符串"),
   522	]
   523	
   524	
   525	@pytest.mark.parametrize("generated_at,expected,mechanism", FRESHNESS_MATRIX, ids=[m for _, _, m in FRESHNESS_MATRIX])

