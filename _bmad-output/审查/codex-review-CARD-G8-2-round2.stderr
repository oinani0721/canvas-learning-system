   238	def _read_text(path: Path) -> str | None:
   239	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。
   240	
   241	    ⛔ symlink 一律拒绝读 (Codex round-1 HIGH-1): 文件 symlink 会被 is_file() 接纳并
   242	    跟随到 vault 外 —— 外部内容里的 wikilink 能藏住真孤儿。指 vault 内的 symlink
   243	    同样拒读 (保守, 方向 = 报盲区不假绿); 细节由 raw_derived 检查的 G10/G11 报出。
   244	    """
   245	    if path.is_symlink():
   246	        return None
   247	    try:
   248	        return path.read_text(encoding="utf-8")
   249	    except (OSError, UnicodeDecodeError, ValueError):
   250	        return None
   251	
   252	
   253	def _split_frontmatter(text: str) -> tuple[str, str]:
   254	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   255	    m = _FRONTMATTER.match(text)
   256	    return (m.group(1), m.group(2)) if m else ("", text)
   257	
   258	
   259	def _fm_scalar(fm: str, key: str) -> str | None:
   260	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   261	
   262	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   263	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   264	    ⛔ YAML null 语义 (Codex round-1 MEDIUM-1b): `source_board: null` 的字面是
   265	    "null" 字符串, 不归 None 会被当真值豁免真孤儿。只认 YAML 1.2 的 null 字面
   266	    (null/Null/NULL/~) —— **不含 "none"**: PyYAML 把 `none` 解析为普通字符串,
   267	    吞掉它 = 比 YAML 更宽 = 会误豁免真的叫 "none" 的值。
   268	    """
   269	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   270	    if not matches:
   271	        return None
   272	    v = matches[-1].strip()
   273	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   274	        v = re.sub(r"\s+#.*$", "", v)
   275	    v = v.strip().strip('"').strip("'")
   276	    if v in ("null", "Null", "NULL", "~"):
   277	        return None
   278	    return v or None
   279	
   280	
   281	def _norm_key(name: str) -> str:
   282	    """入链匹配键: NFC 归一 + casefold。
   283	
   284	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   285	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   286	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   287	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   288	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   289	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   290	    (假阴)。该权衡进验收单「不比什么」表。
   291	    """
   292	    return unicodedata.normalize("NFC", name).casefold().strip()
   293	
   294	
   295	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   296	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   297	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   298	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   299	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   300	
   301	
   302	def _strip_nonsemantic(body: str) -> str:
   303	    """剥离正文里**非语义**的 wikilink 载体 (Codex round-1 HIGH-2/HIGH-4 整改)。
   304	
   305	    依次剥: AUTO-GENERATED 哨兵段 (BEGIN 行 → END 行整段, 含成员列表)、
   306	    fenced code block (``` / ~~~ 围栏, 逐行状态机, 未闭合围栏剥到末尾)、
   307	    行内 code (`...` 反引号对)、HTML 注释 (同一行内的 <!-- ... -->)。
   308	    live 复算 (Codex round-1): 14 个节点的入链全部同时来自 source_board 与自动成员块,
   309	    去掉 AUTO 后 3 个节点没有其他入链 —— 陈旧自动块绝不能豁免孤儿。
   310	    """
   311	    out_lines: list[str] = []
   312	    fence: str | None = None
   313	    in_auto = False
   314	    for line in body.splitlines():
   315	        stripped = line.strip()
   316	        if in_auto:
   317	            if _AUTO_END_RE.match(stripped):
   318	                in_auto = False
   319	            continue  # 哨兵段内整行丢弃 (含 BEGIN/END 行本身)
   320	        if _AUTO_BEGIN_RE.match(stripped):
   321	            in_auto = True
   322	            continue
   323	        if fence is not None:
   324	            if stripped.startswith(fence):
   325	                fence = None
   326	            continue  # 围栏内整行丢弃
   327	        if stripped.startswith("```") or stripped.startswith("~~~"):
   328	            fence = stripped[:3]
   329	            continue
   330	        line = re.sub(r"<!--.*?-->", "", line)
   331	        line = re.sub(r"`[^`]*`", "", line)
   332	        out_lines.append(line)
   333	    # 跨行 HTML 注释 (<!-- ... --> 不在同一行): 状态机按行剥不掉, 文本级再兜一遍
   334	    return re.sub(r"<!--.*?-->", "", "\n".join(out_lines), flags=re.S)
   335	
   336	
   337	def _wikilink_targets(body: str) -> set[str]:
   338	    """正文里全部 wikilink 的 basename 集合 (已归一)。先经 `_strip_nonsemantic`。
   339	
   340	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   341	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   342	    (`resolve_node_id`) —— 三者本就同规则。
   343	
   344	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   345	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   346	       `__pycache__` —— 一个只读审计器绝不该改被审对象。
   347	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   348	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   349	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   350	
   351	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   352	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写,
   353	    Codex round-1 MEDIUM-1a)。**不**覆盖: 围栏/行内 code、HTML 注释 (含 AUTO 哨兵块)、
   354	    跨行 `[[..]]`、空 `[[]]` —— 全部判定为非入链。
   355	    """
   356	    out: set[str] = set()
   357	    for raw in _WIKILINK.findall(_strip_nonsemantic(body)):
   358	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   359	        inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   360	        if inner:
   361	            out.add(_norm_key(inner))
   362	    return out
   363	
   364	
   365	def _iter_md(root: Path) -> list[Path]:
   366	    """目录下全部 md 文件 (排序稳定, 扩展名大小写不敏感, symlink 保留在列)。
   367	
   368	    - suffix.lower() == ".md" 与 check_vault_doc_roles.py:1001 同口径 —— 本卡 round-2
   369	      前用 rglob("*.md"), 对 `.MD` 文件两边存在性判定不一致 (Codex round-1 MEDIUM-1a)。
   370	    - symlink **保留**在扫描面清单里, 但 `_read_text` 拒读 → 调用方记盲区 (Codex
   371	      round-1 HIGH-1): is_file() 会接纳 symlink 并在读取时跟随到 vault 外,
   372	      外部内容能藏住真孤儿。保留而非静默过滤 = 盲区必须显式可见。
   373	    """
   374	    if not root.is_dir():
   375	        return []
   376	    return sorted(p for p in root.rglob("*") if p.is_file() and p.suffix.lower() == ".md")
   377	
   378	
   379	# ---------------------------------------------------------------------------
   380	# 检查 1 — orphan_nodes
   381	# ---------------------------------------------------------------------------
   382	def check_orphan_nodes(vault: Path) -> CheckResult:
   383	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   384	
   385	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   386	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   387	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   388	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   389	
   390	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   391	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   392	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   393	
   394	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   395	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   396	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   397	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   398	    """
   399	    node_root = vault / NODE_DIR
   400	    notes: list[str] = []
   401	    blind: set[str] = set()
   402	
   403	    nodes = _iter_md(node_root)
   404	    if not node_root.is_dir():
   405	        return CheckResult(
   406	            name="orphan_nodes",
   407	            status=FAIL,
   408	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   409	            findings=[
   410	                Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")
   411	            ],
   412	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   413	            details={"nodes_scanned": 0, "inbound_targets": 0},
   414	        )
   415	
   416	    # 入链索引: 三处正文的 wikilink basename 全集, 按来源文件记账 (自链排除要用)
   417	    inbound: dict[str, set[str]] = {}
   418	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   419	        for src in _iter_md(vault / src_dir):
   420	            text = _read_text(src)
   421	            if text is None:
   422	                blind.add(src.relative_to(vault).as_posix())
   423	                continue
   424	            _fm, body = _split_frontmatter(text)
   425	            src_key = _norm_key(src.stem)
   426	            is_toplevel_node = src_dir == NODE_DIR and src.parent == vault / NODE_DIR
   427	            for target in _wikilink_targets(body):
   428	                if is_toplevel_node and target == src_key:
   429	                    continue  # 顶层节点的自链
   430	                inbound.setdefault(target, set()).add(src.relative_to(vault).as_posix())
   431	
   432	    findings: list[Finding] = []
   433	    for node in nodes:
   434	        key = _norm_key(node.stem)
   435	        if key in inbound:
   436	            continue
   437	        text = _read_text(node)
   438	        if text is None:
   439	            blind.add(node.relative_to(vault).as_posix())
   440	            continue
   441	        fm, _body = _split_frontmatter(text)
   442	        if _fm_scalar(fm, "source_board"):
   443	            continue
   444	        findings.append(
   445	            Finding(
   446	                node.relative_to(vault).as_posix(),
   447	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链, "
   448	                f"且 frontmatter 无 source_board",
   449	            )
   450	        )
   451	
   452	    if blind:
   453	        notes.append(
   454	            f"扫描盲区: {len(blind)} 个文件拒绝读出 (symlink / 非 UTF-8 / 权限), 未参与判定: "
   455	            + ", ".join(sorted(blind)[:5])
   456	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   457	        )
   458	    notes.append(
   459	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   460	        "顶层节点自链不算; 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED 哨兵块)、跨行 "
   461	        "[[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   462	        "symlink 文件与其所在目录 symlink 的后代不在扫描面内"
   463	    )
   464	    status = WARN if (findings or blind) else OK
   465	    return CheckResult(
   466	        name="orphan_nodes",
   467	        status=status,
   468	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿"
   469	        + (f", {len(blind)} 个盲区" if blind else ""),
   470	        findings=findings,
   471	        notes=notes,
   472	        details={"nodes_scanned": len(nodes), "inbound_targets": len(inbound), "blind_spots": len(blind)},
   473	    )
