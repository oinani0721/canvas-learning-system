    42	  rc=$?
    43	  # 还原 + 逐字节比对 (先还原再判定, 防中途退出留毒)
    44	  cp "$SCRIPT.bak-g82" "$SCRIPT"
    45	  if ! cmp -s "$SCRIPT" "$SCRIPT.bak-g82"; then echo "MUTANT $name: RESTORE-MISMATCH"; exit 9; fi
    46	  rm -f "$SCRIPT.bak-g82"
    47	
