   355	def test_orphan_ignores_nonsemantic_wikilinks(tmp_path):
   356	    """Codex round-1 HIGH-2/HIGH-4: 围栏 code / 行内 code / HTML 注释 (含 AUTO 哨兵块) /
   357	    跨行伪链 里的 wikilink 都不算入链 —— 每种形态单独一组 fixture, 节点必须仍报孤儿。
   358	    变异对照: 删掉 _strip_nonsemantic 后本组必红。"""
   359	    variants = {
   360	        "fenced": "```dataviewjs\n- [[被链]]\n```\n",
   361	        "inline_code": "命令 `- [[被链]] -` 示例\n",
   362	        "html_comment": "<!-- 说明: [[被链]] 已迁移 -->\n",
   363	        "auto_sentinel": (
   364	            "<!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py · 真相源 = 节点 frontmatter source_board\n"
   365	            "- [[被链]]\n"
   366	            "<!-- /AUTO-GENERATED -->\n"
   367	        ),
   368	        "multiline": "[[\n被链\n]]\n",
   369	    }
   370	    for name, board_body in variants.items():
   371	        root = tmp_path / name
   372	        _node(root, "被链")
   373	        _board(root, "板", board_body)
   374	        res = vl.check_orphan_nodes(root)
   375	        subjects = [f.subject for f in res.findings]
   376	        assert subjects == ["节点/被链.md"], f"{name} 形态的伪链豁免了真孤儿: findings={subjects}"
   377	
