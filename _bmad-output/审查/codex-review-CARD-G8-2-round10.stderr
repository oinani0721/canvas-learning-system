   168	# ── round-4 整改新增的防线 ──
   169	# M19 raw_derived 状态判定去掉 G8/G10/G11 盲区 → 扫描面问题假绿 ok
   170	mutate_and_test "M19-盲区不计状态" \
   171	  '        status=WARN if (findings or recap_blind or blind) else OK,|||        status=WARN if (findings or recap_blind) else OK,  # MUTANT' \
   172	  "test_raw_derived_g8_blind_forces_warn"
   173	
   174	# M20 AUTO BEGIN 分支拆除 (round-9 深度计数形态) → AUTO 段不识别, [[A]] 泄漏
   175	mutate_and_test "M20-BEGIN分支拆除" \
   176	  '        if _AUTO_BEGIN_RE.match(stripped):
   177	            depth += 1|||        if False:
   178	            depth += 1  # MUTANT' \
   179	  "test_orphan_ignores_nonsemantic_wikilinks"
   180	
   181	# ── round-8 整改新增的防线 ──
   182	# M23 嵌套 BEGIN 深度 +1 拆除 (round-9) → 内层 BEGIN 不加深, 第一个 END 提前关闸
   183	# M23 嵌套 BEGIN 深度 +1 拆除 (round-9) → 内层 BEGIN 不加深, 第一个 END 提前关闸
   184	# M23 嵌套 BEGIN 深度 +1 拆除 (round-9) → 内层 BEGIN 不加深, 第一个 END 提前关闸
   185	mutate_and_test "M23-嵌套深度拆除" \
   186	  '            if _AUTO_BEGIN_RE.match(stripped):\n                # ⛔ r9 H2: 嵌套 BEGIN —— 深度 +1, 第一个 END 不得提前关闸\n                depth += 1|||            if False:\n                depth += 1  # MUTANT' \
   187	  "test_nested_auto_begin_depth"
   188	
   189	# M24 fence 行保留谓词拆除 (round-9 fullmatch 形态) → AUTO 内 fence opener 被盲化,
   190	#  跨段 fence 状态丢失, [[A]] 泄漏 (r8 H1 回归)
   191	mutate_and_test "M24-fence行不保留" \
   192	  '            if re.fullmatch(r"(`{3,}|~{3,})[^`]*", stripped):|||            if False and re.fullmatch(r"(`{3,}|~{3,})[^`]*", stripped):  # MUTANT' \
   193	  "test_auto_fence_cross_keeps_fence_state"
   194	
   195	# M25 content 反斜杠剥离 (round-9 承重点) → escaped content 的 [[ 显形, 伪链采纳
   196	#  (raw_targets 守卫为冗余层: content 本身保留反斜杠才是 escaped 拒绝的承重路径)
   197	#  锚内的 \\ 在 bash 单引号中字面传递, python replace("\\n") 不动它, 正确落到源码
   198	# (M25 已删除: escaped 拒绝由 markdown-it-py 的转义处理直接承重——两个候选变异
   199	#  (拆 raw_targets 守卫 / 剥 content 反斜杠) 实测均不改变行为, 即该库语义不可变异;
   200	#  行为由集成测试 test_escaped_brackets_are_not_wikilink 锁定, 与 M16/M21/M22 同类。)
   201	
   202	# (M16/M21/M22 已删除: round-7 token 流重构后, closer 等长 / 转义反引号 / 跨段落
   203	#  三项 Markdown 语义全部由 markdown-it-py 库内正确处理 —— 库是外部依赖不可变异,
   204	#  行为由集成测试锁定 (test_code_span_closer_must_equal_opener /
   205	#  test_escaped_backtick_is_not_delimiter / test_code_span_does_not_span_blank_line),
   206	#  可变异面收敛到 M7 text 过滤 / M20 AUTO 段跳过两个本卡自有决策点。)
   207	
   208	echo "== 汇总 =="
   209	if [ -n "$FAILED" ]; then
   210	  echo "SURVIVED:$FAILED"
   211	  exit 1
   212	fi
   213	echo "ALL-KILLED"
