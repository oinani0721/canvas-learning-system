   227	def test_cli_exit_codes_match_report(tmp_path):
   228	    clean = _run_cli(_clean_vault(tmp_path / "clean"), "--now", NOW_ARG, "--json")
   229	    assert clean.returncode == 0, clean.stderr
   230	
