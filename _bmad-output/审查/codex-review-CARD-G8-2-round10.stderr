   341	
   342	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   343	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   344	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   345	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   346	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   347	
   348	
   349	def _blind_auto_lines(body: str) -> str:
   350	    """AUTO-GENERATED 哨兵段内的行盲化为注释行（**保留原行前导空白与 fence 标记行**），
   351	    其余行原样；返回（盲化文本, AUTO 行的原文行号 0-based 集合）。
   352	
   353	    ⛔ r8 H1/H2 + r9 H1/H2 教训累积：
   354	      - 按段切分逐段解析会丢失跨段 Markdown 状态（r8 H1）；
   355	      - 盲化行写到列 0 会终止 list/blockquote 容器（r9 H1）—— 盲化行必须**保留
   356	        原行前导空白**；
   357	      - AUTO 段内的 fence 标记行原样保留, 维持 fence 开合状态跨段连续（r8 H1）;
   358	        保留谓词 = 整行恰为 fence 标记（CommonMark: info string 不含反引号 ——
   359	        `` ```bad` [[A]] `` 的 info 含反引号不是 fence, 不得保留, r9 H1b）;
   360	      - **嵌套 BEGIN** 以深度计数处理（r9 H2）：BEGIN 深度 +1、END 深度 -1、
   361	        归零才退出 —— 布尔状态机会被内层 BEGIN 的第一个 END 提前关闸。
   362	      - 未闭合 AUTO 段到 EOF（r8 H2）→ 全部行保持盲化, 机器成员不泄漏。
   363	    """
   364	    out_lines: list[str] = []
   365	    auto_line_indices: set[int] = set()
   366	    depth = 0
   367	    # ⛔ 行模型与 mdit map 一致: 仅按 \n 分割 (r9 M5 —— splitlines 会把 VT/FF/NEL 等
   368	    #    也当行界, 导致盲化行号与 token.map 错位)。末行无 \n 时不补。
   369	    raw_lines = body.split("\n")
   370	    line_count = len(raw_lines)
   371	    for idx in range(line_count):
   372	        line = raw_lines[idx] + ("\n" if idx < line_count - 1 else "")
   373	        stripped = line.strip()
   374	        if depth > 0:
   375	            auto_line_indices.add(idx)
   376	            if _AUTO_BEGIN_RE.match(stripped):
   377	                # ⛔ r9 H2: 嵌套 BEGIN —— 深度 +1, 第一个 END 不得提前关闸
   378	                depth += 1
   379	                indent = line[: len(line) - len(line.lstrip())]
   380	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   381	                continue
   382	            if re.fullmatch(r"(`{3,}|~{3,})[^`]*", stripped):
   383	                out_lines.append(line)  # 纯 fence 标记行原样保留, 维持开合状态
   384	            else:
   385	                indent = line[: len(line) - len(line.lstrip())]
   386	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   387	            if _AUTO_END_RE.match(stripped):
   388	                depth -= 1
   389	            continue
   390	        if _AUTO_BEGIN_RE.match(stripped):
   391	            depth += 1
   392	            auto_line_indices.add(idx)
   393	            indent = line[: len(line) - len(line.lstrip())]
   394	            out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   395	            continue
   396	        out_lines.append(line)
   397	    return "".join(out_lines), auto_line_indices
   398	
   399	
   400	def _raw_wikilink_targets_in_lines(src_lines: list[str], line_lo: int, line_hi: int) -> set[str]:
   401	    """原文行区间 [line_lo, line_hi) 内、**未被反斜杠转义**的裸 wikilink target 集合
   402	    （已归一）。转义判定含反斜杠奇偶（`` \\\\[[A]] `` 的成对反斜杠后是真链接）。"""
   403	    targets: set[str] = set()
   404	    for i in range(line_lo, min(line_hi, len(src_lines))):
   405	        line = src_lines[i]
   406	        for m in _WIKILINK.finditer(line):
   407	            backslashes = 0
   408	            k = m.start() - 1
   409	            while k >= 0 and line[k] == "\\":
   410	                backslashes += 1
   411	                k -= 1
   412	            if backslashes % 2 == 1:
   413	                continue  # 被转义的 [[ 不是链接起点
   414	            inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   415	            inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   416	            if inner:
   417	                targets.add(_norm_key(inner))
   418	    return targets
   419	
   420	
   421	def _wikilink_targets(body: str) -> set[str]:
   422	    """正文里全部 wikilink 的 basename 集合（已归一）—— **token 流法**。
   423	
   424	    ⛔ round-7 终局重构（r9 H1/H2/H3 再修）：rounds 2-7 手写的 Markdown 剥除/区间解析
   425	      （正则反向引用 → maximal run 配对 → 字符偏移区间 → AUTO 切分逐段解析）每轮
   426	      修复都开新洞。重演 G8-1 的核心教训「不重新实现解析」：
   427	      - `_blind_auto_lines` 先把 AUTO 哨兵段盲化为**保留缩进与 fence 标记行**的等行数
   428	        注释行（Markdown 连续性与容器上下文不破坏），返回 AUTO 原文行号集合；
   429	      - 整文喂 **markdown-it-py**（venv 既有依赖 4.0.0, 各轮审查的对照裁判）：
   430	        block 级 fence/code_block/html_block 整块不扫；inline 级只扫 `text` children；
   431	        closer 等长 / 转义反引号 / maximal run / 跨段落 / 容器嵌套全部库内正确处理；
   432	      - ⛔ r9 H3：decoded match 逐个绑定**原文裸 target 集合**——inline token 的
   433	        `map` 原文行区间内, `_raw_wikilink_targets_in_lines` 收集的裸 target（含反斜杠
   434	        奇偶转义判定）必须包含该 decoded target 才采纳。解码形态（实体/转义/混合）
   435	        在原文无对应裸链接时一律拒绝, 且**逐 match 绑定**而非整 token 放行。
   436	
   437	    ⛔ orphan 权威口径（r8 M4, 待用户裁决）：本检查按 **markdown-it-py 4.0.0 的可渲染
   438	      文本**裁判 wikilink; 生产图（`wikilink_graph_service.Vault.connect()`）与 Obsidian
   439	      实际渲染的口径可能不同（如 HTML 标签内 wikilink）—— 差异为已声明口径边界。
   440	
   441	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   442	    （`_WIKILINK` + `wikilink_basename`）与 `board_manifest_service.py:132`
   443	    （`resolve_node_id`）—— 三者本就同规则。
   444	
   445	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   446	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   447	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   448	       复制的代价 = 会漂; 行为等价由 `test_wikilink_targets_matches_sync_board_concepts`
   449	       同源锁测试绑定（live sync 脚本可读时逐字对照）。
   450	
   451	    覆盖形态（各有测试用例）：`[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   452	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`（含 `.MD` 大写）。**不**覆盖：AUTO 哨兵段
   453	    （含未闭合到 EOF 与嵌套 BEGIN）、fenced/indented code、行内 code、HTML 注释/块、
   454	    blockquote/list 容器内的 code、转义反引号、跨行 `[[..]]`、空 `[[]]`、`\\[\\[` 转义
   455	    方括号（含奇偶判定）、HTML 实体形式的 `[[`、**decoded target 在原文无裸对应**的
   456	    一切形态。
   457	    """
   458	    blinded, auto_line_indices = _blind_auto_lines(body)
   459	    src_lines = body.split("\n")
   460	    md = _md_parser()
   461	    out: set[str] = set()
   462	    for token in md.parse(blinded):
   463	        if token.type != "inline" or not token.children:
   464	            continue  # fence/code_block/html_block 等 block 级: 整块不扫
   465	        token_map = token.map or [0, 1]
   466	        # ⛔ r9 H3: 原文裸 target 集合（token 所在原文行区间, 含转义奇偶判定）——
   467	        # decoded match 逐个绑定: 只有原文确实存在的裸链接才采纳。
   468	        raw_targets = _raw_wikilink_targets_in_lines(src_lines, token_map[0], token_map[1])
   469	        if not raw_targets:
   470	            continue
   820	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   821	    return CheckResult(
   822	        name="projection_freshness",
   823	        status=mapped,
   824	        summary=f"projection_status={status}",
   825	        findings=findings,
   826	        notes=[
   827	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   828	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   829	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   830	            "只判 读不出/非 object/缺 generated_at",
   831	        ],
   832	        details={"projection_status": status, "generated_at": gen, "error": error},
   833	    )
   834	
