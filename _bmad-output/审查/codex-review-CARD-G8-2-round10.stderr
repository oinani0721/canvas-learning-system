   161	# 报告数据结构 —— 文本与 JSON 的**唯一**真相源
   162	# ---------------------------------------------------------------------------
   163	@dataclass(frozen=True)
   164	class Finding:
   165	    subject: str  #: 出问题的 vault 相对路径 / 主体
   166	    detail: str
