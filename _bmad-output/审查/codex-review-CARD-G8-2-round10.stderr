   836	# ---------------------------------------------------------------------------
   837	# runner
   838	# ---------------------------------------------------------------------------
   839	#: 检查注册表 —— name → (说明, 是否需要 today)
   840	CHECKS: dict[str, str] = {
   841	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   842	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
   843	    "projection_freshness": "outputs/今日复习.json 的 generated_at 是否过期",
   844	}
   845	
   846	
   847	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   848	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   849	    if not vault.is_dir():
   850	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   851	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   852	    checks: list[CheckResult] = []
   853	    for name in selected:
   854	        if name == "orphan_nodes":
   855	            checks.append(check_orphan_nodes(vault))
   856	        elif name == "raw_derived_confusion":
   857	            checks.append(check_raw_derived(vault))
   858	        elif name == "projection_freshness":
   859	            checks.append(check_projection_freshness(vault, today))
   860	    return LintReport(
   861	        vault=str(vault),
   862	        today=today.isoformat(),
   863	        checks=checks,
   864	        skipped=[n for n in CHECKS if n not in selected],
   865	    )
   866	
   867	
   868	def _utcnow() -> datetime:
   869	    """时钟缝 (Codex round-1 MEDIUM-2): 唯一的取当前时刻处, 测试 patch 它来锁
   870	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   871	    return datetime.now(timezone.utc)
   872	
   873	
   874	def resolve_today(now: str | None) -> date:
   875	    """`--now` → 上海本地日。
   876	
   877	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   878	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   879	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   880	    """
   881	    if now is None:
   882	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   883	    try:
   884	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   885	    except ValueError as exc:
   886	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   887	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   888	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   889	    try:
   890	        return dt.astimezone(_TZ_SHANGHAI).date()
   891	    except (OverflowError, OSError) as exc:
   892	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   893	
   894	
   895	_EPILOG = f"""
   896	检查项与状态分级 (ok/warn/fail 的判定规则, Codex round-1 MEDIUM-4 要求写进 --help):
   897	  orphan_nodes            {CHECKS["orphan_nodes"]}
   898	                            warn = 有孤儿或有扫描盲区 (symlink/不可读, 盲区里的文件未参与判定);
   899	                            fail = `节点/` 目录不存在 (检查没查成, 不是零孤儿)
   900	  raw_derived_confusion   {CHECKS["raw_derived_confusion"]}
   901	                            warn = 有混淆 finding (G1/G2/G3/G4/G9 或 回顾-* 缺 type: recap),
   902	                            或存在扫描盲区 (G8/G10/G11 / recap 越界拒读 —— "没查全" ≠ "没问题");
   903	                            本检查无 fail 态
   904	  projection_freshness    {CHECKS["projection_freshness"]}
   905	                            warn = stale (今天还没跑推送) 或 no_projection;
   906	                            fail = corrupt (投影文件坏, 下游拿不到数据)
   907	
   908	退出码:
   909	  0  全部检查 ok
   910	  2  有 warn、无 fail
   911	  1  有 fail
   912	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法 /
   913	      参数用法错误)
   914	
   915	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   916	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   917	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   918	   "vault 有问题" 与 "lint 没跑成"。参数用法错误也归 3 (Codex round-1 HIGH-6:
   919	   argparse 默认 exit(2) 会与"有 warn"撞码)。
   920	
   921	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   922	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   923	"""
   924	
   925	
   926	class _LintArgumentParser(argparse.ArgumentParser):
   927	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   928	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   929	
   930	    def error(self, message: str):  # type: ignore[override]
   931	        self.print_usage(sys.stderr)
   932	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   933	        raise SystemExit(EXIT_CONFIG)
   934	
   935	
   936	def main(argv: list[str] | None = None) -> int:
   937	    ap = _LintArgumentParser(
   938	        prog="vault_lint.py",
   939	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   940	        epilog=_EPILOG,
   941	        formatter_class=argparse.RawDescriptionHelpFormatter,
   942	    )
   943	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   944	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   945	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   946	    ap.add_argument(
   947	        "--only",
   948	        action="append",
   949	        choices=sorted(CHECKS),
   950	        default=None,
   951	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   952	    )
   953	    args = ap.parse_args(argv)
   954	
   955	    try:
   956	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   957	    except LintConfigError as exc:
   958	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   959	        return EXIT_CONFIG
   960	
   961	    if args.json:
   962	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   963	    else:
   964	        print(render_text(report, color=sys.stdout.isatty()))
   965	    return exit_code(report)
   966	
   967	
   968	if __name__ == "__main__":
   969	    sys.exit(main())
