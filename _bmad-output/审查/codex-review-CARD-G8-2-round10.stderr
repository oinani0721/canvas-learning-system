   200	def test_clean_vault_all_ok_exit0(tmp_path):
   201	    root = _clean_vault(tmp_path / "v")
   202	    report = vl.run_checks(root, TODAY)
   203	    assert [c.status for c in report.checks] == [vl.OK, vl.OK, vl.OK], [
   204	        (c.name, c.status, c.summary) for c in report.checks
