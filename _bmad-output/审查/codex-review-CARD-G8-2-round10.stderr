   853	
   854	def test_live_vault_readonly_and_runs():
   855	    if not _LIVE_VAULT.is_dir():
   856	        pytest.skip(f"live vault 不可达: {_LIVE_VAULT}")
   857	    before = _vault_digest(_LIVE_VAULT)
   858	    report = vl.run_checks(_LIVE_VAULT, TODAY)
   859	    assert _vault_digest(_LIVE_VAULT) == before, "live vault 被改动 —— 零写铁律被打破"
   860	    assert vl.exit_code(report) in (0, 1, 2)
   861	    # 卡文裁判 2 的单测侧缩影: rc 与 JSON summary 一致
   862	    assert vl.exit_code(report) == vl.report_to_json(report)["summary"]["exit_code"]
   863	    # orphan 检查的如实性: 节点数必须与 live 实况一致 (probe-F 实测 14)
   864	    orphan = next(c for c in report.checks if c.name == "orphan_nodes")
   865	    assert orphan.details["nodes_scanned"] > 0, "live 节点/ 扫描数为 0 —— 扫描根错了"
