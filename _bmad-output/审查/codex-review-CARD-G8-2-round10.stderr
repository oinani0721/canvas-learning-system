   868	def test_no_duplicate_test_names():
   869	    """⛔ 防回归门 (round-2 收官自审发现): 同名测试函数后定义覆盖前定义 ——
   870	    pytest 收集只报一个, 被覆盖的判别力静默消失 (三变异 SURVIVED 的真凶)。
   871	    本文件任何 test_* 重名 = 直接红。"""
   872	    import ast as _ast
   873	
   874	    tree = _ast.parse(Path(__file__).read_text(encoding="utf-8"))
   875	    names = [
   876	        n.name
   877	        for node in _ast.walk(tree)
   878	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef))
   879	        for n in [node]
   880	        if n.name.startswith("test_")
   881	    ]
   882	    dupes = sorted({n for n in names if names.count(n) > 1})
   883	    assert dupes == [], f"存在重名测试 (后定义静默覆盖前定义): {dupes}"
   884	
