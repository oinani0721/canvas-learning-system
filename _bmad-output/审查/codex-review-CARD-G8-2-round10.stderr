   777	def test_vault_lint_source_has_no_write_primitives():
   778	    src = SCRIPT.read_text(encoding="utf-8")
   779	    forbidden = [
   780	        r"\.write_text\(",
   781	        r"\.write_bytes\(",
   782	        r"\.mkdir\(",
   783	        r"\.unlink\(",
   784	        r"\.touch\(",
   785	        r"\brmtree\b",
   786	        r"\bshutil\.",
   787	        r"os\.remove\(",
   788	        r"os\.rename\(",
   789	        r"""open\([^)]*["'][wax]""",
   790	        r"\bmkstemp\b",
   791	        r"\bNamedTemporaryFile\b",
   792	    ]
   793	    for pat in forbidden:
   794	        assert not re.search(pat, src), f"vault_lint.py 含写原语 {pat!r} —— 违反零写铁律"
