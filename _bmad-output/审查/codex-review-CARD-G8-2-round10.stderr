   145	def _vault_digest(vault: Path) -> list[tuple[str, str]]:
   516	def check_orphan_nodes(vault: Path) -> CheckResult:
   517	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   518	
   519	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   520	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   521	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   522	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   523	
   524	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   525	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   526	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   527	
   528	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   529	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   530	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   531	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   532	    """
   533	    node_root = vault / NODE_DIR
   534	    notes: list[str] = []
   535	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   536	
   537	    if not node_root.is_dir():
   538	        return CheckResult(
   539	            name="orphan_nodes",
   540	            status=FAIL,
   541	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   542	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   543	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   544	            details={"nodes_scanned": 0, "inbound_targets": 0},
   545	        )
   546	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   547	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   548	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   549	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   550	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   551	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   552	    inbound: dict[str, set[str]] = {}
   553	    nodes: list[Path] = []
   554	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   555	        srcs, src_blind = _walk_md(vault / src_dir)
   556	        for rel, why in src_blind.items():
   557	            blind[f"{src_dir}/{rel}"] = why
   558	        if src_dir == NODE_DIR:
   559	            nodes = srcs
   560	        for src in srcs:
   561	            blocked = _scan_block_reason(vault, src)
   562	            if blocked:
   563	                blind[src.relative_to(vault).as_posix()] = blocked
   564	                continue
   565	            text = _read_text(src)
   566	            if text is None:
   567	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   568	                continue
   569	            _fm, body = _split_frontmatter(text)
   570	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   571	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   572	            src_phys = os.path.realpath(src)
   573	            for target in _wikilink_targets(body):
   574	                inbound.setdefault(target, set()).add(src_phys)
   575	
   576	    findings: list[Finding] = []
   577	    for node in nodes:
   578	        own = node.relative_to(vault).as_posix()
   579	        blocked = _scan_block_reason(vault, node)
   580	        if blocked:
   581	            blind[own] = blocked
   582	            continue
   583	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   584	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   585	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   586	        #    realpath 归并, 不得绕过自身排除。
   587	        own_phys = os.path.realpath(node)
   588	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   589	        if sources:
   590	            continue
   591	        text = _read_text(node)
   592	        if text is None:
   593	            blind[own] = "unreadable"
   594	            continue
   595	        fm, _body = _split_frontmatter(text)
   596	        if _fm_scalar(fm, "source_board"):
   597	            continue
   598	        findings.append(
   599	            Finding(
   600	                own,
   601	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   602	                f"(自身出链不计), 且 frontmatter 无 source_board",
   603	            )
   604	        )
   605	
   606	    if blind:
   607	        notes.append(
   608	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   609	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   610	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   611	        )
   612	    notes.append(
   613	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   614	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   615	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   616	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   617	    )
   618	    status = WARN if (findings or blind) else OK
   619	    return CheckResult(
   620	        name="orphan_nodes",
   621	        status=status,
   622	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   623	        findings=findings,
   624	        notes=notes,
   625	        details={
   626	            "nodes_scanned": len(nodes),
   627	            "inbound_targets": len(inbound),
   628	            "blind_spots": len(blind),
   629	            "blind_detail": dict(sorted(blind.items())),
   630	        },
