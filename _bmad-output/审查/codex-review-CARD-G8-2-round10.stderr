   809	def test_bytecode_guard_is_armed():
   810	    """元门: 本进程的 .pyc 写入开关必须是关的 (oracle exec 与被测模块 import 都依赖它)。
   811	
   812	    probe-B 实测: 缺了它, oracle 的 import 闭包会往 backend/app/、app/core/、app/utils/
   813	    三处写 8 个 .pyc —— 光看 endpoints/ 会假绿。
   814	    """
   815	    assert sys.dont_write_bytecode is True
   816	    assert os.environ.get("PYTHONDONTWRITEBYTECODE") == "1", (
   817	        "卡文裁判命令要求 PYTHONDONTWRITEBYTECODE=1; 缺失时 sys.dont_write_bytecode "
   818	        "兜底仍成立, 但环境变量门是双保险的第二道, 不许悄悄失守"
   819	    )
