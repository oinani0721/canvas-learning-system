1271:def test_double_backslash_escape_is_real_link(tmp_path):
     1	# ⚠️ CARD-G8-2 (BATCH-2026-09-01-第八批) — 统一 /lint 骨架 + 首批三检查的裁判
     2	#
     3	# 被测物: backend/scripts/vault_lint.py (新)
     4	# 本文件禁用 conftest —— 全部 helper 在文件内 (卡文硬约束)。
     5	#
     6	# 语义钉死点:
     7	#   1. 三检查反例 (先红) —— 孤儿 / raw-derived 混入+recap 缺标记 / stale+corrupt 投影,
     8	#      每个反例的 findings 非空断言 = 检查逻辑被删时本文件必须变红
     9	#   2. 干净 fixture 全 ok + 退出码三态 (0/2/1) 与报告状态逐项一致
    10	#   3. orphan 形态表 —— 别名/子路径/embed/heading锚/带.md/NFC-NFD/大小写/空[[]]/
    11	#      frontmatter链/自链/检验白板链, 逐类标「判定/不判定」
    12	#   4. freshness 同源锁 ≥6 组 —— **活 oracle 比对**: 构造 vault fixture 后同时调
    13	#      真实 review_overview._vault_entry (spec_from_file_location 直载, 零包路由)
    14	#      与 vault_lint._projection_status, 断言 status 逐字相等;
    15	#      另附 17 组实测快照锚 (probe-B 2026-09-01 实测) 防 oracle 静默漂移
    16	#   5. --json 与文本同源 —— 解析文本输出逐项比对 JSON (同源门)
    17	#   6. 零写门 —— 源码写原语扫描 + fixture 真跑前后 shasum 逐字节相同
    18	#   7. 配置/环境错误 → 退出码 3 (vault 不存在 / --now 非法 / 台账 ConfigError 接线)
    19	#   8. --only / skipped 语义 —— 未跑的检查显式列出, 不伪造 ok
    20	#   9. --help 门 —— 三检查名与退出码语义必须在输出里
    21	#  10. live 只读跑通 (live 不可达时 skip; 跑前后全树 sha 逐字节相同)
    22	#
    23	# ⛔ oracle 加载纪律 (probe-B 实测 2026-09-01):
    24	#   - **禁** `from app.api.v1.endpoints.review_overview import ...` 包路由 —— 实测 29.4s /
    25	#     7875 模块 / import 期出站 HTTP (litellm 拉 model cost map) / 写 torchinductor tmp 目录。
    26	#   - 必须 spec_from_file_location 直载文件: 实测 0.95s / 557 模块 / 审计事件 0。
    27	#   - `sys.dont_write_bytecode = True` 必须在 exec_module **之前** —— 否则 oracle 的
    28	#     `from app.config import ...` 闭包会往 backend/app/ 等 3 处写 8 个 .pyc (实测)。
    29	#   - 零写若只看 endpoints/ 目录会假绿 —— 泄漏面在 app/、app/core/、app/utils/ 三处。
    30	
    31	from __future__ import annotations
    32	
    33	import hashlib
    34	import json
    35	import os
    36	import re
    37	import subprocess
    38	import sys
    39	import unicodedata
    40	from datetime import date, datetime, timezone
    41	from pathlib import Path
    42	
    43	import pytest
    44	
    45	# ⛔ 必须先于一切被测/oracle 模块加载 —— pytest assertion rewrite 与 import 闭包
    46	# 的 .pyc 写入都由它兜底 (卡文裁判命令另带 PYTHONDONTWRITEBYTECODE=1 双保险)
    47	sys.dont_write_bytecode = True
    48	
    49	BACKEND_DIR = Path(__file__).resolve().parents[2]
    50	_SCRIPTS_DIR = BACKEND_DIR / "scripts"
    51	for _p in (str(_SCRIPTS_DIR), str(BACKEND_DIR)):
    52	    if _p not in sys.path:
    53	        sys.path.insert(0, _p)
    54	
    55	import vault_lint as vl  # noqa: E402
    56	
    57	SCRIPT = _SCRIPTS_DIR / "vault_lint.py"
    58	TODAY = date(2026, 8, 31)
    59	NOW_ARG = "2026-08-31T12:00:00+08:00"
    60	
    61	# ---------------------------------------------------------------------------
    62	# oracle (真实 review_overview._vault_entry) —— spec_from_file_location 直载
    63	# ---------------------------------------------------------------------------
    64	_ORACLE = None
    65	
    66	
    67	def _oracle():
    68	    global _ORACLE
    69	    if _ORACLE is None:
    70	        import importlib.util
    71	
    72	        path = BACKEND_DIR / "app" / "api" / "v1" / "endpoints" / "review_overview.py"
    73	        spec = importlib.util.spec_from_file_location("_g82_review_overview_oracle", path)
    74	        assert spec is not None and spec.loader is not None, f"oracle 无法载入: {path}"
    75	        mod = importlib.util.module_from_spec(spec)
    76	        spec.loader.exec_module(mod)
    77	        assert hasattr(mod, "_vault_entry"), "oracle 模块里没有 _vault_entry"
    78	        _ORACLE = mod
    79	    return _ORACLE
