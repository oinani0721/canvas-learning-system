   153	# ---------------------------------------------------------------------------
   154	# 1. 三检查反例 (先红) —— 每个反例 findings 非空; 删掉对应检查逻辑此处必红
   155	# ---------------------------------------------------------------------------
   156	def test_orphan_counterexample_is_caught(tmp_path):
   157	    root = tmp_path / "v"
   158	    _node(root, "孤儿")
   159	    res = vl.check_orphan_nodes(root)
   160	    assert res.status == vl.WARN
