   889	def test_orphan_nested_symlink_dir_recorded_not_silent(tmp_path):
   890	    """Codex round-3 H1a: `节点/sub -> vault 外目录` —— os.walk 不深入嵌套目录
   891	    symlink, 其后代整棵不在扫描面 → 必须显式记盲区 (rglob 时代是 0 盲区静默消失);
   892	    外部内容的 [[x]] 不得豁免 x。"""
   893	    outside_dir = tmp_path / "outside"
   894	    outside_dir.mkdir()
   895	    (outside_dir / "A.md").write_text(NODE_FM + "- [[x]]\n", encoding="utf-8")
   896	    root = tmp_path / "v"
   897	    _node(root, "x")
   898	    sub = root / "节点" / "sub"
   899	    sub.parent.mkdir(parents=True, exist_ok=True)
   900	    sub.symlink_to(outside_dir, target_is_directory=True)
   901	    res = vl.check_orphan_nodes(root)
   902	    subjects = [f.subject for f in res.findings]
   903	    assert "节点/x.md" in subjects, f"嵌套 symlink 目录后代豁免了真孤儿: {res.findings}"
   904	    assert any("sub" in rel for rel in res.details["blind_detail"]), (
   905	        f"嵌套 symlink 目录必须记盲区: {res.details['blind_detail']}"
   906	    )
   907	    assert res.status == vl.WARN
