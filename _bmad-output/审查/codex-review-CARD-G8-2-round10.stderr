   948	def test_projection_symlink_outside_is_corrupt(tmp_path):
   949	    """Codex round-3 H1d: `outputs -> vault 外目录` 且外部投影是当天 ——
   950	    freshness 不得读取 vault 外文件, 判 corrupt (fail)。"""
   951	    outside = tmp_path / "outside-outputs"
   952	    (outside / "outputs").mkdir(parents=True)
   953	    payload = {
   954	        "schema_version": 3,
   955	        "generated_at": "2026-08-31T09:05:05+08:00",
   956	        "stats": {"due_nodes": 0},
   957	        "top_boards": [],
   958	        "upcoming": [],
   959	        "due_nodes": [],
   960	        "ineligible": {"placeholder": []},
   961	    }
   962	    (outside / "outputs" / "今日复习.json").write_text(json.dumps(payload), encoding="utf-8")
   963	    root = tmp_path / "v"
