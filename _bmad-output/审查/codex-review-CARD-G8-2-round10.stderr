   253	
   254	def test_config_error_from_ledger_wiring(tmp_path, monkeypatch):
   255	    """台账 ConfigError → LintConfigError (→ 退出码 3) 的接线。
   256	
   257	    注入的是**异常**而非假数据 —— 测的是 vault_lint 的错误路径接线, 不是用 mock 顶替实现。
   258	    (台账 SHA 单边篡改的行为门在 test_vault_doc_roles.py, 那边退出 2。)
   259	    """
   260	
   760	    """Codex round-1 HIGH-6: argparse 默认 exit(2) 与「有 warn」的 2 撞码 ——
   761	    用法错误归 3 (配置/环境错误族 = lint 没跑成)。"""
   762	    # 缺 --vault
   763	    env = dict(os.environ)
   764	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   765	    bad = subprocess.run([sys.executable, str(SCRIPT)], capture_output=True, text=True, env=env, timeout=60)
   766	    assert bad.returncode == 3, f"缺 --vault 必须 rc=3 (用法错误), 实为 {bad.returncode}"
   767	    assert "--vault" in bad.stderr
   768	    # --only 非法值
   769	    r = _run_cli(_clean_vault(tmp_path / "v"), "--only", "no_such_check")
   770	    assert r.returncode == 3, f"--only 非法值必须 rc=3, 实为 {r.returncode}"
   771	    assert "no_such_check" in r.stderr
