   164	def test_raw_derived_counterexample_is_caught(tmp_path):
   165	    root = tmp_path / "v"
   166	    p = root / "节点" / "混入.md"
   167	    p.parent.mkdir(parents=True)
   168	    p.write_text("---\ntype: recap\n---\n派生内容\n", encoding="utf-8")  # wiki 区混入派生标记 → G3
   169	    res = vl.check_raw_derived(root)
   170	    assert res.status == vl.WARN
   171	    # ⛔ G8-1 原生语义: G3 的 subject = ftype (同类聚合), 路径在 detail 里
   172	    g3 = [f for f in res.findings if f.detail.startswith("[G3]")]
   173	    assert g3, f"G3 未报: {[f.detail for f in res.findings]}"
   174	    assert any(f.subject == "recap" and "节点/混入.md" in f.detail for f in g3)
