   925	def test_orphan_unreadable_subtree_is_blind(tmp_path):
   926	    """Codex round-3 H2: `节点/locked`(chmod 000)`/A.md` —— 不可读子树整棵消失
   927	    时代已终结: os.walk(onerror) 必须把子树记为盲区, 且同目录其余节点照常判定。"""
   928	    if os.geteuid() == 0:
   929	        pytest.skip("root 用户不受 chmod 000 限制")
   930	    root = tmp_path / "v"
   931	    _node(root, "可见")
   932	    locked = root / "节点" / "locked"
   933	    locked.mkdir(parents=True)
   934	    (locked / "A.md").write_text(NODE_FM + "正文\n", encoding="utf-8")
   935	    locked.chmod(0o000)
   936	    try:
   937	        res = vl.check_orphan_nodes(root)
   938	    finally:
   939	        locked.chmod(0o755)  # 还原, 让 tmp_path 清理不炸
   940	    assert any("locked" in rel for rel in res.details["blind_detail"]), (
   941	        f"不可读子树必须记盲区: {res.details['blind_detail']}"
   942	    )
   943	    assert res.status == vl.WARN
   944	    subjects = [f.subject for f in res.findings]
   945	    assert "节点/locked/A.md" not in subjects  # 它不可读未判定, 不在 findings
