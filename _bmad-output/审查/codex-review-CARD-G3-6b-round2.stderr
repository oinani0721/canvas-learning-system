   616	
   617	def effective_rank_config(decay, version, minutes: dict) -> dict:
   618	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   619	
   620	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   621	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   622	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   623	    该变), 上限与因子序取代码常量, 分钟取 manifest 生效值。
   624	    """
   625	    return {
   626	        "version": version,
   627	        "ranking_factors": list(TIE_FACTOR_KEYS),
   628	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   629	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   630	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   631	    }
   632	
   633	
   634	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   635	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   636	    effective = effective_rank_config(decay, version, minutes)
   637	    _warn_recorded_drift(recorded, effective)
   638	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   639	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   640	
   641	
