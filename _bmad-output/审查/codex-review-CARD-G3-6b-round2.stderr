   588	
   589	def _recorded_claim(recorded: dict, key: str, subkey: str | None = None):
   590	    """recorded 小节取值, 剥掉 "_" 开头的说明键; 形状不符返 None (= 未登记)。"""
   591	    node = recorded.get(key)
   592	    if not isinstance(node, dict):
   593	        return None
   594	    if subkey is not None:
   595	        return node.get(subkey)
   596	    return {k: v for k, v in node.items() if not k.startswith("_")}
   597	
   598	
   599	def _warn_recorded_drift(recorded: dict, effective: dict):
   600	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   601	
   602	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   603	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   604	    """
   605	    for label, claimed, actual in (
   606	        ("ranking_factors.order",
   607	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   608	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   609	        ("decay_beta_constants",
   610	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   611	    ):
   612	        if claimed is not None and claimed != actual:
   613	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   614	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
   615	
   616	
   617	def effective_rank_config(decay, version, minutes: dict) -> dict:
   618	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   619	
   620	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   621	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   622	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   623	    该变), 上限与因子序取代码常量, 分钟取 manifest 生效值。
   624	    """
   625	    return {
   626	        "version": version,
   627	        "ranking_factors": list(TIE_FACTOR_KEYS),
   628	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   629	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   630	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   631	    }
   632	
   633	
   634	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   635	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   636	    effective = effective_rank_config(decay, version, minutes)
   637	    _warn_recorded_drift(recorded, effective)
   638	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   639	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   640	
   641	
   642	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   643	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   644	
   645	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   646	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   647	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   648	    """
   649	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   650	    overdue_days = None
   651	    if scheduled:
   652	        earliest_sh = _sh_local(min(scheduled))
   653	        if earliest_sh is not None:
   654	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   655	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   656	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   657	
   658	    rec = board_last_recommended.get(board, "")
   659	    gap = None
   660	    if rec:
   661	        try:
   662	            # 不夹负值 (Codex round-1 MEDIUM): 记录晚于今天属异常状态, 如实
   663	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   664	            # 「今天刚推荐过」, 违反 S4 不虚构。
   665	            gap = (today_sh - date.fromisoformat(rec)).days
   666	        except (ValueError, TypeError):
   667	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   668	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   669	            gap = None
   670	    return {
   671	        "due_total": len(due),
   672	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   673	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   674	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   675	        "overdue_days": overdue_days,
   676	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   677	        "never_recommended": not rec,
   678	        "recommend_gap_days": gap,
   679	    }
   680	
   681	
   682	def why_this_board(f: dict) -> str:
   683	    """S4 模板: factors → 恒非空人话串。纯函数 — 同一 factors 恒得同一句。
   684	
   685	    契约测试把落盘的 factors 原样喂回本函数, 要求与落盘的 why_this_board
   686	    逐字相同 —— 解释与数字之间没有第二条通路 (没有 LLM, 没有渲染层再算)。
   687	    """
   688	    scale = f"{int(f['due_total'])} 个节点到期"
   689	    if f["due_new"]:
   690	        scale += f"（其中 {int(f['due_new'])} 张新卡）"

