   302	def _aware(s: str) -> datetime:
   303	    dt = datetime.fromisoformat(str(s).strip().replace("Z", "+00:00"))
   304	    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
   305	
   306	
   307	def _fm_num(fm: str, key: str):
   308	    # 容负号 (Code-Review L5): mastery_a: -3 应进 corrupt 分支而非静默当无字段
   309	    m = re.search(rf'^{key}:\s*"?(-?[0-9]*\.?[0-9]+)"?\s*$', fm, re.M)
   310	    return float(m.group(1)) if m else None
   311	
   312	
   313	def _fm_str(fm: str, key: str):
   314	    m = re.search(rf'^{key}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   315	    return m.group(1).strip() if m else None

