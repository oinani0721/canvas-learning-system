   729	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   730	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   731	
   732	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   733	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   734	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   735	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   736	    """
   737	    minutes = minutes or DEFAULT_MINUTES
   738	    today_sh = _today_sh(now)
   739	    boards: dict[str, list] = {}
   740	    unassigned = []
   741	    for n in nodes:
   742	        if not n["board"]:
   743	            unassigned.append(n["node"])
   744	            continue
   745	        boards.setdefault(n["board"], []).append(n)
   746	
   747	    ranked, upcoming = [], []
   748	    for board, members in boards.items():
   749	        due = [n for n in members if n["due_now"]]
   750	        if not due:
   751	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   752	            nxt = min(members, key=lambda n: n["fsrs_due"])
   753	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   754	            continue
   755	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   756	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   757	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   758	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   759	        tie_parts = {
   760	            "priority_pick": round(top["pick"], 8),
   761	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   762	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   763	            "board": board,
   764	        }
   765	        ranked.append({
   766	            "board": board,
   767	            "top_node": top["node"],
   768	            "priority": round(top["pick"], 4),
   769	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   770	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   771	            "difficulty": top["difficulty"],
   772	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   773	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   774	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   775	            "why_this_board": why_this_board(factors),
   776	            "estimated_minutes": estimated_minutes(factors, minutes),
   777	            "factors": factors,
   778	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   779	        })
   780	    ranked.sort(key=lambda r: r["_tie"])
   781	    for r in ranked:
   782	        del r["_tie"]
   783	    upcoming.sort(key=lambda u: u["next_due"])
   784	    return ranked, upcoming, unassigned
