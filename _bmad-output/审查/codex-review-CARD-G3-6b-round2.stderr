  1595	def _tie_fixture_vault(tmp_path) -> tuple[Path, Path]:
  1596	    """排序金样 fixture: 四块板 pick 全同 (同 mastery 无 fsrs_due), tie-break
  1597	    逐级可辨 —— 乙板有推荐记录 (blr 罚后), 其余三块按 板名 排。state 单独
  1598	    成文件供两个版本的 CLI 同参消费。"""
  1599	    vault = tmp_path / "tiefixture"
  1600	    (vault / ".claude" / "scripts").mkdir(parents=True)
  1601	    (vault / "节点").mkdir()
  1602	    shutil.copy(WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py", vault / ".claude" / "scripts")
  1603	    for board in ("甲板", "乙板", "丙板", "丁板"):
  1604	        (vault / "节点" / f"{board}节点.md").write_text(
  1605	            "---\ntype: concept\n"
  1606	            f'source_board: "[[原白板/{board}]]"\n'
  1607	            "mastery_a: 2.0\nmastery_b: 3.0\n---\n真实内容。\n",
  1608	            encoding="utf-8",
  1609	        )
  1610	    state = tmp_path / "state.json"
  1611	    state.write_text(json.dumps({"board_last_recommended": {"乙板": "2026-07-28"}}), encoding="utf-8")
  1612	    return vault, state
