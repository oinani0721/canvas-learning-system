   719	def estimated_minutes(f: dict, minutes: dict) -> int:
   720	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   721	
   722	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   723	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   724	    """
   725	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   726	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
