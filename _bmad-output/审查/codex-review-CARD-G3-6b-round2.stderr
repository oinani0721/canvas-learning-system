   549	    静默 (静默降级 = 把配置断裂伪装成"就该是这个数")。version 只在文件与
   550	    version 字段双双可用时为整数, 其余一律 None ("没有版本"而非假装有)。
   551	    """
   552	    path = Path(path) if path is not None else Path(__file__).resolve().parent / MANIFEST_FILENAME
   553	    minutes = dict(DEFAULT_MINUTES)
   554	    try:
   555	        raw = json.loads(path.read_text(encoding="utf-8"))
   556	    except (OSError, ValueError) as e:  # ValueError ⊃ JSONDecodeError
   557	        print(f"[pick] 系数清单不可用, 用内置默认: {path} ({type(e).__name__})", file=sys.stderr)
   558	        return None, minutes, {}
   559	    if not isinstance(raw, dict):
   560	        print(f"[pick] 系数清单不是 object, 用内置默认: {path}", file=sys.stderr)
   561	        return None, minutes, {}
   562	
   563	    version = raw.get("version")
   564	    if not isinstance(version, int) or isinstance(version, bool):
   565	        print(f"[pick] 系数清单 version 非整数, 记为 None: {version!r}", file=sys.stderr)
   566	        version = None
   567	
   568	    auth = raw.get("authoritative")
   569	    cfg = auth.get("estimated_minutes") if isinstance(auth, dict) else None
   570	    if isinstance(cfg, dict):
   571	        for k in DEFAULT_MINUTES:
   572	            v = cfg.get(k)
   573	            if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
   574	                minutes[k] = v
   575	            else:
   576	                # 缺键与非法值同等待遇: 点名后再回落 (Codex round-1 MEDIUM —
   577	                # 只验"在场但坏", 会放过"压根没写"的半份配置, 让静默回落
   578	                # 伪装成用户确实配了)
   579	                print(f"[pick] estimated_minutes.{k} 缺失或非法({v!r}), 用内置默认 {minutes[k]}",
   580	                      file=sys.stderr)
   581	    elif cfg is not None:
   582	        print(f"[pick] authoritative.estimated_minutes 形状不符, 用内置默认: {cfg!r}",
   583	              file=sys.stderr)
   584	
   585	    recorded = raw.get("recorded")
   586	    return version, minutes, (recorded if isinstance(recorded, dict) else {})
