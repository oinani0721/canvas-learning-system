   589	def _recorded_claim(recorded: dict, key: str, subkey: str | None = None):
   590	    """recorded 小节取值, 剥掉 "_" 开头的说明键; 形状不符返 None (= 未登记)。"""
   591	    node = recorded.get(key)
   592	    if not isinstance(node, dict):
   593	        return None
   594	    if subkey is not None:
   595	        return node.get(subkey)
   596	    return {k: v for k, v in node.items() if not k.startswith("_")}
   597	
   598	
   599	def _warn_recorded_drift(recorded: dict, effective: dict):
   600	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   601	
   602	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   603	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   604	    """
   605	    for label, claimed, actual in (
   606	        ("ranking_factors.order",
   607	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   608	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   609	        ("decay_beta_constants",
   610	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   611	    ):
   612	        if claimed is not None and claimed != actual:
   613	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   614	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
