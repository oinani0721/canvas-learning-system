  2595	                    f"依据 {basis!r} 在真实 scan JSON 里解析不到（到 {part!r} 断链）"
  2596	                )
  2597	                node = node[part]
  2598	        elif basis == "md:heading":
  2599	            assert pattern.pattern.startswith("^#{1,6}"), f"依据声明为标题结构，模式却不是标题锚定: {pattern.pattern!r}"
  2600	        elif basis == "skill:action-verb":
