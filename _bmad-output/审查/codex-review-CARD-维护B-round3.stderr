  1381	    由调用方按"无法验证"处理, 不静默放行。
  1382	    """
  1383	    total, section, digit, seen = 0, 0, None, False
  1384	    for ch in s:
  1385	        if ch in _CJK_NUM:
  1386	            digit = _CJK_NUM[ch]
  1387	            seen = True
  1388	        elif ch in _CJK_UNIT:
  1389	            unit = _CJK_UNIT[ch]
  1390	            if unit >= 10000:
  1391	                section = (section + (digit or 0)) if (section or digit) else 1
  1392	                total += section * unit
  1393	                section, digit = 0, None
  1394	            else:
  1395	                section += (digit if digit is not None else 1) * unit
  1396	                digit = None
  1397	            seen = True
  1398	        else:
  1399	            return None
  1400	    if not seen:
  1401	        return None
  1402	    return total + section + (digit or 0)
