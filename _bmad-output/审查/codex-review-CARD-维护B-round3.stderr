  1100	                # round-4 新增 FAIL: percentile_ref 为 null 时原先会渲染成
  1101	                # "p25/p50/p75 = None/None/None" 且照样匹配 → schema 侧已要求
  1102	                # 有数档必须有 dict 分位, 这里再兜一层
  1103	                if not isinstance(sig.get("percentile_ref"), dict):
  1104	                    problems.append(
  1105	                        f"数字终核: signals.{key} 有数档但 percentile_ref 不是对象"
  1106	                    )
  1107	                    continue
  1108	                body = (
  1109	                    rf"{re.escape(label)}[：:]\s*最老\s*{sig['value']}\s*天\s*"
  1110	                    rf"[（(]\s*参与统计\s*{sig['denominator']}\s*条[，,]\s*"
  1111	                    rf"p25/p50/p75\s*=\s*{pr.get('p25_days')}/{pr.get('p50_days')}"
  1112	                    rf"/{pr.get('p75_days')}\s*天\s*[）)]"
