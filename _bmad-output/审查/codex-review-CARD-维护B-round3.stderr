  1053	        problems.append("数字终核: scan JSON 含 signals 但报告缺 ③ 段可绑定信号行")
  1054	        return
  1055	    all_labels = [lb for _, lb in _SIGNAL_SPECS]
  1056	    for key, label in _SIGNAL_SPECS:
  1057	        sig = signals.get(key)
  1058	        if not _verify_signal_schema(key, sig, problems):
