  1716	def _verify_report(path: str) -> int:
  1717	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  1718	
  1719	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  1720	    """
  1721	    try:
  1722	        text_raw = Path(path).read_text(encoding="utf-8")
  1723	    except (OSError, UnicodeDecodeError) as e:
  1724	        print(f"✗ 报告不可读: {type(e).__name__}")
  1725	        return 1
  1726	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  1727	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  1728	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  1729	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  1730	    if not fm_m:
  1731	        print("✗ 报告缺 frontmatter 块")
  1732	        return 1
  1733	    fm = fm_m.group(1)
  1734	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  1735	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  1736	    if "<!--" in fm or "-->" in fm:
  1737	        print("✗ frontmatter 块内含 HTML 注释标记")
  1738	        return 1
  1739	    problems: list[str] = []
  1740	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  1741	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  1742	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  1743	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  1744	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  1745	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  1746	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  1747	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  1748	    if "<!--" in text_raw or "-->" in text_raw:
  1749	        problems.append(
  1750	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  1751	        )
  1752	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  1753	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  1754	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
  1755	    # round-4: 零宽/双向控制字符 — 渲染不可见但能改变正则匹配与阅读顺序,

