  1505	            line = _D2_RANGE_RE.sub(_range_ok, line)
  1506	            # E6b: 逐字模板常量整段挖空 (等长, 保持偏移)
  1507	            for const in _D2_TEMPLATE_CONSTANTS:
  1508	                line = line.replace(const, " " * len(const))
