   961	def _strip_code_blocks(text: str) -> str:
   962	    """剔除**围栏**代码块 (```/~~~), 含引用块内的围栏 (round-4 M3 → round-5)。
   963	
   964	    代码块里的内容渲染为字面文本, 不是报告的陈述 —— 把信号行藏进去曾让
   965	    verifier 认为"信号行在场"。行数保持不变 (整行替空), 以免影响其他基于
   966	    行的校验。
   967	
   968	    round-5 两项修正:
   969	      · 引用前缀 (``> ``) 内的围栏此前不被识别 (``> ``` `` 逃逸) → 先剥
   970	        引用前缀再判围栏;
   971	      · **不再剥四空格缩进块** —— 合法的三级嵌套列表 (四空格缩进) 会被误删,
   972	        实测导致"③段缺信号行"误报。缩进块里的信号行改由信号行自身的
   973	        严格模板拒绝 (模板行首只允许 ``> ``/``- ``/空白, 不允许四空格缩进)。
   974	
   975	    ⛔ 维护卡 B · E1 (round-6 实证反例 `four-fence-short-close`): 原实现只存
   976	    ``bare[:3]`` 并用 ``startswith`` 判闭合 —— 四反引号开栏、三反引号"闭合"后,
   977	    后续内容被当成**块外正文**, 于是藏在 ``<pre><code>`` 里的信号行仍被 verifier
   978	    当成在场陈述 (实测 exit 0)。CommonMark 的规则是: 闭合围栏必须**同字符**且
   979	    **不短于**开栏。这里按规则记录开栏的完整标记再比长度。
   980	    """
   981	    out: list[str] = []
   982	    fence: str | None = None  # 开栏的完整标记, 如 "````"
   983	    # ⛔ Codex round-1 BLOCKER-1: 只比字符与长度**仍不是** CommonMark ——
   984	    # 闭栏行在标记之后**只能有空白**(`` ````not-a-valid-close `` 不是闭栏),
   985	    # 且围栏行缩进最多三格 (四格起是缩进代码块)。少这两条时,
   986	    # ````text 后跟一个带 info string 的伪闭栏就能让后续信号行"看起来在块外",
   987	    # 而 CommonMark 渲染里它们全在 <pre><code> 内 —— 实测 exit 0。
   988	    open_re = re.compile(r"^(?P<ind> {0,3})(?P<fence>`{3,}|~{3,})")
   989	    close_re = re.compile(r"^ {0,3}(?P<fence>`{3,}|~{3,})[^\S\n]*$")
   990	    for ln in text.splitlines():
   991	        # 剥任意层引用前缀后再判围栏。
   992	        # ⛔ CARD-维护B-R2 round-2 线索（Codex 被截断前的中途发现, 本车道独立复现）:
   993	        # 只剥 `>`/空白不剥**列表标记**时, `> - ``` ` (列表项内围栏, Obsidian 渲染为
   994	        # 列表项内的代码块) 不被识别为开栏 —— 藏进里面的信号行被当成在场陈述,
   995	        # 整篇 VERIFY PASS (实测 A/A2 两形态 exit 0)。剥列表符只影响**围栏判定**
   996	        # (非围栏行 out.append 原样保留), 标记后须有空白 (`- ``` 是列表项围栏,
   997	        # `---` 是 thematic break 不是列表)。
   998	        bare = re.sub(r"^[>\s]*(?:[-*+][^\S\n]+)?", "", ln)
   999	        if fence is None:
  1000	            m = open_re.match(bare)
  1001	            # 反引号围栏的 info string 不得含反引号 (CommonMark);
  1002	            # 波浪线围栏无此限制。
  1003	            if m and not (m.group("fence")[0] == "`" and "`" in bare[m.end() :]):
  1004	                fence = m.group("fence")
  1005	                out.append("")
  1006	                continue
  1007	        else:
  1008	            mc = close_re.match(bare)
  1009	            # 闭合: 同字符 + 长度 ≥ 开栏 + 其后只有空白
  1010	            if (
  1011	                mc
  1012	                and mc.group("fence")[0] == fence[0]
  1013	                and len(mc.group("fence")) >= len(fence)
  1014	            ):
  1015	                fence = None
  1016	            out.append("")
  1017	            continue
  1018	        out.append(ln)
  1019	    return "\n".join(out)
