   910	def _verify_signal_schema(key: str, sig, problems: list[str]) -> bool:
   911	    """signals.<key> 子对象 schema fail-closed (Codex round-2 M2)。
   912	
   913	    只校验顶层 signals 是 dict 不够 — 把子对象削成 {"availability":"无据"}
   914	    就能让报告写四条"无据"蒙混过关。必需五键齐全 / availability 属枚举 /
   915	    无据 ⇒ value is None 且 denominator == 0 / 有数 ⇒ value 是整数。
   916	    """
   917	    if not isinstance(sig, dict):
   918	        problems.append(f"数字终核: scan JSON signals.{key} 形状损坏")
   919	        return False
   920	    missing = [f for f in _SIGNAL_REQUIRED_FIELDS if f not in sig]
   921	    if missing:
   922	        problems.append(f"数字终核: signals.{key} 缺必备字段 {missing}")
   923	        return False
   924	    avail = sig.get("availability")
   925	    if avail not in _AVAIL_ENUM:
   926	        problems.append(f"数字终核: signals.{key}.availability 非法值 {avail!r}")
   927	        return False
   928	    if avail == AVAIL_NODATA:
   929	        if sig.get("value") is not None or sig.get("denominator") != 0:
   930	            problems.append(f"数字终核: signals.{key} 标无据却带数值 (契约违反)")
   931	            return False
   932	    else:
   933	        # round-3 M2: Python 里 bool 是 int 子类 — `value: true` 配报告 "1/N"
   934	        # 曾整条通过。显式排除 bool。
   935	        for f in ("value", "denominator"):
   936	            v = sig.get(f)
   937	            if isinstance(v, bool) or not isinstance(v, int):
   938	                problems.append(
   939	                    f"数字终核: signals.{key}.{f} 非整数 ({type(v).__name__})"
   940	                )
   941	                return False
   942	        # round-4 新增 FAIL: 年龄信号有数档时 percentile_ref 必须是含三个整数
   943	        # 分位的对象 — 置 null 时报告渲染成 "None/None/None" 曾照样通过。
   944	        if key == "unanswered_question_age":
   945	            pr = sig.get("percentile_ref")
   946	            if not isinstance(pr, dict):
   947	                problems.append(
   948	                    f"数字终核: signals.{key} 有数档但 percentile_ref 非对象"
   949	                )
   950	                return False
   951	            for pk in ("p25_days", "p50_days", "p75_days"):
   952	                pv = pr.get(pk)
   953	                if isinstance(pv, bool) or not isinstance(pv, int):
   954	                    problems.append(
   955	                        f"数字终核: signals.{key}.percentile_ref.{pk} 非整数"
   956	                    )
   957	                    return False
   958	    return True
