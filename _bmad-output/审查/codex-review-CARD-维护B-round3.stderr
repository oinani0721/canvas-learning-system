  1022	def _verify_signal_lines(text: str, signals: dict, problems: list[str]) -> None:
  1023	    """G5-4 信号绑定 (fail-closed): scan JSON 含 signals 键才进本函数。
  1024	
  1025	    ③段必须逐信号给**独占一行**的标准行, 行内数字与 availability 档与
  1026	    signals.* 全等 — 篡改任一数字 / 档位 / 缺行 / 无据错标 / 合并行 → FAIL。
  1027	    旧 scan JSON (无 signals 键) 由调用方跳过 (兼容)。同 label 行若出现
  1028	    多条, 逐条全查 — 防"一条合规一条私货"的双行逃逸。
  1029	    """
  1030	    # M3 (round-2 → round-4): ③ 段止于下一个 ## / ###。历轮收紧:
  1031	    #   round-2 只认 ###（"## 附录"可越界）→ round-3 认 tab 分隔（"##\t附录"）
  1032	    #   → round-4 认**空标题** `##`（行尾即止，无标题文字也是合法标题）。
  1033	    # 另: 信号行**不得藏在代码块里** — fenced (```/~~~) 与四空格缩进块在渲染
  1034	    # 时是字面文本, 与"报告在说什么"分叉, 故校验前整体剔除。
  1035	    scan_text = _strip_code_blocks(text)
  1036	    # ⛔ round-6 终裁复核: 剔除代码块是**双向**的 — 它挡住"把必需行藏进围栏",
  1037	    # 却放行"在合规行之外再往围栏里追加一组造假信号行"(围栏内容在 Obsidian
  1038	    # 里照常渲染为可见文本, 读者会看到与 scan JSON 冲突的第二组数字)。
  1039	    # 故: 被剔除的那部分文本里**不得出现任何信号 label**。
  1040	    stripped_only = "\n".join(
  1041	        a for a, b in zip(text.splitlines(), scan_text.splitlines()) if a != b
  1042	    )
  1043	    for _, lb in _SIGNAL_SPECS:
  1044	        if lb in stripped_only:
  1045	            problems.append(
  1046	                f"代码块内出现信号名 {lb} (围栏内容仍会渲染给读者, "
  1047	                "不得放置第二组信号数字)"
  1048	            )
