  2565	def test_domain_derive_allow_entries_are_grounded(tmp_path):
  2566	    """d2 · S4 承重门②「允许式绑定结构门」: 每条允许式都必须有**可验证的依据**。
  2567	
  2568	    d1 拦的是"表外的句子"，d2 拦的是"往表里塞一条没有依据的模式"——
  2569	    后者才是 survivor 的实际形态（改的是实现，不是报告）。
  2570	    逐条判据:
  2571	      · `scan:<路径>` → 该路径必须能在**真实** scan JSON 里解析到；
  2572	      · `md:heading`  → 模式必须以 `^#{1,6}` 起（真的是在匹配标题结构）；
  2573	      · `skill:action-verb` → 模式必须含 SKILL HARD-CONSTRAINTS 白名单动词之一；
  2574	      · `skill:③段固定句式` → 归口 SKILL.md ③段模板/叙述句式；
  2575	      · 且**每条**模式至少匹配一条 SKILL 模板正例、且**不匹配** d1 反例集里的任何一行。
  2576	
  2577	    最后一条是关键: 「备注：…派生…」这类自由允许式无论挂什么依据，
  2578	    都会因为"匹配到了 d1 反例"而变红。
  2579	
  2580	    **它证明什么**: 表内 8 条允许式各有可解析的依据、都在匹配真实模板形态、
  2581	    且没有一条会顺带放行 d1 的越界语料。
  2582	    **它不证明什么**: 不证明这 8 条**穷尽**了合法形态（漏一条合法形态表现为误伤，
  2583	    由 live/合成真语料放行门守）；`skill:③段固定句式` 的依据是**语义归口**，
  2584	    不是与 SKILL.md 的逐字比对（SKILL.md:203 原文无「角色」二字，逐字锁会锁错）。
  2585	    """
  2586	    rs = _load_recap_scan()
  2587	    scan = collect_json(standard_vault(tmp_path))
  2588	    table = rs._FALLBACK_DERIVE_ALLOW
  2589	    assert len(table) >= 8, f"允许式表条目数异常: {len(table)}"
  2590	    for pattern, basis in table:
  2591	        if basis.startswith("scan:"):
  2592	            node = scan
  2593	            for part in basis[len("scan:") :].split("."):
