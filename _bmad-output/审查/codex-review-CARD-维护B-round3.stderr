  2240	def _parse_skill_tail_notes(skill_text: str) -> list[str]:
  2241	    """从 SKILL.md ③段铁律里解析**信号行尾部注记**封闭表（CARD-维护B-R2 (e)）。"""
  2242	    idx = skill_text.find("附注只许")
  2243	    if idx < 0:
  2244	        return []
  2245	    for line in skill_text[idx:].splitlines()[1:]:
  2246	        toks = re.findall(r"`([^`\n]+)`", line)
  2247	        if toks:
  2248	            return toks
  2249	    return []
