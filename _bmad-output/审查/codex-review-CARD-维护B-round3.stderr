  1065	        for line in lines:
  1066	            # H3 (Codex round-2): 每行只许承载一个信号 — 四信号合并成一行时,
  1067	            # "首个数字匹配 + 整行任意位置找档位" 会让档位互相借用而放行。
  1068	            if sum(1 for lb in all_labels if lb in line) > 1:
