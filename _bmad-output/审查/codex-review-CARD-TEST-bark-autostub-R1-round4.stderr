    47	
    48	    send_bark = sys.modules.get("send_bark")
    49	    if send_bark is None:
    50	        print(f"{BAD} send_bark 未进入 sys.modules — 守卫并没有真的 import 它")
    51	        return 1
    52	
    53	    kf = Path(send_bark.KEY_FILE)
    54	    problems = []
    55	    if kf != expected:
    56	        problems.append(f"KEY_FILE={kf} 不等于本进程真实默认 {expected}")
    57	    # 只在「路径本来就不对」时才补报痕迹 —— 合法自定义路径完全可以叫
    58	    # /tmp/legitimate-bark-guard-config/key (round-3 审查实证误报)。
    59	    if kf != expected and "bark-guard-" in str(kf):
    60	        problems.append("KEY_FILE 仍带守卫 tmp 目录痕迹 (bark-guard-*)")
    61	    # 冷启动加载的模块属性: 全局还原对账只比对 collection 期就已存在的模块,
    62	    # 冷启动这一面归本脚本管 (round-3 审查指出的覆盖缺口)。
    63	    if getattr(send_bark._urlopen, "__qualname__", "") != "urlopen":
    64	        problems.append(f"send_bark._urlopen 未恢复 (现为 {send_bark._urlopen!r})")
    65	    runner = sys.modules.get("daily_review_run")
    66	    if runner is not None and getattr(runner.osascript_fallback, "__qualname__", "") != "osascript_fallback":
    67	        problems.append(f"daily_review_run.osascript_fallback 未恢复 (现为 {runner.osascript_fallback!r})")
    68	    # 只在「路径本来就不对」时才补报父目录 —— 合法的自定义配置完全可以指向一个
    69	    # 尚未创建的父目录 (round-2 审查用 BARK_KEY_FILE=/tmp/<不存在>/key 实证误报)。
    70	    if kf != expected and not kf.parent.is_dir():
    71	        problems.append(f"KEY_FILE 的父目录已不存在 ({kf.parent}) — 典型的已删 tmp 残留")
    72	    if os.environ.get("BARK_KEY_FILE") != env_before:
    73	        problems.append(f"env BARK_KEY_FILE 未恢复 (现 {os.environ.get('BARK_KEY_FILE')!r}, 原 {env_before!r})")
    74	
    75	    if problems:
    76	        for p in problems:
    77	            print(f"{BAD} {p}")
    78	        return 1
    79	    print(f"{OK} KEY_FILE={kf} (= 真实默认, 无 tmp 残留, env 已恢复)")
    80	    return 0
    81	
    82	
    83	if __name__ == "__main__":
    84	    sys.exit(main())

