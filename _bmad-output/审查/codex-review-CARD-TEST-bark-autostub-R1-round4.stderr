   150	def pytest_runtest_logreport(report):
   151	    rec = {
   152	        "nodeid": report.nodeid,
   153	        "when": report.when,
   154	        "outcome": report.outcome,
   155	    }
   156	    longrepr = getattr(report, "longrepr", None)
   157	    crash = getattr(longrepr, "reprcrash", None)
   158	    if crash is not None:
   159	        rec["crash_path"] = crash.path
   160	        rec["crash_lineno"] = crash.lineno
   161	        rec["crash_message"] = crash.message
   162	    tb = getattr(longrepr, "reprtraceback", None)
   163	    if tb is not None:
   164	        rec["frames"] = [f for f in (_fileloc(e) for e in getattr(tb, "reprentries", [])) if f]
   165	    _RECORDS.append(rec)
