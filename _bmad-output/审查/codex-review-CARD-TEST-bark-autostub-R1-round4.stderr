   394	def test_osascript_prebound_alias_blocked(monkeypatch):
   395	    """H 门 (armed): collection 期 from-import 预绑定的 osascript_fallback
   396	    别名, 也必须在**副作用之前**被拦 (round-3 MEDIUM 升级为 R1 完成条件 d)。
   397	
   398	    守卫层③ 换的是模块属性, 换不掉 _PREBOUND_OSASCRIPT 这个已绑定对象;
   399	    它执行时仍按模块全局查 subprocess.run —— 层⑥ 就拦在那里。
   400	    探针自装 Popen 墙作最后防线: 卸甲形态下真 subprocess.run 会走到墙,
   401	    抛 AssertionError (osascript_fallback 只吞 OSError/TimeoutExpired,
   402	    AssertionError 必然穿透) → H' 必红, 且两形态都不会真弹通知。"""
   403	
   404	    def _wall(*a, **kw):
   405	        raise AssertionError("BARK-GATE-H-OSASCRIPT-SPAWN: 真 osascript spawn 已抵达 subprocess.Popen")
   406	
   407	    monkeypatch.setattr(subprocess, "Popen", _wall)
   408	    assert _PREBOUND_OSASCRIPT({"title": "bark-gate-h", "body": "bark-gate-h"}) is True, (
   409	        "BARK-GATE-H-RETURN: 预绑定别名未被守卫层⑥ 接管"
   410	    )
   411	
   412	    # 误吞面: basename 不是 osascript 的命令必须原样透传 (会撞上探针的 Popen 墙)。
   413	    # 原来的 substring 判定会把它静默吞成 rc=0, 于是守卫在悄悄改变无关命令的行为。
   414	    # 不用 pytest.raises: 它失败时给的是 "DID NOT RAISE", 消息里没有本门的
   415	    # sentinel, 判据就锚不住红因 (变异 M16 首跑当场暴露)。
   416	    for decoy in (
   417	        ["/tmp/bark-gate-h-not-osascript-helper"],  # basename 只是「含」osascript
   418	        ["/usr/bin/printf", "osascript"],  # osascript 只是个**数据**参数
   419	    ):
   420	        decoy_hit_wall = False
   421	        try:
   422	            subprocess.run(decoy)
   423	        except AssertionError:
   424	            decoy_hit_wall = True
   425	        assert decoy_hit_wall, (
   426	            f"BARK-GATE-H-DECOY: 无关命令 {decoy!r} 被层⑥ 误吞 — 判定必须只认 argv[0] 或 env 转发的首个非赋值参数"
   427	        )
   428	
   429	    # 漏判面: /usr/bin/env osascript ... 这种间接形态也必须被层⑥ 接管
   430	    # (round-2 审查实测原判定只看 argv[0], 这条会抵达真 spawn)。
   431	    try:
   432	        indirect = subprocess.run(["/usr/bin/env", "osascript", "-", "t", "b"], capture_output=True)
   433	    except AssertionError as exc:  # 撞上探针的 Popen 墙 = 层⑥ 漏判了这条形态
   434	        raise AssertionError("BARK-GATE-H-INDIRECT: env osascript 未被守卫层⑥ 接管, 已抵达真 spawn") from exc
   435	    assert indirect.returncode == 0, "BARK-GATE-H-INDIRECT: env osascript 未被守卫层⑥ 接管"
   436	    _assert_no_real_egress()
