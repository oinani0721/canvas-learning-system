   155	    scripts = vault / ".claude" / "scripts"
   156	    scripts.mkdir(parents=True)
   157	    (vault / "节点").mkdir()
   158	    decay = WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py"
   159	    (scripts / "decay_beta.py").write_bytes(decay.read_bytes())
   160	    (vault / "节点" / "甲.md").write_text(
