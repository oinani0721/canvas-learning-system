   528	def test_reapply_after_failed_reload(monkeypatch):
   529	    """X 门 (armed): reload **半途抛异常**之后, 六层仍须已被重打。
   530	
   531	    模块顶层一旦执行完, 生产值就已经写回模块 (subprocess.run 变回真实现);
   532	    此时 reload 再抛异常, 「正常返回才重打」的实现就会留下一个失防的模块 ——
   533	    与第八批 H2「先 reload 后 raise 不回滚」同形, 只是换了触发路径
   534	    (round-3 审查用 trace 在 subprocess.py 中断 reload 实测)。
   535	
   536	    复刻手法: patch loader **类**的 exec_module, 先真执行再抛。必须打在类上 ——
   537	    importlib.reload 内部会 _find_spec 重新造一个 loader **实例**, 打在
   538	    module.__spec__.loader 那个旧实例上完全不生效 (首跑当场证伪)。
   539	    按模块名限定, 不波及同一次调用里别的 import。
   540	    卸甲形态下没有守卫, reload 之后 subprocess.run 就是真实现, 第二条断言即红。
   541	    整条测试不 spawn、不出网。"""
   542	    loader_cls = type(subprocess.__spec__.loader)
   543	    real_exec = loader_cls.exec_module
   544	
   545	    def _exec_then_boom(self, mod):
   546	        real_exec(self, mod)
   547	        if getattr(mod, "__name__", "") == "subprocess":
   548	            raise RuntimeError("bark_egress_probe: reload failed midway (audit)")
   549	
   550	    monkeypatch.setattr(loader_cls, "exec_module", _exec_then_boom)
   551	    try:
   552	        importlib.reload(subprocess)
   553	        reloaded_cleanly = True
   554	    except RuntimeError:
   555	        reloaded_cleanly = False
   556	
   557	    assert not reloaded_cleanly, "BARK-GATE-X-SETUP: 预期中的 reload 失败没有发生"
   558	    assert getattr(subprocess.run, "__qualname__", "") != "run", (
   559	        "BARK-GATE-X-REAPPLY-ON-FAILURE: reload 半途失败后层⑥ 未被重打, 模块停在生产态"
   560	    )
   561	    subprocess.Popen = _ledger_popen
     1	"""冷启动布防探针 (CARD-TEST-bark-autostub-R1 完成条件 (c) 的取证载体)。
     2	
     3	为什么必须单独一个文件: (c) 说的「冷启动」= **守卫自己**那次 import 才是
