   371	def test_proxy_state_neutralized():
   372	    """F2 门 (armed, 状态): 守卫层⑤a/⑤b/⑤c 三处代理来源同时哑火。
   373	
   374	    F 是行为门但只承重 ⑤d; 这三条各自承重一层, 任一层被摘掉本门必红
   375	    (变异负控按层逐条验)。⑤c 分两处断言是因为 darwin 的
   376	    `from _scproxy import _get_proxies` 把补丁点劈成了两个绑定:
   377	    urllib.request 侧管当下, _scproxy 侧管 reload(urllib.request) 之后。"""
   378	    leftover = sorted(k for k in os.environ if k.lower().endswith("_proxy"))
   379	    assert not leftover, f"BARK-GATE-F2-ENVPROXY: 布防期内仍有代理 env 残留 {leftover}"
   380	    assert urllib.request.getproxies() == {}, (
   381	        f"BARK-GATE-F2-GETPROXIES: getproxies() 非空 ({urllib.request.getproxies()!r})"
   382	    )
   383	    if sys.platform == "darwin":
   384	        import _scproxy
   385	
   386	        assert _scproxy._get_proxies() == {}, (
   387	            "BARK-GATE-F2-SCPROXY: _scproxy._get_proxies 未中和 — reload(urllib.request) 后代理会复活"
   388	        )
   389	        assert getattr(urllib.request, "_get_proxies", None) is not None and (urllib.request._get_proxies() == {}), (
   390	            "BARK-GATE-F2-URLLIB-GETPROXIES: urllib.request._get_proxies 未中和"
   391	        )
