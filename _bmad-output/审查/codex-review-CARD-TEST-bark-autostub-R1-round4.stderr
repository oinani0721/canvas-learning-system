   150	class RegressionMetricsCollector:
   151	    """Collects per-scenario metrics during a regression test run."""
   152	
   153	    def __init__(self):
   154	        self.results: List[Dict[str, Any]] = list()
   155	
   156	    def record(
   157	        self,
   158	        scenario_id: str,
   159	        prompt_name: str,
   160	        prompt_version: int,
   161	        metrics: Dict[str, Any],
   162	        passed: bool,
   163	        details: str = "",
   164	    ):
   165	        self.results.append(
   166	            {
   167	                "scenario_id": scenario_id,
   168	                "prompt_name": prompt_name,
   169	                "prompt_version": prompt_version,
   170	                "metrics": metrics,
   171	                "passed": passed,
   172	                "details": details,
   173	            }
   174	        )
   175	
   176	    def summary(self) -> Dict[str, Any]:
   177	        total = len(self.results)
   178	        passed_count = sum(1 for r in self.results if r["passed"])
   179	        failed_count = total - passed_count
   180	        pass_rate = (passed_count / total * 100) if total > 0 else 0.0
   181	        return {
   182	            "total_scenarios": total,
   183	            "passed": passed_count,
   184	            "failed": failed_count,
   185	            "pass_rate": pass_rate,
   186	            "results": self.results,
   187	        }
   188	
   189	
