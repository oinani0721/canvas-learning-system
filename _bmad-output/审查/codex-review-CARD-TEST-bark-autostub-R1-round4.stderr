   296	def test_proxy_first_hop_stays_loopback(monkeypatch):
   297	    """F 门 (armed, 行为): 模块 import 期就已存在的敌对「已建 opener」
   298	    (ProxyHandler 指向 127.0.0.1:63128) 不得把 loopback 请求转出机 ——
   299	    首跳必须是 loopback discard 端口本身。
   300	
   301	    这是 (b) 的行为门: 判据锚 (host, port) 二元组而不是只锚 host ——
   302	    本机系统代理实测就是 127.0.0.1:1082, 与兜底目标同主机不同端口, 只比
   303	    host 会两形态同值 = 假门。
   304	    建连在 socket.create_connection 层被拦并抛 OSError, 布防/卸甲两形态
   305	    都不会真建连、不出机 (63128 也不监听)。
   306	    三段各自承重不同的层: 第一段 (模块全局 _opener) 承重 ⑤d, 第二段 (现场
   307	    新建 opener) 承重 ⑤a/⑤b/⑤c, 第三段 (别处握持的 opener 对象) 承重 ⑤e
   308	    —— 变异任一层, 本门都会红在对应那一段。"""
   309	    hops = []
   310	
   311	    def _intercept(address, *a, **kw):
   312	        hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   313	        raise OSError(61, "blocked by bark_egress_probe (first-hop gate)")
   314	
   315	    monkeypatch.setattr(socket, "create_connection", _intercept)
   316	    opener = urllib.request._opener
   317	    assert opener is not None, "BARK-GATE-F-NOOPENER: _opener 为空, 前置态未建立"
   318	    try:
   319	        opener.open("http://127.0.0.1:9/push", timeout=1)
   320	    except urllib.error.URLError:
   321	        pass
   322	
   323	    assert hops, "BARK-GATE-F-NOHOP: 未观察到任何建连尝试"
   324	    assert hops[0] == ("127.0.0.1", 9), (
   325	        f"BARK-GATE-F-FIRSTHOP: 代理首跳未被中和 (首跳 {hops[0]!r}, 期望 ('127.0.0.1', 9))"
   326	    )
   327	
   328	    # 第二段: 现场新建的 opener —— 这是 `_opener is None` 时 urlopen 走的路
   329	    # (reload(urllib.request) 之后就是这个状态)。build_opener() 会在此刻读
   330	    # getproxies(), 于是这段behaviorally 覆盖的是「系统/环境代理」向量,
   331	    # 与上面「已建 opener」向量互补, 合起来才是完成条件 (b) 的两条。
   332	    fresh_hops = []
   333	
   334	    def _intercept_fresh(address, *a, **kw):
   335	        fresh_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   336	        raise OSError(61, "blocked by bark_egress_probe (fresh-opener gate)")
   337	
   338	    monkeypatch.setattr(socket, "create_connection", _intercept_fresh)
   339	    try:
   340	        urllib.request.build_opener().open("http://127.0.0.1:9/push", timeout=1)
   341	    except urllib.error.URLError:
   342	        pass
   343	
   344	    assert fresh_hops, "BARK-GATE-F-NOFRESHHOP: 新建 opener 未观察到任何建连尝试"
   345	    assert fresh_hops[0] == ("127.0.0.1", 9), (
   346	        f"BARK-GATE-F-FRESHHOP: 新建 opener 的首跳被代理接管 (首跳 {fresh_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   347	    )
   348	
   349	    # 第三段: 直接握着的 opener 对象 —— 不经 urllib.request._opener 这个模块
   350	    # 全局, 所以 ⑤d 换引用对它无效; 承重的是 ⑤e (proxy_bypass 恒 True)。
   351	    # R1 round-1 审查正是用这条路径击穿了只有 ⑤d 的版本。
   352	    held_hops = []
   353	
   354	    def _intercept_held(address, *a, **kw):
   355	        held_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   356	        raise OSError(61, "blocked by bark_egress_probe (held-opener gate)")
   357	
   358	    monkeypatch.setattr(socket, "create_connection", _intercept_held)
   359	    try:
   360	        _HOSTILE_OPENER.open("http://127.0.0.1:9/push", timeout=1)
   361	    except urllib.error.URLError:
   362	        pass
   363	
   364	    assert held_hops, "BARK-GATE-F-NOHELDHOP: 握持 opener 未观察到任何建连尝试"
   365	    assert held_hops[0] == ("127.0.0.1", 9), (
   366	        f"BARK-GATE-F-HELDHOP: 别处握持的 opener 首跳被代理接管 (首跳 {held_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   367	    )
   368	    _assert_no_real_egress()
