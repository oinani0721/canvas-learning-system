   252	def test_reload_selfheal():
   253	    """E 门 (armed): reload 双保险 — 对**两个**受保护生产模块各自
   254	    reload 重跑模块顶层 (KEY_FILE/_urlopen / osascript_fallback 被生产值
   255	    重写) 后, 守卫须对两侧都自动重打桩 (round-2 MEDIUM: 只锁 send_bark
   256	    时, 守卫漏 rearm daily_review_run 本门仍绿)。仅 reload 不调 send,
   257	    布防/卸甲两形态都零出网。"""
   258	    import daily_review_run
   259	    import send_bark
   260	
   261	    importlib.reload(send_bark)
   262	    assert Path(send_bark.KEY_FILE) != REAL_KEY, "BARK-GATE-E-RELOAD-KEYFILE: reload 后 KEY_FILE 回到真实 key 位置"
   263	    assert getattr(send_bark._urlopen, "__qualname__", "") != "urlopen", (
   264	        "BARK-GATE-E-RELOAD-URLOPEN: reload 后 _urlopen 回到真实 urlopen"
   265	    )
   266	
   267	    importlib.reload(daily_review_run)
   268	    assert Path(daily_review_run.send_bark.KEY_FILE) != REAL_KEY, (
   269	        "BARK-GATE-E-RELOAD-RUNNER-KEYFILE: reload runner 后 send_bark.KEY_FILE 回到真实 key 位置"
   270	    )
   271	    assert getattr(daily_review_run.osascript_fallback, "__qualname__", "") != "osascript_fallback", (
   272	        "BARK-GATE-E-RELOAD-OSASCRIPT: reload 后 osascript_fallback 回到 runner 原始实现"
   273	    )
   274	
   275	    # round-3 H1 的逃逸链第一步就是 reload(urllib.request) —— 它会把④⑤ 全部
   276	    # 抹掉。属性式调用现在也在双保险名单内, 重打必须覆盖到这两层。
