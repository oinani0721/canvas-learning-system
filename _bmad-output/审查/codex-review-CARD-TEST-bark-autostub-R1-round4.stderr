   298	def _run_pytest(case, report_path: Path):
   299	    cmd = [
   300	        sys.executable,
   301	        "-m",
   302	        "pytest",
   303	        "-p",
   304	        "no:cacheprovider",
   305	        "-p",
   306	        "bark_negctl_report_plugin",
   307	        *case["extra"],
   308	        *case["nodeids"],
   309	    ]
   310	    env = dict(os.environ)
   311	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   312	    env["BARK_NEGCTL_REPORT"] = str(report_path)
   313	    env["PYTHONPATH"] = os.pathsep.join([str(SCRIPTS)] + ([env["PYTHONPATH"]] if env.get("PYTHONPATH") else []))
   314	    print(f"[{case['label']}] $ {' '.join(cmd)}", flush=True)
   315	    try:
   316	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   317	    except subprocess.TimeoutExpired as e:
   318	        sys.stdout.write(e.stdout if isinstance(e.stdout, str) else "")
   319	        sys.stderr.write(str(e))
   320	        print(f"[{case['label']}] TIMEOUT after 600s")
   321	        return None, None
   322	    sys.stdout.write(proc.stdout)
   323	    sys.stderr.write(proc.stderr)
   324	    return proc.returncode, report_path
   325	
   326	
   327	def _judge_pytest(case) -> bool:
   328	    problems = []
   329	    with tempfile.TemporaryDirectory(prefix="bark-negctl-") as td:
   330	        report_path = Path(td) / "report.json"
   331	        rc, _ = _run_pytest(case, report_path)
   332	        if rc is None:
   333	            return False
   334	        if not report_path.exists():
   335	            print(f"[{case['label']}] MISMATCH: 插件未落报告 (进程可能崩溃) rc={rc}")
   336	            return False
   337	        data = json.loads(report_path.read_text(encoding="utf-8"))
   338	
   339	    want_rc = 0 if all(v == "passed" for v in case["expect"].values()) else 1
   340	    if rc != want_rc:
   341	        problems.append(f"进程 rc={rc} 不是本跑期望的 {want_rc} (pytest 正常判定只有 0/1)")
   342	    if data.get("exitstatus") != rc:
   343	        problems.append(f"进程 rc={rc} 与插件 exitstatus={data.get('exitstatus')} 不一致")
   344	
   345	    # 进程级全局还原对账 (每一跑都查): 守卫在一次测试里可能反复 _reapply,
   346	    # 任何一层没被 MonkeyPatch 正确还原, 桩就会漏进后续测试。
   347	    gb, ga = data.get("globals_before"), data.get("globals_after")
   348	    if gb is None or ga is None:
   349	        problems.append("插件未落全局快照 (globals_before/after 缺失)")
   350	    else:
   351	        # 豁免按**键**给, 不是整份跳过 (round-3 审查: 整份豁免会连带盖住别的漂移)
   352	        diff = [
   353	            f"{k}: 布防前 {gb.get(k)!r} → teardown 后 {ga.get(k)!r}"
   354	            for k in sorted(set(gb) | set(ga))
   355	            if gb.get(k) != ga.get(k) and k not in case["globals_drift_allow"]
   356	        ]
   357	        if diff:
   358	            problems.append("globals 未还原 (进程级污染): " + "; ".join(diff))
   359	
   360	    calls, other_failed = {}, []
   361	    for rep in data["reports"]:
   362	        if rep["when"] == "call":
   363	            calls[_short(rep["nodeid"])] = rep
   364	        elif rep["outcome"] == "failed":
   365	            other_failed.append(f"{rep['when']}:{rep['nodeid']}")
   366	    if other_failed:
   367	        problems.append(f"非 call 阶段出现失败: {other_failed}")
   368	
   369	    got = {k: v["outcome"] for k, v in calls.items()}
   370	    if got != case["expect"]:
   371	        problems.append(f"outcome 集合不符: 实测 {got} != 期望 {case['expect']}")
   372	
   373	    for name, (want_path, want_msg, is_prefix) in case["crash"].items():
   374	        rep = calls.get(name)
   375	        if rep is None or "crash_path" not in rep:
   376	            problems.append(f"{name}: 无 crash 记录")
   377	            continue
   378	        if os.path.realpath(rep["crash_path"]) != os.path.realpath(want_path):
   379	            problems.append(f"{name}: 异常抛出点文件不符 {rep['crash_path']} != {want_path}")
   380	        first = rep["crash_message"].splitlines()[0]
   381	        ok_msg = first.startswith(want_msg) if is_prefix else first == want_msg
   382	        if not ok_msg:
   383	            problems.append(f"{name}: 异常首行不符\n      实测 {first!r}\n      期望 {want_msg!r}")
   384	
   385	    for name, wanted in case["require_frames"].items():
   386	        rep = calls.get(name)
   387	        # frame 里的 path 是相对 rootdir 的, 先还原成绝对再**路径全等**比对 ——
   388	        # 用 endswith 的话同尾巴的别的模块也能满足 (round-2 审查 LOW)。
   389	        chain = {os.path.realpath(os.path.join(BACKEND, f["path"])) for f in (rep or {}).get("frames", [])}
   390	        for want in wanted:
   391	            if os.path.realpath(want) not in chain:
   392	                problems.append(f"{name}: frame 链缺少 {want} (实测 {sorted(chain)})")
   393	
   394	    # 把**结构化**的抛出点消息单独打一行 —— 变异裁判据此绑定红因,
   395	    # 被测代码 print 不出这一行 (它来自异常对象, round-3 审查 MEDIUM)。
   396	    for name, rep in sorted(calls.items()):
   397	        if rep.get("outcome") == "failed" and "crash_message" in rep:
   398	            print(f"[{case['label']}] CRASH {name} :: {rep['crash_message'].splitlines()[0]}")
   399	    ok = not problems
   400	    print(f"[{case['label']}] expect {case['expect']} -> ok={ok} rc={rc}")
   401	    for p in problems:
   402	        print(f"    ✗ {p}")
   403	    return ok
   404	
   405	
   406	def _judge_residue() -> bool:
   407	    cmd = [sys.executable, G_SCRIPT]
   408	    env = dict(os.environ)
   409	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   410	    print(f"[{G_LABEL}] $ {' '.join(cmd)}", flush=True)
   411	    try:
   412	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   413	    except subprocess.TimeoutExpired as e:
   414	        sys.stderr.write(str(e))
   415	        print(f"[{G_LABEL}] TIMEOUT after 600s")
   416	        return False
   417	    sys.stdout.write(proc.stdout)
   418	    sys.stderr.write(proc.stderr)
   419	    lines = [ln for ln in proc.stdout.splitlines() if ln.startswith("BARK-KEYFILE-RESIDUE:")]
   420	    ok = proc.returncode == 0 and len(lines) == 1 and lines[0].startswith(G_OK_PREFIX)
   421	    # 把红因复述成裁判自产的 ✗ 行 —— 变异裁判只在 CRASH/✗ 行里找 sentinel,
   422	    # 被测脚本自己的 stdout 不算数 (与 pytest 侧同一条口径)。
   423	    if not ok:
   424	        for ln in lines or ["(无 BARK-KEYFILE-RESIDUE 行)"]:
   425	            print(f"    ✗ {ln}")
   426	    print(f"[{G_LABEL}] expect OK -> ok={ok} rc={proc.returncode} lines={lines}")
   427	    return ok
   428	
   429	
   430	def main() -> int:
   431	    ap = argparse.ArgumentParser(description="Bark 外发守卫负控裁判 (二十四跑)")
   432	    ap.add_argument("--only", help="逗号分隔的跑标签, 只跑这些 (变异负控用)")
   433	    args = ap.parse_args()
   434	
   435	    wanted = None
   436	    if args.only:
   437	        wanted = [w.strip() for w in args.only.split(",") if w.strip()]
   438	        unknown = [w for w in wanted if w not in ALL_LABELS]
   439	        if unknown:
   440	            print(f"未知跑标签 {unknown}; 可用: {ALL_LABELS}")
   441	            return 2
   442	
   443	    results = []
   444	    for case in CASES:
   445	        if wanted is not None and case["label"] not in wanted:
   446	            continue
   447	        results.append((case["label"], _judge_pytest(case)))
   448	    if wanted is None or G_LABEL in wanted:
   449	        results.append((G_LABEL, _judge_residue()))
   450	
   451	    print()
   452	    for label, ok in results:
   453	        print(f"{label}: {'ok' if ok else 'MISMATCH'}")
   454	    if results and all(ok for _, ok in results):
   455	        print(f"NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} runs as expected)")
   456	        return 0
   457	    print("NEGATIVE-CONTROL: FAIL")
   458	    return 1
   459	
   460	
   461	if __name__ == "__main__":
   462	    sys.exit(main())

