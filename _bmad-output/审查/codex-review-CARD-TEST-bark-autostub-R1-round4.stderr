   284	    importlib.reload(subprocess)
   285	    assert getattr(subprocess.run, "__qualname__", "") != "run", (
   286	        "BARK-GATE-E-RELOAD-SUBPROCESS: reload(subprocess) 后层⑥ 未被重打"
   287	    )
   288	    # reload 重跑 subprocess 顶层, 把探针 import 期装的 Popen 总账也冲掉了
   289	    # (round-3 审查指出; E 门自己不 spawn 所以看不见)。用完立刻补装回去。
   290	    subprocess.Popen = _ledger_popen
   291	    assert urllib.request.getproxies() == {}, (
   292	        "BARK-GATE-E-RELOAD-URLLIB-PROXY: reload(urllib.request) 后代理中和未被重打"
   293	    )
