    18	
    19	import os
    20	import sys
    21	from pathlib import Path
    22	
    23	#: collection 期快照 —— 早于任何 fixture, 因此是「守卫动手之前」的真值。
    24	#: sys.path 存**整份列表**、env 存全部代理相关键 (不只 BARK_KEY_FILE):
    25	#: round-3 审查指出只比 membership 布尔值和单个键, 覆盖不到「重复插入」与
    26	#: 「删掉某个代理变量」这类污染形态。
