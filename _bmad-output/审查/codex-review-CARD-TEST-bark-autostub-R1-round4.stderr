   231	#: ④⑤, 再 reload send_bark 让 _urlopen 变回真 urlopen」; R1 round-2 审查又
   232	#: 找到同型的第二条: reload(subprocess) 抹掉层⑥, 预绑定的 osascript 别名
   233	#: 随即抵达真 spawn。教训是名单要照着「patch 了谁」列, 不是照着「哪些是
   234	#: 生产模块」列 —— stdlib 被 patch 了就同样要进名单。
   235	#: importlib 自己也在内 (守卫 patch 了 importlib.reload)。
   236	_BARK_PATCHED_MODULES = (
   237	    "send_bark",
   238	    "daily_review_run",
   239	    "urllib.request",
   240	    "subprocess",
   241	    "_scproxy",
   242	    "importlib",
   243	)
