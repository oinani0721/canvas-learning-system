   244	
   245	#: M9 单列: 它变异的是探针而非守卫, 且要双判据对比。
   246	M9 = {
   247	    "id": "M9",
   248	    "file": PROBE,
   249	    "desc": "(e) stdout 伪造绕过 (复刻 round-3 实证形态): 同文件无关失败 + 打印伪造的 traceback 行与 E 行",
   250	    "old": "def test_probe(tmp_path, monkeypatch, capsys):\n",
   251	    "new": (
   252	        "def test_probe(tmp_path, monkeypatch, capsys):\n"
   253	        '    print("  tests/regression/conftest.py:335: in _refuse_egress")\n'
   254	        '    print("E   AssertionError: Bark egress attempted in tests")\n'
   255	        '    assert False, "unrelated failure in probe"\n'
   256	    ),
   257	    "gate": "B/armed-probe-refused",
   258	    "sentinel": "异常首行不符",
   259	}
   260	
   261	_LEGACY_SUMMARY = r"=+\s+(.*?)\s+in\s+[\d.]+s\s*=+$"
   262	_LEGACY_PATTERN = r"^E\s+AssertionError: Bark egress attempted in tests\s*$"
   263	_LEGACY_SRC_HINT = "conftest.py"
   264	
   265	
   266	def _legacy_text_judge(rc: int, out: str) -> bool:
   267	    """第八批 (HEAD 2cacbb0c) 的文本判据, 逐行重写用于对照。
   268	
   269	    摘要唯一性 + 形态 + `^E ...$` 整行锚定 + 「E 行前 1500 字符窗口含
   270	    conftest.py」。它判 True 而 R1 判 FAIL, 就是 (e) 关掉的那条通路。"""
   271	    summaries = [m.group(1) for line in out.splitlines() if (m := re.match(_LEGACY_SUMMARY, line.strip()))]
   272	    shape_ok = (
   273	        len(summaries) == 1
   274	        and re.fullmatch(r"1 failed(, \d+ warnings?)?", summaries[0]) is not None
   275	        and " no tests ran" not in out
   276	        and "= ERRORS =" not in out
   277	    )
   278	    m = re.search(_LEGACY_PATTERN, out, re.MULTILINE)
   279	    regex_ok = m is not None
   280	    src_ok = bool(m) and _LEGACY_SRC_HINT in out[max(0, m.start() - 1500) : m.start()]
   281	    return rc == 1 and shape_ok and regex_ok and src_ok
   282	
   283	
   284	def _apply(mut) -> str:
   285	    path: Path = mut["file"]
   286	    original = path.read_bytes()
   287	    before = sha256(original).hexdigest()
   288	    text = original.decode("utf-8")
   289	    n = text.count(mut["old"])
   290	    if n != 1:
   291	        raise SystemExit(f"[{mut['id']}] 锚点命中 {n} 次 (必须恰好 1) — 锚点漂移, 中止")
   292	    mutated = text.replace(mut["old"], mut["new"])
   293	    for i, (eo, en) in enumerate(mut.get("extras", []), start=2):
   294	        n2 = mutated.count(eo)
   295	        if n2 != 1:
   296	            raise SystemExit(f"[{mut['id']}] 第 {i} 个锚点命中 {n2} 次 (必须恰好 1) — 锚点漂移, 中止")
   297	        mutated = mutated.replace(eo, en)
   298	    _INFLIGHT[path] = original
   299	    path.write_text(mutated, encoding="utf-8")
   300	    return before
   301	
   302	
   303	def _restore(mut, before: str) -> bool:
   304	    path: Path = mut["file"]
   305	    path.write_bytes(_INFLIGHT.pop(path))
   306	    after = sha256(path.read_bytes()).hexdigest()
   307	    same = before == after
   308	    print(f"[{mut['id']}] 还原逐字节一致: {'YES' if same else 'NO!!'} ({after})")
   309	    return same
   310	
   311	
   312	def _run_negctl(gate: str):
   313	    proc = subprocess.run(
   314	        [sys.executable, NEGCTL, "--only", gate],
   315	        cwd=BACKEND,
   316	        capture_output=True,
   317	        text=True,
   318	        timeout=1800,
   319	        env={**_child_env()},
   320	    )
   321	    return proc.returncode, proc.stdout + proc.stderr
   322	
   323	
   324	def _child_env():
   325	    import os
   326	
   327	    env = dict(os.environ)
   328	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   329	    return env
   330	
   331	
   332	def _check(mut) -> bool:
   333	    print(f"\n=== [{mut['id']}] {mut['desc']}")
   334	    print(f"    指定门: {mut['gate']} / 期望 sentinel: {mut['sentinel']}")
   335	    before = _apply(mut)
   336	    try:
   337	        rc, out = _run_negctl(mut["gate"])
   338	        # 元裁判收紧 (round-2 审查 MEDIUM): 「rc!=0 + 输出含 sentinel」会把
   339	        # 「基础设施炸了 + 恰好打印了那串文本」判成「指定门承重」。现在要求
   340	        # rc 恰为 1、负控确实跑完给出总判、且**指定的那道跑**自己判 ok=False。
   341	        gate_line = re.search(r"^\[" + re.escape(mut["gate"]) + r"\].*-> ok=False", out, re.MULTILINE)
   342	        went_red = rc == 1 and "NEGATIVE-CONTROL: FAIL" in out and gate_line is not None
   343	        # sentinel 只在**裁判自己产出的行**里找: 指定跑的 CRASH 行 (来自异常对象)
   344	        # 与 ✗ 问题行。round-3 审查实证: 让被测代码 print 一行 sentinel 再制造
   345	        # 无关失败, 「sentinel 出现在输出任意位置」的判据就会被骗过。
   346	        judged_lines = [
   347	            ln for ln in out.splitlines() if ln.startswith(f"[{mut['gate']}] CRASH ") or ln.lstrip().startswith("✗ ")
   348	        ]
   349	        has_sentinel = any(mut["sentinel"] in ln for ln in judged_lines)
   350	        ok = went_red and has_sentinel
   351	        print(f"[{mut['id']}] 指定门变红={went_red} (negctl rc={rc}); sentinel 命中={has_sentinel}")
   352	        if mut["id"] == "M9":
   353	            legacy = _legacy_text_judge(1, out)
   354	            print(f"[{mut['id']}] 第八批文本判据对同一份输出的判定: {legacy} (True = 老判据会放行, 正是 R1 关掉的通路)")
   355	            ok = ok and legacy
   356	        if not ok:
   357	            print(out[-4000:])
   358	    finally:
   359	        restored = _restore(mut, before)
   360	    return ok and restored
   361	
   362	
   363	def main() -> int:
   364	    results = []
   365	    for mut in MUTATIONS + [M9]:
   366	        results.append((mut["id"], _check(mut)))
   367	    print()
   368	    for mid, ok in results:
   369	        print(f"{mid}: {'指定门变红 ✓' if ok else 'NOT-RED ✗'}")
   370	    if all(ok for _, ok in results):
   371	        print(f"MUTATION-NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} 条变异均使指定门变红)")
   372	        return 0
   373	    print("MUTATION-NEGATIVE-CONTROL: FAIL")
   374	    return 1
   375	
   376	
   377	if __name__ == "__main__":
   378	    sys.exit(main())

