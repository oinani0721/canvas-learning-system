   573	def _append_calibration(fm_text, ts_str, ev=None):
   574	    """calibration_log 条目 (正常 / 恢复 / A2 重放三路径共用)。ts_str = 业务生效
   575	    时刻 (review_time — 与 effective_at 同源, 保证恢复产物与直接应用逐字节对齐)。
   576	
   577	    ev=None ⇒ 记本次评分, 字段取本次 payload。
   578	    ev=某条 durable 行 ⇒ **复放**那次评分的校准条目, 字段取该行 payload;
   579	      question_id / self_confidence_* 不在事件载荷里, 记 null。
   580	      ⚠️ 但 event_id / ts / exam_board / grade_norm / abandoned 都在, 够让 F1
   581	      判定命中 —— 于是被恢复的那张检验白板重跑时能走「已完整应用, 幂等跳过」,
   582	      而不是撞上「FSRS 已应用但缺校准记录」的人工裁定 (审查实测: 缺了这一步,
   583	      那张白板**永久卡在** scored_pending_node_update)。
   584	    """
   585	    q_ = lambda v: json.dumps(v, ensure_ascii=False)
   586	    if ev is None:
   587	        _e_id, _e_pl = eid, p
   588	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   589	        _e_qid = q_(p.get("question_id", "q1"))
   590	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   591	    else:
   592	        _e_pl = ev.get("payload") or {}
   593	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
   594	        # 剥完之后 `quiz:K` 与 `K` 变成同一个键, F1 判定无法区分 —— 实测账本 3 次
   595	        # 评分只记 2 条校准、attempt 停在 2, **一次复习静默消失且 rc=0 无提示**。
   596	        # (另两种 attempt 排列恰好被序数门兜住而 fail-closed —— 那是巧合不是设计,
   597	        #  「被别的门兜住」不等于缺陷不存在。)
   598	        _e_id = str(ev.get("event_id") or "")
   599	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   600	        _e_qid, _e_scr, scn_ = "null", "null", None
   601	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   602	              f'    ts: {q_(ts_str)}\n'
   603	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
