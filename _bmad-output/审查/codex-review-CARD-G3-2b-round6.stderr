   154	def r1():
   155	    print("\n── R1 (BLOCKER) durable payload 未知额外键 → 必须 envelope 冲突 ──")
   156	    v = new_vault("r1")
   157	    assert run(v).returncode == 0
   158	    base = rows(v)[0]
   159	    # ⚠️ `out_of_order` 现被更早的语义门接管 (见 n1_n5 的 N1) —— 只有**合法
   160	    # 乱序形态** (review_time ≤ W) 的该键才会走到 envelope 门。保 W 不回滚地
   161	    # 测它, R1 的原始穿透链仍被覆盖: 本次评分事实里没有这个键, 键集不等即冲突。
   162	    base_oo = json.loads(json.dumps(base))
   163	    base_oo["payload"]["out_of_order"] = True  # review_time == W ⇒ 合法乱序
   164	    write_rows(v, base_oo)
   165	    r_oo = run(v, ts="2026-09-01T07:00:00Z")
   166	    check(
   167	        "R1/out_of_order (合法乱序形态, 走 envelope 门)",
   168	        r_oo.returncode != 0 and "envelope 冲突" in r_oo.stderr and len(rows(v)) == 1,
   169	        f"rc={r_oo.returncode} 账本={len(rows(v))}行 | {last_line(r_oo.stderr)}",
   170	    )
   171	    for key, val, desc in (("note", "外部注入", "任意未知键"),):
   172	        (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 崩溃窗口①
   173	        t = json.loads(json.dumps(base))
   174	        t["payload"][key] = val
   175	        write_rows(v, t)
   176	        r = run(v)
   177	        check(
   178	            f"R1/{desc}",
   179	            r.returncode != 0 and "envelope 冲突" in r.stderr,
   180	            f"rc={r.returncode} fsrs_fields={fsrs_fields(v) or '{}'} 账本={len(rows(v))}行 | {last_line(r.stderr)}",
   181	        )
   182	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   183	    t = json.loads(json.dumps(base))
   184	    t["payload"].pop("exam_board")
   185	    write_rows(v, t)
