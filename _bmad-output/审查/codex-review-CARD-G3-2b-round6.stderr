  2429	def test_round5_routing_order_and_input_literal(vault):
  2430	    """round-5 的路由顺序与输入校验三条，逐条锁住。
  2431	
  2432	    ① **完整校验必须排在 marker/乱序分流之前**：那两条分支都以 `continue` 结束，
  2433	       排在校验后面等于「先放行再校验」——实测一条标了 `out_of_order`、时刻带
  2434	       首尾空白的行，校验器 rc=1 而写点 rc=0 并照常写入下一次评分。
  2435	    ② **必须传 golden manifest**：不传等于**没执行**算法身份真值绑定——实测
  2436	       `fsrs_library_version="999.999"` + 全零 hash 时校验器 CLI rc=1 而写点放行。
  2437	    ③ **本次输入 ts 按字面校验且拒而不洗**：它会**原样**写进账本 `recorded_at`，
  2438	       而 bridge 入口的 `.strip()` 只洗自己那份拷贝 ⇒ 写点 rc=0 而账本落库带空白、
  2439	       校验器 rc=1。**写点自己产出了不合规的行**，比消费侧漏网更糟。
  2440	    """
  2441	    # ① 乱序分流之前必须已完整校验
  2442	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2443	    _write_ledger(vault, _review_row())
  2444	    assert _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z")).returncode == 0
  2445	    bad = _review_row(**{"payload.review_time": " 2026-07-01T10:00:00Z ", "effective_at": " 2026-07-01T10:00:00Z "})
  2446	    bad["event_id"] = "quiz:乱序空白"
  2447	    bad["payload"]["out_of_order"] = True
  2448	    with (vault / "learning_events.jsonl").open("a", encoding="utf-8") as f:
  2449	        f.write(json.dumps(bad, ensure_ascii=False) + "\n")
  2450	    face = _write_face(vault)
  2451	    r = _run_writer_settled(vault, _payload(event_id="板C#q1", ts="2026-08-03T10:00:00Z"))
  2452	    assert r.returncode != 0, "标了 out_of_order 但时刻带空白的行必须在分流前被校验拦下"
  2453	    assert _run_validator(vault).returncode != 0, "校验器同样拒（两侧同口径）"
  2454	    assert _write_face(vault) == face, "零写（节点 + 账本）"
  2455	
  2456	    # ② golden manifest 必须真正传进去
  2457	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2458	    forged = _review_row(**{"payload.fsrs_library_version": "999.999", "payload.fsrs_params_hash": "0" * 64})
  2459	    _write_ledger(vault, forged)
  2460	    r2 = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2461	    assert r2.returncode != 0, "伪造的 fsrs 身份键必须被 manifest 绑定门拦下"
  2462	    assert _run_validator(vault).returncode != 0, "校验器同样拒（两侧同口径）"
  2463	
  2464	    # ③ 输入 ts 字面校验：拒而不洗
  2465	    for bad_ts, why in ((" 2026-08-02T10:00:00Z ", "首尾空白"), ("2026-08-02T10:00:00+00:00:00", "畸形偏移")):
  2466	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2467	        (vault / "learning_events.jsonl").unlink(missing_ok=True)
  2468	        r3 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=bad_ts))
  2469	        assert r3.returncode != 0, f"输入 ts {why} 必须拒: {r3.stderr[:200]}"
  2470	        assert "不符 §三 受理语法" in r3.stderr, r3.stderr
  2471	        assert not (vault / "learning_events.jsonl").exists() or not _ledger_lines(vault), (
  2472	            f"{why} 的输入不得产出任何账本行"
  2473	        )
  2474	    # 验伪：两种合法写法（Z 与 +08:00 偏移）都不得被误拒
  2475	    for good_ts in ("2026-08-02T10:00:00Z", "2026-08-02T18:00:00+08:00"):
  2476	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2477	        (vault / "learning_events.jsonl").unlink(missing_ok=True)
  2478	        rg = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=good_ts))
  2479	        assert rg.returncode == 0, f"合法 ts {good_ts} 不得被误拒: {rg.stderr[:200]}"
  2480	        assert _run_validator(vault).returncode == 0, f"{good_ts} 产出的账本必须合规"
  2481	
