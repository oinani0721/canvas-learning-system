   323	def r7():
   324	    print("\n── R7 (MEDIUM) 坏末行: 带 LF = 完整损坏(拒) / 无 LF = 截断(容忍) ──")
   325	    v = new_vault("r7")
   326	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   327	    good["event_id"] = "quiz:旧板"
   328	    good["effective_at"] = "2026-07-01T10:00:00Z"
   329	    good["node_id"] = "别的节点"
   330	    bad = '{"event_id": "quiz:损坏行", "event_version": 1, "event_type": "answer_sc'
   331	    ledger = v / "learning_events.jsonl"
   332	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad + "\n", encoding="utf-8")
   333	    s = sha(v / NODE_REL)
   334	    r = run(v)
   335	    check(
   336	        "R7/坏末行带终止 LF → fail-closed",
   337	        r.returncode != 0 and "完整写入的损坏行" in r.stderr and sha(v / NODE_REL) == s,
   338	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   339	    )
   340	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
   341	    rf = run(v)
   342	    lines = [x for x in ledger.read_text(encoding="utf-8").splitlines() if x.strip()]
   343	    check(
   344	        "R7/同一坏行去掉 LF → 仍按截断隔离",
   345	        rf.returncode == 0 and "截断尾行" in rf.stdout and len(lines) == 3,
   346	        f"rc={rf.returncode} 账本={len(lines)}行 (坏行隔离, 新事件独立成行)",
   347	    )
