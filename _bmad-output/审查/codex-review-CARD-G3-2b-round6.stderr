   115	def _reject_dup_keys(pairs: list[tuple[str, object]]) -> dict:
   116	    seen: set[str] = set()
   117	    for key, _ in pairs:
   118	        if key in seen:
   119	            raise _NonStandardJSON(f"对象内重复键 {key!r} (json.loads 静默取后者, 审计不容许歧义)")
   120	        seen.add(key)
   121	    return dict(pairs)
