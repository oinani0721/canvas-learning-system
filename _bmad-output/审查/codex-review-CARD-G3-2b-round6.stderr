  1965	        _write_ledger(vault, row)
  1966	        r3 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1967	        assert r3.returncode != 0, f"[attempt_count {desc}] 必须 fail-closed"
