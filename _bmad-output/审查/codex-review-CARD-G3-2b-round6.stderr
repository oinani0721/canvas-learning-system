   447	            # json.loads 静默取最后一个值, 于是一行里的两个 grade_norm 只有后者
   448	            # 参与 envelope 比较 —— 前者是什么无从证明。_DupKey 不继承 ValueError,
   449	            # 故不会被下面的坏行分支吞掉。
   450	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行 JSON 含重复键 {_dk} (解析层取最后一个值, 歧义不可证), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   451	        except ValueError:
   452	            if _ln == _n_lines and not _ends_with_lf:
   453	                print(f"[quiz-answer] 账本第 {_ln} 行为截断尾行 (崩溃产物: 非 JSON 且无终止 LF) — 追加时 LF 守卫隔离, 不阻塞本次评分")
   454	            else:
   455	                _why = "该行有终止 LF ⇒ 完整写入的损坏行, 非截断" if _ln == _n_lines else "中间行"
   456	                raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行损坏 (非 JSON; {_why}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   457	# 幂等键全文件唯一 (§三): 账本被外部工具写出重复 event_id 时, A2 会把两条
   458	# 同 id 行各重放一次 = 确定性二次 apply (Codex round-2 BLOCKER) → 拒写人工修复
   459	_seen_ids = {}
