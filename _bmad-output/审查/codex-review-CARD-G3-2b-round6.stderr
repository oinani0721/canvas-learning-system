   465	def _split_ledger_lines(raw: bytes) -> list[bytes]:
   466	    """账本字节 → 物理行列表 (1-based 行号 = 索引 + 1)。
   467	
   468	    ⚠️ 必须按 \\n 切分, **不能**用 splitlines(): 后者还会在 \\r / \\v / \\f /
   469	    \\x1c-\\x1e / \\x85 处断行, 与主体校验 (二进制文件迭代, 只认 \\n) 和
   470	    prefix 计算的行号定义不一致 —— 一条含裸 CR 的记录会让两套编号错位,
   471	    cursor_line 与 prefix 指向不同的行 (round-15 自查实证)。
   472	    """
   473	    chunks = raw.split(b"\n")
   474	    if chunks and chunks[-1] == b"":
   475	        chunks.pop()  # 末尾 LF 不产生额外空行
   476	    return chunks
