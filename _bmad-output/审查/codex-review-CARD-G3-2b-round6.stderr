   473	def main() -> int:
   474	    resolved = CE_ROOT.resolve() if CE_ROOT.exists() else CE_ROOT
   475	    if not str(resolved).startswith(str(FIXTURE_ROOT)):
   476	        sys.exit(f"[g32b-ce] 目标目录越出约定前缀 ({resolved}) — 拒跑")
   477	    if FIXTURE_ROOT.exists() and not (FIXTURE_ROOT / MARKER).is_file():
   478	        sys.exit(f"[g32b-ce] {FIXTURE_ROOT} 缺标记文件 {MARKER} — 先跑 g32b_build_fixture.py")
   479	    if CE_ROOT.exists():
   480	        shutil.rmtree(CE_ROOT)
   481	    CE_ROOT.mkdir(parents=True)
   482	    print(f"反例 fixture 根: {CE_ROOT}")
   483	    for fn in (r1, r2, r3, r4, r5, r6, r7, n1_n5):
   484	        fn()
   485	    bad = [t for t, ok, _ in RESULTS if not ok]
   486	    print(f"\n{'=' * 70}\n判据 {len(RESULTS) - len(bad)}/{len(RESULTS)} PASS")
   487	    if bad:
   488	        print("FAIL:", bad)
   489	        return 1
   490	    print("R1-R7 + round-1 后续 N1-N5 全部 fail-closed / 幂等 — 裁判 2 PASS")
   491	    return 0
   492	
   493	
   494	if __name__ == "__main__":
   495	    sys.exit(main())

