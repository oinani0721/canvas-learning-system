   256	def _instant_only(s, ctx):
   257	    """tz-aware 解析 → UTC 瞬间。**不施加整秒/UTC 字面门** —— 用于只需要比较
   258	    「是不是同一个绝对时刻」的场合。
   259	
   260	    ⚠️ 别拿 _durable_instant 去当它用: 契约 §6.1:106 对 effective_at 的要求
   261	    只有「与 review_time **同一瞬间**（按绝对时刻比较——Z 与 +00:00 是同一瞬间
   262	    的两种写法, **不按原字符串比**）」, 整秒只约束 review_time。校验器也正是
   263	    这么实现的(_instant 比较)。用严格字面门去卡 effective_at 就比契约严一档,
   264	    `+08:00` 写法会被写点拒而校验器放行 —— 又一次实现与契约两个口径。
   265	    """
   266	    if not isinstance(s, str) or not s.strip():
   267	        raise SystemExit(f"[quiz-answer] {ctx} 非字符串时刻 ({s!r}), fail-closed 拒写")
   268	    try:
   269	        _d = datetime.fromisoformat(s.strip().replace("Z", "+00:00"))
   270	    except ValueError:
   271	        raise SystemExit(f"[quiz-answer] {ctx} 不可解析 ({s!r}), fail-closed 拒写")
   272	    if _d.tzinfo is None:
   273	        raise SystemExit(f"[quiz-answer] {ctx} 缺时区 ({s!r}; §三 要求 tz-aware), fail-closed 拒写")
   274	    return _d.astimezone(timezone.utc)
