   319	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   320	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   335	#        双引号形态经 json.loads 与写侧 json.dumps 同源反解, 单引号/裸词剥引号)
   336	#   L1 = 账本已有 parsed event_id == evid 的行 (parsed-field equality, 禁子串)
   337	# ⛔ F1 单独不能证明 FSRS 已推进 (degraded 落账写过 calibration 但没写 W —
   338	# Codex round-2 BLOCKER): 「已应用」的机械判据是 W >= durable.review_time,
   339	# 分诊在下方主流程里做, 这里只放解析函数。
   340	def _fm_has_event_compat(fm_text, ev_id, all_ledger_ids=()):
   341	    """F1 判定: 按**完整** event_id 查; 裸键回落**仅在映射可证唯一时**才做。
   342	
   343	    回落只为**历史兼容** —— 本卡之前写入的校准记录存的是剥前缀形态。新写入一律
   344	    存完整形态, 所以新数据不会再走回落分支。
   345	
   346	    ⛔ 但回落本身会**制造新的别名** (Codex round-5 BLOCKER, 实测): 账本里同时
   347	    存在裸键 `K` 与带前缀的 `quiz:K` 时, 后者回落查 `K` 会命中前者写下的校准
   348	    条目 —— 两个**不同的完整 event_id** 别名成一个, 那次评分静默不入账
   349	    (实测 rc=0、账本 attempts=[1,2]、第三次评分没有校准条目)。
   350	
   351	    所以回落前必须**先证明映射唯一**: 账本里若同时存在 `K` 与 `quiz:K`
   352	    (裸形态相同的两个不同完整 id), 歧义不可消解 —— **停下**, 而不是猜一个。
   353	    """
   354	    if _fm_has_event(fm_text, ev_id):
   355	        return True
   356	    if not ev_id.startswith("quiz:"):
   357	        return False
   358	    _bare = ev_id[5:]
   359	    # 唯一性证明: 账本里裸形态同为 _bare 的完整 id 只能有一个 (就是 ev_id 自己)
   360	    _aliases = {i for i in all_ledger_ids
   361	                if (i[5:] if i.startswith("quiz:") else i) == _bare}
   362	    if len(_aliases) > 1:
   363	        raise SystemExit(
   364	            f"[quiz-answer] 账本里存在裸形态相同的多个 event_id {sorted(_aliases)!r} — "
   365	            f"历史校准条目存的是剥前缀形态, 无法证明它对应其中哪一个; "
   366	            f"猜一个就会让另一个静默不入账, fail-closed 拒写 — 请人工统一这些 id"
   367	        )
   368	    return _fm_has_event(fm_text, _bare)
