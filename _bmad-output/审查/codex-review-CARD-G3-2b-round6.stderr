  1200	    oo = doc[doc.index("**`out_of_order` 字段冻结") : doc.index("**迟到事件的入账通道**")]
  1201	    for needle in ("写点（在线 A2）侧同款语义门", "fail-closed", "被伪装成乱序的真实后继", "唯一合法值布尔 `true`"):
  1202	        assert needle in oo, f"§6.2 三态语义段缺「{needle}」— 写点侧口径未回写契约"
  1203	
  1204	
  1205	# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
  1206	# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
  1207	# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
  1208	# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
  1209	# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
  1210	
  1211	
  1212	def _strip_calibration(vault: Path) -> None:
  1213	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1214	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1215	    head, fm, body = text.split("---\n", 2)
  1216	    lines, out, skipping = fm.split("\n"), [], False
  1217	    for ln in lines:
  1218	        if ln.startswith("calibration_log:"):
  1219	            skipping = True
  1220	            continue
  1221	        if skipping and (ln.startswith("  ") or ln == ""):
  1222	            continue
  1223	        skipping = False
  1224	        out.append(ln)
  1225	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1226	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1227	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1228	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1229	
  1230	
  1231	def test_six_cell_state_machine_closed(vault):
  1232	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1233	    foreign = _review_row(event_id="quiz:板A#q1")
  1234	    _write_ledger(vault, foreign)
  1235	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z"))
  1236	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1237	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1238	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1239	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1240	
  1241	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1242	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1243	    sha_before = _sha(vault / NODE_REL)
  1244	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
  1245	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1246	    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
  1247	    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
  1248	
  1249	    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
  1250	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1251	    (vault / "learning_events.jsonl").unlink()
  1252	    assert _run_writer(vault, _payload()).returncode == 0
  1253	    sha_full = _sha(vault / NODE_REL)
  1254	    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
  1255	    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
  1256	    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
  1257	
  1258	    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
  1259	    _strip_calibration(vault)
  1260	    sha_stripped = _sha(vault / NODE_REL)
  1261	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1262	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1263	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1264	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1265	
  1266	    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
  1267	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1268	    (vault / "learning_events.jsonl").unlink()
  1269	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1270	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1271	    ema_before = {
  1272	        k: re.search(rf"^{k}:.*", _fm(vault), re.M).group(0)
  1273	        for k in ("mastery_score", "mastery_a", "mastery_b", "attempt_count")
