  1910	def test_round3_findings(vault):
  1911	    # ① HIGH：未知 event_version 的行不得按 v1 语义 apply。
  1912	    # §一 说 v2 出现前读方要「跳过并告警，不炸」——但那是对**别的节点**的行；
  1913	    # 本节点的未知版本行若被跳过，那次评分就静默漏算了，所以这里 fail-closed。
  1914	    row = _review_row(event_id="quiz:板A#q1")
  1915	    row["event_version"] = 2
  1916	    _write_ledger(vault, row)
  1917	    _face_ver = _write_face(vault)
  1918	    r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1919	    assert r.returncode != 0 and "非 v1" in r.stderr, r.stderr
  1920	    assert _write_face(vault) == _face_ver, "零写（节点 + 账本）"
  1921	
  1922	    # ② HIGH：effective_at 与 payload.review_time 必须是同一绝对瞬间。
  1923	    # 两者脱钩的行在 dup 路径会被 envelope 拦，但走 foreign pending 时没人管
  1924	    # （实测 writer rc=0 而 validator rc=1，两侧口径分叉）。
  1925	    bad = _review_row(event_id="quiz:板A#q1")
  1926	    bad["effective_at"] = "2026-08-01T11:00:00Z"  # payload.review_time 仍是 10:00
  1927	    _write_ledger(vault, bad)
  1928	    r2 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1929	    assert r2.returncode != 0 and "不是同一瞬间" in r2.stderr, r2.stderr
  1930	    # 验伪 + **写点↔校验器口径对照**：契约 §6.1:106 对 effective_at 只要求「与
  1931	    # review_time 同一瞬间（按绝对时刻比较——Z 与 +00:00 是同一瞬间的两种写法，
  1932	    # **不按原字符串比**）」，整秒只约束 review_time。
  1933	    # ⚠️ 自查抓到的错：这里原本套了 _durable_instant 的严格字面门，于是
  1934	    # `+08:00`（同一瞬间但非 UTC 字面）会被写点拒而校验器放行 —— 又一次实现比
  1935	    # 契约严的口径分叉（本卡第三次同类错，前两次是 R2 的整秒字面与 R6 的身份键）。
  1936	    # 现改用 _instant_only（只比瞬间）。本断言锁的是**两侧结论必须一致**。
  1937	    for ea, expect_ok in (
  1938	        ("2026-08-01T10:00:00Z", True),
  1939	        ("2026-08-01T10:00:00+00:00", True),
  1940	        ("2026-08-01T18:00:00+08:00", True),  # 同一瞬间，非 UTC 字面
  1941	        ("2026-08-01T11:00:00Z", False),  # 不同瞬间
  1942	        ("2026-08-01T10:00:00", False),  # naive
  1943	    ):
  1944	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1945	        ok = _review_row(event_id="quiz:板A#q1")
  1946	        ok["effective_at"] = ea
  1947	        _write_ledger(vault, ok)
  1948	        rok = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1949	        writer_ok = rok.returncode == 0
  1950	        assert writer_ok is expect_ok, f"effective_at={ea!r} 写点结论应为 {expect_ok}: {rok.stderr}"
  1951	        # 只在写点放行时对照校验器（拒了就没有产物可校验）
  1952	        if writer_ok:
  1953	            assert _run_validator(vault).returncode == 0, f"effective_at={ea!r} 写点放行但校验器拒 —— 两侧口径分叉"
  1954	
  1955	    # ③ BLOCKER：attempt_count 是 ordinal 回推与恢复的权威值，缺了/非法就无法
  1956	    # 证明「这是第几次评分」。旧实现缺键时静默跳过同步（实测 writer rc=0、
  1957	    # validator 也 rc=0，账本 attempts=[null,1]：两次评分而笔记计数只有 1）。
  1958	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
