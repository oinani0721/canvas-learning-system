   427	    _last_idx = max((i for i, x in enumerate(_byte_lines) if x.strip()), default=-1)
   428	    _ends_with_lf = _last_idx >= 0 and _last_idx < len(_byte_lines) - 1
   429	    _n_lines = len([x for x in _byte_lines if x.strip()])
