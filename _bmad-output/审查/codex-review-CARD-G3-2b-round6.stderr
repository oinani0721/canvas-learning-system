   371	def _fm_has_event(fm_text, ev_id):
   372	    mcal = re.search(r'^calibration_log:[ \t]*$', fm_text, re.M)
   373	    if not mcal:
   374	        return False
   375	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   376	        if ln and not ln[0].isspace():
   377	            break
   378	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   379	        if mm:
   380	            v = mm.group(1).strip()
   381	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   382	                try:
   383	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   384	                except ValueError:
   385	                    pass
   386	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   387	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
