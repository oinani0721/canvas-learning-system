   441	
   442	    print("\n── N4 (MEDIUM) 非法 UTF-8 字节须 clean fail-closed，不是 traceback ──")
   443	    v = new_vault("n4")
   444	    (v / "learning_events.jsonl").write_bytes(b'{"event_id": "quiz:x"}\n\xff\xfe bad\n')
   445	    r = run(v)
   446	    check(
   447	        "N4/非 UTF-8 字节",
   448	        r.returncode != 0 and "非 UTF-8 字节" in r.stderr and "Traceback" not in r.stderr,
   449	        f"rc={r.returncode} clean={'Traceback' not in r.stderr} | {last_line(r.stderr)}",
   450	    )
   451	
   452	    print("\n── N5 (MEDIUM) 多 pending 并存 → attempt 序数不可从账本边界确证 ──")
   453	    v = new_vault("n5")
   454	    e1 = _pending_row(review_time="2026-08-03T10:00:00Z")
   455	    e1["event_id"] = "quiz:板A#q1"
   456	    e1["effective_at"] = "2026-08-03T10:00:00Z"
   457	    e2 = _pending_row(
   458	        review_time="2026-08-04T10:00:00Z",
   459	        attempt_count=2,
   460	        exam_board="检验白板/测试检验-2026-08-01-1000.md",
   461	    )
   462	    e2["event_id"] = "quiz:" + EID
   463	    e2["effective_at"] = "2026-08-04T10:00:00Z"
   464	    write_rows(v, e1, e2)
   465	    r = run(v)
   466	    check(
   467	        "N5/A2 不变量破坏时报真因",
   468	        r.returncode != 0 and "不变量已被破坏" in r.stderr and not fsrs_fields(v),
   469	        f"rc={r.returncode} | {last_line(r.stderr)}",
   470	    )
