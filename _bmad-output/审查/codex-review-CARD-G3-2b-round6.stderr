  1300	def test_round1_followups_n1_to_n5(vault):
  1301	    # ── N1 (BLOCKER) 被伪装成乱序的真实后继：标 out_of_order 但 review_time > W
  1302	    # 旧实现无条件排除标记行 ⇒ 该事件的 FSRS 永久丢失且 writer 照常 rc=0
  1303	    # （实测 rc=0、W 只反映本次事件、账本 2 行）。§6.2 三态语义 round-17 已冻结
  1304	    # 「标记行 review_time 必须不晚于此前适用事件的最大时刻」，本卡补进写点侧。
  1305	    late = _review_row(**{"payload.out_of_order": True, "payload.review_time": "2026-08-05T10:00:00Z"})
  1306	    late["effective_at"] = "2026-08-05T10:00:00Z"
  1307	    _write_ledger(vault, late)
  1308	    sha0 = _sha(vault / NODE_REL)
  1309	    r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1310	    assert r.returncode != 0, "标 out_of_order 但晚于水位线的行必须 fail-closed（否则静默丢一次评分）"
  1880	    (vault / NODE_REL).write_text(
  1881	        NODE_V0.replace("mastery_score: 0.5\n", 'mastery_score: 0.5\nattempt_count: "3"\n'), encoding="utf-8"
  1882	    )
  1883	    (vault / "learning_events.jsonl").unlink()
  1884	    r6 = _run_writer(vault, _payload(event_id="板Q#q1"))
  1885	    assert r6.returncode == 0, r6.stdout + r6.stderr
  1886	    assert _ledger_lines(vault)[0]["payload"]["attempt_count"] == 4, (
