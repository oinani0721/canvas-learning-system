   306	class _DupKey(Exception):
   307	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   308	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   309	
   310	
   311	def _no_dup_keys(pairs):
   312	    _seen = set()
   313	    for _k, _ in pairs:
   314	        if _k in _seen:
   315	            raise _DupKey(repr(_k))
   316	        _seen.add(_k)
   317	    return dict(pairs)
