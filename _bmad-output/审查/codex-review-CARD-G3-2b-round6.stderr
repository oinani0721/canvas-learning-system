  2356	# ── 门㊵ round-5 BLOCKER: 校准键剥前缀导致 ID 碰撞 ⇒ 一次复习静默消失 ──
  2357	
  2358	
  2359	def test_round5_calibration_key_prefix_collision(vault):
  2360	    """校准记录曾存**剥掉 `quiz:` 前缀**的 event_id, 于是账本里的 `quiz:K` 与
  2361	    `K` 落到同一个键上, F1 判定无法区分。
  2362	
  2363	    ⚠️ 实测漏算链: 账本 3 次评分 (`quiz:K` / `K` / 本次), 第二条因剥前缀后与第一条
  2364	    同名而被误判「已应用」⇒ 跳过复放 ⇒ 校准只记 2 条、attempt 停在 2,
  2365	    **那次复习永久消失且 rc=0 无任何提示**。
  2366	
  2367	    ⚠️ 另两种 attempt 排列恰好被序数门顶住而 fail-closed —— 那是**巧合不是设计**。
  2368	    「被别的门兜住」不等于缺陷不存在: 只要换一个排列 (第二行 attempt 恰等于误判
  2369	    分支算出的期望值) 就穿过去了。这正是本门要锁住的那一个排列。
  2370	
  2371	    修法: 写入存**完整** event_id; F1 查询完整形态优先, 剥前缀形态**仅作历史
  2372	    兼容回落** (回落不能反向做 —— 拿剥前缀的键去撞完整记录正是碰撞的来源)。
  2373	    """
  2374	
  2375	    def _three_scored(id1, id2, n2):
  2376	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2377	        rows = []
  2378	        for eid, rt, n in ((id1, TS1, 1), (id2, "2026-08-01T10:00:01Z", n2)):
  2379	            row = _review_row(**{"payload.review_time": rt, "effective_at": rt})
  2380	            row["event_id"] = eid
  2381	            row["payload"]["attempt_count"] = n
  2382	            rows.append(row)
  2383	        _write_ledger(vault, *rows)
  2384	        r = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2385	        fm = (vault / NODE_REL).read_text(encoding="utf-8")
  2386	        # _fm_fields 只抽 fsrs_*，attempt_count 直接读（容 YAML 引号标量）
  2387	        _m = re.search(r"^attempt_count:\s*[\"']?(\d+)[\"']?\s*$", fm, re.M)
  2388	        return r, re.findall(r"^  - event_id: (.+)$", fm, re.M), (int(_m.group(1)) if _m else None)
  2389	
  2390	    # ① 碰撞 + attempt 恰好对上误判期望 —— 修复前正是这个排列穿过了序数门
  2391	    r, cal, att = _three_scored("quiz:K", "K", 1)
  2392	    assert not (r.returncode == 0 and len(cal) < 3), (
  2393	        f"碰撞键不得静默漏算: rc={r.returncode} 校准{len(cal)}条 attempt={att}"
  2394	    )
  2395	    # ② 碰撞 + 序数自洽 ⇒ **歧义即停**（round-5 修订的口径）。
  2396	    # ⚠️ 我一度把期望写成「都能正常复放」——那是错的：历史校准条目存的是**剥前缀**
  2397	    # 形态，遇到 `K` 与 `quiz:K` 并存时，一条裸键条目到底对应哪一个**无法证明**。
  2398	    # 猜一个就会让另一个静默不入账（正是本门开头那条漏算链）。可证的处置只有停下。
  2399	    r, cal, att = _three_scored("quiz:K", "K", 2)
  2400	    assert r.returncode != 0, f"裸形态相同的两个 event_id 并存时必须 fail-closed: {cal}"
  2401	    assert "裸形态相同的多个 event_id" in r.stderr, r.stderr
  2402	    assert "请人工统一这些 id" in r.stderr, "拒因必须给出可执行的处置方式"
  2403	
  2404	    # 验伪①: 不碰撞的正常场景不得回归
  2405	    r, cal, att = _three_scored("quiz:甲", "quiz:乙", 2)
  2406	    assert r.returncode == 0 and len(cal) == 3 and att == 3, f"正常场景回归: {cal} {att}"
  2407	
  2408	    # 验伪②: **历史**剥前缀形态的校准记录必须仍被认出（否则旧笔记会被重复复放）
  2409	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2410	    row = _review_row()
  2411	    row["event_id"] = "quiz:老键"
  2412	    _write_ledger(vault, row)
  2413	    assert _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z")).returncode == 0
  2414	    t = (vault / NODE_REL).read_text(encoding="utf-8")
  2415	    t2 = t.replace('event_id: "quiz:老键"', 'event_id: "老键"')
  2416	    assert t2 != t, "预置必须与旧形态可区分"
  2417	    (vault / NODE_REL).write_text(t2, encoding="utf-8")
  2418	    r2 = _run_writer_settled(vault, _payload(event_id="板C#q1", ts="2026-08-03T10:00:00Z"))
  2419	    assert r2.returncode == 0, r2.stderr[:300]
  2420	    t3 = (vault / NODE_REL).read_text(encoding="utf-8")
  2421	    assert t3.count('event_id: "quiz:老键"') + t3.count('event_id: "老键"') == 1, (
  2422	        "历史剥前缀形态的校准记录必须被回落命中，否则旧笔记会被重复复放（双吃 EMA）"
  2423	    )
