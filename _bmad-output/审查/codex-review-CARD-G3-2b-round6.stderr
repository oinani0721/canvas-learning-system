  2483	# ── 门㊷ round-5 HIGH: §6.3 历史评分行被序数回推漏计 ──
  2484	
  2485	
  2486	def test_round5_legacy_scored_rows_break_ordinal_proof(vault):
  2487	    """§6.3 历史评分行（旧写点产物，**没有 attempt_count**）同样推进过 attempt，
  2488	    但它们不在适用集里，序数回推把它们漏计。
  2489	
  2490	    ⚠️ 实测：正常写 E1、L 两次评分后，把 L 转成合法的历史形态（去 marker 与全部
  2491	    review 扩展键，validator `rc=0`），原样重跑 E1 被报「**envelope 冲突**」。
  2492	    那个诊断是**错的** —— 评分事实并无不一致，不一致的是算出的期望序数。
  2493	
  2494	    处置按审查者口径「不伪造期望值」：报真因停下，而不是硬算一个数再以 envelope
  2495	    冲突的名义拒绝。⛔ 本门锁的是**诊断的正确性**，不只是"拒了就行"——
  2496	    一个错的拒因会把用户引去查根本没错的地方。
  2497	    """
  2498	    for eid, ts in (("E1#q1", TS1), ("L#q1", "2026-08-01T11:00:00Z")):
  2499	        assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts)).returncode == 0
  2500	    rows = list(_ledger_lines(vault))  # 已是解析好的 dict

