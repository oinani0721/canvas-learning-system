   276	
   277	def _durable_instant(rt, ctx):
   278	    """durable 行的 review_time → UTC 整秒 aware datetime; 不合规即 fail-closed。
   279	
   280	    Codex round-3 BLOCKER (R2): A2 会把小数秒 durable review_time 交给 bridge,
   281	    bridge 入口 _whole_second 截成整秒写进 W ⇒ 「10:00:00.5 > 10:00:00」恒真,
   282	    同一账本行每次重跑都判 pending 并**再推进一次 FSRS** (§6.2 A5 禁止的二次
   283	    apply; 实测账本始终一行而 W 逐次 +1s)。
   284	    ⛔ 只验不改: 消费时顺手规范化 = 把损坏行洗成合法行, 缺陷从写入面挪进不可
   285	    见面。本写点的 _iso() 恒产出整秒 UTC, 校验器对 review/1 行也机械强制整秒 —
   286	    出现小数秒/非 UTC 即外部污染, 停下人工修, 不猜。
   287	    """
   288	    if not isinstance(rt, str) or not rt.strip():
   289	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非字符串 ({rt!r}), fail-closed 拒写")
   290	    # 整秒判据复用**校验器本体**的 _WHOLE_SECOND_RE (禁第三套, DD-03/DD-13):
   291	    # 判据必须是**字面**而非解析后的值 —— '10:00:00.000000Z' 的 microsecond
   292	    # 恰为 0, 只看值会放行它, 而校验器按字面判 FAIL ⇒ 写点放行、validator 拒,
   293	    # 实现与契约又成两个口径 (正是 R6 那类缺陷的重演)。同源即无分叉。
   294	    if not _WHOLE_SECOND_RE.match(rt.strip()):
   295	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非 canonical 整秒形态 ({rt!r}; §6.2 A5 要求 YYYY-MM-DDThh:mm:ss 加 Z 或 ±hh:mm, 无小数秒 — 含小数秒会让同一行二次推进 FSRS), fail-closed 拒写")
   296	    try:
   297	        _dt = datetime.fromisoformat(rt.strip().replace("Z", "+00:00"))
   298	    except ValueError:
   299	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 不可解析 ({rt!r}), fail-closed 拒写")
   300	    # 字面门放行 ±hh:mm 任意偏移 (校验器口径); A2 消费面比校验器**严一档**,
   301	    # 只收 UTC (卡文 (b)) —— 本写点恒产出 Z, 非 UTC 行必为外部写入。
   302	    if _dt.tzinfo is None or _dt.utcoffset() != timedelta(0):
   303	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非 UTC ({rt!r}; §6.2 A6 要求 tz-aware UTC 时刻), fail-closed 拒写")
   304	    return _dt
