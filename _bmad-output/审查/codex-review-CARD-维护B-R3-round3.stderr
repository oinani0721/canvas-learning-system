  2000	        text_raw = Path(path).read_text(encoding="utf-8")
  2001	    except (OSError, UnicodeDecodeError) as e:
  2002	        print(f"✗ 报告不可读: {type(e).__name__}")
  2003	        return 1
  2004	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2005	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2006	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2007	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2008	    if not fm_m:
  2009	        print("✗ 报告缺 frontmatter 块")
  2010	        return 1
  2011	    fm = fm_m.group(1)
  2012	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2013	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
