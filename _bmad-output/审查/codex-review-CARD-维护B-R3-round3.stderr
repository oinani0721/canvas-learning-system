  1439	def _scan_number_pool(obj, pool: set[int]) -> None:
  1440	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1441	
  1442	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1443	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1444	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1445	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1446	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1447	    """
  1448	    if isinstance(obj, bool):
  1449	        return
  1450	    if isinstance(obj, int):
  1451	        pool.add(obj)
  1452	    elif isinstance(obj, float):
  1453	        if obj.is_integer():
  1454	            pool.add(int(obj))
  1455	    elif isinstance(obj, dict):
  1456	        for v in obj.values():
  1457	            _scan_number_pool(v, pool)
  1458	    elif isinstance(obj, list):
  1459	        for v in obj:
  1460	            _scan_number_pool(v, pool)

