   229	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   230	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。

 succeeded in 0ms:
   230	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   231	
   232	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   233	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   234	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   235	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   236	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   237	    要求"确实收集到用例"且"确实有失败"才算变红。
   238	    """
   239	    r = subprocess.run(
   240	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   241	        cwd=ROOT / "backend",
   242	        capture_output=True,
   243	        text=True,
   244	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   245	        timeout=600,
   246	    )
   247	    out = r.stdout
   248	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   249	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   250	    return r.returncode, out[-400:], passed + failed, failed
   251	
   252	
   253	def main() -> int:
   254	    try:
   255	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   256	    except FileExistsError:
   257	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   258	        return 2
   259	    try:
   260	        original = TARGET.read_bytes()
   261	        backup_sha = hashlib.sha256(original).hexdigest()
   262	
   263	        rc0, out0, n0, f0 = run_suite("domain_")
   264	        if rc0 != 0 or f0 or n0 == 0:
   265	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   266	            return 2
   267	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   268	
   269	        failures = 0
   270	        for name, subs, keyword in MUTANTS:
   271	            text = original.decode("utf-8")
   272	            for old, new in subs:
   273	                if old not in text:
   274	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   275	                    failures += 1
   276	                    text = None
   277	                    break
   278	                text = text.replace(old, new, 1)
   279	            if text is None:
   280	                continue
   281	            TARGET.write_text(text, encoding="utf-8")
   282	            try:
   283	                rc, out, n, f = run_suite(keyword)
   284	            finally:
   285	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   286	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   287	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   288	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   289	            if n == 0:
   290	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   291	                failures += 1
   292	            elif f == 0:
   293	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   294	                failures += 1
   295	            else:
   296	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   297	
   298	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   299	        return 1 if failures else 0
   300	    finally:
   301	        LOCK.rmdir()
   302	
   303	
   304	if __name__ == "__main__":
   305	    sys.exit(main())

