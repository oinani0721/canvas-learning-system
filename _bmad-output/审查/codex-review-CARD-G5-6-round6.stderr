  1069	def test_stable_id_is_path_determined_and_content_agnostic(tmp_path):
  1070	    vault, _ = base_vault(tmp_path)
  1071	    # ⛔ 三个产物目录必须各自的父目录已存在 —— prepare_out_dir 明令不静默造祖先链
  1072	    r1, r2, r3 = tmp_path / "r1", tmp_path / "r2", tmp_path / "r3"
  1073	    p = mk(vault / "_待处理" / "稳定.md", "# a\n\n正文一。\n正文二。\n", age_days=3)
  1074	    assert run_cli(vault, r1).returncode == 0
  1075	    id1 = load_json(r1)["items"][0]["stable_id"]
  1076	
  1077	    mk(vault / "_待处理" / "稳定.md", "# a\n\n完全不同的正文。\n第二行也不同。\n", age_days=9)
  1078	    assert run_cli(vault, r2).returncode == 0
  1079	    id2 = load_json(r2)["items"][0]["stable_id"]
  1080	
  1081	    assert id1 == id2, "内容与 mtime 变化不得改变身份"
  1082	    assert id1.startswith("inb1-")
  1083	
  1084	    mk(vault / "_待处理" / "另一个.md", "# b\n\n正文一。\n正文二。\n", age_days=2)
  1085	    assert run_cli(vault, r3).returncode == 0
  1086	    ids = {i["stable_id"] for i in load_json(r3)["items"]}
  1087	    assert len(ids) == 2, "不同路径必须不同 ID"
  1088	    assert p.exists()
