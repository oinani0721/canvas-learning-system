  1218	def test_ai_marker_needs_boundary_after_literal(tmp_path):
  1219	    """⛔ H2 回归: 标记右侧必须满足边界规则 —— 话题提及不是生成断言, 不得被归档。
  1220	    ⛔ round-3 自审 H2-1 扩: 汉字收尾标记后须为行尾/空白/标点; ASCII 字母收尾
  1221	    标记(`Generated by AI`)后空白**不算**边界 —— `Generated by AI Lab` 是机构名,
  1222	    `本文由 AI 领域…` 是话题, 放行空白就是把边界规则对这些标记变成空操作。"""
  1223	    vault, out = base_vault(tmp_path)
  1224	    inbox = vault / "_待处理"
  1225	    mk(
  1226	        inbox / "版权话题.md",
  1227	        "# AI 生成内容的版权问题\n\n话题正文一。\n话题正文二。\n",
  1228	        age_days=9,
  1229	    )
  1230	    mk(
  1231	        inbox / "由字版权话题.md",
  1232	        "# 由 AI 生成内容的版权问题\n\n话题正文三。\n话题正文四。\n",
  1233	        age_days=8,
  1234	    )
  1235	    mk(
  1236	        inbox / "评测话题.md",
  1237	        "# Deep Research 生成质量评测\n\n评测正文一。\n评测正文二。\n",
  1238	        age_days=7,
  1239	    )
  1240	    mk(
  1241	        inbox / "本文由话题.md",
  1242	        "# 访谈整理\n\n本文由 AI 领域的三位研究者共同撰写，记录分歧。\n访谈正文二。\n",
  1243	        age_days=6,
  1244	    )
  1245	    mk(
  1246	        inbox / "英文机构.md",
  1247	        "# Lab notes\n\nGenerated by AI Lab researchers in Beijing.\n笔记正文二。\n",
  1248	        age_days=5,
  1249	    )
  1250	    # 正向对照: 行尾/标点/加粗收尾仍命中, 依据带行号与逐字片段
  1251	    mk(
  1252	        inbox / "行尾自述.md",
  1253	        "# 报告甲\n\n> 本文由 AI 生成\n\n自述正文一。\n自述正文二。\n",
  1254	        age_days=4,
  1255	    )
  1256	    mk(
  1257	        inbox / "标点自述.md",
  1258	        "# 报告乙\n\n由 AI 生成，仅供参考\n\n自述正文三。\n自述正文四。\n",
  1259	        age_days=3,
  1260	    )
  1261	    mk(
  1262	        inbox / "英文句点自述.md",
  1263	        "# Report\n\nThis draft was generated by AI.\n报告正文二。\n",
  1264	        age_days=2,
  1265	    )
  1266	    mk(
  1267	        inbox / "加粗自述.md",
  1268	        "# 报告丙\n\n**由 AI 生成**\n\n自述正文五。\n自述正文六。\n",
  1269	        age_days=1,
  1270	    )
  1271	
  1272	    assert run_cli(vault, out).returncode == 0
  1273	    data = load_json(out)
  1274	    for name in (
  1275	        "版权话题.md",
  1276	        "由字版权话题.md",
  1277	        "评测话题.md",
  1278	        "本文由话题.md",
  1279	        "英文机构.md",
  1280	    ):
  1281	        it = item_by_name(data, name)
  1282	        assert it["criterion"] != "C2_ai_self_declared", name
  1283	        # ⛔ round-3 Codex MEDIUM: 只排除 C2 曾放过「整批被判 C3 建议删」的变异 ——
  1284	        # 负例必须同时钉住「没有被破坏性提名」
  1285	        assert it["verdict"] != "建议删", name
  1286	        assert it["confident"] is False, name
  1287	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1288	    tail = item_by_name(data, "行尾自述.md")
  1289	    assert tail["criterion"] == "C2_ai_self_declared"
