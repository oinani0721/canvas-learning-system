   963	            f"文头第 {lineno} 行自述「{marker}」"
   964	            + (f"；文件名带 R{rnd}_ 故归轮次目录" if rnd else ""),
   965	            True,
   966	        )
   967	
   968	    def _looks_like_source_value(v: str) -> bool:
   969	        """URL 前缀形态判定（⛔ 不要求可机判合法）：`https://:443/x` 这类损坏
   970	        URL 同样是来源声明 —— round-5 审查 BLOCKER-2 实证 `Source: <坏URL>` 曾
   971	        因值不合法穿透信号③b 被建议删。大小写不敏感。"""
   972	        return v.strip().casefold().startswith(("http://", "https://"))
   973	
   974	    # 信号③b：非 source 键名但值是 URL 形态（url:/URL:/Source: 等剪藏工具
   975	    # 常见键名 —— round-5 自审 F2 实证它们曾穿透全部信号被建议删且 URL 零留痕；
   976	    # 值损坏的别名见 `_looks_like_source_value`）。
   977	    # 合法 source 键在此不可能出现（C1 已先行返回）。⚠️ C1 仍只认字面 source 键
   978	    # （R8 稿约定）；本信号只把这类来源摆上台面降 C6，不扩大 C1。
   979	    url_bearing_keys = [k for k, v in fm.items() if v and _looks_like_source_value(v)]
