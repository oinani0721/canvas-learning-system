   561	def test_yaml_inline_comment_does_not_hide_source_url(tmp_path):
   562	    """⛔ MEDIUM 回归: `source: <url> # 官方来源` 的值是 URL, 注释不算值的一部分。"""
   563	    vault, out = base_vault(tmp_path)
