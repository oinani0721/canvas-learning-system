   567	        age_days=3,
   568	    )
   569	    assert run_cli(vault, out).returncode == 0
   570	    it = load_json(out)["items"][0]
   625	    assert scan["compared_pairs"] >= 1, "长度相近的一对必须真的比过"
   626	    assert scan["skipped_length_prefilter"] >= 1, "长度差悬殊的一对必须计入跳过"
