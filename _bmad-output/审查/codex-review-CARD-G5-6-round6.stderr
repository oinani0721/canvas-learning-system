   255	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   256	            results.append((name, gate, r.returncode, killed))
   257	            if not killed:
   258	                ok = False
   259	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   260	                print(out[-1500:])
   261	        finally:
   262	            SCRIPT.write_bytes(pristine)
   263	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   264	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   265	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   266	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
