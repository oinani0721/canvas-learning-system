  1636	def validate_label(label: str) -> None:
  1637	    if not label or _BAD_LABEL.search(label):
  1638	        raise SystemExit(
  1639	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
  1640	        )
  1641	
  1642	
  1643	def validate_product_filename(label: str) -> None:
  1644	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  1645	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  1646	    for suffix in (".json", ".md"):
  1647	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  1648	        if n > MAX_FILENAME_BYTES:
  1649	            raise SystemExit(
  1650	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  1651	                f"inbox-preview-{label}{suffix}"
  1652	            )
  1653	
  1654	
  1655	def main() -> int:
  1656	    ap = argparse.ArgumentParser(
  1657	        description="待处理盘点提名 preview（只读, CARD-G5-6）"
  1658	    )
  1659	    ap.add_argument("--vault", required=True, help="vault 根目录")
  1660	    ap.add_argument(
  1661	        "--now", required=True, help="基准时刻 ISO-8601（裸时间按 Asia/Shanghai 解释）"
  1662	    )
  1663	    ap.add_argument(
  1664	        "--inbox-dir",
  1665	        default=None,
  1666	        help=f"收件箱目录（缺省 <vault>/{DEFAULT_INBOX_NAME}）。"
  1667	        "显式给定却不存在 = 拒绝；缺省路径不存在 = 空仓回执",
  1668	    )
  1669	    ap.add_argument(
  1670	        "--out-dir",
  1671	        default=None,
  1672	        help="产物目录（缺省 <vault>/outputs；父目录必须已存在）",
  1673	    )
  1674	    ap.add_argument(
  1675	        "--batch-size", type=int, default=BATCH_MAX, help=f"单批件数（1..{BATCH_MAX}）"
  1676	    )
  1677	    args = ap.parse_args()
  1678	
  1679	    # ⛔ 次序铁律：全部输入守卫跑完**再**碰 out-dir —— 拒绝路径必须零产物。
  1680	    if not (1 <= args.batch_size <= BATCH_MAX):
  1681	        raise SystemExit(
  1682	            f"✗ --batch-size 必须在 1..{BATCH_MAX}（D15 确认预算上限，不得突破）, 实得 {args.batch_size}"
  1683	        )
  1684	    now = parse_now(args.now)
  1685	
  1686	    vault = Path(args.vault)
  1687	    if vault.is_symlink():
  1688	        raise SystemExit(f"✗ vault 路径本身是 symlink, 拒绝越界读取: {vault}")
  1689	    if not vault.is_dir():
  1690	        raise SystemExit(f"✗ vault 不存在或不是目录: {vault}")
  1691	    vault = vault.resolve()
  1692	
  1693	    explicit = args.inbox_dir is not None
  1694	    inbox = Path(args.inbox_dir) if explicit else vault / DEFAULT_INBOX_NAME
  1695	    if inbox.is_symlink():
  1696	        raise SystemExit(f"✗ 收件箱目录本身是 symlink, 拒绝越界读取: {inbox}")
  1697	    inbox_exists = inbox.is_dir()
  1698	    if explicit and not inbox_exists:
  1699	        # 用户明确指了路径却找不到 = 写错了。绝不能报成「空仓」把 typo 掩盖掉。
  1700	        raise SystemExit(f"✗ --inbox-dir 指定的目录不存在: {inbox}")
  1701	
  1702	    validate_label(inbox.name)
  1703	    validate_product_filename(inbox.name)
  1704	
  1705	    out_dir_arg = Path(args.out_dir) if args.out_dir else vault / "outputs"
  1706	    inbox_real, out_real = os.path.realpath(inbox), os.path.realpath(out_dir_arg)
  1707	    if out_real == inbox_real or out_real.startswith(inbox_real + os.sep):
  1708	        # ⛔ 否则第一次跑落下的两份产物，第二次跑会被当成待处理材料盘点进来 ——
  1709	        # 「同输入二跑逐字节相等」当场不成立，而且是那种跑两次才看得见的不成立。
  1710	        raise SystemExit(
  1711	            f"✗ 产物目录不能位于收件箱内, 拒绝运行（二跑会把上一次的产物当成待处理材料）: {out_dir_arg}"
  1712	        )
  1713	    excluded = [inbox_real, out_real]
  1714	
  1715	    data = build_preview(vault, inbox, inbox_exists, now, args.batch_size, excluded)
  1716	    payload_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
  1717	    payload_md = render_md(data)
  1718	
  1719	    out_dir = _SP.prepare_out_dir(out_dir_arg)
  1720	    json_path = out_dir / f"inbox-preview-{inbox.name}.json"
  1721	    md_path = out_dir / f"inbox-preview-{inbox.name}.md"
  1722	    _SP.write_pair_atomically_checked(
  1723	        [(json_path, payload_json), (md_path, payload_md)]
  1724	    )
  1725	
  1726	    print(
  1727	        f"✓ preview 已生成（只读引擎, 未动 vault 任何既有文件）: {json_path} / {md_path}"
  1728	    )
  1729	    print(f"  {data['receipt']}")
  1730	    unsure = sum(1 for i in data["items"] if not i["confident"])
  1731	    print(
  1732	        f"  本批 {len(data['items'])} 件 · 拿不准 {unsure} 件 · "
  1733	        f"建议删 {sum(1 for i in data['items'] if i['verdict'] == V_DELETE)} 件"
  1734	    )
  1735	    return 0
  1736	
