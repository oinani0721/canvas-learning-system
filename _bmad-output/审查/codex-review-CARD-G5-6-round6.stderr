  1703	def test_frontmatter_map_value_fidelity():
  1704	    """⛔ round-3 自审 GATE-1/H3-3: _FM_KEY_RE 的**值提取**半边此前无任何门锁 ——
  1705	    回退旧正则 63 条照样全绿。本门锁三个行为: 值含冒号的键完整保留 /
  1706	    冒号前空格的键被解析 / 冒号后无空格仍不认键 (值不吞 URL)。"""
  1707	    mod = load_module()
  1708	    fm = mod.frontmatter_map(["created: 2026-01-01T00:00:00+08:00"])
  1709	    assert fm["created"] == "2026-01-01T00:00:00+08:00", "值里的冒号不得截断值"
  1710	    fm = mod.frontmatter_map(["title : x"])
