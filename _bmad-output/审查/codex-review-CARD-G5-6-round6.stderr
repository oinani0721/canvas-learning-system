  1573	def test_source_like_keys_are_undigested_signals(tmp_path):
  1574	    """⛔ round-5 自审 F2 (BLOCKER): 来源声明信号不能只认字面 source 键 ——
  1575	    `url:`/`URL:`/`Source:` 等剪藏工具常见键名曾穿透全部信号: 无正文判 C3 建议删、
  1576	    带独有 URL 的重复件判 C4 建议删且 URL 零留痕。任意键的值为合法 URL 形态
  1577	    即为来源声明信号(降 C6); C1 仍只认 source 键(R8 稿约定), 信号只降级不扩大。"""
  1578	    vault, out = base_vault(tmp_path)
  1579	    inbox = vault / "_待处理"
  1580	    mk(inbox / "url键书签.md", "---\nurl: https://clip.example/article-42\n---\n", age_days=7)
  1581	    mk(inbox / "大写Source键.md", "---\nSource: https://clip.example/other\n---\n", age_days=6)
  1582	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1583	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1584	    mk(
  1585	        inbox / "url键重复件.md",
  1586	        "---\nurl: https://unique-source.example/a\n---\n" + body,
  1587	        age_days=5,
  1588	    )
  1589	    # 正向对照 1: 值不是 URL 的键不触发信号 → 纯空骨架仍 C3
  1590	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1591	    # 正向对照 2: source 键 + 合法 URL → 仍 C1 (信号不扩大 C1)
  1592	    mk(inbox / "source键书签.md", "---\nsource: https://ok.test/x\n---\n", age_days=3)
  1593	
  1594	    assert run_cli(vault, out).returncode == 0
  1595	    data = load_json(out)
  1596	    for name in ("url键书签.md", "大写Source键.md"):
  1597	        it = item_by_name(data, name)
  1598	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1599	        assert it["criterion"] == "C6_undecided", name
  1600	        assert "clip.example" in (it["uncertain_reason"] or ""), name
  1601	    dup = item_by_name(data, "url键重复件.md")
  1602	    assert dup["verdict"] != "建议删", f"URL 重复件被建议删了: {dup['basis']}"
  1603	    assert dup["exact_duplicate_of"] == "节点/库内正本.md"
  1604	    assert "unique-source.example" in (dup["uncertain_reason"] or "")
  1605	    skeleton = item_by_name(data, "纯空骨架.md")
  1606	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1607	    assert skeleton["verdict"] == "建议删"
  1608	    primary = item_by_name(data, "source键书签.md")
  1609	    assert primary["criterion"] == "C1_source_url"
