  1501	def test_ai_suspect_without_body_never_suggested_for_deletion(tmp_path):
  1502	    """⛔ round-4 BLOCKER-1: 边界规则拒掉的 AI 自述嫌疑 × 无正文 → 不得判 C3 建议删。
  1503	
  1504	    `generator: Generated by AI on March` 是肯定式生成断言, 但 ASCII 收尾标记
  1505	    的右边界(禁空白)把它拒了 —— 漏判本身方向安全, 可漏判后掉进 C3 就是把
  1506	    「引擎不敢确定的文件」当垃圾扔。护栏第 4 类信号: 裸子串在场即拦。"""
  1507	    vault, out = base_vault(tmp_path)
  1508	    mk(
  1509	        vault / "_待处理" / "英文断言仅头.md",
  1510	        "---\ngenerator: Generated by AI on March\n---\n",
  1511	        age_days=5,
  1512	    )
  1513	    # 正向对照: 无任何 AI 字样的纯空骨架 → 仍 C3 建议删 (护栏不得误伤存量判据)
  1514	    mk(vault / "_待处理" / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1515	
  1516	    assert run_cli(vault, out).returncode == 0
  1517	    data = load_json(out)
  1518	    it = item_by_name(data, "英文断言仅头.md")
  1519	    assert it["verdict"] != "建议删", f"AI 嫌疑件被建议删了: {it['basis']}"
  1520	    assert it["criterion"] == "C6_undecided"
  1521	    assert it["confident"] is False
  1522	    assert it["target_hint"] is None and it["nomination_type"] is None
  1523	    assert "Generated by AI" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1524	    skeleton = item_by_name(data, "纯空骨架.md")
  1525	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1526	    assert skeleton["verdict"] == "建议删"
