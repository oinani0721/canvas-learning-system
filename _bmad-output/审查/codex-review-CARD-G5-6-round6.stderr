  1333	def test_frontmatter_span_requires_key_then_space_or_eol():
  1334	    """⛔ H3 回归(纯函数): YAML 映射键必须是 `key:` 后接空白或行尾;
  1335	    `https://example.com` 的 `https:` 不满足 → span 必须为 0。"""
  1336	    mod = load_module()
  1337	    bad = "---\nhttps://example.com\n---\n\n正文。\n".splitlines()
  1338	    assert mod.frontmatter_span(bad) == 0
  1339	    good = "---\ntags:\n---\n\n正文。\n".splitlines()
  1340	    assert mod.frontmatter_span(good) == 3
