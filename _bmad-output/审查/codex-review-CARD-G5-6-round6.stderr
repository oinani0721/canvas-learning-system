  1329	def _parse_slept_at(raw: str) -> datetime | None:
  1330	    if not raw:
  1331	        return None
  1332	    try:
  1333	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  1334	    except ValueError:
  1335	        try:
  1336	            d = date.fromisoformat(raw)
  1337	        except ValueError:
  1338	            return None
  1339	        dt = datetime(d.year, d.month, d.day)
  1340	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
