   993	def test_far_future_mtime_reports_what_filesystem_stores(tmp_path):
   994	    """⛔ 本条钉的是一个实证事实 + 一条诚实纪律。
   995	
   996	    事实: `os.utime` 把 mtime 设到 9999 年时, macOS APFS **静默钳位**到 int64 纳秒
   997	    上界(2262-04-11T23:47:16Z), `st_mtime` / `st_mtime_ns` 回读到的都是钳位值、不抛。
   998	    纪律: 引擎必须**照实报文件系统里存着的那个值**, 既不崩、也不自己造一个。
   999	    第一条断言把「钳位」这个前提本身钉住 —— 换个文件系统若不再钳位, 本条会失败提醒
  1000	    而不是继续绿着(前提失效的测试恒绿 = 假证书)。
  1001	    """
  1002	    vault, out = base_vault(tmp_path)
  1003	    p = mk(vault / "_待处理" / "远未来.md", "# t\n\n正文一。\n正文二。\n", age_days=1)
  1004	    far = 253402300799  # 9999-12-31T23:59:59Z
  1005	    os.utime(p, (far, far))
  1006	    stored = p.stat().st_mtime
  1007	    assert stored < far, "前提失效: 本平台 os.utime 未钳位远未来 mtime"
  1008	
  1009	    r = run_cli(vault, out)
  1010	    assert r.returncode == 0, r.stderr[-300:]
  1011	    it = load_json(out)["items"][0]
  1012	    expected = datetime.fromtimestamp(stored, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
  1013	    assert it["mtime_utc"] == expected, "引擎报的必须逐字等于文件系统存的, 不得自造"
  1014	    assert it["age_days"] < 0, "--now 远早于该 mtime, 负年龄如实呈现不夹逼"
  1015	
