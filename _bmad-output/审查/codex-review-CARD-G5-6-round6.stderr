   471	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   472	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   473	    lines = text.splitlines()
   474	    n = frontmatter_span(lines)
   475	    return (lines[1 : n - 1] if n else []), lines[n:]
   476	
   477	
   478	def frontmatter_map(fm_lines: list[str]) -> dict:
   479	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   480	    out: dict[str, str] = {}
   481	    for ln in fm_lines:
   482	        m = _FM_KEY_RE.match(ln)
   483	        if not m:
   484	            continue
   485	        val = (m.group(2) or "").strip()
   486	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   487	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   488	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   489	        val = re.sub(r"\s+#.*$", "", val).strip()
   490	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   491	            val = val[1:-1]
   492	        out.setdefault(m.group(1), val)
   493	    return out
   494	
   495	
   496	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   497	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   498	
   499	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   500	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   501	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   502	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   503	    分隔行由状态机精确标记，内容行一律是内容。
   504	
   505	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   506	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   507	
   508	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   509	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   510	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   511	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   512	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   513	    """
   514	    _, rest = split_frontmatter(text)
   515	    rows: list[tuple[str, str]] = []
   516	    in_fence = False
   517	    fence_char = ""
   518	    fence_len = 0
   519	    in_comment = False
   520	    for ln in rest:
   521	        m = _FENCE_RE.match(ln)
   522	        if m and not in_comment:
   523	            tok = m.group(1)
   524	            if not in_fence:
   525	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   526	                rows.append((ln, "fence"))
   527	                continue
   528	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   529	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   530	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   531	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   532	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   533	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   534	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   535	            # 在 CommonMark 里是围栏内容）。
   536	            if (
   537	                tok[0] == fence_char
   538	                and len(tok) >= fence_len
   539	                and all(c in " \t" for c in ln[m.end() :])
   540	            ):
   541	                in_fence, fence_char, fence_len = False, "", 0
   542	                rows.append((ln, "fence"))
   543	                continue
   544	        if in_fence:
   545	            rows.append((ln, "code"))
   546	            continue
   547	        kept, rem = "", ln
   548	        while rem:
   549	            if in_comment:
   550	                i = rem.find("-->")
   551	                if i < 0:
   552	                    break
   553	                rem, in_comment = rem[i + 3 :], False
   554	            else:
   555	                i = rem.find("<!--")
   556	                if i < 0:
   557	                    kept += rem
   558	                    break
   559	                kept += rem[:i]
   560	                rem, in_comment = rem[i + 4 :], True
   561	        rows.append((kept, "text"))
   562	    return rows, in_comment
   563	
   564	
   565	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   566	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   567	    三态细节见 `_classify_lines_typed`。"""
   568	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   569	
   570	
   571	def dup_body(text: str) -> str:
   572	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   573	
   574	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   575	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   576	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   577	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   578	    有后果的提名，依据必须逐字。
   579	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   580	    """
   581	    parts: list[str] = []
   582	    for ln, is_code in _classify_lines(text):
   583	        if not is_code and _HEADING_RE.match(ln):
   584	            continue
   585	        t = ln.rstrip()
   586	        if not t:
   587	            continue
   588	        parts.append(nfc(t))
   589	    return "\n".join(parts)
   590	
   591	
   592	def has_substantive_content(text: str) -> bool:
   593	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   594	
   595	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   596	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   597	    合用一个函数正是 Codex BLOCKER 的根因。
   598	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   599	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   600	    （round-3 自审 B3-3）。
   601	    """
   602	    for ln, kind in _classify_lines_typed(text)[0]:
   603	        if kind == "code":
   604	            if ln.strip():
   605	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   606	            continue
   607	        if kind == "fence":
   608	            continue
   609	        if _HEADING_RE.match(ln):
   610	            continue
   611	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   612	        if t and not _ONLY_STRUCT_RE.match(t):
   613	            return True
   614	    return False
   615	
   616	
   617	def skeleton_note(text: str, size: int) -> str:
   618	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   619	
   620	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   621	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   622	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   623	    """
   624	    if size == 0:
   625	        return "0 字节空文件"
   626	    rows = _classify_lines_typed(text)[0]
   627	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   628	    struct = sum(
   629	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   630	    )
   631	    fences = sum(1 for _, k in rows if k == "fence")
   632	    return (
   633	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   634	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   635	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   636	    )
   637	
   638	
   639	def head_window(text: str) -> list[tuple[int, str]]:
   640	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   641	    lines = text.splitlines()
   642	    n = frontmatter_span(lines)
   643	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   644	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   645	        win.append((n + j + 1, ln))
   646	    return win
   647	
   648	
   649	def _norm_ai_line(ln: str) -> str:
   650	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   651	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   652	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   653	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   654	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   655	    return " ".join(ln.split()).casefold()
   656	
   657	
   658	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   659	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   660	
   661	
   662	def _find_marker_pos(ln: str, marker: str) -> int:
   663	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   664	
   665	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   666	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   667	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   668	    行内更靠后的真命中。
   669	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   670	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   671	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   672	    只认行尾或标点；漏判方向落 C6，安全。"""
   673	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   674	    start = 0
   675	    while (i := ln.find(marker, start)) >= 0:
   676	        j = i + len(marker)
   677	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   678	            return i
   679	        if not ascii_ending and ln[j].isspace():
   680	            return i
   681	        start = i + 1
   682	    return -1
   683	
   684	
   685	def find_ai_marker(text: str) -> tuple[int, str] | None:
   686	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   687	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   688	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   689	    —— 行号准确，文本保真。"""
   690	    for lineno, ln in head_window(text):
   691	        norm = _norm_ai_line(ln)
   692	        hits = [
   693	            (pos, -len(nm), orig)
   694	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   695	            if (pos := _find_marker_pos(norm, nm)) >= 0
   696	        ]
   697	        if hits:
   698	            _, _, marker = min(hits)
   699	            return lineno, marker
   700	    return None
   701	
   702	
   703	def raw_ai_marker(text: str) -> str | None:
   704	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   705	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
   706	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
   707	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
   708	    返回原表原文（uncertain_reason 展示用）。"""
   709	    for _, ln in head_window(text):
   710	        norm = _norm_ai_line(ln)
   711	        for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
   712	            if nm in norm:
   713	                return orig
   714	    return None
   715	
   716	
   717	def round_of(name: str) -> str | None:
   718	    m = _ROUND_RE.search(name)
   719	    return m.group(1) if m else None
   720	
   721	
   722	def round_type(name: str) -> str | None:
   723	    for pat, typ in ROUND_SUBPATTERNS:
   724	        if pat in name:
   725	            return typ
   726	    return None
   727	
