  1369	def build_preview(
  1370	    vault: Path,
  1371	    inbox: Path,
  1372	    inbox_exists: bool,
  1373	    now: datetime,
  1374	    batch_size: int,
  1375	    excluded_roots: list[str],
  1376	) -> dict:
  1377	    now_s = _epoch_s(now)
  1378	    items_raw, skipped = list_inbox(inbox, now_s) if inbox_exists else ([], [])
  1379	    total = len(items_raw)
  1380	    batch_raw = items_raw[:batch_size]
  1381	    deferred = [
  1382	        {
  1383	            "name": it["name"],
  1384	            "age_days": it["age_days"],
  1385	            "mtime_local": it["mtime_local"],
  1386	        }
  1387	        for it in items_raw[batch_size:]
  1388	    ]
  1389	
  1390	    dup_index, corpus_bodies, corpus_stats = scan_corpus(vault, excluded_roots)
  1391	    scan = {
  1392	        "ratio_threshold": NEAR_DUP_RATIO,
  1393	        "body_char_cap": NEAR_DUP_BODY_CHAR_CAP,
  1394	        "length_prefilter_ratio": NEAR_DUP_LEN_RATIO,
  1395	        "top_n_reported": NEAR_DUP_TOP_N,
  1396	        "compared_pairs": 0,
  1397	        "skipped_oversize": 0,
  1398	        "skipped_length_prefilter": 0,
  1399	        "note": "「跳过」≠「无重复」：跳过的对从未比对过，产物如实分列两个计数。",
  1400	    }
  1401	
  1402	    texts = {it["rel_path"]: read_text_or_none(Path(it["_path"])) for it in batch_raw}
  1403	    batch_body_counts: dict[str, int] = {}
  1404	    for it in batch_raw:
  1405	        t = texts[it["rel_path"]]
  1406	        if t is None:
  1407	            continue
  1408	        b = dup_body(t) if has_substantive_content(t) else ""
  1409	        if b:
  1410	            batch_body_counts[b] = batch_body_counts.get(b, 0) + 1
  1411	
  1412	    items: list[dict] = []
  1413	    for idx, it in enumerate(batch_raw, start=1):
  1414	        text = texts[it["rel_path"]]
  1415	        base = {k: v for k, v in it.items() if not k.startswith("_")}
  1416	        base["index"] = idx
  1417	        base["text_readable"] = text is not None
  1418	        items.append(
  1419	            nominate(base, text, dup_index, corpus_bodies, scan, batch_body_counts)
  1420	        )
  1421	
  1422	    data = {
  1423	        "schema_version": SCHEMA_VERSION,
  1424	        "generator": GENERATOR,
  1425	        "id_namespace": INBOX_ID_NAMESPACE,
  1426	        "id_stability": ID_STABILITY,
  1427	        "vault_fingerprint": "vf1-"
  1428	        + hashlib.sha256(os.path.realpath(vault).encode("utf-8")).hexdigest()[:16],
  1429	        "now": now.isoformat(),
  1430	        "now_utc": fmt_utc(now_s),
  1431	        "now_local": fmt_local(now_s),
  1432	        "inbox_dir": f"{inbox.name}/",
  1433	        "inbox_exists": inbox_exists,
  1434	        "label": inbox.name,
  1435	        "criteria_order": list(CRITERIA_ORDER),
  1436	        "verdict_vocabulary": VERDICT_VOCABULARY,
  1437	        "corpus": corpus_stats,
  1438	        "inventory": {
  1439	            "total": total,
  1440	            "batch_size": batch_size,
  1441	            "batch_max": BATCH_MAX,
  1442	            "batch_rule": "最旧优先（mtime 升序，同 mtime 按文件名升序），"
  1443	            f"单批上限 {BATCH_MAX} 件（D15 确认预算：一次性 >20 项完成率趋近 0）",
  1444	            "over_budget": total > batch_size,
  1445	            "deferred": deferred,
  1446	            "skipped": skipped,
  1447	        },
  1448	        "items": items,
  1449	        "sleeping": build_sleeping(inbox, now_s, inbox_exists),
  1450	        "near_dup_scan": scan,
  1451	        "last_cleanup": None,
  1452	        "last_cleanup_note": LAST_CLEANUP_NOTE,
  1453	        "not_executed_disclaimer": NOT_EXECUTED,
  1454	    }
  1455	    data["receipt"] = build_receipt(data)
  1456	    return data
