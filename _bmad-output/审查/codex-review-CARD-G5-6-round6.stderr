   435	+def test_fence_close_trailing_whitespace_must_be_ascii(tmp_path):
   436	+    """⛔ round-3 Codex BLOCKER: 关闭围栏行尾只允许 ASCII 空白 (CommonMark 4.5)。
   437	+
   438	+    `str.strip()` 接受一切 Unicode 空白 —— 行尾一个 U+00A0 (NBSP, 从网页复制
   439	+    常见) 曾让该行被当成合法关闭围栏, 围栏提前闭合, `# keep` 被剥 →
   440	+    「空骨架 → 建议删 confident=true」。NBSP 行在 CommonMark 里是围栏**内容**。
   441	+    """
   442	+    vault, out = base_vault(tmp_path)
   443	+    mk(
   444	+        vault / "_待处理" / "nbsp关闭.md",
   445	+        "```\n```\xa0\n# keep\n```\n",
   446	+        age_days=5,
   447	+    )
   448	+    # 正向对照: 行尾 ASCII 空白/制表符仍是合法关闭 (不得修过头) ——
   449	+    # ⛔ 语料必须是「只包围栏无内容」: 带真实内容行时断言杀不死变异
   450	+    mk(vault / "_待处理" / "ascii尾随.md", "```\n``` \t\n", age_days=4)

