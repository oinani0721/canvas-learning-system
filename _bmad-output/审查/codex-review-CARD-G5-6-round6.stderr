   635	+def test_damaged_url_alias_is_undigested(tmp_path):
   636	+    """⛔ round-5 BLOCKER-2: 损坏 URL 的来源键别名不得穿透护栏 —— 信号③b 原
   637	+    要求「值过合法 URL 判定」，`Source: https://:443/x`(损坏) 因此被当不存在
   638	+    而建议删。URL 前缀形态即算来源声明(与 source 键的 fail-closed 同口径)。"""
   639	+    vault, out = base_vault(tmp_path)
   640	+    inbox = vault / "_待处理"
   641	+    mk(inbox / "坏Source别名.md", "---\nSource: https://:443/x\n---\n", age_days=6)
   642	+    body = "别名键重复件的正文。\n第二行。\n"
   643	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   644	+    mk(
   645	+        vault / "_待处理" / "坏url别名重复.md",
   646	+        "---\nurl: https://:443/broken\n---\n" + body,
   647	+        age_days=5,
   648	+    )
   649	+    # 正向对照: 值不是 URL 的别名键 → 不触发 → 纯空骨架仍 C3
   650	+    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
   651	+
   652	+    assert run_cli(vault, out).returncode == 0
   653	+    data = load_json(out)
   654	+    for name in ("坏Source别名.md", "坏url别名重复.md"):
   655	+        it = item_by_name(data, name)
   656	+        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
   657	+        assert it["criterion"] == "C6_undecided", name
   658	+        assert ":443" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
   659	+    skeleton = item_by_name(data, "纯空骨架.md")
   660	+    assert skeleton["criterion"] == "C3_empty_or_skeleton"
   661	+    assert skeleton["verdict"] == "建议删"
