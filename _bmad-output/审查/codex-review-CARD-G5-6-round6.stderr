   534	+def test_source_like_keys_are_undigested_signals(tmp_path):
   535	+    """⛔ round-5 自审 F2 (BLOCKER): 来源声明信号不能只认字面 source 键 ——
   536	+    `url:`/`URL:`/`Source:` 等剪藏工具常见键名曾穿透全部信号: 无正文判 C3 建议删、
   537	+    带独有 URL 的重复件判 C4 建议删且 URL 零留痕。任意键的值为合法 URL 形态
   538	+    即为来源声明信号(降 C6); C1 仍只认 source 键(R8 稿约定), 信号只降级不扩大。"""
   539	+    vault, out = base_vault(tmp_path)
   540	+    inbox = vault / "_待处理"
   541	+    mk(inbox / "url键书签.md", "---\nurl: https://clip.example/article-42\n---\n", age_days=7)
   542	+    mk(inbox / "大写Source键.md", "---\nSource: https://clip.example/other\n---\n", age_days=6)
   543	+    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
   544	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   545	+    mk(
   546	+        inbox / "url键重复件.md",
   547	+        "---\nurl: https://unique-source.example/a\n---\n" + body,
   548	+        age_days=5,
   549	+    )
   550	+    # 正向对照 1: 值不是 URL 的键不触发信号 → 纯空骨架仍 C3
   551	+    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
   552	+    # 正向对照 2: source 键 + 合法 URL → 仍 C1 (信号不扩大 C1)
   553	+    mk(inbox / "source键书签.md", "---\nsource: https://ok.test/x\n---\n", age_days=3)
   554	+
   555	+    assert run_cli(vault, out).returncode == 0
   556	+    data = load_json(out)
   557	+    for name in ("url键书签.md", "大写Source键.md"):
   558	+        it = item_by_name(data, name)
   559	+        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
   560	+        assert it["criterion"] == "C6_undecided", name
   561	+        assert "clip.example" in (it["uncertain_reason"] or ""), name
   562	+    dup = item_by_name(data, "url键重复件.md")
   563	+    assert dup["verdict"] != "建议删", f"URL 重复件被建议删了: {dup['basis']}"
   564	+    assert dup["exact_duplicate_of"] == "节点/库内正本.md"
   565	+    assert "unique-source.example" in (dup["uncertain_reason"] or "")
   566	+    skeleton = item_by_name(data, "纯空骨架.md")
   567	+    assert skeleton["criterion"] == "C3_empty_or_skeleton"
   568	+    assert skeleton["verdict"] == "建议删"
   569	+    primary = item_by_name(data, "source键书签.md")
   570	+    assert primary["criterion"] == "C1_source_url"
