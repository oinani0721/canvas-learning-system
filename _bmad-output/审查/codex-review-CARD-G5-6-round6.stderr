   378	def test_c6_fallback_is_explicitly_undecided(tmp_path):
   379	    """C6 兜底: 六判据全不命中 → 拿不准 + 提问, 且**不给任何去向**。"""
   380	    vault, out = base_vault(tmp_path)
   381	    mk(vault / "_待处理" / "面试思路草稿.md", "# 面试思路\n\n一些我自己的分析文字。\n第二行分析。\n", age_days=3)
   382	
   383	    assert run_cli(vault, out).returncode == 0
   384	    it = load_json(out)["items"][0]
   385	    assert it["criterion"] == "C6_undecided"
   386	    assert it["verdict"] == "拿不准"
   387	    assert it["confident"] is False
   388	    assert it["target_hint"] is None
   389	    assert it["nomination_type"] is None
   390	    assert it["ask"], "兜底必须给出「需要你一句话」的具体问题"
   391	
