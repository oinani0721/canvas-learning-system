  1449	def test_unclosed_html_comment_never_suggested_for_deletion(tmp_path):
  1450	    """⛔ round-3 自审 B3-1: `<!--` 没等到 `-->` 就到文件尾时, 哪些内容被注释吞掉
  1451	    是引擎猜不了的 —— 不得据此判「空骨架 → 建议删」, 更不得给出
  1452	    「标题 0 行、代码围栏 0 行」这种与肉眼可见内容矛盾的假依据。"""
  1453	    vault, out = base_vault(tmp_path)
  1454	    inbox = vault / "_待处理"
  1455	    mk(
  1456	        inbox / "注释未闭合.md",
  1457	        "<!-- 说明: 粘贴时忘了闭合\n```python\n# keep\n这段正文其实存在\n",
  1458	        age_days=5,
  1459	    )
  1460	    # 正向对照: 闭合注释的空骨架 → 仍 C3 建议删 (护栏不误伤存量判据)
  1461	    mk(inbox / "闭合注释骨架.md", "---\ntitle: t\n---\n\n# 标题\n\n<!-- 注释 -->\n", age_days=4)
  1462	
  1463	    assert run_cli(vault, out).returncode == 0
  1464	    data = load_json(out)
  1465	    it = item_by_name(data, "注释未闭合.md")
  1466	    assert it["verdict"] != "建议删", f"未闭合注释的文件被建议删了: {it['basis']}"
  1467	    assert it["criterion"] == "C6_undecided"
  1468	    assert "其余皆空行" not in it["basis"], f"假依据: {it['basis']}"
  1469	    skeleton = item_by_name(data, "闭合注释骨架.md")
  1470	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1471	    assert skeleton["verdict"] == "建议删"
