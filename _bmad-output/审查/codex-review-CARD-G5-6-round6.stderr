   214	
   215	def run_gate(gate: str) -> subprocess.CompletedProcess:
   216	    return subprocess.run(
   217	        [
   218	            str(WT / "backend/.venv/bin/pytest"),
   219	            f"{TESTFILE}::{gate}",
   220	            "-q",
   221	            "-p",
   222	            "no:cacheprovider",
   223	        ],
   224	        cwd=WT / "backend",
   225	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   226	        capture_output=True,
   227	        text=True,
   228	    )
   229	
   230	
   231	def main() -> int:
   232	    pristine = SCRIPT.read_bytes()
   233	    BACKUP.write_bytes(pristine)
   234	    results = []
   235	    ok = True
   236	    for name, old, new, gate in MUTATIONS:
   237	        content = SCRIPT.read_text(encoding="utf-8")
   238	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   239	        mutated = content.replace(old, new, 1)
   240	        if name.startswith("M7"):
   241	            m7b_old = "url_bearing_keys = [k for k, v in fm.items() if v and _looks_like_source_value(v)]"
   242	            assert m7b_old in mutated, "M7: 信号③b 原串不在场"
   243	            mutated = mutated.replace(m7b_old, "url_bearing_keys = []", 1)
   244	        if name.startswith("M5"):
   245	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   246	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   247	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   248	            mutated = mutated.replace(looks_old, looks_rev, 1)
   249	        assert mutated != content, f"{name}: 替换后内容未变化"
