    91	+def test_fence_close_requires_same_char_min_length_and_bare_fence(tmp_path):
    92	+    """⛔ B3 回归: 关闭围栏 = 同字符 且 长度 ≥ 开启长度 且 围栏后仅空白
    93	+    (CommonMark 4.5)。
    94	+
    95	+    原实现只比字符: ```` 里的 ``` 被当关闭、``` 后带 info string 的行也被当关闭,
    96	+    围栏内容 `# keep` 落到围栏外被 `_HEADING_RE` 剥掉 → 整份文件被误判成
    97	+    空骨架 → 建议删。
    98	+    """
    99	+    vault, out = base_vault(tmp_path)
   100	+    inbox = vault / "_待处理"
   101	+    mk(inbox / "四反引号.md", "````\n```\n# keep\n````\n", age_days=9)
   102	+    mk(inbox / "四波浪线.md", "~~~~\n~~~\n# keep\n~~~~\n", age_days=8)
   103	+    # CommonMark: 关闭围栏不得带 info string → ```python 是围栏内容, 不是关闭
   104	+    mk(inbox / "关闭带infostring.md", "```\n```python\n# keep\n```\n", age_days=7)
   105	+    # 同字符子句: ``` 围栏里的 ~~~ 行是内容, 不是关闭 (删掉同字符判断即翻红)
   106	+    mk(inbox / "混合字符.md", "```\n~~~\n# keep\n```\n", age_days=6)
   107	+    # 制表符缩进不构成围栏 (CommonMark: ≥4 列是缩进代码块); \t``` 不得提前关闭 ——
   108	+    # ⛔ 语料不得带正文行: 有正文行时「提前关闭」也杀不死断言, 变异会存活
   109	+    mk(inbox / "tab关闭围栏.md", "```\n\t```\n# 标题\n", age_days=5)
   110	+    # 围栏内容行哪怕每行都长得像围栏标记, 也是实质正文 (Markdown 围栏语法速查)
   111	+    mk(
   112	+        inbox / "围栏速查.md",
   113	+        "# Markdown 围栏语法速查\n\n## 空围栏怎么写\n\n````\n```\n```\n~~~\n~~~\n````\n",
   114	+        age_days=4,
   115	+    )
   116	+    # 正向对照: 只有围栏无内容 → 仍是空骨架; 正常围栏包着注释 → 仍非空骨架
   117	+    mk(inbox / "只有围栏.md", "````\n````\n", age_days=2)
   118	+    mk(inbox / "正常围栏.md", "```\n# keep\n```\n", age_days=1)
   119	+
   120	+    assert run_cli(vault, out).returncode == 0
   121	+    data = load_json(out)
   122	+    for name in (
   123	+        "四反引号.md",
   124	+        "四波浪线.md",
   125	+        "关闭带infostring.md",
   126	+        "混合字符.md",
   127	+        "tab关闭围栏.md",
   128	+        "围栏速查.md",
   129	+    ):
   130	+        it = item_by_name(data, name)
   131	+        assert it["criterion"] != "C3_empty_or_skeleton", f"{name} 的围栏内容被剥掉了"
   132	+        assert it["verdict"] != "建议删", name
   133	+    only = item_by_name(data, "只有围栏.md")
   134	+    assert only["criterion"] == "C3_empty_or_skeleton"
   135	+    assert only["verdict"] == "建议删"
   136	+    normal = item_by_name(data, "正常围栏.md")
   137	+    assert normal["criterion"] != "C3_empty_or_skeleton"
   138	+    assert normal["verdict"] != "建议删"
