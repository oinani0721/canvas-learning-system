   545	def test_within_batch_dup_does_not_block_c4_when_corpus_canonical_exists(tmp_path):
   546	    """⛔ MEDIUM 回归: 批内还有同稿, 不影响「库内已有一份」这条独立证据。
   547	    原实现无条件否决 C4, 两件都掉进 C6 —— 明明有依据却说没有。"""
   548	    vault, out = base_vault(tmp_path)
   549	    body = "库内已经存着的一段正文。\n第二行。\n"
   550	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   551	    mk(vault / "_待处理" / "甲.md", body, age_days=3)
   552	    mk(vault / "_待处理" / "乙.md", body, age_days=2)
   553	
   554	    assert run_cli(vault, out).returncode == 0
   555	    for it in load_json(out)["items"]:
   556	        assert it["criterion"] == "C4_exact_duplicate"
   557	        assert it["exact_duplicate_of"] == "节点/库内正本.md"
   558	        assert any(c["kind"] == "duplicate_within_batch" for c in it["conflicts"])
