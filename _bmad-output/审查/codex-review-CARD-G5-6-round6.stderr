   490	+def test_unparsed_source_with_duplicate_body_is_not_suggested_for_deletion(tmp_path):
   491	+    """⛔ round-4 BLOCKER-2: 非标准 source × 正文与库内逐字重复 → 不得建议删。
   492	+
   493	+    C4 只证明「剥掉 frontmatter 后正文相等」, 不证明「整个文件多余」—— 这份
   494	+    还带着一个独有的来源声明(冒号后无空格, 键正则不认)。来源信息必须在建议里
   495	+    摆到台面上; 摆不出来就不许删。护栏拦在 C4 出口, 降 C6 且重复证据留痕。"""
   496	+    vault, out = base_vault(tmp_path)
   497	+    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
   498	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   499	+    mk(
   500	+        vault / "_待处理" / "带来源重复.md",
   501	+        "---\ntitle: 剪藏\nsource:https://unique.example/a\n---\n" + body,
   502	+        age_days=3,
   503	+    )
   504	+    # 正向对照: 无 source 的重复件 → 仍 C4 建议删 (护栏不得误伤存量判据)
   505	+    mk(vault / "_待处理" / "无来源重复.md", body, age_days=2)
   506	+    # 带普通元数据键的重复件 → 仍 C4 建议删, 但元数据必须挂冲突留痕
   507	+    mk(
   508	+        vault / "_待处理" / "带标签重复.md",
   509	+        "---\ntags: [剪藏, 待整理]\n---\n" + body,
   510	+        age_days=1,
   511	+    )
   512	+
   513	+    assert run_cli(vault, out).returncode == 0
   514	+    data = load_json(out)
   515	+    it = item_by_name(data, "带来源重复.md")
   516	+    assert it["verdict"] != "建议删", f"带来源的重复件被建议删了: {it['basis']}"
   517	+    assert it["criterion"] == "C6_undecided"
   518	+    assert it["confident"] is False
   519	+    assert it["target_hint"] is None and it["nomination_type"] is None
   520	+    assert it["exact_duplicate_of"] == "节点/库内正本.md", "重复证据必须留痕"
   521	+    assert any(c["kind"] == "exact_duplicate_under_other_verdict" for c in it["conflicts"]), "重复证据必须挂冲突留痕"
   522	+    assert "unique.example" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
   523	+    dup = item_by_name(data, "无来源重复.md")
   524	+    assert dup["criterion"] == "C4_exact_duplicate"
   525	+    assert dup["verdict"] == "建议删"
   526	+    tagged = item_by_name(data, "带标签重复.md")
   527	+    assert tagged["criterion"] == "C4_exact_duplicate"
   528	+    assert tagged["verdict"] == "建议删"
   529	+    assert any(c["kind"] == "frontmatter_metadata_present" for c in tagged["conflicts"]), (
   530	+        "C4 删除前 frontmatter 元数据必须留痕"
