   777	
   778	    before = snapshot(vault)
   779	    assert run_cli(vault, out).returncode == 0
   780	    after = snapshot(vault)
   781	    assert before == after, "只读引擎修改了 vault 树"
   782	    assert products(out)[0].exists() and products(out)[1].exists()
