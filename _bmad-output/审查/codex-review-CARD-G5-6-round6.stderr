   414	def test_duplicate_within_batch_is_flagged_not_deleted(tmp_path):
   415	    """批内两件逐字相同: 谁是正本不可判 → 只挂冲突, 不产出建议删。"""
   416	    vault, out = base_vault(tmp_path)
   417	    body = "# 同稿\n\n一模一样的正文内容。\n第二行。\n"
   418	    mk(vault / "_待处理" / "甲.md", body, age_days=3)
   419	    mk(vault / "_待处理" / "乙.md", body, age_days=2)
   420	
   421	    assert run_cli(vault, out).returncode == 0
   422	    data = load_json(out)
   423	    for it in data["items"]:
   424	        assert it["verdict"] != "建议删"
   425	        assert any(c["kind"] == "duplicate_within_batch" for c in it["conflicts"])
