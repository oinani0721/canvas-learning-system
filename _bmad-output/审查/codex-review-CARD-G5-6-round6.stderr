   729	# ───────────────────────────── 扫描 ─────────────────────────────
   730	
   731	
   732	def read_text_or_none(p: Path) -> str | None:
   733	    try:
   734	        return p.read_bytes().decode("utf-8")
   735	    except (OSError, UnicodeDecodeError):
   736	        return None
   737	
   738	
   739	def scan_corpus(
   740	    vault: Path, excluded_roots: list[str]
   741	) -> tuple[dict[str, list[str]], list[tuple[str, str]], dict]:
   742	    """库内 .md 语料：→ (归一化正文 → [相对路径…], [(路径, 正文)…], 统计)。
   743	
   744	    排除：一切隐藏目录、`outputs/`、收件箱子树、产物目录子树。
   745	    ⛔ **空正文不进重复索引** —— 否则库内任意两个空骨架互为「正本」，会撑出一条
   746	    有后果的建议删，其证据是「两个都是空的」。C3 虽然先命中，但索引本身必须先干净：
   747	    门要防的是未来次序调整时的静默失效，不只是当下这一次。
   748	    """
   749	    by_body: dict[str, list[str]] = {}
   750	    bodies: list[tuple[str, str]] = []
   751	    stats = {
   752	        "files_scanned": 0,
   753	        "files_indexed": 0,
   754	        "skipped_empty_body": 0,
   755	        "skipped_symlink": 0,
   756	        "skipped_unreadable": 0,
   757	        "truncated": False,
   758	        "file_cap": CORPUS_FILE_CAP,
   759	    }
   760	    for dirpath, dirnames, filenames in os.walk(vault):
   761	        dirnames[:] = sorted(
   762	            d
   763	            for d in dirnames
   764	            if not d.startswith(".")
   765	            and d not in CORPUS_EXCLUDED_DIR_NAMES
   766	            and os.path.realpath(os.path.join(dirpath, d)) not in excluded_roots
   767	        )
   768	        for fn in sorted(filenames):
   769	            if not fn.endswith(".md"):
   770	                continue
   771	            if stats["files_scanned"] >= CORPUS_FILE_CAP:
   772	                # ⛔ 不在此处 return —— 早退会绕过下面的排序尾巴, 让"截断"与"未截断"
   773	                # 两条路径产出形态不同的索引。置位后跳出全部循环, 走同一个出口。
   774	                stats["truncated"] = True
   775	                dirnames.clear()
   776	                break
   777	            p = Path(dirpath) / fn
   778	            stats["files_scanned"] += 1
   779	            if p.is_symlink():
   780	                stats["skipped_symlink"] += 1
   781	                continue
   782	            text = read_text_or_none(p)
   783	            if text is None:
   784	                stats["skipped_unreadable"] += 1
   785	                continue
   786	            if not has_substantive_content(text):
   787	                stats["skipped_empty_body"] += 1
   788	                continue
   789	            body = dup_body(text)
   790	            if not body:
   791	                stats["skipped_empty_body"] += 1
   792	                continue
   793	            rel = p.relative_to(vault).as_posix()
   794	            by_body.setdefault(body, []).append(rel)
   795	            bodies.append((rel, body))
   796	            stats["files_indexed"] += 1
   797	        if stats["truncated"]:
   798	            break
   799	    for v in by_body.values():
   800	        v.sort()
   801	    bodies.sort()
   802	    return by_body, bodies, stats
   803	
   804	
   805	def near_duplicates(
   806	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
   807	) -> list[dict]:
   808	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
   809	    if not body:
   810	        return []
   811	    a_lines = body.split("\n")
   812	    la = len(body)
   813	    hits: list[tuple[float, str]] = []
   814	    for rel, other in corpus_bodies:
   815	        if other == body:
   816	            continue  # 逐字相等归 C4，不重复计入疑似
   817	        lb = len(other)
   818	        if la > NEAR_DUP_BODY_CHAR_CAP or lb > NEAR_DUP_BODY_CHAR_CAP:
   819	            scan["skipped_oversize"] += 1
   820	            continue
   821	        if not (1 / NEAR_DUP_LEN_RATIO <= (lb / la if la else 0) <= NEAR_DUP_LEN_RATIO):
   822	            scan["skipped_length_prefilter"] += 1
   823	            continue
   824	        scan["compared_pairs"] += 1
   825	        sm = difflib.SequenceMatcher(None, a_lines, other.split("\n"), autojunk=False)
   826	        if sm.real_quick_ratio() < NEAR_DUP_RATIO or sm.quick_ratio() < NEAR_DUP_RATIO:
   827	            continue
   828	        r = sm.ratio()
   829	        if r >= NEAR_DUP_RATIO:
   830	            hits.append((r, rel))
   831	    hits.sort(key=lambda x: (-x[0], x[1]))
   832	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
   833	
   834	
   835	# ───────────────────────── 逐份提名（判据次序即本函数结构） ─────────────────────────
   836	
   837	
   838	def nominate(
   839	    item: dict,
   840	    text: str | None,
   841	    dup_index: dict[str, list[str]],
   842	    corpus_bodies: list[tuple[str, str]],
   843	    scan: dict,
   844	    batch_body_counts: dict[str, int],
   845	) -> dict:
   846	    """对一件材料出提名。**次序即 CRITERIA_ORDER**，先命中者定 verdict；
   847	    后续判据的证据仍全量附上（conflicts / exact_duplicate_of / near_duplicates）。"""
   848	    name = item["name"]
   849	    conflicts: list[dict] = []
   850	
   851	    if text is None:
   852	        # 非 UTF-8（PDF/图片等）：除 0 字节外无任何可机械判读的信号 → 不猜。
   853	        if item["size_bytes"] == 0:
   854	            return _fill(
   855	                item,
   856	                "C3_empty_or_skeleton",
   857	                V_DELETE,
   858	                None,
   859	                None,
   860	                "0 字节空文件",
   861	                True,
   862	                conflicts=conflicts,
   863	            )
   864	        return _fill(
   865	            item,
   866	            "C6_undecided",
   867	            V_UNSURE,
   868	            None,
   869	            None,
   870	            "非 UTF-8 文本，本引擎不解析其正文",
   871	            False,
   872	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
   873	            ask=UNDECIDED_ASK,
   874	            conflicts=conflicts,
   875	        )
   876	
   877	    fm_lines = split_frontmatter(text)[0]
   878	    fm = frontmatter_map(fm_lines)
   879	    typed_rows, unclosed_comment = _classify_lines_typed(text)
   880	    del typed_rows
   881	    substantive = has_substantive_content(text)
   882	    body = dup_body(text) if substantive else ""
   883	    rnd = round_of(name)
   884	    # C3 护栏信号（显式偏差 15）：frontmatter 里「看着像键但不被键正则认」的行。
   885	    unparsed_fm = [
   886	        ln.strip()
   887	        for ln in fm_lines
   888	        if ln.strip() and not ln.strip().startswith("#") and not _FM_KEY_RE.match(ln)
   889	    ]
   890	    # 未消化信号之四：边界规则拒掉的 AI 自述嫌疑（裸子串在场即算，见 raw_ai_marker）。
   891	    ai_suspect = raw_ai_marker(text)
   892	
   893	    # ── 后置证据（不参与次序，但必须全量呈现） ──
   894	    exact_all = sorted(dup_index.get(body, [])) if body else []
   895	    exact_of = exact_all[0] if exact_all else None
   896	    exact_others = exact_all[1:]
   897	    near = near_duplicates(body, corpus_bodies, scan)
   898	    within_batch = bool(body) and batch_body_counts.get(body, 0) > 1
   899	    if within_batch:
   900	        conflicts.append(

