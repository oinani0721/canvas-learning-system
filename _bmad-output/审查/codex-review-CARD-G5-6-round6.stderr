  1159	    exact_others: list[str] | None = None,
  1160	    near: list[dict] | None = None,
  1161	    conflicts: list[dict] | None = None,
  1162	) -> dict:
  1163	    out = dict(item)
  1164	    out.update(
  1165	        {
  1166	            "criterion": criterion,
  1167	            "verdict": verdict,
  1168	            "nomination_type": ntype,
  1169	            "target_hint": target,
  1170	            "basis": basis,
  1171	            "confident": confident,
  1172	            "type_uncertain": type_uncertain,
  1173	            "uncertain_reason": uncertain_reason,
  1174	            "ask": ask,
  1175	            "exact_duplicate_of": exact_of,
  1176	            "exact_duplicate_others": exact_others or [],
  1177	            "near_duplicates": near or [],
  1178	            "conflicts": conflicts or [],
  1179	        }
  1180	    )
  1181	    return out
