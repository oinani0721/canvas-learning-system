  1462	def render_md(d: dict) -> str:
  1463	    L: list[str] = []
  1464	    L.append(f"# 待处理盘点 preview · {d['label']}")
  1465	    L.append("")
  1466	    L.append(f"> {d['not_executed_disclaimer']}")
  1467	    L.append(
  1468	        f"> 基准时刻 `--now`：{d['now_local']}（Asia/Shanghai）· schema v{d['schema_version']}"
  1469	    )
  1470	    L.append("")
  1471	    L.append("## 一、回执")
  1472	    L.append("")
  1473	    L.append(d["receipt"])
  1474	    L.append("")
  1475	    L.append(f"- 上次清仓：**不可得** —— {d['last_cleanup_note']}")
  1476	    c = d["corpus"]
  1477	    L.append(
  1478	        f"- 语料库：扫描 {c['files_scanned']} 份 .md，进重复索引 {c['files_indexed']} 份"
  1479	        f"（空正文 {c['skipped_empty_body']} 份不进索引 · symlink {c['skipped_symlink']} · "
  1480	        f"不可读 {c['skipped_unreadable']}）"
  1481	        + (
  1482	            "　⚠️ **已达扫描上限被截断**，「无重复」仅代表已扫部分"
  1483	            if c["truncated"]
  1484	            else ""
  1485	        )
  1486	    )
  1487	    L.append("")
  1488	
  1489	    L.append(f"## 二、本批提名（{len(d['items'])} 件，最旧优先）")
  1490	    L.append("")
  1491	    if not d["items"]:
  1492	        L.append("_（本批无材料）_")
  1493	    else:
  1494	        L.append("| # | 文件 | 年龄 | 建议去向 | 提名类型 | 判据 | 依据 | 冲突 |")
  1495	        L.append("|---|---|---|---|---|---|---|---|")
  1496	        for it in d["items"]:
  1497	            conflict = (
  1498	                "；".join(f"{x['kind']}" for x in it["conflicts"])
  1499	                if it["conflicts"]
  1500	                else "—"
  1501	            )
  1502	            target = f"（→ {it['target_hint']}）" if it["target_hint"] else ""
  1503	            L.append(
  1504	                "| {i} | {n} | {a} 天 | {v}{t} | {ty} | {c} | {b} | {cf} |".format(
  1505	                    i=it["index"],
  1506	                    n=md_cell(it["name"]),
  1507	                    a=it["age_days"],
  1508	                    v=md_cell(it["verdict"]),
  1509	                    t=md_cell(target),
  1510	                    ty=md_cell(it["nomination_type"] or "—"),
  1511	                    c=md_cell(it["criterion"]),
  1512	                    b=md_cell(it["basis"]),
  1513	                    cf=md_cell(conflict),
  1514	                )
  1515	            )
  1516	    L.append("")
  1517	
  1518	    unsure = [it for it in d["items"] if not it["confident"]]
  1519	    L.append(f"## 三、拿不准（{len(unsure)} 件 · 需你一句话）")
  1520	    L.append("")
  1521	    if not unsure:
  1522	        L.append("_（本批无拿不准条目）_")
  1523	    else:
  1524	        for it in unsure:
  1525	            L.append(f"- **{it['index']}. {it['name']}** —— {it['uncertain_reason']}")
  1526	            L.append(f"  - 请回一句：{it['ask']}")
  1527	    L.append("")
  1528	
  1529	    dups = [
  1530	        it for it in d["items"] if it["exact_duplicate_of"] or it["near_duplicates"]
  1531	    ]
  1532	    L.append("## 四、重复线索")
  1533	    L.append("")
  1534	    if not dups:
  1535	        L.append("_（本批未发现逐字重复或疑似高相似）_")
  1536	    else:
  1537	        for it in dups:
  1538	            if it["exact_duplicate_of"]:
  1539	                if it["exact_duplicate_others"]:
  1540	                    # ⛔ basis 已声明「哪一份算正本不可判」—— 人读 MD 不得再钦定
  1541	                    # 「正本 `字典序首项`」（round-2 H4：JSON 与 MD 自相矛盾）。
  1542	                    # 路径**不加反引号**：路径本身含反引号时 code span 会错配吃掉
  1543	                    # 字符，渲染出一个不存在的文件名（round-3 自审 H4-1）。
  1544	                    all_dups = [
  1545	                        it["exact_duplicate_of"],
  1546	                        *it["exact_duplicate_others"],
  1547	                    ]
  1548	                    L.append(
  1549	                        f"- **{it['name']}** · 与库内 {len(all_dups)} 份文件"
  1550	                        "逐字相同："
  1551	                        + "、".join(p.replace("`", "\\`") for p in all_dups)
  1552	                        + " —— 哪一份是正本不可判"
  1553	                        "（exact_duplicate_of 仅为字典序代表）"
  1554	                    )
  1555	                else:
  1556	                    L.append(
  1557	                        f"- **{it['name']}** · 逐字相同 → 正本 "
  1558	                        f"`{it['exact_duplicate_of'].replace(chr(96), chr(92) + chr(96))}`"
  1559	                    )
  1560	            for n in it["near_duplicates"]:
  1561	                L.append(
  1562	                    f"- **{it['name']}** · 疑似（ratio {n['ratio']}）→ `{n['path']}`"
  1563	                    "　— 疑似不等于重复，**不建议删**，需你确认"
  1564	                )
  1565	    s = d["near_dup_scan"]
  1566	    L.append("")
  1567	    L.append(
  1568	        f"> 近似比对：阈值 {s['ratio_threshold']}，实比 {s['compared_pairs']} 对；"
  1569	        f"因体积跳过 {s['skipped_oversize']} 对、因长度差跳过 {s['skipped_length_prefilter']} 对。"
  1570	        f"{s['note']}"
  1571	    )
  1572	    L.append("")
  1573	
  1574	    sl = d["sleeping"]
  1575	    L.append(f"## 五、Sleeping 台账（{sl['count']} 件）")
  1576	    L.append("")
  1577	    if not sl["items"]:
  1578	        L.append("_（Sleeping/ 未建立或为空）_")
  1579	    else:
  1580	        L.append("| 文件 | 睡了几天 | 起算依据 | 满 30 天 |")
  1581	        L.append("|---|---|---|---|")
  1582	        for x in sl["items"]:
  1583	            L.append(
  1584	                f"| {md_cell(x['name'])} | {x['slept_days']} | {md_cell(x['slept_at_source'])} "
  1585	                f"| {'⚠️ 是' if x['over_30d'] else '否'} |"
  1586	            )
  1587	    L.append("")
  1588	
  1589	    dfr = d["inventory"]["deferred"]
  1590	    L.append(f"## 六、本批之外（{len(dfr)} 件，本次不提名）")
  1591	    L.append("")
  1592	    if not dfr:
  1593	        L.append("_（无积压）_")
  1594	    else:
  1595	        for x in dfr:
  1596	            L.append(f"- {x['name']}（{x['age_days']} 天 · {x['mtime_local']}）")
  1597	    skp = d["inventory"]["skipped"]
  1598	    if skp:
  1599	        L.append("")
  1600	        L.append("**跳过留痕**（不静默消失）：")
  1601	        for x in skp:
  1602	            L.append(f"- {x['name']} —— {x['reason']}")
  1603	    L.append("")
  1604	
  1605	    L.append("## 七、引擎边界（如实声明）")
  1606	    L.append("")
  1607	    v = d["verdict_vocabulary"]
  1608	    L.append(f"- 引擎可达去向：{'、'.join(v['reachable_by_engine'])}")
  1609	    L.append(f"- **恒不产出**：{'、'.join(v['human_only'])} —— {v['human_only_note']}")
  1610	    L.append(
  1611	        "- 近似重复（difflib）**永不**产出建议删：只有归一化正文逐字相等才建议删；"
  1612	        "库内只有一份同正文时给正本路径，多份同正文时给出全部候选并声明"
  1613	        "「哪一份是正本不可判」。"
  1614	    )
  1615	    L.append(
  1616	        "- 建议删有两个出口（空骨架 / 正文重复），共用一组护栏（如实声明）："
  1617	        "在来源链接与 AI 自述都未确定命中时，文件若以未闭合注释结尾、frontmatter"
  1618	        " 含解析不了的行、有 source 声明、或文头有疑似 AI 自述 —— 空骨架不判、"
  1619	        "重复也不建议删，一律落「拿不准」把证据摆给你。"
  1620	    )
  1621	    L.append(
  1622	        "- AI 自述标记为字面量 + 右边界规则（汉字收尾标记后须为行尾/空白/有限标点"
  1623	        "表，英文收尾标记后须为行尾/表中标点），仍不做语义否定检测：语义否定"
  1624	        "（「这不是由 AI 生成」）与满足边界的话题提及仍可能给出归档提名 —— 依据"
  1625	        "带行号与逐字片段，请逐条核对后再拍板；漏判方向在其余判据也不命中时落"
  1626	        "「拿不准」。"
  1627	    )
  1628	    L.append(f"- 判据次序（先命中者定去向）：{' → '.join(d['criteria_order'])}")
  1629	    L.append("")
  1630	    return "\n".join(L) + "\n"
