  1272	    for entry in entries:
  1273	        # ⛔ 与收件箱同一条纪律：跳过必须留痕，不静默消失。
  1274	        if entry.is_symlink():
  1275	            skipped.append({"name": entry.name, "reason": "条目是 symlink，不跟随"})
