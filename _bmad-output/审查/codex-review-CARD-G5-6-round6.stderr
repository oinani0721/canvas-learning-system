   849	def test_reject_overlong_product_name(tmp_path):
   850	    """255B 预检必须先于 out-dir 创建 —— 否则「拒绝但已留空目录」。"""
   851	    vault, out = base_vault(tmp_path)
   852	    # 240 字节（80 个三字节汉字）——单组件在 APFS/ext4 上都建得出来, 但产物名
   853	    # `inbox-preview-` + 240 + `.json` = 259 字节越界。⛔ 原先用 540 字节的目录名,
   854	    # 在 ext4 那种 255 **字节**上限的文件系统上 mkdir 自己就会失败, 测试根本走不到
   855	    # 被测守卫（Codex MEDIUM 的可移植性问题；本机 APFS 按字符计所以侥幸能跑）。
   856	    long_dir = vault / ("超" * 80)
   857	    long_dir.mkdir()
   858	    r = run_cli(vault, out, "--inbox-dir", str(long_dir))
   859	    assert r.returncode != 0
   860	    assert no_products(out)

