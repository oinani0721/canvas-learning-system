  1187	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1188	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1189	    items: list[dict] = []
  1190	    skipped: list[dict] = []
  1191	    with os.scandir(inbox) as it:
  1192	        entries = sorted(it, key=lambda e: e.name)
  1193	    for entry in entries:
  1194	        p = Path(entry.path)
  1195	        if entry.is_symlink():
  1196	            skipped.append(
  1197	                {
  1198	                    "name": entry.name,
  1199	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1200	                }
  1201	            )
  1202	            continue
  1203	        if entry.is_dir():
  1204	            if entry.name == SLEEPING_DIR_NAME:
  1205	                continue  # 走 Sleeping 台账
  1206	            skipped.append(
  1207	                {
  1208	                    "name": entry.name,
  1209	                    "reason": "子目录不在本卡盘点范围（只盘点顶层文件与 Sleeping/ 台账）",
  1210	                }
  1211	            )
  1212	            continue
  1213	        if not entry.is_file():
  1214	            # FIFO / 设备 / 套接字：read_bytes 可能直接阻塞，绝不碰
  1215	            skipped.append(
  1216	                {
  1217	                    "name": entry.name,
  1218	                    "reason": "不是普通文件（FIFO / 设备 / 套接字等），不读取",
  1219	                }
  1220	            )
  1221	            continue
  1222	        try:
  1223	            st = p.stat()
  1224	        except OSError as e:
  1225	            # 扫目录与取属性之间材料被移走 —— 跳过留痕, 不让一次竞态崩掉整份 preview
  1226	            skipped.append(
  1227	                {
  1228	                    "name": entry.name,
  1229	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1230	                }
  1231	            )
  1232	            continue
  1233	        items.append(
  1234	            {
  1235	                "stable_id": compute_inbox_stable_id(
  1236	                    f"{nfc(inbox.name)}/{nfc(entry.name)}"
  1237	                ),
  1238	                "name": entry.name,
  1239	                "rel_path": f"{inbox.name}/{entry.name}",
  1240	                "size_bytes": st.st_size,
  1241	                "mtime_utc": fmt_utc(st.st_mtime),
  1242	                "mtime_local": fmt_local(st.st_mtime),
  1243	                "age_days": days_between(now_s, st.st_mtime),
  1244	                # 排序用纳秒整数（float 秒会把相差 1ns 的两件折叠成相等，
  1245	                # 于是"最旧优先"退化成按文件名 —— Codex LOW 实证）
  1246	                "_mtime_ns": st.st_mtime_ns,
  1247	                "_path": str(p),
  1248	            }
  1249	        )
  1250	    # 最旧优先；同 mtime 按名字升序 —— 二跑同序的唯一保证
  1251	    items.sort(key=lambda d: (d["_mtime_ns"], d["name"]))
  1252	    return items, skipped
