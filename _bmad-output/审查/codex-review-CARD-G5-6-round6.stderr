   211	+    # 正向对照: 行尾/标点/加粗收尾仍命中, 依据带行号与逐字片段
   212	+    mk(
   213	+        inbox / "行尾自述.md",
   214	+        "# 报告甲\n\n> 本文由 AI 生成\n\n自述正文一。\n自述正文二。\n",
   215	+        age_days=4,
