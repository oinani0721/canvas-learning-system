   372	class TestSecondLevelFallback:
   373	    def test_fallback_also_failing_still_keeps_200(self, client: TestClient, mock_rag_service: MagicMock):
   374	        """一级 (inner) 与二级 (fallback) 同时坏掉, 响应仍不变。
   375	
   376	        ⚠️ 二级用**模块属性 patch** 而非类级 patch: ``_FALLBACK_LOGGER`` 本身是
   377	        ``logging.Logger`` 实例, 类级 patch 会连它一起打掉, 于是分不清"二级被走
   378	        到了"还是"一级就短路了"。分层后 ``fallback.warning.call_count`` 是二级
   379	        路径被走到的**独立证据**。
   380	        """
   381	        fallback = MagicMock()
   382	        fallback.warning.side_effect = RuntimeError("logging backend is also dead")
   383	
   384	        with (
   385	            _kill("info") as primary_spy,
   386	            patch.object(nothrow_logging, "_FALLBACK_LOGGER", fallback),
   387	        ):
   388	            response = client.get("/api/v1/rag/weak-concepts/数学/离散数学.canvas")
   389	
   390	        assert response.status_code == 200, "二级兜底失效 —— 日志后端全坏时业务被带崩"
   391	        assert mock_rag_service.get_weak_concepts.await_count == 1
   392	        assert primary_spy.call_count >= 1, "一级注入没生效"
   393	        assert fallback.warning.call_count >= 1, (
   394	            "二级降级路径**没被走到** —— 这条门在测一个不存在的场景 (一级若提前短路, 前面的断言照样全过)"
   395	        )
   396	
   397	    def test_fallback_line_carries_diagnostic_context(self, client: TestClient, mock_rag_service: MagicMock):
   398	        """降级那条日志必须能定位到"哪个 logger 的哪个方法为什么坏了"。
   399	
   400	        否则"吞掉异常"就变成了"把故障藏起来"。
   401	        (Codex round-1 LOW-3: 必须**单条** rendered line 同时含三项 —— join 后
   402	        分别搜的话, 三条各带一项的残缺日志也能拼过。)
   403	        """
   404	        fallback = MagicMock()
   405	
   406	        with _kill("info"), patch.object(nothrow_logging, "_FALLBACK_LOGGER", fallback):
   407	            client.get("/api/v1/rag/weak-concepts/数学/离散数学.canvas")
   408	
   409	        assert fallback.warning.call_count >= 1
   410	        rendered = [
   411	            call.args[0] % tuple(call.args[1:]) if len(call.args) > 1 else call.args[0]
   412	            for call in fallback.warning.call_args_list
   413	        ]
   414	        complete = [
   415	            line for line in rendered if "app.api.v1.endpoints.rag" in line and "'info'" in line and SINK_DEAD in line
   416	        ]
   417	        assert complete, f"没有一条降级行同时带 logger 名 + 方法名 + 原始异常 —— 诊断上下文被拆散了。实得: {rendered}"
   418	
