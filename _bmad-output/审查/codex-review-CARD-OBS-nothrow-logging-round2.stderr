    51	"""
    52	
    53	import logging
    54	from typing import Any, Union
    55	
    56	# 二级降级的落点。模块级缓存而非每次 ``logging.getLogger()`` 现取: 现取会去
    57	# 抢 ``logging._lock``, 而本函数恰恰运行在"日志系统刚出过事"的路径上。
    58	# 也是测试缝 —— 用例可 patch 本模块属性来单独验证二级路径确实被走到
    59	# (见 tests/api/v1/endpoints/test_nothrow_logging_api.py 的分层断言)。
    60	_FALLBACK_LOGGER = logging.getLogger("app.nothrow.fallback")
