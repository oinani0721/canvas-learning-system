     1	# Canvas Learning System - Logging Configuration
     2	# [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#基础设施层]
     3	"""
     4	Logging configuration for the Canvas Learning System backend.
     5	
     6	This module provides a unified configuration entry point for both structlog
     7	and stdlib `logging`. The bridge ensures:
     8	
     9	1. structlog logs flow through stdlib's logging pipeline so pytest's
    10	   `caplog` fixture can capture them.
    11	2. stdlib `logging.getLogger()` records also get JSON-formatted output
    12	   via `ProcessorFormatter.foreign_pre_chain`.
    13	3. `request_id` from `structlog.contextvars` is available on every record
    14	   (no separate filter needed; `merge_contextvars` is in both chains).
    15	
    16	[Source: ADR-010 - Logging聚合策略]
    17	[Source: openspec/changes/fix-structlog-caplog-compat — Task 1]
    18	[Source: Context7 /websites/structlog_en_stable — ProcessorFormatter pattern]
    19	"""
    20	
    21	import io
    22	import logging
    23	import sys
    24	from typing import Optional
    25	
    26	import structlog
    27	
    28	
    29	def configure_logging(level: int = logging.INFO) -> None:
    30	    """
    31	    Configure unified structlog + stdlib logging with bidirectional bridge.
    32	
    33	    This is the canonical logging entry point. It is idempotent — subsequent
    34	    calls return immediately without re-installing handlers.
    35	
    36	    The bridge works in two directions:
    37	    - structlog → stdlib: `structlog.stdlib.LoggerFactory()` causes
    38	      `structlog.get_logger()` to return loggers that delegate to stdlib's
    39	      `logging.Logger`. The final structlog processor `wrap_for_formatter`
    40	      packs the event dict so `ProcessorFormatter` can render it later.
    41	    - stdlib → structlog: `foreign_pre_chain` runs structlog processors
    42	      (timestamper, log level, contextvars) on records emitted by direct
    43	      `logging.getLogger()` callers.
    44	
    45	    Args:
    46	        level: stdlib logging level (e.g. ``logging.INFO``, ``logging.DEBUG``).
    47	
    48	    [Source: Context7 /websites/structlog_en_stable - ProcessorFormatter]
    49	    """
    50	    if getattr(configure_logging, "_configured", False):
    51	        return
    52	
    53	    _configure_structlog()
    54	    _configure_stdlib_handler(level)
    55	
    56	    # Reduce noise from third-party libraries
    57	    logging.getLogger("uvicorn.access").setLevel(logging.WARNING)
    58	    logging.getLogger("httpx").setLevel(logging.WARNING)
    59	    logging.getLogger("httpcore").setLevel(logging.WARNING)
    60	
    61	    # Reconfigure Uvicorn handlers to use the same UTF-8 stdout we wired up.
    62	    # [Source: Story 12.J.1 - Uvicorn handler reconfiguration]
    63	    root_handlers = logging.getLogger().handlers
    64	    if root_handlers:
    65	        primary_stream = root_handlers[0].stream  # type: ignore[attr-defined]
    66	        for logger_name in ["uvicorn", "uvicorn.error", "uvicorn.access"]:
    67	            uv_logger = logging.getLogger(logger_name)
    68	            for handler in uv_logger.handlers[:]:
    69	                if isinstance(handler, logging.StreamHandler):
    70	                    handler.stream = primary_stream
    71	
    72	    configure_logging._configured = True  # type: ignore[attr-defined]
    73	
    74	
    75	def _shared_processors() -> list:
    76	    """structlog processors run for BOTH structlog-native and foreign records.
    77	
    78	    These run before any renderer:
    79	    - merge_contextvars: pulls request_id (and other ContextVars) into the dict
    80	    - add_logger_name: includes the logger name (typically __name__)
    81	    - add_log_level: adds level as a string field
    82	    - TimeStamper: ISO 8601 timestamp
    83	    """
    84	    return [
    85	        structlog.contextvars.merge_contextvars,
    86	        structlog.stdlib.add_logger_name,
    87	        structlog.stdlib.add_log_level,
    88	        structlog.processors.TimeStamper(fmt="iso"),
    89	    ]
    90	
    91	
    92	def _configure_structlog() -> None:
    93	    """Configure structlog to bridge through stdlib's logging.
    94	
    95	    `wrap_for_formatter` MUST be the final processor — it packs the event
    96	    dict so the downstream `ProcessorFormatter` can render it as JSON.
    97	    """
    98	    structlog.configure(
    99	        processors=[
   100	            *_shared_processors(),
   101	            structlog.stdlib.PositionalArgumentsFormatter(),
   102	            structlog.processors.StackInfoRenderer(),
   103	            structlog.processors.format_exc_info,
   104	            structlog.processors.UnicodeDecoder(),
   105	            # Last processor — packs event_dict for ProcessorFormatter.
   106	            structlog.stdlib.ProcessorFormatter.wrap_for_formatter,
   107	        ],
   108	        wrapper_class=structlog.stdlib.BoundLogger,
   109	        context_class=dict,
   110	        logger_factory=structlog.stdlib.LoggerFactory(),
   111	        cache_logger_on_first_use=True,
   112	    )
   113	
   114	
   115	def _configure_stdlib_handler(level: int) -> None:
   116	    """Install root stdlib handler with `ProcessorFormatter` for JSON output.
   117	
   118	    UTF-8 wrapping for stdout/stderr is preserved from Story 12.I.1 / 12.J.1
   119	    so emoji and Unicode characters do not crash on Windows GBK terminals.
   120	    """
   121	    # UTF-8 wrapping for stdout (Story 12.I.1)
   122	    utf8_stdout = io.TextIOWrapper(
   123	        sys.stdout.buffer, encoding="utf-8", errors="replace", line_buffering=True
   124	    )
   125	
   126	    formatter = structlog.stdlib.ProcessorFormatter(
   127	        # Run shared processors on records that did NOT originate from structlog.
   128	        foreign_pre_chain=_shared_processors(),
   129	        # Run on ALL records after the pre_chain is done.
   130	        processors=[
   131	            structlog.stdlib.ProcessorFormatter.remove_processors_meta,
   132	            structlog.processors.JSONRenderer(),
   133	        ],
   134	    )
   135	
   136	    handler = logging.StreamHandler(utf8_stdout)
   137	    handler.setFormatter(formatter)
   138	    handler.setLevel(level)
   139	
   140	    root_logger = logging.getLogger()

