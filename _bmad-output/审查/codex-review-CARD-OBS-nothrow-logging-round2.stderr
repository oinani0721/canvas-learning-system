   268	    )
   269	    def test_error_log_failure_keeps_status_and_detail(
   270	        self,
   271	        client: TestClient,
   272	        mock_rag_service: MagicMock,
   273	        exc_type,
   274	        expected_status: int,
   275	        needle: str,
   276	    ):
   277	        mock_rag_service.query.side_effect = exc_type("upstream is down")
   278	
   279	        with _kill("error") as spy:
   280	            response = client.post("/api/v1/rag/query", json=_QUERY_BODY)
   281	
   282	        assert response.status_code == expected_status, f"日志抛错把 {expected_status} 打成了 {response.status_code}"
   283	        # 未包装时异常逃出 except → 裸 500 是 text/plain, response.json() 会
   284	        # 炸 JSONDecodeError —— 先断 content-type, 让失败原因停在可读的
   285	        # AssertionError 上 (负控靠失败消息里的关键字核原因)。
   286	        content_type = response.headers.get("content-type", "")
   287	        assert content_type.startswith("application/json"), (
   288	            f"detail 文案丢失 —— {expected_status} 被打成了裸 "
   289	            f"{response.status_code} Internal Server Error (content-type={content_type!r})"
   290	        )
   291	        assert response.json()["detail"] == "upstream is down", "detail 文案丢失"
   292	        assert spy.call_count >= 1 and _ours(spy, needle)
