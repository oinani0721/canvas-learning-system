    61	# ─────────────────────────────────────────────────────────────────────────────
    62	# AST 判定原语
    63	# ─────────────────────────────────────────────────────────────────────────────
    64	
    65	
    66	def _alias_table(tree: ast.Module) -> Set[str]:
    67	    """本文件里指向 nothrow 的本地别名。
    68	
    69	    Codex round-1 LOW-8: 只认 **from app.core.nothrow_logging import nothrow**
    70	    (module 尾段匹配) —— 名字恰好叫 nothrow 的其它来源 (第三方、本地 helper)
    71	    不能作为"已包装"的证据。
    72	    """
    73	    names: Set[str] = set()
    74	    for node in ast.walk(tree):
    75	        if isinstance(node, ast.ImportFrom):
    76	            mod = node.module or ""
    77	            if mod == "app.core.nothrow_logging" or mod.endswith(".nothrow_logging"):
    78	                for alias in node.names:
    79	                    if alias.name == "nothrow":
    80	                        names.add(alias.asname or alias.name)
    81	    return names
    82	
    83	
    84	def _local_nothrow_shadows(tree: ast.Module) -> List[Tuple[str, int]]:
    85	    """本文件里自定义的 nothrow 名字 (def nothrow / nothrow = ...) —— 假包装源。
    86	
    87	    Codex round-1 LOW-8: 本地 ``def nothrow(x): return x`` 会让裸 Logger 在
    88	    AST 形态上与真包装逐字相同。检出即整文件判 SUSPECT (不可信), 不判已包装。
    89	    """
    90	    out: List[Tuple[str, int]] = []
    91	    for node in ast.walk(tree):
    92	        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == "nothrow":
    93	            out.append(("def", node.lineno))
    94	        elif isinstance(node, ast.Assign):
    95	            for t in node.targets:
    96	                if isinstance(t, ast.Name) and t.id == "nothrow":
    97	                    out.append(("assign", node.lineno))
    98	    return out
    99	
   100	
   101	def _is_call_named(node: ast.AST, names: Set[str], attr: Optional[str] = None) -> bool:
   102	    """nothrow(...) / obs.nothrow(...) / getLogger(...) 形态判定。
   103	
   104	    ``attr`` 给定时只认 ``.attr`` 尾名 (Attribute 形态) 或裸名 (Name 形态)。
   105	    """
   106	    if not isinstance(node, ast.Call):
   107	        return False
   108	    func = node.func
   109	    if isinstance(func, ast.Name):
   110	        return func.id in names and (attr is None or func.id == attr)
   111	    if isinstance(func, ast.Attribute):
   112	        return func.attr in names and (attr is None or func.attr == attr)
   113	    return False
   114	
   115	
   116	def _is_nothrow_call(node: ast.AST, aliases: Set[str]) -> bool:
   117	    return _is_call_named(node, aliases)
   118	
   119	
   120	def _is_getlogger_call(node: ast.AST) -> bool:
   121	    return _is_call_named(node, {"getLogger", "get_logger"})
   122	
   123	
   124	def _is_structlog_call(node: ast.AST) -> bool:
   125	    """structlog.get_logger(...) / structlog.stdlib.get_logger(...)。"""
   126	    if not isinstance(node, ast.Call):
   127	        return False
   128	    func = node.func
   129	    return isinstance(func, ast.Attribute) and func.attr == "get_logger"
   130	
   131	
   132	def _module_stmts(tree: ast.Module) -> List[ast.stmt]:
   133	    """模块级语句, 下探一层 Try/If 的 body (rollback.py 有 try-import 先例),
   134	    但不进 FunctionDef/ClassDef。"""
   135	    out: List[ast.stmt] = []
   136	    stack = list(tree.body)
   137	    while stack:
   138	        node = stack.pop(0)
   139	        out.append(node)
   140	        if isinstance(node, ast.Try):
   141	            stack.extend(node.body + node.orelse + [n for h in node.handlers for n in h.body])
   142	        elif isinstance(node, ast.If):
   143	            stack.extend(node.body + node.orelse)
   144	    return out
   145	
   146	
   147	class Binding:
   148	    def __init__(self, name, lineno, source, kind, wrapped):
   149	        self.name = name
   150	        self.lineno = lineno
   151	        self.source = source
   152	        self.kind = kind  # stdlib | structlog
   153	        self.wrapped = wrapped
   154	
   155	
   156	def _bindings(tree: ast.Module, lines: List[str], aliases: Set[str]) -> List[Binding]:
   157	    out = []
   158	    for node in _module_stmts(tree):
   159	        value = None
   160	        targets = []
   161	        if isinstance(node, ast.Assign):
   162	            value, targets = node.value, node.targets
   163	        elif isinstance(node, ast.AnnAssign) and node.value is not None:
   164	            value, targets = node.value, [node.target]
   165	        if value is None:
   166	            continue
   167	        nothrow_call = _is_nothrow_call(value, aliases)
   168	        getlogger = _is_getlogger_call(value)
   169	        structlog = _is_structlog_call(value)
   170	        if not (nothrow_call or getlogger or structlog):
   171	            continue
   172	        kind = "structlog" if structlog else "stdlib"
   173	        for target in targets:
   174	            if isinstance(target, ast.Name):
   175	                src = lines[node.lineno - 1].strip() if node.lineno <= len(lines) else ""
   176	                out.append(Binding(target.id, node.lineno, src, kind, nothrow_call))
   177	    return out
   178	
   179	
   180	def _imported_logger_names(tree: ast.Module) -> List[Tuple[str, int]]:
   181	    """函数体内 import 进来的 logger (包装状态在别的文件 → EXTERNAL)。"""
   182	    out = []
   183	    for node in ast.walk(tree):
   184	        if isinstance(node, ast.ImportFrom):
   185	            for alias in node.names:
   186	                if "logger" in alias.name.lower():
   187	                    out.append((alias.asname or alias.name, node.lineno))
   188	    return out
   189	
   190	
   191	class Call:
   192	    def __init__(self, lineno, method, fstring, func, snippet, receiver):
   193	        self.lineno = lineno
   194	        self.method = method
   195	        self.fstring = fstring
   196	        self.func = func
   197	        self.snippet = snippet
   198	        self.receiver = receiver
   199	
   200	
   201	def _spans(tree: ast.Module) -> List[Tuple[int, int, str]]:
   202	    return [
   203	        (n.lineno, getattr(n, "end_lineno", n.lineno), n.name)
   204	        for n in ast.walk(tree)
   205	        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
   206	    ]
   207	
   208	
   209	def _enclosing(spans, lineno):
   210	    best = None
   211	    for s, e, name in spans:
   212	        if s <= lineno <= e and (best is None or s > best[0]):
   213	            best = (s, e, name)
   214	    return best[2] if best else "<module>"
   215	
   216	
   217	def _calls(
   218	    tree: ast.Module,
   219	    bound_names: Set[str],
   220	    lines: List[str],
   220	    lines: List[str],
   221	    spans,
   222	    external_names: Optional[Set[str]] = None,
   223	) -> List[Call]:
   224	    external_names = external_names or set()
   225	    out = []
   226	    for node in ast.walk(tree):
   227	        if not isinstance(node, ast.Call):
   228	            continue
   229	        func = node.func
   230	        if not isinstance(func, ast.Attribute) or func.attr not in LOG_METHODS:
   231	            continue
   232	        base = func.value
   233	        receiver = None
   234	        if isinstance(base, ast.Name) and base.id in bound_names:
   235	            receiver = base.id
   236	        elif isinstance(base, ast.Name) and base.id in external_names:
   237	            receiver = f"<external:{base.id}>"
   238	        elif isinstance(base, ast.Name) and base.id == "logging":
   239	            # Codex round-1 LOW-8: 根模块便捷调用 logging.error("boom") ——
   240	            # 无变量可寻址, 模块级包装罩不住, 单列计数。
   241	            receiver = "<root-logging>"
   242	        elif isinstance(base, ast.Call) and _is_getlogger_call(base):
   243	            receiver = "<inline-getLogger>"
   244	        if receiver is None:
   245	            continue
   246	        first = None
   247	        if node.args:
   248	            idx = 1 if (func.attr == "log" and len(node.args) > 1) else 0
   249	            first = node.args[idx]
   250	        is_f = isinstance(first, ast.JoinedStr)
   251	        snippet = lines[node.lineno - 1].strip() if node.lineno <= len(lines) else ""
   252	        out.append(Call(node.lineno, func.attr, is_f, _enclosing(spans, node.lineno), snippet, receiver))
   253	    return out
   254	
   255	
   256	def _parse(path: Path):
   257	    try:
   258	        text = path.read_text(encoding="utf-8")
   259	    except (OSError, UnicodeDecodeError):
   260	        return None, []
   261	    try:
   262	        return ast.parse(text), text.splitlines()
   263	    except SyntaxError:
   264	        return None, text.splitlines()
   265	
   266	
   267	# ─────────────────────────────────────────────────────────────────────────────
   268	# 篡改自检 —— 防止"判定恒返回未包装"的坏门冒充工作
   269	# ─────────────────────────────────────────────────────────────────────────────
   270	
   271	
   272	def _self_check() -> None:
   273	    cases = [
   274	        (
   275	            "from app.core.nothrow_logging import nothrow\nlogger = nothrow(logging.getLogger(__name__))",
   276	            True,
   277	        ),
   278	        ("logger = logging.getLogger(__name__)", False),
   279	        ("from app.core.nothrow_logging import nothrow as _nt\nlogger = _nt(logging.getLogger(__name__))", True),
   280	        ("import structlog\nlogger = structlog.get_logger(__name__)", False),
   281	    ]
   282	    for src, expect_wrapped in cases:
   283	        tree = ast.parse(src)
   284	        aliases = _alias_table(tree)
   285	        bs = _bindings(tree, src.splitlines(), aliases)
   286	        got = bool(bs) and bs[0].wrapped
   287	        if got is not expect_wrapped:
   288	            print(
   289	                f"⛔ 自检失败: 判定函数对合成语料的结论与预期相反\n  语料: {src!r}\n  期望 wrapped={expect_wrapped}, 实得 {got}",
   290	                file=sys.stderr,
   291	            )
   292	            raise SystemExit(2)
   293	
   294	    # Codex round-1 LOW-8: 假包装 (本地 def nothrow 恒等函数 / 来源不对的
   295	    # import) 不得判已包装 —— 名字叫 nothrow 不等于包装。
   296	    suspect_cases = [
   297	        ("def nothrow(x):\n    return x\nlogger = nothrow(logging.getLogger(__name__))", False),
   298	        ("from some.other.mod import nothrow\nlogger = nothrow(logging.getLogger(__name__))", False),
   299	    ]
   300	    for src, expect_wrapped in suspect_cases:
   301	        tree = ast.parse(src)
   302	        aliases = _alias_table(tree)
   303	        bs = _bindings(tree, src.splitlines(), aliases)
   304	        got = bool(bs) and bs[0].wrapped
   305	        if got is not expect_wrapped:
   306	            print(
   307	                f"⛔ 假包装自检失败\n  语料: {src!r}\n  期望 wrapped={expect_wrapped}, 实得 {got}",
   308	                file=sys.stderr,
   309	            )
   310	            raise SystemExit(2)
   311	
   312	    # root-module 便捷调用 (logging.error('boom')) 必须被看见
   313	    tree = ast.parse("import logging\nlogging.error('boom')")
   314	    calls = _calls(tree, set(), ["", ""], _spans(tree))
   315	    if not any(c.receiver == "<root-logging>" for c in calls):
   316	        print("⛔ 根模块调用自检失败: logging.error('boom') 没被识别", file=sys.stderr)
   317	        raise SystemExit(2)
   318	
   319	    print("[self-check] 篡改自检 4/4 + 假包装 2/2 + 根模块调用 1/1 通过 — 判定函数不是恒 False 的坏门")
   320	
   321	
   322	def _structural_anchors(backend: Path, reports: Dict[str, dict]) -> None:
   323	    """结构验伪锚: 检不出已知存在的形态 = 判定函数有漏, 拒绝出报告。"""
   324	    bad = []
   325	    rb = reports.get("rollback.py")
   326	    if not rb or rb["inline_calls"] < 1:
   327	        bad.append("rollback.py 的匿名内联 getLogger 调用没被识别 (已知存在 1 处 :41)")
   328	    hp = reports.get("health.py")
   329	    if not hp or hp["external"] < 1:
   330	        bad.append("health.py 的 EXTERNAL logger (memory_logger) 没被识别")
   331	    if bad:
   332	        for b in bad:
   333	            print(f"⛔ 结构锚失败: {b}", file=sys.stderr)
   334	        raise SystemExit(2)
   335	    print("[self-check] 结构验伪锚 2/2 通过 — 内联/EXTERNAL 两类都能看见")
   336	
   337	
   338	# ─────────────────────────────────────────────────────────────────────────────
   339	# 扫描
   340	# ─────────────────────────────────────────────────────────────────────────────
   341	
   342	
   343	def scan_endpoints(backend: Path) -> Dict[str, dict]:
   344	    ep_dir = backend / "app" / "api" / "v1" / "endpoints"
   345	    result: Dict[str, dict] = {}
   346	    for path in sorted(ep_dir.glob("*.py")):
   347	        tree, lines = _parse(path)
   348	        if tree is None:
   349	            result[path.name] = {"error": "parse failed"}
   350	            continue
   351	        aliases = _alias_table(tree)
   352	        bindings = _bindings(tree, lines, aliases)
   353	        bound_names = {b.name for b in bindings}
   354	        spans = _spans(tree)
   355	        imported = _imported_logger_names(tree)
   356	        external_names = {n for n, _ in imported}
   357	        calls = _calls(tree, bound_names, lines, spans, external_names)
   358	        inline = [c for c in calls if c.receiver == "<inline-getLogger>"]
   359	        root_calls = [c for c in calls if c.receiver == "<root-logging>"]
   360	        ext_calls = [c for c in calls if c.receiver and c.receiver.startswith("<external:")]
   361	        shadows = _local_nothrow_shadows(tree)
   362	        stdlib_bs = [b for b in bindings if b.kind == "stdlib"]
   363	        structlog_bs = [b for b in bindings if b.kind == "structlog"]
   364	        module_calls = [c for c in calls if c.receiver in bound_names]
   365	        result[path.name] = {
   366	            "bindings": bindings,
   367	            "stdlib_bindings": stdlib_bs,
   368	            "structlog_bindings": structlog_bs,
   369	            "calls": module_calls,
   370	            "inline_calls": len(inline),
   371	            "root_calls": root_calls,
   372	            "shadows": shadows,
   373	            "external": len(imported),
   374	            "external_detail": imported,
   375	            "external_calls": ext_calls,
   376	            "fstring_calls": [c for c in module_calls if c.fstring],
   377	        }
   378	    return result
   379	
   380	
   381	def scan_handoff(backend: Path) -> List[dict]:
   382	    out = []
   383	    by_file: Dict[str, List[Tuple[str, str]]] = {}
   384	    for rel, fn, note in HANDOFF_ANCHORS:
   385	        by_file.setdefault(rel, []).append((fn, note))
   386	    for rel, anchors in by_file.items():
   387	        path = backend / rel
   388	        tree, lines = _parse(path)
   389	        if tree is None:
   390	            out.append({"file": rel, "func": "*", "error": "parse failed / missing"})
   391	            continue
   392	        aliases = _alias_table(tree)
   393	        bindings = _bindings(tree, lines, aliases)
   394	        names = {b.name for b in bindings}
   395	        spans = _spans(tree)
   396	        calls = _calls(tree, names, lines, spans)
   397	        module_wrapped = bool(bindings) and all(b.wrapped for b in bindings)
   398	        for fn, note in anchors:
   399	            hits = [c for c in calls if c.func == fn]
   400	            out.append(
   401	                {
   402	                    "file": rel,
   403	                    "func": fn,
   404	                    "note": note,
   405	                    "found": bool(hits),
   406	                    "module_wrapped": module_wrapped,
   407	                    "calls": hits,
   408	                }
   409	            )
   410	    return out
   411	
   412	
   413	# ─────────────────────────────────────────────────────────────────────────────
   414	# 报告
   415	# ─────────────────────────────────────────────────────────────────────────────
   416	
   417	
   418	def main() -> int:
   419	    parser = argparse.ArgumentParser(description=__doc__)
   420	    parser.add_argument("--backend", default=str(Path(__file__).resolve().parent.parent))
   421	    args = parser.parse_args()
   422	    backend = Path(args.backend).resolve()
   423	
   424	    _self_check()
   425	    eps = scan_endpoints(backend)
   426	    _structural_anchors(backend, eps)
   427	
   428	    print("=" * 78)
   429	    print("表一 · 端点层 logger 包装状态  (backend/app/api/v1/endpoints/*.py)")
   430	    print("=" * 78)
   431	    wrapped, unwrapped, notwrappable, dead, nolog, external_only, nobinding = [], [], [], [], [], [], []
   432	    total_calls = 0
   433	    total_fstring = 0
   434	    total_inline = 0
   435	    for name, info in eps.items():
   436	        if info.get("error"):
   437	            print(f"  !! {name}: {info['error']}")
   438	            continue
   439	        total_calls += len(info["calls"]) + info["inline_calls"] + len(info["external_calls"])
   440	        total_fstring += len(info["fstring_calls"]) + sum(1 for c in info["external_calls"] if c.fstring)
   441	        total_inline += info["inline_calls"]
   442	        has_calls = bool(info["calls"]) or info["inline_calls"] > 0
   443	        if info["external"] and not info["bindings"]:
   444	            external_only.append(name)
   445	            continue
   446	        if not info["bindings"]:
   447	            if has_calls:
   448	                nobinding.append(name)  # 无绑定但有调用 (如 rollback.py 的内联 getLogger)
   449	            else:
   450	                nolog.append(name)
   451	            continue
   452	        stdlib = info["stdlib_bindings"]
   453	        slog = info["structlog_bindings"]
   454	        if stdlib and all(b.wrapped for b in stdlib) and not slog:
   455	            wrapped.append(name)
   456	        elif slog and not stdlib:
   457	            notwrappable.append(name)
   458	        elif not has_calls:
   459	            dead.append(name)
   460	        else:
   460	        else:
   461	            unwrapped.append(name)
   462	
   463	    print(f"\n【已包装】{len(wrapped)} 个 —— 本卡承诺覆盖面")
   464	    for name in wrapped:
   465	        info = eps[name]
   466	        b = info["stdlib_bindings"][0]
   467	        print(f"  ✓ {name:28} :{b.lineno:<5} {b.source}")
   468	        print(f"      日志调用 {len(info['calls']):>3} 处 | f-string 首参 {len(info['fstring_calls'])} 处 (必须为 0)")
   469	        if info["root_calls"]:
   470	            print(f"      ⚠ 另有根模块便捷调用 {len(info['root_calls'])} 处 (logging.<level>, 包装罩不住)")
   471	        if info["shadows"]:
   472	            print(f"      ⚠ SUSPECT: 本文件自定义了 nothrow 名字 {info['shadows']} —— 已包装判定不可信")
   473	        for c in info["fstring_calls"]:
   474	            print(f"        ⚠ :{c.lineno} logger.{c.method}(f...)  in {c.func}()")
   475	
   476	    print(f"\n【未包装】{len(unwrapped)} 个 —— 本卡**不覆盖**, 如实登记")
   477	    for name in unwrapped:
   478	        info = eps[name]
   479	        b = info["bindings"][0]
   480	        note = " (绑定后 0 调用但有内联调用)" if not info["calls"] and info["inline_calls"] else ""
   481	        ext_note = ""
   482	        if info["external_calls"]:
   483	            rcv = info["external_calls"][0].receiver
   484	            ext_note = (
   485	                f" + EXTERNAL {rcv[1:-1].split(':')[1]} {len(info['external_calls'])} 处 (包装状态在别文件, 本表不判)"
   486	            )
   487	        print(
   488	            f"  ✗ {name:28} :{b.lineno:<5} {b.kind:9} 日志调用 {len(info['calls']):>3} 处 (f-string {len(info['fstring_calls'])} 处, 内联 {info['inline_calls']}){note}{ext_note}"
   489	        )
   490	
   491	    print(f"\n【NOT-WRAPPABLE·structlog】{len(notwrappable)} 个 —— 本适配器技术不可包 (stacklevel 会泄进 JSON)")
   492	    for name in notwrappable:
   493	        info = eps[name]
   494	        b = info["structlog_bindings"][0]
   495	        print(
   496	            f"  S {name:28} :{b.lineno:<5} 日志调用 {len(info['calls']):>3} 处 (f-string {len(info['fstring_calls'])} 处)"
   497	        )
   498	
