   548	@rag_router.put(
   549	    "/config",
   550	    summary="更新 RAG 配置",
   551	    description="动态更新 RAG 管道配置，立即生效（无需重启）",
   552	    operation_id="update_rag_config",
   553	)
   554	async def update_rag_config(updates: dict) -> dict:
   555	    """
   556	    Story 2.11 AC-5: Update RAG config and persist to YAML file.
   557	    """
   558	    import os
   559	
   560	    try:
   561	        from agentic_rag.config import DEFAULT_CONFIG, validate_config
   562	
   563	        # Validate incoming updates against defaults
   564	        test_config = DEFAULT_CONFIG.copy()
   565	        test_config.update(updates)
   566	        validated = validate_config(test_config)
   567	
   568	        # Persist to YAML file
   569	        config_path = os.path.join(os.getcwd(), "config", "rag_config.yaml")
   570	        try:
   571	            import yaml
   572	
   573	            os.makedirs(os.path.dirname(config_path), exist_ok=True)
   574	
   575	            # Load existing file config
   576	            existing = {}
   577	            if os.path.isfile(config_path):
   578	                with open(config_path, "r", encoding="utf-8") as f:
   579	                    existing = yaml.safe_load(f) or {}
   580	
   581	            # Merge updates
   582	            existing.update(updates)
   583	
   584	            with open(config_path, "w", encoding="utf-8") as f:
   585	                yaml.dump(existing, f, default_flow_style=False, allow_unicode=True)
   586	
   587	            logger.info(
   588	                "[CONFIG] Updated %s params, persisted to %s",
   589	                len(updates),
   590	                config_path,
   591	            )
   592	        except ImportError:
   593	            logger.warning(
   594	                "[CONFIG] pyyaml not installed, config not persisted to file"
   595	            )
   596	
   597	        # Log changes
   598	        for param, value in updates.items():
   599	            old_val = DEFAULT_CONFIG.get(param, "N/A")
   600	            logger.info("[CONFIG] Updated %s: %s -> %s", param, old_val, value)
   601	
   602	        return {
   603	            "status": "ok",
   604	            "updated_keys": list(updates.keys()),
   605	            "config": dict(validated),
   606	        }
   607	
   608	    except Exception as e:
   609	        logger.error("Failed to update RAG config: %s", e)
   610	        raise HTTPException(status_code=400, detail=f"Config update failed: {e}") from e

