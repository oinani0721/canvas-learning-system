   166	def _kill(level: str):
   167	    """类级 patch (卡文指定的注入形态) + 调用方甄别。
   168	
   169	    为什么不是裸 ``side_effect=RuntimeError``: 实测 (2026-09-01) httpx 在每次
   170	    TestClient 请求完成后会调 ``logger.info("HTTP Request: ...")`` —— 纯类级
   171	    info patch 把**请求本身**炸掉, 测到的就成了 httpx 层的错误而不是端点行为。
   172	    所以 side_effect 先甄别调用方: 端点模块的调用抛错, 其余 (httpx/starlette)
   173	    放行返回 None (与 stdlib info 的返回值一致)。
   174	
   175	    "包装去掉后同一测试必红"仍然成立: M1/M2 变异把模块 logger 拆回裸 stdlib
   176	    Logger, 它仍在 ``logging.Logger`` 类上 —— 类级 patch 照样命中, 端点调用
   177	    照样抛错。
   178	
   179	    帧遍历的两个坑 (都实测踩过):
   180	    - 起点必须是 ``_getframe(1)`` (mock 内部帧) —— 不能经由辅助函数取帧, 辅助
   181	      函数自己的帧会变成"第一个调用方" (它住在测试模块里, 既不在穿越名单、
   182	      也不匹配 app.api 前缀 → killer 恒放行, 全部门假绿);
   183	    - 必须穿透 ``app.core.nothrow_logging``: 被包装链是 端点 → 包装器 →
   184	      inner.info(patched), 不穿透包装器帧的话 killer 永远看不见端点 (二级
   185	      fallback 门抓出: ``fallback.warning.call_count == 0``)。这与
   186	      ``_STACKLEVEL_OFFSET`` 是同一哲学 —— 包装器对调用点透明。
   187	    """
   188	
   189	    def _raiser(*args: Any, **kwargs: Any):
   190	        frame = sys._getframe(1)  # mock 内部帧 (跳过 _raiser 自己)
   191	        caller = "<unknown>"
   192	        while frame is not None:
   193	            mod = frame.f_globals.get("__name__", "")
   194	            if mod and not mod.startswith("unittest.mock") and mod != "logging" and mod != "app.core.nothrow_logging":
   195	                caller = mod
   196	                break
   197	            frame = frame.f_back
   198	        if caller.startswith("app.api.v1.endpoints"):
   199	            raise RuntimeError(SINK_DEAD)
   200	        return None
   201	
   202	    return patch.object(logging.Logger, level, side_effect=_raiser)
   203	
   204	
   205	def _ours(spy, needle: str) -> bool:
   206	    """spy 的调用里有没有**我们那一行**。
   207	
   208	    ``spy.call_count >= 1`` 单独用是弱门: 类级 patch 会捕获进程内所有 logger
   209	    的调用 (fastapi / httpx / asyncio 都可能在同一次请求里 log)。所以除了计数,
   210	    还要能指认出被测的那条消息。
   211	    """
   212	    for call in spy.call_args_list:
   213	        if call.args and isinstance(call.args[0], str) and needle in call.args[0]:
   214	            return True
   215	    return False
