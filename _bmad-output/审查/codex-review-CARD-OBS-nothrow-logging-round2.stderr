   424	
   425	class TestWrapperIsNotANoOp:
   426	    """上面所有门在"NoThrowLogger 实现成 pass"时**全绿**。
   427	
   428	    因为它们只断言"业务响应没被日志带崩" —— 一个什么都不记的 logger 当然不会
   429	    带崩任何东西。没有这一节, 本卡就等于用删掉日志功能来换取"日志不出错"。
   430	    """
   431	
   432	    def test_normal_path_still_emits_the_log_record(self, client: TestClient, caplog: pytest.LogCaptureFixture):
   433	        with caplog.at_level(logging.INFO, logger="app.api.v1.endpoints.rag"):
   434	            response = client.get("/api/v1/rag/weak-concepts/数学/离散数学.canvas")
   435	
   436	        assert response.status_code == 200
   437	        messages = [r.getMessage() for r in caplog.records]
   438	        assert any("Getting weak concepts for" in m for m in messages), (
   439	            f"包装后日志根本没写出来 —— 观测面被『保护』没了。实得: {messages}"
   440	        )
   441	        assert any("数学/离散数学.canvas" in m for m in messages), "惰性参数没被渲染进最终消息 —— %s 占位符和实参对不上"
   442	
   443	    def test_wrapper_is_frame_transparent(self, client: TestClient, caplog: pytest.LogCaptureFixture):
   444	        """调用点信息必须仍指向端点, 不是指向包装器自己。
   445	
   446	        锁的是 ``nothrow_logging._STACKLEVEL_OFFSET`` —— 它与 ``_guarded`` 的调用
   447	        深度强耦合, 谁改了包装层数不改这个常量, 这条门就红。
   448	        (生产 JSON 日志当前不含 filename/funcName, 见 ``app/core/logging.py``
   449	        无 ``CallsiteParameterAdder``; 但 caplog 与任何将来加上调用点字段的配置
   450	        看得见, 且"包装器对调用点透明"本身就是该有的性质。)
   451	        """
   452	        with caplog.at_level(logging.INFO, logger="app.api.v1.endpoints.rag"):
   453	            client.get("/api/v1/rag/weak-concepts/数学/离散数学.canvas")
   454	
   455	        ours = [r for r in caplog.records if "Getting weak concepts for" in r.getMessage()]
   456	        assert ours, "没抓到端点那条日志"
   457	        record = ours[0]
   458	        assert record.funcName == "get_weak_concepts", (
   459	            f"调用点漂移到了 {record.filename}:{record.funcName} —— "
   460	            "包装器把自己写成了日志来源 (_STACKLEVEL_OFFSET 失准)"
   461	        )
   462	        assert record.filename == "rag.py", f"调用点文件漂移: {record.filename}"
   463	
   464	    def test_stacklevel_none_does_not_propagate(self):
   465	        """Codex round-1 HIGH-1 的直接回归锁: 参数归一化必须发生在守护区内。
   466	
   467	        ``wrapped.info("x", stacklevel=None)`` 会让补偿算式 ``1 + None`` 抛
   468	        TypeError —— 补偿曾在 try 之外, 该错直接传播击穿 no-throw 承诺。
   469	        """
   470	        base = logging.getLogger("probe.stacklevel-none")
   471	        base.addHandler(logging.NullHandler())
   472	        wrapped = NoThrowLogger(base)
   473	
   474	        fallback = MagicMock()
   475	        with patch.object(nothrow_logging, "_FALLBACK_LOGGER", fallback):
   476	            try:
   477	                wrapped.info("x", stacklevel=None)  # type: ignore[arg-type]
   478	            except Exception as exc:  # noqa: BLE001 — 断言的就是不传播
   479	                pytest.fail(f"stacklevel=None 的 TypeError 传播了: {exc!r}")
   480	
   481	        assert fallback.warning.call_count == 1, "降级路径没被走到 —— 错被静默吞掉了"
   482	
   483	    def test_frame_transparent_for_log_level_path(self):
   484	        """``log(level, ...)`` 路径的帧透明 (Codex round-1 LOW-5)。
   485	
   486	        info 门只锁了 info; ``log()`` 与 ``exception()`` 共用同一 ``_guarded``,
   487	        offset 应一致 —— 这里把 ``log()`` 也钉住 (exception 路径需构造 except
   488	        块, 同构性由实现保证, 验收单 §五 第 9 条如实声明)。
   489	        """
   490	        records: list = []
   491	
   492	        class _Cap(logging.Handler):
   493	            def emit(self, record: logging.LogRecord) -> None:
   494	                records.append(record)
   495	
   496	        base = logging.getLogger("probe.frame-log")
   497	        base.setLevel(logging.DEBUG)
   498	        base.addHandler(_Cap())
   499	        base.propagate = False
   500	
   501	        def caller_function_for_frame_check():
   502	            nothrow_logging.nothrow(base).log(logging.INFO, "via log() %s", 1)
   503	
   504	        caller_function_for_frame_check()
   505	
   506	        assert records, "log() 路径没写出日志"
   507	        assert records[0].funcName == "caller_function_for_frame_check", f"log() 路径调用点漂移: {records[0].funcName}"
