   334	    def test_error_log_failure_keeps_structured_detail(
   335	        self,
   336	        client: TestClient,
   337	        mock_memory_service: MagicMock,
   338	        case_id: str,
   339	        path: str,
   340	        service_attr: str,
   341	        log_needle: str,
   342	        detail_prefix: str,
   343	    ):
   344	        """这三条的状态码**两种情况下都是 500** —— 区别全在 body。
   345	
   346	        没有包装时: logger.error 抛错逃出 except → Starlette 返回裸
   347	        ``Internal Server Error`` (text/plain), 客户端再也看不到"到底哪一步失败"。
   348	        有包装时: 500 的 detail 仍是端点自己写的结构化文案。
   349	        所以本门断的是 **detail**, 断状态码是不够的。
   350	        """
   351	        getattr(mock_memory_service, service_attr).side_effect = RuntimeError("neo4j exploded")
   352	
   353	        with _kill("error") as spy:
   354	            response = client.get(path)
   355	
   356	        assert response.status_code == 500
   357	        content_type = response.headers.get("content-type", "")
   358	        assert content_type.startswith("application/json"), (
   359	            f"detail 文案丢失 —— 结构化 500 被打成了裸 Internal Server Error (content-type={content_type!r})"
   360	        )
   361	        assert response.json()["detail"].startswith(detail_prefix), (
   362	            f"detail 文案丢失 —— 期望以 {detail_prefix!r} 开头, 实得 {response.json().get('detail')!r}"
   363	        )
   364	        assert spy.call_count >= 1 and _ours(spy, log_needle), "被注入的调用里没有端点那一行 —— 假门"
