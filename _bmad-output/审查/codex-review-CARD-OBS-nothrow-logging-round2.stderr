    51	    ("app/services/rag_service.py", "query", "G4-3 记 :274-287/:289-290/:326-333"),
    52	    ("app/core/vault_scope.py", "active_vault_aliases", "G4-3 记 :133"),
    53	    ("app/core/vault_scope.py", "resolve_vault_scope", "G4-3 记 :184-198"),
    54	    ("app/services/memory_service.py", "get_learning_history", "G4-3 记 :665-682/:748/:843-850"),
    55	    ("app/services/memory_service.py", "get_concept_score_history", "G4-3 记 :1080-1089"),
    56	    ("app/clients/neo4j_client.py", "_handle_merge_learning", "G4-3 记 :746"),
