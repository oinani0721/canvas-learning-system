     9	变异表 (卡文 (d) 指定 3 个):
    10	- M1 rag-nothrow-removed : rag.py 的模块级包装拆回裸 getLogger
    11	  → 指定门: /weak-concepts 入口日志注入 (预期 200 变 500)
    12	  → 原因必须含 "500" 或 "await_count" (卡文: 只核 nodeid 不核原因 = G4-3
    13	    round-5 MEDIUM-1 的教训 —— nodeid 红可能是 fixture 崩了, 不是门在工作)
    14	- M2 memory-nothrow-removed: memory.py 同型
    15	  → 指定门: memory episodes 端点注入 (预期结构化 detail 变裸 Internal Server Error)
    16	- M3 nothrow-except-deleted: NoThrowLogger._guarded 的 try/except 整体删除
    17	  (变成透明转发, 一二级降级全灭)
    18	  → 指定门: rag 入口 + rag 503 + memory episodes 三道全红
    19	
    20	形态照抄 g41b_mutation_negative_controls.py: 配料 count!=1 硬校验 (防配方
    21	漂移静默零命中)、tempdir 备份 + finally 逐字节还原 (filecmp shallow=False,
    22	shallow 会放过大小的同形损坏)、return 不进 finally (SyntaxWarning 教训)、
    23	baseline 必须全绿才开跑、skip 不算红、pytest 带 -rf + -p no:cacheprovider。
    24	
    25	本脚本相对 g41b 的两点不同 (如实声明):
    26	- 原因匹配 = 失败输出全文必须含预期关键字 —— g41b 只核 nodeid; 本卡卡文点名
    27	  要核原因。
    28	- 还原保证的是"回到**开跑时**的字节", 不是"回到 HEAD"。若开跑时工作树已有
    29	  未提交改动, 还原会原样保留它们 (脚本会先打印三文件的 porcelain 状态让运行
    30	  者看见)。进程被 SIGKILL 强杀时 try/finally 不执行 —— 这是本方案与生俱来
    31	  的边界, 验收单如实登记。
    32	"""
    33	
    34	import filecmp
    35	import shutil
    36	import subprocess
    37	import sys
    38	import tempfile
    39	from dataclasses import dataclass, field
    40	from pathlib import Path
    41	
    42	BACKEND = Path(__file__).resolve().parent.parent
    43	PYTEST = BACKEND / ".venv" / "bin" / "python"
    44	
    45	RAG_EP = BACKEND / "app" / "api" / "v1" / "endpoints" / "rag.py"
    46	MEM_EP = BACKEND / "app" / "api" / "v1" / "endpoints" / "memory.py"
    47	CORE = BACKEND / "app" / "core" / "nothrow_logging.py"
    48	TARGETS = (RAG_EP, MEM_EP, CORE)
    49	
    50	TEST_FILE = "tests/api/v1/endpoints/test_nothrow_logging_api.py"
    51	
    52	GATE_ENTRY_200 = f"{TEST_FILE}::TestWeakConceptsEntryLog::test_entry_log_failure_keeps_200_and_service_still_awaited"
    53	GATE_ENTRY_503 = f"{TEST_FILE}::TestWeakConceptsEntryLog::test_error_log_failure_keeps_structured_503"
    54	GATE_MEM_DETAIL = (
    55	    f"{TEST_FILE}::TestMemoryMainEndpointErrorLogs::test_error_log_failure_keeps_structured_detail[episodes]"
    56	)
    57	
    58	# 配料必须与落地后的源码逐字一致 (含注释与空白); count != 1 即拒跑。
    59	_RAG_WRAPPED_LINE = "logger = nothrow(logging.getLogger(__name__))"
    60	_RAG_UNWRAPPED_LINE = "logger = logging.getLogger(__name__)"
    61	
    62	_M3_OLD = """        try:
    63	            kwargs["stacklevel"] = kwargs.get("stacklevel", 1) + _STACKLEVEL_OFFSET
    64	            getattr(self.inner, method)(*args, **kwargs)
    65	        except Exception as exc:  # noqa: BLE001 — 观测面刻意兜底, 见模块 docstring
    66	            try:
    67	                _FALLBACK_LOGGER.warning(
    68	                    "nothrow: logger %r method %r raised during logging: %r",
    69	                    getattr(self.inner, "name", "<unknown>"),
    70	                    method,
    71	                    exc,
    72	                )
    73	            except Exception:  # noqa: BLE001 — 兜底的兜底: 日志后端整体坏死
    74	                pass
    75	"""
    76	_M3_NEW = """        kwargs["stacklevel"] = kwargs.get("stacklevel", 1) + _STACKLEVEL_OFFSET
    77	        getattr(self.inner, method)(*args, **kwargs)
    78	"""
    79	
    80	
    81	@dataclass
    82	class Mutation:
    83	    name: str
    84	    target: Path
    85	    edits: list  # [(old, new), ...]
    86	    expect_red_tests: list  # nodeid 整段匹配 (parametrize 尾巴也必须逐字一致)
    87	    reason_keywords: list = field(default_factory=list)
    88	    desc: str = ""
    89	
    90	
    91	MUTATIONS = [
    92	    Mutation(
    93	        name="M1-rag-nothrow-removed",
    94	        target=RAG_EP,
    95	        edits=[(_RAG_WRAPPED_LINE, _RAG_UNWRAPPED_LINE)],
    96	        expect_red_tests=[GATE_ENTRY_200],
    97	        reason_keywords=["500", "await_count"],
    98	        desc="/weak-concepts 入口日志注入在包装拆掉后必须红 (200→500)",
    99	    ),
   100	    Mutation(
   101	        name="M2-memory-nothrow-removed",
   102	        target=MEM_EP,
   103	        edits=[(_RAG_WRAPPED_LINE, _RAG_UNWRAPPED_LINE)],
   104	        expect_red_tests=[GATE_MEM_DETAIL],
   105	        reason_keywords=["500", "Internal Server Error"],
   106	        desc="memory episodes 注入在包装拆掉后必须红 (结构化 detail→裸 500)",
   107	    ),
   108	    Mutation(
   109	        name="M3-nothrow-except-deleted",
   110	        target=CORE,
   111	        edits=[(_M3_OLD, _M3_NEW)],
   112	        expect_red_tests=[GATE_ENTRY_200, GATE_ENTRY_503, GATE_MEM_DETAIL],
   113	        reason_keywords=["500"],
   114	        desc="except 删除 (透明转发) 后三道门全红",
   115	    ),
   116	]
   117	
   118	
   119	def _apply(text: str, edits) -> str:
   120	    for old, new in edits:
   121	        count = text.count(old)
   122	        if count != 1:
   123	            raise SystemExit(
   124	                f"变异原料失配: 期望恰 1 处命中, 实得 {count}\n---\n{old[:240]}\n---\n"
   125	                "(被测源码改过 ⇒ 请同步更新本脚本的变异原料, 否则负控是假的)"
   126	            )
   127	        text = text.replace(old, new)
   128	    return text
   129	
   130	
   131	def _run_pytest(selectors) -> tuple:
   132	    cmd = [
   133	        str(PYTEST),
   134	        "-m",
   135	        "pytest",
   136	        *selectors,
   137	        "-q",
   138	        "--no-header",
   139	        "-rf",
   140	        "--tb=short",
   141	        "-p",
   142	        "no:cacheprovider",
   143	        "-p",
   144	        "no:randomly",
   145	    ]
   146	    proc = subprocess.run(cmd, cwd=str(BACKEND), capture_output=True, text=True)
   147	    return proc.returncode, proc.stdout + proc.stderr
   148	
   149	
   150	def _failed_tests(out: str) -> list:
   151	    """从 -rf 短摘要取失败的 nodeid (只认 'FAILED ' 行)。
   152	
   153	    ⚠️ 本仓 pytest 9.0.2 的摘要行是 `FAILED <nodeid>` (实测 2026-09-01, 无
   154	    " - 原因" 段); 旧 pytest 是 `FAILED <nodeid> - <原因>`。两种格式都兼容:
   155	    有 " - " 取前面, 没有取整行。g41b 原版要求 " - " 必在, 在 pytest 9 上
   156	    会把每道门误判成"未红" (死门) —— 预验证 M2 抓出后修正。
   157	    """
   158	    failed = []
   159	    for line in out.splitlines():
   160	        if line.startswith("FAILED "):
   161	            failed.append(line[len("FAILED ") :].split(" - ", 1)[0].strip())
   162	    return failed
   163	
   164	
   165	def _test_matches(spec: str, nodeid: str) -> bool:
   166	    """整段匹配, 不用子串 —— 'test_foo' 不能被 'test_foo_bar' 满足 (g41b round-2)。"""
   167	    tail = nodeid.rsplit("::", 1)[-1]
   168	    spec_tail = spec.rsplit("::", 1)[-1]
   169	    if "[" in spec_tail:
   170	        return tail == spec_tail
   171	    return tail.split("[", 1)[0] == spec_tail
   172	
   173	
   174	def _summary(out: str) -> str:
   175	    for line in out.splitlines():
   176	        if line.startswith("=") and ("passed" in line or "failed" in line or "error" in line):
   177	            return line.strip()
   178	    return "(无摘要行)"
   179	
   180	
   181	def main() -> int:
   182	    if not PYTEST.exists():
   183	        print(f"⛔ 找不到 pytest: {PYTEST}", file=sys.stderr)
   184	        return 2
   185	
   186	    status = subprocess.run(
   187	        ["git", "status", "--porcelain", "--", *(str(t.relative_to(BACKEND.parent)) for t in TARGETS)],
   188	        cwd=str(BACKEND.parent),
   189	        capture_output=True,
   190	        text=True,
   191	    ).stdout
   192	    if status.strip():
   193	        print("⚠️ 开跑时目标文件已有未提交改动 (还原将保留这些改动, 不回 HEAD):")
   194	        print(status)
   195	
   196	    originals = {t: t.read_text() for t in TARGETS}
   197	
   198	    with tempfile.TemporaryDirectory() as tmp:
   199	        backups = {}
   200	        for t in TARGETS:
   201	            b = Path(tmp) / (t.name + ".orig")
   202	            b.write_text(originals[t])
   203	            backups[t] = b
   204	
   205	        # ── baseline: 指定门在未变异时必须全绿 ────────────────────────────
   206	        all_gates = sorted({nid for m in MUTATIONS for nid in m.expect_red_tests})
   207	        code, out = _run_pytest(all_gates)
   208	        print(f"[baseline] {_summary(out)}")
   209	        if code != 0:
   210	            print("⛔ 基线就不是全绿 — 先修好再跑负控", file=sys.stderr)
   211	            return 2
   212	        if " skipped" in out or "skipped," in out:
   213	            print("⚠️ 有 skip — skip 不构成『能红』证据", file=sys.stderr)
   214	
   215	        dead_gates = 0
   216	        for m in MUTATIONS:
   217	            print(f"\n=== {m.name}: {m.desc} ===")
   218	            m.target.write_text(_apply(originals[m.target], m.edits))
   219	            # 逐门单跑 + 逐门原因匹配 (Codex round-1 LOW-7): 多门合跑时对整份
   220	            # 输出做一次 any(keyword) 的话, 第一门的关键字能替其余门的"别的
   221	            # 原因失败"背书 —— 原因必须按门绑定。
   222	            per_gate = []
   223	            try:
   224	                for nid in m.expect_red_tests:
   225	                    code, out = _run_pytest([nid])
   226	                    failed = _failed_tests(out)
   227	                    red = code != 0 and " failed" in out and any(_test_matches(nid, x) for x in failed)
   228	                    summary = _summary(out)
   229	                    # 卡文口径: 失败原因含 "500" / "await_count" —— **任一**命中
   230	                    # (M1 下 await_count 断言排在状态码断言之后, 前者红了后者
   231	                    # 不会渲染; all 语义会把 M1 误判死门 —— 首跑实测)。
   232	                    reasons_ok = any(kw in out for kw in m.reason_keywords)
   233	                    per_gate.append((nid, red, reasons_ok, summary))
   234	            finally:
   235	                shutil.copyfile(backups[m.target], m.target)
   236	                restored_ok = filecmp.cmp(backups[m.target], m.target, shallow=False)
   237	            if not restored_ok:
   238	                print("⛔ 还原后字节不一致 — 立即人工检查!", file=sys.stderr)
   239	                return 3
   240	            # return 不放进 finally (g41a 教训: 会吞掉正在传播的异常)
   241	
   242	            bad = [nid for nid, red, rok, _s in per_gate if not (red and rok)]
   243	            if bad:
   244	                dead_gates += 1
   245	                for nid, red, rok, summary in per_gate:
   246	                    if not (red and rok):
   247	                        why = "没有以『测试失败』的方式变红" if not red else "失败原因不是预期的"
   248	                        print(f"⛔ 死门: {m.name} → {nid.rsplit('::', 1)[-1]} — {why}")
   249	                        print(f"   实得: {summary}")
   250	                continue
   251	            print(f"✓ {m.name}: 指定门全红且原因逐门匹配 | {per_gate[0][3]}")
   252	
   253	        print()
   254	        if dead_gates:
   255	            print(f"NEGATIVE-CONTROL: FAIL ({dead_gates} dead gates)", file=sys.stderr)
   256	            return 1
   257	        print(
   258	            "NEGATIVE-CONTROL: PASS (3 mutants each killed by named gates "
   259	            "with expected reason; restored byte-identical)"
   260	        )
   261	        return 0
   262	
   263	
   264	if __name__ == "__main__":
   265	    raise SystemExit(main())

