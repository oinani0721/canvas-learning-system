   721	def test_rest_to_due_reversal_pushes_second_time(tmp_path, monkeypatch, capsys):
   722	    """rest→due 放行一次: 早晨休息推送后, 盘中转出到期 → 第二推放行且与
   723	    首推同 id (服务端覆盖, 手机原地刷新); due 之后恒 skip-done (上界 2)。"""
   724	    vault = _vault(tmp_path, {"重学卡": _node(board="A板", extra="fsrs_due: 2026-07-30T06:00:00Z\n")})
   725	    calls = _push_harness(monkeypatch, tmp_path, vault, rcs=[0, 0])
   726	
   727	    out1 = _run_main(monkeypatch, capsys, vault, "2026-07-30T10:00:00+08:00")  # 02:00Z
   728	    assert "generate:new" in out1 and "push:accepted" in out1
   729	    assert runner.load_state()["last_push_kind"] == "rest"
   730	    assert calls[0][1] == "📚 今日无到期节点"
   731	
   732	    _pin_pool_older_than_payload(vault, BASE)
   733	    out2 = _run_main(monkeypatch, capsys, vault, "2026-07-30T14:05:00+08:00")  # 06:05Z 跨到期
   734	    assert "generate:new" in out2 and "push:accepted" in out2, (
   735	        "rest→due 语义反转必须放行第二推, 不得让手机整天停留「今日无到期」"
   736	    )
   737	    assert runner.load_state()["last_push_kind"] == "due"
   738	    assert len(calls) == 2 and calls[1][1] == "📚 今日复习 · A板"
   739	    assert calls[1][0] == calls[0][0], "两推必须同 id — 服务端覆盖而非堆叠"
   740	
   741	    _pin_pool_older_than_payload(vault, BASE)
   742	    out3 = _run_main(monkeypatch, capsys, vault, "2026-07-30T15:05:00+08:00")
   743	    assert "push:skip-done" in out3
   744	    assert len(calls) == 2, "due 之后不得再推 — 每天推送上界 = 2"
