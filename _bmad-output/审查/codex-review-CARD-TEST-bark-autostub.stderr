     1	#!/usr/bin/env python3
     2	"""CARD-TEST-bark-autostub 负控裁判 (A/B 串行双跑)。
     3	
     4	A (disarmed): --noconftest 卸下 _bark_egress_guard → 探针期望 PASS
     5	   (证明「去掉 fixture 就会真的尝试外发」, 外发被探针自装的 DNS 拦截器
     6	   挡住 — 任何情况下都不出网);
     7	B (armed): 正常 conftest → 探针期望 FAIL, 且失败必须是指定的那道断言
     8	   "AssertionError: Bark egress attempted in tests" (拒绝器) — 收集错误
     9	   或别的断言炸红不算数 (裁判核指定断言, 不是「有失败」)。
    10	
    11	exit 0 仅当 A=PASS 且 B=按预期 FAIL。两次 pytest 均为串行子进程,
    12	-p no:cacheprovider 防与并行 session 共享 .pytest_cache 踩踏。
    13	"""
    14	
    15	import subprocess
    16	import sys
    17	from pathlib import Path
    18	
    19	BACKEND = Path(__file__).resolve().parents[1]
    20	NODEID = "tests/regression/bark_egress_probe.py::test_probe"
    21	REFUSAL = "AssertionError: Bark egress attempted in tests"
    22	
    23	
    24	def _run(label: str, extra_args: list[str]) -> subprocess.CompletedProcess:
    25	    cmd = [sys.executable, "-m", "pytest", "-p", "no:cacheprovider", *extra_args, NODEID]
    26	    print(f"[{label}] $ {' '.join(cmd)}", flush=True)
    27	    proc = subprocess.run(
    28	        cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600
    29	    )
    30	    sys.stdout.write(proc.stdout)
    31	    sys.stderr.write(proc.stderr)
    32	    return proc
    33	
    34	
    35	def main() -> int:
    36	    a = _run("A/disarmed", ["--noconftest"])
    37	    # 核 "1 passed" 而非仅 rc==0 — rc==5 (未收集到任何测试) 也非 0, 但
    38	    # 「探针没被收集」≠「探针证明了外发」
    39	    a_pass = a.returncode == 0 and "1 passed" in a.stdout
    40	
    41	    b = _run("B/armed", [])
    42	    b_fail = b.returncode != 0 and "1 failed" in b.stdout and REFUSAL in b.stdout
    43	
    44	    print(f"A(disarmed): expect PASS         -> ok={a_pass} rc={a.returncode}")
    45	    print(f"B(armed):    expect FAIL/refusal -> ok={b_fail} rc={b.returncode}")
    46	    if a_pass and b_fail:
    47	        print(
    48	            "NEGATIVE-CONTROL: PASS "
    49	            "(armed=probe-FAILED-as-expected, disarmed=probe-PASSED-egress-attempted)"
    50	        )
    51	        return 0
    52	    print("NEGATIVE-CONTROL: FAIL")
    53	    return 1
    54	
    55	
    56	if __name__ == "__main__":
    57	    sys.exit(main())

