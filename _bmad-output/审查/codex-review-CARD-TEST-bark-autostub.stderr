   562	def test_migrate_dry_run_writes_nothing(tmp_path, monkeypatch, capsys):
   563	    backups = _old_state_fixture(tmp_path)
   564	    before = sorted(p.name for p in backups.iterdir())
   565	    rc = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups), "--dry-run"])
   566	    assert rc == 0
   567	    out = capsys.readouterr().out
   568	    assert "daily-review.state.json" in out and "daily-review.canvas-vault.state.json" in out
   569	    assert sorted(p.name for p in backups.iterdir()) == before, "dry-run 必须零写入"
   570	    # Codex-C1a B3: 字面零写含 __pycache__ — 模块必须已挂 bytecode 禁写防线
   571	    assert sys.dont_write_bytecode, "migrate 模块应设 sys.dont_write_bytecode"
   572	
