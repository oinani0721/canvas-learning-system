   555	def _run_migrate(monkeypatch, argv: list[str]) -> int:
   556	    import migrate_daily_review_state as migrate
   557	
   558	    monkeypatch.setattr(sys, "argv", ["migrate_daily_review_state.py", *argv])
   559	    return migrate.main()
