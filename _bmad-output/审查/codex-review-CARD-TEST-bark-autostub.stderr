   170	    def summary(self) -> Dict[str, Any]:
   171	        total = len(self.results)
   172	        passed_count = sum(1 for r in self.results if r["passed"])
   173	        failed_count = total - passed_count
   174	        pass_rate = (passed_count / total * 100) if total > 0 else 0.0
