   674	def test_migrate_preplanted_symlink_target_not_overwritten(tmp_path, monkeypatch):
   675	    """Codex-C1a F4/N1: 目标位置被预置成悬空 symlink (指向尚不存在的路径)
   676	    时, mkstemp+rename 发布只替换链接名本身 — 内容绝不被引到 symlink 指向
   677	    的位置落盘, 终点成为常规文件。"""
