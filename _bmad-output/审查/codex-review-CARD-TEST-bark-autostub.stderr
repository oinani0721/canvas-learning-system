   869	def test_structurally_corrupt_state_quarantined_not_crash(tmp_path, monkeypatch, capsys):
   870	    """Codex-D2b M1: 合法 JSON 但结构错型的 state (顶层 [] / 账本 []) 必须
   871	    与语法损坏同等对待 — 隔离重建不炸, 当轮照常生成+推送。已知代价 (如实
   872	    入档): 重建即丢当日推送账, 与既有语法损坏路径同级。"""
   873	    vault = _vault(tmp_path, {"甲": _node(board="A板")})
   874	    calls = _push_harness(monkeypatch, tmp_path, vault, rcs=[0, 0])
   875	    state = runner.state_path()
   876	    state.parent.mkdir(parents=True, exist_ok=True)
   877	
   878	    state.write_text("[]", encoding="utf-8")  # 顶层非 dict
   879	    out1 = _run_main(monkeypatch, capsys, vault, "2026-07-30T10:00:00+08:00")
   880	    assert "generate:new" in out1 and "push:accepted" in out1
   881	    assert runner.load_state()["last_push_kind"] == "due"
   882	    # Codex-D2b-r2 L2: 错型件必须隔离留档 (防「删 quarantine 直接吞档」回归)
   883	    assert list(state.parent.glob(state.name + ".corrupt-*")), "错型 state 必须隔离留档"
   884	
   885	    # 账本错型 (board_last_recommended 非 dict) 同样隔离重建
   886	    state.write_text(json.dumps({"schema_version": 1, "board_last_recommended": []}), encoding="utf-8")
   887	    out2 = _run_main(monkeypatch, capsys, vault, "2026-07-30T11:05:00+08:00")
   888	    assert "generate:new" in out2 and "push:accepted" in out2
   889	    assert len(calls) == 2
