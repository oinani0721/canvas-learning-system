    47	def _patch_runner(monkeypatch, vault, tmp_path):
    48	    """CARD-C1a: STATE/LOG 常量已函数化为 BACKUPS 派生 (state_path/log_line),
    49	    fixture 只注入 BACKUPS 一处 — 所有 state/log 写入随之进 tmp, 防写真实
    50	    backups/。逐用例检查: 本文件所有落盘路径均经 VAULT (tmp) 或 BACKUPS (tmp)。"""
    51	    monkeypatch.setattr(runner, "VAULT", vault)
    52	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
