   190	        st["board_last_recommended"][ranked[0]["board"]] = today
   191	        st["last_recommend_credit_date"] = today
   192	    save_state(st)
   193	    return payload, "new"
   194	
   195	
   196	def osascript_fallback(noti: dict) -> bool:
   197	    try:
   198	        r = subprocess.run(
   199	            ["/usr/bin/osascript", "-", noti["title"], noti["body"]],
   200	            input=APPLESCRIPT, text=True, capture_output=True, timeout=15,
   201	        )
   202	        return r.returncode == 0
   203	    except (OSError, subprocess.TimeoutExpired):
   204	        return False
   205	
   206	
   207	def main() -> int:
   208	    global VAULT
   209	    # allow_abbrev=False: push.sh 锁解析只认全称 --vault, argparse 缩写
   210	    # (--v) 会让锁与 runner 指向不同 vault (Codex-C1a F1) — 两侧必须同源
   211	    ap = argparse.ArgumentParser(description="每日复习推送编排", allow_abbrev=False)
   212	    ap.add_argument("--now", help="ISO 时间覆盖 (12 场景验收矩阵用)")
   213	    ap.add_argument("--vault", help="活 vault 路径 (wrapper 从 .env ACTIVE_VAULT 解析传入; 缺省回退 canvas-vault)")
   214	    args = ap.parse_args()
   215	
   216	    if args.vault:
   217	        VAULT = Path(args.vault)
   218	
   219	    now = _now(args.now)
   220	    local = now.astimezone()
   221	    today = local.date().isoformat()
   222	    st = load_state()
   223	
   224	    try:
   225	        payload, gen = ensure_payload(st, now, today)
   226	    except Exception as e:  # 生成失败 = 无保底, 唯一的非 0 退出
   227	        log_line(f"generate:FAILED err={type(e).__name__}:{str(e)[:120]}")
   228	        print(f"[runner] 生成失败: {e}", file=sys.stderr)
   229	        return 1
   230	
   231	    noti = (payload or {}).get("notification")
   232	    push, fallback = "-", "-"
   233	    if not noti:
   234	        push = "skip-empty"  # 无板可推 (全占位/空 vault): md 已如实落盘
   235	    elif st.get("last_push_accepted_date") == today and not (
   236	        st.get("last_push_kind") == "rest" and payload.get("top_boards")
   237	    ):
   238	        # CARD-D2b 方案甲: 当日已推但语义从 rest 反转为 due (休息推送后盘中
   239	        # 转出到期) 时放行一次二推 — 同 id 服务端覆盖 (A4 契约, 通知中心
   240	        # 不堆叠), due 落账后恒 skip-done → state 持久化成立时每日至多
   241	        # 2 次 accepted (accepted 后崩溃窗/损坏重建的 at-least-once 残余
   242	        # 与 A4/A7 既有语义同级, Codex-D2b H1/H2 如实入档)。旧 state 缺
   243	        # last_push_kind → 条件恒真 → 保守一日一推 (向后兼容)
   244	        push = "skip-done"
   245	    elif not (PUSH_WINDOW[0] <= local.time() < PUSH_WINDOW[1]):
   246	        push = "skip-window"  # RunAtLoad 早触发 / 21:00 后唤醒: 只落盘
   247	    else:
   248	        # vault_id 取 payload 顶层 (C1a 加性字段); 当日缓存若是迁移前生成的
   249	        # 旧 payload (无该字段), 回退当前 vault 目录名 — 两者必然同库
   250	        rc = send_bark.send(noti, payload.get("vault_id") or VAULT.resolve().name)
   251	        if rc == 0:
   252	            st["last_push_accepted_date"] = today
   253	            # CARD-D2b: 语义账只在 accepted 时落 — 失败保持原 kind, 反转门
   254	            # 敞开, 次小时 launchd 触发自然幂等重试。缺 top_boards 键的
   255	            # legacy 缓存 payload 语义未知 → 保守记 due (关反转门, Codex M2)
   256	            st["last_push_kind"] = "due" if payload.get("top_boards", True) else "rest"
   257	            st["last_result"], st["last_error"] = "pushed", ""
   258	            save_state(st)
   259	            push = "accepted"
   260	        else:
   261	            push = "skip-nokey" if rc == 2 else "failed"
   262	            if rc != 2:
   263	                st["last_result"] = "generated_push_failed"
   264	                st["last_error"] = "bark-send"
   265	            # 本地兜底每日一次 (Code-Review L1 去重门); 无 key 也提醒一条
   266	            # (Code-Review H1: key 配好前不能一切静默)
   267	            if st.get("last_local_notify_date") != today:
   268	                local_noti = noti if rc != 2 else {
   269	                    "title": "📚 今日复习已生成",
   270	                    "body": noti["body"] + "（Bark 未配置，仅本地提醒）",
   271	                }
   272	                fallback = "ok" if osascript_fallback(local_noti) else "fail"
   273	                if fallback == "ok":
   274	                    st["last_local_notify_date"] = today
   275	            save_state(st)
   276	
   277	    log_line(f"generate:{gen} push:{push} fallback:{fallback}")
   278	    print(f"[runner] generate:{gen} push:{push} fallback:{fallback}")
   279	    return 0
   280	
   281	
   282	if __name__ == "__main__":
   283	    sys.exit(main())

