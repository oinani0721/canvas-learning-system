   383	# ── CARD-C1a (BATCH-2026-08-25-跨vault与收束): 多 vault 命名空间隔离 ──
   384	
   385	
   386	def test_two_vaults_same_day_push_and_state_isolated(tmp_path, monkeypatch, capsys):
   387	    """全局单例根缺陷的修复锁定: vault A 当日推送后, vault B 同日必须仍能
   388	    推送 (旧 last_push_accepted_date 全局 → B 永远 skip-done); 两个 state
   389	    文件独立; 互跑后各自缓存门仍 cached (旧 payload_sha256 单值 → 乒乓失效)。
   390	
   391	    已知局限: 本测两库跑在同一 Python 进程, 证明的是 state 隔离, 不证明
   392	    生产「一库一进程」契约 — 后者由 wrapper shell 层循环保证 (进程内复用
   393	    会踩 pick.load_decay 的 decay_beta import 缓存, 见 wrapper 注释)。"""
   394	    vault_a = _vault(tmp_path, {"甲": _node()}, name="vaultA")
   395	    vault_b = _vault(tmp_path, {"乙": _node()}, name="vaultB")
   396	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
   397	    # runner.main 会改写模块全局 VAULT — 先经 monkeypatch 登记原值,
   398	    # teardown 恢复, 防测试顺序依赖 (Codex-C1a M1)
   399	    monkeypatch.setattr(runner, "VAULT", runner.VAULT)
   400	    # 窗口门放行 (机器时区无关): 本测锁 state 隔离, 不锁窗口语义
   401	    monkeypatch.setattr(runner, "PUSH_WINDOW", (dtime(0, 0), dtime(23, 59, 59)))
   402	    sent = []
   403	    monkeypatch.setattr(
   404	        runner.send_bark,
   405	        "send",
   406	        lambda noti, vault_id=None: sent.append((noti["id"], vault_id)) or 0,
   407	    )
   408	    now_arg = "2026-07-30T10:00:00+08:00"
   409	
   410	    def _run(vault) -> str:
   411	        monkeypatch.setattr(
   412	            sys,
   413	            "argv",
   414	            ["daily_review_run.py", "--now", now_arg, "--vault", str(vault)],
   415	        )
   416	        assert runner.main() == 0
   417	        return capsys.readouterr().out
   418	
   419	    out_a = _run(vault_a)
   420	    assert "generate:new" in out_a and "push:accepted" in out_a
   421	    out_b = _run(vault_b)
   422	    assert "generate:new" in out_b and "push:accepted" in out_b, (
   423	        "vault A 推过后 vault B 同日必须仍可推送 (state 全局单例会误判 skip-done)"
   424	    )
   425	    # send 侧拿到的是各自 payload 的顶层 vault_id (通知 id 值本身不含 vault)
   426	    assert [v for _, v in sent] == ["vaultA", "vaultB"]
   427	    assert all(nid == "canvas-review-2026-07-30" for nid, _ in sent)
   428	
   429	    state_a = tmp_path / "backups" / "daily-review.vaultA.state.json"
   430	    state_b = tmp_path / "backups" / "daily-review.vaultB.state.json"
   431	    assert state_a.exists() and state_b.exists(), "两个 vault 必须各有独立 state 文件"
   432	    assert (
   433	        json.loads(state_a.read_text(encoding="utf-8"))["last_push_accepted_date"]
   434	        == json.loads(state_b.read_text(encoding="utf-8"))["last_push_accepted_date"]
   435	    )
   436	
   437	    # 互跑第二轮: 各自缓存门仍 cached + 同日去重 skip-done (乒乓失效修复)
   438	    _pin_pool_older_than_payload(vault_a, BASE)
   439	    _pin_pool_older_than_payload(vault_b, BASE)
   440	    out_a2 = _run(vault_a)
   441	    assert "generate:cached" in out_a2 and "push:skip-done" in out_a2
   442	    out_b2 = _run(vault_b)
   443	    assert "generate:cached" in out_b2 and "push:skip-done" in out_b2
   444	    assert len(sent) == 2, "第二轮不得再发推送"
   445	
   446	    log_text = (tmp_path / "backups" / "daily-review.log").read_text(encoding="utf-8")
   447	    assert "vault=vaultA" in log_text and "vault=vaultB" in log_text
   448	
