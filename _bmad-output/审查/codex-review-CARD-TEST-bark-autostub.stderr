   136	        ["daily_review_run.py", "--now", now_arg, "--vault", str(vault)],
   137	    )
   138	    assert runner.main() == 0
   139	    out = capsys.readouterr().out
   140	    assert "generate:new" in out, "重扫必须真的发生 (否则本场景空转)"
   141	    assert "push:skip-done" in out
   142	
   143	    st2 = runner.load_state()
   144	    assert st2["last_push_accepted_date"] == today
   145	    assert st2["last_generate_date"] == today
