   110	def test_rescan_keeps_same_day_push_skip_done(tmp_path, monkeypatch, capsys):
   111	    vault = _vault(tmp_path, {"甲": _node()})
   112	    _patch_runner(monkeypatch, vault, tmp_path)
   113	    now_arg = "2026-07-30T10:00:00+08:00"
   114	    # today 按 runner 同一变换推导 (机器时区无关): skip-done 门在窗口门之前
   115	    today = datetime.fromisoformat(now_arg).astimezone().date().isoformat()
   116	
