   836	def test_rest_due_rest_due_oscillation_capped_at_two(tmp_path, monkeypatch, capsys):
   837	    """Codex-D2b M3: 全天 rest→due→rest→due 振荡 — 第二次 accepted (due) 后
   838	    无论语义再怎么翻转, 当日不得出现第三次发送 (rcs 越界哨兵扛门)。防
   839	    「任意已知语义变化均放行」类回归 mutant。"""
