   395	    vault_b = _vault(tmp_path, {"乙": _node()}, name="vaultB")
   396	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
   397	    # runner.main 会改写模块全局 VAULT — 先经 monkeypatch 登记原值,
