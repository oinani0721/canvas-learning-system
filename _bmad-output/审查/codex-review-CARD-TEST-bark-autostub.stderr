   747	def test_due_to_due_rescan_stays_skip_done(tmp_path, monkeypatch, capsys):
   748	    """due→due 不放行: 早晨到期推送后, 盘中重扫榜更新也 skip-done (与场景 3
   749	    互补 — 那条锁旧 state 无 last_push_kind 的保守回退, 本条锁写入后语义)。"""
   750	    vault = _vault(tmp_path, {"甲": _node(board="A板")})
   751	    calls = _push_harness(monkeypatch, tmp_path, vault, rcs=[0])
   752	
   753	    out1 = _run_main(monkeypatch, capsys, vault, "2026-07-30T10:00:00+08:00")
   754	    assert "push:accepted" in out1
   755	    assert runner.load_state()["last_push_kind"] == "due"
