   519	def test_vault_key_slug_rules():
   520	    """两域设计 (Codex-C1a B2/H1): ASCII 短名原样; 非 ASCII slug+hash16;
   521	    hash 域后缀形态的 ASCII 名强制改道 hash 域 (两域不重叠 → 「数学 的 key
   522	    恰好被某 ASCII 目录名占用」这类直白碰撞不可构造); 超长名截断+hash,
   523	    state 文件名恒在 NAME_MAX 内; 输出恒为文件名/通知 id 安全字符集。"""
   524	    vault_key = runner.send_bark.vault_key
   525	    assert vault_key("canvas-vault") == "canvas-vault"
   526	    k1, k2 = vault_key("数学"), vault_key("物理")
   527	    assert k1 != k2
   528	    for k in (k1, k2):
   529	        assert re.fullmatch(r"[0-9A-Za-z._-]+-[0-9a-f]{16}", k)
   530	    # 域分离: 中文库的 key 本身作为目录名再进来, 必须映射到不同 key
   531	    assert vault_key(k1) != k1
   532	    # 超长合法目录名不得让 daily-review.<key>.state.json 超 NAME_MAX=255
   533	    long_key = vault_key("a" * 232)
   534	    assert len(f"daily-review.{long_key}.state.json".encode("utf-8")) <= 255
   535	    assert long_key != vault_key("a" * 233)
   536	    # 目录名字面精确: Unicode 空白尾巴是另一个库, 不得与裸名撞 key
   537	    assert vault_key("foo ") != vault_key("foo")
   538	    # 路径传入也归约到目录名 (调用方兜底)
   539	    assert vault_key("/tmp/x/canvas-vault/") == "canvas-vault"
