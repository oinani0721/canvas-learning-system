   592	def test_migrate_symlink_vault_arg_matches_runner_key(tmp_path, monkeypatch):
   593	    """经 symlink 传 --vault 时, 迁移目标文件名必须与 runner state_path 恒等
   594	    — migrate 取字面名而 runner resolve 的话, 迁移会落到永远不被读的文件。"""
   595	    backups = _old_state_fixture(tmp_path)
   596	    real = _vault(tmp_path, {"甲": _node()}, name="真库")
   597	    link = tmp_path / "alias"
   598	    link.symlink_to(real)
   599	
   600	    rc = _run_migrate(monkeypatch, ["--vault", str(link), "--backups", str(backups)])
   601	    assert rc == 0
   602	    monkeypatch.setattr(runner, "VAULT", link)
   603	    monkeypatch.setattr(runner, "BACKUPS", backups)
   604	    assert runner.state_path().exists(), "迁移产出的文件名必须能被 runner 读到"
