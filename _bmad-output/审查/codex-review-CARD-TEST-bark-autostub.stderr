   789	def test_second_push_failure_retries_next_hour(tmp_path, monkeypatch, capsys):
   790	    """二推失败幂等重试: 反转门只在 accepted 时关闭 (last_push_kind 翻 due),
   791	    失败保持 rest → 次小时 launchd 触发自然重试; 连续失败本地兜底只弹一次
   792	    (Codex-D2b L2); 成功后清错收口。"""
   793	    vault = _vault(tmp_path, {"重学卡": _node(board="A板", extra="fsrs_due: 2026-07-30T06:00:00Z\n")})
   794	    calls = _push_harness(monkeypatch, tmp_path, vault, rcs=[0, 1, 1, 0])
   795	    fallbacks = []
   796	    monkeypatch.setattr(runner, "osascript_fallback", lambda noti: fallbacks.append(noti["title"]) or True)
   797	    today = datetime.fromisoformat("2026-07-30T10:00:00+08:00").astimezone().date().isoformat()
   798	
   799	    out1 = _run_main(monkeypatch, capsys, vault, "2026-07-30T10:00:00+08:00")
   800	    assert "push:accepted" in out1
   801	
   802	    _pin_pool_older_than_payload(vault, BASE)
   803	    out2 = _run_main(monkeypatch, capsys, vault, "2026-07-30T14:05:00+08:00")
   804	    assert "push:failed" in out2 and "fallback:ok" in out2
   805	    st2 = runner.load_state()
   806	    assert st2["last_push_kind"] == "rest", "失败不得翻 due — 否则重试门被永久关闭"
   807	    assert st2["last_result"] == "generated_push_failed"
   808	    assert st2["last_error"] == "bark-send"
   809	    assert st2["last_local_notify_date"] == today
   810	    assert fallbacks == ["📚 今日复习 · A板"]
   811	
   812	    _pin_pool_older_than_payload(vault, BASE)
   813	    out3 = _run_main(monkeypatch, capsys, vault, "2026-07-30T15:05:00+08:00")
   814	    assert "push:failed" in out3 and "fallback:-" in out3, "同日本地兜底只弹一次"
   815	    assert len(fallbacks) == 1
   816	
   817	    _pin_pool_older_than_payload(vault, BASE)
   818	    out4 = _run_main(monkeypatch, capsys, vault, "2026-07-30T16:05:00+08:00")
   819	    assert "push:accepted" in out4, "次小时必须幂等重试成功"
   820	    st4 = runner.load_state()
   821	    assert st4["last_push_kind"] == "due"
   822	    assert st4["last_result"] == "pushed" and st4["last_error"] == "", "成功后必须清错"
   823	    assert [t for _, t in calls] == [
   824	        "📚 今日无到期节点",
   825	        "📚 今日复习 · A板",
   826	        "📚 今日复习 · A板",
   827	        "📚 今日复习 · A板",
   828	    ]
   829	
   830	    _pin_pool_older_than_payload(vault, BASE)
   831	    out5 = _run_main(monkeypatch, capsys, vault, "2026-07-30T17:05:00+08:00")
   832	    assert "push:skip-done" in out5
   833	    assert len(calls) == 4
