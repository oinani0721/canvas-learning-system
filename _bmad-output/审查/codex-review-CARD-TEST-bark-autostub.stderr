   574	def test_migrate_apply_keeps_bak_and_refuses_overwrite(tmp_path, monkeypatch, capsys):
   575	    backups = _old_state_fixture(tmp_path)
   576	    original = (backups / "daily-review.state.json").read_text(encoding="utf-8")
   577	    rc = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   578	    assert rc == 0
   579	    new = backups / "daily-review.canvas-vault.state.json"
   580	    bak = backups / "daily-review.state.json.bak"
   581	    assert new.read_text(encoding="utf-8") == original
   582	    assert bak.read_text(encoding="utf-8") == original, "实迁必须保留 .bak 供回滚"
   583	    assert not (backups / "daily-review.state.json").exists()
   584	
   585	    # 二次实迁 (旧文件重新出现) 不得覆盖已存在的新文件
   586	    (backups / "daily-review.state.json").write_text("{}", encoding="utf-8")
   587	    rc2 = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   588	    assert rc2 == 1
   589	    assert new.read_text(encoding="utf-8") == original
