   892	def test_legacy_cached_payload_without_top_boards_records_due(tmp_path, monkeypatch, capsys):
   893	    """Codex-D2b M2: 迁移前 legacy 缓存 payload 无 top_boards 键 — 语义未知,
   894	    accepted 落账必须保守记 due (关闭反转门), 不得记 rest 造成 due→due 二推。"""
   895	    vault = _vault(tmp_path, {"甲": _node(board="A板")})
   896	    calls = _push_harness(monkeypatch, tmp_path, vault, rcs=[0])
   897	    now_arg = "2026-07-30T10:00:00+08:00"
   898	    today = datetime.fromisoformat(now_arg).astimezone().date().isoformat()
   899	
   900	    legacy = {
   901	        "schema_version": 3,
   902	        "date": today,
   903	        "notification": {
   904	            "title": "📚 今日复习 · A板",
   905	            "body": "b",
   906	            "group": "canvas复习",
   907	            "id": f"canvas-review-{today}",
   908	        },
   909	    }
   910	    raw = json.dumps(legacy, ensure_ascii=False, indent=2) + "\n"
   911	    out_dir = vault / "outputs"
   912	    out_dir.mkdir(parents=True)
   913	    (out_dir / "今日复习.json").write_text(raw, encoding="utf-8")
   914	    st = runner.load_state()
   915	    st["last_generate_date"] = today
   916	    st["payload_sha256"] = hashlib.sha256(raw.encode("utf-8")).hexdigest()
