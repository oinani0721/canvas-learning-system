   758	    _pin_pool_older_than_payload(vault, BASE)
   759	    _set_mtime(vault / "节点" / "乙.md", BASE + 200)
   760	    _set_mtime(vault / "节点", BASE + 200)
   761	    out2 = _run_main(monkeypatch, capsys, vault, "2026-07-30T14:05:00+08:00")
   762	    assert "generate:new" in out2 and "push:skip-done" in out2
   763	    assert len(calls) == 1
   764	    assert runner.load_state()["last_push_kind"] == "due"
