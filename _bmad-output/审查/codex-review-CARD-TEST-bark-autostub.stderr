   187	# ── 内审 MEDIUM (实测复现): 扫描-落盘窗口内的写侧更新不得整天丢失 ──
   188	
   189	
   190	def test_write_during_scan_window_not_lost(tmp_path, monkeypatch):
   191	    """写侧恰在扫描完成后、payload 落盘前落地一张重学卡: 该卡 mtime 早于
   192	    payload 落盘时刻, 若以落盘时刻为基准则整天 cached 丢卡。基准必须是
   193	    扫描起点。真实 build_payload 照常执行, 仅在其返回后注入竞态写入。"""
   194	    vault = _vault(tmp_path, {"甲": _node()})
   195	    _patch_runner(monkeypatch, vault, tmp_path)
   196	    st = runner.load_state()
   197	
   198	    import daily_review_pick as picker
   199	
   200	    real_build = picker.build_payload
   201	    fired = []
   202	
   203	    def _race_build(*args, **kwargs):
   204	        result = real_build(*args, **kwargs)
   205	        if not fired:  # 只在首轮注入一次
   206	            fired.append(1)
   207	            (vault / "节点" / "竞态.md").write_text(_node(), encoding="utf-8")
   208	        return result
   209	
   210	    monkeypatch.setattr(picker, "build_payload", _race_build)
   211	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
   212	    assert gen1 == "new"
   213	    assert "竞态" not in {d["node"] for d in payload1["due_nodes"]}  # 首轮扫描没看到它
   214	
   215	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
   216	    assert gen2 == "new", "竞态窗口内落地的节点必须在下一轮触发重扫, 不得整天 cached"
   217	    assert "竞态" in {d["node"] for d in payload2["due_nodes"]}
