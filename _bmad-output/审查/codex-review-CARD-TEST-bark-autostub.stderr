   607	def test_migrate_crlf_state_byte_identical_and_idempotent(tmp_path, monkeypatch, capsys):
   608	    """Codex-C1a round4: CRLF 换行的合法 state 必须按字节原样迁移 (文本模式
   609	    read_text 会洗成 LF, 令 new≠bak 击穿完成态判据), 且重跑判 '已完成'。"""
   610	    backups = tmp_path / "backups"
   611	    backups.mkdir()
   612	    crlf = b'{\r\n  "schema_version": 1,\r\n  "last_generate_date": "2026-07-29"\r\n}\r\n'
   613	    (backups / "daily-review.state.json").write_bytes(crlf)
   614	    rc = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   615	    assert rc == 0
   616	    new = backups / "daily-review.canvas-vault.state.json"
   617	    assert new.read_bytes() == crlf, "迁移必须逐字节保真 (含 CRLF)"
   618	    rc2 = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   619	    assert rc2 == 0
   620	    assert "已完成" in capsys.readouterr().out
