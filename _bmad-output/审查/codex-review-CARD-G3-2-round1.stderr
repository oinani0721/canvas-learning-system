   127	def scheduler_identity(sched) -> tuple[str, str]:
   128	    """从活体 fsrs Scheduler 反推 (library_version, params_hash)。
   129	
   130	    params_hash 口径与 backend/scripts/generate_fsrs_golden_vectors.py::
   131	    params_hash() 逐字一致 (sha256 of canonical JSON, 六键形状), 零硬编码 ——
   132	    golden manifest 真值相等是被**复算证明**的, 不是被声明的。库/参数升级时
   133	    此处如实返回新身份, 与 manifest 的相等性检查由校验器负责。
   134	    """
   135	    from importlib.metadata import version as _pkg_version
   136	
   137	    config = {
   138	        "parameters": [float(p) for p in sched.parameters],
   139	        "desired_retention": float(sched.desired_retention),
   140	        "learning_steps_minutes": _steps_to_minutes(sched.learning_steps),
   141	        "relearning_steps_minutes": _steps_to_minutes(sched.relearning_steps),
   142	        "maximum_interval": int(sched.maximum_interval),
   143	        "enable_fuzzing": bool(sched.enable_fuzzing),
   144	    }
   145	    canonical = json.dumps(config, sort_keys=True, separators=(",", ":"))
   146	    return _pkg_version("fsrs"), hashlib.sha256(canonical.encode("utf-8")).hexdigest()
   147	
   148	
   149	def fields_from_frontmatter(fm: str) -> dict:
   150	    """从 frontmatter 文本抽 fsrs_* 字段 (纯 stdlib, 读侧同款正则)。"""
   151	    out = {}
   152	    for key in FIELD_ORDER:
   153	        m = re.search(rf'^{key}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   154	        if m:
   155	            out[key] = m.group(1).strip()
   156	    return out
   157	
   158	
   159	def _legacy_param(v):
   160	    """legacy state:0 伴生参数哨兵归一: 空/null/~/0/0.0/不可解析 → None。"""
   161	    if v in (None, ""):
   162	        return None
   163	    s = str(v).strip().lower()
   164	    if s in ("null", "none", "~"):
   165	        return None
   166	    try:
   167	        return None if float(s) == 0.0 else v
   168	    except ValueError:
   169	        return None
   170	
   171	
   172	#: A7 review 域上界 (schema v1 §6.2): review_time 与 W 同域同界且均须严格小于。
   173	#: 调度会在其上叠加 interval, A3 还要 +1s —— 逼近上界时新事件不可写, fail-closed。
   174	_REVIEW_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   175	
   176	
   177	def review(fields: dict, grade_norm: float, abandoned: bool, ts: str, rating: int | None = None) -> dict:
   178	    """一次评分 → 新 fsrs_* 字段 (需要 fsrs 可导入)。
   179	
   180	    G3-2 时刻语义 (schema v1 §6.2 A3/A5/A6):
   181	      - ts 归一 UTC 整秒后作为本次 review 时刻 (写出的 fsrs_last_review 与
   182	        返回的 review_time 逐字相同);
   183	      - 若当前 frontmatter 有 W (fsrs_last_review) 且本次时刻 ≤ W, 推进到
   184	        W+1s 再写 (A3 等时唯一口径: 推进不拒绝);
   185	      - rating 可显式指定 (A2 pending 重放按事件已断言的 rating 复算),
   186	        缺省按 grade_norm+abandoned 推导; abandoned 恒为 1 (弃答一票否决)。
   187	    """
   188	    from fsrs import Card, Rating, Scheduler, State
   189	
   190	    now = _whole_second(_aware(ts))
   191	    if now >= _REVIEW_MAX:
   192	        raise ValueError(f"review 时刻 {ts!r} 越出 A7 review 域上界 (须严格小于 {_iso(_REVIEW_MAX)})")
   193	    if abandoned:
   194	        used_rating = 1
   195	    elif rating is not None:
   196	        if isinstance(rating, bool) or int(rating) not in (1, 2, 3, 4):
   197	            raise ValueError(f"显式 rating 必须为 int 1-4, 实为 {rating!r}")
   198	        used_rating = int(rating)
   199	    else:
   200	        used_rating = rating_from_grade(grade_norm, abandoned)
   201	
   202	    sched = Scheduler(enable_fuzzing=False)
   203	    if fields.get("fsrs_due"):
   204	        step = fields.get("fsrs_step")
   205	        stability = fields.get("fsrs_stability")
   206	        difficulty = fields.get("fsrs_difficulty")
   207	        raw_state = int(fields.get("fsrs_state", 1))
   208	        if raw_state == 0:
   209	            # legacy New 形状字段级迁移 (CARD-C3, roundtrip 显式例外):
   210	            # state 0→Learning(1) — py-fsrs 4+ 无 New 态, State(0) 抛
   211	            # ValueError; 伴生哨兵 0/0.0/null → None (0.0 会进 v6 稳定度
   212	            # 幂运算抛 ZeroDivisionError); step 兜底 0 (Learning 首步)。
   213	            raw_state = 1
   214	            stability = _legacy_param(stability)
   215	            difficulty = _legacy_param(difficulty)
   216	            step = _legacy_param(step) or 0
   217	        card = Card(
   218	            state=State(raw_state),
   219	            step=int(step) if step not in (None, "") else None,
   220	            stability=float(stability) if stability else None,
   221	            difficulty=float(difficulty) if difficulty else None,
   222	            due=_aware(fields["fsrs_due"]),
   223	            last_review=_aware(fields["fsrs_last_review"]) if fields.get("fsrs_last_review") else None,
   224	        )
   225	        # A3 等时消解: 时刻 ≤ W → 推进 W+1s (写侧唯一口径, 禁止拒绝丢评分)。
   226	        # W 与 review_time 同域同界, W+1s 越出 A7 上界 ⇒ 后继不可写, fail-closed。
   227	        if fields.get("fsrs_last_review"):
   228	            w = _whole_second(_aware(fields["fsrs_last_review"]))
   229	            if now <= w:
   230	                bumped = w + timedelta(seconds=1)
   231	                if bumped >= _REVIEW_MAX:
   232	                    raise ValueError(f"A3 推进 W+1s 越出 A7 上界 (W={_iso(w)}) — 后继事件不可写")
   233	                now = bumped
   234	    else:
   235	        card = Card(due=now)  # 无字段 = New 卡即刻到期 (零迁移)
   236	
   237	    card, _log = sched.review_card(
   238	        card, Rating(used_rating), review_datetime=now
   239	    )
   240	    lib_ver, p_hash = scheduler_identity(sched)
   241	    out = {
   242	        "fsrs_due": _iso(card.due),
   243	        "fsrs_state": int(card.state),
   244	        "fsrs_step": card.step if card.step is not None else "",
   245	        "fsrs_stability": round(card.stability, 4) if card.stability is not None else "",
   246	        "fsrs_difficulty": round(card.difficulty, 4) if card.difficulty is not None else "",
   247	        "fsrs_last_review": _iso(now),
   248	        # G3-2 加性输出: 调用方必须把 review_time 原样写进事件 payload
   249	        # (与 effective_at 同一瞬间), 不要自己另算一份。
   250	        "review_time": _iso(now),
   251	        "rating": used_rating,
   252	        "fsrs_library_version": lib_ver,
   253	        "fsrs_params_hash": p_hash,
   254	    }
   255	    out["fm_block"] = "\n".join(
   256	        f"{k}: {out[k]}" for k in FIELD_ORDER if out[k] != ""
   257	    )
   258	    return out
   259	
   260	
   261	def _ensure_fsrs() -> bool:
   262	    try:
   263	        import fsrs  # noqa: F401
   264	        return True
   265	    except ImportError:
   266	        venv_py = _venv_python()
   267	        if os.environ.get("FSRS_BRIDGE_REEXEC") != "1" and venv_py:
   268	            os.environ["FSRS_BRIDGE_REEXEC"] = "1"
   269	            os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
   270	        return False
   271	
   272	
   273	def main() -> int:
   274	    if not _ensure_fsrs():
   275	        print(json.dumps({"error": "fsrs_unavailable — backend/.venv 缺失或未装 fsrs"}))
   276	        return 3
   277	    p = json.load(sys.stdin)
   278	    try:
   279	        out = review(
   280	            fields_from_frontmatter(p.get("fm", "")),
   281	            float(p.get("grade_norm", 0.0)),
   282	            bool(p.get("abandoned")),
   283	            p["ts"],
   284	            rating=p.get("rating"),
   285	        )
   286	    except ValueError as e:
   287	        # G3-2: naive/越界/非法 rating 等输入缺陷 —— 拒绝并 stdout 明说,
   288	        # 不静默降级。exit 2 = 输入错误 (区别于 3 = fsrs 不可用)。
   289	        print(json.dumps({"error": f"invalid_input — {e}"}, ensure_ascii=False))
   290	        return 2
   291	    print(json.dumps(out, ensure_ascii=False))
   292	    return 0
   293	
   294	
   295	if __name__ == "__main__":
   296	    sys.exit(main())

