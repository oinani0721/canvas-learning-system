    89	            # 而**零次落账** (丢一次真实事实)。幂等语义不变 (event_id 唯一),
    90	            # 只修正查重实现的正确性; 无法解析的行不算命中 (不静默吞)。
    91	            if path.exists():
    92	                with open(path, encoding="utf-8") as f:
    93	                    for line in f:
    94	                        try:
    95	                            record = json.loads(line)
    96	                        except ValueError:
    97	                            continue  # 坏行 (截断/损坏) 不构成 duplicate 证据
    98	                        if isinstance(record, dict) and record.get("event_id") == event_id:
    99	                            return False
   100	            now = datetime.now(timezone.utc).isoformat()
   101	            record = {
   102	                "event_id": event_id,
   103	                "event_version": EVENT_VERSION,
   104	                "event_type": event_type,
   105	                "node_id": node_id,
   106	                "recorded_at": now,
   107	                "effective_at": effective_at or now,
   108	                "payload": payload or {},
   109	            }
   110	            with open(path, "a", encoding="utf-8") as f:
   111	                f.write(json.dumps(record, ensure_ascii=False) + "\n")
   112	        return True
   113	    except Exception as e:  # noqa: BLE001 — 日志兜底, 不炸主链
   114	        logger.warning("[learning-events] append 失败 (主链不受影响): %s", e)
   115	        return False

