   238	        card, Rating(used_rating), review_datetime=now
   239	    )
   240	    lib_ver, p_hash = scheduler_identity(sched)
   241	    out = {
   242	        "fsrs_due": _iso(card.due),
   243	        "fsrs_state": int(card.state),
   244	        "fsrs_step": card.step if card.step is not None else "",
   245	        "fsrs_stability": round(card.stability, 4) if card.stability is not None else "",
   246	        "fsrs_difficulty": round(card.difficulty, 4) if card.difficulty is not None else "",
