   123	def _writer_code(vault: Path, payload: dict) -> str:
   124	    pfile = vault.parent / "payload.json"
   125	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   126	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   127	
   128	
   129	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   130	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   131	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   132	    return subprocess.run(
   133	        [sys.executable, "-c", _writer_code(vault, payload)],
   134	        capture_output=True,
   135	        text=True,
   136	        timeout=180,
   137	        cwd=str(vault),
   138	        env=env,
   139	    )
   140	
   141	
   142	def _ledger_lines(vault: Path) -> list[dict]:
   143	    ledger = vault / "learning_events.jsonl"
   144	    if not ledger.exists():
   145	        return []
   146	    return [json.loads(ln) for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   147	
   148	
   149	def _fm(vault: Path) -> str:
   150	    import yaml
   151	
   152	    text = (vault / NODE_REL).read_text(encoding="utf-8")
   153	    return text.split("---\n")[1]
   154	
   155	
   156	def _fm_fields(vault: Path) -> dict:
   157	    """按 bridge 同款正则抽 fsrs_* 行 (值+冒号后文本)。"""
   158	    fm = _fm(vault)
   159	    out = {}
   160	    for key in ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   161	        m = re.search(rf"^{key}:\s*\"?([^\"\n]+?)\"?\s*$", fm, re.M)
   162	        if m:
   163	            out[key] = m.group(1)
   164	    return out
   165	
   166	
   167	def _run_validator(vault: Path):
   168	    return subprocess.run(
   169	        [sys.executable, str(VALIDATOR), str(vault / "learning_events.jsonl")],
   170	        capture_output=True,
   171	        text=True,
   172	        timeout=60,
   173	    )
   174	
   175	
   176	def _sha(p: Path) -> str:
   177	    import hashlib
   178	
   179	    return hashlib.sha256(p.read_bytes()).hexdigest()
