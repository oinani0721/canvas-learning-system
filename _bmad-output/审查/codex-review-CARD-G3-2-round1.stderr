   399	# ── 门⑬ 耐久序列 + 写序 (A4.3/A4.4): spy 调用序列 ──
   400	# ⚠️ 本门证明耐久序列**被调用** (fsync 覆盖账本/temp/父目录, append fsync 先于
   401	# os.replace), 不证明掉电后数据存活 — 后者需真实断电, 不在本卡。
   402	
   403	
   404	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   405	    events: list[tuple] = []
   406	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   407	
   408	    def spy_fsync(fd):
   409	        try:
   410	            st = os.fstat(fd)
   411	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   412	            events.append(("fsync", kind, st.st_ino))
   413	        except OSError:
   414	            events.append(("fsync", "unknown", -1))
   415	        return real_fsync(fd)
   416	
   417	    def spy_replace(src, dst):
   418	        events.append(("replace", str(src), str(dst)))
   419	        return real_replace(src, dst)
   420	
   421	    monkeypatch.setattr(os, "fsync", spy_fsync)
   422	    monkeypatch.setattr(os, "replace", spy_replace)
   423	    monkeypatch.chdir(vault)
   424	    saved_path = list(sys.path)
   425	    saved_modules = {
   426	        k: sys.modules.pop(k) for k in ("fsrs_bridge", "decay_beta", "validate_learning_events") if k in sys.modules
   427	    }
   428	    try:
   429	        exec(compile(_writer_code(vault, _payload()), "quiz-answer-SKILL-extract", "exec"), {})
   430	    except SystemExit as e:
   431	        assert e.code in (0, None), f"静态块异常退出: {e.code}"
   432	    finally:
   433	        sys.path[:] = saved_path
   434	        sys.modules.pop("fsrs_bridge", None)
   435	        sys.modules.pop("decay_beta", None)
   436	        sys.modules.pop("validate_learning_events", None)
   437	        sys.modules.update(saved_modules)
   438	
   439	    ledger, node = vault / "learning_events.jsonl", vault / NODE_REL
   440	    ledger_ino, node_ino = ledger.stat().st_ino, node.stat().st_ino
   441	    fsyncs = [e for e in events if e[0] == "fsync"]
   442	    replaces = [e for e in events if e[0] == "replace"]
   443	    assert len(replaces) == 1, f"恰一次原子发布, 实得 {len(replaces)}"
   444	    replace_idx = events.index(replaces[0])
   445	    # 账本 fsync (file) 与 temp fsync (temp inode == 发布后节点 inode)
   446	    fsynced_files = {e[2] for e in fsyncs if e[1] == "file"}
   447	    assert ledger_ino in fsynced_files, "账本 fd 必须 fsync (A4.3)"
   448	    assert node_ino in fsynced_files, "temp fd 必须 fsync (A4.4; replace 保留 inode)"
   449	    dir_count = sum(1 for e in fsyncs if e[1] == "dir")
   450	    assert dir_count >= 2, f"首建账本父目录 + 节点父目录均须 fsync, 实得 dir fsync {dir_count} 次"
   451	    # 写序: 账本 durable 必须先于 os.replace (真 write-ahead, 非改名)
   452	    ledger_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == ledger_ino)
   453	    temp_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == node_ino)
   454	    assert ledger_fsync_idx < replace_idx, "账本 fsync 必须先于 frontmatter 发布 (A1 write-ahead)"
   455	    assert temp_fsync_idx < replace_idx, "temp fsync 必须先于 os.replace (A4.4)"
