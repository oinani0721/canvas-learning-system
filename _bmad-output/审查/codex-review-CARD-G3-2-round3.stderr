   434	
   435	
   436	# ── 门⑬ 耐久序列 + 写序 (A4.3/A4.4): spy 调用序列 ──
   437	# ⚠️ 本门证明耐久序列**被调用** (fsync 覆盖账本/temp/父目录, append fsync 先于
   438	# os.replace), 不证明掉电后数据存活 — 后者需真实断电, 不在本卡。
   439	
   440	
   441	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   442	    events: list[tuple] = []
   443	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   444	
   445	    def spy_fsync(fd):
   446	        try:
   447	            st = os.fstat(fd)
   448	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   449	            events.append(("fsync", kind, st.st_ino))
   450	        except OSError:
   451	            events.append(("fsync", "unknown", -1))
   452	        return real_fsync(fd)
   453	
   454	    def spy_replace(src, dst):
   455	        events.append(("replace", str(src), str(dst)))
   456	        return real_replace(src, dst)
   457	
   458	    monkeypatch.setattr(os, "fsync", spy_fsync)
   459	    monkeypatch.setattr(os, "replace", spy_replace)
   460	    monkeypatch.chdir(vault)
   461	    saved_path = list(sys.path)
   462	    saved_modules = {
   463	        k: sys.modules.pop(k) for k in ("fsrs_bridge", "decay_beta", "validate_learning_events") if k in sys.modules
   464	    }
   465	    try:
   466	        exec(compile(_writer_code(vault, _payload()), "quiz-answer-SKILL-extract", "exec"), {})
   467	    except SystemExit as e:
   468	        assert e.code in (0, None), f"静态块异常退出: {e.code}"
   469	    finally:
   470	        sys.path[:] = saved_path
   471	        sys.modules.pop("fsrs_bridge", None)
   472	        sys.modules.pop("decay_beta", None)
   473	        sys.modules.pop("validate_learning_events", None)
   474	        sys.modules.update(saved_modules)
   475	
   476	    ledger, node = vault / "learning_events.jsonl", vault / NODE_REL
   477	    ledger_ino, node_ino = ledger.stat().st_ino, node.stat().st_ino
   478	    fsyncs = [e for e in events if e[0] == "fsync"]
   479	    replaces = [e for e in events if e[0] == "replace"]
   480	    assert len(replaces) == 1, f"恰一次原子发布, 实得 {len(replaces)}"
   481	    replace_idx = events.index(replaces[0])
