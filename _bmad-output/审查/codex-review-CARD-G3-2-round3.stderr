   521	    # W 恰为新事件时刻 — 若旧行被误重放 W 会先落到 2026-07-01
   522	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
   523	    assert len(_ledger_lines(vault)) == 2
   524	    assert _run_validator(vault).returncode == 0
