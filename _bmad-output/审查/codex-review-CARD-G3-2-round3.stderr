   503	
   504	def test_legacy_rows_never_replayed(vault):
   505	    legacy = json.dumps(
   506	        {
   507	            "event_id": "quiz:旧事件",
   508	            "event_version": 1,
   509	            "event_type": "answer_scored",
   510	            "node_id": "测试节点",
   511	            "recorded_at": "2026-07-01T10:00:00Z",
   512	            "effective_at": "2026-07-01T10:00:00Z",
   513	            "payload": {"grade_norm": 1.0, "exam_board": "x", "attempt_count": 1},
   514	        },
