   386	def _append_calibration(fm_text, ts_str):
   387	    """calibration_log 条目 (正常/恢复两路径共用)。ts_str = 业务生效时刻
   388	    (review_time — 与 effective_at 同源, 保证恢复产物与直接应用逐字节对齐)。"""
   389	    q_ = lambda v: json.dumps(v, ensure_ascii=False)
   390	    scn_ = p.get("self_confidence_norm")
   391	    entry_ = (f'  - event_id: {q_(eid)}\n'
   392	              f'    ts: {q_(ts_str)}\n'
   393	              f'    exam_board: {q_(p.get("exam_board",""))}\n'
   394	              f'    question_id: {q_(p.get("question_id","q1"))}\n'
   395	              f'    self_confidence_raw: {q_(p.get("self_confidence_raw") or "null")}\n'
   396	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   397	              f'    grade_norm: {GN2}\n'
   398	              f'    abandoned: {"true" if p.get("abandoned") else "false"}')
   399	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   400	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   401	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   402	    # 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   403	    mcal_ = re.search(r'^calibration_log:', fm_text, re.M)
   404	    if mcal_:
   405	        lines_ = fm_text.split("\n")
   406	        li_ = next(i for i, ln in enumerate(lines_) if re.match(r'^calibration_log:', ln))
   407	        j_ = li_ + 1
   408	        while j_ < len(lines_) and lines_[j_].startswith("  "):
   409	            j_ += 1
   410	        lines_[j_:j_] = entry_.split("\n")
   411	        return "\n".join(lines_)
   412	    return fm_text.rstrip() + "\ncalibration_log:\n" + entry_
