   738	# ── 门㉑ degraded 遗留重试 (round-2 B-1②): F1=T 但 W 未推进 → 恢复只补 FSRS ──
   739	
   740	
   741	def test_degraded_legacy_retry_restores_fsrs_without_double_ema(vault):
   742	    """首评 fsrs 不可用 → 事件落账(哨兵)+EMA/校准已应用+W 未推进。fsrs 恢复后
   743	    同 ID 重试必须: 补齐 FSRS、**不再吃一次 EMA**、账本仍 1 行。"""
   744	    r1 = _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"})
   745	    assert r1.returncode == 0, r1.stdout + r1.stderr
   746	    ema_after_degraded = _fm(vault)
   747	    assert not _fm_fields(vault), "degraded 后 W 必须未推进"
   748	    # fsrs 恢复 (不加 REEXEC env) → 同 ID 重试
   749	    r2 = _run_writer(vault, _payload(ts="2026-09-01T06:00:00Z"))
   750	    assert r2.returncode == 0, r2.stdout + r2.stderr
   751	    assert "degraded 遗留" in r2.stdout, r2.stdout + r2.stderr
   752	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-01T10:00:00Z", "FSRS 必须补齐推进"
   753	    fm_now = _fm(vault)
   754	    for key in ("mastery_score", "mastery_a", "mastery_b"):
   755	        assert re.search(rf"^{key}:.*", fm_now, re.M).group(0) == re.search(
   756	            rf"^{key}:.*", ema_after_degraded, re.M
   757	        ).group(0), f"{key} 不得二次吸收成绩 (EMA 双吃)"
   758	    assert len(_ledger_lines(vault)) == 1, "恢复不得二次 append"
   759	    assert _run_validator(vault).returncode == 0
