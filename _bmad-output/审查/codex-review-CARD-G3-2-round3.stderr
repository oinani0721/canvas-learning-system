   315	def _apply_mastery(fm_text, biz_ts):
   316	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   317	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   318	    old = None
   319	    for key in ("mastery_score", "mastery", "mastery_level"):
   320	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   321	        if mo:
   322	            old = float(mo.group(1)); break
   323	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   324	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   325	    if ma and mb:
   326	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   327	    elif old is not None:
   328	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   329	    else:
   330	        a_, b_ = PRIOR_A, PRIOR_B
   331	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   332	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   333	    days_idle = 0.0
   334	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   335	    if mle:
   336	        try:
   337	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   338	        except ValueError:
   339	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   340	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   341	    a_, b_ = update_after_idle(a_, b_, GN, days_idle)
   342	    return old, a_, b_, round(mu(a_, b_), 2)
