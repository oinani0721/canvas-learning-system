   726	    assert len(lines) == 2, f"新行必须独立成行, 实得 {len(lines)} 行"
   727	    assert json.loads(lines[1])["event_id"] == "quiz:fresh-1"
   728	    assert ev.append_event("answer_scored", event_id="quiz:fresh-1") is False  # 幂等不因守卫破坏
   729	    # 变体 (round-2 HIGH): 零字节空文件首写 — seek(-1) 守卫必须跳过, 不能炸
   730	    empty = tmp_path / "empty" / "learning_events.jsonl"
   731	    empty.parent.mkdir(parents=True)
   732	    empty.write_text("", encoding="utf-8")
   733	    monkeypatch.setattr(ev, "_log_path", lambda: empty)
   734	    assert ev.append_event("answer_scored", event_id="quiz:first-in-empty"), "空文件首写必须成功"
   735	    assert json.loads(empty.read_text(encoding="utf-8").strip())["event_id"] == "quiz:first-in-empty"
