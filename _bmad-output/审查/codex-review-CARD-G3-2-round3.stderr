   414	# ── 门⑫ 裁决② degraded: 事件仍落账 + 哨兵成对 + W 不推进 ──
   415	
   416	
   417	def test_fsrs_unavailable_degraded_sentinels_pair_and_w_frozen(vault):
   418	    """FSRS_BRIDGE_REEXEC=1 阻断 re-exec; bridge 子进程用系统 python3
   419	    (无 fsrs, 本机实证) → 诚实 exit 3 → 裁决②路径。"""
   420	    r = _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"})
   421	    assert r.returncode == 0, r.stdout + r.stderr
   422	    assert "degraded" in r.stdout
   423	    rec = _ledger_lines(vault)[0]
   424	    pl = rec["payload"]
   425	    assert pl["fsrs_library_version"].startswith("degraded:"), "库版本必须填哨兵"
   426	    assert pl["fsrs_params_hash"].startswith("degraded:"), "参数 hash 必须填哨兵"
   427	    assert pl["fsrs_library_version"] == pl["fsrs_params_hash"], "两键哨兵必须成对 (同因)"
   428	    assert pl["fsrs_library_version"][len("degraded:") :].strip(), "哨兵原因必须非空"
   429	    assert not _fm_fields(vault), "degraded 不得写任何 fsrs_* 字段 (W 不推进)"
   430	    assert "mastery_score" in _fm(vault), "衰减 Beta 照常写"
   431	    assert _run_validator(vault).returncode == 0, "哨兵成对产物必须过校验器"
   432	    # degraded 事件 review_time > W(无 W = -inf) → 留 pending; fsrs 恢复后
   433	    # 下次评分的 A2 会自动补应用 (write-ahead 的价值, 产品可见)
   434	
   435	
   436	# ── 门⑬ 耐久序列 + 写序 (A4.3/A4.4): spy 调用序列 ──
   437	# ⚠️ 本门证明耐久序列**被调用** (fsync 覆盖账本/temp/父目录, append fsync 先于
   438	# os.replace), 不证明掉电后数据存活 — 后者需真实断电, 不在本卡。
   439	
   440	
   441	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   442	    events: list[tuple] = []
   443	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   444	
   445	    def spy_fsync(fd):
   446	        try:
   447	            st = os.fstat(fd)
   448	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   449	            events.append(("fsync", kind, st.st_ino))
   450	        except OSError:
   451	            events.append(("fsync", "unknown", -1))
   452	        return real_fsync(fd)
   453	
   454	    def spy_replace(src, dst):
   455	        events.append(("replace", str(src), str(dst)))
   456	        return real_replace(src, dst)
   457	
   458	    monkeypatch.setattr(os, "fsync", spy_fsync)
   459	    monkeypatch.setattr(os, "replace", spy_replace)
   460	    monkeypatch.chdir(vault)
   461	    saved_path = list(sys.path)
   462	    saved_modules = {
   463	        k: sys.modules.pop(k) for k in ("fsrs_bridge", "decay_beta", "validate_learning_events") if k in sys.modules
   464	    }
   465	    try:
   466	        exec(compile(_writer_code(vault, _payload()), "quiz-answer-SKILL-extract", "exec"), {})
   467	    except SystemExit as e:
   468	        assert e.code in (0, None), f"静态块异常退出: {e.code}"
   469	    finally:
   470	        sys.path[:] = saved_path
   471	        sys.modules.pop("fsrs_bridge", None)
   472	        sys.modules.pop("decay_beta", None)
   473	        sys.modules.pop("validate_learning_events", None)
   474	        sys.modules.update(saved_modules)
   475	
   476	    ledger, node = vault / "learning_events.jsonl", vault / NODE_REL
   477	    ledger_ino, node_ino = ledger.stat().st_ino, node.stat().st_ino
   478	    fsyncs = [e for e in events if e[0] == "fsync"]
   479	    replaces = [e for e in events if e[0] == "replace"]
   480	    assert len(replaces) == 1, f"恰一次原子发布, 实得 {len(replaces)}"
   481	    replace_idx = events.index(replaces[0])
   482	    # 账本 fsync (file) 与 temp fsync (temp inode == 发布后节点 inode)
   483	    fsynced_files = {e[2] for e in fsyncs if e[1] == "file"}
   484	    assert ledger_ino in fsynced_files, "账本 fd 必须 fsync (A4.3)"
   485	    assert node_ino in fsynced_files, "temp fd 必须 fsync (A4.4; replace 保留 inode)"
   486	    dir_count = sum(1 for e in fsyncs if e[1] == "dir")
   487	    assert dir_count >= 2, f"首建账本父目录 + 节点父目录均须 fsync, 实得 dir fsync {dir_count} 次"
   488	    # Codex round-1 验证限制: dir fsync 必须绑定两个**不同**目录 inode
   489	    # (VAULT 根 = 账本父目录, 节点/ = 节点父目录), 不是同一目录刷两次
   490	    dir_inodes = {e[2] for e in fsyncs if e[1] == "dir"}
   491	    assert len(dir_inodes) >= 2, f"两个不同父目录都要 fsync, 实得 {len(dir_inodes)} 个 inode"
   492	    assert vault.stat().st_ino in dir_inodes, "账本父目录 (VAULT 根) 必须 fsync"
   493	    assert (vault / "节点").stat().st_ino in dir_inodes, "节点父目录必须 fsync"
   494	    # 写序: 账本 durable 必须先于 os.replace (真 write-ahead, 非改名)
   495	    ledger_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == ledger_ino)
   496	    temp_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == node_ino)
   497	    assert ledger_fsync_idx < replace_idx, "账本 fsync 必须先于 frontmatter 发布 (A1 write-ahead)"
   498	    assert temp_fsync_idx < replace_idx, "temp fsync 必须先于 os.replace (A4.4)"
   499	
