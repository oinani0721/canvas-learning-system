   284	def test_truncated_tail_line_without_lf_guard(vault):
   285	    """§二 截断自愈: 真实崩溃产物是 **半个 JSON** 且无尾 LF — 读取时跳过
   286	    留痕, 追加前 LF 守卫隔离, 新事件必须独立可解析 (Codex round-1 HIGH:
   287	    旧版只测「完整 JSON 缺 LF」, partial-JSON 在读取阶段就 fail-closed,
   288	    自愈路径不可达)。"""
   289	    ledger = vault / "learning_events.jsonl"
   290	    full = json.dumps(
   291	        {
   292	            "event_id": "exam:旧板",
   293	            "event_version": 1,
   294	            "event_type": "exam_created",
   295	            "node_id": "旧节点",
   296	            "recorded_at": TS1,
   297	            "effective_at": TS1,
   298	            "payload": {"exam_board": "检验白板/旧板.md"},
   299	        },
   300	        ensure_ascii=False,
   301	    )
   302	    torn = '{"event_id": "quiz:被截断的事件", "event_version": 1, "event_ty'
   303	    ledger.write_text(full + "\n" + torn, encoding="utf-8")  # 第二行为 partial JSON, 无尾 LF
   304	    r = _run_writer(vault, _payload())
   305	    assert r.returncode == 0, r.stdout + r.stderr
   306	    assert "截断尾行" in r.stdout, "截断尾行必须留痕"
   307	    lines = [ln for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   308	    assert len(lines) == 3, f"新事件必须独立成行 (LF 守卫隔离截断行), 实得 {len(lines)} 行"
   309	    assert json.loads(lines[0])["event_id"] == "exam:旧板", "完整旧行必须原样保留"
   310	    assert json.loads(lines[2])["event_id"] == "quiz:" + EID, "新事件行必须独立可解析"
   311	    # 校验器如实把坏行报 FAIL (审计暴露损坏), 但坏行不连坐新行
   312	    v = _run_validator(vault)
   313	    assert v.returncode == 1 and "JSON 解析失败" in v.stdout, "坏行必须被校验器如实暴露"
   314	
