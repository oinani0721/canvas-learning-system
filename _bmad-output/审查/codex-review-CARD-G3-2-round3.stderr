   176	
   177	def review(fields: dict, grade_norm: float, abandoned: bool, ts: str, rating: int | None = None) -> dict:
   178	    """一次评分 → 新 fsrs_* 字段 (需要 fsrs 可导入)。
   179	
   180	    G3-2 时刻语义 (schema v1 §6.2 A3/A5/A6):
   181	      - ts 归一 UTC 整秒后作为本次 review 时刻 (写出的 fsrs_last_review 与
   182	        返回的 review_time 逐字相同);
   183	      - 若当前 frontmatter 有 W (fsrs_last_review) 且本次时刻 ≤ W, 推进到
   184	        W+1s 再写 (A3 等时唯一口径: 推进不拒绝);
   185	      - rating 可显式指定 (A2 pending 重放按事件已断言的 rating 复算),
   186	        缺省按 grade_norm+abandoned 推导; abandoned 恒为 1 (弃答一票否决)。
   187	    """
   188	    from fsrs import Card, Rating, Scheduler, State
   189	
   190	    now = _whole_second(_aware(ts))
   191	    if now >= _REVIEW_MAX:
   192	        raise ValueError(f"review 时刻 {ts!r} 越出 A7 review 域上界 (须严格小于 {_iso(_REVIEW_MAX)})")
   193	    if rating is not None:
   194	        # 严格 int (Codex round-1 MEDIUM): int(1.5)==1 会把非法 pending 行
   195	        # 静默应用; §6.1 冻结 rating 为真 int 1-4, bool 伪装同样拒绝。
   196	        # abandoned 自洽 (round-2 HIGH): 显式 rating 无论 abandoned 与否都先
   197	        # 验证类型 — abandoned 分支不再绕过类型门; 弃答恒 1 (§6.1), 显式给
   198	        # 非 1 的 rating 与 abandoned=true 互斥。
   199	        if isinstance(rating, bool) or not isinstance(rating, int) or rating not in (1, 2, 3, 4):
   200	            raise ValueError(f"显式 rating 必须为 int 1-4, 实为 {rating!r}")
   201	        if abandoned and rating != 1:
   202	            raise ValueError(f"abandoned=true 时 rating 恒为 1 (弃答一票否决), 实为 {rating!r}")
   203	    if abandoned:
   204	        used_rating = 1
   205	    elif rating is not None:
   206	        used_rating = rating
   207	    else:
   208	        used_rating = rating_from_grade(grade_norm, abandoned)
   209	
   210	    sched = Scheduler(enable_fuzzing=False)
   211	    if fields.get("fsrs_due"):
   212	        step = fields.get("fsrs_step")
   213	        stability = fields.get("fsrs_stability")
   214	        difficulty = fields.get("fsrs_difficulty")
   215	        raw_state = int(fields.get("fsrs_state", 1))
   216	        if raw_state == 0:
   217	            # legacy New 形状字段级迁移 (CARD-C3, roundtrip 显式例外):
   218	            # state 0→Learning(1) — py-fsrs 4+ 无 New 态, State(0) 抛
   219	            # ValueError; 伴生哨兵 0/0.0/null → None (0.0 会进 v6 稳定度
   220	            # 幂运算抛 ZeroDivisionError); step 兜底 0 (Learning 首步)。
   221	            raw_state = 1
   222	            stability = _legacy_param(stability)
   223	            difficulty = _legacy_param(difficulty)
   224	            step = _legacy_param(step) or 0
   225	        card = Card(
   226	            state=State(raw_state),
   227	            step=int(step) if step not in (None, "") else None,
   228	            stability=float(stability) if stability else None,
   229	            difficulty=float(difficulty) if difficulty else None,
   230	            due=_aware(fields["fsrs_due"]),
   231	            last_review=_aware(fields["fsrs_last_review"]) if fields.get("fsrs_last_review") else None,
   232	        )
   233	        # A3 等时消解: 时刻 ≤ W → 推进 W+1s (写侧唯一口径, 禁止拒绝丢评分)。
   234	        # W 与 review_time 同域同界, W+1s 越出 A7 上界 ⇒ 后继不可写, fail-closed。
   235	        if fields.get("fsrs_last_review"):
   236	            w = _whole_second(_aware(fields["fsrs_last_review"]))
   237	            if now <= w:
   238	                bumped = w + timedelta(seconds=1)
   239	                if bumped >= _REVIEW_MAX:
   240	                    raise ValueError(f"A3 推进 W+1s 越出 A7 上界 (W={_iso(w)}) — 后继事件不可写")
   241	                now = bumped
   242	    else:
   243	        card = Card(due=now)  # 无字段 = New 卡即刻到期 (零迁移)
   244	
   245	    card, _log = sched.review_card(
   246	        card, Rating(used_rating), review_datetime=now
   247	    )
   248	    lib_ver, p_hash = scheduler_identity(sched)
   249	    out = {
   250	        "fsrs_due": _iso(card.due),
   251	        "fsrs_state": int(card.state),
   252	        "fsrs_step": card.step if card.step is not None else "",
   253	        "fsrs_stability": round(card.stability, 4) if card.stability is not None else "",
   254	        "fsrs_difficulty": round(card.difficulty, 4) if card.difficulty is not None else "",
   255	        "fsrs_last_review": _iso(now),
   256	        # G3-2 加性输出: 调用方必须把 review_time 原样写进事件 payload
   257	        # (与 effective_at 同一瞬间), 不要自己另算一份。
   258	        "review_time": _iso(now),
   259	        "rating": used_rating,
   260	        "fsrs_library_version": lib_ver,
   261	        "fsrs_params_hash": p_hash,
   262	    }
   263	    out["fm_block"] = "\n".join(
   264	        f"{k}: {out[k]}" for k in FIELD_ORDER if out[k] != ""
   265	    )
   266	    return out
   267	
   268	
   269	def _ensure_fsrs() -> bool:
   270	    try:
   271	        import fsrs  # noqa: F401
   272	        return True
   273	    except ImportError:
   274	        venv_py = _venv_python()
   275	        if os.environ.get("FSRS_BRIDGE_REEXEC") != "1" and venv_py:
   276	            os.environ["FSRS_BRIDGE_REEXEC"] = "1"
   277	            os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
   278	        return False
   279	
   280	
   281	def main() -> int:
   282	    if not _ensure_fsrs():
   283	        print(json.dumps({"error": "fsrs_unavailable — backend/.venv 缺失或未装 fsrs"}))
   284	        return 3
   285	    p = json.load(sys.stdin)
   286	    try:
   287	        out = review(
   288	            fields_from_frontmatter(p.get("fm", "")),
   289	            float(p.get("grade_norm", 0.0)),
   290	            bool(p.get("abandoned")),
   291	            p["ts"],
   292	            rating=p.get("rating"),
   293	        )
   294	    except ValueError as e:
   295	        # G3-2: naive/越界/非法 rating 等输入缺陷 —— 拒绝并 stdout 明说,
   296	        # 不静默降级。exit 2 = 输入错误 (区别于 3 = fsrs 不可用)。
   297	        print(json.dumps({"error": f"invalid_input — {e}"}, ensure_ascii=False))
   298	        return 2
   299	    print(json.dumps(out, ensure_ascii=False))
   300	    return 0
   301	
   302	
   303	if __name__ == "__main__":
   304	    sys.exit(main())
     1	"""批次3' 2-4 — 统一学习事件日志 (MEM-FLYWHEEL-2026-07-22, 对账 schema 四要素)。
     2	
     3	`<vault>/learning_events.jsonl` append-only: frontmatter 仍是真相源 (不改架构),
     4	日志提供「过程可回放、图可重建」兜底 — 会话记忆层从「丢图即永失」变为可重放。
     5	
     6	Schema 四要素 (ChatGPT 对账采纳):
     7	  - event_id: 幂等键 (调用方构造稳定值, 重放/重试不双写)
     8	  - event_version: schema 版本 (当前 1)
     9	  - recorded_at / effective_at: 双时间戳 (记录时刻 vs 业务生效时刻,
    10	    补录历史事件时两者分离)
    11	  - event_type: 限 9 类核心动作 (EVENT_TYPES), 未知类型拒绝 — 防事件膨胀
    12	    (callout_ingested 2026-07-23 对账评审入集后 "8 类" 注释曾未同步)
    13	
    14	写点 (批次3' 接入 4 个, node_derived 留批次4' 拆分补强):
    15	  backend: candidate_created (蒸馏) / candidate_accepted / candidate_disputed
    16	           (= dispute 三件套第三件「可追溯」suppression log) / session_archived
    17	  vault:   answer_scored / answer_abandoned (quiz-answer) / exam_created
    18	           (start-exam-board) — SKILL 静态 python 直接 append 同一文件
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import json
    24	import logging
    25	import os
    26	import threading
    27	from datetime import datetime, timezone
    28	from pathlib import Path
    29	from typing import Any, Optional
    30	
    31	logger = logging.getLogger(__name__)
    32	
    33	EVENT_VERSION = 1
    34	
    35	#: 核心动作白名单 — 新增类型必须走对账评审, 不得随手扩
    36	#: (callout_ingested 经 2026-07-23 燃料策略对账批次5' 方案评审加入)
    37	EVENT_TYPES = frozenset(
    38	    {
    39	        "node_derived",
    40	        "exam_created",
    41	        "answer_scored",
    42	        "answer_abandoned",
    43	        "candidate_created",
    44	        "candidate_accepted",
    45	        "candidate_disputed",
    46	        "session_archived",
    47	        "callout_ingested",
    48	    }
    49	)
    50	
    51	_write_lock = threading.Lock()
    52	
    53	
    54	def _log_path() -> Path:
    55	    from app.config import settings
    56	
    57	    canvas_base = getattr(settings, "CANVAS_BASE_PATH", None) or "/vaults/canvas-vault"
    58	    return Path(canvas_base) / "learning_events.jsonl"
    59	
    60	
    61	def append_event(
    62	    event_type: str,
    63	    event_id: str,
    64	    node_id: str = "",
    65	    payload: Optional[dict[str, Any]] = None,
    66	    effective_at: Optional[str] = None,
    67	) -> bool:
    68	    """append-only 落一条学习事件; event_id 已存在 → 幂等跳过。
    69	
    70	    永不抛异常 (记录失败不得影响主链) — 返回 False 表示未写入
    71	    (幂等跳过或 IO 失败, 区别见日志)。
    72	    """
    73	    try:
    74	        if event_type not in EVENT_TYPES:
    75	            logger.warning("[learning-events] 拒绝未知 event_type=%r (9 类白名单)", event_type)
    76	            return False
    77	        if not event_id:
    78	            logger.warning("[learning-events] 拒绝空 event_id (幂等键必填)")
    79	            return False
    80	
    81	        path = _log_path()
    82	        path.parent.mkdir(parents=True, exist_ok=True)
    83	
    84	        with _write_lock:
    85	            # 幂等: 文件内已有该 event_id → 跳过 (日志量级小, 全文扫描可接受;
    86	            # 大文件时可换尾部 N 行 + 索引)。
    87	            # G3-2 (CARD-G3-2, schema §二/§6.2 A4.5): 查重改为 parsed-field
    88	            # equality — 原子串匹配 (`json.dumps(event_id) in line`) 在任意
    89	            # 历史行 payload 文本恰好含该 JSON 串形时会把新事件误判 duplicate
    90	            # 而**零次落账** (丢一次真实事实)。幂等语义不变 (event_id 唯一),
    91	            # 只修正查重实现的正确性; 无法解析的行不算命中 (留痕后跳过)。
    92	            if path.exists() and path.stat().st_size > 0:
    93	                # (round-2 HIGH: 空文件 seek(-1, SEEK_END) 抛 OSError, 守卫
    94	                # 必须 size>0 才读尾字节 — 否则首事件永远写不进去)
    95	                with open(path, encoding="utf-8") as f:
    96	                    for line in f:
    97	                        try:
    98	                            record = json.loads(line)
    99	                        except ValueError:
   100	                            # 坏行 (截断/损坏) 不构成 duplicate 证据, 但要留痕
   101	                            logger.warning(
   102	                                "[learning-events] 账本存在无法解析的行 (截断/损坏), 查重跳过该行: %r", line[:80]
   103	                            )
   104	                            continue
   105	                        if isinstance(record, dict) and record.get("event_id") == event_id:
   106	                            return False
   107	                # G3-2 LF 守卫 (schema §二 截断自愈): 尾行无换行时先补 LF 再
   108	                # 追加 — 否则新事件粘进坏行连坐损坏 (Codex round-1 HIGH:
   109	                # 预置 partial JSON 后 append 会把两个 JSON 粘成一行坏行)。
   110	                with open(path, "rb") as bf:
   111	                    bf.seek(-1, os.SEEK_END)
   112	                    if bf.read(1) != b"\n":
   113	                        with open(path, "a", encoding="utf-8") as tf:
   114	                            tf.write("\n")
   115	                        logger.warning("[learning-events] 检测到无换行结尾的尾行 (疑似截断), 已补 LF 隔离后再追加")
   116	            now = datetime.now(timezone.utc).isoformat()
   117	            record = {
   118	                "event_id": event_id,
   119	                "event_version": EVENT_VERSION,
   120	                "event_type": event_type,
   121	                "node_id": node_id,
   122	                "recorded_at": now,
   123	                "effective_at": effective_at or now,
   124	                "payload": payload or {},
   125	            }
   126	            with open(path, "a", encoding="utf-8") as f:
   127	                f.write(json.dumps(record, ensure_ascii=False) + "\n")
   128	        return True
   129	    except Exception as e:  # noqa: BLE001 — 日志兜底, 不炸主链
   130	        logger.warning("[learning-events] append 失败 (主链不受影响): %s", e)
   131	        return False
11:- 本契约冻结 **EVENT_VERSION = 1**（`learning_event_log.py:31`）的记录结构。这是对既有实现的**加性扩展式冻结，不是 supersede**：既有 9 类事件、既有 7 字段、既有**幂等键语义**（`event_id` 全文件唯一）原样生效。⚠️ 幂等**键语义**不变，但其**判定方式**由本契约冻结为 parsed-field equality（§二 + §6.2 A4.5）——既有子串查重是实现缺陷而非另一种语义，修正它**不触发**下方的 v2 升版条款。
13:- **必须 bump EVENT_VERSION（v2）的变更**：删除/改名任一顶层字段；改变任一顶层字段类型或语义；改变 event_id 幂等语义；payload 从 object 改为其他类型。v2 出现前，读方必须容忍未知 event_version 行（前向兼容：跳过并告警，不炸）。
14:- **路由信封冻结（round-20 Codex MEDIUM：跨版本 routing 此前未成文）**：`event_id` / `event_version` / `node_id` 三键构成**路由信封**，**任何未来版本都必须原样保留**（v2 可增删/改名其他顶层字段与 payload，但不得删除或改名这三键）。理由：读方要判定"这条记录是否属于我关心的节点"，只能靠一个**跨版本稳定**的键；若 v2 可以改名 `node_id`，任何按 v1 形状过滤的读方都会**静默放过无法解释的记录**（实测：一条改名了 `node_id` 的合法 v2 行，proof 的 scanner 完全看不见它 ⇒ 返回 `[]`）。
26:| 幂等 | **契约语义**：同一 `event_id` 全文件唯一；重放时已存在即跳过。**判定方式（§6.2 A4.5 冻结）= parsed-field equality**（逐行 `json.loads` 后比 `event_id` 字段）。<br>⚠️ **既有实现偏离（登记 §九，随 G3-2 修正）**：`append_event` 现用 `json.dumps(event_id) in line` 的**子串匹配**（`learning_event_log.py:86-88`）——若某 event_id 的 JSON 串形恰好出现在任意行的 payload 文本里，后续同名追加会被误判已存在而**零次落账**（丢一次真实事实）。这不是"更保守"，是**错误的查重实现**；契约以 parsed-field equality 为准 |
28:| 失败语义 | `append_event()` **永不抛异常**（:66-69, :103-105）。**折叠语义如实登记（Codex round-1 HIGH）**：返回值 `False` 把"幂等跳过"与"IO 失败"折叠为同一信号（区别只在日志），调用方无法机械区分。已知消费者偏离：`tips.py:572-578` 把任意 `False` 当 duplicate 处理并中止 callout 管道（`accepted=False`）——IO 失败会被误报为重复，**该写点上"不阻断主链"不成立**（登记 §九，修复属生产路径不在本卡）。G3-2 新写点**禁止**依赖此折叠布尔：必须沿用 skill 写点模式，先显式查重（duplicate 可区分）再追加（IO 失败单独可见） |
40:| `event_id` | string | 非空；全文件唯一（幂等键）；调用方构造稳定值 | 幂等键。构造规则见 §四逐类契约（`前缀:业务id` 惯例） |
50:| event_type | event_id 构造 | payload 已知键（v1 现实，informative） | 写点 |
54:| `answer_scored` | `quiz:<eid>` | `grade_norm`, `exam_board`, `attempt_count` | vault skill `quiz-answer/SKILL.md` 评分链（:324-341 静态 python） |
55:| `answer_abandoned` | `quiz:<eid>` | 同 `answer_scored` | 同上（`abandoned` 分支，:325） |
76:6. `canvas-vault/.claude/skills/quiz-answer/SKILL.md:324-341` — `answer_scored` / `answer_abandoned`
88:### 6.1 事件形状
90:- **不新增 event_type**：沿用既有 `answer_scored` / `answer_abandoned`（白名单不变，见 §七评审记录）。
92:  - **降级绕过封堵（Codex round-3 HIGH）**：`schema_ext` 出现但值不是 `"review/1"`（如 `"review/01"`、非字符串）= **违规**，不得静默降级为历史行；复习事件 payload **带扩展键却无 marker** 同样违规（历史行 payload 只有 `grade_norm`/`exam_board`/`attempt_count`，不含扩展键，故对存量零误报）。
93:- **挂载点限定**：`review/1` 只许挂在 `answer_scored` / `answer_abandoned` 上（挂到 `session_archived` 等 = 违规）。
103:  - `rating`：int 且 ∈ {1,2,3,4}（FSRS Rating；bool 伪装 int 判违规）
105:  - **评分自洽（Codex round-3 HIGH）**：`answer_scored` 的 `rating` 必须等于 `rating_from_grade(grade_norm)`（`fsrs_bridge.rating_from_grade` 口径：`grade = 1 + 3·gn` 就近落四档、越界钳制）；`answer_abandoned` 的 `rating` **恒为 1**（[Decision-FSRS-1] 弃答一票否决 Again）。
106:  - `review_time`：本次复习业务时刻（§三受理语法，tz-aware，**必须整秒**见 §6.2 A5）；与顶层 `effective_at` **同一瞬间**（按绝对时刻比较——`Z` 与 `+00:00` 是同一瞬间的两种写法，不按原字符串比）
107:  - `fsrs_library_version` + `fsrs_params_hash`：产生本次调度结果的库版本与参数指纹。**非降级时必须与 G3-4 `backend/tests/regression/fsrs_golden_manifest.json` 的 `library_version` / `params_hash` 真值相等**（Codex round-3 HIGH：只验形状时 `999.999` + 全零 hash 可蒙混）；校验器找不到该 manifest（脚本被拷到别处独立运行）时降级为形状校验并输出 WARN。
110:### 6.2 写序与崩溃恢复状态机（G3-2 落实；Codex round-1 BLOCKER + round-2 交错窗口整改）
116:- **正常卡** = 持久化 tuple **完整、canonical、落在可调度域内，且 `W` 落在 review 域内**（round-8 HIGH#2：`fsrs_last_review` 是"上一次 review 的时刻"，与 `review_time` 同域，必须**严格小于** A7 的 review 域上界——否则不存在任何合法后继事件（后继须 `> W` 且同样严格小于该上界），`W` 恰为上界时 A3 的 `W+1s` 也立即越界；`fsrs_due` 是调度产物，适用更宽的一般时间戳上界）（round-5 HIGH#2 + round-6 HIGH#1 逐条收紧：bridge `review()` 消费**六字段**构造 `Card`，规则不精确会放过真实调用时抛 `AssertionError`/`ZeroDivisionError`/产生 NaN 的形状）。逐条：
143:**整秒性判定同样按 UTC 归一化后计**：A5 要求的"整秒"在 UTC 归一化后保持（offset 只到分钟级；含秒的 offset 已被 §三 受理语法拒绝）。
147:  - 基础理由：真实调度器会在复习时刻上叠加最长 `maximum_interval = 36500` 天（≈100 年）算出新 `due`，A3 的等时消解还要 `+1s`——`9999-12-31T23:59:59Z` 会让二者都抛 `OverflowError`。
152:**A6 调度器入参必须是 UTC（round-5 HIGH#1，端到端条款）**：传给 fsrs `Scheduler.review_card()` 的 `review_datetime` **必须 tz-aware 且 tzinfo 恰为 UTC**——库对此硬校验（`scheduler.py:256-260` 抛 `ValueError: datetime must be timezone-aware and set to UTC`）。因此 G3-2 写路径必须满足：**事件 `payload.review_time`、传入调度器的时刻、写出的 `W` 三者是同一瞬间，且入库/入调度器前统一 `astimezone(UTC)`**。
159:- **A1 write-ahead**：先追加事件再更新 frontmatter。当前现实为 frontmatter 先写、事件后补，差异已在 D0 修订 §四登记。
160:- **A2 恢复先于新写（消灭交错窗口）**：任何复习写点在**追加新事件之前**，必须先把该节点的 pending 集合按序重放至空。
161:  - **为什么必要**（round-2 反例）：若允许"E1@t1 落账未应用时 E2@t2 直接从旧状态推进到 t2"，则水位线抬到 t2 后 E1 满足 `t1 ≤ W` 被误判已应用，**E1 对 current state 的贡献永久丢失**。A2 使**单写者下**任意时刻至多只有最后一次追加的事件处于 pending，该交错窗口不会出现。**并发下 A2 本身不够**——见 A4。
162:  - 崩溃窗口全覆盖：①事件已落账、frontmatter 未推进 → 下次写入前 A2 重放恢复；②两者都完成 → `review_time ≤ W`，不推进（幂等）；③追加即崩（事件未落账）→ 账本与 frontmatter 一致，本次评分丢失属用户可感知重试面，非账本不一致。
163:- **A3 严格递增（等时唯一口径：写侧推进，禁止拒绝）**：写侧必须保证同节点新事件 `review_time` **严格大于** `W`（按绝对瞬间比较）——若计算值 ≤ `W`（秒级精度下等时是常见情形），**推进到 `W + 1s` 后再写**，不得以原值写入。
170:      ① **fencing epoch**：锁文件内记单调递增的 `epoch`（每次成功获取 +1）与持有者身份；持有者在**发布前（写 temp 之后、`os.replace` 之前）必须重读锁文件确认 `epoch` 与身份仍是自己**，否则**放弃本次发布**（已 durable 的事件留在账本里，由下一次带锁的 A2 重放消化——这正是 write-ahead 的价值）。
174:  - **A4.2 唯一折叠基线（round-5：原措辞自相矛盾，此处收敛）**：在线写路径的基线**恒为当前 frontmatter 的 current state**，游标 = 本次锁内读到的 `W`，只做 **pending 增量重放**。"从账本起点全量折叠"**仅作离线对账/审计手段**，禁止出现在在线写路径——两者在"事件账不完整（历史行无 review/1 扩展）"的现实下**并不等价**，把全量折叠当在线基线会重复应用已在 state 里的事件。
175:  - **A4.3 耐久序列（round-5 补全，参照仓内已有正确模式 `canvas-vault/.claude/scripts/sync_board_concepts.py:583`）**：
178:  - **A4.4 原子发布（round-5 补全 fsync）**：frontmatter 六字段（`fsrs_bridge.py:44-46` FIELD_ORDER）与 `fsrs_last_review` 必须在**同一次原子替换**中落盘：`写 temp` → `flush` → `fsync(temp fd)` → `os.replace` → **`fsync(父目录 fd)`**。杜绝"部分字段已更新、W 未更新"的半态——半态会被三态判别识别为**残缺卡**并 fail-closed（正确的降级方向）。
179:  - **A4.5 账本追加的原子性与查重同域（round-5 新增，round-6 三项收紧）**：
180:    - **查重与追加同锁**：`event_id` 的查重与追加必须在同一把锁内（查重通过后到写入之间不得释放锁），否则两写者可各自查重通过再双写同一 `event_id`。账本是 **per-vault 共享文件**（非 per-node），故该锁粒度为 **per-vault 账本锁**，与 A4.1 的 per-node 锁是两把不同的锁（获取顺序全局固定：**先 node 锁后账本锁**，防死锁）。
181:    - **查重必须是 parsed-field equality（round-6 BLOCKER 分项）**：逐行 `json.loads` 后比较 `record["event_id"]` 字段是否相等；**禁止子串匹配**。既有 `append_event` 用的是子串查重（`learning_event_log.py:86-88`，§二已如实登记）——当任一历史行的 payload 文本里恰好含有新 `event_id` 的 JSON 串形时，新事件会被**误判 duplicate 而零次落账**（丢一次真实评分）。⚠️ 澄清：这**不是改变幂等语义**（幂等键仍是 `event_id` 唯一，不触发 §一的 v2 升版条款），而是**修正查重实现的正确性**——子串匹配从来就不是"字段相等"的正确实现。既有实现的偏离登记在 §九，随 G3-2 修正。
183:    - **duplicate 命中后的状态推进门（round-6 BLOCKER 分项，round-7 扩等价面）**：查重命中同一 `event_id` 时，按**语义 envelope 的 canonical 形式**分流。envelope = `{event_version, event_type, node_id, effective_at, payload}` 的 `json.dumps(..., sort_keys=True, separators=(",",":"))`——**显式排除 `recorded_at`**（重试时自然变化，不构成事实差异）。
184:      ⚠️ round-7 反例：只比 `payload` 时，两条同 `event_id`、同 payload、`event_type` 分别为 `answer_scored`/`answer_abandoned` 的记录会被误判 no-op（两者是**相反的事实**：答对 vs 弃答）。
185:      ⚠️ **适用范围（round-8 MEDIUM）**：envelope 冲突门**只约束 `schema_ext=review/1` 的复习写路径**（G3-2 地盘）。通用 `append_event()` 在调用方省略 `effective_at` 时每次以新 `now` 填充（5 个 backend 调用点中 4 个省略），若全局套用 envelope 门，**合法重试会因 `effective_at` 天然不同而被误判冲突**——非扩展行沿用既有语义：同 `event_id` 即幂等跳过，不做 envelope 比较。
187:      ① **同 ID 同 canonical envelope** ⇒ 视为重放/恢复，**no-op**（不再落账、**绝不再次 apply**；若 frontmatter 尚未推进则按 A2 走 pending 重放路径恢复）；
188:      ② **同 ID 不同 canonical envelope** ⇒ **冲突，fail-closed**（拒绝写入并如实报错——同一幂等键承载了两份不同事实，属上游 bug，不得由工具静默选边）；
189:      ③ 任何情况下 duplicate 都**不得触发第二次 apply**。
190:  - ⚠️ **移交条款（G3-3，五项必补）**：①per-node **排他 sidecar 锁**（非 CAS、非节点文件本身）覆盖 A4 全序列 + 崩溃回收；②**per-vault 账本锁**内完成 event_id 查重与 `O_APPEND` 单次写；③冲突写者在锁内**重读 W 并按 A3 推进时刻**后重算（不得在陈旧状态上重试）；④账本与 frontmatter 的**完整 fsync 序列**（含父目录）；⑤只做 pending 增量重放，不把全量折叠当在线基线。
192:- **A5 整秒精度（Codex round-3 BLOCKER：小数秒二次推进）**：`review_time` **必须为整秒**（无小数秒段）。因为 `W` 只有秒级精度，`10:00:00.5 > 10:00:00` 恒成立——同一事件重放会被判 pending 并**二次推进**（实测：首次应用后 Learning/due 10:10，重放同一事件推进为 Review/due +2d）。校验器对 `schema_ext=review/1` 行机械强制整秒。
198:- **迟到事件的入账通道**：A3 的"严格大于 W"只约束**在线评分**（正常复习写入）。补录/迟到事件走**账本补录通道**：以原始 `review_time` 入账 + 标 `payload.out_of_order = true`，**不进 pending、不推进 current state**——因此与 A3 无冲突。
212:        ⑤ 不做完整记录级 schema 校验 —— scanner 只校验 proof 依赖的字段 (node_id / schema_ext / out_of_order / review_time / event_id / 算法身份 / vault_id); proof 校验以「该账本已通过主体校验」为前置条件;
227:      | `event_id` / `review_time` | E 的幂等键与业务时刻（`review_time` 即重建后写入的 `W`） |
228:      | `fsrs_library_version` / `fsrs_params_hash` / `scheduler_config` | 复算所用的算法身份与完整配置（须与 G3-4 golden manifest 同源；`degraded:*` 哨兵不合格） |
257:      - **顺序**：按**行号升序**折叠（账本的物理追加序即因果序——A2 保证写入时状态已是最新）。
271:    - **`degraded:*` 哨兵行不参与自动证明链**：其 `fsrs_library_version`/`params_hash` 是哨兵而非算法身份，无法确定性复算——含此类事件的区间必须由人工裁定。
276:- **duplicate 与 IO 失败必须可区分**（§二折叠语义）：G3-2 写点先显式查重再追加，禁止依赖 `append_event` 的折叠布尔。
279:### 6.3 历史兼容
281:- 历史行（无 `schema_ext` 标记的 `answer_scored`/`answer_abandoned`）**永久合法**——校验器不以扩展键缺失判 FAIL（防对现网账本误报）。历史行不参与 6.2 水位线重放（无 `review_time`，视为已应用）。
288:| 2026-08-28 | G3-1 冻结评审：复习域是否需要新 event_type？ | **否**——`answer_scored`/`answer_abandoned`/`exam_created` 已覆盖复习动作语义；G3-2 走 payload 加性键（§六），EVENT_TYPES 白名单 9 类不变。若未来出现无法归入现有 9 类的复习动作（如调度重算、休眠/恢复），须新开评审行再入集 |
294:- **判定规则**（每行）: **严格 JSON** 可解析（RFC 8259——拒 `NaN`/`Infinity` 非标准常量、拒对象内重复键；写侧 `json.dumps(dict)` 不可能产出两者，合法数据零误报）；非法 UTF-8 字节序列 = 该行违规（逐行独立解码，不中断其余行）；**前向兼容分流**：`event_version` 为 int 且 ≠1 的行**只 WARN 并完全跳过 v1 形状校验**（Codex round-1：原"WARN+形状 FAIL 双发"违反前向兼容，已修）；v1 行：顶层键**恰好** 7 键、各字段类型/约束按 §三、`event_type` ∈ 白名单、时间戳按 §三受理语法且 tz-aware；payload 含 `schema_ext: "review/1"` 时强制 §6.1 全部扩展键类型与**语义绑定**（挂载点 / concept_id==node_id / review_time 整秒且与 effective_at 同瞬间 / rating-grade_norm 自洽 / 弃答 rating=1 / 库指纹与 golden manifest 真值相等）；`schema_ext` 值非法或复习事件带扩展键却无 marker = 违规（防降级绕过）。深层嵌套（RecursionError）与超长整数（解析限额）均单行判违规、不中断其余行。**文件级**: `event_id` 全文件唯一（跨版本行也登记——幂等键语义跨版本恒定）。无标记历史行的 payload 键集不做 FAIL 判定（§6.3）。
301:| **查重用子串匹配而非字段等值**（Codex round-6/7 BLOCKER 分项） | `learning_event_log.py:86-88`（`json.dumps(event_id) in line`） | 若某 `event_id` 的 JSON 串形恰好出现在任意历史行的 payload 文本里，新事件会被误判 duplicate 而**零次落账**（丢一次真实事实）。契约（§二 + §6.2 A4.5）已冻结为 **parsed-field equality**；这是**修正错误实现**而非改幂等语义，不触发 §一的 v2 升版条款。**移交 G3-2**（其新写点必须用 parsed 查重；既有 `append_event` 本体的修正随之进行） |
302:| **bridge 时间口径三项**（Codex round-5 HIGH#1） | `fsrs_bridge.py:50 _aware()` / `:55 _iso()` | ①`_aware()` 只补 tzinfo 不做 `astimezone(UTC)`——把校验器判定合法的 `12:00:00+08:00` 传给真实库会抛 `ValueError: datetime must be timezone-aware and set to UTC`（round-5 只读复算实测）；②naive 串被静默当 UTC；③`_iso()` 截掉小数秒。契约 A6 已冻结"三者同一瞬间且统一 UTC"；**移交 G3-2**（接入复习写路径时一并修） |
307:| **tips 写点把 IO 失败误报为 duplicate 并中止管道**（Codex round-1 HIGH） | `tips.py:572-578` | `append_event` 返回 `False` 折叠两义（§二），tips 消费者按 duplicate 分支返回 `accepted=False`——IO 失败时 callout 被错误拒收且"不阻断主链"不成立。生产路径修复不在本卡；**移交独立 micro-patch**（⚠️ G3-7 卡面只含 `/review/record`、`/fsrs-state`、mastery grade 三条路径，**不含 tips**——不可默认由其顺带收，Codex round-2 指出） |

