   316	# ── 门⑧ envelope 冲突 (同 id 不同 event_type) → 拒绝; 同 envelope → no-op ──
   317	
   318	
   319	def test_envelope_conflict_rejected_and_same_envelope_noop(vault):
   320	    # ①同 id 同 envelope: 完整成功后再跑, 绝不二次 apply (W 不动即证明)
   321	    r = _run_writer(vault, _payload())
   322	    assert r.returncode == 0, r.stdout + r.stderr
   323	    sha = _sha(vault / NODE_REL)
   324	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
   325	    assert r2.returncode == 0
   326	    assert _sha(vault / NODE_REL) == sha, "同 id 同 envelope 重放不得二次 apply"
   327	    # ②同 id 不同事实 (abandoned 翻转 event_type) → fail-closed 拒写
   328	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 回到崩溃窗口①前置态
   329	    r3 = _run_writer(vault, _payload(abandoned=True))
   330	    assert r3.returncode != 0, "同 id 不同 event_type 必须 envelope 冲突拒绝"
   331	    assert "envelope 冲突" in r3.stderr, r3.stderr
   332	    assert len(_ledger_lines(vault)) == 1, "冲突拒绝不得追加"
   333	    assert not _fm_fields(vault), "冲突拒绝不得推进 frontmatter"
   334	    # ③Codex round-1 BLOCKER: 五字段局部比对抓不到的篡改 — durable 行被
   335	    # 改动 payload 事实键 (exam_board) / 顶层 event_version 后, 恢复必须拒。
   336	    base_event = _ledger_lines(vault)[0]
   337	    for tweak, desc in (
   338	        ({"payload.exam_board": "检验白板/被篡改.md"}, "payload 事实键 exam_board"),
   339	        ({"event_version": 2}, "顶层 event_version"),
   340	    ):
   341	        tampered = json.loads(json.dumps(base_event))
   342	        key, val = next(iter(tweak.items()))
   343	        if "." in key:
   344	            tampered["payload"][key.split(".")[1]] = val
   345	        else:
   346	            tampered[key] = val
   347	        ledger = vault / "learning_events.jsonl"
   348	        ledger.write_text(json.dumps(tampered, ensure_ascii=False) + "\n", encoding="utf-8")
   349	        rt = _run_writer(vault, _payload())
   350	        assert rt.returncode != 0, f"篡改 {desc} 后恢复必须拒绝"
   351	        assert "envelope 冲突" in rt.stderr, rt.stderr
   352	    # 恢复正常 durable 行后 (原样回写), 同一续跑必须成功 (崩溃窗口①恢复)
   353	    (vault / "learning_events.jsonl").write_text(json.dumps(base_event, ensure_ascii=False) + "\n", encoding="utf-8")
   354	    r4 = _run_writer(vault, _payload())
   355	    assert r4.returncode == 0, r4.stdout + r4.stderr
   356	    assert "恢复" in r4.stdout and "崩溃窗口" in r4.stdout
   357	
