   159	def _legacy_param(v):
   160	    """legacy state:0 伴生参数哨兵归一: 空/null/~/0/0.0/不可解析 → None。"""
   161	    if v in (None, ""):
   162	        return None
   163	    s = str(v).strip().lower()
   164	    if s in ("null", "none", "~"):
   165	        return None
   166	    try:
   167	        return None if float(s) == 0.0 else v
   168	    except ValueError:
   169	        return None
