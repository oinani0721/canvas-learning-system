   716	def test_append_event_lf_guard_isolates_torn_tail(monkeypatch, tmp_path):
   717	    """backend append_event 在 partial-JSON 无 LF 尾行后追加: 新行必须独立
   718	    可解析、函数返回 True (新行确实落盘) — 不得把两个 JSON 粘成一行。"""
