   527	# ── 门⑮ 跨事件 A2: 别的事件落账未应用 → 本次评分前重放至空 ──
   528	
   529	
   530	def test_pending_foreign_event_replayed_before_new_write(vault):
   531	    """run1 为事件 A 落账未应用 (崩溃), run2 换一张板考同一节点 (事件 B):
   532	    A2 必须先重放 A 再计算 B — 单写者下交错窗口由 A2 消灭。"""
   533	    event_a = {
   534	        "event_id": "quiz:板A#q1",
   535	        "event_version": 1,
   536	        "event_type": "answer_scored",
   537	        "node_id": "测试节点",
   538	        "recorded_at": TS1,
   539	        "effective_at": TS1,
   540	        "payload": {
   541	            "schema_ext": "review/1",
   542	            "vault_id": "canvas_vault_测试",
   543	            "concept_id": "测试节点",
   544	            "rating": 3,
   545	            "grade_norm": 0.75,
   546	            "review_time": TS1,
   547	            "fsrs_library_version": "degraded:historic-run",  # 哨兵行
   548	            "fsrs_params_hash": "degraded:historic-run",
   549	            "exam_board": "检验白板/板A.md",
   550	            "attempt_count": 1,
   551	        },
   552	    }
   553	    (vault / "learning_events.jsonl").write_text(json.dumps(event_a, ensure_ascii=False) + "\n", encoding="utf-8")
   554	    r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md"))
   555	    assert r.returncode == 0, r.stdout + r.stderr
   556	    assert "A2 重放已应用" in r.stdout, "事件 A 必须在本次写入前被重放"
   557	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z", "W 反映 B"
   558	    recs = _ledger_lines(vault)
   559	    assert [x["event_id"] for x in recs] == ["quiz:板A#q1", "quiz:板B#q1"]
   560	    assert _run_validator(vault).returncode == 0
   561	    # A2 重放 A 后 W=TS1; 若跳过重放直接算 B, B 会从新卡基线出发 — 与正确
   562	    # 基线 (A 已应用) 的 FSRS 六字段必然不同; 对拍 bridge 直调两次的结果:
   563	    sys.path.insert(0, str(VAULT_SCRIPTS))
   564	    try:
   565	        import fsrs_bridge as fb
   566	
   567	        base = fb.review({}, 0.75, False, TS1)  # A (rating 3)
   568	        got = _fm_fields(vault)
   569	        expect2 = fb.review({k: v for k, v in base.items() if k != "fm_block"}, 0.75, False, "2026-08-02T10:00:00Z")
   570	        assert float(got["fsrs_stability"]) == expect2["fsrs_stability"], (
   571	            f"A2 重放未生效或基线错: {got['fsrs_stability']} != {expect2['fsrs_stability']}"
   572	        )
   573	    finally:
   574	        sys.path.remove(str(VAULT_SCRIPTS))
   575	        sys.modules.pop("fsrs_bridge", None)
   576	
   577	
   578	# ── 门⑯ 子串查重陷阱: payload 文本含 JSON 串形不得误判 duplicate ──
   579	# Codex round-1 MEDIUM: 中文 EID + 转义 note 形态下旧子串谓词实测不命中
   580	# (杀不掉旧实现) — 陷阱必须用 ASCII event_id 且 payload 字段值**直接等于**
   581	# 该 event_id 文本, 让 `json.dumps(eid) in line` (旧实现) 确定命中。
   582	
   583	TRAP_EID = "trap-eid-123"
   584	
   585	
   586	def test_substring_dedup_trap(vault):
   587	    """A4.5 parsed-field equality: 预置行的 payload 文本里恰好含
   588	    `"quiz:<新eid>"` 的 JSON 串形时, 子串查重会误判 duplicate 而**零次落账**
   589	    (旧实现的真实缺陷, schema §九登记)。正确行为 = 正常追加第 2 行。
   590	    陷阱载体 = payload **键名** (键名引号不被 JSON 转义, 值内引号恒转义为
   591	    \\" 导致 needle 尾引号匹配不上 — 首版陷阱因此被验伪断言自己抓出)。
   592	    验伪: 该陷阱对旧子串谓词 `json.dumps(evid) in line` 必须命中。"""
   593	    trap_needle = json.dumps("quiz:" + TRAP_EID, ensure_ascii=False)  # "quiz:trap-eid-123"
   594	    other = {
   595	        "event_id": "quiz:另一事件",
   596	        "event_version": 1,
   597	        "event_type": "answer_scored",
   598	        "node_id": "测试节点",
   599	        "recorded_at": TS1,
   600	        "effective_at": TS1,
   601	        "payload": {"quiz:" + TRAP_EID: "字段名恰好等于新事件 id 的 JSON 串形"},  # 不含 schema_ext
   602	    }
   603	    line_text = json.dumps(other, ensure_ascii=False)
   604	    assert trap_needle in line_text, "陷阱行必须真的命中旧子串谓词 (否则本门为假门)"
   605	    (vault / "learning_events.jsonl").write_text(line_text + "\n", encoding="utf-8")
   606	    r = _run_writer(vault, _payload(event_id=TRAP_EID))
   607	    assert r.returncode == 0, r.stdout + r.stderr
   608	    recs = _ledger_lines(vault)
   609	    assert len(recs) == 2, f"parsed 查重不得被子串误判, 实得 {len(recs)} 行: {[x['event_id'] for x in recs]}"
   610	    assert recs[1]["event_id"] == "quiz:" + TRAP_EID
   611	
   612	
   613	# ── 门⑰ A2 重放失败 → 一律 fail-closed 零写 (Codex round-1 BLOCKER) ──
   614	
   615	
   616	def test_pending_replay_failure_blocks_everything(vault):
   617	    """存在 pending 且重放失败 (fsrs 不可用) 时: 既不 degraded 落账、也不
   618	    发布 frontmatter — A2 「追加前重放至空」无例外。"""
   619	    event_a = {
   620	        "event_id": "quiz:板A#q1",
   621	        "event_version": 1,
