   360	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   361	def _bridge(fm_text, gn, ab, ts, rating=None):
   362	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   363	    if rating is not None:
   364	        payload_in["rating"] = rating
   365	    try:
   366	        _r = subprocess.run(
   367	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   368	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   369	    except Exception as _e:
   370	        return None, str(_e)
   371	    try:
   372	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   373	    except ValueError:
   374	        _out = {}
   375	    if _r.returncode == 2:
   376	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
   377	    if _r.returncode == 0 and _out.get("fm_block"):
   378	        return _out, None
   379	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
   380	    return None, _err
