exec("\nimport importlib.util, tempfile, json, hashlib, re\nfrom pathlib import Path\n\nspec = importlib.util.spec_from_file_location(\"g32test\", \"tests/regression/test_g3_2_review_ledger.py\")\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\n\ndef mk():\n    td = tempfile.TemporaryDirectory()\n    v = m.vault.__wrapped__(Path(td.name))\n    return td, v\n\ndef sha_bytes(b):\n    return hashlib.sha256(b).hexdigest()\n\ndef lines_for(text, keys):\n    out = {}\n    for key in keys:\n        mm = re.search(rf\"^{re.escape(key)}:.*$\", text, re.M)\n        out[key] = mm.group(0) if mm else None\n    return out\n\nresults = {}\n\n# 1. Historical applied event after a later event: same facts should no-op.\ntd, v = mk()\na1 = m._run_writer(v, m._payload())\na2 = m._run_writer(v, m._payload(event_id=\"板B#q1\", ts=\"2026-08-02T10:00:00Z\", exam_board=\"检验白板/板B.md\"))\na3 = m._run_writer(v, m._payload(ts=\"2026-09-01T01:00:00Z\"))\nresults[\"historical_attempt\"] = {\n    \"setup_rc\": [a1.returncode, a2.returncode],\n    \"retry_rc\": a3.returncode,\n    \"retry_stderr\": a3.stderr.strip(),\n    \"ledger_attempts\": [x[\"payload\"][\"attempt_count\"] for x in m._ledger_lines(v)],\n    \"frontmatter_attempt\": lines_for(m._fm(v), [\"attempt_count\"])[\"attempt_count\"],\n}\ntd.cleanup()\n\n# 2. Extra out_of_order key self-copied through envelope and skips A2.\ntd, v = mk()\nbase_run = m._run_writer(v, m._payload())\nbase = m._ledger_lines(v)[0]\n(v / m.NODE_REL).write_text(m.NODE_V0, encoding=\"utf-8\")\nbase[\"payload\"][\"out_of_order\"] = True\n(v / \"learning_events.jsonl\").write_text(json.dumps(base, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\nrr = m._run_writer(v, m._payload())\nresults[\"out_of_order_self_copy\"] = {\n    \"setup_rc\": base_run.returncode,\n    \"recovery_rc\": rr.returncode,\n    \"stdout\": rr.stdout.strip(),\n    \"fsrs_fields_after\": m._fm_fields(v),\n    \"has_calibration\": \"calibration_log:\" in m._fm(v),\n    \"ledger_rows\": len(m._ledger_lines(v)),\n    \"validator_rc\": m._run_validator(v).returncode,\n}\ntd.cleanup()\n\n# 3. A3 bump: direct mastery uses raw ts, recovery uses durable review_time.\ntd, v = mk()\ninitial = m.NODE_REVIEW_W10.replace(\n    \"mastery_score: 0.5\\n\",\n    \"mastery_score: 0.5\\nmastery_a: 100000000.0\\nmastery_b: 100000000.0\\nattempt_count: 7\\nlast_examined: \\\"2026-07-01T00:00:00Z\\\"\\n\",\n)\n(v / m.NODE_REL).write_text(initial, encoding=\"utf-8\")\ndirect = m._run_writer(v, m._payload(ts=\"2026-08-01T10:00:00Z\"))\ndirect_bytes = (v / m.NODE_REL).read_bytes()\ndirect_lines = lines_for(m._fm(v), [\"mastery_a\", \"mastery_b\", \"mastery_score\", \"last_examined\"])\n(v / m.NODE_REL).write_text(initial, encoding=\"utf-8\")\nrecover = m._run_writer(v, m._payload(ts=\"2026-09-01T02:00:00Z\"))\nrecover_bytes = (v / m.NODE_REL).read_bytes()\nrecover_lines = lines_for(m._fm(v), [\"mastery_a\", \"mastery_b\", \"mastery_score\", \"last_examined\"])\nresults[\"mastery_time_basis\"] = {\n    \"rc\": [direct.returncode, recover.returncode],\n    \"byte_equal\": direct_bytes == recover_bytes,\n    \"sha_direct\": sha_bytes(direct_bytes),\n    \"sha_recover\": sha_bytes(recover_bytes),\n    \"direct\": direct_lines,\n    \"recover\": recover_lines,\n}\ntd.cleanup()\n\n# 4. Foreign scored pending with int/range-valid but grade-inconsistent rating.\ntd, v = mk()\nbad = {\n    \"event_id\": \"quiz:板A#q1\",\n    \"event_version\": 1,\n    \"event_type\": \"answer_scored\",\n    \"node_id\": \"测试节点\",\n    \"recorded_at\": m.TS1,\n    \"effective_at\": m.TS1,\n    \"payload\": {\n        \"schema_ext\": \"review/1\",\n        \"vault_id\": \"canvas_vault_测试\",\n        \"concept_id\": \"测试节点\",\n        \"rating\": 4,\n        \"grade_norm\": 0.75,\n        \"review_time\": m.TS1,\n        \"fsrs_library_version\": \"degraded:historic-run\",\n        \"fsrs_params_hash\": \"degraded:historic-run\",\n        \"exam_board\": \"检验白板/板A.md\",\n        \"attempt_count\": 1,\n    },\n}\n(v / \"learning_events.jsonl\").write_text(json.dumps(bad, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\nbr = m._run_writer(v, m._payload(event_id=\"板B#q1\", ts=\"2026-08-02T10:00:00Z\", exam_board=\"检验白板/板B.md\"))\nresults[\"scored_rating_mismatch\"] = {\n    \"writer_rc\": br.returncode,\n    \"stdout\": br.stdout.strip(),\n    \"ledger_rows\": len(m._ledger_lines(v)),\n    \"validator_rc\": m._run_validator(v).returncode,\n}\ntd.cleanup()\n\n# 5. Fractional durable review_time is normalized then replayed again.\ntd, v = mk()\nfrac_time = \"2026-08-01T10:00:00.500Z\"\nfrac = {\n    \"event_id\": \"quiz:frac#q1\",\n    \"event_version\": 1,\n    \"event_type\": \"answer_scored\",\n    \"node_id\": \"测试节点\",\n    \"recorded_at\": frac_time,\n    \"effective_at\": frac_time,\n    \"payload\": {\n        \"schema_ext\": \"review/1\",\n        \"vault_id\": \"canvas_vault_测试\",\n        \"concept_id\": \"测试节点\",\n        \"rating\": 3,\n        \"grade_norm\": 0.75,\n        \"review_time\": frac_time,\n        \"fsrs_library_version\": \"degraded:historic-run\",\n        \"fsrs_params_hash\": \"degraded:historic-run\",\n        \"exam_board\": \"x\",\n        \"attempt_count\": 1,\n    },\n}\n(v / \"learning_events.jsonl\").write_text(json.dumps(frac, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\nfp = m._payload(event_id=\"frac#q1\", exam_board=\"x\", grade_norm=0.75)\nf1 = m._run_writer(v, fp)\nw1 = m._fm_fields(v).get(\"fsrs_last_review\")\nf2 = m._run_writer(v, m._payload(event_id=\"frac#q1\", exam_board=\"x\", grade_norm=0.75, ts=\"2026-09-01T03:00:00Z\"))\nw2 = m._fm_fields(v).get(\"fsrs_last_review\")\nresults[\"fractional_durable\"] = {\n    \"rc\": [f1.returncode, f2.returncode],\n    \"w_after_first\": w1,\n    \"w_after_second\": w2,\n    \"second_stdout\": f2.stdout.strip(),\n    \"ledger_rows\": len(m._ledger_lines(v)),\n}\ntd.cleanup()\n\nprint(json.dumps(results, ensure_ascii=False, indent=2))\n")
