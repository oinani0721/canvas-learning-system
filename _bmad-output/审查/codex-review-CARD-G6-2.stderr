   478	test("6 秒后到期 → 6 秒后再问 (区间内原样)", () => {
   479	  assert.equal(computePollDelayMs(at(6), NOW), 6000);
   480	});
   481	test("2 秒后到期 → 夹到下限 5 秒 (不打爆后端)", () => {
   482	  assert.equal(computePollDelayMs(at(2), NOW), 5000);
   483	});
   484	test("1 小时后到期 → 夹到上限 60 秒 (不睡死)", () => {
   485	  assert.equal(computePollDelayMs(at(3600), NOW), 60000);
   486	});
   487	test("已过期的 next_due → 回落上限, 不空转", () => {
   488	  assert.equal(computePollDelayMs(at(-100), NOW), 60000);
   489	});
   490	test("没有任何 upcoming → 回落上限", () => {
   491	  assert.equal(computePollDelayMs({vaults: [NO_PROJ, CORRUPT]}, NOW), 60000);
   492	  assert.equal(computePollDelayMs({vaults: []}, NOW), 60000);
   493	  assert.equal(computePollDelayMs(null, NOW), 60000);
   494	});
   495	test("多库取最近的那个未来时刻", () => {
   496	  const data = {vaults: [at(50).vaults[0], at(8).vaults[0], at(-5).vaults[0]]};
