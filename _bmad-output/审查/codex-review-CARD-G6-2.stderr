   582	  const h = renderRefreshResult(200, {rebuilt: true, reason: "rebuilt", rebuild_count: 3});
   583	  assert.match(h, /已重建/);
   584	  assert.match(h, /第 3 次/);
   585	  assert.match(h, /rnote ok/);
   586	});
   587	test("去抖 → 明说本次没重算 + 还要等多久", () => {
   588	  const h = renderRefreshResult(200, {rebuilt: false, reason: "debounced",
   589	    debounce_ttl_seconds: 10, retry_after_seconds: 6.2});
   590	  assert.match(h, /10 秒内已重建过，本次未重算/);
   591	  assert.match(h, /约 7 秒后可再试/);
   592	  assert.match(h, /rnote warn/);
   593	  assert.ok(!h.includes("已重建（"), "去抖不许长得像成功");
   594	});
   595	test("in_progress → 说清没重复启动", () => {
   596	  const h = renderRefreshResult(200, {rebuilt: false, reason: "in_progress"});
   597	  assert.match(h, /已有一次重建在跑/);
   598	  assert.ok(!/rnote ok/.test(h));
   599	});
   600	test("503 → 显示状态码与后端给的原因", () => {
   601	  const h = renderRefreshResult(503, {detail: {error: "pick_missing", message: "生产器脚本不可用"}});
   602	  assert.match(h, /HTTP 503/);
