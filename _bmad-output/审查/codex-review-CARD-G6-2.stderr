   284	def main() -> int:
   285	    if not TARGET.exists():
   286	        print(f"FATAL: 找不到被测文件 {TARGET}", file=sys.stderr)
   287	        return 2
   288	    original = TARGET.read_bytes()
   289	    original_text = original.decode("utf-8")
   290	
   291	    # 前置: 基线必须全绿 —— 基线本来就红的话, 后面每条"变红"都不算数
   292	    base = subprocess.run(PYTEST + [TESTFILE], cwd=BACKEND, capture_output=True, text=True, timeout=900)
   293	    if base.returncode != 0:
   294	        print("FATAL: 基线不绿, 负验证无意义\n" + base.stdout[-3000:], file=sys.stderr)
   295	        return 2
   296	    print(f"基线全绿 ✓  ({MUTATIONS.__len__()} 条变异待跑, 串行)")
   297	
   298	    failures: list[str] = []
   299	    restore_broken = False
   300	    for idx, (mid, desc, old, new, gate) in enumerate(MUTATIONS, 1):
   301	        hits = original_text.count(old)
   302	        if hits != 1:
   303	            failures.append(f"{mid} 锚点在原文命中 {hits} 次 (须恰好 1) — 变异会静默空转")
   304	            print(f"[{idx:>2}/{len(MUTATIONS)}] {mid} ✗ 锚点命中 {hits} 次: {desc}")
   305	            continue
   306	        mutated = original_text.replace(old, new, 1)
   307	        assert mutated != original_text, f"{mid} 替换后文件未变"
   308	        TARGET.write_text(mutated, encoding="utf-8")
   309	        try:
   310	            proc = run_gate(gate)
   311	            red = proc.returncode != 0
   312	        finally:
   313	            TARGET.write_bytes(original)
   314	            restored = TARGET.read_bytes()
   315	            if restored != original:
   316	                print(f"FATAL: {mid} 还原后字节不一致 — 停止", file=sys.stderr)
   317	                restore_broken = True
   318	        if restore_broken:
   319	            return 2
   320	        mark = "✓ 变红" if red else "✗ 仍绿 (门不承重!)"
   321	        print(f"[{idx:>2}/{len(MUTATIONS)}] {mid} {mark} · {gate} · {desc}")
   322	        if not red:
   323	            failures.append(f"{mid} ({gate}) 未变红: {desc}")
   324	
   325	    # 收尾: 还原后基线必须仍然全绿 (证明脚本没留下残渣)
   326	    after = subprocess.run(PYTEST + [TESTFILE], cwd=BACKEND, capture_output=True, text=True, timeout=900)
   327	    if after.returncode != 0:
   328	        print("FATAL: 跑完后基线不绿 — 文件被污染\n" + after.stdout[-3000:], file=sys.stderr)
   329	        return 2
   330	
   331	    print()
   332	    if failures:
   333	        print(f"负验证 FAIL: {len(failures)}/{len(MUTATIONS)} 条未按预期变红")
   334	        for f in failures:
   335	            print("  - " + f)
   336	        return 1
   337	    print(f"负验证 PASS: {len(MUTATIONS)}/{len(MUTATIONS)} 条变异均被**指定的那道门**抓住; 还原后基线仍全绿")
   338	    return 0
   339	
   340	
   341	if __name__ == "__main__":
   342	    sys.exit(main())

