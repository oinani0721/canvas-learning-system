   700	@pytestmark_node
   701	def test_js_humanize_due_matches_server_side_wording(node_harness):
   702	    """同源锁: JS 的到期人话与服务端 _humanize_due 逐条相同。
   703	
   704	    期望值由**服务端函数当场算出**再喂进 node —— 哪天两页文案分家
   705	    (或时区口径漂移), 本门先红。
   706	    """
   707	    from datetime import datetime, timedelta, timezone
   708	
   709	    now_utc = datetime.fromtimestamp(_NOW_MS / 1000, tz=timezone.utc)
   710	    cases = []
   711	    for label, ts in (
   712	        ("空串=现在", ""),
   713	        ("逾期2天", (now_utc - timedelta(days=2)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   714	        ("今天", now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")),
   715	        ("明天", (now_utc + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   716	        ("5天后", (now_utc + timedelta(days=5)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   717	        ("同年月日", (now_utc + timedelta(days=30)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   718	        ("跨年", (now_utc + timedelta(days=400)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   719	        ("畸形", "20260901"),
   720	    ):
   721	        expected, _color = _humanize_due(ts, now_utc)
   722	        cases.append({"label": label, "ts": ts, "expected": expected})
   723	    # None 走 "—" 分支 (板级无数据)
   724	    cases.append({"label": "无数据", "ts": None, "expected": _humanize_due(None, now_utc)[0]})
   725	
   726	    proc = _run_node(
   727	        node_harness,
   728	        "import test from 'node:test';\nimport assert from 'node:assert/strict';\n"
   729	        "import {humanizeDue} from './render.mjs';\n"
   730	        f"const NOW = {_NOW_MS};\nconst CASES = {json.dumps(cases, ensure_ascii=False)};\n"
   731	        r"""
   732	for (const c of CASES) {
   733	  test("与服务端一致: " + c.label, () => {
   734	    assert.equal(humanizeDue(c.ts, NOW).text, c.expected);
   735	  });
   736	}
   737	""",
   738	    )
   739	    _assert_node_green(proc)

