    87	def test_no_external_resource_tags(page_html):
    88	    """零 CDN: script/link/img/iframe 一律不得引用外部资源。
    89	
    90	    与上一条不同 —— 这条挡的是**协议相对**与**跨源相对**写法
    91	    (`//cdn.x/y.js`, `link href` 指向别的主机), 它们不含 "http" 前缀,
    92	    上一条的正则看不见。
    93	    """
    94	    for tag, attr in (("script", "src"), ("link", "href"), ("img", "src"), ("iframe", "src")):
    95	        for m in re.finditer(rf'<{tag}\b[^>]*\b{attr}\s*=\s*["\']([^"\']*)["\']', page_html, re.I):
    96	            pytest.fail(f"{tag}[{attr}] 引用了外部资源: {m.group(1)!r}")
    97	    # 内联样式表以外不得有 <link>; <script> 必须是内联的 (无 src 属性)
    98	    assert page_html.count("<script>") == 1
    99	    assert "<script " not in page_html
