   686	  assert.ok(!h.includes('onmouseover="alert'), "属性被撑破");
   687	});
   688	test("深链把 / & # ? 一并编码 (与服务端 quote(safe='') 同语义)", () => {
   689	  const l = boardLink("v/a", "b&c#d?e");
   690	  assert.ok(l.includes("v%2Fa"));
