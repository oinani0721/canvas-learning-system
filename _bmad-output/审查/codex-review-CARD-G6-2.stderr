   222	
   223	def _extract_pure_js(html: str) -> str:
   224	    """从**实际响应体**割出常量区 + 纯函数区 (不是模板副本)。"""
   225	    const = re.search(r"// __CONSTANTS_BEGIN__\n(.*?)// __CONSTANTS_END__", html, re.S).group(1)
   226	    pure = re.search(r"// __PURE_RENDER_BEGIN__\n(.*?)// __PURE_RENDER_END__", html, re.S).group(1)
   227	    assert "__URLS_JSON__" not in const, "占位符没被替换 — 页面发出去的是模板本身"
   228	    assert "document" not in pure and "fetch(" not in pure, "纯函数区混入了副作用代码"
   229	    names = re.findall(r"^function (\w+)", pure, re.M)
   230	    return const + "\n" + pure + "\nexport {" + ", ".join(names) + "};\n"
   231	
   232	
   233	@pytest.fixture
   234	def node_harness(tmp_path, page_html):
   235	    """把真实响应里的纯函数写成 ESM 模块, 供 node --test 导入。"""
   236	    (tmp_path / "render.mjs").write_text(_extract_pure_js(page_html), encoding="utf-8")
   237	    return tmp_path
   238	
   239	
   240	def _run_node(tmp_path: Path, test_src: str) -> subprocess.CompletedProcess:
   241	    (tmp_path / "case.test.mjs").write_text(test_src, encoding="utf-8")
   242	    return subprocess.run(
   243	        [_NODE, "--test", "case.test.mjs"],
   244	        cwd=tmp_path,
   245	        capture_output=True,
   246	        text=True,
   247	        timeout=120,
   248	    )
   249	
   250	
   251	def _assert_node_green(proc: subprocess.CompletedProcess):
   252	    assert proc.returncode == 0, f"node --test 失败:\n{proc.stdout}\n{proc.stderr}"
   253	
   254	
