   167	    「bridge re-exec 链可达且 fsrs 真实参与」, 不是「tmp candidate 被选中」。
   168	    """
   169	    repo = tmp_path
   170	    v = repo / "canvas-vault"
   171	    (v / "节点").mkdir(parents=True)
   172	    (v / ".claude" / "scripts").mkdir(parents=True)
   173	    (repo / "backend" / "scripts").mkdir(parents=True)
   174	    (repo / "backend" / ".venv").symlink_to(WT / "backend" / ".venv", target_is_directory=True)
   175	    (repo / "backend" / "scripts" / "validate_learning_events.py").symlink_to(VALIDATOR)
   176	    (v / ".claude" / "scripts" / "fsrs_bridge.py").symlink_to(VAULT_SCRIPTS / "fsrs_bridge.py")
   177	    (v / ".claude" / "scripts" / "decay_beta.py").symlink_to(VAULT_SCRIPTS / "decay_beta.py")
   178	    # 故意连字符+中文: 校验器绑定的是 sanitize 后的 canvas_vault_测试;
   179	    # 写侧漏 sanitize (写原始形式) 会在 validator 绑定比对处翻红
   180	    (v / ".canvas-config.yaml").write_text(
   181	        '# 测试 config\nvault_id: "canvas-vault-测试"\nsubject: cs-61b\n', encoding="utf-8"
   182	    )
   183	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   184	    return v
   185	
   186	
   187	def _writer_code(vault: Path, payload: dict) -> str:
   188	    pfile = vault.parent / "payload.json"
   189	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   190	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   191	
   192	
   193	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   194	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   195	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   196	    return subprocess.run(
   197	        [sys.executable, "-c", _writer_code(vault, payload)],
   198	        capture_output=True,
   199	        text=True,
   200	        timeout=180,
   201	        cwd=str(vault),
   202	        env=env,
   203	    )
   204	
   205	
   206	def _sha(p: Path) -> str:
   207	    import hashlib
   208	
   209	    return hashlib.sha256(p.read_bytes()).hexdigest()
   210	
   211	
   212	def _write_face(vault: Path):
   213	    """整个写入面的快照：节点 + 账本。零写断言比这个。
   214	
   215	    只比节点 sha 对「账本被追加」失明；只比账本行数对「行内容被改」失明。
   216	    审查实测：在 fail-closed 分支里插一行账本追加，只比节点 sha 的门全绿。
   217	    """
   218	    lp = vault / "learning_events.jsonl"
   219	    return (_sha(vault / NODE_REL), _sha(lp) if lp.exists() else None)
   220	
   221	
   222	def _run_writer_settled(vault: Path, payload: dict, env_extra: dict | None = None):
   223	    """跑写点；若因「A2 恢复先落定」被要求重跑，就再跑一次并返回合并结果。
   224	
   225	    存在 foreign pending 时写点会先把恢复结果原子发布、再以非零码退出要求重跑
   226	    （Codex round-3 BLOCKER 的修法：恢复与新写不在同一次运行里混做，否则被恢复
   227	    事件的 mastery/校准会连同「多 pending 攒在一起」一起变得不可证）。
   228	    只关心「最终有没有写成」的门用这个；专门验证两阶段语义的门直接用 _run_writer。
   229	    """
   230	    r = _run_writer(vault, payload, env_extra)
   231	    if r.returncode != 0 and "恢复已落定" in r.stderr:
   232	        r2 = _run_writer(vault, payload, env_extra)
   233	        return subprocess.CompletedProcess(r2.args, r2.returncode, r.stdout + r2.stdout, r.stderr + r2.stderr)
   234	    return r
   235	
   236	
   237	def _ledger_lines(vault: Path) -> list[dict]:
   238	    ledger = vault / "learning_events.jsonl"
   239	    if not ledger.exists():
   240	        return []
   241	    return [json.loads(ln) for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   242	
   243	
   244	def _fm(vault: Path) -> str:
   245	    import yaml
   246	
   247	    text = (vault / NODE_REL).read_text(encoding="utf-8")
   248	    return text.split("---\n")[1]
   249	
   250	
   251	def _fm_fields(vault: Path) -> dict:
   252	    """按 bridge 同款正则抽 fsrs_* 行 (值+冒号后文本)。"""
   253	    fm = _fm(vault)
   254	    out = {}
   255	    for key in ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   256	        m = re.search(rf"^{key}:\s*\"?([^\"\n]+?)\"?\s*$", fm, re.M)
   257	        if m:
   258	            out[key] = m.group(1)
   259	    return out
   260	
   261	
   262	def _run_validator(vault: Path):
   263	    return subprocess.run(
   264	        [sys.executable, str(VALIDATOR), str(vault / "learning_events.jsonl")],
   265	        capture_output=True,
   266	        text=True,
   267	        timeout=60,
   268	    )
   269	
   270	
   271	# ── 门① 同 event_id 重放两次 → frontmatter 不二次推进、账本一行 ──
   272	
   273	
   274	def test_same_event_id_replay_no_double_advance(vault):
   275	    r = _run_writer(vault, _payload())
   276	    assert r.returncode == 0, r.stdout + r.stderr
   277	    w1 = _fm_fields(vault)["fsrs_last_review"]
   278	    ledger = vault / "learning_events.jsonl"
   279	    n1 = len(_ledger_lines(vault))
   280	    # 二跑: recorded_at 变化不构成事实差异 (envelope 显式排除), 必须 no-op
  1200	    oo = doc[doc.index("**`out_of_order` 字段冻结") : doc.index("**迟到事件的入账通道**")]
  1201	    for needle in ("写点（在线 A2）侧同款语义门", "fail-closed", "被伪装成乱序的真实后继", "唯一合法值布尔 `true`"):
  1202	        assert needle in oo, f"§6.2 三态语义段缺「{needle}」— 写点侧口径未回写契约"
  1203	
  1204	
  1205	# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
  1206	# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
  1207	# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
  1208	# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
  1209	# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
  1210	
  1211	
  1212	def _strip_calibration(vault: Path) -> None:
  1213	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1214	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1215	    head, fm, body = text.split("---\n", 2)
  1216	    lines, out, skipping = fm.split("\n"), [], False
  1217	    for ln in lines:
  1218	        if ln.startswith("calibration_log:"):
  1219	            skipping = True
  1220	            continue
  1221	        if skipping and (ln.startswith("  ") or ln == ""):
  1222	            continue
  1223	        skipping = False
  1224	        out.append(ln)
  1225	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1226	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1227	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1228	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1229	
  1230	
  1231	def test_six_cell_state_machine_closed(vault):
  1232	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1233	    foreign = _review_row(event_id="quiz:板A#q1")
  1234	    _write_ledger(vault, foreign)
  1235	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z"))
  1236	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1237	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1238	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1239	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1240	
  1241	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1242	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1243	    sha_before = _sha(vault / NODE_REL)
  1244	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
  1245	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1246	    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
  1247	    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
  1248	
  1249	    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
  1250	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1251	    (vault / "learning_events.jsonl").unlink()
  1252	    assert _run_writer(vault, _payload()).returncode == 0
  1253	    sha_full = _sha(vault / NODE_REL)
  1254	    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
  1255	    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
  1256	    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
  1257	
  1258	    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
  1259	    _strip_calibration(vault)
  1260	    sha_stripped = _sha(vault / NODE_REL)
  1261	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1262	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1263	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1264	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1265	
  1266	    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
  1267	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1268	    (vault / "learning_events.jsonl").unlink()
  1269	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1270	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1271	    ema_before = {
  1272	        k: re.search(rf"^{k}:.*", _fm(vault), re.M).group(0)
  1273	        for k in ("mastery_score", "mastery_a", "mastery_b", "attempt_count")
  1274	    }
  1275	    r5 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
  1276	    assert r5.returncode == 0 and "degraded 遗留" in r5.stdout, r5.stdout + r5.stderr
  1277	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "格5: FSRS 必须补齐"
  1278	    for k, v in ema_before.items():
  1279	        assert re.search(rf"^{k}:.*", _fm(vault), re.M).group(0) == v, f"格5: {k} 不得二次吸收"
  1280	    assert len(_ledger_lines(vault)) == 1
  1281	
  1282	    # ── 格6 dup=有, f1=F, applied=F: 崩溃窗口① → 全套补齐且与直接应用字节相同
  1283	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1284	    (vault / "learning_events.jsonl").unlink()
  1285	    assert _run_writer(vault, _payload()).returncode == 0
  1286	    golden = (vault / NODE_REL).read_bytes()
  1287	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1288	    r6 = _run_writer(vault, _payload(ts="2026-09-01T10:00:00Z"))
  1289	    assert r6.returncode == 0 and "崩溃窗口" in r6.stdout, r6.stdout + r6.stderr
  1290	    assert (vault / NODE_REL).read_bytes() == golden, "格6: 恢复产物必须与直接应用逐字节相同"
  1291	    assert len(_ledger_lines(vault)) == 1
  1292	    assert _run_validator(vault).returncode == 0, "六格走完后账本仍须过校验器"
  1293	
