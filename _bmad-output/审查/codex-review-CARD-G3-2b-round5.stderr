  1432	                f"rating {rating} 与 grade_norm {grade_norm} 不自洽 (rating_from_grade 口径应为 {expected})"
  1433	            )
  1434	
  1435	    # 防御: _golden_manifest 已保证 dict|None, 此处对任意坏值也不炸
  1436	    # (round-4 MEDIUM: 非 dict manifest 曾可触发 AttributeError)
  1437	    manifest = manifest if isinstance(manifest, dict) else None
  1438	    truth_version = manifest.get("library_version") if manifest else None
  1439	    truth_hash = manifest.get("params_hash") if manifest else None
  1440	    degraded_flags = []
  1441	    for key, shape_re, shape_desc, truth in (
