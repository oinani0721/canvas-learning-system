  2220	        assert rd.returncode != 0, f"[{desc}] 带扩展键却 marker 不合规的本节点行不得被当历史行跳过"
  2221	        assert "降级绕过" in rd.stderr or "schema_ext" in rd.stderr, rd.stderr
  2222	        assert _write_face(va) == face, f"[{desc}] 零写（节点 + 账本）"
  2223	    # 验伪：**真·历史行**（无 marker 也无任何扩展键，§6.3）必须照常跳过而不报错
  2224	    (va / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2225	    legacy = {
  2235	    rl2 = _run_writer(va, _payload(event_id="历史B#q1", ts="2026-08-02T10:00:00Z"))
  2236	    assert rl2.returncode == 0, "真·历史行（§6.3）必须照常跳过: " + rl2.stderr
  2237	    assert len(_ledger_lines(va)) == 2
  2238	
  2239	
  2240	# ── 门㊴ round-4 HIGH/MEDIUM: 消费侧与校验器的**结论对照**（不是单侧断言）──
  2241	
  2242	
  2243	def test_round4_writer_validator_verdict_parity(vault):
  2244	    """同一条账本行, 写点与校验器必须给出**相同结论**。
  2245	
  2246	    单侧断言（「写点应该拒 X」）只能证明「我按我想的做了」; 两侧对照才能抓出
  2247	    口径分叉——round-4 报的 HIGH「消费侧 v1 准入不完整」与 MEDIUM「词法接收集
  2248	    分叉」都是这类: 顶层 `[]` / 缺 payload / `event_version: true`
  2249	    (`True == 1` 在 Python 里成立) / 时刻首尾带空白, 四种形态**写点 rc=0 而
  2250	    校验器 rc=1**, 全是**漏网**方向。
  2251	
  2252	    修法是消费前复用校验器本体的 `validate_record_full`, 而不是在写点里手写
  2253	    第二套判据 (DD-03/DD-13 同一条理由; 见 §6.2 A8)。
  2254	
  2255	    ⚠️ 对照的**适用范围是本节点的行**: 写点只对自己要消费的行负责, 别的节点
  2256	    的不合规行由校验器兜底, 写点不得越权阻塞 (末尾两条验伪守着这条边界)。
  2257	
  2258	    ⚠️ **这道门的鉴别力边界**(如实写明, 免得后人高估它): 它证明的是「两侧结论
  2259	    一致」, 不是「写点自己那几道手写门有用」。写点里排在 validate_record_full
  2260	    **之前**的几道手写准入 (顶层是 object / event_version 非 bool / 归属判断
  2261	    位置) 与校验器**功能重合** —— 单独删掉其中一道, 校验器仍拦住, 本门照样绿。
  2262	    实测: M49/M50 两条变异在只删手写门时 SURVIVED, 挂上「同时禁掉校验器那层」
  2263	    后才 KILLED。**门的鉴别力要靠变异去量, 不能靠读断言想当然。**
  2264	    """
  2265	    base = _review_row()
  2266	
  2267	    def _mutate(fn):
  2268	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2269	        row = json.loads(json.dumps(base))
  2270	        raw = fn(row)
  2271	        if raw is None:
  2272	            _write_ledger(vault, row)
  2273	        else:
  2274	            (vault / "learning_events.jsonl").write_text(raw, encoding="utf-8")
  2275	        # 合法行会触发两阶段发布（恢复先落定 + 要求重跑）——那是设计内的续跑
  2276	        # 信号, 不是拒绝, 所以用会自动续跑的 settled 版本判"最终写成没有"。
  2277	        w = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2278	        return w.returncode == 0, _run_validator(vault).returncode == 0, w
  2279	
  2280	    CASES = (
  2281	        ("顶层是 JSON 数组", lambda r: "[]\n"),
  2282	        ("顶层是 JSON 数字", lambda r: "12345\n"),
  2283	        ("本节点行缺 payload", lambda r: r.pop("payload") and None),
  2284	        ("event_version 为 true", lambda r: r.__setitem__("event_version", True)),
  2285	        ("review_time 首尾空白", lambda r: r["payload"].__setitem__("review_time", " 2026-08-01T10:00:00Z ")),
  2286	        ("未知顶层字段", lambda r: r.__setitem__("未知顶层", 1)),
  2287	        ("缺 fsrs_library_version", lambda r: r["payload"].pop("fsrs_library_version") and None),
  2288	        ("rating 越界为 9", lambda r: r["payload"].__setitem__("rating", 9)),
  2289	    )
  2290	    for desc, fn in CASES:
  2291	        wok, vok, w = _mutate(fn)
  2292	        assert wok == vok, f"[{desc}] 写点 ok={wok} 校验器 ok={vok} — 口径分叉: {w.stderr[:200]}"
  2293	        assert not wok, f"[{desc}] 两侧应当都拒（本例是不合规输入）"
  2294	
  2295	    # 验伪①: 完全合法的行两侧都必须放行 —— 否则「写点恒拒」也能骗过上面的对照
  2296	    wok, vok, w = _mutate(lambda r: None)
  2297	    assert wok and vok, f"合法行两侧都必须放行: writer={w.stderr[:200]}"
  2298	
  2299	    # 验伪②: **别节点**的不合规行不得阻塞本次写入（写点只管自己消费的行）
  2300	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2301	    other = json.loads(json.dumps(base))
  2302	    other["node_id"] = "别的节点"
  2303	    other["event_id"] = "quiz:别节点坏行"
  2304	    del other["payload"]
  2305	    _write_ledger(vault, other)
  2306	    r2 = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2307	    assert r2.returncode == 0, f"别节点的坏行不得越权阻塞本节点写入: {r2.stderr[:300]}"
  2308	    assert _run_validator(vault).returncode != 0, "但它仍应被校验器兜住（分层边界成立）"

