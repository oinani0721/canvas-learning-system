  1371	            f"payload.out_of_order 唯一合法值为布尔 true, 实为 {marker_value!r} — "
  1372	            "未标乱序时不得写该键 (§6.2 字段冻结: false/字符串/对象均会让 pending 排除条件产生歧义)"
  1373	        )
  1374	
  1375	    review_time = payload.get("review_time")
  1376	    ok, why = _parse_ts(review_time, upper_bound=REVIEW_INPUT_MAX)
  1377	    if not ok:
  1378	        problems.append(f"扩展键 review_time {why}")
  1379	    else:
  1380	        if _SUBSECOND_RE.match(review_time):
  1381	            problems.append(
  1382	                f"扩展键 review_time 必须为整秒 {review_time!r} — frontmatter 水位线 "
  1383	                "fsrs_last_review 只有整秒精度 (§6.2 A5), 小数秒会导致同一事件二次推进"
  1384	            )
  1385	        elif not _WHOLE_SECOND_RE.match(review_time):
  1386	            problems.append(
  1387	                f"扩展键 review_time 必须为完整整秒形态 YYYY-MM-DDTHH:MM:SS(Z|±HH:MM), "
  1388	                f"实为 {review_time!r} — 省略秒段与 W 的整秒口径对不齐 (§6.2 A5)"
  1389	            )
  1390	        left, right = _instant(review_time), _instant(record.get("effective_at"))
  1391	        if left is None or right is None or left != right:
  1392	            problems.append(
  1393	                f"扩展键 review_time {review_time!r} 与顶层 effective_at "
  1394	                f"{record.get('effective_at')!r} 不是同一瞬间 (§6.1)"
  1395	            )
  1396	
  1397	    for key in ("vault_id", "concept_id"):
  1398	        value = payload.get(key)
  1399	        if not isinstance(value, str) or not value:
  1400	            problems.append(f"扩展键 {key} 必须为非空字符串")
  1401	    declared_vault = payload.get("vault_id")
  1402	    if isinstance(declared_vault, str) and declared_vault:
  1403	        if vault_id is None:
  1404	            warnings.append("vault_id 未绑定 — 账本同目录无 .canvas-config.yaml 或其中无 vault_id 键")
  1405	        elif declared_vault != vault_id:
  1406	            problems.append(
  1407	                f"扩展键 vault_id {declared_vault!r} != 账本所在 vault 声明的 {vault_id!r} "
  1408	                "(.canvas-config.yaml) — 事件写错 vault 或账本被搬运"
  1409	            )
  1410	    concept_id = payload.get("concept_id")
  1411	    node_id = record.get("node_id")
  1412	    if isinstance(concept_id, str) and concept_id and concept_id != node_id:
  1413	        problems.append(
  1414	            f"扩展键 concept_id {concept_id!r} != 顶层 node_id {node_id!r} (§6.1 映射关系: node_id 承载 concept_id)"
  1415	        )
  1416	
  1417	    grade_norm = payload.get("grade_norm")
  1418	    grade_ok = (
  1419	        not isinstance(grade_norm, bool) and isinstance(grade_norm, (int, float)) and 0.0 <= float(grade_norm) <= 1.0
  1420	    )
  1421	    if not grade_ok:
  1422	        problems.append("扩展键 grade_norm 必须为 [0,1] 区间数值")
  1423	    if event_type == "answer_abandoned":
  1424	        if rating_ok and rating != 1:
  1425	            problems.append(
