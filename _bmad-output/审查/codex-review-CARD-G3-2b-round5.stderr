   131	def fsrs_fields(vault: Path) -> dict:
   132	    fm = (vault / NODE_REL).read_text(encoding="utf-8").split("---\n")[1]
   133	    out = {}
   134	    for k in ("fsrs_due", "fsrs_state", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   135	        m = re.search(rf'^{k}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   136	        if m:
   137	            out[k] = m.group(1)
   138	    return out
