  1681	    # ④ 分层成立（非缺陷，锁住）：fixture 脚本的写入面守卫不被 symlink 劫持。
  1682	    # ⚠️ 原写法是「源码里有 resolve() 和 MARKER 这两个词」—— 审查实测：把
  1683	    # _guard_target() 函数体整体挖空、连调用点一起删掉，两条断言**仍全真**
  1684	    # （resolve() 在该文件另有无关出现：WT = Path(__file__).resolve()...）。
  1685	    # 断言必须绑定被审对象本身：直接**调用守卫**，看它在两种攻击形态下是否拒。
  1686	    import importlib.util as _ilu
  1687	
  1688	    _spec = _ilu.spec_from_file_location(
  1689	        "g32b_build_fixture_gate", WT / "backend" / "scripts" / "g32b_build_fixture.py"
  1690	    )
  1691	    _mod = _ilu.module_from_spec(_spec)
  1692	    _spec.loader.exec_module(_mod)
  1693	    probe = Path("/private/tmp/g32b-gate-toctou-probe")
  1694	    victim = Path("/private/tmp/g32b-gate-toctou-victim")
  1695	    for p in (probe, victim):
  1696	        if p.is_symlink():
  1697	            p.unlink()
  1698	        elif p.exists():
  1699	            subprocess.run(["rm", "-rf", str(p)], check=True)
  1700	    victim.mkdir()
  1701	    _orig_root = _mod.FIXTURE_ROOT
  1702	    try:
  1703	        # ① symlink 劫持：目标是指向别处的软链 ⇒ 守卫必须拒
  1704	        probe.symlink_to(victim, target_is_directory=True)
  1705	        _mod.FIXTURE_ROOT = probe
  1706	        with pytest.raises(SystemExit) as ei:
  1707	            _mod._guard_target()
  1708	        assert "resolve" in str(ei.value) or "拒跑" in str(ei.value), str(ei.value)
  1709	        probe.unlink()
  1710	        # ② 陌生目录（无 marker）⇒ 守卫必须拒，绝不 rmtree 别人的目录
  1711	        probe.mkdir()
  1712	        (probe / "别人的重要文件.txt").write_text("不该被删", encoding="utf-8")
  1713	        _mod.FIXTURE_ROOT = probe
  1714	        with pytest.raises(SystemExit) as ei2:
  1715	            _mod._guard_target()
  1716	        assert "标记文件" in str(ei2.value) or "拒绝删除" in str(ei2.value), str(ei2.value)
  1717	        assert (probe / "别人的重要文件.txt").exists(), "守卫拒跑时不得动目标目录"
  1718	        # ③ 验伪：带 marker 的自己的目录必须放行（否则这门是「恒拒」的假门）
  1719	        (probe / _mod.MARKER).write_text("x", encoding="utf-8")
  1720	        _mod._guard_target()
  1721	    finally:
  1722	        _mod.FIXTURE_ROOT = _orig_root
  1723	        if probe.is_symlink():
  1724	            probe.unlink()
  1725	        else:
  1726	            subprocess.run(["rm", "-rf", str(probe)], check=True)
  1727	        subprocess.run(["rm", "-rf", str(victim)], check=True)
