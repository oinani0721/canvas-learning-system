  1401	def test_self_audit_coverage_gaps(vault):
  1402	    import subprocess
  1403	    import unicodedata
  1404	
  1405	    # ① 分层防线的另一半：门㉕ 只测「篡改身份键的值」，没测「删掉整个键」。
  1406	    # 删键后 envelope 照样放行（两键排除出等价面 = 有意），必须由 validator 兜住。
  1407	    r = _run_writer(vault, _payload())
  1408	    assert r.returncode == 0, r.stdout + r.stderr
  1409	    base = _ledger_lines(vault)[0]
  1410	    assert _run_validator(vault).returncode == 0, "基线：完整行必须过校验器"
  1411	    for key in ("fsrs_library_version", "fsrs_params_hash"):
  1412	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1413	        dropped = json.loads(json.dumps(base))
  1414	        dropped["payload"].pop(key)
  1415	        _write_ledger(vault, dropped)
  1416	        rw = _run_writer(vault, _payload())
  1417	        # round-4 后：消费前复用校验器本体做完整 v1 校验，所以缺键在**写点侧**
  1418	        # 就被拦，两侧同口径（此前是「写点放行 + 校验器兜底」的分层）。
  1419	        assert rw.returncode != 0, f"删 {key} 后必须在消费前拒"
  1420	        assert "未通过校验器的 v1 记录校验" in rw.stderr, rw.stderr
  1421	        v = _run_validator(vault)
  1422	        assert v.returncode != 0, f"校验器同样拦下 {key}（两侧同口径）"
  1423	        assert key in v.stdout, v.stdout[:300]
  1424	
  1425	    # ② Unicode 归一化差异必须构成冲突。
  1426	    # ⚠️ 首版探针用汉字节点名做 NFD 变异，结果「放行」——那是**假阴性**：
  1427	    # 汉字没有分解形式，NFD(s) == s，变异根本没改字节。必须用有分解形式的字符。
  1428	    assert unicodedata.normalize("NFD", "测试节点") == "测试节点", "汉字无分解形式（本断言防后人重蹈）"
  1429	    nfc_name = "café笔记"
  1430	    assert unicodedata.normalize("NFD", nfc_name) != nfc_name, "fixture 前提：该名字必须真有分解形式"
  1431	    node2 = f"节点/{nfc_name}.md"
  1432	    (vault / node2).write_text(NODE_V0, encoding="utf-8")
  1433	    (vault / "learning_events.jsonl").unlink()
  1434	    r2 = _run_writer(vault, _payload(node=node2, event_id="nfd#q1"))
  1435	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1436	    base2 = _ledger_lines(vault)[0]
  1437	    (vault / node2).write_text(NODE_V0, encoding="utf-8")  # 崩溃窗口①
  1438	    nfd = json.loads(json.dumps(base2))
  1439	    nfd["node_id"] = unicodedata.normalize("NFD", nfd["node_id"])
  1440	    nfd["payload"]["concept_id"] = unicodedata.normalize("NFD", nfd["payload"]["concept_id"])
  1441	    assert nfd["node_id"] != base2["node_id"], "变异必须真的改变了字节"
  1442	    _write_ledger(vault, nfd)
  1443	    r3 = _run_writer(vault, _payload(node=node2, event_id="nfd#q1"))
  1444	    assert r3.returncode != 0 and "envelope 冲突" in r3.stderr, r3.stderr
  1445	
  1446	    # ③ payload 键顺序不同**不得**构成冲突（canonical 用 sort_keys，顺序不是事实差异）
  1447	    (vault / node2).write_text(NODE_V0, encoding="utf-8")
  1448	    reordered = json.loads(json.dumps(base2))
  1449	    reordered["payload"] = dict(reversed(list(reordered["payload"].items())))
  1450	    assert list(reordered["payload"]) != list(base2["payload"]), "fixture 前提：顺序必须真的变了"
  1451	    _write_ledger(vault, reordered)
  1452	    r4 = _run_writer(vault, _payload(node=node2, event_id="nfd#q1"))
  1453	    assert r4.returncode == 0, "键顺序不是事实差异，不得误报冲突: " + r4.stderr
  1454	
  1455	    # ④ attempt 序数复算成负值时必须 fail-closed（f1=T 但 attempt_count 被人手删）
  1456	    v3 = vault
  1457	    (v3 / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1458	    (v3 / "learning_events.jsonl").unlink()
  1459	    assert _run_writer(v3, _payload()).returncode == 0
  1460	    assert (
  1461	        _run_writer(v3, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md")).returncode
  1462	        == 0
  1463	    )
  1464	    text = (v3 / NODE_REL).read_text(encoding="utf-8")
  1465	    (v3 / NODE_REL).write_text(re.sub(r"^attempt_count:.*\n", "", text, flags=re.M), encoding="utf-8")
  1466	    _face_neg = _write_face(v3)
  1467	    r5 = _run_writer(v3, _payload(ts="2026-09-01T12:00:00Z"))
  1468	    assert r5.returncode != 0, "attempt 期望值算成负数时必须 fail-closed，不得放行"
  1469	    assert _write_face(v3) == _face_neg, "零写（节点 + 账本）"
  1470	
  1471	    # ⑤ 同节点两个适用事件 review_time 完全相同 → 按行号稳定全序，两条都重放
  1472	    v4 = vault
  1473	    (v4 / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1474	    a = _review_row(event_id="quiz:板A#q1", **{"payload.review_time": TS1})
  1475	    b = _review_row(event_id="quiz:板B#q1", **{"payload.review_time": TS1, "payload.attempt_count": 2})
  1476	    _write_ledger(v4, a, b)
  1477	    r6 = _run_writer_settled(v4, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z"))
  1478	    assert r6.returncode == 0, r6.stdout + r6.stderr
  1479	    replayed = [ln for ln in r6.stdout.splitlines() if "A2 重放已应用" in ln]
  1480	    assert len(replayed) == 2, f"同时刻两事件都应被重放，实得 {len(replayed)}: {replayed}"
  1481	    assert "板A" in replayed[0] and "板B" in replayed[1], f"全序必须按行号稳定: {replayed}"
  1482	
  1483	    # ⑥ 整秒门放行的宽松字面量必须都归一到**同一个** UTC 整秒瞬间
  1484	    # （小写 t / 空格分隔 / -00:00 都是合法 ISO 写法，语义等价，放行无害）
