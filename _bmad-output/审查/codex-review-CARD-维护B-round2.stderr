  1450	        for i, h in enumerate(heads):
  1451	            end = heads[i + 1].start() if i + 1 < len(heads) else len(text)
  1452	            parts.append((h.group(0).lstrip("# ").strip(), text[h.end() : end]))
  1453	    else:
