  2213	def _parse_skill_tail_notes(skill_text: str) -> list[str]:
  2214	    """从 SKILL.md ③段铁律里解析**信号行尾部注记**封闭表（CARD-维护B-R2 (e)）。"""
  2215	    idx = skill_text.find("附注只许")
  2216	    if idx < 0:
  2217	        return []
  2218	    for line in skill_text[idx:].splitlines()[1:]:
  2219	        toks = re.findall(r"`([^`\n]+)`", line)
  2220	        if toks:
  2221	            return toks
  2222	    return []
