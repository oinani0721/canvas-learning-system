   166	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   167	            return 2
   168	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   169	
   170	        failures = 0
   171	        for name, subs, keyword in MUTANTS:
   172	            text = original.decode("utf-8")
   173	            for old, new in subs:
   174	                if old not in text:
   175	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   176	                    failures += 1
   177	                    text = None
   178	                    break
   179	                text = text.replace(old, new, 1)
   180	            if text is None:

