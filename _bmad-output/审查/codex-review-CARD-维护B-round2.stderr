   116	
   117	def write_node(
   118	    vault: Path,
   119	    name: str,
   120	    *,
   121	    source_note: str | None = None,
   122	    derived_from: str | None = None,
   123	    tips: list[dict] | None = None,
   124	    stub: bool = False,
   125	) -> None:
   126	    fm = ["---", "type: concept", f'source_board: "[[原白板/{BOARD}]]"']
   127	    if source_note:
   128	        fm.append(f'source_note: "{source_note}"')
   129	    if derived_from:
   130	        fm.append(f'derived-from: "{derived_from}"')
   131	    if tips:
   132	        fm.append("tips:")
   133	        for t in tips:
   134	            fm.append(f"  - text: {t['text']}")
   135	            if t.get("added_at"):
   136	                fm.append(f"    added_at: {t['added_at']}")
   137	            if t.get("understanding"):
   138	                fm.append(f"    understanding: {t['understanding']}")
   139	    fm.append("---")
   140	    body = f"# {name}\n\n## 核心概念\n\n"
   141	    body += "（你的 1-2 句精准定义。）\n" if stub else "已有正文。\n"
   142	    (vault / "节点" / f"{name}.md").write_text("\n".join(fm) + "\n" + body, encoding="utf-8")
   143	
   144	
   145	def build_vault(tmp_path: Path, members: list[str]) -> Path:
   146	    vault = tmp_path / "vault"
   147	    for sub in ("原白板", "节点", "outputs"):
   148	        (vault / sub).mkdir(parents=True)
   149	    links = "\n".join(f"- [[节点/{m}]]" for m in members)
   150	    (vault / "原白板" / f"{BOARD}.md").write_text(
   151	        f"---\ntype: whiteboard\nboard_name: {BOARD}\n---\n\n# {BOARD}\n\n## Concepts\n\n{links}\n",
   152	        encoding="utf-8",
   153	    )
   154	    return vault
   155	
   156	
   157	def standard_vault(tmp_path: Path) -> Path:
   158	    """3 成员: 种子无 provenance + 派生带 source_note + 派生缺 source_note。"""
   159	    vault = build_vault(tmp_path, ["SeedA", "DerivedB", "DerivedC"])
   160	    write_node(
   161	        vault,
   162	        "SeedA",
   163	        tips=[
   164	            {"text": "What is X", "added_at": _ts(11)},
   165	            {"text": "what   is x", "added_at": _ts(5)},
   166	        ],
   167	    )
   168	    write_node(
   169	        vault,
   170	        "DerivedB",
   171	        source_note="[[节点/SeedA|别名]]",
   172	        derived_from="[[SeedA]]",
   173	        tips=[
   174	            {"text": "What is X", "added_at": _ts(2)},
   175	            {"text": "unique question", "added_at": "not-a-date"},
   176	        ],
   177	        stub=True,
   178	    )
   179	    write_node(vault, "DerivedC", derived_from="[[SeedA]]")
   180	    return vault
