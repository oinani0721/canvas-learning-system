  2678	def test_domain_skill_sync_signal_tail_notes_table():
  2679	    """e3 表锁: `_SIGNAL_TAIL_NOTES` 与 SKILL.md ③段铁律的附注表必须全等 + 篡改门。
  2680	
  2681	    **它证明什么**: 代码侧注记表与文档侧逐字同序一致，单侧改动即红。
  2682	    **它不证明什么**: 不证明表内短语在运行时真的放行（e1）或表外真的被拦（e2）。
  2683	    """
  2684	    rs = _load_recap_scan()
  2685	    skill_text = SKILL_MD.read_text(encoding="utf-8")
  2686	    parsed = _parse_skill_tail_notes(skill_text)
  2687	    assert parsed, "SKILL.md 里解析不到信号行附注表"
  2688	    assert tuple(parsed) == rs._SIGNAL_TAIL_NOTES, (
  2689	        f"代码与 SKILL.md 的附注表不同步:\n  代码 = {rs._SIGNAL_TAIL_NOTES}\n  SKILL = {tuple(parsed)}"
  2690	    )
  2691	    note_line = next(
  2692	        ln for ln in skill_text[skill_text.find("附注只许") :].splitlines()[1:] if re.findall(r"`([^`\n]+)`", ln)
  2693	    )
  2694	    for name, bad_line in {
  2695	        "多一项": note_line.replace("`口径一致`", "`口径一致` / `另有仨条`", 1),
  2696	        "改文案": note_line.replace("`口径一致`", "`口径不一致`", 1),
  2697	    }.items():
  2698	        bad = skill_text.replace(note_line, bad_line, 1)
