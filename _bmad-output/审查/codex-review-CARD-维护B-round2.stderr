  1326	def _scan_number_pool(obj, pool: set[int]) -> None:
  1327	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1328	
  1329	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1330	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1331	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1332	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1333	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1334	    """
  1335	    if isinstance(obj, bool):
  1336	        return
  1337	    if isinstance(obj, int):
  1338	        pool.add(obj)
  1339	    elif isinstance(obj, float):
  1340	        if obj.is_integer():
  1341	            pool.add(int(obj))
  1342	    elif isinstance(obj, dict):
  1343	        for v in obj.values():
  1344	            _scan_number_pool(v, pool)
  1345	    elif isinstance(obj, list):
  1346	        for v in obj:
  1347	            _scan_number_pool(v, pool)
