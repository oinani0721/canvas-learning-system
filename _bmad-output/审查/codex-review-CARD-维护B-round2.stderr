   910	def _verify_signal_schema(key: str, sig, problems: list[str]) -> bool:
   911	    """signals.<key> 子对象 schema fail-closed (Codex round-2 M2)。
   912	
   913	    只校验顶层 signals 是 dict 不够 — 把子对象削成 {"availability":"无据"}
   914	    就能让报告写四条"无据"蒙混过关。必需五键齐全 / availability 属枚举 /
   915	    无据 ⇒ value is None 且 denominator == 0 / 有数 ⇒ value 是整数。
   916	    """
   917	    if not isinstance(sig, dict):
   918	        problems.append(f"数字终核: scan JSON signals.{key} 形状损坏")
   919	        return False
   920	    missing = [f for f in _SIGNAL_REQUIRED_FIELDS if f not in sig]
   921	    if missing:
   922	        problems.append(f"数字终核: signals.{key} 缺必备字段 {missing}")
   923	        return False
   924	    avail = sig.get("availability")
   925	    if avail not in _AVAIL_ENUM:
   926	        problems.append(f"数字终核: signals.{key}.availability 非法值 {avail!r}")
   927	        return False
   928	    if avail == AVAIL_NODATA:
   929	        if sig.get("value") is not None or sig.get("denominator") != 0:
   930	            problems.append(f"数字终核: signals.{key} 标无据却带数值 (契约违反)")
   980	    """
   981	    out: list[str] = []
   982	    fence: str | None = None  # 开栏的完整标记, 如 "````"
   983	    # ⛔ Codex round-1 BLOCKER-1: 只比字符与长度**仍不是** CommonMark ——
   984	    # 闭栏行在标记之后**只能有空白**(`` ````not-a-valid-close `` 不是闭栏),
   985	    # 且围栏行缩进最多三格 (四格起是缩进代码块)。少这两条时,
   986	    # ````text 后跟一个带 info string 的伪闭栏就能让后续信号行"看起来在块外",
   987	    # 而 CommonMark 渲染里它们全在 <pre><code> 内 —— 实测 exit 0。
   988	    open_re = re.compile(r"^(?P<ind> {0,3})(?P<fence>`{3,}|~{3,})")
   989	    close_re = re.compile(r"^ {0,3}(?P<fence>`{3,}|~{3,})[^\S\n]*$")
   990	    for ln in text.splitlines():
   991	        # 剥任意层引用前缀后再判围栏
   992	        bare = re.sub(r"^[>\s]*", "", ln)
   993	        if fence is None:
   994	            m = open_re.match(bare)
   995	            # 反引号围栏的 info string 不得含反引号 (CommonMark);
   996	            # 波浪线围栏无此限制。
   997	            if m and not (m.group("fence")[0] == "`" and "`" in bare[m.end() :]):
   998	                fence = m.group("fence")
   999	                out.append("")
  1000	                continue
  1001	        else:
  1002	            mc = close_re.match(bare)
  1003	            # 闭合: 同字符 + 长度 ≥ 开栏 + 其后只有空白
  1004	            if (
  1005	                mc
  1006	                and mc.group("fence")[0] == fence[0]
  1007	                and len(mc.group("fence")) >= len(fence)
  1008	            ):
  1009	                fence = None
  1010	            out.append("")
  1011	            continue
  1012	        out.append(ln)
  1013	    return "\n".join(out)
  1014	
