   130	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   131	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   132	
   133	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   134	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   135	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   136	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   137	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   138	    要求"确实收集到用例"且"确实有失败"才算变红。
   139	    """
   140	    r = subprocess.run(
   141	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   142	        cwd=ROOT / "backend",
   143	        capture_output=True,
   144	        text=True,
   145	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   146	        timeout=600,
   147	    )
   148	    out = r.stdout
   149	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   150	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   151	    return r.returncode, out[-400:], passed + failed, failed
   152	
