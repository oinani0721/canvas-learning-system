  2349	def test_domain_strip_code_blocks_unit_contract():
  2350	    """c2 · S3 承重门②「`_strip_code_blocks` 单元契约门」: 直接调函数验双向行为。
  2351	
  2352	    行为门（c1）走整条 verifier，误伤面与拦截面都可能被别的规则掩盖；
  2353	    这道单元门把契约钉在函数本身：**任意层引用前缀**下的围栏整块剥空，
  2354	    而**合法的多层引用列表**与四空格三级列表一个字都不许动。
  2355	
  2356	    **它证明什么**: 该函数对 2/3 层引用围栏整块置空、对两类合法结构零改动。
  2357	    **它不证明什么**: 不证明调用方（`_verify_signal_lines` / `_verify_prose_counts`）
  2358	    正确使用了它——那是 c1 与 D2 门的事。
  2359	    """
  2360	    rs = _load_recap_scan()
  2361	    # 卡文点名的字面反例（S3 survivor 的逃逸形态）: `> > ``` 三行必须全部变空
  2362	    literal = "> > ```\n> > x\n> > ```"
  2363	    got = rs._strip_code_blocks(literal)
  2364	    # ⚠️ 必须用 split("\n") 不能用 splitlines(): 三行全空时结果是 "\n\n",
  2365	    # splitlines() 只给两项（末尾换行后无内容），断言会**因构造错误而红**
  2366	    # ——第一次写就踩了，如实留注。
  2367	    assert got.split("\n") == ["", "", ""], f"两层引用围栏未整块剥空: {got!r}"
  2368	    for depth in (3,):
  2369	        p = "> " * depth
  2370	        src = f"{p}```\n{p}藏起来的正文\n{p}```"
  2371	        got = rs._strip_code_blocks(src)
  2372	        assert got.split("\n") == ["", "", ""], f"{depth} 层引用围栏未整块剥空: {got!r}"
  2373	    # 正向对照（误伤锁）: 合法结构一个字都不许动
  2374	    for legit in (
  2375	        "> > - 合法二级引用列表",
  2376	        "- 一级\n  - 二级\n    - 三级列表（四空格缩进，合法 Markdown）",
  2377	    ):
  2378	        assert rs._strip_code_blocks(legit) == legit, f"合法结构被误剥: {legit!r}"
