  2475	def test_domain_derive_allow_entries_are_grounded(tmp_path):
  2476	    """d2 · S4 承重门②「允许式绑定结构门」: 每条允许式都必须有**可验证的依据**。
  2477	
  2478	    d1 拦的是"表外的句子"，d2 拦的是"往表里塞一条没有依据的模式"——
  2479	    后者才是 survivor 的实际形态（改的是实现，不是报告）。
  2480	    逐条判据:
  2481	      · `scan:<路径>` → 该路径必须能在**真实** scan JSON 里解析到；
  2482	      · `md:heading`  → 模式必须以 `^#{1,6}` 起（真的是在匹配标题结构）；
  2483	      · `skill:action-verb` → 模式必须含 SKILL HARD-CONSTRAINTS 白名单动词之一；
  2484	      · `skill:③段固定句式` → 归口 SKILL.md ③段模板/叙述句式；
  2485	      · 且**每条**模式至少匹配一条 SKILL 模板正例、且**不匹配** d1 反例集里的任何一行。
  2486	
  2487	    最后一条是关键: 「备注：…派生…」这类自由允许式无论挂什么依据，
  2488	    都会因为"匹配到了 d1 反例"而变红。
  2489	
  2490	    **它证明什么**: 表内 8 条允许式各有可解析的依据、都在匹配真实模板形态、
  2491	    且没有一条会顺带放行 d1 的越界语料。
  2492	    **它不证明什么**: 不证明这 8 条**穷尽**了合法形态（漏一条合法形态表现为误伤，
  2493	    由 live/合成真语料放行门守）；`skill:③段固定句式` 的依据是**语义归口**，
  2494	    不是与 SKILL.md 的逐字比对（SKILL.md:203 原文无「角色」二字，逐字锁会锁错）。
  2495	    """
  2496	    rs = _load_recap_scan()
  2497	    scan = collect_json(standard_vault(tmp_path))
  2498	    table = rs._FALLBACK_DERIVE_ALLOW
  2499	    assert len(table) >= 8, f"允许式表条目数异常: {len(table)}"
  2500	    for pattern, basis in table:
  2501	        if basis.startswith("scan:"):
  2502	            node = scan
  2503	            for part in basis[len("scan:") :].split("."):
  2504	                assert isinstance(node, dict) and part in node, (
  2505	                    f"依据 {basis!r} 在真实 scan JSON 里解析不到（到 {part!r} 断链）"
  2506	                )
  2507	                node = node[part]
  2508	        elif basis == "md:heading":
  2509	            assert pattern.pattern.startswith("^#{1,6}"), f"依据声明为标题结构，模式却不是标题锚定: {pattern.pattern!r}"
  2510	        elif basis == "skill:action-verb":
  2511	            # ⚠️ 白名单动词在模式里是**正则转义**过的（`Cmd\+Shift\+D`），
  2512	            # 裸子串比对会恒假 —— 这条断言第一次写就因此变红，如实留注。
  2513	            assert any(v in pattern.pattern or re.escape(v) in pattern.pattern for v in rs._VERIFY_ACTION_VERBS), (
  2514	                f"依据声明为 SKILL 白名单动词，模式里却没有任何白名单动词: {pattern.pattern!r}"
  2515	            )
  2516	        elif basis == "skill:③段固定句式":
  2517	            assert "派生角色成员" in pattern.pattern, (
  2518	                f"依据声明为 ③段固定句式，模式却不含该句式的锚: {pattern.pattern!r}"
  2519	            )
  2520	        else:
  2521	            pytest.fail(f"未知依据类型 {basis!r} —— 新增允许式必须带可验证依据")
  2522	        assert any(pattern.match(p) for p in D2_SKILL_POSITIVES), (
  2523	            f"允许式 {pattern.pattern!r} 匹配不到任何 SKILL 模板正例（它在放行什么？）"
  2524	        )
  2525	        for neg in D1_NEGATIVES:
  2526	            assert not pattern.match(neg), f"允许式 {pattern.pattern!r}（依据 {basis}）放行了越界语料: {neg!r}"
  2527	
