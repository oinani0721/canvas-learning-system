  2196	def _parse_skill_nodata_reasons(skill_text: str) -> list[str]:
  2197	    """从 SKILL.md ③段铁律里解析五条无据原因（顺序保留）。
  2198	
  2199	    ⛔ 解析必须真的读文件：返回常量的"解析器"会让同步锁恒绿（假门）。
  2200	    锚点是铁律原文「原因只能逐字取自下列」，其后**第一条**全部由反引号项
  2201	    与 `/` 组成的行即原因表行；找不到就返回空表（让比对失败并点名），
  2202	    ⛔ 不静默回退成"就当它们相等"。
  2203	    """
  2204	    idx = skill_text.find("原因只能逐字取自下列")
  2205	    if idx < 0:
  2206	        return []
  2207	    for line in skill_text[idx:].splitlines()[1:]:
  2208	        if re.fullmatch(r"\s*`[^`\n]+`(?:\s*/\s*`[^`\n]+`)+\s*", line):
  2209	            return re.findall(r"`([^`\n]+)`", line)
  2210	    return []
  2211	
