  1860	        # (无论措辞, 同义改写也一样) 都是越界内容, 词表补丁竞赛到此为止。
  1861	        leftover = acts.group(1)
  1862	        for it in items:
  1863	            leftover = leftover.replace(it, "")
  1864	        stray = [ln.strip() for ln in leftover.splitlines() if ln.strip()]
