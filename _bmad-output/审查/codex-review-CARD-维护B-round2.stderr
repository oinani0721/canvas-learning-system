  1457	        # 子串匹配下 `## 附录（数据来源与新鲜度）` 也算出域 —— 把豁免段名塞进任意标题
  1458	        # 的非开头位置就能整段免检, 而报告别处的重复段检查是前缀锚定的, 两者错位。
  1459	        # 与 _SECTION_RE 同口径: 段名开头相符 + 其后只能是空白或全角括号补充说明。
  1460	        if any(
  1461	            re.match(rf"^{re.escape(ex)}(?:[\s（(]|$)", sec)
  1462	            for ex in _D2_EXEMPT_SECTIONS
  1463	        ):
  1464	            continue
  1465	        # E2/E3/E4/E5: 结构性跨度挖空 (等长替换, 保持行内偏移不乱)
  1466	        for rx in (_D2_INLINE_CODE_RE, _D2_WIKILINK_RE, _D2_TIME_RE):
  1467	            body = rx.sub(lambda mm: " " * len(mm.group(0)), body)
  1468	        body = _D2_ORDERED_LIST_RE.sub(
  1469	            lambda mm: mm.group(1) + "  " + mm.group(2), body
  1470	        )
  1471	        for line in body.splitlines():
  1472	            # 全角数字归一 (等长, 偏移不变): `９８７６５４ 个` 与 `987654 个` 同义,
  1473	            # 换个写法不该换来免检。
  1474	            line = line.translate(_FULLWIDTH_DIGITS)
  1475	            # ⛔ 对抗审查 HIGH: 千分位与前导零把量级洗掉 —— `999,016 个` 只会被切成
  1680	            "数字终核: 未找到『## AI 侧对账』段 (标题须为段名本身或段名+（补充）) "
  1681	            "— tips 两数无法绑定"
  1682	        )
