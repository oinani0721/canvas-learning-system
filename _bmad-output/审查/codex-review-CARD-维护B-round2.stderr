  2307	def _wrap_signals_in_fence(text: str, prefix: str) -> str:
  2308	    """把四条信号行整体包进 `<prefix>``` … <prefix>``` `，信号行同层前缀。"""
  2309	    lines = text.splitlines()
  2310	    idx = [i for i, ln in enumerate(lines) if any(lb in ln for lb in SIGNAL_LABELS)]
  2311	    start, end = idx[0], idx[-1]
  2312	    body = [prefix + re.sub(r"^[>\s]*", "", lines[i]) for i in range(start, end + 1)]
  2313	    out = lines[:start] + [prefix + "```"] + body + [prefix + "```"] + lines[end + 1 :]
  2314	    return "\n".join(out)
  2315	
