   120	  echo "--- diff (before vs after) ---"
   121	  diff <(echo "${BEFORE}") <(echo "${AFTER}") || true
   122	  exit 1
   123	fi
   124	
   125	echo "RUNTIME-FILES: unchanged"
   126	exit "${CMD_RC}"

