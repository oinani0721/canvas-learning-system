   665	# ═══════════════════════════════════════════════════════════════════════════════
   666	# L5-#2 Regression: Neo4j Mode-Aware Probe (Plan v25 Option C)
   667	# Pattern source: app/services/memory_service.py:969-987 (Story 30.3 fix)
   668	# ═══════════════════════════════════════════════════════════════════════════════
   669	
   670	
   671	class TestHealthCheckNeo4jFallback:
   672	    """
   673	    L5-#2 regression: components.neo4j must distinguish 4 states:
   674	    NEO4J + ping ok / NEO4J + ping fail / JSON_FALLBACK / not_initialized.
   675	
   676	    Pattern source: app/services/memory_service.py:969-987
   677	
   678	    Bug history: previously the health endpoint only checked stats["initialized"],
   679	    so JSON_FALLBACK mode (initialized=True, mode=JSON_FALLBACK) would dispatch
   680	    RETURN 1 AS ping to _run_query_json_fallback, which silently no-ops instead
   681	    of raising. That produced a false-positive components.neo4j == "ok" even
   682	    though Neo4j was unreachable.
   683	    """
   684	
   685	    def _patch_neo4j_client(self, monkeypatch, stats: dict, run_query=None):
   686	        """Inject a fake Neo4jClient into the get_neo4j_client factory."""
   687	        from app.clients import neo4j_client as nc_module
   688	
   689	        class _FakeClient:
   690	            def __init__(self) -> None:
   691	                self.stats = stats
   692	
   693	            async def run_query(self, q):
   694	                if run_query is None:
   695	                    return [{"ping": 1}]
   696	                return await run_query(q)
   697	
   698	        monkeypatch.setattr(nc_module, "get_neo4j_client", lambda: _FakeClient())
   699	
   700	    def test_neo4j_real_ok(self, client: TestClient, monkeypatch):
   701	        """Real NEO4J mode + healthy + ping success → 'ok'."""
   702	        self._patch_neo4j_client(
   703	            monkeypatch,
   704	            stats={"initialized": True, "mode": "NEO4J", "health_status": True},
   705	        )
   706	        resp = client.get("/api/v1/health")
