   132	            stale = gen != self.current_gen
   133	            if stale:
   134	                # 过期 context 副本（用例已结束/豁免已被撤销）—— fail-closed
   135	                owner = _UNKNOWN_OWNER
   136	                exempt = False
   137	            rec = {
   138	                "address": repr(address),
   139	                "thread": threading.current_thread().name,
   140	                "owner": owner,
   141	                "exempt": exempt,
   142	            }
   143	            self.total += 1
   144	            self.records.append(rec)
   145	            if exempt:
   146	                self.advisory += 1
   147	                return False
   148	            self.blocked += 1
   149	            self.pending.setdefault(owner, []).append(rec)
   150	            return True
   151	
   152	    def take(self, owner: str) -> list[dict]:
   153	        with self._lock:
   154	            records = self.pending.pop(owner, [])
   155	            self.billed += len(records)
   156	            return records
   157	
   158	    def unaccounted_blocked(self) -> list[dict]:
   159	        """到死没被任何用例结账的 blocked 记录（迟到线程 / collection 期 / 未知线程）。
   160	
   161	        每条 blocked 记录都会先落 ``pending[owner]``；哨兵 ``take()`` 时迁出并计入
   162	        ``billed``。所以 session 结束时仍留在 ``pending`` 里的，就是无人买单的账。
   163	        """
   164	        with self._lock:
   165	            return self._unaccounted_locked()
   166	
   167	    def _unaccounted_locked(self) -> list[dict]:
   168	        """``self._lock`` 已持有的前提下取无人买单的账（不可重入锁，禁止嵌套获取）。"""
   169	        return [rec for records in self.pending.values() for rec in records]
   170	
   171	    def summary_line(self) -> str:
   172	        with self._lock:
   173	            unaccounted = len(self._unaccounted_locked())
   174	            return (
   175	                f"{_SUMMARY_PREFIX}={self.total} "
   176	                f"(blocked={self.blocked}, advisory={self.advisory}, "
   177	                f"unaccounted={unaccounted})"
   178	            )
   179	
   180	
   181	STATE = _GuardState()
   182	
   183	
   184	def begin_item(owner: str, exempt: bool) -> None:
   185	    """标记「现在起到 end_item 之间的连接归属 owner」（ContextVar，portal 线程可见）。"""
   186	    with STATE._lock:
   187	        STATE.current_gen = STATE._next_gen
   188	        STATE._next_gen += 1
   189	        gen = STATE.current_gen
   190	    _OWNER_CV.set(owner)
   191	    _EXEMPT_CV.set(exempt)
   192	    _GEN_CV.set(gen)
   193	
   194	
   195	def end_item() -> None:
   196	    """结束归属：主线程上下文复位 + 换代——旧 context 副本（含豁免票）立即作废。"""
   197	    with STATE._lock:
   198	        STATE.current_gen = STATE._next_gen
   199	        STATE._next_gen += 1
   200	    _OWNER_CV.set(_UNKNOWN_OWNER)
   201	    _EXEMPT_CV.set(False)
   202	    _GEN_CV.set(-1)
   203	
   204	
   205	# ═══════════════════════════════════════════════════════════════════════════
   206	# 端口提取 + 包装
   207	# ═══════════════════════════════════════════════════════════════════════════
   208	
   209	
   210	def extract_port(address) -> int | None:
   211	    """从 socket 地址里取端口。
   212	
   213	    IPv4 是 2 元组 ``('127.0.0.1', 7691)``；IPv6 是 4 元组
   214	    ``('::1', 7691, 0, 0)`` —— 2026-09-01 实测 neo4j 驱动走的正是 IPv6 四元组，
   215	    只按 ``len(address) == 2`` 判会**整条漏掉**。
   216	    AF_UNIX（str/bytes 地址）与其它协议族返回 None（不在本门射程）。
   217	    """
   218	    if isinstance(address, tuple) and len(address) >= 2:
   219	        port = address[1]
   220	        if isinstance(port, int):
   221	            return port
   222	    return None
   223	
   224	
   225	def _block_message(address) -> str:
   226	    return (
   227	        f"{BLOCK_REASON}: {address!r}. "
   228	        f"受拦端口 {sorted(BLOCKED_PORTS)} 是现网 Neo4j；测试进程不得连接。"
   229	        f"若这是端点测试，请用 backend/tests/support/lifespan.py::no_lifespan "
   230	        f"关掉 app.main 的 lifespan；若确需真库，用测试容器 "
   231	        f"NEO4J_TEST_URI(7692) 并打 integration/real_neo4j marker。"
   232	    )
   233	
   234	
   235	def _guarded_connect(sock_self, address):
   236	    if extract_port(address) in BLOCKED_PORTS:
   237	        if STATE.record(address):
   238	            raise RuntimeError(_block_message(address))
   239	    return STATE._orig_connect(sock_self, address)
   240	
   241	
   242	def _guarded_connect_ex(sock_self, address):
   243	    """``connect_ex`` 正常返回 errno 而不抛；这里**故意抛**。
   244	
   245	    fail-closed 优先于 API 形状：一个用 connect_ex 探活现网库的调用方，
   246	    拿到 errno 会静默走降级分支，那正是本卡要消灭的「静默连库」。
   247	    """
   248	    if extract_port(address) in BLOCKED_PORTS:
   249	        if STATE.record(address):
   250	            raise RuntimeError(_block_message(address))
   251	    return STATE._orig_connect_ex(sock_self, address)
   252	
   253	
   254	def poison_uvloop() -> None:
   255	    """把 ``import uvloop`` 在本进程内变成 ``ImportError``。
   256	
   257	    uvloop 的 connect 走 libuv，绕过 ``socket.socket.connect`` —— 与其事后
   258	    检查「有没有人用了 uvloop」（Codex round-1 HIGH：时序上拦不住先装门后
   259	    导入），不如直接关死这扇门。本 venv 的 uvloop 全仓零引用，误伤面为零；
   260	    若未来确需 uvloop，必须连本门一起重新设计（下沉到 uvloop/OS 层）。
   261	    """
   262	    if "uvloop" not in sys.modules:
   263	        sys.modules["uvloop"] = None  # type: ignore[assignment] — import 时即 ImportError
   264	        for mod_name in [m for m in sys.modules if m.startswith("uvloop.")]:
   265	            sys.modules[mod_name] = None  # type: ignore[assignment]
   266	
   267	
   268	def install() -> None:
   269	    """装门 + 毒化 uvloop。幂等——重复调用不会把包装函数当成原函数存起来。
   270	
   271	    patch 目标是 ``_socket.socket``（= ``socket.SocketType`` 基类本体）而不是
   272	    ``socket.socket`` 子类：Python 3.14 的 ``socket.SocketType`` 就是未包装的
   273	    ``_socket.socket``，只 patch 子类会漏掉直接用基类/SocketType 的调用方
   274	    （Codex round-2 HIGH 实测）。子类没有自己的 connect 定义，基类 patch 对
   275	    全部子类生效。
   276	
   277	    ⚠️ 装=不卸：本门**只装不卸**（uninstall 仅为 API 完整保留，生产代码路径
   278	    不调用）。CLI 测试进程的迟到线程在 ``pytest_unconfigure`` 之后仍可能发起
   279	    连接（Codex round-2 HIGH 实测），先恢复 socket 再结账会留下无账窗口——
   280	    门随进程存活到退出，这是有意为之。
   281	    """
   282	    uvloop_mod = sys.modules.get("uvloop")
   283	    if uvloop_mod is not None:
   284	        # install 前就被人 import 了：collection/import 窗口已经不受保护，
   285	        # 宁可立刻 fail 也不装一道已知失效的门（Codex round-2 HIGH）。
   286	        raise RuntimeError(
   287	            "uvloop 在 install() 之前已被导入 —— 本门会静默失效，拒绝装门。"
   288	            "请在任何业务 import 之前先装门（根 conftest 已保证），并排查是谁提前导入了 uvloop。"
   289	        )
   290	    poison_uvloop()
   291	    if STATE.installed:
   292	        return
   293	    base = _socket_mod.socket  # _socket.socket 基类（socket.SocketType 同一对象）
   294	    STATE._orig_connect = base.connect
   295	    STATE._orig_connect_ex = base.connect_ex
   296	    base.connect = _guarded_connect  # type: ignore[method-assign]
   297	    base.connect_ex = _guarded_connect_ex  # type: ignore[method-assign]
   298	    STATE.installed = True
   299	
   300	
   301	def uninstall() -> None:
   302	    """仅保留 API 形状；CLI 测试进程**刻意不调用**（见 install 的 ⚠️ 说明）。"""
   303	    if not STATE.installed:
   304	        return
   305	    base = _socket_mod.socket
   306	    base.connect = STATE._orig_connect  # type: ignore[method-assign]
   307	    base.connect_ex = STATE._orig_connect_ex  # type: ignore[method-assign]
   308	    STATE.installed = False
   309	
   310	
   311	# ═══════════════════════════════════════════════════════════════════════════
   312	# 自证
   313	# ═══════════════════════════════════════════════════════════════════════════
   314	
   315	
   316	def assert_not_uvloop() -> None:
   317	    """session 级复核：uvloop 已被 :func:`poison_uvloop` 关死。
   318	
   319	    import 失败毒化 + policy 复核双保险；policy 拿不到时不算证据失败
   320	    （3.14 起 get_event_loop_policy 已 deprecated），毒化才是承重防线。
   321	    """
   322	    if sys.modules.get("uvloop") is not None:
   323	        raise RuntimeError(
   324	            "uvloop 已在本进程被导入：本门包装的是 socket.socket.connect，uvloop 走 "
   325	            "libuv 绕过它，门会静默失效。install() 应当已把 uvloop 毒化——出现本错误"
   326	            "说明毒化被人绕过（例如 install 前已被 import）。"
   327	        )
   328	    try:
   329	        with warnings.catch_warnings():
   330	            warnings.simplefilter("ignore", DeprecationWarning)
   331	            policy_module = type(asyncio.get_event_loop_policy()).__module__ or ""
   332	    except Exception:  # noqa: BLE001 —— 拿不到 policy 不算证据，靠 sys.modules 那条
   333	        return
   334	    if "uvloop" in policy_module:
   335	        raise RuntimeError(f"event loop policy 来自 uvloop（{policy_module}）：本门会静默失效。")
   336	
   337	
   338	def assert_test_uri_not_blocked() -> None:
   339	    """NEO4J_TEST_URI 指向受拦端口 = 配置事故，直接 fail 而不是悄悄放行。
   340	
   341	    刻意**不**做「把 NEO4J_TEST_URI 的端口从受拦集合里摘掉」——那会给出一条
   342	    「改个环境变量就能把门打开」的静默旁路。
   343	    """
   344	    uri = os.environ.get("NEO4J_TEST_URI") or ""
   345	    for port in BLOCKED_PORTS:
   346	        if f":{port}" in uri:
   347	            raise RuntimeError(f"NEO4J_TEST_URI={uri!r} 指向受拦端口 {port}（现网库）。测试容器应当是 7692。")
   348	
   349	
   350	# ═══════════════════════════════════════════════════════════════════════════
   351	# pytest 接线（由根 conftest 调用）
   352	# ═══════════════════════════════════════════════════════════════════════════
   353	
   354	
   355	def is_exempt(item, tests_dir) -> tuple[bool, str]:
   356	    """该用例是否豁免（只记不拦）。返回 (豁免, 依据)。
   357	
   358	    ``tests_dir`` = backend/tests 的绝对路径（由 conftest 传入 ``Path(__file__).parent``）。
   359	    路径判定用 **相对化后的首段目录**，不做整条路径的 substring——
   360	    ``/tmp/tests/integration/...`` 之类的绝对路径不得误判（Codex round-1 MEDIUM）。
   361	    """
   362	    for marker in EXEMPT_MARKERS:
   363	        if item.get_closest_marker(marker) is not None:
   364	            return True, f"marker:{marker}"
   365	    try:
   366	        rel = item.path.resolve().relative_to(tests_dir.resolve())
   367	    except Exception:  # noqa: BLE001 —— 相对化失败（如 rootdir 外）一律不豁免，fail-closed
   368	        return False, ""
   369	    first = rel.parts[0] if rel.parts else ""
   370	    if first in EXEMPT_PATH_PREFIXES:
   371	        return True, f"path:{first}/"
   372	    return False, ""
   373	
   374	
   375	def format_sentinel(owner: str, records: list[dict]) -> str:
   376	    lines = [
   377	        f"{BLOCK_REASON} —— 本用例期间有 {len(records)} 次到现网 Neo4j 的连接尝试被拦下。",
   378	        "（连接处抛出的异常被 app/main.py 的 lifespan try/except 吞掉了，",
   379	        "  所以由本哨兵把它转成用例失败——否则这道门什么都证明不了。）",
   380	    ]
   381	    for rec in records:
   382	        lines.append(f"  - {rec['address']} on thread {rec['thread']} (owner={owner})")
   383	    return "\n".join(lines)

