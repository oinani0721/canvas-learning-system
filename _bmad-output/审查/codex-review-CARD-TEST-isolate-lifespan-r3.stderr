   250	    def resolve_name(self, name: str, node: ast.AST) -> str:
   251	        cur: ast.AST | None = node
   252	        while cur is not None:
   253	            parent = self.parent.get(id(cur))
   254	            if isinstance(parent, (ast.FunctionDef, ast.AsyncFunctionDef)):
   255	                scope = self.scope_by_func.get(id(parent))
   256	                if scope and name in scope:
   257	                    return scope[name]
   258	            cur = parent
   259	        if name in self.module_scope:
   260	            return self.module_scope[name]
   261	        return _ORIGIN_UNKNOWN
   262	
   263	    def resolve_arg(self, arg: ast.expr, node: ast.AST) -> str:
   264	        if isinstance(arg, ast.Name):
   265	            return self.resolve_name(arg.id, node)
   266	        if isinstance(arg, ast.Attribute):
   267	            base = arg.value
   268	            if isinstance(base, ast.Name) and self.resolve_name(base.id, node) == _ORIGIN_MAIN:
   269	                return _ORIGIN_MAIN
   270	            return _ORIGIN_UNKNOWN
   271	        if isinstance(arg, ast.Call):
   272	            fname = None
   273	            if isinstance(arg.func, ast.Name):
   274	                fname = arg.func.id
   275	            elif isinstance(arg.func, ast.Attribute):
   276	                fname = arg.func.attr
   277	            if fname == "FastAPI":
   278	                return _ORIGIN_FASTAPI
   279	            if fname in self.fastapi_returning_funcs:
   280	                return _ORIGIN_FASTAPI
   281	        return _ORIGIN_UNKNOWN
