 succeeded in 0ms:
   221	                    if alias.name in ISOLATION_HELPER_NAMES:
   222	                        self.helper_aliases.add(alias.asname or alias.name)
   223	        elif isinstance(stmt, ast.Import):
   224	            for alias in stmt.names:
   225	                if alias.name == "app.main" or alias.name.startswith("app.main."):
   226	                    bound = alias.asname or alias.name.split(".")[0]
   227	                    scope[bound] = _ORIGIN_MAIN
   228	        elif isinstance(stmt, (ast.Assign, ast.AnnAssign)):
   229	            value = stmt.value
   230	            targets = stmt.targets if isinstance(stmt, ast.Assign) else [stmt.target]
   231	            if value is None:
   232	                return
