   238	                helper_name = call.attr
   239	            if _call_name(value) == "FastAPI" or (helper_name in self.fastapi_returning_funcs):
   240	                for t in targets:
   241	                    for elt in [t] if isinstance(t, ast.Name) else getattr(t, "elts", []):
   242	                        if isinstance(elt, ast.Name):
   243	                            scope[elt.id] = _ORIGIN_FASTAPI
   244	            else:
   245	                for t in targets:
   246	                    for elt in [t] if isinstance(t, ast.Name) else getattr(t, "elts", []):
   247	                        if isinstance(elt, ast.Name):
   248	                            scope.setdefault(elt.id, _ORIGIN_UNKNOWN)
