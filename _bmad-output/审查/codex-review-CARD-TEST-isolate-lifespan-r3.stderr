   121	        #: 当前有效归属代次（end_item 即换代，旧 context 副本的票作废）。
   122	        self.current_gen = 0
   123	        self._next_gen = 1
   124	
   125	    # ── 记账 ────────────────────────────────────────────────────────────
   126	    def record(self, address) -> bool:
   127	        """记一次到受拦端口的连接尝试。返回 True 表示应当拦（非豁免）。"""
   128	        owner = _OWNER_CV.get()
