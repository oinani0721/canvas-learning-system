   276	def test_metrics_endpoint_handles_concurrent_requests(client):
   277	    """Test that metrics endpoints handle concurrent requests."""
   278	    import threading
   279	
   280	    results = []
   281	
   282	    def make_request():
   283	        response = client.get("/api/v1/health/metrics/summary")
   284	        results.append(response.status_code)
   285	
   286	    threads = [threading.Thread(target=make_request) for _ in range(5)]
   287	    for t in threads:
   288	        t.start()
   289	    for t in threads:
   290	        t.join()
   291	
   292	    # All requests should succeed
   293	    assert all(status == 200 for status in results)
