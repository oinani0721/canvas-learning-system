   388	    def test_tips_callout_direct_409_before_idempotency_write(
   389	        self, client, isolated_event_log, isolated_episode_worker
   390	    ):
   391	        """BLOCKER-2: callout-direct 曾先落幂等事件再 409 —— 客户端纠正
   392	        vault 后重试会被判 duplicate, 批注永久丢失。现在解析先行。
   393	
   394	        事件账本经 ``isolated_event_log`` 重定向到 tmp (append_event 的
   395	        `_log_path()` 读 CANVAS_BASE_PATH, 默认指向 **live vault**;
   396	        本用例必须落盘验证幂等语义, 不隔离就会污染真实学习事件账本)。
   397	        """
   398	        payload = {
   399	            "vault_id": OTHER,
   400	            "callout_id": "c-409-guard",
   401	            "node_id": "n1",
   402	            "callout_type": "question",
   403	            "text": "why?",
   404	            "added_at": "2026-01-01T00:00:00Z",
   405	        }
   406	        with patch("app.config.get_current_vault_id", return_value=ACTIVE):
   407	            resp = client.post("/api/v1/tips/callout-direct", json=payload)
   408	        assert resp.status_code == 409, resp.text
   409	
   410	        # 409 时**不得**留下幂等键 (留了就等于把重试机会烧掉)
   411	        assert "c-409-guard" not in isolated_event_log.read_text(encoding="utf-8")
   412	
   413	        # 纠正 vault 后同一 callout_id 必须仍可被受理 (未被幂等键拦死)
   414	        payload_fixed = {**payload, "vault_id": ACTIVE}
   415	        with patch("app.config.get_current_vault_id", return_value=ACTIVE):
   416	            resp2 = client.post("/api/v1/tips/callout-direct", json=payload_fixed)
   417	        assert resp2.status_code == 200, resp2.text
   418	        assert "duplicate" not in resp2.text
