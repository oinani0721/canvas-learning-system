   131	
   132	class _ModuleIndex:
   133	    """一次 ast.parse 的静态索引：import 别名 + 按作用域的名字来源表。
   134	
   135	    来源（Codex round-1 HIGH 整改：支持函数级 import 与别名，解析不了 = 违规）：
   136	      * ``from app.main import app``（任意层级）→ 绑定名 → _ORIGIN_MAIN；
   137	      * ``import app.main`` / ``import app.main as m`` → 绑定名 → _ORIGIN_MAIN
   138	        （供 ``m.app`` 这类 Attribute 解析）；
   139	      * ``x = FastAPI(...)`` → x → _ORIGIN_FASTAPI（局部应用正例）；
   140	      * 其它 Name 绑定 → _ORIGIN_UNKNOWN；
   141	      * 解析失败 → _ORIGIN_UNKNOWN（= 违规，fail-closed）。
   142	
   143	    作用域：每条名字记到「离它最近的 enclosing 函数」的作用域表；With 处解析时
   144	    沿 parent 链从内向外查，最后查模块级。类体视作透明（近似，往保守方向偏）。
   145	    """
   146	
   147	    def __init__(self, tree: ast.Module) -> None:
   148	        self.parent: dict[int, ast.AST] = {}
   149	        for node in ast.walk(tree):
   150	            for child in ast.iter_child_nodes(node):
   151	                self.parent[id(child)] = node
   152	
   153	        self.client_aliases: set[str] = {"TestClient"}
   154	        #: 合法隔离基元名 = 真正从 tests.support.lifespan import 进来的名字
   155	        #: （Codex round-2 HIGH：本地定义一个同名 no-op 不能冒充隔离基元）。
   156	        self.helper_aliases: set[str] = set()
   157	        #: 「返回局部 FastAPI() 的函数」名集（名字级过程间近似）：正例文件
   158	        #: （test_rag_four_state_api 等）的模式是 helper 内 ``app = FastAPI()``
   159	        #: 然后 return，测试里元组解包后传入 TestClient —— 不识别会把正例
   160	        #: 误判成 unknown 违规。近似是**单向放宽**且要求函数体内确有
   161	        #: ``x = FastAPI()`` + ``return x`` 同现，冒用面极窄。
   162	        self.fastapi_returning_funcs: set[str] = set()
   163	        self.module_scope: dict[str, str] = {}
   164	        self.scope_by_func: dict[int, dict[str, str]] = {}
   165	        self._index_statements(tree.body, self.module_scope)
   166	        for node in ast.walk(tree):
   167	            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
   168	                scope: dict[str, str] = {}
   169	                self._index_statements(node.body, scope)
   170	                self.scope_by_func[id(node)] = scope
   171	                self._mark_fastapi_returning(node)
   172	
   173	    def _mark_fastapi_returning(self, fd) -> None:
   174	        """函数体内「x = FastAPI() … return x（或直接 return FastAPI()）」→ 记名。"""
   175	        local_fastapi_names: set[str] = set()
   176	        for stmt in ast.walk(fd):
   177	            if isinstance(stmt, (ast.Assign, ast.AnnAssign)) and stmt.value is not None:
   178	                if _call_name(stmt.value) == "FastAPI":
   179	                    targets = stmt.targets if isinstance(stmt, ast.Assign) else [stmt.target]
   180	                    for t in targets:
   181	                        if isinstance(t, ast.Name):
   182	                            local_fastapi_names.add(t.id)
   183	        for stmt in ast.walk(fd):
   184	            if isinstance(stmt, ast.Return) and stmt.value is not None:
   185	                candidates = stmt.value.elts if isinstance(stmt.value, ast.Tuple) else [stmt.value]
   186	                for c in candidates:
   187	                    if _call_name(c) == "FastAPI" or (isinstance(c, ast.Name) and c.id in local_fastapi_names):
   188	                        self.fastapi_returning_funcs.add(fd.name)
   189	                        return
   190	
   191	    def _index_statements(self, stmts, scope: dict[str, str]) -> None:
   192	        """把一批语句的名字绑定记入 scope；不跨函数边界（内层函数另行建表）。"""
   193	        for stmt in stmts:
   194	            self._index_one(stmt, scope)
   195	            if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
   196	                continue
   197	            for field in ("body", "orelse", "finalbody"):
   198	                block = getattr(stmt, field, None)
   199	                if block:
   200	                    self._index_statements(block, scope)
   201	            if isinstance(stmt, (ast.With, ast.AsyncWith)):
   202	                for item in stmt.items:
   203	                    var = item.optional_vars
   204	                    if isinstance(var, ast.Name):
   205	                        scope.setdefault(var.id, _ORIGIN_UNKNOWN)
   206	            if isinstance(stmt, ast.ClassDef):
   207	                self._index_statements(stmt.body, scope)
   208	
   209	    def _index_one(self, stmt, scope: dict[str, str]) -> None:
   210	        if isinstance(stmt, ast.ImportFrom):
   211	            if stmt.module == "app.main":
   212	                for alias in stmt.names:
   213	                    if alias.name == "app":
   214	                        scope[alias.asname or "app"] = _ORIGIN_MAIN
   215	            if stmt.module == "fastapi.testclient":
   216	                for alias in stmt.names:
   217	                    if alias.name == "TestClient":
   218	                        self.client_aliases.add(alias.asname or "TestClient")
   219	            if stmt.module == "tests.support.lifespan":
   220	                for alias in stmt.names:

