   284	def run_ast_gate() -> tuple[int, list[str], int]:
   285	    """返回 (违规数, 违规明细, 扫描的文件数)。"""
   286	    files: list[Path] = []
   287	    for d in AST_SCOPE_DIRS:
   288	        files.extend(sorted((BACKEND_DIR / d).rglob("*.py")))
   289	    for f in AST_SCOPE_FILES:
   290	        p = BACKEND_DIR / f
   291	        if p.exists():
   292	            files.append(p)
   293	
   294	    violations: list[str] = []
   295	    for path in files:
   296	        try:
   297	            tree = ast.parse(path.read_text(encoding="utf-8"))
   298	        except SyntaxError as e:
   299	            violations.append(f"{path}: SyntaxError {e}")
   300	            continue
   301	        index = _ModuleIndex(tree)
   302	        rel = path.relative_to(BACKEND_DIR)
   303	        for node in ast.walk(tree):
   304	            if not isinstance(node, (ast.With, ast.AsyncWith)):
   305	                continue
   306	            for pos, item in enumerate(node.items):
   307	                cname = _call_name(item.context_expr)
   308	                if cname not in index.client_aliases:
   309	                    continue
   310	                args = item.context_expr.args
   311	                if not args:
   312	                    violations.append(f"{rel}:{node.lineno}: TestClient() 无参 —— 人工复核")
   313	                    continue
   314	                arg = args[0]
   315	                origin = index.resolve_arg(arg, node)
   316	                if origin == _ORIGIN_FASTAPI:
   317	                    continue  # 局部 FastAPI() 正例
   318	                if origin != _ORIGIN_MAIN:
   319	                    # unknown：来源无法静态证明 —— 按违规处理（fail-closed）。
   320	                    # Codex round-2 HIGH：此前 unknown 被直接放行，与 docstring
   321	                    # 声明相反（target = app / 晚绑定 / class 作用域污染全漏）。
   322	                    arg_desc = arg.id if isinstance(arg, ast.Name) else "<expr>"
   323	                    violations.append(
   324	                        f"{rel}:{node.lineno}: with TestClient({arg_desc}) —— app 来源"
   325	                        "无法静态证明（unknown 按违规处理，人工复核）"
   326	                    )
   327	                    continue
   328	                # app 来自 app.main：必须有**排在前面的**隔离兄弟项、且操作同一个
   329	                # app、且该名字确实 import 自 tests.support.lifespan（Codex
   330	                # round-2 HIGH：本地同名 no-op 不能冒充隔离基元；
   331	                # round-1 HIGH：顺序反了等于没隔离）。
   332	                ok = False
   333	                for hpos, hitem in enumerate(node.items):
   334	                    if hpos >= pos:
   335	                        break
   336	                    if _call_name(hitem.context_expr) not in index.helper_aliases:
   337	                        continue
   338	                    hargs = hitem.context_expr.args
   339	                    if hargs and isinstance(arg, ast.Name) and isinstance(hargs[0], ast.Name) and hargs[0].id == arg.id:
   340	                        ok = True
   341	                        break
   342	                if not ok:
   343	                    arg_desc = arg.id if isinstance(arg, ast.Name) else "<expr>"
   344	                    violations.append(
   345	                        f"{rel}:{node.lineno}: with TestClient({arg_desc}) —— app 来自"
   346	                        " app.main 且缺少**在前**的 no_lifespan/lifespan_lite 兄弟项"
   347	                        "（顺序不符、参数不同名或 helper 并非 import 自"
   348	                        " tests.support.lifespan 同样算违规）"
   349	                    )
   350	    return len(violations), violations, len(files)
   351	
   352	
   353	# ═══════════════════════════════════════════════════════════════════════════
   354	# 变异 + 子进程 + 还原
   355	# ═══════════════════════════════════════════════════════════════════════════
   356	
   357	
   358	def sha_of(path: Path) -> str:
   359	    if not path.exists():
   360	        return "absent"
   361	    return hashlib.sha256(path.read_bytes()).hexdigest()
   362	
   363	
   364	def runtime_snapshot() -> str:
   365	    return "\n".join(f"{sha_of(p)}  {p}" for p in RUNTIME_FILES)
   366	
   367	
   368	def _parse_outcomes(stdout: str) -> dict[str, str]:
   369	    """从 ``-rA`` 汇总块解析 nodeid → PASSED/FAILED/ERROR/...。"""
   370	    outcomes: dict[str, str] = {}
   371	    for line in stdout.splitlines():
   372	        m = re.match(r"^(PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS) (\S+)", line.strip())
   373	        if m:
   374	            outcomes[m.group(2)] = m.group(1)
   375	    return outcomes
   376	
   377	
   378	def main() -> int:
   379	    print("=== lifespan isolation NEGATIVE CONTROL ===")
   380	
   381	    # -- 0-保险. 门在位前置检查（belt）+ AST 门（裁判 6）-----------------------
   382	    conftest_text = (BACKEND_DIR / "tests/conftest.py").read_text(encoding="utf-8")
   383	    if "live_port_guard" not in conftest_text:
   384	        print(
   385	            "NEGATIVE-CONTROL: FAIL — 根 tests/conftest.py 未引用 live_port_guard："
   386	            "结账哨兵不会在子进程里工作，负门失去被测对象。"
   387	        )
   388	        return 1
   389	    n_violations, violation_lines, n_files = run_ast_gate()
   390	    print(f"[0] AST gate: {n_violations} violations across {n_files} files")
   391	    for v in violation_lines:
   392	        print(f"    VIOLATION: {v}")
   393	    if "--ast-only" in sys.argv:
   394	        if n_violations:
   395	            print("AST-GATE: FAIL")
   396	            return 1
   397	        print(f"AST-GATE: PASS (0 violations in {n_files} files)")
   398	        return 0
   399	
   400	    tmp_root = Path(tempfile.mkdtemp(prefix="lifespan-negctl-"))
   401	    junit_xml = tmp_root / "negctl-junit.xml"
   402	    vault_tmp = tmp_root / "vault"
   403	    lance_tmp = tmp_root / "lancedb"
   404	    vault_tmp.mkdir()
   405	    lance_tmp.mkdir()
   406	
   407	    original = TARGET.read_bytes()
   408	    original_sha = hashlib.sha256(original).hexdigest()
   409	    mutated = False
   410	
   411	    def _restore(*_a) -> None:
   412	        """无条件写回原始字节（幂等）。变异标志先置位，保证任何路径都会还原。"""
   413	        nonlocal mutated
   414	        if not mutated:
