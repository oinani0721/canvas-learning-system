   125	def _call_name(node: ast.expr) -> str | None:
   126	    """Call(...) 的函数名（仅 Name 形式），否则 None。"""
   127	    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
   128	        return node.func.id
   129	    return None
