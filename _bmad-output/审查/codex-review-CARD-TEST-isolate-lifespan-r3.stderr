    97	_GEN_CV: contextvars.ContextVar[int] = contextvars.ContextVar("w4_guard_gen", default=-1)
    98	
    99	
   100	# ═══════════════════════════════════════════════════════════════════════════
   101	# 状态
   102	# ═══════════════════════════════════════════════════════════════════════════
   103	
   104	
   105	class _GuardState:
   106	    """门的运行时账。计数跨线程累加；归属走 ContextVar。"""
   107	
   108	    def __init__(self) -> None:
   109	        self._lock = threading.Lock()
   110	        self.installed = False
   111	        self.total = 0
   112	        self.blocked = 0
