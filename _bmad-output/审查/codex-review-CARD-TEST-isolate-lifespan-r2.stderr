   267	# 自证
   268	# ═══════════════════════════════════════════════════════════════════════════
   269	
   270	
   271	def assert_not_uvloop() -> None:
   272	    """session 级复核：uvloop 已被 :func:`poison_uvloop` 关死。
   273	
   274	    import 失败毒化 + policy 复核双保险；policy 拿不到时不算证据失败
   275	    （3.14 起 get_event_loop_policy 已 deprecated），毒化才是承重防线。
   276	    """
   277	    if sys.modules.get("uvloop") is not None:
   278	        raise RuntimeError(
   279	            "uvloop 已在本进程被导入：本门包装的是 socket.socket.connect，uvloop 走 "
   280	            "libuv 绕过它，门会静默失效。install() 应当已把 uvloop 毒化——出现本错误"
   281	            "说明毒化被人绕过（例如 install 前已被 import）。"
   282	        )
   283	    try:
   284	        with warnings.catch_warnings():
   285	            warnings.simplefilter("ignore", DeprecationWarning)
   286	            policy_module = type(asyncio.get_event_loop_policy()).__module__ or ""
   287	    except Exception:  # noqa: BLE001 —— 拿不到 policy 不算证据，靠 sys.modules 那条
   288	        return
   289	    if "uvloop" in policy_module:
   290	        raise RuntimeError(f"event loop policy 来自 uvloop（{policy_module}）：本门会静默失效。")
   291	
   292	
   293	def assert_test_uri_not_blocked() -> None:
   294	    """NEO4J_TEST_URI 指向受拦端口 = 配置事故，直接 fail 而不是悄悄放行。
   295	
   296	    刻意**不**做「把 NEO4J_TEST_URI 的端口从受拦集合里摘掉」——那会给出一条
   297	    「改个环境变量就能把门打开」的静默旁路。
   298	    """
   299	    uri = os.environ.get("NEO4J_TEST_URI") or ""
   300	    for port in BLOCKED_PORTS:
   301	        if f":{port}" in uri:
   302	            raise RuntimeError(f"NEO4J_TEST_URI={uri!r} 指向受拦端口 {port}（现网库）。测试容器应当是 7692。")
   303	
