   122	@pytest.hookimpl(wrapper=True)
   123	def pytest_runtest_protocol(item, nextitem):
   124	    """把连接尝试归属到用例；豁免用例（integration/e2e 路径与 marker）只记不拦。
   125	
   126	    归属写在 ContextVar 上（portal 线程带副本可见，裸线程默认 <unknown> 且永不
   127	    豁免 = fail-closed），见 tests/support/live_port_guard.py 的模块 docstring。
   128	    """
   129	    exempt, _why = live_port_guard.is_exempt(item, Path(__file__).parent)
   130	    live_port_guard.begin_item(item.nodeid, exempt)
   131	    try:
   132	        return (yield)
   133	    finally:
   134	        live_port_guard.end_item()
   135	
   136	
   137	@pytest.hookimpl(wrapper=True)
   138	def pytest_runtest_makereport(item, call):
   139	    """结账哨兵：把被 app/main.py 的 try/except 吞掉的拦截转成用例失败。
   140	
   141	    没有这一层，门拦住了连接却无人知晓——TestClient 照常进入、用例照常绿，
   142	    等于一门否定断言恒真的假门（2026-09-01 E3 机制实验实证）。
   143	    """
   144	    report = yield
   145	    if report.when in ("call", "teardown"):
   146	        records = live_port_guard.STATE.take(item.nodeid)
   147	        if records:
   148	            report.outcome = "failed"
   149	            detail = live_port_guard.format_sentinel(item.nodeid, records)
   150	            report.longrepr = f"{report.longrepr}\n\n{detail}" if report.longrepr else detail
   151	    return report
   152	
   153	
   154	def pytest_sessionfinish(session, exitstatus):
   155	    unaccounted = live_port_guard.STATE.unaccounted_blocked()
   156	    if unaccounted:
   157	        print(
   158	            f"\n*** {live_port_guard.BLOCK_REASON} —— {len(unaccounted)} 次拦截"
   159	            "无人结账（迟到线程 / collection 期 / 未知线程），进程将以退出码 3 失败 ***",
   160	            file=sys.stderr,
   161	        )
   162	        for rec in unaccounted:
   163	            print(f"    - {rec['address']} on thread {rec['thread']} (owner={rec['owner']})", file=sys.stderr)
   164	
   165	
   166	@pytest.hookimpl(wrapper=True)
   167	def pytest_cmdline_main(config):
   168	    """session 总账收口：任何无人买单的拦截 → 退出码 3（Codex round-1 HIGH）。"""
   169	    status = yield
   170	    if live_port_guard.STATE.unaccounted_blocked():
   171	        return 3
   172	    return status
   173	
   174	
   175	def pytest_terminal_summary(terminalreporter, exitstatus, config):
   176	    terminalreporter.write_line(live_port_guard.STATE.summary_line())
