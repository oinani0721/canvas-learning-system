   184	async def wait_for_mock_call(
   185	    mock_method,
   186	    *,
   187	    timeout: float = 2.0,
   188	    interval: float = 0.05,
   189	    expected_count: int = 1,
   190	):
   191	    """Poll until mock is called expected number of times or timeout.
   192	
   193	    Use instead of asyncio.sleep() to wait for fire-and-forget background tasks.
   194	
   195	    Args:
   196	        mock_method: The mock to check call_count on.
   197	        timeout: Maximum wait time in seconds.
   198	        interval: Polling interval in seconds.
   199	        expected_count: Minimum call_count to wait for.
   200	
   201	    Raises:
   202	        TimeoutError: If mock not called within timeout.
   203	    """
   204	    loop = asyncio.get_running_loop()
   205	    start = loop.time()
   206	    while (loop.time() - start) < timeout:
   207	        if mock_method.call_count >= expected_count:
   208	            return
   209	        await asyncio.sleep(interval)
   210	    raise TimeoutError(
   211	        f"{mock_method} not called {expected_count} time(s) within {timeout}s (actual: {mock_method.call_count})"
   212	    )
   213	
