   310	def is_exempt(item, tests_dir) -> tuple[bool, str]:
   311	    """该用例是否豁免（只记不拦）。返回 (豁免, 依据)。
   312	
   313	    ``tests_dir`` = backend/tests 的绝对路径（由 conftest 传入 ``Path(__file__).parent``）。
   314	    路径判定用 **相对化后的首段目录**，不做整条路径的 substring——
   315	    ``/tmp/tests/integration/...`` 之类的绝对路径不得误判（Codex round-1 MEDIUM）。
   316	    """
   317	    for marker in EXEMPT_MARKERS:
   318	        if item.get_closest_marker(marker) is not None:
   319	            return True, f"marker:{marker}"
   320	    try:
   321	        rel = item.path.resolve().relative_to(tests_dir.resolve())
   322	    except Exception:  # noqa: BLE001 —— 相对化失败（如 rootdir 外）一律不豁免，fail-closed
   323	        return False, ""
   324	    first = rel.parts[0] if rel.parts else ""
   325	    if first in EXEMPT_PATH_PREFIXES:
   326	        return True, f"path:{first}/"
   327	    return False, ""
   328	
   329	
   330	def format_sentinel(owner: str, records: list[dict]) -> str:
   331	    lines = [
   332	        f"{BLOCK_REASON} —— 本用例期间有 {len(records)} 次到现网 Neo4j 的连接尝试被拦下。",
   333	        "（连接处抛出的异常被 app/main.py 的 lifespan try/except 吞掉了，",
   334	        "  所以由本哨兵把它转成用例失败——否则这道门什么都证明不了。）",
   335	    ]
   336	    for rec in records:
   337	        lines.append(f"  - {rec['address']} on thread {rec['thread']} (owner={owner})")
   338	    return "\n".join(lines)

