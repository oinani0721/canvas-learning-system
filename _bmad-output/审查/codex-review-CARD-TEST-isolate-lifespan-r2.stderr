   106	    # 并发竞态无数据库兜底, 同 (group_id, id) 可能写出两份)。
   107	    gate_reason = await get_canvas_schema_gate().block_reason()
   108	    if gate_reason:
   109	        raise HTTPException(status_code=503, detail=gate_reason)
   110	
   111	    # P0-SYNC-ISO-2026-08-17 — 显式接住 resolver 返回值并下传 service, 与
   112	    # 同文件 /sync/relationships/* 范式一致。此前只靠 ContextVar 副作用,
   113	    # service 层零消费 → 六条 Cypher 裸 id 跨 vault 互相覆盖 (Codex P0)。
   114	    logical_gid = resolve_vault_group_id(
   115	        request.vault_id,
   116	        subject_id=request.subject_id,
   117	        legacy_group_id=request.group_id,
   118	    )
   119	    # 物理边界一次转换: 绑定 Neo4j group_id 属性的 Cypher 参数必过此函数
   120	    physical_gid = to_physical_group_id(logical_gid)
   121	
   122	    # R10 复审 P0-01 — 有损规范化非单射: 不同 vault 名可坍缩同一物理
   123	    # group ('CS 61B'/'CS-61B' → vault__cs_61b), 碰撞时复合键失效, 覆盖/
   124	    # 误删复活。注册表首claim绑定 + 碰撞 fail-closed。
   125	    try:
   126	        await get_vault_identity_registry().assert_identity(raw_vault_id=request.vault_id, physical_gid=physical_gid)
   127	    except VaultIdentityUnresolvableError as e:
   128	        raise HTTPException(status_code=422, detail=str(e)) from e
   129	    except VaultIdentityCollisionError as e:
   130	        raise HTTPException(status_code=409, detail=str(e)) from e
   131	    except (ServiceUnavailable, AuthError, ConnectionError) as e:
   132	        # 注册表查不了 = 身份无法确认 → fail closed (拒写而非放行)
   133	        logger.error("vault_identity_registry_unavailable: %s", str(e)[:200])
   134	        raise HTTPException(status_code=503, detail="Neo4j unavailable") from e
   135	
   136	    try:
   137	        service = get_sync_service()
   138	        return await service.process_sync_batch(request, group_id=physical_gid)
   139	    except (ServiceUnavailable, AuthError, ConnectionError) as e:
   140	        # Infrastructure-level failures → 503

