   172	    # CARD-TEST-isolate-lifespan: 两类请求期连接在此一并打桩 —
   173	    # 1) schema_gate: /sync/batch 每次请求真连 NEO4J_URI 做 SHOW
   174	    #    CONSTRAINTS（verify 失败按「未知态」放行），桩返回恒放行，
   175	    #    与被拦时的实际行为一致，409 断言不受影响。
   176	    # 2) MemoryServiceDep: FastAPI 在 handler 体之前解析全部 Depends，
   177	    #    就连 memory/* 的 409 用例也会先触发 MemoryService 惰性
   178	    #    initialize（driver health_check 连 NEO4J_URI）。本模块的断言
   179	    #    只关心 vault 解析层，memory 服务本身不被消费 —— 覆盖为哑对象。
   180	    gate = MagicMock()
   181	    gate.block_reason = AsyncMock(return_value=None)
   182	
   183	    saved_overrides = {
   184	        require_internal_api_key: app.dependency_overrides.get(require_internal_api_key),
   185	        get_memory_service: app.dependency_overrides.get(get_memory_service),
   186	    }
   187	    app.dependency_overrides[require_internal_api_key] = lambda: None
   188	    app.dependency_overrides[get_memory_service] = lambda: MagicMock()
   189	    with (
   190	        patch("app.services.schema_gate.get_canvas_schema_gate", return_value=gate),
   191	        no_lifespan(app),
   192	        TestClient(app, raise_server_exceptions=False) as c,
   193	    ):
   194	        yield c
   195	    for dep, original in saved_overrides.items():
   196	        if original is None:
   197	            app.dependency_overrides.pop(dep, None)
   198	        else:
   199	            app.dependency_overrides[dep] = original
