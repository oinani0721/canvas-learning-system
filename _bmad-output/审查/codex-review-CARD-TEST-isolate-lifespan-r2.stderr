     1	#!/usr/bin/env bash
     2	# 运行时文件门 —— 证明「跑测试没动生产运行时数据」。
     3	#
     4	# [BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     5	#
     6	# 用法:
     7	#   bash backend/scripts/lifespan_isolation_runtime_sha.sh -- <要跑的命令...>
     8	#
     9	# 例:
    10	#   bash scripts/lifespan_isolation_runtime_sha.sh -- .venv/bin/pytest tests/api -q
    11	#
    12	# 判据: 三个受监视文件在命令前后 **逐字节相同**（sha256 相等，或前后都不存在）。
    13	#       任一不同 → 打印 `RUNTIME-FILES: CHANGED` 并 exit 1。
    14	#
    15	# ## 这道门不比什么（诚实边界）
    16	#
    17	# * 只看这三个**具名**文件。lifespan 若写了别的路径（新增的日志/缓存/临时文件），
    18	#   本门看不到 —— 它证明的是「这三个已知受害者没被动」，不是「全盘零写入」。
    19	# * 只比首尾两个时刻。命令中途写进去、结束前又改回原内容，本门判 unchanged。
    20	# * 不看 live vault、不看 Neo4j。数据库里被 DDL 改了 schema，本门照样绿
    21	#   —— 那是 socket 门（backend/tests/support/live_port_guard.py）的职责。
    22	# * `absent → absent` 与 `present 且 sha 不变` 同样算 unchanged；两者语义不同，
    23	#   脚本会逐条打印实际状态，不要只看最后一行结论。
    24	#
    25	# 退出码:
    26	#   1  = 文件被改（门的裁定）
    27	#   其它 = 被包裹命令自己的退出码（测试红了照样透出来，不被门吞掉）
    28	
    29	set -uo pipefail
    30	
    31	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    32	BACKEND_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    33	
    34	# 受监视文件 —— 均 git-ignored 的运行时产物，均由 app/main.py 的 lifespan 链写。
    35	#   bug_log.jsonl            <- app/services/bug_tracker.py
    36	#   vault_index_pending.jsonl<- app/services/vault_index_orchestrator.py
    37	#   outbox/events.jsonl      <- app/services/event_bus.py
    38	WATCHED=(
    39	  "${BACKEND_DIR}/data/bug_log.jsonl"
    40	  "${BACKEND_DIR}/app/data/vault_index_pending.jsonl"
    41	  "${BACKEND_DIR}/data/outbox/events.jsonl"
    42	)
    43	EXPECTED_WATCH_COUNT=3
    44	
    45	# 自检: 监视清单不能悄悄变空/变短 —— 空清单会让本门「零比较、恒绿」。
    46	if [ "${#WATCHED[@]}" -ne "${EXPECTED_WATCH_COUNT}" ]; then
    47	  echo "RUNTIME-FILES: GATE-BROKEN — 监视清单有 ${#WATCHED[@]} 项, 期望 ${EXPECTED_WATCH_COUNT} 项" >&2
    48	  exit 1
    49	fi
    50	
    51	if [ "${1:-}" != "--" ]; then
    52	  echo "用法: bash $0 -- <command...>" >&2
    53	  echo "  ('--' 之后的一切原样作为命令执行)" >&2
    54	  exit 2
    55	fi
    56	shift
    57	if [ "$#" -eq 0 ]; then
    58	  echo "RUNTIME-FILES: GATE-BROKEN — '--' 之后没有命令; 拒绝空跑（空跑必然 unchanged, 是假绿）" >&2
    59	  exit 2
    60	fi
    61	
    62	snapshot() {
    63	  # 逐行输出 "<sha256|absent>  <path>"；顺序与 WATCHED 一致。
    64	  # hash 管道任何一环失败（shasum 出错 / 结果非 64 位十六进制）都判门损坏，
    65	  # 不允许「空 digest 前后相等 = unchanged」的假绿（Codex round-1 HIGH）。
    66	  local f digest
    67	  for f in "${WATCHED[@]}"; do
    68	    if [ -f "$f" ]; then
    69	      digest="$(shasum -a 256 "$f")" || {
    70	        echo "RUNTIME-FILES: GATE-BROKEN — shasum 失败: $f" >&2
    71	        exit 1
    72	      }
    73	      digest="$(printf '%s' "$digest" | awk '{print $1}')"
    74	      if ! printf '%s' "$digest" | grep -qE '^[0-9a-f]{64}$'; then
    75	        echo "RUNTIME-FILES: GATE-BROKEN — sha256 结果非 64-hex: '$digest' ($f)" >&2
    76	        exit 1
    77	      fi
    78	      printf '%s  %s\n' "$digest" "$f"
    79	    else
    80	      printf 'absent  %s\n' "$f"
    81	    fi
    82	  done
    83	}
    84	
    85	BEFORE="$(snapshot)"
    86	echo "=== RUNTIME-FILES before ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    87	echo "${BEFORE}"
    88	echo "=== 执行被包裹命令 ==="
    89	echo "\$ $*"
    90	
    91	set +e
    92	# 子 shell 执行：builtin（`exit 0`）/ eval / 函数定义都死在子壳里，
    93	# 无法篡改本壳的 snapshot 函数、BEFORE 变量或跳过 after 快照（Codex round-1 HIGH）。
    94	( "$@" )
    95	CMD_RC=$?
    96	set -e
    97	
    98	AFTER="$(snapshot)"
    99	echo "=== RUNTIME-FILES after ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
   100	echo "${AFTER}"
   101	echo "WRAPPED-COMMAND-EXIT: ${CMD_RC}"
   102	
   103	if [ "${BEFORE}" != "${AFTER}" ]; then
   104	  echo "RUNTIME-FILES: CHANGED"
   105	  echo "--- diff (before vs after) ---"
   106	  diff <(echo "${BEFORE}") <(echo "${AFTER}") || true
   107	  exit 1
   108	fi
   109	
   110	echo "RUNTIME-FILES: unchanged"
   111	exit "${CMD_RC}"
