     1	# Canvas Learning System - Canvas Schema Gate
     2	# P0-SYNC-ISO-2026-08-17 · R10 复审 P2-02
     3	"""启动/请求时的 Neo4j 约束在位校验 — 缺约束时写入 fail-closed.
     4	
     5	R10 复审 P2-02: 部署链不会自动应用 migrations/003, 重建 volume 后不能
     6	假设复合唯一约束存在 (本项目实测过一次: 001 从未在现网生效, SHOW
     7	CONSTRAINTS 为空跑了数月)。缺约束时六条写 Cypher 的并发竞态失去数据库
     8	层兜底 — 同 (group_id, id) 可能写出两份。
     9	
    10	Gate 语义 (三态):
    11	- **True (已验证齐全)**: 放行, 后续请求零开销。
    12	- **False (确认缺失)**: /sync/batch 拒绝写入 (503 + 指明缺哪条 + 修法)。
    13	- **None (未知 — DB 不可达/未验证)**: 不拦。理由: DB 不可达时写入自身
    14	  就会 503, gate 重复拦截无增益; 只有「连上了且确认缺约束」才是 gate
    15	  独有的信息, 才值得 fail closed。每次请求遇 None 会重试验证 (lazy)。
    16	
    17	[Source: _bmad-output/审查/2026-08-17-Codex对抗审查-R10第一批次实际成果.md P2-02]
    18	[Source: backend/migrations/003_canvas_group_isolation.cypher STEP 4]
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import structlog
    24	from neo4j import AsyncDriver, AsyncGraphDatabase
    25	
    26	from app.config import get_settings
    27	
    28	logger = structlog.get_logger(__name__)
    29	
    30	# migrations/003 STEP 4 建立的三条复合唯一约束 — 写侧隔离的数据库层兜底
    31	REQUIRED_CANVAS_CONSTRAINTS: frozenset[str] = frozenset(
    32	    {
    33	        "canvasnode_group_id_unique",
    34	        "canvasboard_group_id_unique",
    35	        "canvasboard_group_subject_name_unique",
    36	    }
    37	)
    38	
    39	
    40	class CanvasSchemaGate:
    41	    """三态 gate: True=齐 / False=确认缺失 (拦写) / None=未知 (不拦, 重试)."""
    42	
    43	    def __init__(self) -> None:
    44	        self._driver: AsyncDriver | None = None
    45	        self._verified: bool | None = None
    46	        self._missing: frozenset[str] = frozenset()
    47	
    48	    async def _get_driver(self) -> AsyncDriver:
    49	        if self._driver is None:
    50	            settings = get_settings()
    51	            self._driver = AsyncGraphDatabase.driver(
    52	                settings.NEO4J_URI,
    53	                auth=(settings.NEO4J_USER, settings.NEO4J_PASSWORD),
    54	            )
    55	        return self._driver
    56	
    57	    async def close(self) -> None:
    58	        if self._driver is not None:
    59	            await self._driver.close()
    60	            self._driver = None
    61	
    62	    @property
    63	    def verified(self) -> bool | None:
    64	        return self._verified
    65	
    66	    @property
    67	    def missing(self) -> frozenset[str]:
    68	        return self._missing
    69	
    70	    async def verify(self) -> bool | None:
    71	        """SHOW CONSTRAINTS 精确校验; 返回新的三态结果 (并缓存)."""
    72	        try:
    73	            driver = await self._get_driver()
    74	            settings = get_settings()
    75	            async with driver.session(database=settings.NEO4J_DATABASE) as session:
    76	                result = await session.run("SHOW CONSTRAINTS")
    77	                rows = await result.data()
    78	            present = {row.get("name") for row in rows}
    79	            missing = REQUIRED_CANVAS_CONSTRAINTS - present
    80	            self._missing = frozenset(missing)
    81	            self._verified = not missing
    82	            if missing:
    83	                logger.error(
    84	                    "canvas_schema_gate_missing_constraints",
    85	                    missing=sorted(missing),
    86	                    hint=("run: python scripts/migrate_canvas_group_isolation.py --apply (migrations/003)"),
    87	                )
    88	            else:
    89	                logger.info("canvas_schema_gate_ok", required=len(REQUIRED_CANVAS_CONSTRAINTS))
    90	            return self._verified
    91	        except Exception as e:  # noqa: BLE001 — DB 不可达 → 未知态, 不误拦
    92	            logger.warning("canvas_schema_gate_verify_failed", error=str(e)[:200])
    93	            self._verified = None
    94	            return None
    95	
    96	    async def block_reason(self) -> str | None:
    97	        """写入前调用: 返回 None=放行, 返回文案=503 拒绝.
    98	
    99	        未知态 (None) 每次重试验证 — 覆盖「启动时 DB 没起来, 之后起来了
   100	        但 volume 是新建的 (零约束)」的窗口。
   101	        """
   102	        if self._verified is None:
   103	            await self.verify()
   104	        if self._verified is False:
   105	            return (
   106	                "Canvas schema constraints missing: "
   107	                f"{sorted(self._missing)} — writes refused (data-integrity "
   108	                "fail-closed). Apply migrations/003 via "
   109	                "scripts/migrate_canvas_group_isolation.py --apply"
   110	            )
   111	        return None
   112	
   113	
   114	_gate: CanvasSchemaGate | None = None
   115	
   116	
   117	def get_canvas_schema_gate() -> CanvasSchemaGate:
   118	    """Singleton accessor."""
   119	    global _gate
   120	    if _gate is None:
   121	        _gate = CanvasSchemaGate()
   122	    return _gate
   123	
   124	
   125	async def cleanup_canvas_schema_gate() -> None:
   126	    """Shutdown hook."""
   127	    global _gate
   128	    if _gate is not None:
   129	        await _gate.close()
   130	        _gate = None

