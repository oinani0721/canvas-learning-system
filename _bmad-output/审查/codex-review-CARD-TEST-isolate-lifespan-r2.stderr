   308	class TestCodexRound1RectifiedEndpoints:
   309	    """Codex round-1 点名的失守面 — 整改后逐个锁 409 (MEDIUM-14 覆盖缺口).
   310	
   311	    每条对应一个 BLOCKER/HIGH: 这些端点此前或自建 resolver 绕过 409,
   312	    或把 409 吞成 200/500, 或在解析前就写了状态。
   313	    """
   314	
   315	    def test_chat_enrich_context_mismatch_409(self, client):
   316	        """BLOCKER-1: /enrich-context 曾是第 9 份克隆, 可读异 vault 记忆."""
   317	        payload = {
   318	            "node_path": "x.md",
   319	            "current_note_content": "c",
   320	            "current_note_frontmatter": {},
   321	            "vault_id": OTHER,
   322	        }
   323	        with patch("app.config.get_current_vault_id", return_value=ACTIVE):
   324	            resp = client.post("/api/v1/chat/enrich-context", json=payload)
   325	        assert resp.status_code == 409, resp.text
   326	
   327	    def test_chat_enrich_context_match_path_executes(self, client):
   328	        """一致 vault 的成功路径必须真的能跑完 —— 收敛 resolver 时若把
   329	        下游仍在用的 `sanitized_vault_id` 变量删掉, 只测 409 分支的用例
   330	        看不出来 (409 在它之前就 raise 了), 生产上是 NameError 500。"""
   331	        payload = {
   332	            "node_path": "x.md",
   333	            "current_note_content": "c",
   334	            "current_note_frontmatter": {},
   335	            "vault_id": ACTIVE,
   336	        }
   337	        # CARD-TEST-isolate-lifespan: enrich_context 在函数体内直调
   338	        # get_memory_service()（不经 Depends，模块级 DI 覆盖拦不住），随后
   339	        # await search_error_memories(...) —— 裸 MagicMock 会让该行抛
   340	        # TypeError → 500，把「match 路径真的跑完」的用例打回假绿（Codex
   341	        # round-1 HIGH）。桩给接口完整的 AsyncMock，让成功路径真跑完。
   342	        mem_svc = MagicMock()
   343	        mem_svc.search_error_memories = AsyncMock(return_value=[])
   344	        with (
   345	            patch("app.config.get_current_vault_id", return_value=ACTIVE),
   346	            patch(
   347	                "app.api.v1.endpoints.chat.get_memory_service",
   348	                new=AsyncMock(return_value=mem_svc),
   349	            ),
   350	        ):
   351	            resp = client.post("/api/v1/chat/enrich-context", json=payload)
   352	        # 桩齐后成功路径应真跑完；同时保留原始的 NameError 防线
   353	        assert resp.status_code == 200, resp.text
   354	        assert "sanitized_vault_id" not in resp.text
   355	        assert "NameError" not in resp.text
   356	
