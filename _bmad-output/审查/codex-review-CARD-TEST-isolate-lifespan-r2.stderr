     1	"""FR-KG-04 Phase 4 Task 4.6: HTTP exception classification at /sync/batch.
     2	
     3	Story: openspec change fix-fr-kg-04-schema-drift-and-sync-hardening.
     4	
     5	The previous endpoint returned 503 for every exception, masking logic bugs
     6	behind a "Neo4j unavailable" message. This test suite verifies the new
     7	classification:
     8	
     9	- ServiceUnavailable / AuthError / ConnectionError → 503
    10	- Neo4jError (non-service) / ValueError / TypeError / anything else → 500
    11	
    12	Response bodies must NOT contain raw exception text (no internal paths,
    13	driver state, or stack traces leaked to the client).
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	from typing import Any, Generator
    19	from unittest.mock import AsyncMock, patch
    20	
    21	import pytest
    22	from fastapi.testclient import TestClient
    23	from neo4j.exceptions import AuthError, ServiceUnavailable
    24	
    25	from app.config import Settings, get_settings
    26	from app.main import app
    27	from tests.support.lifespan import no_lifespan
    28	
    29	
    30	SAMPLE_PAYLOAD = {
    31	    "canvas_id": "test-canvas",
    32	    # P0-SYNC-ISO-2026-08-17: vault_id 必填
    33	    "vault_id": "test_vault",
    34	    "subject_id": "test-subject",
    35	    "operations": [
    36	        {
    37	            "operation_id": "00000000-0000-0000-0000-000000000001",
    38	            "entity_type": "node",
    39	            "entity_id": "node-1",
    40	            "operation": "create",
    41	            "payload": {"title": "t", "content": "c"},
    42	            "timestamp": "2026-04-07T00:00:00Z",
    43	        }
    44	    ],
    45	}
    46	
    47	
    48	def _dev_settings() -> Settings:
    49	    """Dev-mode settings so the auth dependency lets the request through."""
    50	    return Settings(
    51	        PROJECT_NAME="Test",
    52	        VERSION="1.0.0-test",
    53	        DEBUG=True,
    54	        LOG_LEVEL="DEBUG",
    55	        CORS_ORIGINS="http://localhost:3000",
    56	        CANVAS_BASE_PATH="./test_canvas",
    57	        INTERNAL_API_KEY="",
    58	    )
    59	
    60	
    61	@pytest.fixture
    62	def client() -> Generator[TestClient, None, None]:
    63	    """TestClient that cleans overrides between tests."""
    64	    with no_lifespan(app), TestClient(app) as test_client:
    65	        yield test_client
    66	    app.dependency_overrides.clear()
    67	
    68	
    69	def _override_sync_service_raising(exc: BaseException) -> Any:
    70	    """Return a patch context manager that makes SyncService raise ``exc``."""
    71	
    72	    async def raiser(*args: Any, **kwargs: Any) -> None:
    73	        raise exc
    74	
    75	    return patch(
    76	        "app.services.sync_service.SyncService.process_sync_batch",
    77	        new=AsyncMock(side_effect=raiser),
    78	    )
    79	
    80	
    81	# ---------------------------------------------------------------------------
    82	# 503 branch: infrastructure failures
    83	# ---------------------------------------------------------------------------
    84	
    85	
    86	class TestInfrastructureErrors:
    87	    """ServiceUnavailable, AuthError, ConnectionError → 503."""
    88	
    89	    def test_service_unavailable_returns_503(self, client: TestClient) -> None:
    90	        app.dependency_overrides[get_settings] = _dev_settings
    91	        with _override_sync_service_raising(ServiceUnavailable("neo4j down")):
    92	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
    93	        assert response.status_code == 503
    94	        body = response.json()
    95	        # Fixed, non-leaky message
    96	        assert body["detail"] == "Neo4j unavailable"
    97	        # Raw exception text must not appear in the response
    98	        assert "neo4j down" not in str(body)
    99	
   100	    def test_auth_error_returns_503(self, client: TestClient) -> None:
   101	        app.dependency_overrides[get_settings] = _dev_settings
   102	        with _override_sync_service_raising(AuthError("bad creds")):
   103	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
   104	        assert response.status_code == 503
   105	        assert response.json()["detail"] == "Neo4j unavailable"
   106	
   107	    def test_connection_error_returns_503(self, client: TestClient) -> None:
   108	        app.dependency_overrides[get_settings] = _dev_settings
   109	        with _override_sync_service_raising(ConnectionError("refused")):
   110	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
   111	        assert response.status_code == 503
   112	        assert response.json()["detail"] == "Neo4j unavailable"
   113	
   114	
   115	# ---------------------------------------------------------------------------
   116	# 500 branch: logic errors
   117	# ---------------------------------------------------------------------------
   118	
   119	
   120	class TestLogicErrors:
   121	    """Logic bugs (ValueError, TypeError, unexpected exceptions) → 500."""
   122	
   123	    def test_value_error_returns_500(self, client: TestClient) -> None:
   124	        app.dependency_overrides[get_settings] = _dev_settings
   125	        with _override_sync_service_raising(ValueError("unexpected payload shape")):
   126	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
   127	        assert response.status_code == 500
   128	        body = response.json()
   129	        # Fixed, generic message — no raw exception content
   130	        assert body["detail"] == "Sync batch failed unexpectedly"
   131	        assert "unexpected payload shape" not in str(body)
   132	
   133	    def test_type_error_returns_500(self, client: TestClient) -> None:
   134	        app.dependency_overrides[get_settings] = _dev_settings
   135	        with _override_sync_service_raising(TypeError("int has no len()")):
   136	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
   137	        assert response.status_code == 500
   138	        assert response.json()["detail"] == "Sync batch failed unexpectedly"
   139	
   140	    def test_generic_exception_returns_500(self, client: TestClient) -> None:
   141	        app.dependency_overrides[get_settings] = _dev_settings
   142	
   143	        class UnknownError(Exception):
   144	            """A custom exception never seen before."""
   145	
   146	        with _override_sync_service_raising(UnknownError("mystery")):
   147	            response = client.post("/api/v1/sync/batch", json=SAMPLE_PAYLOAD)
   148	        assert response.status_code == 500
   149	        body = response.json()
   150	        assert body["detail"] == "Sync batch failed unexpectedly"
   151	        assert "mystery" not in str(body)

