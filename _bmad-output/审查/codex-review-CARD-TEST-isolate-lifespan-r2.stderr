    66	TARGET = BACKEND_DIR / TARGET_REL
    67	
    68	#: 原文件里的隔离形态（必须恰好出现一次，否则说明文件已被动过，先停下来）。
    69	ANCHOR = "with no_lifespan(app), TestClient(app) as c:"
    70	MUTATED = "with TestClient(app) as c:"
    71	
    72	#: 与 tests/support/live_port_guard.py 的 BLOCK_REASON 保持一致。
    73	EXPECTED_REASON = "live Neo4j port connect attempted"
    74	
    75	#: 与 backend/scripts/lifespan_isolation_runtime_sha.sh 的监视清单保持一致。
    76	RUNTIME_FILES = [
    77	    BACKEND_DIR / "data/bug_log.jsonl",
    78	    BACKEND_DIR / "app/data/vault_index_pending.jsonl",
    79	    BACKEND_DIR / "data/outbox/events.jsonl",
    80	]
    81	
    82	#: 变异态每个用例都要完整跑一遍真实 lifespan（被拦的连接各自带驱动级重试/
    83	#: 超时），实测单用例 ~30-110s（机器负载相关，多 session 并行时更慢）——
    84	#: 19 个用例全跑 ≈ 35 分钟，把「验证负门」变成半小时级负担。卡文判据写的是
    85	#: 「**指定 nodeid** 全部 FAIL」而非「全部用例」：取 3 条代表性 nodeid
    86	#: （GET 成功路径 / POST 写路径 / 404 路径），红集判据相应改为与选中集严格
    87	#: 相等。全 19 条逐个红这件事由「防线形态同构」+ 本子集实证共同背书，
    88	#: 如实登记于验收单（「这道负门不比什么」）。
    89	SELECTED_NODEID_FILTER = "test_get_returns_200 or test_add_returns_200 or test_remove_nonexistent_returns_404"
    90	PYTEST_TIMEOUT_S = 1500
    91	
    92	# ═══════════════════════════════════════════════════════════════════════════
    93	# 裁判 6 的 AST 门 —— 静态扫描「裸 with TestClient(app.main 的 app)」
    94	# ═══════════════════════════════════════════════════════════════════════════
    95	
    96	#: 扫描范围（与卡文裁判 6 一致，并按 Codex round-1 MEDIUM 扩到子目录全部 .py，
    97	#: 覆盖 tests/unit/conftest.py、tests/unit/grouping/conftest.py 等共享 fixture 面）。
    98	#: tests/integration、tests/e2e、regression 及其它根级文件**不在射程**：
    99	#: 前者按路径豁免（advisory），后者吃根 conftest 的 lifespan-free client fixture。
   100	AST_SCOPE_DIRS = ["tests/api", "tests/unit"]
   101	AST_SCOPE_FILES = [
   102	    "tests/test_debug.py",
   103	    "tests/test_deep_monitoring.py",
   104	    "tests/conftest.py",
   105	]
   106	
   107	#: 同一 with 语句里允许充当隔离基元的名字。
   108	ISOLATION_HELPER_NAMES = {"no_lifespan", "lifespan_lite"}
   109	
   110	_ORIGIN_MAIN = "app.main"
   111	_ORIGIN_FASTAPI = "FastAPI()"
   112	_ORIGIN_UNKNOWN = "unknown"
   113	
   114	
   115	def _call_name(node: ast.expr) -> str | None:
   116	    """Call(...) 的函数名（仅 Name 形式），否则 None。"""
   117	    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
   118	        return node.func.id
   119	    return None
   120	
   121	
   122	class _ModuleIndex:
   123	    """一次 ast.parse 的静态索引：import 别名 + 按作用域的名字来源表。
   124	
   125	    来源（Codex round-1 HIGH 整改：支持函数级 import 与别名，解析不了 = 违规）：
   126	      * ``from app.main import app``（任意层级）→ 绑定名 → _ORIGIN_MAIN；
   127	      * ``import app.main`` / ``import app.main as m`` → 绑定名 → _ORIGIN_MAIN
   128	        （供 ``m.app`` 这类 Attribute 解析）；
   129	      * ``x = FastAPI(...)`` → x → _ORIGIN_FASTAPI（局部应用正例）；
   130	      * 其它 Name 绑定 → _ORIGIN_UNKNOWN；
   131	      * 解析失败 → _ORIGIN_UNKNOWN（= 违规，fail-closed）。
   132	
   133	    作用域：每条名字记到「离它最近的 enclosing 函数」的作用域表；With 处解析时
   134	    沿 parent 链从内向外查，最后查模块级。类体视作透明（近似，往保守方向偏）。
   135	    """
   136	
   137	    def __init__(self, tree: ast.Module) -> None:
   138	        self.parent: dict[int, ast.AST] = {}
   139	        for node in ast.walk(tree):
   140	            for child in ast.iter_child_nodes(node):
   141	                self.parent[id(child)] = node
   142	
   143	        self.client_aliases: set[str] = {"TestClient"}
   144	        self.module_scope: dict[str, str] = {}
   145	        self.scope_by_func: dict[int, dict[str, str]] = {}
   146	        self._index_statements(tree.body, self.module_scope)
   147	        for node in ast.walk(tree):
   148	            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
   149	                scope: dict[str, str] = {}
   150	                self._index_statements(node.body, scope)
   151	                self.scope_by_func[id(node)] = scope
   152	
   153	    def _index_statements(self, stmts, scope: dict[str, str]) -> None:
   154	        """把一批语句的名字绑定记入 scope；不跨函数边界（内层函数另行建表）。"""
   155	        for stmt in stmts:
   156	            self._index_one(stmt, scope)
   157	            if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
   158	                continue
   159	            for field in ("body", "orelse", "finalbody"):
   160	                block = getattr(stmt, field, None)
   161	                if block:
   162	                    self._index_statements(block, scope)
   163	            if isinstance(stmt, (ast.With, ast.AsyncWith)):
   164	                for item in stmt.items:
   165	                    var = item.optional_vars
   166	                    if isinstance(var, ast.Name):
   167	                        scope.setdefault(var.id, _ORIGIN_UNKNOWN)
   168	            if isinstance(stmt, ast.ClassDef):
   169	                self._index_statements(stmt.body, scope)
   170	
   171	    def _index_one(self, stmt, scope: dict[str, str]) -> None:
   172	        if isinstance(stmt, ast.ImportFrom):
   173	            if stmt.module == "app.main":
   174	                for alias in stmt.names:
   175	                    if alias.name == "app":
   176	                        scope[alias.asname or "app"] = _ORIGIN_MAIN
   177	            if stmt.module == "fastapi.testclient":
   178	                for alias in stmt.names:
   179	                    if alias.name == "TestClient":
   180	                        self.client_aliases.add(alias.asname or "TestClient")
   181	        elif isinstance(stmt, ast.Import):
   182	            for alias in stmt.names:
   183	                if alias.name == "app.main" or alias.name.startswith("app.main."):
   184	                    bound = alias.asname or alias.name.split(".")[0]
   185	                    scope[bound] = _ORIGIN_MAIN
   186	        elif isinstance(stmt, (ast.Assign, ast.AnnAssign)):
   187	            value = stmt.value
   188	            targets = stmt.targets if isinstance(stmt, ast.Assign) else [stmt.target]
   189	            if value is None:
   190	                return
   191	            if _call_name(value) == "FastAPI":
   192	                for t in targets:
   193	                    if isinstance(t, ast.Name):
   194	                        scope[t.id] = _ORIGIN_FASTAPI
   195	            else:
   196	                for t in targets:
   197	                    if isinstance(t, ast.Name):
   198	                        scope.setdefault(t.id, _ORIGIN_UNKNOWN)
   199	
   200	    def resolve_name(self, name: str, node: ast.AST) -> str:
   201	        cur: ast.AST | None = node
   202	        while cur is not None:
   203	            parent = self.parent.get(id(cur))
   204	            if isinstance(parent, (ast.FunctionDef, ast.AsyncFunctionDef)):
   205	                scope = self.scope_by_func.get(id(parent))
   206	                if scope and name in scope:
   207	                    return scope[name]
   208	            cur = parent
   209	        if name in self.module_scope:
   210	            return self.module_scope[name]
   211	        return _ORIGIN_UNKNOWN
   212	
   213	    def resolve_arg(self, arg: ast.expr, node: ast.AST) -> str:
   214	        if isinstance(arg, ast.Name):
   215	            return self.resolve_name(arg.id, node)
   216	        if isinstance(arg, ast.Attribute):
   217	            base = arg.value
   218	            if isinstance(base, ast.Name) and self.resolve_name(base.id, node) == _ORIGIN_MAIN:
   219	                return _ORIGIN_MAIN
   220	            return _ORIGIN_UNKNOWN
   221	        if isinstance(arg, ast.Call) and isinstance(arg.func, ast.Name) and arg.func.id == "FastAPI":
   222	            return _ORIGIN_FASTAPI
   223	        return _ORIGIN_UNKNOWN
   224	
   225	
   226	def run_ast_gate() -> tuple[int, list[str], int]:
   227	    """返回 (违规数, 违规明细, 扫描的文件数)。"""
   228	    files: list[Path] = []
   229	    for d in AST_SCOPE_DIRS:
   230	        files.extend(sorted((BACKEND_DIR / d).rglob("*.py")))
   231	    for f in AST_SCOPE_FILES:
   232	        p = BACKEND_DIR / f
   233	        if p.exists():
   234	            files.append(p)
   235	
   236	    violations: list[str] = []
   237	    for path in files:
   238	        try:
   239	            tree = ast.parse(path.read_text(encoding="utf-8"))
   240	        except SyntaxError as e:
   241	            violations.append(f"{path}: SyntaxError {e}")
   242	            continue
   243	        index = _ModuleIndex(tree)
   244	        rel = path.relative_to(BACKEND_DIR)
   245	        for node in ast.walk(tree):
   246	            if not isinstance(node, (ast.With, ast.AsyncWith)):
   247	                continue
   248	            for pos, item in enumerate(node.items):
   249	                cname = _call_name(item.context_expr)
   250	                if cname not in index.client_aliases:
   251	                    continue
   252	                args = item.context_expr.args
   253	                if not args:
   254	                    violations.append(f"{rel}:{node.lineno}: TestClient() 无参 —— 人工复核")
   255	                    continue
   256	                arg = args[0]
   257	                origin = index.resolve_arg(arg, node)
   258	                if origin != _ORIGIN_MAIN:
   259	                    # 局部 FastAPI() 正例 / 非 app 来源：放行
   260	                    continue
   261	                # app 来自 app.main：必须有**排在前面的**隔离兄弟项、且操作同一个
   262	                # app（Codex round-1 HIGH：`with TestClient(app), no_lifespan(app)`
   263	                # 是先起真 lifespan 再换栓，顺序反了等于没隔离）。
   264	                ok = False
   265	                for hpos, hitem in enumerate(node.items):
   266	                    if hpos >= pos:
   267	                        break
   268	                    if _call_name(hitem.context_expr) not in ISOLATION_HELPER_NAMES:
   269	                        continue
   270	                    hargs = hitem.context_expr.args
   271	                    if hargs and isinstance(arg, ast.Name) and isinstance(hargs[0], ast.Name) and hargs[0].id == arg.id:
   272	                        ok = True
   273	                        break
   274	                if not ok:
   275	                    arg_desc = arg.id if isinstance(arg, ast.Name) else "<expr>"
   276	                    violations.append(
   277	                        f"{rel}:{node.lineno}: with TestClient({arg_desc}) —— app 来自"
   278	                        " app.main 且缺少**在前**的 no_lifespan/lifespan_lite 兄弟项"
   279	                        "（顺序不符或参数不同名同样算违规）"
   280	                    )
   281	    return len(violations), violations, len(files)
   282	
   283	
   284	# ═══════════════════════════════════════════════════════════════════════════
   285	# 变异 + 子进程 + 还原
   286	# ═══════════════════════════════════════════════════════════════════════════
   287	
   288	
   289	def sha_of(path: Path) -> str:
   290	    if not path.exists():
   291	        return "absent"
   292	    return hashlib.sha256(path.read_bytes()).hexdigest()
   293	
   294	
   295	def runtime_snapshot() -> str:
   296	    return "\n".join(f"{sha_of(p)}  {p}" for p in RUNTIME_FILES)
   297	
   298	
   299	def _parse_outcomes(stdout: str) -> dict[str, str]:
   300	    """从 ``-rA`` 汇总块解析 nodeid → PASSED/FAILED/ERROR/...。"""
   301	    outcomes: dict[str, str] = {}
   302	    for line in stdout.splitlines():
   303	        m = re.match(r"^(PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS) (\S+)", line.strip())
   304	        if m:
   305	            outcomes[m.group(2)] = m.group(1)
   306	    return outcomes
   307	
   308	
   309	def main() -> int:
   310	    print("=== lifespan isolation NEGATIVE CONTROL ===")
   311	
   312	    # -- 0-保险. 门在位前置检查（belt）+ AST 门（裁判 6）-----------------------
   313	    conftest_text = (BACKEND_DIR / "tests/conftest.py").read_text(encoding="utf-8")
   314	    if "live_port_guard" not in conftest_text:
   315	        print(
   316	            "NEGATIVE-CONTROL: FAIL — 根 tests/conftest.py 未引用 live_port_guard："
   317	            "结账哨兵不会在子进程里工作，负门失去被测对象。"
   318	        )
   319	        return 1
   320	    n_violations, violation_lines, n_files = run_ast_gate()
   321	    print(f"[0] AST gate: {n_violations} violations across {n_files} files")
   322	    for v in violation_lines:
   323	        print(f"    VIOLATION: {v}")
   324	    if "--ast-only" in sys.argv:
   325	        if n_violations:
   326	            print("AST-GATE: FAIL")
   327	            return 1
   328	        print(f"AST-GATE: PASS (0 violations in {n_files} files)")
   329	        return 0
   330	
   331	    tmp_root = Path(tempfile.mkdtemp(prefix="lifespan-negctl-"))
   332	    vault_tmp = tmp_root / "vault"
   333	    lance_tmp = tmp_root / "lancedb"
   334	    vault_tmp.mkdir()
   335	    lance_tmp.mkdir()
   336	
   337	    original = TARGET.read_bytes()
   338	    original_sha = hashlib.sha256(original).hexdigest()
   339	    mutated = False
   340	
   341	    def _restore(*_a) -> None:
   342	        """无条件写回原始字节（幂等）。变异标志先置位，保证任何路径都会还原。"""
   343	        nonlocal mutated
   344	        if not mutated:
   345	            return
   346	        TARGET.write_bytes(original)
   347	        mutated = False
   348	
   349	    atexit.register(_restore)
   350	    for sig in (signal.SIGTERM, signal.SIGINT):
   351	        signal.signal(sig, lambda *_: (_restore(), sys.exit(130)))
   352	
   353	    before_runtime = runtime_snapshot()
   354	    pytest_rc: int | None = None
   355	    outcomes: dict[str, str] = {}
   356	    try:
   357	        # -- 1. 预采集 nodeid 全集（变异前）----------------------------------
   358	        env = os.environ.copy()
   359	        env.pop("PYTEST_ADDOPTS", None)  # 防 addopts 注入 --rootdir/--confcutdir 绕门
   360	        env["PYTHONDONTWRITEBYTECODE"] = "1"
   361	        # -p 插件加载早于 pytest 把 rootdir 塞进 sys.path —— 必须显式给
   362	        # PYTHONPATH，否则 tests.support.guard_plugin 在插件装载期不可导入。
   363	        env["PYTHONPATH"] = str(BACKEND_DIR) + os.pathsep + env.get("PYTHONPATH", "")
   364	        base_cmd = [
   365	            str(BACKEND_DIR / ".venv/bin/pytest"),
   366	            TARGET_REL,
   367	            "-p",
   368	            "tests.support.guard_plugin",  # 显式点名装门（BLOCKER 整改：不受 rootdir/confcutdir 影响）
   369	            "-p",
   370	            "no:cacheprovider",
   371	            "--override-ini=addopts=",
   372	        ]
   373	        collect = subprocess.run(
   374	            base_cmd + ["--collect-only", "-q", "-k", SELECTED_NODEID_FILTER],
   375	            cwd=BACKEND_DIR,
   376	            env=env,
   377	            capture_output=True,
   378	            text=True,
   379	            timeout=PYTEST_TIMEOUT_S,
   380	        )
   381	        expected_nodeids = {ln.strip() for ln in collect.stdout.splitlines() if "::" in ln}
   382	        if not expected_nodeids:
   383	            print("NEGATIVE-CONTROL: FAIL — 预采集拿到 0 个 nodeid")
   384	            print("--- collect stdout tail ---")
   385	            print(collect.stdout[-1500:])
   386	            return 1
   387	        print(f"[1] 预采集 nodeid 全集: {len(expected_nodeids)} 条")
   388	
   389	        # -- 2. 原地摘掉 no_lifespan ----------------------------------------
   390	        original_text = original.decode("utf-8")
   391	        count = original_text.count(ANCHOR)
   392	        if count != 1:
   393	            print(
   394	                f"NEGATIVE-CONTROL: FAIL — 隔离锚点出现 {count} 次（期望恰好 1 次），"
   395	                f"文件形态与本脚本假设不符，拒绝盲改: {TARGET_REL}"
   396	            )
   397	            return 1
   398	        mutated = True  # 先置位再写盘：任何崩溃路径都会走 _restore
   399	        TARGET.write_bytes(original_text.replace(ANCHOR, MUTATED).encode("utf-8"))
   400	        print(f"[2] 已摘掉 no_lifespan: {TARGET_REL}")
   401	
   402	        # -- 3. 跑该文件（-p 显式装门 + 根 conftest 哨兵）--------------------
   403	        env = os.environ.copy()
   404	        env.pop("PYTEST_ADDOPTS", None)
   405	        env["CANVAS_BASE_PATH"] = str(vault_tmp)
   406	        env["LANCEDB_DATA_PATH"] = str(lance_tmp)
   407	        env["PYTHONDONTWRITEBYTECODE"] = "1"
   408	        env["PYTHONPATH"] = str(BACKEND_DIR) + os.pathsep + env.get("PYTHONPATH", "")
   409	        cmd = base_cmd + ["-q", "--tb=no", "-rA", "-k", SELECTED_NODEID_FILTER]
   410	        print("[3] pytest 子进程（串行）:", " ".join(cmd))
   411	        try:
   412	            proc = subprocess.run(
   413	                cmd,
   414	                cwd=BACKEND_DIR,
   415	                env=env,
   416	                capture_output=True,
   417	                text=True,
   418	                timeout=PYTEST_TIMEOUT_S,
   419	            )
   420	        except subprocess.TimeoutExpired as e:
   421	            print("NEGATIVE-CONTROL: FAIL — 变异运行超时；faulthandler dump（stderr）如下")
   422	            err_tail = (e.stderr or "")[-5000:]
   423	            print(err_tail)
   424	            print("--- stdout tail ---")
   425	            print((e.stdout or "")[-1000:])
   426	            return 1
   427	        pytest_rc = proc.returncode
   428	        print(f"    pytest exit={pytest_rc}")
   429	
   430	        # -- 3b. 正证据：门必须在子进程里真的拦下过东西 ----------------------
   431	        m = re.search(r"NEO4J_LIVE_PORT_CONNECT_ATTEMPTS=(\d+) \(blocked=(\d+)", proc.stdout)
   432	        if not m:
   433	            print("NEGATIVE-CONTROL: FAIL — 子进程输出里没有门的汇总行（guard_plugin 未加载？）")
   434	            print("--- child stdout tail ---")
   435	            print(proc.stdout[-1500:])
   436	            return 1
   437	        total_attempts, blocked_attempts = int(m.group(1)), int(m.group(2))
   438	        print(f"[3b] 子进程门汇总: attempts={total_attempts} blocked={blocked_attempts}")
   439	        if blocked_attempts < 1:
   440	            print(
   441	                "NEGATIVE-CONTROL: FAIL — 变异态下 blocked=0：门未在子进程生效"
   442	                "（或 lifespan 未触发连接），防线证明不成立"
   443	            )
   444	            return 1
   445	
   446	        # -- 4. 解析 -rA 输出，逐用例核对红因 --------------------------------
   447	        outcomes = _parse_outcomes(proc.stdout)
   448	        total = len(outcomes)
   449	        green = sorted(nid for nid, oc in outcomes.items() if oc != "FAILED")
   450	        red_nodeids = {nid for nid, oc in outcomes.items() if oc == "FAILED"}
   451	        red_for_wrong_reason: list[str] = []
   452	        for line in proc.stdout.splitlines():
   453	            lm = re.match(r"^FAILED (\S+) - (.*)$", line.strip())
   454	            if lm and EXPECTED_REASON not in lm.group(2):
   455	                red_for_wrong_reason.append(f"{lm.group(1)} :: {lm.group(2)[:160]}")
   456	        red_for_right_reason = len(red_nodeids) - len(red_for_wrong_reason)
   457	
   458	        print(
   459	            f"[4] outcomes: total={total} red={len(red_nodeids)} "
   460	            f"green={len(green)} red-wrong-reason={len(red_for_wrong_reason)}"
   461	        )
   462	        for g in green:
   463	            print(f"    GREEN (不应绿): {g}")
   464	        for w in red_for_wrong_reason:
   465	            print(f"    RED-WRONG-REASON: {w}")
   466	
   467	        if pytest_rc != 1:
   468	            print(f"    (判据锁定) pytest 退出码 {pytest_rc} ≠ 1 — 见最终裁定")
   469	    finally:
   470	        # -- 5. 逐字节还原（无论上面死在哪一步；atexit/信号再兜底）-----------
   471	        _restore()
   472	        restored_identical = sha_of(TARGET) == original_sha
   473	        after_runtime = runtime_snapshot()
   474	        runtime_unchanged = before_runtime == after_runtime
   475	
   476	    print(f"[5] 还原完成; byte-identical={restored_identical}; runtime sha unchanged={runtime_unchanged}")
   477	    if not restored_identical:
   478	        print("NEGATIVE-CONTROL: FAIL — 源文件未能逐字节还原（这是事故，请人工检查 git diff）")
   479	        return 1
   480	    shutil.rmtree(tmp_root, ignore_errors=True)
   481	
   482	    # -- 6. 裁定 --------------------------------------------------------------
   483	    problems: list[str] = []
   484	    if pytest_rc is None:
   485	        problems.append("pytest 未运行")
   486	    if pytest_rc != 1:
   487	        problems.append(f"pytest 退出码 {pytest_rc} ≠ 1（期望恰为 tests-failed）")
   488	    if total != len(expected_nodeids):
   489	        problems.append(f"用例总数 {total} ≠ 预采集 {len(expected_nodeids)} — 解析或收集缩水")
   490	    if green:
   491	        problems.append(f"{len(green)} 个用例在 no_lifespan 摘除后仍然绿（哨兵没接住）")
   492	    if red_nodeids != expected_nodeids:
   493	        missing = expected_nodeids - red_nodeids
   494	        extra = red_nodeids - expected_nodeids
   495	        problems.append(f"红集与预采集全集不严格相等（缺红 {len(missing)} / 多红 {len(extra)}）")
   496	    if red_for_wrong_reason:
   497	        problems.append(f"{len(red_for_wrong_reason)} 个用例红了但原因不对（不是 live port connect）")
   498	    if not runtime_unchanged:
   499	        problems.append("运行时文件 sha 变化 — 门没能在 connect 前拦住（或写路径被触发）")
   500	    if n_violations:
   501	        problems.append(f"AST 门 {n_violations} 处违规（见上方 VIOLATION 清单）")
   502	
   503	    if problems:
   504	        print("NEGATIVE-CONTROL: FAIL")
   505	        for p in problems:
   506	            print(f"  - {p}")
   507	        return 1
   508	
   509	    print(
   510	        f"NEGATIVE-CONTROL: PASS ({red_for_right_reason} nodeids red for expected "
   511	        f"reason; runtime files unchanged; restored byte-identical; AST-GATE: "
   512	        f"PASS 0/{n_files} files)"
   513	    )
   514	    return 0
   515	
   516	
   517	if __name__ == "__main__":
   518	    sys.exit(main())
     1	#!/usr/bin/env bash
     2	# 运行时文件门 —— 证明「跑测试没动生产运行时数据」。
     3	#
     4	# [BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     5	#
     6	# 用法:
     7	#   bash backend/scripts/lifespan_isolation_runtime_sha.sh -- <要跑的命令...>
     8	#
     9	# 例:
    10	#   bash scripts/lifespan_isolation_runtime_sha.sh -- .venv/bin/pytest tests/api -q
    11	#
    12	# 判据: 三个受监视文件在命令前后 **逐字节相同**（sha256 相等，或前后都不存在）。
    13	#       任一不同 → 打印 `RUNTIME-FILES: CHANGED` 并 exit 1。
    14	#
    15	# ## 这道门不比什么（诚实边界）
    16	#
    17	# * 只看这三个**具名**文件。lifespan 若写了别的路径（新增的日志/缓存/临时文件），
    18	#   本门看不到 —— 它证明的是「这三个已知受害者没被动」，不是「全盘零写入」。
    19	# * 只比首尾两个时刻。命令中途写进去、结束前又改回原内容，本门判 unchanged。
    20	# * 不看 live vault、不看 Neo4j。数据库里被 DDL 改了 schema，本门照样绿
    21	#   —— 那是 socket 门（backend/tests/support/live_port_guard.py）的职责。
    22	# * `absent → absent` 与 `present 且 sha 不变` 同样算 unchanged；两者语义不同，
    23	#   脚本会逐条打印实际状态，不要只看最后一行结论。
    24	#
    25	# 退出码:
    26	#   1  = 文件被改（门的裁定）
    27	#   其它 = 被包裹命令自己的退出码（测试红了照样透出来，不被门吞掉）
    28	
    29	set -uo pipefail
    30	
    31	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    32	BACKEND_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    33	
    34	# 受监视文件 —— 均 git-ignored 的运行时产物，均由 app/main.py 的 lifespan 链写。
    35	#   bug_log.jsonl            <- app/services/bug_tracker.py
    36	#   vault_index_pending.jsonl<- app/services/vault_index_orchestrator.py
    37	#   outbox/events.jsonl      <- app/services/event_bus.py
    38	WATCHED=(
    39	  "${BACKEND_DIR}/data/bug_log.jsonl"
    40	  "${BACKEND_DIR}/app/data/vault_index_pending.jsonl"
    41	  "${BACKEND_DIR}/data/outbox/events.jsonl"
    42	)
    43	EXPECTED_WATCH_COUNT=3
    44	
    45	# 自检: 监视清单不能悄悄变空/变短 —— 空清单会让本门「零比较、恒绿」。
    46	if [ "${#WATCHED[@]}" -ne "${EXPECTED_WATCH_COUNT}" ]; then
    47	  echo "RUNTIME-FILES: GATE-BROKEN — 监视清单有 ${#WATCHED[@]} 项, 期望 ${EXPECTED_WATCH_COUNT} 项" >&2
    48	  exit 1
    49	fi
    50	
    51	if [ "${1:-}" != "--" ]; then
    52	  echo "用法: bash $0 -- <command...>" >&2
    53	  echo "  ('--' 之后的一切原样作为命令执行)" >&2
    54	  exit 2
    55	fi
    56	shift
    57	if [ "$#" -eq 0 ]; then
    58	  echo "RUNTIME-FILES: GATE-BROKEN — '--' 之后没有命令; 拒绝空跑（空跑必然 unchanged, 是假绿）" >&2
    59	  exit 2
    60	fi
    61	
    62	snapshot() {
    63	  # 逐行输出 "<sha256|absent>  <path>"；顺序与 WATCHED 一致。
    64	  # hash 管道任何一环失败（shasum 出错 / 结果非 64 位十六进制）都判门损坏，
    65	  # 不允许「空 digest 前后相等 = unchanged」的假绿（Codex round-1 HIGH）。
    66	  local f digest
    67	  for f in "${WATCHED[@]}"; do
    68	    if [ -f "$f" ]; then
    69	      digest="$(shasum -a 256 "$f")" || {
    70	        echo "RUNTIME-FILES: GATE-BROKEN — shasum 失败: $f" >&2
    71	        exit 1
    72	      }
    73	      digest="$(printf '%s' "$digest" | awk '{print $1}')"
    74	      if ! printf '%s' "$digest" | grep -qE '^[0-9a-f]{64}$'; then
    75	        echo "RUNTIME-FILES: GATE-BROKEN — sha256 结果非 64-hex: '$digest' ($f)" >&2
    76	        exit 1
    77	      fi
    78	      printf '%s  %s\n' "$digest" "$f"
    79	    else
    80	      printf 'absent  %s\n' "$f"
    81	    fi
    82	  done
    83	}
    84	
    85	BEFORE="$(snapshot)"
    86	echo "=== RUNTIME-FILES before ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    87	echo "${BEFORE}"
    88	echo "=== 执行被包裹命令 ==="
    89	echo "\$ $*"
    90	
    91	set +e
    92	# 子 shell 执行：builtin（`exit 0`）/ eval / 函数定义都死在子壳里，
    93	# 无法篡改本壳的 snapshot 函数、BEFORE 变量或跳过 after 快照（Codex round-1 HIGH）。
    94	( "$@" )
    95	CMD_RC=$?
    96	set -e
    97	
    98	AFTER="$(snapshot)"
    99	echo "=== RUNTIME-FILES after ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
   100	echo "${AFTER}"
   101	echo "WRAPPED-COMMAND-EXIT: ${CMD_RC}"
   102	
   103	if [ "${BEFORE}" != "${AFTER}" ]; then
   104	  echo "RUNTIME-FILES: CHANGED"
   105	  echo "--- diff (before vs after) ---"
   106	  diff <(echo "${BEFORE}") <(echo "${AFTER}") || true
   107	  exit 1
   108	fi
   109	
   110	echo "RUNTIME-FILES: unchanged"
   111	exit "${CMD_RC}"
     1	"""「测试进程运行时零连现网 Neo4j」硬门。
     2	
     3	[BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     4	
     5	## 为什么是双层，而不只是「connect 前抛异常」
     6	
     7	`backend/app/main.py` 的 lifespan 每一步都包在 ``try/except Exception`` +
     8	``logger.warning`` 里（预热 MemoryService、fulltext index、LanceDB recover、
     9	EventBus recover_outbox、graphiti 探活、wikilink build …）。所以在 connect 处抛出的
    10	``RuntimeError`` 会被**吞掉**：``TestClient.__enter__`` 照常成功，用例照常全绿。
    11	
    12	2026-09-01 于本车道 venv 实测（scratchpad/exp_mechanics.py）：不换 lifespan 栓时，
    13	真实 ``app.main.app`` 起 ``TestClient`` 会发起 3 次到 ``('::1', 7691, 0, 0)`` 的连接，
    14	3 次全部被本门拦下，**而没有任何一条用例变红**。
    15	
    16	因此本门是三层：
    17	
    18	1. **connect 前抛**（fail-closed）—— 保证进程永远不会真的连上现网库；
    19	2. **每用例结账**（conftest 的 ``pytest_runtest_makereport`` 哨兵）—— 把被生产代码
    20	   吞掉的拦截转成该用例 ``FAILED``；
    21	3. **session 总账**（conftest 的 ``pytest_cmdline_main`` 收口）—— 任何「到死都没被
    22	   哨兵结账」的拦截（迟到线程、collection 期、未知线程）都会把整个 pytest 进程的
    23	   退出码改成 3。没有这一层，一条从不在任何用例名下出现的拦截就无人买单。
    24	
    25	## 归属模型（线程安全 + 未知来源 fail-closed）
    26	
    27	当前用例的归属信息放 **ContextVar**（不是共享字段）：主线程在
    28	``pytest_runtest_protocol`` 边界 set/reset，TestClient 的 anyio portal 线程会携带
    29	上下文副本（2026-09-01 实测 ``ContextVar`` 值在 portal 线程可见），所以 portal 里
    30	发起的连接能记到发起用例名下。**不带上下文的裸线程**（``threading.Thread`` 直启）
    31	看到的是默认值 → 归 ``<unknown>`` 且**永不豁免** → fail-closed。
    32	
    33	## 这道门不比什么（诚实边界，验收单同步登记）
    34	
    35	* 只拦本进程内的 ``socket.socket.connect`` / ``connect_ex``。**子进程**里的连接
    36	  （``subprocess`` / ``os.system`` 起的 python）不在射程内。
    37	* 只拦 TCP 连接建立那一刻。若某处**复用**了一条门装上之前就已建立的连接，
    38	  本门看不到。
    39	* 只按**目标端口**判定，不解析 bolt 协议。连到 7691/7687 之外端口的现网库
    40	  （例如有人改了 compose 端口映射）本门不拦。
    41	* uvloop 走 libuv 自己的 connect，**不经过** ``socket.socket.connect``。本门在
    42	  :func:`install` 时把 ``sys.modules["uvloop"]`` 毒化为 ``None``（此后任何
    43	  ``import uvloop`` 直接 ``ImportError``），并在 session fixture 里复核——不是
    44	  只在装门那一刻检查一次（Codex round-1 HIGH：事后检查拦不住「先装门、后导入
    45	  uvloop」的时序）。毒化是进程级承诺：本 venv 的 uvloop 全仓零引用，误伤面为零。
    46	"""
    47	
    48	from __future__ import annotations
    49	
    50	import asyncio
    51	import contextvars
    52	import os
    53	import socket as _socket_mod
    54	import sys
    55	import threading
    56	import warnings
    57	
    58	import pytest
    59	
    60	# ═══════════════════════════════════════════════════════════════════════════
    61	# 契约常量
    62	# ═══════════════════════════════════════════════════════════════════════════
    63	
    64	#: 现网 Neo4j 的 bolt 端口。7691 = docker-compose 的 canvas-learning-system-neo4j
    65	#: （backend/.env 的 NEO4J_URI）；7687 = app/config.py 的 NEO4J_URI 默认值，
    66	#: 也是 neo4j 官方默认端口——CI 没有 .env，任何遗漏隔离的测试会打到它。
    67	#: 测试容器 7692（NEO4J_TEST_URI）**不在此列**，真库门测试照常可用。
    68	BLOCKED_PORTS = frozenset({7691, 7687})
    69	
    70	#: 打了这些 marker 的用例只记录不拦（advisory）。
    71	EXEMPT_MARKERS = frozenset({"integration", "e2e", "real_neo4j"})
    72	
    73	#: 这些路径前缀下的用例只记录不拦（advisory）。
    74	#: 为什么按路径而不只按 marker：``backend/tests/integration/conftest.py`` 没有
    75	#: ``pytest_collection_modifyitems`` 自动打标，``test_story_38_7_ac3/ac5`` 等文件
    76	#: 也没有 ``pytestmark`` —— 只认 marker 会把它们错判成违规。
    77	#: ⚠️ 这是**有意的旁路**：新写的测试只要放进 tests/integration/ 就自动免拦。
    78	EXEMPT_PATH_PREFIXES = ("integration", "e2e")
    79	
    80	#: 拦截原因文案。负控脚本按这个子串判"红得是不是因为这件事"，不要随手改。
    81	BLOCK_REASON = "live Neo4j port connect attempted"
    82	
    83	_SUMMARY_PREFIX = "NEO4J_LIVE_PORT_CONNECT_ATTEMPTS"
    84	
    85	_UNKNOWN_OWNER = "<unknown>"
    86	
    87	
    88	# ═══════════════════════════════════════════════════════════════════════════
    89	# 归属上下文（ContextVar：portal 线程带副本可见，裸线程默认 fail-closed）
    90	# ═══════════════════════════════════════════════════════════════════════════
    91	
    92	_OWNER_CV: contextvars.ContextVar[str] = contextvars.ContextVar("w4_guard_owner", default=_UNKNOWN_OWNER)
    93	_EXEMPT_CV: contextvars.ContextVar[bool] = contextvars.ContextVar("w4_guard_exempt", default=False)
    94	
    95	
    96	# ═══════════════════════════════════════════════════════════════════════════
    97	# 状态
    98	# ═══════════════════════════════════════════════════════════════════════════
    99	
   100	
   101	class _GuardState:
   102	    """门的运行时账。计数跨线程累加；归属走 ContextVar。"""
   103	
   104	    def __init__(self) -> None:
   105	        self._lock = threading.Lock()
   106	        self.installed = False
   107	        self.total = 0
   108	        self.blocked = 0
   109	        self.advisory = 0
   110	        #: 已被哨兵结账（转成用例失败）的 blocked 数。
   111	        self.billed = 0
   112	        self.records: list[dict] = []
   113	        # owner -> 该用例名下尚未结账的拦截记录
   114	        self.pending: dict[str, list[dict]] = {}
   115	        self._orig_connect = None
   116	        self._orig_connect_ex = None
   117	
   118	    # ── 记账 ────────────────────────────────────────────────────────────
   119	    def record(self, address) -> bool:
   120	        """记一次到受拦端口的连接尝试。返回 True 表示应当拦（非豁免）。"""
   121	        owner = _OWNER_CV.get()
   122	        exempt = _EXEMPT_CV.get()
   123	        with self._lock:
   124	            rec = {
   125	                "address": repr(address),
   126	                "thread": threading.current_thread().name,
   127	                "owner": owner,
   128	                "exempt": exempt,
   129	            }
   130	            self.total += 1
   131	            self.records.append(rec)
   132	            if exempt:
   133	                self.advisory += 1
   134	                return False
   135	            self.blocked += 1
   136	            self.pending.setdefault(owner, []).append(rec)
   137	            return True
   138	
   139	    def take(self, owner: str) -> list[dict]:
   140	        with self._lock:
   141	            records = self.pending.pop(owner, [])
   142	            self.billed += len(records)
   143	            return records
   144	
   145	    def unaccounted_blocked(self) -> list[dict]:
   146	        """到死没被任何用例结账的 blocked 记录（迟到线程 / collection 期 / 未知线程）。
   147	
   148	        每条 blocked 记录都会先落 ``pending[owner]``；哨兵 ``take()`` 时迁出并计入
   149	        ``billed``。所以 session 结束时仍留在 ``pending`` 里的，就是无人买单的账。
   150	        """
   151	        with self._lock:
   152	            return self._unaccounted_locked()
   153	
   154	    def _unaccounted_locked(self) -> list[dict]:
   155	        """``self._lock`` 已持有的前提下取无人买单的账（不可重入锁，禁止嵌套获取）。"""
   156	        return [rec for records in self.pending.values() for rec in records]
   157	
   158	    def summary_line(self) -> str:
   159	        with self._lock:
   160	            unaccounted = len(self._unaccounted_locked())
   161	            return (
   162	                f"{_SUMMARY_PREFIX}={self.total} "
   163	                f"(blocked={self.blocked}, advisory={self.advisory}, "
   164	                f"unaccounted={unaccounted})"
   165	            )
   166	
   167	
   168	STATE = _GuardState()
   169	
   170	
   171	def begin_item(owner: str, exempt: bool) -> None:
   172	    """标记「现在起到 end_item 之间的连接归属 owner」（ContextVar，portal 线程可见）。"""
   173	    _OWNER_CV.set(owner)
   174	    _EXEMPT_CV.set(exempt)
   175	
   176	
   177	def end_item() -> None:
   178	    """结束归属：主线程上下文复位；未知线程/迟到连接自此落 <unknown>（fail-closed）。"""
   179	    _OWNER_CV.set(_UNKNOWN_OWNER)
   180	    _EXEMPT_CV.set(False)
   181	
   182	
   183	# ═══════════════════════════════════════════════════════════════════════════
   184	# 端口提取 + 包装
   185	# ═══════════════════════════════════════════════════════════════════════════
   186	
   187	
   188	def extract_port(address) -> int | None:
   189	    """从 socket 地址里取端口。
   190	
   191	    IPv4 是 2 元组 ``('127.0.0.1', 7691)``；IPv6 是 4 元组
   192	    ``('::1', 7691, 0, 0)`` —— 2026-09-01 实测 neo4j 驱动走的正是 IPv6 四元组，
   193	    只按 ``len(address) == 2`` 判会**整条漏掉**。
   194	    AF_UNIX（str/bytes 地址）与其它协议族返回 None（不在本门射程）。
   195	    """
   196	    if isinstance(address, tuple) and len(address) >= 2:
   197	        port = address[1]
   198	        if isinstance(port, int):
   199	            return port
   200	    return None
   201	
   202	
   203	def _block_message(address) -> str:
   204	    return (
   205	        f"{BLOCK_REASON}: {address!r}. "
   206	        f"受拦端口 {sorted(BLOCKED_PORTS)} 是现网 Neo4j；测试进程不得连接。"
   207	        f"若这是端点测试，请用 backend/tests/support/lifespan.py::no_lifespan "
   208	        f"关掉 app.main 的 lifespan；若确需真库，用测试容器 "
   209	        f"NEO4J_TEST_URI(7692) 并打 integration/real_neo4j marker。"
   210	    )
   211	
   212	
   213	def _guarded_connect(sock_self, address):
   214	    if extract_port(address) in BLOCKED_PORTS:
   215	        if STATE.record(address):
   216	            raise RuntimeError(_block_message(address))
   217	    return STATE._orig_connect(sock_self, address)
   218	
   219	
   220	def _guarded_connect_ex(sock_self, address):
   221	    """``connect_ex`` 正常返回 errno 而不抛；这里**故意抛**。
   222	
   223	    fail-closed 优先于 API 形状：一个用 connect_ex 探活现网库的调用方，
   224	    拿到 errno 会静默走降级分支，那正是本卡要消灭的「静默连库」。
   225	    """
   226	    if extract_port(address) in BLOCKED_PORTS:
   227	        if STATE.record(address):
   228	            raise RuntimeError(_block_message(address))
   229	    return STATE._orig_connect_ex(sock_self, address)
   230	
   231	
   232	def poison_uvloop() -> None:
   233	    """把 ``import uvloop`` 在本进程内变成 ``ImportError``。
   234	
   235	    uvloop 的 connect 走 libuv，绕过 ``socket.socket.connect`` —— 与其事后
   236	    检查「有没有人用了 uvloop」（Codex round-1 HIGH：时序上拦不住先装门后
   237	    导入），不如直接关死这扇门。本 venv 的 uvloop 全仓零引用，误伤面为零；
   238	    若未来确需 uvloop，必须连本门一起重新设计（下沉到 uvloop/OS 层）。
   239	    """
   240	    if "uvloop" not in sys.modules:
   241	        sys.modules["uvloop"] = None  # type: ignore[assignment] — import 时即 ImportError
   242	        for mod_name in [m for m in sys.modules if m.startswith("uvloop.")]:
   243	            sys.modules[mod_name] = None  # type: ignore[assignment]
   244	
   245	
   246	def install() -> None:
   247	    """装门 + 毒化 uvloop。幂等——重复调用不会把包装函数当成原函数存起来。"""
   248	    poison_uvloop()
   249	    if STATE.installed:
   250	        return
   251	    STATE._orig_connect = _socket_mod.socket.connect
   252	    STATE._orig_connect_ex = _socket_mod.socket.connect_ex
   253	    _socket_mod.socket.connect = _guarded_connect  # type: ignore[method-assign]
   254	    _socket_mod.socket.connect_ex = _guarded_connect_ex  # type: ignore[method-assign]
   255	    STATE.installed = True
   256	
   257	
   258	def uninstall() -> None:
   259	    if not STATE.installed:
   260	        return
   261	    _socket_mod.socket.connect = STATE._orig_connect  # type: ignore[method-assign]
   262	    _socket_mod.socket.connect_ex = STATE._orig_connect_ex  # type: ignore[method-assign]
   263	    STATE.installed = False
   264	
   265	
