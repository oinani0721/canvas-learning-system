   608	def _apply_mastery(fm_text, biz_ts, gn=None):
   609	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   610	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   611	    old = None
   612	    for key in ("mastery_score", "mastery", "mastery_level"):
   613	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   614	        if mo:
   615	            old = float(mo.group(1)); break
   616	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   617	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   618	    if ma and mb:
   619	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   620	    elif old is not None:
   621	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   622	    else:
   623	        a_, b_ = PRIOR_A, PRIOR_B
   624	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   625	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   626	    days_idle = 0.0
   627	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   628	    if mle:
   629	        try:
   630	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   631	        except ValueError:
   632	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   633	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   634	    # 用 GN2 而非 GN (内部对抗审查 MEDIUM): durable payload 锁的是 round(GN,2),
   635	    # 而 mastery 若用未舍入的 GN, 同一个 durable 事件在「首跑 gn=0.752」与
   636	    # 「恢复重试 gn=0.7549」两次下会算出不同的 mastery_a —— envelope 判它们
   637	    # 同一件事(两侧 GN2 都是 0.75), 产物却不同。业务量恒取账本锁住的那个值。
   638	    # gn=None ⇒ 用本次评分的 GN2; A2 重放别人的事件时传那行 durable 的 grade_norm。
   639	    a_, b_ = update_after_idle(a_, b_, GN2 if gn is None else float(gn), days_idle)
   640	    return old, a_, b_, round(mu(a_, b_), 2)
