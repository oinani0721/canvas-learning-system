   695	        r"^calibration_log:[ \t]*(?:\[[ \t]*\]|null|Null|NULL|~)?[ \t]*(#[^\n]*)?$",
   696	        lambda m: "calibration_log:" + (" " + m.group(1) if m.group(1) else ""),
   697	        fm_text, count=1, flags=re.M,
