  2937	    assert r2.returncode == 0, f"崩溃后按原始稳定时刻续跑必须可恢复: {r2.stderr[:300]}"
  2938	    assert len(_ledger_lines(vault)) == 1, "续跑不得新增账本行"
  2939	    assert _run_validator(vault).returncode == 0
  2940	
  2941	    # ── B② A3 生效时（时刻 ≤ W）采用值与原始值分离，续跑仍可恢复
  2942	    _fresh()
  2943	    assert _run_writer_settled(vault, _payload(event_id="E0#q1", ts=TS1, review_time=TS1)).returncode == 0
  2944	    w1 = (vault / NODE_REL).read_text(encoding="utf-8")
  2945	    assert _run_writer_settled(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1)).returncode == 0
  2946	    last = list(_ledger_lines(vault))[-1]
  2947	    assert last["payload"]["review_time"] == "2026-08-01T10:00:01Z", f"A3 应把采用值推成 W+1s: {last['payload']}"
  2948	    assert last["payload"]["scored_at"] == TS1, "原始时刻不受 A3 影响"
  2949	    (vault / NODE_REL).write_text(w1, encoding="utf-8")
  2950	    r3 = _run_writer_settled(vault, _payload(event_id="E1#q1", ts="2026-08-01T10:10:00Z", review_time=TS1))
  2951	    assert r3.returncode == 0, f"A3 采用值不进等价面，续跑必须可恢复: {r3.stderr[:300]}"
