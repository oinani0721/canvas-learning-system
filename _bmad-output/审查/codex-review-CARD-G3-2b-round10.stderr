  3080	    assert rb.returncode != 0, "别节点占用本次幂等键会让本次评分**零次应用**，必须拒"
  3081	    assert "属于**别的节点**" in rb.stderr, rb.stderr[:250]
  3082	    assert _write_face(vault) == face, "零写"
