  2332	def test_round4_writer_validator_verdict_parity(vault):
  2333	    """同一条账本行, 写点与校验器必须给出**相同结论**。
  2334	
  2335	    单侧断言（「写点应该拒 X」）只能证明「我按我想的做了」; 两侧对照才能抓出
  2336	    口径分叉——round-4 报的 HIGH「消费侧 v1 准入不完整」与 MEDIUM「词法接收集
  2337	    分叉」都是这类: 顶层 `[]` / 缺 payload / `event_version: true`
  2338	    (`True == 1` 在 Python 里成立) / 时刻首尾带空白, 四种形态**写点 rc=0 而
  2339	    校验器 rc=1**, 全是**漏网**方向。
  2340	
  2341	    修法是消费前复用校验器本体的 `validate_record_full`, 而不是在写点里手写
  2342	    第二套判据 (DD-03/DD-13 同一条理由; 见 §6.2 A8)。
  2343	
  2344	    ⚠️ 对照的**适用范围是本节点的行**: 写点只对自己要消费的行负责, 别的节点
  2345	    的不合规行由校验器兜底, 写点不得越权阻塞 (末尾两条验伪守着这条边界)。
  2346	
  2347	    ⚠️ **这道门的鉴别力边界**(如实写明, 免得后人高估它): 它证明的是「两侧结论
  2348	    一致」, 不是「写点自己那几道手写门有用」。写点里排在 validate_record_full
  2349	    **之前**的几道手写准入 (顶层是 object / event_version 非 bool / 归属判断
  2350	    位置) 与校验器**功能重合** —— 单独删掉其中一道, 校验器仍拦住, 本门照样绿。
  2351	    实测: M49/M50 两条变异在只删手写门时 SURVIVED, 挂上「同时禁掉校验器那层」
  2352	    后才 KILLED。**门的鉴别力要靠变异去量, 不能靠读断言想当然。**
  2353	    """
  2354	    base = _review_row()
  2355	
  2356	    def _mutate(fn):
  2357	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2358	        row = json.loads(json.dumps(base))
  2359	        raw = fn(row)
  2360	        if raw is None:
  2361	            _write_ledger(vault, row)
  2362	        else:
  2363	            (vault / "learning_events.jsonl").write_text(raw, encoding="utf-8")
  2364	        # 合法行会触发两阶段发布（恢复先落定 + 要求重跑）——那是设计内的续跑
  2365	        # 信号, 不是拒绝, 所以用会自动续跑的 settled 版本判"最终写成没有"。
  2366	        w = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2367	        return w.returncode == 0, _run_validator(vault).returncode == 0, w
  2368	
  2369	    CASES = (
  2370	        # round-5 线索: `\x0c`(换页) 是 **Python** 眼里的空白但**不是 JSON 空白**
  2371	        # (RFC 8259 只认 space/tab/CR/LF)。写点曾用 `_line.strip()` 洗掉它再解析 ⇒
  2372	        # 解析成功、放行; 校验器不 strip、判 `Extra data` ⇒ 拒。又一次「洗值」分叉,
  2373	        # 与 MEDIUM「时刻首尾空白」同源 —— 我修了字段级的 strip, 漏了**行级**的。
  2374	        ("行尾裸换页 \\x0c", lambda r: json.dumps(r) + "\x0c\n"),
  2375	        ("行尾裸垂直制表 \\x0b", lambda r: json.dumps(r) + "\x0b\n"),
  2376	        ("顶层是 JSON 数组", lambda r: "[]\n"),
  2377	        ("顶层是 JSON 数字", lambda r: "12345\n"),
  2378	        ("本节点行缺 payload", lambda r: r.pop("payload") and None),
  2379	        ("event_version 为 true", lambda r: r.__setitem__("event_version", True)),
  2380	        ("review_time 首尾空白", lambda r: r["payload"].__setitem__("review_time", " 2026-08-01T10:00:00Z ")),
  2381	        ("未知顶层字段", lambda r: r.__setitem__("未知顶层", 1)),
  2382	        ("缺 fsrs_library_version", lambda r: r["payload"].pop("fsrs_library_version") and None),
  2383	        ("rating 越界为 9", lambda r: r["payload"].__setitem__("rating", 9)),
  2384	    )
  2385	    for desc, fn in CASES:
  2386	        wok, vok, w = _mutate(fn)
  2387	        assert wok == vok, f"[{desc}] 写点 ok={wok} 校验器 ok={vok} — 口径分叉: {w.stderr[:200]}"
  2388	        assert not wok, f"[{desc}] 两侧应当都拒（本例是不合规输入）"
  2389	
  2390	    # 验伪①: 完全合法的行两侧都必须放行 —— 否则「写点恒拒」也能骗过上面的对照
  2391	    wok, vok, w = _mutate(lambda r: None)
  2392	    assert wok and vok, f"合法行两侧都必须放行: writer={w.stderr[:200]}"
  2393	
  2394	    # 验伪①b: **JSON 自己允许的空白**(CR) 不得被误拒 —— 去掉 .strip() 的修法
  2395	    # 若改成「任何尾随字节都拒」就会误伤 CRLF 账本, 那是从漏网翻到误拒的另一侧。
  2396	    wok, vok, w = _mutate(lambda r: json.dumps(r) + "\r\n")
  2397	    assert wok and vok, f"尾随 CR 是 RFC 8259 允许的空白, 两侧都必须放行: {w.stderr[:200]}"
  2398	
  2399	    # 验伪②: **别节点**的不合规行不得阻塞本次写入（写点只管自己消费的行）
  2400	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2401	    other = json.loads(json.dumps(base))
