  3119	def test_round9_yaml_calibration_forms(vault):
  3120	    """F1 判定改用**真正的 YAML 解析器**（round-9 HIGH）。
  3121	
  3122	    ⛔ 手写正则在这张卡里被合法 YAML 写法打穿了**三次**：尾注释、inline 空列表、
  3123	    mapping 键顺序。每次补一个正则分支，下一轮就出现第四种 ——
  3124	    **一类缺陷反复以不同面貌出现，说明方法本身选错了**。
  3125	    """
  3126	    import yaml
  3127	
  3128	    LED = vault / "learning_events.jsonl"
  3129	
  3130	    # ① 四种「空」形态都必须产出合法 YAML 且同 ID 重跑收敛
  3131	    for form in ("null", "~", "[]", "# only comment"):
  3132	        base = NODE_V0.replace("mastery_score:", f"calibration_log: {form}\nmastery_score:", 1)
  3133	        assert base != NODE_V0, "预置必须真的插入 header"
  3134	        (vault / NODE_REL).write_text(base, encoding="utf-8")
  3135	        LED.unlink(missing_ok=True)
  3136	        r1 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3137	        assert r1.returncode == 0, f"[{form}] 首跑: {r1.stderr[:250]}"
  3138	        after = (vault / NODE_REL).read_text(encoding="utf-8")
  3139	        m = re.match(r"^---\n(.*?)\n---", after, re.S)
  3140	        assert m, f"[{form}] frontmatter 结构损坏"
  3141	        yaml.safe_load(m.group(1))  # 非法 YAML 会抛 —— 那正是修复前的行为
  3142	        r2 = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3143	        assert r2.returncode == 0, f"[{form}] 同 ID 重跑必须收敛: {r2.stderr[:250]}"
  3144	
  3145	    # ② mapping **键顺序**变化不得造成 F1 假阴性（用 YAML 库做合法重排）
  3146	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3147	    LED.unlink(missing_ok=True)
  3148	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  3149	    t = (vault / NODE_REL).read_text(encoding="utf-8")
  3150	    m = re.match(r"^---\n(.*?)\n---(.*)$", t, re.S)
  3151	    doc = yaml.safe_load(m.group(1))
  3152	    doc["calibration_log"] = [{k: e[k] for k in reversed(list(e))} for e in doc["calibration_log"]]
  3153	    new_fm = yaml.safe_dump(doc, allow_unicode=True, sort_keys=False, default_flow_style=False)
  3154	    (vault / NODE_REL).write_text(f"---\n{new_fm}---{m.group(2)}", encoding="utf-8")
  3155	    rk = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3156	    assert rk.returncode == 0, f"键顺序不是事实差异，F1 必须仍命中: {rk.stderr[:250]}"
  3157	
  3158	    # ③ 验伪：calibration_log 是**非法 YAML** 时必须 fail-closed（不得当作「没有条目」）
  3159	    (vault / NODE_REL).write_text(
  3160	        NODE_V0.replace("mastery_score:", "calibration_log:\n  - event_id: [unclosed\nmastery_score:", 1),
  3161	        encoding="utf-8",
  3162	    )
  3163	    LED.unlink(missing_ok=True)
  3164	    rbad = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3165	    assert rbad.returncode != 0, "非法 YAML 下 F1 不可证，必须停下而不是当成「没有条目」"
  3166	    assert "不是合法 YAML" in rbad.stderr, rbad.stderr[:250]
