   740	        # 之前写的旧行, 回落它的 review_time —— 那些行没有 A3 前后之分)。
   741	        _e_sa = str(_e_pl.get("scored_at") or _e_pl.get("review_time") or "")
   742	        _e_att = _e_pl.get("attempt_count") if isinstance(_e_pl.get("attempt_count"), int) else "null"
   743	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
