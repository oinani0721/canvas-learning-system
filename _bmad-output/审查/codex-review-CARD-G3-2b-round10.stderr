   422	def _fm_has_event(fm_text, ev_id):
   423	    """F1 判定: calibration_log 里有没有这个 event_id。
   424	
   425	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   426	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   427	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   428	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   429	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   430	
   431	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   432	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   433	    是「有总比没有强」的降级, 出现即告警。
   434	    """
   435	    try:
   436	        import yaml  # F1 判定
   437	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   438	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   439	        if isinstance(_doc, dict):
   440	            _cal = _doc.get("calibration_log")
   441	            if isinstance(_cal, list):
   442	                return any(
   443	                    isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id
   444	                    for _e in _cal
   445	                )
   446	            return False        # null / 标量 / 缺失 ⇒ 没有任何条目
   447	    except ImportError:
   448	        print("[quiz-answer] ⚠️ PyYAML 不可用 — F1 判定退回正则扫描, 只认 block list + `- event_id:` 开头的条目; 尾注释/inline/键顺序变体会假阴性")
   449	    except Exception as _ye:
   450	        raise SystemExit(f"[quiz-answer] frontmatter 的 calibration_log 不是合法 YAML ({_ye}) — F1 判定不可证, fail-closed 拒写 — 请人工修复 {NODE}")
   451	    mcal = re.search(r'^calibration_log:[ \t]*(?:#[^\n]*)?$', fm_text, re.M)
   452	    if not mcal:
   453	        return False
   454	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   455	        if ln and not ln[0].isspace():
   456	            break
   457	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   458	        if mm:
   459	            v = mm.group(1).strip()
   460	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   461	                try:
   462	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   463	                except ValueError:
   464	                    pass
   465	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   466	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   467	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   468	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   469	                v = v[1:-1].replace("''", "'")
   470	            if v == ev_id:
   471	                return True
   472	    return False
