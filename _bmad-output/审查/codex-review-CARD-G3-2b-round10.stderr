    if not str(resolved).startswith(str(FIXTURE_ROOT)):
        sys.exit(f"[g32b-ce] 目标目录越出约定前缀 ({resolved}) — 拒跑")
    if FIXTURE_ROOT.exists() and not (FIXTURE_ROOT / MARKER).is_file():
