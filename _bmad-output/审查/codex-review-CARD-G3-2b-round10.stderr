   724	        _e_sa = _SCORED_AT                 # 本次评分的原始稳定业务时刻
   725	        # `n_att` 在正常路径 append 时才算出 —— _append_calibration 定义在它之前,
   726	        # 故用 globals() 延迟取值（调用发生在 n_att 已存在之后）。
   727	        _e_att = globals().get("n_att", "null")
   728	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   729	        _e_qid = q_(p.get("question_id", "q1"))
   730	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   731	    else:
   732	        _e_pl = ev.get("payload") or {}
   733	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
   734	        # 剥完之后 `quiz:K` 与 `K` 变成同一个键, F1 判定无法区分 —— 实测账本 3 次
   735	        # 评分只记 2 条校准、attempt 停在 2, **一次复习静默消失且 rc=0 无提示**。
   736	        # (另两种 attempt 排列恰好被序数门兜住而 fail-closed —— 那是巧合不是设计,
   737	        #  「被别的门兜住」不等于缺陷不存在。)
   738	        _e_id = str(ev.get("event_id") or "")
