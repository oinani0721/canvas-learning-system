  3051	def test_round9_identity_and_self_check(vault):
  3052	    """round-9 中**卡文约束内可修**的四条。
  3053	
  3054	    ⚠️ 其余几条触及 validator（卡文明确禁改）或需要把 calibration 改成结构化
  3055	    receipt（数据格式变更 + 需 validator 配合），如实登记为移交，不在本卡修。
  3056	    """
  3057	    LED = vault / "learning_events.jsonl"
  3058	
  3059	    def _fresh():
  3060	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3061	        LED.unlink(missing_ok=True)
  3062	
