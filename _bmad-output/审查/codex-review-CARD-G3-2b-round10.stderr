  2870	def test_round7_ordinal_gap_and_self_node_id(vault):
  2871	    """H① 本次事件自身的 node_id 门；H② 序数证明跨越缺字段行时按 gap 折算。"""
  2872	    LED = vault / "learning_events.jsonl"
  2873	
  2874	    # H① 从节点路径派生的 node_id 也要过「非空且无首尾空白」
  2875	    blank = vault / "节点" / " .md"
  2876	    blank.write_text(NODE_V0, encoding="utf-8")
  2877	    LED.unlink(missing_ok=True)
  2878	    rb = _run_writer(vault, _payload(node="节点/ .md", event_id="板A#q1", ts=TS1, review_time=TS1))
  2879	    assert rb.returncode != 0, "写出去的事件将永远路由不到任何节点"
  2880	    assert "派生出的 node_id 不可用" in rb.stderr, rb.stderr[:250]
  2881	    assert not LED.exists() or not _ledger_lines(vault), "不得先落账"
  2882	
  2883	    # H② E1(真值 1) → 历史 L2(无 count) → 历史 L3(3)
  2884	    def _chain(e1_count):
  2885	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2886	        LED.unlink(missing_ok=True)
  2887	        for eid, ts in (("E1#q1", TS1), ("L2#q1", "2026-08-01T11:00:00Z"), ("L3#q1", "2026-08-01T12:00:00Z")):
  2888	            assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts, review_time=ts)).returncode == 0
  2889	        rows = list(_ledger_lines(vault))
  2890	        rows[0]["payload"]["attempt_count"] = e1_count
  2891	        rows[1]["payload"] = {"exam_board": "旧板", "note": "无 count"}
  2892	        rows[2]["payload"] = {"exam_board": "旧板", "note": "有 count", "attempt_count": 3}
  2893	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  2894	        assert _run_validator(vault).returncode == 0, "该账本本身合规"
  2895	        return _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1))
  2896	
  2897	    # 修复前是**反的**：错值 2 被接受、真值 1 被报冲突。
  2898	    assert _chain(1).returncode == 0, "真值必须放行"
  2899	    r_wrong = _chain(2)
  2900	    assert r_wrong.returncode != 0, "错值必须拒 —— 固定减 1 会把它当成对的"
  2901	    assert "envelope 冲突" in r_wrong.stderr, r_wrong.stderr[:250]
