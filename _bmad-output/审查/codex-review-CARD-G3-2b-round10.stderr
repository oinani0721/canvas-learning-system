  3086	    rt = _run_writer(vault, _payload(event_id="板A#q1", ts="2026-02-30T10:00:00Z", review_time=TS1))
  3087	    assert rt.returncode != 0, "2026-02-30 形状合法但日期不存在 —— 词法门放行，自检必须拦"
  3088	    assert "校验器自检" in rt.stderr, rt.stderr[:250]
