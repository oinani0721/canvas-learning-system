   657	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   658	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   659	def _bridge(fm_text, gn, ab, ts, rating=None):
   660	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
