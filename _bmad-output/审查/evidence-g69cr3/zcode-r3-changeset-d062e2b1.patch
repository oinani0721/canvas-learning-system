+        "            if len(digits) > 10:\n"
+        "                return 86400 * 400  # 必被 ⑧ 的 |偏移| < 24h 拒掉\n",
+        "            digits = parts[i]\n"
+        "            if len(digits) > 10:\n"
+        "                return 86400 * 400  # 必被 ⑧ 的 |偏移| < 24h 拒掉\n",
