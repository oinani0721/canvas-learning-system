+    for spec in (":AAA-1", ":EST5EDT,M3.2.0,M11.1.0", ":ABC5", "::Asia/Shanghai"):
+        assert parse(spec) is None, f"[{copy_id}] {spec!r} 被当成 POSIX 规格串收下 —— C 库对它退 UTC。"
