+            dt.astimezone(tz)
+        except Exception as exc:  # noqa: BLE001 —— 任何异常都是失败，类型不限
+            raise AssertionError(
+                f"[{copy_id}] 候选年守卫失效: {dt.isoformat()} 换算抛 "
+                f"{type(exc).__name__}: {exc}\n"
+                "  `_in_dst` 的候选年里有 year∉[1,9999]，`_rule_epoch` 的 `datetime(year, …)` 会抛。"
+            ) from exc
