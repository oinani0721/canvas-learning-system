  1298	def test_g36b_recorded_ranking_and_limits_match_code():
  1299	    """S5: recorded 的因子序与上限必须与代码真相源一致 (同上, 登记不许过期)。"""
  1300	    _, _, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1301	    assert picker._recorded_claim(recorded, "ranking_factors", "order") == list(picker.TIE_FACTOR_KEYS)
  1302	    assert picker._recorded_claim(recorded, "limits") == {
  1303	        "top_boards": picker.TOP_BOARDS_LIMIT,
  1304	        "upcoming": picker.UPCOMING_LIMIT,
  1305	    }
