  1285	def test_g36b_recorded_decay_snapshot_matches_real_module(tmp_path):
  1286	    """S5: manifest 登记的 decay 六常量必须与 vault 内 decay_beta.py 实际值一致。
  1287	
  1288	    登记抄错 = 指纹旁边挂着一份指向不存在配置的说明, 且漂移告警会天天刷。
  1289	    decay_beta.py 将来被改而 manifest 忘了同步时, 本门变红 —— 那正是它该
  1290	    说话的时刻。"""
  1291	    decay = picker.load_decay(_mk_min_vault(tmp_path, "snapshot_v", {}))
  1292	    _, _, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1293	    claimed = picker._recorded_claim(recorded, "decay_beta_constants")
  1294	    actual = {k: getattr(decay, k) for k in picker.DECAY_CONSTANT_NAMES}
  1295	    assert claimed == actual, "manifest 登记的 decay 常量与 decay_beta.py 实际值不符"
