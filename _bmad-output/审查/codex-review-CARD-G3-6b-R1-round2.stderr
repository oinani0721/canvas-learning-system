  1308	def test_g36b_authoritative_minutes_actually_take_effect(tmp_path):
  1309	    """S5 authoritative 名副其实: 改 manifest 的分钟常量, 下一轮真的按新值算。
  1310	
  1311	    这是「拍脑袋值请用户改」那句承诺的可执行形态 —— 改了不生效就是假配置。"""
  1312	    mp = _write_manifest(
  1313	        tmp_path,
  1314	        {
  1315	            "version": 7,
  1316	            "authoritative": {"estimated_minutes": {"per_due_node": 10, "per_new_node": 20}},
  1317	        },
  1318	    )
  1319	    vault = _mk_min_vault(
  1320	        tmp_path,
  1321	        "auth_v",
