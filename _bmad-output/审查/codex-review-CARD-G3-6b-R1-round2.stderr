    93	
    94	
    95	def sha(p: Path) -> str:
    96	    return hashlib.sha256(p.read_bytes()).hexdigest()
    97	
    98	
    99	def run_gate(testfile: str, gate: str) -> tuple[int, str]:
   100	    """跑**精确 nodeid**（不是 -k 子串），返回 (rc, stdout+stderr 尾部)。"""
   101	    nodeid = f"{testfile}::{gate}"
   102	    r = subprocess.run(
   103	        [".venv/bin/pytest", nodeid, "-q", "-p", "no:cacheprovider", "--no-header"],
   104	        cwd=LANE / "backend", capture_output=True, text=True,
   105	        env={"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "PYTHONDONTWRITEBYTECODE": "1",
   106	             "HOME": str(Path.home()), "LANG": "en_US.UTF-8"},
   107	    )
   108	    tail = ((r.stdout or "")[-400:] + " ||STDERR|| " + (r.stderr or "")[-300:])
   109	    return r.returncode, tail.strip().replace("\n", " | ")
   110	
   111	
   112	def _install_restore_handlers(originals: dict) -> None:
   113	    """SIGINT/SIGTERM 时也还原（finally 覆盖不到信号中断）。
   114	
   115	    如实声明：SIGKILL / 解释器硬崩仍会留下变异字节 —— 这不是 EXIT trap 的
   116	    等价物，最终判据始终是脚本末尾的逐字节比对。
   117	    """
   118	    def _restore(signum, _frame):
   119	        for path, raw in originals.items():
   120	            try:
   121	                path.write_bytes(raw)
   122	            except OSError:
   123	                pass
   124	        print(f"\n⚠ 收到信号 {signum}，已尝试还原全部目标文件", file=sys.stderr)
   125	        sys.exit(130)
   126	
   127	    for sig in (signal.SIGINT, signal.SIGTERM):
   128	        signal.signal(sig, _restore)
   129	
   130	
   131	def main() -> int:
   132	    _install_restore_handlers({PICK: PICK.read_bytes(), OVERVIEW: OVERVIEW.read_bytes()})
   133	    baseline = {PICK: sha(PICK), OVERVIEW: sha(OVERVIEW)}
   134	    print("变异前基线 sha256:")
   135	    for p, s in baseline.items():
   136	        print(f"  {p.name}: {s}")
   137	
   138	    # 先确认每道指定门在未变异状态下是绿的（否则"红"证明不了是变异造成的）
   139	    print("\n── 阶段 0：确认 8 道指定门在原样代码下全绿（红的来源必须可归因）──")
   140	    for tag, _desc, _f, _o, _n, tf, gate in MUTATIONS:
   141	        rc, tail = run_gate(tf, gate)
   142	        status = "绿" if rc == 0 else f"⛔ rc={rc}"
   143	        print(f"  {tag} {gate}: {status}")
   144	        if rc != 0:
   145	            print(f"      {tail}")
   146	            print("  ⛔ 前置不成立，中止（无法归因）")
   147	            return 2
   148	
   149	    results = []
   150	    print("\n── 阶段 1：8 条变异，严格串行 ──")
   151	    for tag, desc, target, old, new, tf, gate in MUTATIONS:
   152	        raw = target.read_bytes()
   153	        src = raw.decode("utf-8")
   154	        hits = src.count(old)
   155	        if hits != 1:
   156	            results.append((tag, "INVALID", f"锚点命中 {hits} 次（应为 1）— 死变异", ""))
   157	            print(f"[{tag}] INVALID 锚点命中 {hits} 次")
   158	            continue
   159	        try:
   160	            target.write_text(src.replace(old, new, 1), encoding="utf-8")
   161	            assert sha(target) != baseline[target], "变异未真正落盘"
   162	            rc, tail = run_gate(tf, gate)
   163	        finally:
   164	            target.write_bytes(raw)  # EXIT trap 等价物：无条件还原
   165	            restored = sha(target)
   166	            assert restored == baseline[target], f"{tag} 还原后字节不一致！{restored}"
   167	
   168	        if rc == 1:
   169	            verdict, note = "✅ 红", "rc=1（唯一能证明「测试断言失败」的退出码）"
   170	        elif rc == 0:
   171	            verdict, note = "空转", "rc=0 指定门未变红 —— 门不承重"
   172	        else:
   173	            verdict, note = "INVALID", (
   174	                f"rc={rc} —— pytest 2=中断/3=内部错/4=用法错/5=未收集到，"
   175	                "都不是「门抓住了变异」")
   176	        results.append((tag, verdict, note, desc))
   177	        print(f"[{tag}] {verdict:6s} {gate}  ({note})")
   178	        print(f"        变异: {desc}")
   179	        if verdict != "✅ 红":
   180	            print(f"        pytest: {tail}")
   181	
   182	    print("\n── 阶段 2：还原后逐字节校验 ──")
   183	    ok_bytes = True
   184	    for p, s in baseline.items():
   185	        now = sha(p)
   186	        same = now == s
   187	        ok_bytes &= same
   188	        print(f"  {p.name}: {'逐字节一致 ✅' if same else f'⛔ 漂移 {now}'}")
   189	
   190	    killed = sum(1 for _t, v, _n, _d in results if v == "✅ 红")
   191	    print(f"\n{'=' * 60}\n变异结果: {killed}/{len(MUTATIONS)} 条各杀其指定门；还原完整性: "
   192	          f"{'PASS' if ok_bytes else 'FAIL'}")
   193	    for tag, v, note, _d in results:
   194	        if v != "✅ 红":
   195	            print(f"  ⛔ {tag}: {v} — {note}")
   196	    return 0 if (killed == len(MUTATIONS) and ok_bytes) else 1
   197	
   198	
   199	if __name__ == "__main__":
   200	    sys.exit(main())

