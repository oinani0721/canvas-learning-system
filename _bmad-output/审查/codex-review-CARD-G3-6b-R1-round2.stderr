  1324	            "排期": _node(board="板", extra="fsrs_due: 2026-07-01T01:00:00Z\n"),
  1325	        },
  1326	    )
  1327	    payload, _ = picker.build_payload(vault, NOW, {}, picker.load_decay(vault), manifest_path=mp)
  1328	    assert payload["rank_manifest"]["version"] == 7
  1329	    assert payload["top_boards"][0]["estimated_minutes"] == 1 * 20 + 1 * 10 == 30
