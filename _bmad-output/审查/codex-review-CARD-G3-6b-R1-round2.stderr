    81	        '"_tie": (tie_parts["priority_pick"], tie_parts["board_last_recommended"], '
    82	        'tie_parts["min_last_examined"], tie_parts["board"]),',
    83	        PICK_TESTS, "test_g36b_tie_keys_are_single_source",
