+def _install_restore_handlers(originals: dict) -> None:
+    """SIGINT/SIGTERM 时也还原（finally 覆盖不到信号中断）。
+
+    如实声明：SIGKILL / 解释器硬崩仍会留下变异字节 —— 这不是 EXIT trap 的
+    等价物，最终判据始终是脚本末尾的逐字节比对。
