   274	    shutil.copy(LANE / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py",
   275	                vault / ".claude" / "scripts")
   276	    for stem, content in nodes.items():
   277	        (vault / "节点" / f"{stem}.md").write_text(content, encoding="utf-8")
   278	    return vault
