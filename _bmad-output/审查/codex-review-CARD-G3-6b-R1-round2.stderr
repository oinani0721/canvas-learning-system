+        ("父节为 null", {"version": 1, "authoritative": None}, D,
+         ["authoritative", "内置默认"]),
+        ("子节为 null", {"version": 1, "authoritative": {"estimated_minutes": None}}, D,
+         ["estimated_minutes", "内置默认"]),
