   717	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   718	            # 「今天刚推荐过」, 违反 S4 不虚构。
   719	            gap = (today_sh - date.fromisoformat(rec)).days
   720	        except (ValueError, TypeError):
   721	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   722	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   723	            gap = None
   724	    return {
   725	        "due_total": len(due),
   726	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   727	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   728	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   729	        "overdue_days": overdue_days,
   730	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   731	        "never_recommended": not rec,
   732	        "recommend_gap_days": gap,
   733	    }
