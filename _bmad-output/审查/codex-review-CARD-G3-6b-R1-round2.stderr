    16	from datetime import datetime, timedelta, timezone
    17	from pathlib import Path
    18	
    19	import pytest
    20	
    21	WT = Path(__file__).resolve().parents[3]
    22	sys.path.insert(0, str(WT / "scripts"))
    23	
    24	import daily_review_pick as picker  # noqa: E402
    25	
    26	NOW = datetime(2026, 7, 30, 1, 0, tzinfo=timezone.utc)
    27	
    28	
    29	_seq = iter(range(1000))
    30	
    31	
    32	def _build(tmp_path, nodes: dict, blr: dict | None = None, now: datetime = NOW):
    33	    vault = tmp_path / f"vault{next(_seq)}"  # 同一测试可多次调用, 各建独立 vault
    34	    scripts = vault / ".claude" / "scripts"
    35	    scripts.mkdir(parents=True)
    36	    (vault / "节点").mkdir()
    37	    shutil.copy(WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py", scripts)
    38	    for name, content in nodes.items():
    39	        (vault / "节点" / f"{name}.md").write_text(content, encoding="utf-8")
    40	    return picker.build_payload(vault, now, blr or {}, picker.load_decay(vault))
    41	
    42	
    43	def _node(board="普通板", extra=""):
    44	    return f'---\ntype: concept\nsource_board: "[[原白板/{board}]]"\n{extra}---\n真实内容。\n'
    45	
    46	
    47	def test_pathological_last_examined_does_not_kill_run(tmp_path):
    48	    """Code-Review M2: 年份手滑成 0001 的节点不得崩掉整轮生成。"""
    49	    payload, ranked = _build(
    50	        tmp_path,
    51	        {
    52	            "病理": _node(extra="mastery_a: 2.0\nmastery_b: 3.0\nlast_examined: 0001-01-01T00:00:00Z\n"),
    53	            "正常": _node(),
    54	        },
    55	    )
    56	    assert payload["stats"]["corrupt"] == 0 and len(ranked) == 1
    57	    assert all(r["priority"] == r["priority"] for r in ranked)  # 无 NaN
    58	
    59	
    60	def test_wikilink_board_normalization(tmp_path):
    61	    payload, ranked = _build(tmp_path, {"甲": _node(board="我的板")})
    62	    assert ranked[0]["board"] == "我的板"
    63	    assert "node 甲" in picker.render_md(payload, ranked)
    64	
    65	
    66	def test_placeholder_node_skipped_empty_notification(tmp_path):
    67	    payload, ranked = _build(
    68	        tmp_path,
    69	        {
    70	            "占位": _node(extra="").replace("真实内容。", "> 你的 1-2 句精准定义"),
    71	        },
    72	    )
    73	    assert payload["stats"]["ineligible"] == 1
    74	    assert ranked == [] and payload["notification"] is None
    75	
    76	
    77	def test_tiebreak_prefers_least_recently_recommended(tmp_path):
    78	    nodes = {"a节点": _node(board="A板"), "b节点": _node(board="B板")}
    79	    _, ranked = _build(tmp_path, nodes, blr={"A板": "2026-07-29"})
    80	    assert ranked[0]["board"] == "B板", "同分时从未被推荐的板优先"
    81	    _, ranked2 = _build(tmp_path, nodes)
    82	    assert ranked2[0]["board"] == "A板", "全无记录时按板名稳定排序"
    83	
    84	
