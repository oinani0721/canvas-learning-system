   863	    nodes, stats, ineligible, placeholder_boards = scan_nodes(vault, now, decay)
   864	    ranked, upcoming, unassigned = rank_boards(nodes, board_last_recommended, now, minutes)
   865	    stats["unassigned"] = len(unassigned)
   866	    # CARD-G3-6a S1: 级联判桶 + why_due 一次算好, due_nodes 行与 buckets 分组
