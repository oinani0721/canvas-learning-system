    38	        '"why_this_board": why_this_board(factors),',
    39	        '"why_this_board": why_this_board({**factors, "due_total": factors["due_total"] + 1}),',
    40	        PICK_TESTS, "test_g36b_why_this_board_recomputes_from_factors",
    41	    ),
    42	    (
    43	        "M2", "sha 不随 decay 系数变（decay 常量退出摘要）",
    44	        PICK,
    45	        '"decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},',
    46	        '"decay_beta_constants": {k: 0 for k in DECAY_CONSTANT_NAMES},',
    47	        PICK_TESTS, "test_g36b_sha_changes_for_every_single_coefficient",
    48	    ),
    49	    (
    50	        "M3", "渲染层自算分钟（UI 再算，违反单通路）",
    51	        OVERVIEW,
    52	        'text = html.escape(why) + f" · 预计 {int(mins)} 分钟"',
    53	        'text = html.escape(why) + f" · 预计 {len(r.get(\'nodes\') or []) * 3} 分钟"',
    54	        OV_TESTS, "test_g36b_page_renders_explain_row_and_escapes_hostile",
    55	    ),
    56	    (
    57	        "M4", "排序倒序（改序，违反 A2 冻结）",
    58	        PICK,
    59	        'ranked.sort(key=lambda r: r["_tie"])',
    60	        'ranked.sort(key=lambda r: r["_tie"], reverse=True)',
    61	        PICK_TESTS, "test_g36b_top_boards_order_matches_head_baseline",
    62	    ),
    63	    (
    64	        "M5", "截断放松 [:TOP_BOARDS_LIMIT] → [:99]",
    65	        PICK,
    66	        '"top_boards": ranked[:TOP_BOARDS_LIMIT],',
    67	        '"top_boards": ranked[:99],',
