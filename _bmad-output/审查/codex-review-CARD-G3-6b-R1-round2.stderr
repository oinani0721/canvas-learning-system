  1335	    也绝不让每日推送整轮失败。"""
  1336	    v, minutes, recorded = picker.load_rank_manifest(tmp_path / "不存在.json")
  1337	    assert v is None and minutes == picker.DEFAULT_MINUTES and recorded == {}
  1338	    assert "系数清单不可用" in capsys.readouterr().err
