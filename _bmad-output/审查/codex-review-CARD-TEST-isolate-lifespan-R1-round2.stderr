   484	    # ── FastAPI-returning helper 识别 ───────────────────────────────────
   485	    def _mark_all_fastapi_returning(self, tree: ast.Module) -> None:
   486	        """两轮：先按「可证 FastAPI 类」标一轮，再让 helper 调 helper 收敛一次。"""
   487	        for _ in range(2):
   488	            for node in ast.walk(tree):
   489	                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
   490	                    self._mark_fastapi_returning(node)
   491	
   492	    def _mark_fastapi_returning(self, fd) -> None:
   493	        """判定「本函数的**每一条**可达 return 都返回可证的局部 app」。
   494	
   495	        R1 Codex HIGH-10 打回的旧判据是「**存在**一条 return 返回局部 app」，于是
   496	
   497	            a = FastAPI()
   498	            a = production_app
   499	            return a
   500	
   501	        被标成安全，调用方裸启生产 lifespan。现在改成：
   502	
   503	        * 每一条 return 都在**它自己的位置**上按 :meth:`resolve_name` 解析
   504	          （「全部先前绑定必须一致」的口径，见该方法），必须解析为 ``O_LOCAL_APP``；
   505	        * 函数里**必须至少有一条** return（没有 return 的函数不算工厂）；
   506	        * 任何一条不合格 ⇒ 整个函数不算工厂。
   507	        """
   508	        own = self.scope_of.get(id(fd.body[0])) if fd.body else None
   509	        if own is None:
   510	            return
   511	        # 只看**本函数自己作用域**里的语句：嵌套函数的 return 归它自己，
   512	        # 不能算到外层函数头上（否则 `def outer(): def inner(): return FastAPI()`
   513	        # 会把 outer 误标成返回局部 app）。
   514	        own_stmts = [s for s in ast.walk(fd) if self.scope_of.get(id(s)) is own]
   515	        returns = [s for s in own_stmts if isinstance(s, ast.Return) and s.value is not None]
   516	        if not returns:
   517	            return
   518	        for stmt in returns:
   519	            candidates = stmt.value.elts if isinstance(stmt.value, ast.Tuple) else [stmt.value]
   520	            if not any(self._value_origin(c, stmt, own) == O_LOCAL_APP for c in candidates):
   521	                return  # 这条 return 拿不出可证的局部 app ⇒ 整个函数不算工厂
   522	        key = self._factory_key(fd)
   523	        self.fastapi_returning_funcs.add(key)
   524	
   525	    def _factory_key(self, fd) -> str:
   526	        """工厂身份 = 「(类名或 <module>) . 方法名」。
   527	
   528	        R1 Codex HIGH-11：旧实现只按**方法名**记，于是 A 类的 ``make`` 返回局部 app
   529	        会让 B 类同名、返回生产 app 的 ``make`` 也被判安全。按类限定之后，
   530	        ``self.make()`` 只能命中**它自己那个类**里的定义。
   531	        """
   532	        enclosing = self.scope_of.get(id(fd))
   533	        while enclosing is not None and enclosing.kind != "class":
   534	            enclosing = enclosing.parent
   535	        owner = getattr(enclosing.node, "name", "<anon>") if enclosing is not None else "<module>"
   536	        return f"{owner}.{fd.name}"
   537	
   538	    def _enclosing_class_name(self, node: ast.AST) -> str:
   539	        scope = self.scope_of.get(id(node))
   540	        while scope is not None and scope.kind != "class":
   541	            scope = scope.parent
   542	        return getattr(scope.node, "name", "<anon>") if scope is not None else "<module>"
   543	
   544	    # ── TestClient 识别 ─────────────────────────────────────────────────
   545	    def is_testclient_call(self, call: ast.expr, node: ast.AST, scope: _Scope) -> bool:
   546	        """这次调用是不是在构造 TestClient。
   547	
   548	        两条路，取并集（检测面要宽，判定面才敢严）：
   549	          * **词法**叫 ``TestClient``（哪怕被本地遮蔽——那种情况另有一条违规）；
   550	          * **解析**到真正 import 自 fastapi/starlette 的 TestClient 类
   551	            （覆盖 ``as TC`` 别名与 ``fastapi.testclient.TestClient`` 全链）。
   552	        """
   553	        if not isinstance(call, ast.Call):
   554	            return False
   555	        return _syntactic_call_name(call) == "TestClient" or self._callable_origin(call.func, node, scope) == (
   556	            O_TESTCLIENT_CLASS
   557	        )
   558	
   559	    @staticmethod
   560	    def testclient_app_arg(call: ast.Call) -> ast.expr | None:
   561	        """取 TestClient(...) 的 app 实参：第一个位置参数，或 ``app=`` 关键字。
   562	
   563	        R1 Codex MEDIUM-13：只看位置参数会漏掉 ``TestClient(app=app)``。
   564	        """
   565	        if call.args:
   566	            return call.args[0]
   567	        for kw in call.keywords:
   568	            if kw.arg == "app":
   569	                return kw.value
   570	        return None
   571	
   572	    # ── 解析 ────────────────────────────────────────────────────────────
   573	    def scope_for(self, node: ast.AST) -> _Scope:
   574	        """节点所属作用域。
   575	
   576	        ``scope_of`` 只对**语句**建了索引，所以表达式节点（比如
   577	        ``stack.enter_context(client)`` 这个 Call）要沿父链往上找到它所在的语句。
   578	        直接 fallback 到 module_scope 会让函数内的局部名字整片解析不出来。
   579	        """
   580	        cur: ast.AST | None = node
   581	        while cur is not None:
   582	            scope = self.scope_of.get(id(cur))
   583	            if scope is not None:
   584	                return scope
   585	            cur = self.parents.get(id(cur))
   586	        return self.module_scope
   587	
   588	    def parent_of(self, node: ast.AST) -> ast.AST | None:
   589	        return self.parents.get(id(node))
   590	
   591	    def resolve_name(self, name: str, pos: tuple[int, int], scope: _Scope) -> str:
   592	        """在 ``scope`` 处、位置 ``pos`` 上，名字 ``name`` 的来源。
   593	
   594	        判据（R1 Codex HIGH-9 整改后）：**所有**位于 ``pos`` 之前的绑定必须来源
   595	        一致，才给出那个来源；有任何分歧一律 unknown（= 违规，fail-closed）。
   596	
   597	        为什么不能只取「最后一次绑定」：那是**词法**上的最后一次，不是**控制流**
   598	        上的。Codex 的反例——
   599	
   600	            app = production_app
   601	            if use_local:
   602	                app = FastAPI()
   603	            with TestClient(app): ...
   604	
   605	        ——「最后一次绑定」是 ``FastAPI()``，于是判安全；而 ``use_local`` 为假时
   606	        跑的是生产 app 的真实 lifespan。做完整的 reaching-definition 需要 CFG；
   607	        这里用「全部先前绑定必须一致」这个**更保守**的近似：它对上面这种分支写法
   608	        必然判 unknown，代价是「先赋 A 后无条件覆盖成 B」的写法也会被判 unknown
   609	        （本仓库 371 个文件实测 0 例，见 AST 门输出）。
   610	

