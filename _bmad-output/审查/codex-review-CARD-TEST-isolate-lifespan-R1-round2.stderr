  1211	def _base_cmd() -> list[str]:
  1212	    """pytest 子进程命令前缀。
  1213	
  1214	    用 ``sys.executable -m pytest`` 而不是 ``BACKEND_DIR/.venv/bin/pytest``
  1215	    （第八批 Codex MEDIUM/卡文裁判 2）：负控必须跑在**调用者指定的那个解释器**上，
  1216	    否则「我用 A 解释器验证的门」和「你用 B 解释器跑的测试」不是同一件事。
  1217	    """
  1218	    return [
  1219	        sys.executable,
  1220	        "-m",
  1221	        "pytest",
  1222	        "-p",
  1223	        "tests.support.guard_plugin",  # 显式点名装门（不受 rootdir/confcutdir 影响）
  1224	        "-p",
  1225	        "no:cacheprovider",
  1226	        "--override-ini=addopts=",
  1227	    ]
