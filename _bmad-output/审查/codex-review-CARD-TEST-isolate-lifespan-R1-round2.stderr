  1230	def _parse_summary(stdout: str) -> tuple[int, int, int, int] | str:
  1231	    """整行唯一解析门的汇总行。返回 (total, blocked, advisory, unaccounted) 或错误串。"""
  1232	    hits = [m for line in stdout.splitlines() if (m := SUMMARY_RE.match(line.strip()))]
  1233	    if len(hits) != 1:
  1234	        return f"门汇总行匹配 {len(hits)} 次（期望恰好 1 次）"
  1235	    return tuple(int(g) for g in hits[0].groups())  # type: ignore[return-value]
