   705	def analyze_source(source: str, rel: str) -> list[str]:
   706	    """对一份源码跑 AST 门，返回违规明细（空 = 合规）。
   707	
   708	    三类被检面（R1 Codex HIGH-8 之后）：
   709	
   710	    1. ``with TestClient(<app>) ...`` —— 直接进 with 的构造；
   711	    2. ``client = TestClient(<app>)`` 之后 ``with client:`` —— 实例被追踪进 with；
   712	    3. ``stack.enter_context(TestClient(<app>))`` / ``enter_context(client)``
   713	       —— ExitStack 同样会触发 ``__enter__``。
   714	
   715	    ⚠️ **不带 with 的裸 ``TestClient(app)`` 不算违规**：Starlette 只在
   716	    ``__enter__`` 里跑 lifespan，构造本身没有启动副作用（本仓库 7 个文件用这种
   717	    写法，全部无害）。
   718	    """
   719	    violations: list[str] = []
   720	    try:
   721	        tree = ast.parse(source)
   722	    except SyntaxError as e:
   723	        return [f"{rel}: SyntaxError {e}"]
   724	    index = _ModuleIndex(tree)
   725	
   726	    def flag_client_construction(call, node, scope, pos_in_with=None, with_node=None, how=""):
   727	        """判定一次「会触发 lifespan 的 TestClient 构造」是否合规。"""
   728	        app_arg = index.testclient_app_arg(call)
   729	        if app_arg is None:
   730	            violations.append(f"{rel}:{node.lineno}: TestClient() 取不到 app 实参 —— 人工复核{how}")
   731	            return
   732	        origin = index.resolve_arg(app_arg, node, scope)
   733	        if origin == O_LOCAL_APP:
   734	            return
   735	        desc = _describe(app_arg)
   736	        if origin != O_MAIN_APP:
   737	            violations.append(
   738	                f"{rel}:{node.lineno}: TestClient({desc}) —— app 来源无法静态证明"
   739	                f"（解析结果={origin}，按违规处理，人工复核）{how}"
   740	            )
   741	            return
   742	        covered = with_node is not None and _isolation_sibling_covers(index, with_node, pos_in_with, app_arg, scope)
   743	        if not covered:
   744	            covered = _isolation_enclosing_covers(index, node, app_arg)
   745	        if not covered:
   746	            violations.append(
   747	                f"{rel}:{node.lineno}: TestClient({desc}) —— app 来自 app.main 且没有"
   748	                "生效中的 no_lifespan/lifespan_lite（同 with 语句里排在前面的兄弟项，"
   749	                f"或支配本处的外层 with 块）{how}"
   750	            )
   751	
   752	    for node in ast.walk(tree):
   753	        scope = index.scope_for(node)
   754	
   755	        # ── 面 1/2：with 语句 ────────────────────────────────────────────
   756	        if isinstance(node, (ast.With, ast.AsyncWith)):
   757	            for pos_i, item in enumerate(node.items):
   758	                ctx = item.context_expr
   759	                # 1) with TestClient(...)
   760	                if isinstance(ctx, ast.Call):
   761	                    syn = _syntactic_call_name(ctx)
   762	                    callee_origin = index._callable_origin(ctx.func, node, scope)
   763	                    if syn == "TestClient" and callee_origin != O_TESTCLIENT_CLASS:
   764	                        violations.append(
   765	                            f"{rel}:{node.lineno}: with TestClient(...) —— TestClient 这个名字"
   766	                            f"解析不到 {sorted(TESTCLIENT_MODULES)} 的真实 import"
   767	                            f"（当前来源={callee_origin}），无法证明它是被隔离约束覆盖的那个 TestClient"
   768	                        )
   769	                        continue
   770	                    if index.is_testclient_call(ctx, node, scope):
   771	                        flag_client_construction(ctx, node, scope, pos_in_with=pos_i, with_node=node)
   772	                    continue
   773	                # 2) with client:（client 是先前构造的 TestClient 实例）
   774	                if isinstance(ctx, ast.Name):
   775	                    inst = index.resolve_name(ctx.id, _pos(node), scope)
   776	                    if inst == O_TESTCLIENT_INSTANCE_MAIN and not _isolation_enclosing_covers(index, node, ctx):
   777	                        violations.append(
   778	                            f"{rel}:{node.lineno}: with {ctx.id}: —— {ctx.id} 是用 app.main 的 app"
   779	                            " 构造的 TestClient 实例，进 with 会跑真实 lifespan"
   780	                            "（构造点没有隔离，本处也没有支配的外层隔离块）"
   781	                        )
   782	            continue
   783	
   784	        # ── 面 3：ExitStack.enter_context(...) ──────────────────────────
   785	        if (
   786	            isinstance(node, ast.Call)
   787	            and isinstance(node.func, ast.Attribute)
   788	            and node.func.attr in _ENTER_CONTEXT_ATTRS
   789	        ):
   790	            if not node.args:
   791	                continue
   792	            target = node.args[0]
   793	            stmt = node
   794	            if isinstance(target, ast.Call) and index.is_testclient_call(target, stmt, scope):
   795	                flag_client_construction(target, node, scope, how="（经 enter_context）")
   796	            elif isinstance(target, ast.Name):
   797	                inst = index.resolve_name(target.id, _pos(node), scope)
   798	                if inst == O_TESTCLIENT_INSTANCE_MAIN and not _isolation_enclosing_covers(index, node, target):
   799	                    violations.append(
   800	                        f"{rel}:{node.lineno}: {node.func.attr}({target.id}) —— {target.id} 是用"
   801	                        " app.main 的 app 构造的 TestClient 实例，enter_context 会跑真实 lifespan"
   802	                    )
   803	    return violations
