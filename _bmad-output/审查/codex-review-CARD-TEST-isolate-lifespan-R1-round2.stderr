   806	def ast_scope_files() -> list[Path]:
   807	    """射程内文件：``backend/tests`` 下除 integration / e2e 顶层目录外的全部 .py。"""
   808	    root = BACKEND_DIR / AST_ROOT
   809	    files: list[Path] = []
   810	    for p in sorted(root.rglob("*.py")):
   811	        rel = p.relative_to(root)
   812	        if rel.parts and rel.parts[0] in AST_EXCLUDED_TOP_DIRS:
   813	            continue
   814	        files.append(p)
   815	    return files
   816	
   817	
   818	def run_ast_gate() -> tuple[int, list[str], int]:
   819	    """返回 (违规数, 违规明细, 扫描的文件数)。"""
   820	    files = ast_scope_files()

