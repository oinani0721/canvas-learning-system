   730	def _final_accounting() -> None:
   731	    """最后一道结账：任何未结账的拦截都必须让进程以非零 rc 结束。
   732	
   733	    第八批 Codex HIGH：``pytest_cmdline_main`` 返回之后还有 pytest 自身的清理、
   734	    其它 ``atexit`` 处理器和迟到线程 —— 那段窗口里被拦下的连接会被记账，进程
   735	    却仍然 ``exit 0``，于是「任何未结账尝试都令测试失败」这句承诺不成立。
   736	
   737	    R1 Codex HIGH-2：本处理器**之后**仍可能有更早注册的 atexit 回调在跑
   738	    （见 :func:`register_final_accounting`）。所以第一件事是置不可逆的
   739	    :data:`_FINALIZING`：从这一刻起，audit hook 命中受拦端口就直接
   740	    ``os._exit(3)``，不再指望任何后续结账。
   741	    """
   742	    global _FINALIZING
   743	    _FINALIZING = True
   744	    ledger = STATE.ledger()
   745	    path = os.environ.get(ENV_LEDGER)
   746	    if path:
   747	        try:
   748	            write_ledger(path)
   749	        except Exception as exc:  # noqa: BLE001 —— 落盘失败要说话，但不能盖掉结账
   750	            print(f"*** W4 guard: 账本落盘失败 {path}: {exc!r} ***", file=sys.stderr)
   751	    unaccounted = ledger["unaccounted"]
   752	    blocked = ledger["blocked"]
   753	    status = ledger["reported_status"]
   754	    # status is None ⇒ 不是 pytest 跑的（脚本/探针直接 import 本模块）：按 0 处理，
   755	    # 也就是「有非豁免拦截却打算正常退出」同样算失败。
   756	    effective_status = 0 if status is None else status
   757	    if unaccounted > 0 or (blocked > 0 and effective_status == 0):
   758	        print(
   759	            f"\n*** {BLOCK_REASON} —— 最终总账：blocked={blocked} "
   760	            f"unaccounted={unaccounted} reported_status={status}；"
   761	            f"进程被强制以退出码 {FINAL_EXIT_CODE} 结束（迟到连接不得以 0 收场）***",
   762	            file=sys.stderr,
   763	        )
   764	        for rec in ledger["unaccounted_records"]:
   765	            print(f"    - {rec['address']} on thread {rec['thread']} (owner={rec['owner']})", file=sys.stderr)
   766	        try:
   767	            sys.stdout.flush()
   768	            sys.stderr.flush()
   769	        except Exception:  # noqa: BLE001
   770	            pass
   771	        os._exit(FINAL_EXIT_CODE)
