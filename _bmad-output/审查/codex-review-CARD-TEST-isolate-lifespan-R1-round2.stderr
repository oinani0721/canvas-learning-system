   632	    def resolve_arg(self, arg: ast.expr, node: ast.AST, scope: _Scope) -> str:
   633	        if isinstance(arg, ast.Name):
   634	            return self.resolve_name(arg.id, _pos(node), scope)
   635	        if isinstance(arg, ast.Attribute):
   636	            return self._attribute_origin(arg, node, scope)
   637	        if isinstance(arg, ast.Call):
   638	            return self._value_origin(arg, node if isinstance(node, ast.stmt) else arg, scope)
   639	        return O_UNKNOWN
   640	
   641	
   642	def _syntactic_call_name(node: ast.expr) -> str | None:
   643	    """Call(...) 的**词法**函数名：``f()`` → f；``m.f()`` → f。"""
   644	    if not isinstance(node, ast.Call):
   645	        return None
   646	    if isinstance(node.func, ast.Name):
   647	        return node.func.id
   648	    if isinstance(node.func, ast.Attribute):
   649	        return node.func.attr
   650	    return None
   651	
   652	
   653	def _isolation_sibling_covers(index: "_ModuleIndex", with_node, upto_pos: int, app_arg, scope) -> bool:
   654	    """同一个 ``with`` 语句里，位置**在前**的兄弟项是否对同一个 app 做了隔离。"""
   655	    if not isinstance(app_arg, ast.Name):
   656	        return False
   657	    for hpos, hitem in enumerate(with_node.items):
   658	        if hpos >= upto_pos:
   659	            break
   660	        hctx = hitem.context_expr
   661	        if not isinstance(hctx, ast.Call):
   662	            continue
   663	        if index._callable_origin(hctx.func, with_node, scope) != O_HELPER:
   664	            continue
   665	        hargs = hctx.args
   666	        if hargs and isinstance(hargs[0], ast.Name) and hargs[0].id == app_arg.id:
   667	            return True
   668	    return False
   669	
   670	
   671	def _isolation_enclosing_covers(index: "_ModuleIndex", node, app_arg) -> bool:
   672	    """**外层**的 ``with no_lifespan(app):`` 是否支配本节点（R1 Codex MEDIUM-13）。
   673	
   674	    外层隔离块内的一切都在 no-op lifespan 生效期间执行，真实 startup 不会跑，
   675	    所以那是安全写法，旧实现却报违规。这里沿父链往上找 With，逐个看它是不是对
   676	    **同一个名字**做了隔离。
   677	    """
   678	    if not isinstance(app_arg, ast.Name):
   679	        return False
   680	    cur = index.parent_of(node)
   681	    while cur is not None:
   682	        if isinstance(cur, (ast.With, ast.AsyncWith)):
   683	            scope = index.scope_for(cur)
   684	            for hitem in cur.items:
   685	                hctx = hitem.context_expr
   686	                if not isinstance(hctx, ast.Call):
   687	                    continue
   688	                if index._callable_origin(hctx.func, cur, scope) != O_HELPER:
   689	                    continue
   690	                hargs = hctx.args
   691	                if hargs and isinstance(hargs[0], ast.Name) and hargs[0].id == app_arg.id:
   692	                    return True
   693	        cur = index.parent_of(cur)
   694	    return False
   695	
   696	
   697	def _describe(expr) -> str:
   698	    if isinstance(expr, ast.Name):
   699	        return expr.id
   700	    if isinstance(expr, ast.Attribute):
   701	        return f"<...>.{expr.attr}"
   702	    return "<expr>"
   703	
