  1243	def make_isolated_backend(tmp_root: Path) -> Path:
  1244	    """把当前工作树的 ``backend/`` 复制一份到 tmp，变异只在副本上做。
  1245	
  1246	    R1 Codex HIGH-6/HIGH-7 的结构性收口：
  1247	
  1248	    * **HIGH-7（变异前无 CAS）**：真实的 tracked 测试文件从头到尾**一个字节都不
  1249	      被写**，所以「读原文 → 期间别人编辑 → 用旧变异体覆盖」这条链根本不存在，
  1250	      不需要靠 CAS 去追一个本来就不该发生的写。
  1251	    * **HIGH-6（`absent → exists` 就 unlink 可能删掉别人的数据）**：变异运行产生的
  1252	      运行时文件（``app/data/vault_index_pending.jsonl`` 的路径是硬编码的，
  1253	      重定向不了）落在**副本**里，随 tmp 目录一起消失；真实树下的同名文件本脚本
  1254	      **永远不删**。
  1255	
  1256	    复制的是**工作树当前内容**（不是 HEAD），因为负控要验的就是此刻这份代码。
  1257	    跳过 ``.venv`` / ``__pycache__`` 等重目录；``.env`` 用软链而不是拷贝，
  1258	    避免把凭据复制进 tmp。
  1259	    """
  1260	    iso = tmp_root / "iso-backend"
  1261	    shutil.copytree(BACKEND_DIR, iso, ignore=_COPY_IGNORE, symlinks=True, dirs_exist_ok=False)
  1262	    env_file = iso / ".env"
  1263	    real_env = BACKEND_DIR / ".env"
  1264	    if env_file.exists() or env_file.is_symlink():
  1265	        env_file.unlink()
  1266	    if real_env.exists():
  1267	        env_file.symlink_to(real_env)
  1268	    # 副本里的运行时残留清掉，保证「变异态确实写了」这条判据从 absent 起步
  1269	    for p in runtime_files(iso):
  1270	        if p.exists():
  1271	            p.unlink()
  1272	    return iso
  1273	
