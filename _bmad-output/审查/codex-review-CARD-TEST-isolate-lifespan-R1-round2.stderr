  1311	def _parse_junit(path: Path, target_rel: str) -> dict[str, dict]:
  1312	    """junitxml → {nodeid: {"outcome": passed|failed|error|skipped, "text": ...}}。"""
  1313	    module_dotted = target_rel[:-3].replace("/", ".")
  1314	    out: dict[str, dict] = {}
  1315	    for case in ET.parse(path).getroot().iter("testcase"):
  1316	        classname = case.get("classname", "")
  1317	        name = case.get("name", "")
  1318	        if classname.startswith(module_dotted):
  1319	            chain = classname[len(module_dotted) :].lstrip(".")
  1320	            nid = f"{target_rel}::" + (f"{chain.replace('.', '::')}::{name}" if chain else name)
  1321	        else:
  1322	            nid = f"{classname.replace('.', '/')}::{name}"
  1323	        failure = case.find("failure")
  1324	        error = case.find("error")
  1325	        skipped = case.find("skipped")
  1326	        node = failure if failure is not None else (error if error is not None else None)
  1327	        if node is not None:
  1328	            outcome = "failed" if failure is not None else "error"
  1329	            text = " ".join(filter(None, [(node.get("message") or ""), (node.text or "")]))
  1330	        elif skipped is not None:
  1331	            outcome, text = "skipped", (skipped.get("message") or "")
  1332	        else:
  1333	            outcome, text = "passed", ""
  1334	        out[nid] = {"outcome": outcome, "text": text}
  1335	    return out
