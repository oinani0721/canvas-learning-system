   476	        if base_origin == O_TESTCLIENT_MODULE and attr.attr == "TestClient":
   477	            return O_TESTCLIENT_CLASS
   478	        if base_origin == O_FASTAPI_MODULE and attr.attr == "FastAPI":
   479	            return O_FASTAPI_CLASS
