   420	    def _is_local_app_factory_call(self, func: ast.expr, node: ast.AST, scope: _Scope) -> bool:
   421	        """本模块内「返回局部 FastAPI() 的工厂」调用形态。
   422	
   423	        两种、且只有两种：
   424	          * ``make()`` —— 裸名字，必须是本模块 def 出来的那个名字；
   425	          * ``self.make()`` / ``cls.make()`` —— 同类方法（``test_rag_four_state_api``
   426	            的 ``self._real_service_client()`` 就是这一形态）。
   427	
   428	        **刻意不接受** ``other.make()``：``other`` 的类型无法静态证明，任何对象
   429	        只要有个同名方法就能冒充局部工厂 —— 那是把 fail-closed 拆掉。
   430	        """
   431	        if isinstance(func, ast.Name):
   432	            if f"<module>.{func.id}" not in self.fastapi_returning_funcs:
   433	                return False
   434	            # 名字此刻必须仍绑定到本模块那个 def（重绑定后不再算数）
   435	            return self.resolve_name(func.id, _pos(node), scope) == f"{O_LOCAL_FUNC_PREFIX}{func.id}"
   436	        if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
   437	            if func.value.id not in ("self", "cls"):
   438	                return False
   439	            # 按**调用点所在的那个类**限定（R1 Codex HIGH-11：同名方法跨类污染）
   440	            owner = self._enclosing_class_name(node)
   441	            return f"{owner}.{func.attr}" in self.fastapi_returning_funcs
   442	        return False
