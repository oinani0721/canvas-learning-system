   779	def is_exempt(item, tests_dir) -> tuple[bool, str]:
   780	    """该用例是否豁免（只记不拦）。返回 (豁免, 依据)。
   781	
   782	    ``tests_dir`` = backend/tests 的绝对路径（由 conftest 传入 ``Path(__file__).parent``）。
   783	    路径判定用 **相对化后的首段目录**，不做整条路径的 substring——
   784	    ``/tmp/tests/integration/...`` 之类的绝对路径不得误判（Codex round-1 MEDIUM）。
   785	
   786	    ``W4_GUARD_NO_EXEMPT=1``（负控）时**一律不豁免**。
   787	    """
   788	    if exempt_disabled():
   789	        return False, "no-exempt-mode"
   790	    for marker in EXEMPT_MARKERS:
   791	        if item.get_closest_marker(marker) is not None:
   792	            return True, f"marker:{marker}"
   793	    try:
   794	        rel = item.path.resolve().relative_to(tests_dir.resolve())
   795	    except Exception:  # noqa: BLE001 —— 相对化失败（如 rootdir 外）一律不豁免，fail-closed
   796	        return False, ""
   797	    first = rel.parts[0] if rel.parts else ""
   798	    if first in EXEMPT_PATH_PREFIXES:
   799	        return True, f"path:{first}/"
   800	    return False, ""
