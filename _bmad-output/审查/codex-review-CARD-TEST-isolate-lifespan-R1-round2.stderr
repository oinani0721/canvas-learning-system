  1158	def _child_env(vault_tmp: Path, lance_tmp: Path, ledger: Path | None, backend_dir: Path) -> dict[str, str]:
  1159	    """构造子进程环境：清 Neo4j 面 → 钉死受拦目标 → 关豁免 → 隔离写路径。
  1160	
  1161	    ``backend_dir`` 是子进程的 backend 根（负控里恒为**隔离副本**），
  1162	    ``PYTHONPATH`` 必须指向它，否则 ``-p tests.support.guard_plugin`` 会加载到
  1163	    真实树里的那一份，验的就不是副本的代码了。
  1164	    """
  1165	    env = os.environ.copy()
  1166	    # 1) 清掉调用者带进来的**全部** Neo4j 相关变量（含 NEO4J_URI/USER/PASSWORD/
  1167	    #    TEST_URI/AUTH/DATABASE… 无论叫什么，只要以 NEO4J 开头）。
  1168	    for key in [k for k in env if k.upper().startswith("NEO4J")]:
  1169	        env.pop(key, None)
  1170	    # 2) 钉死：目标端口必在门的射程内；凭据是假的。
  1171	    env["NEO4J_URI"] = PINNED_NEO4J_URI
  1172	    env["NEO4J_TEST_URI"] = PINNED_TEST_URI
  1173	    env["NEO4J_USER"] = PINNED_NEO4J_USER
  1174	    env["NEO4J_PASSWORD"] = PINNED_NEO4J_PASSWORD
  1175	    # 3) 门自身的 fail-closed 开关：目标不在射程内就拒绝装门（子进程起不来）。
  1176	    env["W4_GUARD_REQUIRE_BLOCKED_TARGET"] = "1"
  1177	    # 4) 负控运行里不允许出现 advisory —— 豁免彻底关掉。
  1178	    env["W4_GUARD_NO_EXEMPT"] = "1"
  1179	    # 5) 写路径隔离到 tmp（live vault / 现网 LanceDB 只读）。
  1180	    #    ⚠️ canonical 与 legacy 两个 LanceDB 变量必须**同值**：
  1181	    #    `lib/agentic_rag/config.py::_resolve_lancedb_db_path` 在两者不同时抛
  1182	    #    RuntimeError，而 `app/main.py:103` 是**无守护直调**——于是 lifespan 会在
  1183	    #    LanceDB 这一步就 abort，**根本走不到 Neo4j 预热**，负门拿到 blocked=0
  1184	    #    却以为是「哨兵没接住」。只 pin canonical 而让 legacy 从 .env（本车道
  1185	    #    .env:94 就有 LANCEDB_PATH）漏进来，负门就变成了在测另一件事。
  1186	    #    2026-09-03 于本车道实测：只 pin canonical ⇒ 3 条全部 setup ERROR
  1187	    #    "Conflicting LanceDB paths"、attempts=0；两者同值 ⇒ 连接尝试正常发生。
  1188	    env["CANVAS_BASE_PATH"] = str(vault_tmp)
  1189	    env["LANCEDB_DATA_PATH"] = str(lance_tmp)
  1190	    env["LANCEDB_PATH"] = str(lance_tmp)
  1191	    # 6) 防注入：addopts 能塞 --rootdir/--confcutdir 绕开根 conftest；
  1192	    #    PYTEST_PLUGINS 能在门装上之前 import 任意插件。
  1193	    env.pop("PYTEST_ADDOPTS", None)
  1194	    env.pop("PYTEST_PLUGINS", None)
  1195	    # ⚠️ 不设 PYTEST_DISABLE_PLUGIN_AUTOLOAD：根 conftest 与目标文件依赖
  1196	    #    hypothesis / pytest-asyncio / pytest-bdd 的注册，关掉 autoload 会让
  1197	    #    collection 直接坏掉——那是「门没被验证」而不是「门更严」。门前窗口改由
  1198	    #    guard_plugin 的 **import 期装门** 收敛（见该模块 docstring）。
  1199	    env["PYTHONDONTWRITEBYTECODE"] = "1"
  1200	    # -p 插件加载早于 pytest 把 rootdir 塞进 sys.path —— 必须显式给 PYTHONPATH。
  1201	    # ⚠️ 只放隔离副本，**不**追加调用者原有的 PYTHONPATH：否则真实树可能排在前面，
  1202	    # 子进程会去 import 真实树的 tests.support.*，验的就不是副本了。
  1203	    env["PYTHONPATH"] = str(backend_dir)
  1204	    if ledger is not None:
  1205	        env["W4_GUARD_LEDGER"] = str(ledger)
  1206	    else:
  1207	        env.pop("W4_GUARD_LEDGER", None)
  1208	    return env
