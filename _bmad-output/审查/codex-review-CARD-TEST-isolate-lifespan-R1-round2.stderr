   803	def format_sentinel(owner: str, records: list[dict]) -> str:
   804	    lines = [
   805	        f"{BLOCK_REASON} —— 本用例期间有 {len(records)} 次到现网 Neo4j 的连接尝试被拦下。",
   806	        "（连接处抛出的异常被 app/main.py 的 lifespan try/except 吞掉了，",
   807	        "  所以由本哨兵把它转成用例失败——否则这道门什么都证明不了。）",
   808	    ]
   809	    for rec in records:
   810	        lines.append(f"  - {rec['address']} on thread {rec['thread']} (owner={owner})")
   811	    return "\n".join(lines)

