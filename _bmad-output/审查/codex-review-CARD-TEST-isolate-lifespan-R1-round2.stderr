   451	    def _attribute_origin(self, attr: ast.Attribute, node: ast.AST, scope: _Scope) -> str:
   452	        """属性访问的来源。**递归**解析 base，从而支持完整属性链。
   453	
   454	        R1 Codex MEDIUM-13：``fastapi.testclient.TestClient(...)`` 是
   455	        ``Attribute(Attribute(Name('fastapi'), 'testclient'), 'TestClient')``，
   456	        旧实现只认 base 是 ``Name`` 的一层，整条链解析不出来 → 误判。
   457	        """
   458	        base = attr.value
   459	        # app.main.app（`import app.main` 之后绑定的是顶层包 `app`）
   460	        if (
   461	            isinstance(base, ast.Attribute)
   462	            and isinstance(base.value, ast.Name)
   463	            and base.value.id == "app"
   464	            and base.attr == "main"
   465	            and attr.attr == "app"
