  1275	def sha_of(path: Path) -> str:
  1276	    if not path.exists():
  1277	        return "absent"
  1278	    return hashlib.sha256(path.read_bytes()).hexdigest()
  1279	
  1280	
  1281	def runtime_snapshot() -> str:
  1282	    return "\n".join(f"{sha_of(p)}  {p}" for p in RUNTIME_FILES)
  1283	
  1284	
  1285	def restore_absent_runtime_files(before: dict[Path, str]) -> tuple[list[str], list[str]]:
  1286	    """把变异运行创建出来的运行时文件删掉，恢复到跑之前的状态。
  1287	
  1288	    只处理「跑之前 absent、跑之后存在」这一种情况 —— 那是**本脚本引起的**新增，
  1289	    删掉即回到原状。对「跑之前就有、内容变了」的文件**刻意不覆盖**：那可能混进了
  1290	    并发进程追加的真实数据，盲写回去会静默吞掉别人的记录（与变异体的 CAS 同口径）。
  1291	    这种情况返回到 ``unresolved``，由调用方判失败并交人工。
  1292	
  1293	    Returns:
  1294	        (removed, unresolved) 两个路径描述列表。
  1295	    """
  1296	    removed: list[str] = []
  1297	    unresolved: list[str] = []
  1298	    for path in RUNTIME_FILES:
  1299	        was = before.get(path, "absent")
  1300	        now = sha_of(path)
  1301	        if was == now:
  1302	            continue
  1303	        if was == "absent" and path.exists():
  1304	            path.unlink()
  1305	            removed.append(str(path))
  1306	        else:
  1307	            unresolved.append(f"{path}: {was} → {now}")
  1308	    return removed, unresolved
