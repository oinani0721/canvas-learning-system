   221	
   222	def _legacy_text_judge(rc: int, out: str) -> bool:
   223	    """第八批 (HEAD 2cacbb0c) 的文本判据, 逐行重写用于对照。
   224	
   225	    摘要唯一性 + 形态 + `^E ...$` 整行锚定 + 「E 行前 1500 字符窗口含
   226	    conftest.py」。它判 True 而 R1 判 FAIL, 就是 (e) 关掉的那条通路。"""
   227	    summaries = [m.group(1) for line in out.splitlines() if (m := re.match(_LEGACY_SUMMARY, line.strip()))]
   228	    shape_ok = (
   229	        len(summaries) == 1
   230	        and re.fullmatch(r"1 failed(, \d+ warnings?)?", summaries[0]) is not None
   231	        and " no tests ran" not in out
   232	        and "= ERRORS =" not in out
   233	    )
   234	    m = re.search(_LEGACY_PATTERN, out, re.MULTILINE)
   235	    regex_ok = m is not None
   236	    src_ok = bool(m) and _LEGACY_SRC_HINT in out[max(0, m.start() - 1500) : m.start()]
   237	    return rc == 1 and shape_ok and regex_ok and src_ok
   238	
   239	
   240	def _apply(mut) -> str:
   241	    path: Path = mut["file"]
   242	    original = path.read_bytes()
   243	    before = sha256(original).hexdigest()
   244	    text = original.decode("utf-8")
   245	    n = text.count(mut["old"])
   246	    if n != 1:
   247	        raise SystemExit(f"[{mut['id']}] 锚点命中 {n} 次 (必须恰好 1) — 锚点漂移, 中止")
   248	    mutated = text.replace(mut["old"], mut["new"])
   249	    for i, (eo, en) in enumerate(mut.get("extras", []), start=2):
   250	        n2 = mutated.count(eo)
   251	        if n2 != 1:
   252	            raise SystemExit(f"[{mut['id']}] 第 {i} 个锚点命中 {n2} 次 (必须恰好 1) — 锚点漂移, 中止")
   253	        mutated = mutated.replace(eo, en)
   254	    _INFLIGHT[path] = original
   255	    path.write_text(mutated, encoding="utf-8")
   256	    return before
   257	
   258	
   259	def _restore(mut, before: str) -> bool:
   260	    path: Path = mut["file"]
   261	    path.write_bytes(_INFLIGHT.pop(path))
   262	    after = sha256(path.read_bytes()).hexdigest()
   263	    same = before == after
   264	    print(f"[{mut['id']}] 还原逐字节一致: {'YES' if same else 'NO!!'} ({after})")
   265	    return same
   266	
   267	
   268	def _run_negctl(gate: str):
   269	    proc = subprocess.run(
   270	        [sys.executable, NEGCTL, "--only", gate],
   271	        cwd=BACKEND,
   272	        capture_output=True,
   273	        text=True,
   274	        timeout=1800,
   275	        env={**_child_env()},
   276	    )
   277	    return proc.returncode, proc.stdout + proc.stderr
   278	
   279	
   280	def _child_env():
   281	    import os
   282	
   283	    env = dict(os.environ)
   284	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   285	    return env
   286	
   287	
   288	def _check(mut) -> bool:
   289	    print(f"\n=== [{mut['id']}] {mut['desc']}")
   290	    print(f"    指定门: {mut['gate']} / 期望 sentinel: {mut['sentinel']}")
   291	    before = _apply(mut)
   292	    try:
   293	        rc, out = _run_negctl(mut["gate"])
   294	        went_red = rc != 0
   295	        has_sentinel = mut["sentinel"] in out
   296	        ok = went_red and has_sentinel
   297	        print(f"[{mut['id']}] 指定门变红={went_red} (negctl rc={rc}); sentinel 命中={has_sentinel}")
   298	        if mut["id"] == "M9":
   299	            legacy = _legacy_text_judge(1, out)
   300	            print(f"[{mut['id']}] 第八批文本判据对同一份输出的判定: {legacy} (True = 老判据会放行, 正是 R1 关掉的通路)")
   301	            ok = ok and legacy
   302	        if not ok:
   303	            print(out[-4000:])
   304	    finally:
   305	        restored = _restore(mut, before)
   306	    return ok and restored
   307	
   308	
   309	def main() -> int:
   310	    results = []
   311	    for mut in MUTATIONS + [M9]:
   312	        results.append((mut["id"], _check(mut)))
   313	    print()
   314	    for mid, ok in results:
   315	        print(f"{mid}: {'指定门变红 ✓' if ok else 'NOT-RED ✗'}")
   316	    if all(ok for _, ok in results):
   317	        print(f"MUTATION-NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} 条变异均使指定门变红)")
   318	        return 0
   319	    print("MUTATION-NEGATIVE-CONTROL: FAIL")
   320	    return 1
   321	
   322	
   323	if __name__ == "__main__":
   324	    sys.exit(main())

