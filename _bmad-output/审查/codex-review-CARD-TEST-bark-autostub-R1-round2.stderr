    15	  D/D'  test_osascript_guarded        — 守卫层③ osascript 模块属性打桩;
    16	  E/E'  test_reload_selfheal          — reload 双保险 (三模块各自重打);
    17	  F/F'  test_proxy_first_hop_stays_loopback — 守卫层⑤d/⑤e: 敌对「已建
    18	        opener」(模块全局的与别处握持的) 都不能把 loopback 请求转出机
    19	        (行为门, socket 首跳);
    20	  F2/F2' test_proxy_state_neutralized  — 守卫层⑤a/⑤b/⑤c: env 代理、
    21	        getproxies、_scproxy 三处同时哑火 (状态门);
    22	  H/H'  test_osascript_prebound_alias_blocked — 守卫层⑥: collection 期
    23	        from-import 预绑定的 osascript_fallback 别名也在 spawn 之前被拦;
    24	  S/S'  test_stale_reload_stash + test_stale_reload_refused_before_reload
    25	        — teardown 后的 stale reload wrapper 必须在**执行 reload 之前**
    26	        拒绝, 且拒绝后两个生产 sentinel (KEY_FILE / _urlopen) 都不生效。
    27	
    28	三层防线 (抛 / 结账 / 总账) 见下方 _REAL_CALLS 段。
    29	C/D/E/F/F2/H/S 全部零真实副作用 (不出网、不弹通知、不读真 key):
    30	F 的建连在 socket 层被拦, H 的 spawn 在 subprocess.Popen 处被拦,
    31	S 只做 reload 不调 send —— 布防/卸甲两形态都成立。
    32	
    33	探针不依赖根 conftest 的 --live/--prompt (卸甲模式下 pytest_addoption
    34	失效), 也不 import test_daily_review_run 取共享 helper — 各 conftest 形态
    35	下跨模块 import 行为不同, 自包含免歧义。
    36	
    37	设计约束 (为什么有模块级副作用): 守卫是 function 级 autouse fixture,
    38	测试体里的任何 monkeypatch 都晚于它 —— 想证明「守卫能中和**先于它存在**
    39	的敌对代理态」, 敌对态就只能建在模块 import 期 (collection, 早于一切
    40	fixture)。这就是下面 HOSTILE_PROXY 段与 _PREBOUND_OSASCRIPT 的由来。
    41	"""
    42	
    43	import importlib
    44	import os
    45	import socket
    46	import subprocess
    47	import sys
    48	import urllib.error
    49	import urllib.request
    50	from datetime import time as dtime
    51	from pathlib import Path
    52	
    53	WT = Path(__file__).resolve().parents[3]
    54	sys.path.insert(0, str(WT / "scripts"))
    55	
    56	import daily_review_run as runner  # noqa: E402
    57	
    58	NOW_ARG = "2026-07-30T10:00:00+08:00"
    59	
    60	#: F/F' 门的敌对前置态 — 必须在任何 fixture 之前 (模块 import 期) 建立:
    61	#: ① env 代理; ② 已经 install 好的 opener (代理已烘焙进它自己的
    62	#: ProxyHandler, 事后改 getproxies 管不着 — round-3 H1 的第二条向量)。
    63	#: 守卫布防时必须把两者都中和 (⑤a 清 env + ⑤d 换无代理 opener), F 的首跳
    64	#: 才会落在 127.0.0.1:9; 卸甲形态下这套前置态原样生效 → 首跳落
    65	#: 127.0.0.1:63128 → F' 必红。哨兵端口 63128 不监听, 且 F/F' 都在 socket
    66	#: 层拦截, 两形态都不会真建连、不出机。
    67	#: no_proxy 一并清掉: 留着它会让 proxy_bypass 走 environment 分支放行
    68	#: loopback, F' 就红不了 (判据依赖机器 env = 假门)。
    69	HOSTILE_PROXY_PORT = 63128
    70	HOSTILE_PROXY = f"http://127.0.0.1:{HOSTILE_PROXY_PORT}"
    71	for _v in ("no_proxy", "NO_PROXY", "https_proxy", "HTTPS_PROXY", "all_proxy", "ALL_PROXY"):
    72	    os.environ.pop(_v, None)
    73	os.environ["http_proxy"] = HOSTILE_PROXY
    74	os.environ["HTTP_PROXY"] = HOSTILE_PROXY
    75	#: 同时留一份**对象引用** —— 换掉 urllib.request._opener 这个模块全局救不了
    76	#: 别处已经握着的 opener 对象 (R1 round-1 审查用 held.open() 实测击穿),
    77	#: F 门第三段就拿它复核层⑤e。
    78	_HOSTILE_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({"http": HOSTILE_PROXY}))
    79	urllib.request.install_opener(_HOSTILE_OPENER)
    80	
    81	#: H/H' 门: collection 期 `from daily_review_run import osascript_fallback`
    82	#: 的预绑定形态 (round-3 MEDIUM 的原型)。守卫层③ 换的是模块属性, 换不掉
    83	#: 这个已经绑定的函数对象 —— 只有层⑥ (subprocess.run 过滤器) 能在 spawn
    84	#: 之前拦住它。
    85	_PREBOUND_OSASCRIPT = runner.osascript_fallback
    86	
    87	#: S 门的跨测试信箱: 前置测试在布防期内存一份当次的 importlib.reload
    88	#: wrapper, 该测试 teardown 后它即成为 stale。
    89	_STASHED_RELOAD: dict = {}
    90	
    91	#: 真实 key 的默认位置 — 只比较路径, 全文件从不读它的内容。
    92	REAL_KEY = Path.home() / ".config" / "canvas-review" / "bark.key"
    93	
    94	#: ── 总账层 (核心裁判 3「socket 与 osascript 实调用为 0」的直接证据) ──
    95	#: 各测试自装的拦截器是第一层 (抛), 每条测试末尾的 _assert_no_real_egress()
    96	#: 是第二层 (结账); 这里是第三层 (总账): 模块 import 期就把三个真实原语换成
    97	#: 记账并抛的版本 —— 于是本进程内**根本不存在**通往真实建连/解析/spawn 的
    98	#: 路径, 而不是「我们相信没走到」。任何逃过前两层的调用都会被计数, 结账断言
    99	#: 随即变红 (单层拦截器 = 假门, 项目教训 reference_test_guard_three_layer_design)。
   100	#: 用 AssertionError 而不是 OSError/gaierror: send_bark 与 urllib 都吞 OSError 族,
   101	#: 吞掉就成了静默放行。
   102	_REAL_CALLS = {"connect": 0, "resolve": 0, "spawn": 0}
   103	
   104	
   105	def _ledger_create_connection(address, *a, **kw):
   106	    _REAL_CALLS["connect"] += 1
   107	    raise AssertionError(f"BARK-LEDGER-CONNECT: 真实建连抵达 socket.create_connection ({address!r})")
   108	
   109	
   110	def _ledger_getaddrinfo(host, *a, **kw):
   111	    _REAL_CALLS["resolve"] += 1
   112	    raise AssertionError(f"BARK-LEDGER-RESOLVE: 真实解析抵达 socket.getaddrinfo ({host!r})")
   113	
   114	
   115	def _ledger_popen(*a, **kw):
   116	    _REAL_CALLS["spawn"] += 1
   117	    raise AssertionError(f"BARK-LEDGER-SPAWN: 真实 spawn 抵达 subprocess.Popen ({a[:1]!r})")
   118	
   119	
   120	socket.create_connection = _ledger_create_connection
   121	socket.getaddrinfo = _ledger_getaddrinfo
   122	subprocess.Popen = _ledger_popen
   123	
   124	
   125	def _assert_no_real_egress():
   126	    """结账: 本条测试期间没有任何真实建连 / 解析 / spawn 抵达过总账层。"""
   127	    assert _REAL_CALLS == {"connect": 0, "resolve": 0, "spawn": 0}, (
   128	        f"BARK-LEDGER-NONZERO: 出现真实出网或 spawn 调用 {_REAL_CALLS!r}"
   129	    )
   130	
   131	
   132	def _make_vault(tmp_path: Path) -> Path:
   133	    """test_daily_review_run._vault 同款最小 vault: 一张即刻到期节点卡,
   134	    保证 payload 带 notification (否则 push:skip-empty, send 根本不被调,
   135	    探针在 A/B 两种形态下都空转)。live vault 只读 (只 copy decay_beta.py)。"""
   136	    vault = tmp_path / "vault"
   137	    scripts = vault / ".claude" / "scripts"
   138	    scripts.mkdir(parents=True)
   139	    (vault / "节点").mkdir()
   140	    decay = WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py"
   141	    (scripts / "decay_beta.py").write_bytes(decay.read_bytes())
   142	    (vault / "节点" / "甲.md").write_text(
   143	        '---\ntype: concept\nsource_board: "[[原白板/普通板]]"\n---\n真实内容。\n',
   144	        encoding="utf-8",
   145	    )
   146	    return vault
   147	
   148	
   149	def test_probe(tmp_path, monkeypatch, capsys):
   150	    # 本探针自身的最后防线: 无论守卫在不在, 双墙 (DNS + 建连) 恒断网。
   151	    # 两墙都记录 host — 任一被触发都满足「观察到解析尝试」的断言; 即便
   152	    # 未来 urllib 绕过 getaddrinfo 直连, create_connection 墙仍拦住
   153	    resolved_hosts = []
   154	
   155	    def _intercept_getaddrinfo(host, *args, **kwargs):
   156	        resolved_hosts.append(host)
   157	        raise socket.gaierror(-2, "blocked by bark_egress_probe")
   158	
   159	    def _intercept_create_connection(address, *args, **kwargs):
   160	        if isinstance(address, tuple) and address:
   161	            resolved_hosts.append(address[0])
   162	        raise socket.gaierror(-2, "blocked by bark_egress_probe (create_connection)")
   163	
   164	    monkeypatch.setattr(socket, "getaddrinfo", _intercept_getaddrinfo)
   165	    monkeypatch.setattr(socket, "create_connection", _intercept_create_connection)
   166	    # 代理会把首跳解析目标换成代理主机, 断言锚点 api.day.app 就失配 —
   167	    # 且 urllib 在 env 之外还读 macOS 系统代理 (getproxies_macosx_sysconf;
   168	    # 本机实测系统代理在)。env + getproxies + 模块级敌对 opener 三处同禁 =
   169	    # 强制直连形态; 拦截器保证两种形态下都不出网。
   170	    # _opener 必须一并复位: 模块 import 期为 F 门装的敌对 opener 会把首跳
   171	    # 抢走 (A 形态下会记到 127.0.0.1:63128 而不是 api.day.app)。
   172	    for var in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "all_proxy"):
   173	        monkeypatch.delenv(var, raising=False)
   174	    monkeypatch.setattr(runner.send_bark.urllib.request, "getproxies", lambda: {})
   175	    monkeypatch.setattr(urllib.request, "_opener", None)
   176	
   177	    key_file = tmp_path / "bark.key"
   178	    key_file.write_text("probekey-12345678\n", encoding="utf-8")
   179	    monkeypatch.setattr(runner.send_bark, "KEY_FILE", key_file)
   180	    # 单次尝试足以取证 — 免 RETRIES=2 的 2s+4s 重试空等
   181	    monkeypatch.setattr(runner.send_bark, "RETRIES", 0)
   182	    # A 模式 (无守卫) 下 push:failed 会走 osascript 兜底 subprocess 真弹
   183	    # macOS 通知 — 探针自行打桩 (B 模式守卫已桩, 此处覆盖等价)
   184	    monkeypatch.setattr(runner, "osascript_fallback", lambda noti: True)
   185	
   186	    vault = _make_vault(tmp_path)
   187	    monkeypatch.setattr(runner, "VAULT", vault)
   188	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
   189	    # 窗口门放行 (机器时区无关) — 既有 _push_harness 同款; 探针证的是
   190	    # 「send 被调后会不会出网」, 不是窗口语义
   191	    monkeypatch.setattr(runner, "PUSH_WINDOW", (dtime(0, 0), dtime(23, 59, 59)))
   192	    monkeypatch.setattr(sys, "argv", ["daily_review_run.py", "--now", NOW_ARG, "--vault", str(vault)])
   193	
   194	    assert runner.main() == 0
   195	    out = capsys.readouterr().out
   196	    assert any("api.day.app" in str(h) for h in resolved_hosts), (
   197	        f"BARK-GATE-A-RESOLVE: 未观察到对 api.day.app 的解析尝试 (resolved={resolved_hosts!r})"
   198	    )
   199	    assert "push:failed" in out
   200	    _assert_no_real_egress()
   201	
   202	
   203	def test_keyfile_guarded():
   204	    """C 门 (armed): 守卫层① KEY_FILE 重定向的放行门 — 布防下
   205	    send_bark.KEY_FILE 必须已被移出真实 key 位置, 且其内容 server 段是
   206	    loopback discard (round-3 M: 八跑此前不锁内容, 守卫回退成外网 server
   207	    时 C 仍绿 — 内容断言把「loopback 纵深」本身钉进门里)。只读守卫自己的
   208	    tmp 假 key, 不触真实 key, 布防/卸甲两形态都零副作用。"""
   209	    import send_bark
   210	
   211	    kf = Path(send_bark.KEY_FILE)
   212	    assert kf != REAL_KEY, "BARK-GATE-C-KEYFILE: 守卫未布防 — send_bark.KEY_FILE 仍指向真实 key 位置"
   213	    content = kf.read_text(encoding="utf-8").strip()
   214	    server = content.rpartition("/")[0]
   215	    assert server == "http://127.0.0.1:9", (
   216	        f"BARK-GATE-C-LOOPBACK: 守卫假 key 的 server 段不是 loopback discard 端口 (实测 {server!r})"
   217	    )
   218	
   219	
   220	def test_osascript_guarded():
   221	    """D 门 (armed): 守卫层③ osascript_fallback 模块属性打桩的放行门 —
   222	    布防下它必须是守卫的记录桩而非 runner 原始实现。按 __qualname__ 结构性
   223	    断言 (任何测试侧替身都会改 qualname), 不调用函数, 布防/卸甲两形态都零
   224	    副作用 (调真函数 = 卸甲形态下真弹通知, 恰是要避免的事; 预绑定别名那条
   225	    路径由 H 门单独覆盖, 它有自己的 Popen 墙)。"""
   226	    import daily_review_run
   227	
   228	    fn = daily_review_run.osascript_fallback
   229	    assert getattr(fn, "__qualname__", "") != "osascript_fallback", (
   230	        "BARK-GATE-D-OSASCRIPT: 守卫未布防 — osascript_fallback 仍是 runner 原始实现"
   231	    )
   232	
   233	
   234	def test_reload_selfheal():
   235	    """E 门 (armed): reload 双保险 — 对**两个**受保护生产模块各自
   236	    reload 重跑模块顶层 (KEY_FILE/_urlopen / osascript_fallback 被生产值
   237	    重写) 后, 守卫须对两侧都自动重打桩 (round-2 MEDIUM: 只锁 send_bark
   238	    时, 守卫漏 rearm daily_review_run 本门仍绿)。仅 reload 不调 send,
   239	    布防/卸甲两形态都零出网。"""
   240	    import daily_review_run
   241	    import send_bark
   242	
   243	    importlib.reload(send_bark)
   244	    assert Path(send_bark.KEY_FILE) != REAL_KEY, "BARK-GATE-E-RELOAD-KEYFILE: reload 后 KEY_FILE 回到真实 key 位置"
   245	    assert getattr(send_bark._urlopen, "__qualname__", "") != "urlopen", (
   246	        "BARK-GATE-E-RELOAD-URLOPEN: reload 后 _urlopen 回到真实 urlopen"
   247	    )
   248	
   249	    importlib.reload(daily_review_run)
   250	    assert Path(daily_review_run.send_bark.KEY_FILE) != REAL_KEY, (
   251	        "BARK-GATE-E-RELOAD-RUNNER-KEYFILE: reload runner 后 send_bark.KEY_FILE 回到真实 key 位置"
   252	    )
   253	    assert getattr(daily_review_run.osascript_fallback, "__qualname__", "") != "osascript_fallback", (
   254	        "BARK-GATE-E-RELOAD-OSASCRIPT: reload 后 osascript_fallback 回到 runner 原始实现"
   255	    )
   256	
   257	    # round-3 H1 的逃逸链第一步就是 reload(urllib.request) —— 它会把④⑤ 全部
   258	    # 抹掉。属性式调用现在也在双保险名单内, 重打必须覆盖到这两层。
   259	    importlib.reload(urllib.request)
   260	    assert getattr(urllib.request.urlopen, "__qualname__", "") != "urlopen", (
   261	        "BARK-GATE-E-RELOAD-URLLIB-URLOPEN: reload(urllib.request) 后全局 urlopen 未被重打"
   262	    )
   263	    assert urllib.request.getproxies() == {}, (
   264	        "BARK-GATE-E-RELOAD-URLLIB-PROXY: reload(urllib.request) 后代理中和未被重打"
   265	    )
   266	
   267	
   268	def test_proxy_first_hop_stays_loopback(monkeypatch):
   269	    """F 门 (armed, 行为): 模块 import 期就已存在的敌对「已建 opener」
   270	    (ProxyHandler 指向 127.0.0.1:63128) 不得把 loopback 请求转出机 ——
   271	    首跳必须是 loopback discard 端口本身。
   272	
   273	    这是 (b) 的行为门: 判据锚 (host, port) 二元组而不是只锚 host ——
   274	    本机系统代理实测就是 127.0.0.1:1082, 与兜底目标同主机不同端口, 只比
   275	    host 会两形态同值 = 假门。
   276	    建连在 socket.create_connection 层被拦并抛 OSError, 布防/卸甲两形态
   277	    都不会真建连、不出机 (63128 也不监听)。
   278	    三段各自承重不同的层: 第一段 (模块全局 _opener) 承重 ⑤d, 第二段 (现场
   279	    新建 opener) 承重 ⑤a/⑤b/⑤c, 第三段 (别处握持的 opener 对象) 承重 ⑤e
   280	    —— 变异任一层, 本门都会红在对应那一段。"""
   281	    hops = []
   282	
   283	    def _intercept(address, *a, **kw):
   284	        hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   285	        raise OSError(61, "blocked by bark_egress_probe (first-hop gate)")
   286	
   287	    monkeypatch.setattr(socket, "create_connection", _intercept)
   288	    opener = urllib.request._opener
   289	    assert opener is not None, "BARK-GATE-F-NOOPENER: _opener 为空, 前置态未建立"
   290	    try:
   291	        opener.open("http://127.0.0.1:9/push", timeout=1)
   292	    except urllib.error.URLError:
   293	        pass
   294	
   295	    assert hops, "BARK-GATE-F-NOHOP: 未观察到任何建连尝试"
   296	    assert hops[0] == ("127.0.0.1", 9), (
   297	        f"BARK-GATE-F-FIRSTHOP: 代理首跳未被中和 (首跳 {hops[0]!r}, 期望 ('127.0.0.1', 9))"
   298	    )
   299	
   300	    # 第二段: 现场新建的 opener —— 这是 `_opener is None` 时 urlopen 走的路
   301	    # (reload(urllib.request) 之后就是这个状态)。build_opener() 会在此刻读
   302	    # getproxies(), 于是这段behaviorally 覆盖的是「系统/环境代理」向量,
   303	    # 与上面「已建 opener」向量互补, 合起来才是完成条件 (b) 的两条。
   304	    fresh_hops = []
   305	
   306	    def _intercept_fresh(address, *a, **kw):
   307	        fresh_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   308	        raise OSError(61, "blocked by bark_egress_probe (fresh-opener gate)")
   309	
   310	    monkeypatch.setattr(socket, "create_connection", _intercept_fresh)
   311	    try:
   312	        urllib.request.build_opener().open("http://127.0.0.1:9/push", timeout=1)
   313	    except urllib.error.URLError:
   314	        pass
   315	
   316	    assert fresh_hops, "BARK-GATE-F-NOFRESHHOP: 新建 opener 未观察到任何建连尝试"
   317	    assert fresh_hops[0] == ("127.0.0.1", 9), (
   318	        f"BARK-GATE-F-FRESHHOP: 新建 opener 的首跳被代理接管 (首跳 {fresh_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   319	    )
   320	
   321	    # 第三段: 直接握着的 opener 对象 —— 不经 urllib.request._opener 这个模块
   322	    # 全局, 所以 ⑤d 换引用对它无效; 承重的是 ⑤e (proxy_bypass 恒 True)。
   323	    # R1 round-1 审查正是用这条路径击穿了只有 ⑤d 的版本。
   324	    held_hops = []
   325	
   326	    def _intercept_held(address, *a, **kw):
   327	        held_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   328	        raise OSError(61, "blocked by bark_egress_probe (held-opener gate)")
   329	
   330	    monkeypatch.setattr(socket, "create_connection", _intercept_held)
   331	    try:
   332	        _HOSTILE_OPENER.open("http://127.0.0.1:9/push", timeout=1)
   333	    except urllib.error.URLError:
   334	        pass
   335	
   336	    assert held_hops, "BARK-GATE-F-NOHELDHOP: 握持 opener 未观察到任何建连尝试"
   337	    assert held_hops[0] == ("127.0.0.1", 9), (
   338	        f"BARK-GATE-F-HELDHOP: 别处握持的 opener 首跳被代理接管 (首跳 {held_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   339	    )
   340	    _assert_no_real_egress()
   341	
   342	
   343	def test_proxy_state_neutralized():
   344	    """F2 门 (armed, 状态): 守卫层⑤a/⑤b/⑤c 三处代理来源同时哑火。
   345	
   346	    F 是行为门但只承重 ⑤d; 这三条各自承重一层, 任一层被摘掉本门必红
   347	    (变异负控按层逐条验)。⑤c 分两处断言是因为 darwin 的
   348	    `from _scproxy import _get_proxies` 把补丁点劈成了两个绑定:
   349	    urllib.request 侧管当下, _scproxy 侧管 reload(urllib.request) 之后。"""
   350	    assert not any(os.environ.get(v) for v in ("http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY")), (
   351	        "BARK-GATE-F2-ENVPROXY: 布防期内代理 env 未被清空"
   352	    )
   353	    assert urllib.request.getproxies() == {}, (
   354	        f"BARK-GATE-F2-GETPROXIES: getproxies() 非空 ({urllib.request.getproxies()!r})"
   355	    )
   356	    if sys.platform == "darwin":
   357	        import _scproxy
   358	
   359	        assert _scproxy._get_proxies() == {}, (
   360	            "BARK-GATE-F2-SCPROXY: _scproxy._get_proxies 未中和 — reload(urllib.request) 后代理会复活"
   361	        )
   362	        assert getattr(urllib.request, "_get_proxies", None) is not None and (urllib.request._get_proxies() == {}), (
   363	            "BARK-GATE-F2-URLLIB-GETPROXIES: urllib.request._get_proxies 未中和"
   364	        )
   365	
   366	
   367	def test_osascript_prebound_alias_blocked(monkeypatch):
   368	    """H 门 (armed): collection 期 from-import 预绑定的 osascript_fallback
   369	    别名, 也必须在**副作用之前**被拦 (round-3 MEDIUM 升级为 R1 完成条件 d)。
   370	
   371	    守卫层③ 换的是模块属性, 换不掉 _PREBOUND_OSASCRIPT 这个已绑定对象;
   372	    它执行时仍按模块全局查 subprocess.run —— 层⑥ 就拦在那里。
   373	    探针自装 Popen 墙作最后防线: 卸甲形态下真 subprocess.run 会走到墙,
   374	    抛 AssertionError (osascript_fallback 只吞 OSError/TimeoutExpired,
   375	    AssertionError 必然穿透) → H' 必红, 且两形态都不会真弹通知。"""
   376	
   377	    def _wall(*a, **kw):
   378	        raise AssertionError("BARK-GATE-H-OSASCRIPT-SPAWN: 真 osascript spawn 已抵达 subprocess.Popen")
   379	
   380	    monkeypatch.setattr(subprocess, "Popen", _wall)
   381	    assert _PREBOUND_OSASCRIPT({"title": "bark-gate-h", "body": "bark-gate-h"}) is True, (
   382	        "BARK-GATE-H-RETURN: 预绑定别名未被守卫层⑥ 接管"
   383	    )
   384	    _assert_no_real_egress()
   385	
   386	
   387	def test_stale_reload_stash():
   388	    """S 门前置: 在布防期内取到当次 importlib.reload 的 wrapper 存进模块级
   389	    信箱; 本条测试 teardown 之后, 它就是一个 stale wrapper。
   390	    卸甲形态下这里存到的是真 importlib.reload —— 正是 S' 要暴露的东西。"""
   391	    _STASHED_RELOAD["fn"] = importlib.reload
   392	    assert callable(_STASHED_RELOAD["fn"])
   393	
   394	
   395	def test_stale_reload_refused_before_reload():
   396	    """S 门 (armed): 上一条留下的 stale wrapper 必须在**执行 reload 之前**
   397	    拒绝 —— 拒绝之后两个生产 sentinel 都不得生效 (round-3 H2: 先 reload
   398	    后 raise 时模块已被重载, 抛异常并不回滚)。
   399	
   400	    卸甲形态下 stale 就是真 reload: 调用直接重新执行模块, 第一条断言即红。
   401	    整条测试不调 send、不读 key 内容, 两形态零外发。
   402	
   403	    ⚠️ 判别器为什么是**模块对象身份**而不是 KEY_FILE/_urlopen 的值:
   404	    本条测试自己也在布防中, 所以「先 reload 后 raise」的错误实现里, reload
   405	    重跑模块顶层拿到的 KEY_FILE 仍是当前守卫的 tmp key、_urlopen 仍是当前
   406	    守卫的拒绝器 —— 两种世界给出**同一个观测**, 值断言在此语境下判不出来
   407	    (R1 变异 M7 首跑当场证伪了值断言版本)。reload 必然重建模块里所有 def
   408	    出来的函数对象, 这一点任何重打桩都掩盖不掉, 所以身份比对才是承重判据;
   409	    KEY_FILE/_urlopen 两条保留为卡文字面的 sentinel 复核, 它们是身份判据的
   410	    推论 (模块没被重新执行 → 生产值不可能被写回)。"""
   411	    import send_bark
   412	
   413	    stale = _STASHED_RELOAD.get("fn")
   414	    assert stale is not None, "BARK-GATE-S-NOSTASH: S 门前置测试未先跑"
   415	    send_before = send_bark.send
   416	    load_key_before = send_bark.load_key
   417	    key_before = send_bark.KEY_FILE
   418	    urlopen_before = send_bark._urlopen
   419	    try:
   420	        stale(send_bark)
   421	        refused = False
   422	    except RuntimeError:
   423	        refused = True
   424	
   425	    assert refused, "BARK-GATE-S-STALE-RELOAD: stale wrapper 未拒绝对受保护模块的 reload"
   426	    assert send_bark.send is send_before and send_bark.load_key is load_key_before, (
   427	        "BARK-GATE-S-MODULE-REEXECUTED: 拒绝之前模块已被重新执行 — reload 已发生, 抛异常并不回滚"
   428	    )
   429	    assert send_bark.KEY_FILE == key_before and Path(send_bark.KEY_FILE) != REAL_KEY, (
   430	        "BARK-GATE-S-KEYFILE-SENTINEL: KEY_FILE 生产 sentinel 已生效"
   431	    )
   432	    assert send_bark._urlopen is urlopen_before, "BARK-GATE-S-URLOPEN-SENTINEL: _urlopen 生产 sentinel 已生效"

