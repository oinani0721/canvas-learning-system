    48	
    49	def _now(arg: str | None) -> datetime:
    50	    if arg:
    51	        dt = datetime.fromisoformat(arg.replace("Z", "+00:00"))
    52	        return dt if dt.tzinfo else dt.astimezone()
    53	    return datetime.now(timezone.utc)
    54	
    55	
    56	def _vault_key() -> str:
    57	    """当前 VAULT 的命名空间 key (规则唯一定义点在 send_bark.vault_key)。"""
    58	    return send_bark.vault_key(VAULT.resolve().name)
    59	
    60	
    61	def state_path() -> Path:
    62	    """per-vault state 文件 (CARD-C1a)。旧全局 daily-review.state.json 由
    63	    migrate_daily_review_state.py 一次性迁入, 此处不做隐式回退 — 隐式读旧
    64	    文件会让双 vault 各自以为「今天推过了」, 恰是本卡要消灭的踩踏。"""
    65	    return BACKUPS / f"daily-review.{_vault_key()}.state.json"
    66	
    67	
    68	def load_state() -> dict:
    69	    state = state_path()
    70	    if not state.exists():
    71	        return {"schema_version": 1, "board_last_recommended": {}}
    72	    try:
    73	        st = json.loads(state.read_text(encoding="utf-8"))
    74	        # Codex-D2b M1: 合法 JSON 但结构错型 (顶层非 dict / 账本非 dict) 与
    75	        # 语法损坏同等对待 — 隔离重建, 不让 setdefault/.values() 半路炸
    76	        if not isinstance(st, dict) or not isinstance(
    77	            st.get("board_last_recommended", {}), dict
    78	        ):
    79	            raise ValueError("state 结构错型")
    80	        st.setdefault("board_last_recommended", {})
    81	        return st
    82	    except (json.JSONDecodeError, OSError, ValueError):
    83	        quarantine = state.with_name(
    84	            state.name + ".corrupt-" + datetime.now().strftime("%Y%m%dT%H%M%S"))
    85	        try:
    86	            os.replace(state, quarantine)
    87	        except OSError:
    88	            pass
    89	        print(f"[runner] state 损坏, 已隔离到 {quarantine.name}, 重建", file=sys.stderr)
    90	        return {"schema_version": 1, "board_last_recommended": {}}
    91	
    92	
    93	def save_state(st: dict):
    94	    state = state_path()
    95	    state.parent.mkdir(parents=True, exist_ok=True)
    96	    tmp = state.with_suffix(".tmp")
    97	    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    98	    os.replace(tmp, state)
    99	
   100	
   101	def log_line(msg: str):
   102	    log = BACKUPS / "daily-review.log"
   103	    log.parent.mkdir(parents=True, exist_ok=True)
   104	    stamp = datetime.now().astimezone().strftime("%F %T")
   105	    with open(log, "a", encoding="utf-8") as f:
   106	        f.write(f"[{stamp}] vault={_vault_key()} {msg}\n")
   107	
   108	
   109	def _nodes_max_mtime(vault: Path) -> float:
   110	    """节点池最新改动时间 (CARD-A3 缓存失效判据)。
   111	
   112	    文件 mtime 抓原地更新 (quiz 写 fsrs_due 不动目录), 目录 mtime 抓
   113	    增删改名 (不留文件 mtime); 误报代价只是一次幂等重扫。保 mtime 的
   114	    还原类操作 (rsync -a / Time Machine) 不在本判据覆盖面内。
   115	    """
   116	    pool = vault / "节点"
   117	    latest = 0.0
   118	    for p in pool.glob("*.md"):
   119	        try:
   120	            latest = max(latest, p.stat().st_mtime)
   121	        except OSError:
   122	            continue  # 迭代间隙被删: 殿后的目录 stat 捕获该变动
   123	    try:
   124	        # 目录 stat 殿后取样 — 迭代期间发生的删除也已反映在目录 mtime 里
   125	        latest = max(latest, pool.stat().st_mtime)
   126	    except OSError:
   127	        return 0.0  # 节点池不存在: 不因 mtime 失效, 保持旧缓存语义
   128	    return latest
   129	
   130	
   131	def ensure_payload(st: dict, now: datetime, today: str) -> tuple[dict | None, str]:
   132	    """当日 payload: 没有才生成 (生成过则复用 — 补跑只补推送)。
   133	
   134	    CARD-A3 (BATCH-2026-08-24-复习闭环): 复用多两道门 — ①节点池比 payload
   135	    新 (quiz 写侧刚更新 fsrs_due / 新增重学卡) 则同日重扫; ②当前时间越过
   136	    生成时记录的最早未来到期点 (next_due_utc) 也重扫 (Codex-A3 BLOCKER:
   137	    09:59 落 fsrs_due=10:09 → 10:05 重扫时未到期 → 11:05 若只看 mtime 会
   138	    整天 cached, 当天到期卡丢失 — 卡片 :89 警告的缺陷位移)。push 去重
   139	    不在此处: last_push_accepted_date + last_push_kind 门保证同日至多
   140	    rest→due 两推 (CARD-D2b; state 持久化成立前提, 见推送门注释)。
   141	    """
   142	    payload_path = VAULT / "outputs" / "今日复习.json"
   143	    first_gen_today = st.get("last_generate_date") != today
   144	    if not first_gen_today and payload_path.exists():
   145	        try:
   146	            raw = payload_path.read_text(encoding="utf-8")
   147	            # sha 校验 (Code-Review L3): 外部改动/半写的 payload 不复用, 重新生成
   148	            if hashlib.sha256(raw.encode("utf-8")).hexdigest() == st.get("payload_sha256"):
   149	                now_z = now.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   150	                due_crossed = bool(st.get("next_due_utc")) and st["next_due_utc"] <= now_z
   151	                if not due_crossed and _nodes_max_mtime(VAULT) <= payload_path.stat().st_mtime:
   152	                    return json.loads(raw), "cached"
   153	        except (json.JSONDecodeError, OSError):
   154	            pass  # 落盘 payload 损坏 → 重新生成
   155	
   156	    import daily_review_pick as picker
   157	
   158	    scan_started = time.time()
   159	    payload, ranked = picker.build_payload(
   160	        VAULT, now, st["board_last_recommended"], picker.load_decay(VAULT))
   161	    out = VAULT / "outputs"
   162	    out.mkdir(parents=True, exist_ok=True)
   163	    picker.atomic_write(out / "今日复习.md", picker.render_md(payload, ranked))
   164	    raw = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
   165	    picker.atomic_write(payload_path, raw)
   166	    # mtime 门基准回拨到扫描起点: 扫描-落盘窗口内落地的写侧更新, 其 mtime
   167	    # 必然 > 基准, 下一轮触发重扫捞回 (否则该更新当天静默丢失, 无日志可查)
   168	    os.utime(payload_path, (scan_started, scan_started))
   169	
   170	    st["last_generate_date"] = today
   171	    st["payload_sha256"] = hashlib.sha256(raw.encode("utf-8")).hexdigest()
   172	    # 最早未来到期点: ranked 是全量榜 (payload.top_boards 才截断), 每行
   173	    # next_due 已是板内未来最小值; upcoming 按 next_due 升序, [0] 即全局
   174	    # 最小, [:3] 截断不丢它。未归板节点不参与推荐, 其到期转场不改变输出。
   175	    nexts = [r["next_due"] for r in ranked if r.get("next_due")]
   176	    if payload.get("upcoming"):
   177	        nexts.append(payload["upcoming"][0]["next_due"])
   178	    st["next_due_utc"] = min(nexts, default="")
   179	    credited_today = (
   180	        st.get("last_recommend_credit_date") == today
   181	        # Codex-D2a H1: 升级当天旧 state 自然缺 marker, 但旧门若已落账其值
   182	        # 必是 today — 只认 marker 会给第二个板补账, 突破每日一次上界
   183	        or today in st["board_last_recommended"].values()
   184	    )
   185	    if ranked and not credited_today:
   186	        # CARD-A3/D2a: 每天只给第一个「非空」榜首落账一次 — 重扫换榜也补写
   187	        # 会把第二个板标成「今天推荐过」, 污染 tie-break 天级轮转; 但门不能
   188	        # 绑 first_gen_today: 空首扫日 (休息日/纯空) 会把当天唯一一次落账
   189	        # 机会白白烧掉, board_last_recommended 永远空置
   190	        st["board_last_recommended"][ranked[0]["board"]] = today
   191	        st["last_recommend_credit_date"] = today
   192	    save_state(st)
   193	    return payload, "new"
   194	
   195	
   196	def osascript_fallback(noti: dict) -> bool:
   197	    try:
   198	        r = subprocess.run(
   199	            ["/usr/bin/osascript", "-", noti["title"], noti["body"]],
   200	            input=APPLESCRIPT, text=True, capture_output=True, timeout=15,
   201	        )
   202	        return r.returncode == 0
   203	    except (OSError, subprocess.TimeoutExpired):
   204	        return False
   205	
   206	
   207	def main() -> int:
   208	    global VAULT
   209	    # allow_abbrev=False: push.sh 锁解析只认全称 --vault, argparse 缩写
   210	    # (--v) 会让锁与 runner 指向不同 vault (Codex-C1a F1) — 两侧必须同源
   211	    ap = argparse.ArgumentParser(description="每日复习推送编排", allow_abbrev=False)
   212	    ap.add_argument("--now", help="ISO 时间覆盖 (12 场景验收矩阵用)")
   213	    ap.add_argument("--vault", help="活 vault 路径 (wrapper 从 .env ACTIVE_VAULT 解析传入; 缺省回退 canvas-vault)")
   214	    args = ap.parse_args()
   215	
   216	    if args.vault:
   217	        VAULT = Path(args.vault)
   218	
   219	    now = _now(args.now)
   220	    local = now.astimezone()
   221	    today = local.date().isoformat()
   222	    st = load_state()
   223	
   224	    try:
   225	        payload, gen = ensure_payload(st, now, today)
   226	    except Exception as e:  # 生成失败 = 无保底, 唯一的非 0 退出
   227	        log_line(f"generate:FAILED err={type(e).__name__}:{str(e)[:120]}")
   228	        print(f"[runner] 生成失败: {e}", file=sys.stderr)
   229	        return 1
   230	
   231	    noti = (payload or {}).get("notification")
   232	    push, fallback = "-", "-"
   233	    if not noti:
   234	        push = "skip-empty"  # 无板可推 (全占位/空 vault): md 已如实落盘
   235	    elif st.get("last_push_accepted_date") == today and not (
   236	        st.get("last_push_kind") == "rest" and payload.get("top_boards")
   237	    ):
   238	        # CARD-D2b 方案甲: 当日已推但语义从 rest 反转为 due (休息推送后盘中
   239	        # 转出到期) 时放行一次二推 — 同 id 服务端覆盖 (A4 契约, 通知中心
   240	        # 不堆叠), due 落账后恒 skip-done → state 持久化成立时每日至多
   241	        # 2 次 accepted (accepted 后崩溃窗/损坏重建的 at-least-once 残余
   242	        # 与 A4/A7 既有语义同级, Codex-D2b H1/H2 如实入档)。旧 state 缺
   243	        # last_push_kind → 条件恒真 → 保守一日一推 (向后兼容)
   244	        push = "skip-done"
   245	    elif not (PUSH_WINDOW[0] <= local.time() < PUSH_WINDOW[1]):
   246	        push = "skip-window"  # RunAtLoad 早触发 / 21:00 后唤醒: 只落盘
   247	    else:
   248	        # vault_id 取 payload 顶层 (C1a 加性字段); 当日缓存若是迁移前生成的
   249	        # 旧 payload (无该字段), 回退当前 vault 目录名 — 两者必然同库
   250	        rc = send_bark.send(noti, payload.get("vault_id") or VAULT.resolve().name)
   251	        if rc == 0:
   252	            st["last_push_accepted_date"] = today
   253	            # CARD-D2b: 语义账只在 accepted 时落 — 失败保持原 kind, 反转门
   254	            # 敞开, 次小时 launchd 触发自然幂等重试。缺 top_boards 键的
   255	            # legacy 缓存 payload 语义未知 → 保守记 due (关反转门, Codex M2)
   256	            st["last_push_kind"] = "due" if payload.get("top_boards", True) else "rest"
   257	            st["last_result"], st["last_error"] = "pushed", ""
   258	            save_state(st)
   259	            push = "accepted"
   260	        else:
   261	            push = "skip-nokey" if rc == 2 else "failed"
   262	            if rc != 2:
   263	                st["last_result"] = "generated_push_failed"
   264	                st["last_error"] = "bark-send"
   265	            # 本地兜底每日一次 (Code-Review L1 去重门); 无 key 也提醒一条
   266	            # (Code-Review H1: key 配好前不能一切静默)
   267	            if st.get("last_local_notify_date") != today:
   268	                local_noti = noti if rc != 2 else {
   269	                    "title": "📚 今日复习已生成",
   270	                    "body": noti["body"] + "（Bark 未配置，仅本地提醒）",
   271	                }
   272	                fallback = "ok" if osascript_fallback(local_noti) else "fail"
   273	                if fallback == "ok":
   274	                    st["last_local_notify_date"] = today
   275	            save_state(st)
   276	
   277	    log_line(f"generate:{gen} push:{push} fallback:{fallback}")
   278	    print(f"[runner] generate:{gen} push:{push} fallback:{fallback}")
   279	    return 0
   280	
   281	
   282	if __name__ == "__main__":
   283	    sys.exit(main())

