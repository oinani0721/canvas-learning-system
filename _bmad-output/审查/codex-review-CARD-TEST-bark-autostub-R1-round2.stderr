    85	        # 拒绝必须发生在**生产 send 路径**上, 不是探针里随手抛的同名异常
    86	        {"test_probe": ("scripts/daily_review_run.py", "scripts/send_bark.py")},
    87	    ),
    88	    _c("C/armed-keyfile-guarded", [f"{PROBE}::test_keyfile_guarded"], [], {"test_keyfile_guarded": "passed"}),
    89	    _c(
