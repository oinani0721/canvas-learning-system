   233	
   234	#: G 跑不是 pytest nodeid — 判据在 fixture teardown 之后, 只能由独立脚本取。
   235	G_LABEL = "G/keyfile-no-residue-after-teardown"
   236	G_SCRIPT = "scripts/bark_keyfile_residue_check.py"
   237	G_OK_PREFIX = "BARK-KEYFILE-RESIDUE: OK"
   238	
   239	ALL_LABELS = [c["label"] for c in CASES] + [G_LABEL]
   240	
   241	
   242	def _short(nodeid: str) -> str:
   243	    return nodeid.rsplit("::", 1)[-1]
   244	
   245	
   246	def _run_pytest(case, report_path: Path):
   247	    cmd = [
   248	        sys.executable,
   249	        "-m",
   250	        "pytest",
   251	        "-p",
   252	        "no:cacheprovider",
   253	        "-p",
   254	        "bark_negctl_report_plugin",
   255	        *case["extra"],
   256	        *case["nodeids"],
   257	    ]
   258	    env = dict(os.environ)
   259	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   260	    env["BARK_NEGCTL_REPORT"] = str(report_path)
   261	    env["PYTHONPATH"] = os.pathsep.join([str(SCRIPTS)] + ([env["PYTHONPATH"]] if env.get("PYTHONPATH") else []))
   262	    print(f"[{case['label']}] $ {' '.join(cmd)}", flush=True)
   263	    try:
   264	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   265	    except subprocess.TimeoutExpired as e:
   266	        sys.stdout.write(e.stdout if isinstance(e.stdout, str) else "")
   267	        sys.stderr.write(str(e))
   268	        print(f"[{case['label']}] TIMEOUT after 600s")
   269	        return None, None
   270	    sys.stdout.write(proc.stdout)
   271	    sys.stderr.write(proc.stderr)
   272	    return proc.returncode, report_path
   273	
   274	
   275	def _judge_pytest(case) -> bool:
   276	    problems = []
   277	    with tempfile.TemporaryDirectory(prefix="bark-negctl-") as td:
   278	        report_path = Path(td) / "report.json"
   279	        rc, _ = _run_pytest(case, report_path)
   280	        if rc is None:
   281	            return False
   282	        if not report_path.exists():
   283	            print(f"[{case['label']}] MISMATCH: 插件未落报告 (进程可能崩溃) rc={rc}")
   284	            return False
   285	        data = json.loads(report_path.read_text(encoding="utf-8"))
   286	
   287	    if data.get("exitstatus") != rc:
   288	        problems.append(f"进程 rc={rc} 与插件 exitstatus={data.get('exitstatus')} 不一致")
   289	
   290	    # 进程级全局还原对账 (每一跑都查): 守卫在一次测试里可能反复 _reapply,
   291	    # 任何一层没被 MonkeyPatch 正确还原, 桩就会漏进后续测试。
   292	    gb, ga = data.get("globals_before"), data.get("globals_after")
   293	    if gb is None or ga is None:
   294	        problems.append("插件未落全局快照 (globals_before/after 缺失)")
   295	    elif gb != ga:
   296	        diff = [
   297	            f"{k}: 布防前 {gb.get(k)!r} → teardown 后 {ga.get(k)!r}"
   298	            for k in sorted(set(gb) | set(ga))
   299	            if gb.get(k) != ga.get(k)
   300	        ]
   301	        problems.append("globals 未还原 (进程级污染): " + "; ".join(diff))
   302	
   303	    calls, other_failed = {}, []
   304	    for rep in data["reports"]:
   305	        if rep["when"] == "call":
   306	            calls[_short(rep["nodeid"])] = rep
   307	        elif rep["outcome"] == "failed":
   308	            other_failed.append(f"{rep['when']}:{rep['nodeid']}")
   309	    if other_failed:
   310	        problems.append(f"非 call 阶段出现失败: {other_failed}")
   311	
   312	    got = {k: v["outcome"] for k, v in calls.items()}
   313	    if got != case["expect"]:
   314	        problems.append(f"outcome 集合不符: 实测 {got} != 期望 {case['expect']}")
   315	
   316	    for name, (want_path, want_msg, is_prefix) in case["crash"].items():
   317	        rep = calls.get(name)
   318	        if rep is None or "crash_path" not in rep:
   319	            problems.append(f"{name}: 无 crash 记录")
   320	            continue
   321	        if os.path.realpath(rep["crash_path"]) != os.path.realpath(want_path):
   322	            problems.append(f"{name}: 异常抛出点文件不符 {rep['crash_path']} != {want_path}")
   323	        first = rep["crash_message"].splitlines()[0]
   324	        ok_msg = first.startswith(want_msg) if is_prefix else first == want_msg
   325	        if not ok_msg:
   326	            problems.append(f"{name}: 异常首行不符\n      实测 {first!r}\n      期望 {want_msg!r}")
   327	
   328	    for name, needles in case["require_frames"].items():
   329	        rep = calls.get(name)
   330	        chain = [f["path"] for f in (rep or {}).get("frames", [])]
   331	        for needle in needles:
   332	            if not any(c.endswith(needle) for c in chain):
   333	                problems.append(f"{name}: frame 链缺少 {needle} (实测 {chain})")
   334	
   335	    ok = not problems
   336	    print(f"[{case['label']}] expect {case['expect']} -> ok={ok} rc={rc}")
   337	    for p in problems:
   338	        print(f"    ✗ {p}")
   339	    return ok
   340	
   341	
   342	def _judge_residue() -> bool:
   343	    cmd = [sys.executable, G_SCRIPT]
   344	    env = dict(os.environ)
   345	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   346	    print(f"[{G_LABEL}] $ {' '.join(cmd)}", flush=True)
   347	    try:
   348	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   349	    except subprocess.TimeoutExpired as e:
   350	        sys.stderr.write(str(e))
   351	        print(f"[{G_LABEL}] TIMEOUT after 600s")
   352	        return False
   353	    sys.stdout.write(proc.stdout)
   354	    sys.stderr.write(proc.stderr)
   355	    lines = [ln for ln in proc.stdout.splitlines() if ln.startswith("BARK-KEYFILE-RESIDUE:")]
   356	    ok = proc.returncode == 0 and len(lines) == 1 and lines[0].startswith(G_OK_PREFIX)
   357	    print(f"[{G_LABEL}] expect OK -> ok={ok} rc={proc.returncode} lines={lines}")
   358	    return ok
   359	
   360	
   361	def main() -> int:
   362	    ap = argparse.ArgumentParser(description="Bark 外发守卫负控裁判 (二十跑)")
   363	    ap.add_argument("--only", help="逗号分隔的跑标签, 只跑这些 (变异负控用)")
   364	    args = ap.parse_args()
   365	
   366	    wanted = None
   367	    if args.only:
   368	        wanted = [w.strip() for w in args.only.split(",") if w.strip()]
   369	        unknown = [w for w in wanted if w not in ALL_LABELS]
   370	        if unknown:
   371	            print(f"未知跑标签 {unknown}; 可用: {ALL_LABELS}")
   372	            return 2
   373	
   374	    results = []
   375	    for case in CASES:
   376	        if wanted is not None and case["label"] not in wanted:
   377	            continue
   378	        results.append((case["label"], _judge_pytest(case)))
   379	    if wanted is None or G_LABEL in wanted:
   380	        results.append((G_LABEL, _judge_residue()))
   381	
   382	    print()
   383	    for label, ok in results:
   384	        print(f"{label}: {'ok' if ok else 'MISMATCH'}")
   385	    if results and all(ok for _, ok in results):
   386	        print(f"NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} runs as expected)")
   387	        return 0
   388	    print("NEGATIVE-CONTROL: FAIL")
   389	    return 1
   390	
   391	
   392	if __name__ == "__main__":
   393	    sys.exit(main())

