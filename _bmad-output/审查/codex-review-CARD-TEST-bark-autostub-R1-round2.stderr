    64	def _c(label, nodeids, extra, expect, crash=None, require_frames=None):
    65	    """一条 pytest 跑。expect: {测试函数名: 'passed'|'failed'};
    66	    crash: {测试函数名: (期望文件绝对路径, 期望消息, 是否前缀匹配)}。"""
    67	    return {
    68	        "label": label,
    69	        "nodeids": nodeids,
    70	        "extra": extra,
    71	        "expect": expect,
    72	        "crash": crash or {},
    73	        "require_frames": require_frames or {},
