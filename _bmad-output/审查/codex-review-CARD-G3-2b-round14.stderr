   635	def _fm_has_event_compat(fm_text, ev_id, all_ledger_ids=()):
   636	    """F1 判定: 按**完整** event_id 查; 裸键回落**仅在映射可证唯一时**才做。
   637	
   638	    回落只为**历史兼容** —— 本卡之前写入的校准记录存的是剥前缀形态。新写入一律
   639	    存完整形态, 所以新数据不会再走回落分支。
   640	
   641	    ⛔ 但回落本身会**制造新的别名** (Codex round-5 BLOCKER, 实测): 账本里同时
   642	    存在裸键 `K` 与带前缀的 `quiz:K` 时, 后者回落查 `K` 会命中前者写下的校准
   643	    条目 —— 两个**不同的完整 event_id** 别名成一个, 那次评分静默不入账
   644	    (实测 rc=0、账本 attempts=[1,2]、第三次评分没有校准条目)。
   645	
   646	    所以回落前必须**先证明映射唯一**: 账本里若同时存在 `K` 与 `quiz:K`
   647	    (裸形态相同的两个不同完整 id), 歧义不可消解 —— **停下**, 而不是猜一个。
   648	    """
   649	    # ⛔ **exact 命中也不得绕过歧义检查** (Codex round-7 BLOCKER)。
   650	    # 上一版第一行就是 `if _fm_has_event(fm_text, ev_id): return True` ——
   651	    # 实测漏账链: 首次提交 event_id='quiz:K' ⇒ 账本行 `quiz:quiz:K`; 把校准改成
   652	    # 历史形态 `quiz:K`; 再提交**新** id `K`(完整 id 也是 `quiz:K`) ⇒ exact 命中
   653	    # 那条历史条目、判「已完整应用」而幂等跳过, **账本/attempt/校准都没增加**。
   654	    #
   655	    # 正确做法: 一个校准 token 可能来自两种来源 —— 某个账本 id 的**完整**形态,
   656	    # 或某个带 `quiz:` 前缀的账本 id 的**历史裸**形态。先把命中的 token 反查回
   657	    # **所有可能的来源 id**, 再要求那个集合**恰为**当前这一个 id。
   658	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   659	    if not _cands:
   660	        return False
   661	    # ⚠️ 与 `_resolve_receipt` 的**有意差异**(不是分叉遗漏, 见 `_cands_and_sources`):
   662	    # 这里空来源集合**放行**。因为本函数只回答「校准里有没有这条」, 而
   663	    # 「账本行本就丢失」正是 F1-only 分支的前提 —— 在那里强制来源非空, 等于要求
   664	    # 证明一个前提上不存在的东西。来源为空时的**证明责任**由 F1-only 分支的
   665	    # `_resolve_receipt(..., require_source=False, facts=...)` 用六项事实承担。
   666	    if _sources and _sources != {ev_id}:
   667	        raise SystemExit(
   668	            f"[quiz-answer] 校准记录里的条目可能来自账本里的多个 event_id "
   669	            f"{sorted(_sources)!r} (完整形态与历史裸形态无法区分), 而本次要判定的是 "
   670	            f"{ev_id!r} — 猜一个就会让另一个静默不入账, fail-closed 拒写 — "
   671	            f"请人工统一这些 id (去掉裸形态或补上 `quiz:` 前缀)"
   672	        )
   673	    return True
