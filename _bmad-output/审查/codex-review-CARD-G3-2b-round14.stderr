  1548	def validate_file(path: Path) -> tuple[list[str], list[str]]:
  1549	    """整文件校验 → (violations, warnings), 均按行号升序。
  1550	
  1551	    逐行二进制读+独立 UTF-8 解码: 单行坏字节序列 = 该行违规,
  1552	    不中断其余行的校验 (Codex round-1: 原 text-mode 读会炸 traceback)。
  1553	    """
  1554	    violations: list[str] = []
  1555	    warnings: list[str] = []

 succeeded in 0ms:
  1220	    ):
  1221	        assert needle in a8, f"§6.2 A8 段缺「{needle}」— round-4 裁决未回写契约"
  1222	    # 三态语义段必须写明 out_of_order 的**写点侧** fail-closed 口径 (N1 的契约面)
  1223	    # —— proof 侧是「报违规仍计入」, 在线写路径不能照搬, 两个口径必须分开写清楚。
  1224	    oo = doc[doc.index("**`out_of_order` 字段冻结") : doc.index("**迟到事件的入账通道**")]
  1225	    for needle in ("写点（在线 A2）侧同款语义门", "fail-closed", "被伪装成乱序的真实后继", "唯一合法值布尔 `true`"):
  1226	        assert needle in oo, f"§6.2 三态语义段缺「{needle}」— 写点侧口径未回写契约"
  1227	
  1228	
  1229	# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
  1230	# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
  1231	# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
  1232	# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
  1233	# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
  1234	
  1235	
  1236	def _strip_calibration(vault: Path) -> None:
  1237	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1238	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1239	    head, fm, body = text.split("---\n", 2)
  1240	    lines, out, skipping = fm.split("\n"), [], False
  1241	    for ln in lines:
  1242	        if ln.startswith("calibration_log:"):
  1243	            skipping = True
  1244	            continue
  1245	        if skipping and (ln.startswith("  ") or ln == ""):
  1246	            continue
  1247	        skipping = False
  1248	        out.append(ln)
  1249	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1250	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1251	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1252	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1253	
  1254	
  1255	def test_six_cell_state_machine_closed(vault):
  1256	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1257	    foreign = _review_row(event_id="quiz:板A#q1")
  1258	    _write_ledger(vault, foreign)
  1259	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z"))
  1260	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1261	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1262	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1263	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1264	
  1265	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1266	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1267	    sha_before = _sha(vault / NODE_REL)
  1268	    # 同一次评分的**续跑**（同 event_id 的旧写序孤儿）：ts 变而稳定业务时刻不变。
  1269	    # round-9 后 F1-only 会拿 receipt 与本次逐项比对 —— 若这里让 review_time
  1270	    # 跟着 ts 走，那就成了「同 ID 承载另一次评分」，会被正确拒绝。
  1271	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z", review_time="2026-08-02T10:00:00Z"))
  1272	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1273	    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
  1274	    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
  1275	
  1276	    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
  1277	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1278	    (vault / "learning_events.jsonl").unlink()
  1279	    assert _run_writer(vault, _payload()).returncode == 0
  1280	    sha_full = _sha(vault / NODE_REL)
  1281	    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
  1282	    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
  1283	    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
  1284	
  1285	    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
  1286	    _strip_calibration(vault)
  1287	    sha_stripped = _sha(vault / NODE_REL)
  1288	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1289	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1290	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1291	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1292	
  1293	    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
  1294	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1295	    (vault / "learning_events.jsonl").unlink()
  1296	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1297	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1298	    ema_before = {
  1299	        k: re.search(rf"^{k}:.*", _fm(vault), re.M).group(0)
  1300	        for k in ("mastery_score", "mastery_a", "mastery_b", "attempt_count")
  1301	    }
  1302	    r5 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
  1303	    assert r5.returncode == 0 and "degraded 遗留" in r5.stdout, r5.stdout + r5.stderr
  1304	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "格5: FSRS 必须补齐"
  1305	    for k, v in ema_before.items():
  1306	        assert re.search(rf"^{k}:.*", _fm(vault), re.M).group(0) == v, f"格5: {k} 不得二次吸收"
  1307	    assert len(_ledger_lines(vault)) == 1
  1308	
