   676	def _fm_has_event(fm_text, ev_id):
   677	    """F1 判定: calibration_log 里有没有这个 event_id。
   678	
   679	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   680	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   681	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   682	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   683	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   684	
   685	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   686	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   687	    是「有总比没有强」的降级, 出现即告警。
   688	    """
   689	    try:
   690	        import yaml  # F1 判定
   691	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   692	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   693	        if isinstance(_doc, dict):
   694	            _cal = _doc.get("calibration_log")
   695	            if isinstance(_cal, list):
   696	                return any(
   697	                    isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id
   698	                    for _e in _cal
   699	                )
   700	            return False        # null / 标量 / 缺失 ⇒ 没有任何条目
   701	    except ImportError:
   702	        print("[quiz-answer] ⚠️ PyYAML 不可用 — F1 判定退回正则扫描, 只认 block list + `- event_id:` 开头的条目; 尾注释/inline/键顺序变体会假阴性")
   703	    except Exception as _ye:
   704	        raise SystemExit(f"[quiz-answer] frontmatter 的 calibration_log 不是合法 YAML ({_ye}) — F1 判定不可证, fail-closed 拒写 — 请人工修复 {NODE}")
   705	    mcal = re.search(r'^calibration_log:[ \t]*(?:#[^\n]*)?$', fm_text, re.M)
   706	    if not mcal:
   707	        return False
   708	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   709	        if ln and not ln[0].isspace():
   710	            break
   711	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   712	        if mm:
   713	            v = mm.group(1).strip()
   714	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   715	                try:
   716	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   717	                except ValueError:
   718	                    pass
   719	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   720	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   721	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   722	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   723	                v = v[1:-1].replace("''", "'")
   724	            if v == ev_id:
   725	                return True
   726	    return False
