ce = importlib.util.module_from_spec(spec); spec.loader.exec_module(ce)
ce.CE_ROOT = ROOT/'fixtures-2'; ce.CE_ROOT.mkdir(parents=True, exist_ok=True)

def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else 'MISSING'
def rows(v):
    p=v/'learning_events.jsonl'
    return [json.loads(x) for x in p.read_text(encoding='utf-8').splitlines() if x.strip()] if p.exists() else []
def text(v): return (v/ce.NODE_REL).read_text(encoding='utf-8')
def fm_attempt(v):
    m=re.search(r'^attempt_count:\s*[\'\"]?(\d+)', text(v), re.M); return int(m.group(1)) if m else None
def receipts(v): return re.findall(r'^  - event_id:\s*[\"\']?([^\"\'\n]+)', text(v), re.M)
def val(v):
    return subprocess.run([sys.executable,str(WT/'backend/scripts/validate_learning_events.py'),str(v/'learning_events.jsonl')],capture_output=True,text=True,env=dict(os.environ),cwd=WT)
def emit(case, **kw): print(json.dumps({'case':case,**kw},ensure_ascii=False,sort_keys=True))

