   508	def _facts_of_current(_sa, _att, _gn, _ab, _board):
   509	    """从**本次候选**构造完整六项事实（F1-only / dup 用）。"""
   510	    return {
   511	        "scored_at": (_sa, _ok_str),
   512	        "attempt_count": (_att, _ok_att),
   513	        "grade_norm": (_norm_gn(_gn), _ok_gn),
   514	        "abandoned": (bool(_ab), _ok_bool),
   515	        "exam_board": (_norm_board(_board), _ok_board),
   516	    }
