  1477	def validate_record_full(
  1478	    record: object, manifest: Optional[dict] = None, vault_id: Optional[str] = None
  1479	) -> tuple[list[str], list[str]]:
  1480	    """单条 v1 记录 → (violations, warnings)。
  1481	
  1482	    调用方须先按 §一 前向兼容规则分流: event_version 为 int 且 != 1 的行
  1483	    不应进入本函数 (validate_file 已处理)。
  1484	    """
  1485	    problems: list[str] = []
  1486	    warnings: list[str] = []
  1487	    if not isinstance(record, dict):
  1488	        return ["顶层必须是 JSON object"], warnings
  1489	
  1490	    keys = set(record.keys())
  1491	    missing = sorted(TOP_LEVEL_KEYS - keys)
  1492	    extra = sorted(keys - TOP_LEVEL_KEYS)
  1493	    if missing:
  1494	        problems.append(f"缺字段: {', '.join(missing)}")
  1495	    if extra:
  1496	        problems.append(f"未知顶层字段 (v1 冻结恰好 7 键): {', '.join(extra)}")
  1497	
  1498	    event_id = record.get("event_id")
  1499	    if "event_id" in keys and (not isinstance(event_id, str) or not event_id):
  1500	        problems.append("event_id 必须为非空字符串 (幂等键)")
  1501	
  1502	    version = record.get("event_version")
  1503	    if "event_version" in keys and (isinstance(version, bool) or not isinstance(version, int)):
  1504	        problems.append("event_version 必须为整数")
  1505	
  1506	    event_type = record.get("event_type")
  1507	    if "event_type" in keys:
  1508	        if not isinstance(event_type, str):
  1509	            problems.append("event_type 必须为字符串")
  1510	        elif event_type not in EVENT_TYPES:
  1511	            problems.append(f"event_type {event_type!r} 不在 9 类白名单")
  1512	
  1513	    if "node_id" in keys and not isinstance(record.get("node_id"), str):
  1514	        problems.append("node_id 必须为字符串 (可为空串)")
  1515	
  1516	    for field in ("recorded_at", "effective_at"):
  1517	        if field in keys:
  1518	            ok, why = _parse_ts(record.get(field))
  1519	            if not ok:
  1520	                problems.append(f"{field} {why}")
  1521	
  1522	    payload = record.get("payload")
  1523	    if "payload" in keys and not isinstance(payload, dict):
  1524	        problems.append("payload 必须为 JSON object")
  1525	    elif isinstance(payload, dict):
  1526	        marker = payload.get("schema_ext")
  1527	        if marker == REVIEW_EXT_MARKER:
  1528	            ext_problems, ext_warnings = _validate_review_ext(payload, record, manifest, vault_id)
  1529	            problems.extend(ext_problems)
  1530	            warnings.extend(ext_warnings)
  1531	        elif "schema_ext" in payload:
  1532	            # marker 降级绕过 (round-3 HIGH): 'review/01' / 非字符串等
  1533	            # 曾让扩展门整体静默跳过, 坏行伪装成历史行 exit 0
  1534	            problems.append(
