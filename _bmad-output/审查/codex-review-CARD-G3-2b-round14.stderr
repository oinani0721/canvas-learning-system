  3548	def test_round11b_single_source_lookup(vault):
  3549	    """候选 token + 来源反查这段**判据逻辑**在生产文件里只许存在一份。
  3550	
  3551	    ⛔ 发现者是变异存活, 不是审查意见 (SURVIVED 的第六种成因, 本卡首次遇到):
  3552	    M53/M72 打的是 `_resolve_receipt` 里那份, 而门的场景走 `_fm_has_event_compat`
  3553	    里的**另一份** —— 变异碰不到门, 于是「存活」。追下去才发现 round-11 那条
  3554	    「抽出统一函数」的 BLOCKER **只修了一份**, 两份的成功条件已经可见地分叉:
  3555	      · resolver: `_sources != {ev_id}`        ⇒ 空集也拒
  3556	      · compat:   `if _sources and _sources != ...` ⇒ 空集放行
  3557	
  3558	    ⚠️ **如实定性: 这是结构缺陷, 不是当时可构造的行为缺陷。**
  3559	    三个 compat 调用点都查过 —— L1098/L1246 的 id 取自账本行本身(`_ALL_LEDGER_IDS`
  3560	    必含它, 空集不可达), L693 的空集由下游 `require_source=False` + 六项 facts
  3561	    承担证明。所以本门断言的是**唯一性**, 不冒充行为覆盖; 行为面由下面的验伪守住。
  3562	
  3563	    ⛔ 为什么值得设门: 两份同形判据已经分叉过一次, 下次改判据仍会只改一处。
  3564	    """
  3565	    src = SKILL.read_text(encoding="utf-8")  # 现读, 不用 import 期缓存
  3566	    assert src.count('_lid.startswith("quiz:") and _lid[5:] == _tok') == 1, (
  3567	        "来源反查逻辑出现多份 —— 判据一旦分叉, 修一处就会漏另一处"
  3568	    )
  3569	    assert src.count("        _cands.append(_bare)") == 1, "候选构造逻辑出现多份"
  3570	    assert "def _cands_and_sources(" in src, "唯一实现必须以具名函数存在(否则无从复用)"
  3571	    # 验伪: 两个消费方都必须真的调它, 否则「只剩一份」可能是把某条路径删没了
  3572	    assert src.count("_cands_and_sources(fm_text, ev_id, all_ledger_ids)") == 2, (
  3573	        "resolver 与 compat 两侧都必须复用唯一实现"
  3574	    )
  3575	
