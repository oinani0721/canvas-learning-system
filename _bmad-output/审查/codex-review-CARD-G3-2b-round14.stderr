   204	def _writer_code(vault: Path, payload: dict) -> str:
   205	    pfile = vault.parent / "payload.json"
   206	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   207	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   208	
   209	
   210	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   211	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   212	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   213	    return subprocess.run(
   214	        [sys.executable, "-c", _writer_code(vault, payload)],
   215	        capture_output=True,
   216	        text=True,
   217	        timeout=180,
   218	        cwd=str(vault),
   219	        env=env,
   220	    )
   221	
   222	
   223	def _sha(p: Path) -> str:
   224	    import hashlib
   225	
   226	    return hashlib.sha256(p.read_bytes()).hexdigest()
   227	
   228	
   229	def _write_face(vault: Path):
   230	    """整个写入面的快照：节点 + 账本。零写断言比这个。
   231	
   232	    只比节点 sha 对「账本被追加」失明；只比账本行数对「行内容被改」失明。
   233	    审查实测：在 fail-closed 分支里插一行账本追加，只比节点 sha 的门全绿。
   234	    """
   235	    lp = vault / "learning_events.jsonl"
   236	    return (_sha(vault / NODE_REL), _sha(lp) if lp.exists() else None)
   237	
   238	
   239	def _run_writer_settled(vault: Path, payload: dict, env_extra: dict | None = None):
   240	    """跑写点；若因「A2 恢复先落定」被要求重跑，就再跑一次并返回合并结果。
   241	
   242	    存在 foreign pending 时写点会先把恢复结果原子发布、再以非零码退出要求重跑
   243	    （Codex round-3 BLOCKER 的修法：恢复与新写不在同一次运行里混做，否则被恢复
   244	    事件的 mastery/校准会连同「多 pending 攒在一起」一起变得不可证）。
   245	    只关心「最终有没有写成」的门用这个；专门验证两阶段语义的门直接用 _run_writer。
   246	    """
   247	    r = _run_writer(vault, payload, env_extra)
   248	    if r.returncode != 0 and "恢复已落定" in r.stderr:
   249	        r2 = _run_writer(vault, payload, env_extra)
   250	        return subprocess.CompletedProcess(r2.args, r2.returncode, r.stdout + r2.stdout, r.stderr + r2.stderr)
   251	    return r
   252	
   253	
   254	def _ledger_lines(vault: Path) -> list[dict]:
   255	    ledger = vault / "learning_events.jsonl"
   256	    if not ledger.exists():
   257	        return []
   258	    return [json.loads(ln) for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   259	
   260	
   261	def _fm(vault: Path) -> str:
   262	    import yaml
   263	
   264	    text = (vault / NODE_REL).read_text(encoding="utf-8")
   265	    return text.split("---\n")[1]
   266	
   267	
   268	def _fm_fields(vault: Path) -> dict:
   269	    """按 bridge 同款正则抽 fsrs_* 行 (值+冒号后文本)。"""
   270	    fm = _fm(vault)
   271	    out = {}
   272	    for key in ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   273	        m = re.search(rf"^{key}:\s*\"?([^\"\n]+?)\"?\s*$", fm, re.M)
   274	        if m:
   275	            out[key] = m.group(1)
   276	    return out
   277	
