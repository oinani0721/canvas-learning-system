   519	def _resolve_receipt(fm_text, ev_id, all_ledger_ids=(), row=None, facts=None, require_source=True):
   520	    """**唯一**的 receipt 解析 + 事实校验入口 (Codex round-11 BLOCKER/HIGH)。
   521	
   522	    ⛔ 为什么必须统一: 此前 receipt 验证散落在**六处**、严格度各不相同 ——
   523	    dup 路径比六项、F1-only 比两项、foreign replay 只看「ID 在不在」(布尔)。
   524	    于是同一份 receipt 在不同分支得到不同结论: 实测把 durable 的采用时刻改掉
   525	    (保留 scored_at 与 receipt), foreign replay 照常「恢复」E1 ⇒ **state 1→2、
   526	    stability 2.31→7.32、同一次评分被算了两遍**; 把 receipt 的 attempt 改成 999
   527	    也照样称「事实一致」。
   528	    这正是 round-10「修一半」那条教训的下一层: **抽出统一函数, 让分歧不可能存在**。
   529	
   530	    返回 (receipt, 唯一来源 id)。任何不可证的情形一律 raise SystemExit。
   531	
   532	    facts: 要逐项核对的事实字典; None 表示只解析不校验事实(仍做来源唯一性证明)。
   533	    row:   对应的账本行; 给出时额外强制「三方同瞬间」(ledger effective_at /
   534	           payload.review_time / receipt ts)。
   535	    """
   536	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   537	    if not _cands:
   538	        return (None, None)          # 没有 receipt —— 由调用方决定这是否可接受
   539	    # ⛔ 成功条件是 `_sources == {ev_id}` —— **空集同样不可证** (round-11 BLOCKER):
   540	    # 账本缺失时来源集合为空, 上一版把它当「唯一」放行 ⇒ 实测另一个完整 id 的评分
   541	    # 被静默吞掉 (rc=0、账本 0 字节、attempt 不变)。
   542	    # ⚠️ `require_source=False` 用于**账本行本就丢失**的分支 (F1-only): 那里
   543	    # 来源集合必然为空, 强制它等于 {ev_id} 就是「要求证明一个前提上不存在的
   544	    # 东西」。⛔ 统一函数不等于所有调用点参数相同 —— 共用逻辑的同时, 每个
   545	    # 调用点要声明它能提供什么证据。
   546	    # ⛔ round-12 BLOCKER①: 账本来源丢失(集合为空)时, 历史裸形态与完整形态的 receipt
   547	    # **字节上不可区分**。此时唯一可证的凭据是条目自带的 `id_form: full` 标记 ——
   548	    # 没有它就无从证明这条 receipt 存的是完整 id, 猜一个就会让另一次评分静默消失。
   549	    if not _sources:
   550	        _probe, _hit_tok = None, None
   551	        for _tok in _cands:
   552	            _probe = _receipt_of(fm_text, _tok)
   553	            if _probe is not None:
   554	                _hit_tok = _tok
   555	                break
   556	        # ⛔ round-13 BLOCKER①: `id_form: full` 只证明「这条 receipt 存的是**某个**完整
   557	        # id」, **不证明它就是本次的完整 id**。裸形态回落命中时, 那个标记恰恰是
   558	        # **另一个事件**留下的 —— 实测别名链: 本地 id `K` 写出 receipt
