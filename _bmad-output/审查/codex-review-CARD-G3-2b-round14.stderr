   372	
   373	class _DupKey(Exception):
   374	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   375	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   376	
   377	
   378	def _no_dup_keys(pairs):
   379	    _seen = set()
   380	    for _k, _ in pairs:
   381	        if _k in _seen:
   382	            raise _DupKey(repr(_k))
   383	        _seen.add(_k)
   384	    return dict(pairs)
   385	
   386	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   387	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   388	# 出现重复时停下, 不猜)。误报方向 fail-closed (顶格错位文本会被当键) 可接受。
   389	FSRS_KEYS = ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review")
   390	_watched = ("type", "source_board", "mastery_score", "mastery", "mastery_level",
   391	            "mastery_a", "mastery_b", "attempt_count", "last_examined", "calibration_log") + FSRS_KEYS
   392	_keycount = {}
   393	for _mm in re.finditer(r'^([A-Za-z_][A-Za-z0-9_-]*):', fm, re.M):
   394	    _keycount[_mm.group(1)] = _keycount.get(_mm.group(1), 0) + 1
   395	_dupkeys = sorted(k for k, c in _keycount.items() if c > 1 and k in _watched)
   396	if _dupkeys:
   397	    raise SystemExit(f"[quiz-answer] frontmatter 重复键 {_dupkeys} (解析歧义不可证), fail-closed 拒写 — 请手工修复节点后重跑")
   398	
   399	# ── G3-2 幂等分诊前置判定。两个独立域:
   400	#   F1 = 本 event_id 已在 frontmatter calibration_log (解析层判定, 非子串 —
   401	#        live 实证 Obsidian 会把 yaml 引号规范化掉, json.dumps 子串恒不命中;
   402	#        双引号形态经 json.loads 与写侧 json.dumps 同源反解, 单引号/裸词剥引号)
   403	#   L1 = 账本已有 parsed event_id == evid 的行 (parsed-field equality, 禁子串)
   404	# ⛔ F1 单独不能证明 FSRS 已推进 (degraded 落账写过 calibration 但没写 W —
   405	# Codex round-2 BLOCKER): 「已应用」的机械判据是 W >= durable.review_time,
   406	# 分诊在下方主流程里做, 这里只放解析函数。
   407	# ⚠️ 定义位置: 本函数必须排在**所有**调用点之前 —— 写点是扁平脚本, `≤W` 全账
   408	# 扫描(round-12 起也走 resolver)在文件中段就执行, 而 `_receipt_of` 原先定义在
   409	# 它后面 ⇒ NameError。移到 resolver 全家之前。
   410	def _receipt_of(fm_text, ev_id):
   411	    """从 calibration_log 取出该 event_id 的条目 (结构化读, 与 F1 同源)。"""
   412	    try:
   413	        import yaml  # receipt 读取
   414	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   415	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   416	        if isinstance(_doc, dict) and isinstance(_doc.get("calibration_log"), list):
   417	            for _e in _doc["calibration_log"]:
   418	                if isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id:
   419	                    return _e
   420	    except Exception:
   421	        pass
   422	    return None
