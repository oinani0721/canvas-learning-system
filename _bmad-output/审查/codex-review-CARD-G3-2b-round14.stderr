emit('id_form_inversion',first_full_id='quiz:K',second_full_id='quiz:quiz:K',receipt_ids=receipts(v),retry_rc=r2.returncode,retry_stdout=r2.stdout.strip(),retry_stderr=r2.stderr.strip(),ledger_bytes=(v/'learning_events.jsonl').read_bytes().decode(),fm_attempt=fm_attempt(v),zero_delta=before==(sha(v/ce.NODE_REL),sha(v/'learning_events.jsonl')))

