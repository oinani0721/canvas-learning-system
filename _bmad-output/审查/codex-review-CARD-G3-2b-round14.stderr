  4098	def test_round13_consumer_must_not_reshape_values(vault):
  4099	    """消费侧**不得单方面改值**：舍入 grade、`str()` 强转 board 都会拒掉合法状态。
  4100	
  4101	    ⛔ round-12 我在事实构造器里 `round(...,2)` 且 `str()` 强转 —— 而 receipt 存的是
  4102	    **原值**，于是合法的 `grade_norm=0.752`（validator rc=0）比出 `0.752 != 期望 0.75`，
  4103	    整数板名 `123` 比出「类型非法」，**两阶段永久不收敛**。
  4104	
  4105	    ⚠️ 场景必须**直接构造账本行**：写点在入口就把输入 `round(...,2)`，
  4106	    走正常入口根本产不出三位小数的账本行 —— 那样这道门测不到任何东西
  4107	    （M121 此前正是这样活下来的）。合法的三位小数行来自外部写入/旧版本。
  4108	    """
  4109	    LED = vault / "learning_events.jsonl"
  4110	
  4111	    # ① 三位小数分数走 **foreign replay**：另一个事件的合法行带 0.752
  4112	    # ⚠️ 不能用 dup 路径 —— 那条路的 envelope 会拿**本次输入**比，而写点在入口
  4113	    # 就把输入 round 成两位，于是必然冲突，测不到消费侧的舍入。
  4114	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4115	    LED.unlink(missing_ok=True)
  4116	    assert _run_writer_settled(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1)).returncode == 0
  4117	    rows = list(_ledger_lines(vault))
  4118	    rows[0]["payload"]["grade_norm"] = 0.752  # 合法的三位小数（外部/旧版本写入）
  4119	    LED.write_text(json.dumps(rows[0], ensure_ascii=False) + "\n", encoding="utf-8")
  4120	    assert _run_validator(vault).returncode == 0, "三位小数分数本身合规（正是它难抓的原因）"
  4121	    # 让 E1 回到「已入账未应用」= pending，随后提交 E2 触发对它的复放
  4122	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4123	    r = _run_writer_settled(
  4124	        vault, _payload(event_id="E2#q1", ts="2026-08-01T11:00:00Z", review_time="2026-08-01T11:00:00Z")
  4125	    )
  4126	    assert r.returncode == 0, f"⛔ 消费侧舍入会把合法的三位小数行永久拒掉: {r.stderr[:300]}"
  4127	    _rc_gn = re.search(
  4128	        r'- event_id: "quiz:E1#q1"\n(?:    [^\n]*\n)*?    grade_norm: ([\d.]+)',
