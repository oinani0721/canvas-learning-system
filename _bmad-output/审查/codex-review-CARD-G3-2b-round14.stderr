   307	
   308	def test_crash_window_ledger_without_frontmatter_recovers(vault):
   309	    """卡文 (c)② 字面判据: 恢复产物与直接应用**逐字节相同** (round-2 HIGH:
   310	    旧版只比 FSRS 子集; 现全部副作用 last_examined/calibration.ts 以 durable
   311	    业务时刻为基准, 整节点字节对拍)。"""
   312	    r = _run_writer(vault, _payload())
   313	    assert r.returncode == 0, r.stdout + r.stderr
   314	    golden_bytes = (vault / NODE_REL).read_bytes()
   315	    # 模拟崩溃窗口①: 回滚 frontmatter 到评分前 (账本保留该事件)
   316	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   317	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
   318	    assert r2.returncode == 0, r2.stdout + r2.stderr
   319	    assert len(_ledger_lines(vault)) == 1, "恢复路径不得二次 append"
   320	    assert (vault / NODE_REL).read_bytes() == golden_bytes, (
   321	        "恢复产物必须与直接应用逐字节相同 (side effects 以 durable review_time 为基准)"
   322	    )
   323	    assert "A2 重放已应用" in r2.stdout or "崩溃窗口" in r2.stdout
