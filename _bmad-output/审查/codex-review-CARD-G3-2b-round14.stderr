   425	def _cands_and_sources(fm_text, ev_id, all_ledger_ids=()):
   426	    """校准 token 的候选集 + 来源反查 —— **唯一实现**, 两个调用点共用。
   427	
   428	    ⛔ 为什么必须抽出来 (变异 M53/M72 存活暴露): round-11 把 receipt 验证统一到
   429	    `_resolve_receipt` 时, 这段「候选 + 反查」在 `_fm_has_event_compat` 里**还留着
   430	    一份副本**, 而且两份的成功条件**已经分叉** ——
   431	      · `_resolve_receipt`:      `_sources != {ev_id}` ⇒ 拒 (空集也不可证, B②)
   432	      · `_fm_has_event_compat`:  `if _sources and ...` ⇒ **空集放行**
   433	    也就是说 round-11 那条 BLOCKER 只修了一份。这正是它自己要根治的「修一半」:
   434	    抽了函数却没让所有调用点都用, 下次改判据仍要改两处。
   435	
   436	    返回 (候选 token 列表, 来源 id 集合)。**不**做放行/拒绝裁决 —— 两个调用点的
   437	    严格度差异是**有意的**(见各自 docstring), 由它们各自声明, 而不是靠这里分叉。
   438	    """
   439	    _cands = []
   440	    if _fm_has_event(fm_text, ev_id):
   441	        _cands.append(ev_id)
   442	    _bare = ev_id[5:] if ev_id.startswith("quiz:") else None
   443	    if _bare is not None and _fm_has_event(fm_text, _bare):
   444	        _cands.append(_bare)
   445	    # 反查: 每个账本 id 贡献「完整」token; 带 `quiz:` 前缀的再贡献「历史裸」token。
   446	    _sources = set()
   447	    for _tok in _cands:
   448	        for _lid in all_ledger_ids:
   449	            if _lid == _tok or (_lid.startswith("quiz:") and _lid[5:] == _tok):
   450	                _sources.add(_lid)
   451	    _sources.discard("")
   452	    return (_cands, _sources)
   453	
