   313	def _instant_only(s, ctx):
   314	    """tz-aware 解析 → UTC 瞬间。**不施加整秒/UTC 字面门** —— 用于只需要比较
   315	    「是不是同一个绝对时刻」的场合。
   316	
   317	    ⚠️ 别拿 _durable_instant 去当它用: 契约 §6.1:106 对 effective_at 的要求
   318	    只有「与 review_time **同一瞬间**（按绝对时刻比较——Z 与 +00:00 是同一瞬间
   319	    的两种写法, **不按原字符串比**）」, 整秒只约束 review_time。校验器也正是
   320	    这么实现的(_instant 比较)。用严格字面门去卡 effective_at 就比契约严一档,
   321	    `+08:00` 写法会被写点拒而校验器放行 —— 又一次实现与契约两个口径。
   322	    """
   323	    if not isinstance(s, str) or not s.strip():
   324	        raise SystemExit(f"[quiz-answer] {ctx} 非字符串时刻 ({s!r}), fail-closed 拒写")
   325	    try:
   326	        _d = datetime.fromisoformat(s.strip().replace("Z", "+00:00"))
   327	    except ValueError:
   328	        raise SystemExit(f"[quiz-answer] {ctx} 不可解析 ({s!r}), fail-closed 拒写")
   329	    if _d.tzinfo is None:
   330	        raise SystemExit(f"[quiz-answer] {ctx} 缺时区 ({s!r}; §三 要求 tz-aware), fail-closed 拒写")
   331	    return _d.astimezone(timezone.utc)
