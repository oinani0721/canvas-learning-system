   869	def _apply_mastery(fm_text, biz_ts, gn=None):
   870	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   871	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   872	    old = None
   873	    for key in ("mastery_score", "mastery", "mastery_level"):
   874	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   875	        if mo:
   876	            old = float(mo.group(1)); break
   877	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   878	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   879	    if ma and mb:
   880	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   881	    elif old is not None:
   882	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   883	    else:
   884	        a_, b_ = PRIOR_A, PRIOR_B
   885	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   886	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   887	    days_idle = 0.0
