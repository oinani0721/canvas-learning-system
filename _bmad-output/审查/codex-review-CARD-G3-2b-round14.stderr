r1=ce.run(v,event_id='E1#q1',ts=t1,review_time=t1,exam_board='检验白板/E1.md'); assert r1.returncode==0
all_rows=rows(v); e1=all_rows[1]
(v/ce.NODE_REL).write_text(baseline_node,encoding='utf-8')
tampered='2026-12-01T10:00:00Z'
e1['effective_at']=tampered; e1['payload']['review_time']=tampered
ce.write_rows(v,base_rows[0],e1)
vr=val(v); before=(sha(v/ce.NODE_REL),sha(v/'learning_events.jsonl'))
r2=ce.run(v,event_id='E1#q1',ts='2026-09-01T10:00:00Z',review_time=t1,exam_board='检验白板/E1.md')
emit('normal_W_adopted_tamper',validator_rc=vr.returncode,precrash_W='2026-08-01T10:00:00Z',scored_at=e1['payload']['scored_at'],tampered_review_time=e1['payload']['review_time'],retry_rc=r2.returncode,retry_stdout=r2.stdout.strip()[-700:],retry_stderr=r2.stderr.strip()[-700:],post_W=ce.fsrs_fields(v).get('fsrs_last_review'),fm_attempt=fm_attempt(v),ledger_attempts=[x['payload']['attempt_count'] for x in rows(v)],node_changed=before[0]!=sha(v/ce.NODE_REL),ledger_unchanged=before[1]==sha(v/'learning_events.jsonl'))

