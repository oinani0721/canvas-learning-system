   101	def _review_row(**over):
   102	    """一条 canonical review/1 durable 行 (与生产写点键集逐字同形)。"""
   103	    row = {
   104	        "event_id": "quiz:板A#q1",
   105	        "event_version": 1,
   106	        "event_type": "answer_scored",
   107	        "node_id": "测试节点",
   108	        "recorded_at": TS1,
   109	        "effective_at": TS1,
   110	        "payload": {
   111	            "schema_ext": "review/1",
   112	            "vault_id": "canvas_vault_测试",
   113	            "concept_id": "测试节点",
   114	            "rating": 3,
   115	            "grade_norm": 0.75,
   116	            "review_time": TS1,
   117	            "fsrs_library_version": "degraded:historic-run",
   118	            "fsrs_params_hash": "degraded:historic-run",
   119	            "exam_board": "检验白板/板A.md",
   120	            "attempt_count": 1,
   121	        },
   122	    }
   123	    for k, v in over.items():
   124	        if k.startswith("payload."):
   125	            row["payload"][k.split(".", 1)[1]] = v
   126	        else:
   127	            row[k] = v
   128	    return row
