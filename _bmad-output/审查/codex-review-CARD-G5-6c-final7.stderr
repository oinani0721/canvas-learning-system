   312	
   313	def sha(p: pathlib.Path) -> str:
   314	    return hashlib.sha256(p.read_bytes()).hexdigest()
   315	
   316	
   317	def run_suite() -> tuple[int, set[str], str]:
   318	    r = subprocess.run(
   319	        PYTEST,
   320	        cwd=BACKEND,
   321	        capture_output=True,
   322	        text=True,
   323	        env={
   324	            "PATH": "/usr/bin:/bin",
   325	            "PYTHONDONTWRITEBYTECODE": "1",
   326	            "HOME": str(pathlib.Path.home()),
   327	            "LC_ALL": "C.UTF-8",
   328	        },
   329	    )
   330	    out = r.stdout + r.stderr
   331	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   332	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   333	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   334	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   335	    failed = {
   336	        ln.split("::")[1].split(" ")[0].strip()
   337	        for ln in out.splitlines()
   338	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   339	    }
   340	    tail = [
   341	        ln
   342	        for ln in out.splitlines()
   343	        if "passed" in ln or "failed" in ln or "error" in ln
   344	    ]
   345	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   346	
   347	
   348	original = SRC.read_bytes()
   349	base_sha = sha(SRC)
   350	print(f"源码基线 sha256 = {base_sha}\n", flush=True)
   351	
   352	
   353	def _restore_on_signal(signum, _frame):
   354	    """⛔ 真事故（2026-09-02）：本脚本被 2 分钟超时 SIGTERM 杀掉时，`finally`
   355	    **没有执行** —— Python 默认信号处理器直接终止进程，不抛异常，源码被留在
   356	    M-PAIRS 变异态。原地改源码的脚本必须显式注册处理器才谈得上「一定还原」。
   357	    （能安全恢复靠的是上面那行基线 sha 已经打印出来 —— 有它，还原才有可验证
   358	    判据；没有它只能凭记忆猜该改回什么。）"""
   359	    SRC.write_bytes(original)
   360	    print(f"\n⛔ 收到信号 {signum}，已还原源码 sha256={sha(SRC)}", flush=True)
   361	    sys.exit(128 + signum)
   362	
   363	
   364	for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
   365	    signal.signal(_sig, _restore_on_signal)
   366	
   367	results: list[tuple[str, bool]] = []
   368	try:
   369	    for name, expected, layers in MUTATIONS:
   370	        text = original.decode("utf-8")
   371	        for old, new in layers:
   372	            n = text.count(old)
   373	            if n != 1:
   374	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   375	            text = text.replace(old, new)
   376	        SRC.write_text(text, encoding="utf-8")
   377	        if sha(SRC) == base_sha:
   378	            raise SystemExit(f"[{name}] 变异没有真的改到字节")
   379	
   380	        rc, failed, summary = run_suite()
   381	        SRC.write_bytes(original)
   382	        restored = sha(SRC)
   383	
   384	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   385	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   386	        # 「跑完了且有测试失败」的只有 rc=1。
   387	        ok = failed == expected and rc == 1 and restored == base_sha
   388	        results.append((name, ok))
   389	        print(f"{'✅' if ok else '❌'} {name}")
   390	        print(f"   期望红: {sorted(expected)}")
   391	        print(f"   实际红: {sorted(failed)}")
   392	        if failed - expected:
   393	            print(f"   ⚠️ 多红（波及面比预期大）: {sorted(failed - expected)}")
   394	        if expected - failed:
   395	            print(f"   ⛔ 少红（该防线没有门在测）: {sorted(expected - failed)}")
   396	        print(
   397	            f"   rc={rc} | {summary} | 还原 sha "
   398	            f"{'一致' if restored == base_sha else '⛔不一致'}\n"
   399	        )
   400	finally:
   401	    SRC.write_bytes(original)
   402	    final = sha(SRC)
   403	    print(
   404	        f"finally 还原后 sha256 = {final} "
   405	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   406	    )
   407	
   408	allok = (
   409	    all(ok for _, ok in results)
   410	    and sha(SRC) == base_sha
   411	    and len(results) == len(MUTATIONS)
   412	)
   413	print("\n" + "=" * 70)
   414	print(
   415	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   416	    f"（{sum(1 for _, ok in results if ok)}/{len(MUTATIONS)} 变异的实际失败集合等于预先声明集合）"
   417	)
   418	sys.exit(0 if allok else 1)

