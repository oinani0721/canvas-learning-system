   904	def head_window(text: str) -> list[tuple[int, str]]:
   905	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   906	    lines = text.splitlines()
   907	    n = frontmatter_span(lines)
   908	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   909	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   910	        win.append((n + j + 1, ln))

