  2739	def test_atx_heading_text_is_parsed_structurally(tmp_path):
  2740	    """⛔ 第九轮审查 HIGH（R9-H3）：标题内容判断此前用 `lstrip(" \\t#")` 一把撸掉
  2741	    所有井号，于是 `# # #` 的**中间那个 `#`**（可见的标题内容）被当 opening 剥掉，
  2742	    整行判空标题 → 文件确定删除；`#######`（7 个，超过 ATX H6 上限）本是普通
  2743	    文本，也被结构行判定当成空标题模板。
  2744	
  2745	    ATX 的结构是 `opening(1-6 个 #) + 空白 + content + 可选 closing`，
  2746	    分离得按这个结构走，不能靠字符集剥离 —— 这是对用户 C3 裁决的**实现偏差**，
  2747	    不是要推翻裁决。
  2748	    """
  2749	    mod = load_module()
  2750	    assert mod._atx_heading_text("# # #") == "#", "中间的井号是可见内容"
  2751	    assert mod._atx_heading_text("## 标题 ##") == "标题", "收尾序列要去掉"
  2752	    assert mod._atx_heading_text("# 标题") == "标题"
  2753	    assert mod._atx_heading_text("# ") == "", "空标题就是空"
  2754	    assert mod._atx_heading_text("###") == ""
  2755	    assert mod._atx_heading_text("#######") == "", "超过 H6 不是标题，无标题文字"
  2756	    assert mod._is_structural_line("#######") is False, "7 个井号是普通文本"
  2757	    assert mod._is_structural_line("######") is True, "6 个仍是空标题模板"
  2758	
  2759	    vault, out = base_vault(tmp_path)
  2760	    inbox = vault / "_待处理"
  2761	    mk(inbox / "井号是内容.md", "# # #\n", age_days=5)
  2762	    mk(inbox / "七个井号.md", "#######\n", age_days=4)
  2763	    # ⛔ 正向对照：真正的空标题模板仍 C3
  2764	    mk(inbox / "空标题模板.md", "# \n\n## \n\n###\n", age_days=3)
  2765	
  2766	    assert run_cli(vault, out).returncode == 0
  2767	    data = load_json(out)
  2768	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2769	    for name in ("井号是内容.md", "七个井号.md"):
  2770	        it = item_by_name(data, name)
  2771	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2772	        assert it["criterion"] == "C6_undecided", name
  2773	    ctrl = item_by_name(data, "空标题模板.md")
  2774	    assert ctrl["criterion"] == "C3_empty_or_skeleton", ctrl["basis"]
  2775	    assert ctrl["verdict"] == "建议删"
