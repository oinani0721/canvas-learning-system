  2857	def test_ascii_whitespace_semantics_are_not_unicode(tmp_path):
  2858	    """⛔ 第十轮审查三条 HIGH，根因是**同一个**：该用 ASCII 空白口径的地方用了
  2859	    Unicode 口径（Python 的 `.strip()` 与 `\\s` 默认就是 Unicode 语义）。
  2860	
  2861	    · R10-H1 `dup_body()` 的 `rstrip()` 剥掉 NBSP，两个 U+00A0 还被改写成两个
  2862	      ASCII 空格 —— 判据仍在做有损投影；
  2863	    · R10-H3 `_atx_heading_text()` 用 Unicode `\\s` 判 closing，于是 `# <NBSP>#`
  2864	      末尾那个**可见的** `#` 被当收尾序列剥掉 → 空标题 → 确定删除。
  2865	      CommonMark §4.2 的 closing 必须由 space/tab 与内容分开。
  2866	
  2867	    ⚠️ 这与本卡开篇那条 NBSP（`#{1,6}` 后写 `(?:\\s|$)`）是**同一个陷阱**，
  2868	    在同一张卡里踩了两次。凡是「按 Markdown 规范判空白」的地方都得写死 ASCII。
  2869	    """
  2870	    mod = load_module()
  2871	    nb = "\u00a0"
  2872	    # ⛔ 承重点在这里：回退成 Unicode `rstrip()` 后，NBSP 会被**整个剥掉**，
  2873	    # `alpha<NBSP><NBSP>\nbeta` 就与**没有硬换行的**正本 `alpha\nbeta` 相等
  2874	    # 并被确定删除。只断言「NBSP 版 ≠ ASCII 版」测不到这一层（两版在回退后
  2875	    # 仍然不等）—— 变异 M-ASCIIWS 首跑「少红」正是这么暴露出来的。
  2876	    assert mod.dup_body(f"alpha{nb}{nb}\nbeta\n") != mod.dup_body("alpha\nbeta\n"), (
  2877	        "NBSP 不是可剥的行尾空白：剥掉它就会与无硬换行的正本相撞"
  2878	    )
  2879	    assert mod.dup_body(f"alpha{nb}{nb}\nbeta\n") != mod.dup_body("alpha  \nbeta\n")
  2880	    assert mod.dup_body(f"x{nb}\ny\n") != mod.dup_body("x\ny\n")
  2881	    assert mod._atx_heading_text(f"# {nb}#") == f"{nb}#", "NBSP 前的 # 是标题内容"
  2882	    assert mod._atx_heading_text("# 标题 ##") == "标题", "ASCII 空格分隔的 closing 仍剥"
  2883	    assert mod.dup_body("alpha  \nbeta\n") == mod.dup_body("alpha  \nbeta\n")
  2884	
  2885	    vault, out = base_vault(tmp_path)
  2886	    inbox = vault / "_待处理"
  2887	    mk(vault / "节点" / "canon.md", "alpha  \nbeta\n", age_days=40)
  2888	    mk(inbox / "nbsp硬换行.md", f"alpha{nb}{nb}\nbeta\n", age_days=5)
  2889	    mk(inbox / "nbsp在井号前.md", f"# {nb}#\n", age_days=4)
  2890	    mk(inbox / "真重复.md", "alpha  \nbeta\n", age_days=3)
  2891	
  2892	    assert run_cli(vault, out).returncode == 0
  2893	    data = load_json(out)
  2894	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2895	    for name in ("nbsp硬换行.md", "nbsp在井号前.md"):
  2896	        it = item_by_name(data, name)
  2897	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2898	        assert it["criterion"] == "C6_undecided", name
  2899	    dup = item_by_name(data, "真重复.md")
  2900	    assert dup["criterion"] == "C4_exact_duplicate", dup["basis"]
  2901	
  2902	
  2903	def test_prefixed_url_filename_is_a_source_signal(tmp_path):
  2904	    """⛔ 第十轮审查 HIGH（R10-H2）：文件名护栏用**锚定**的 URL 正则，于是
  2905	    `source_https_example.test_article.md` 这类带前缀的文件名整条穿透。
  2906	    文件名是自由拼出来的，判定必须是 substring 级；且文件名里一个 `_` 常代表
  2907	    整个 `://`，需显式还原 scheme。
  2908	
  2909	    ⚠️ 还原正则不能写 `\\b(https?)` —— `_` 是词字符，`source_https` 里 `https`
  2910	    前后都没有词边界，那条正则一次也匹配不上（本轮实测踩到）。
  2911	    """
  2912	    vault, out = base_vault(tmp_path)
  2913	    inbox = vault / "_待处理"
  2914	    body = "通用一。\n通用二。\n"
  2915	    mk(vault / "节点" / "generic.md", body, age_days=40)
  2916	    mk(inbox / "source_https_example.test_article.md", body, age_days=6)
  2917	    mk(inbox / "ref_http_a.test_p.md", body, age_days=5)
  2918	    mk(inbox / "普通笔记.md", body, age_days=4)
  2919	
  2920	    assert run_cli(vault, out).returncode == 0
  2921	    data = load_json(out)
  2922	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2923	    for name in ("source_https_example.test_article.md", "ref_http_a.test_p.md"):
  2924	        it = item_by_name(data, name)
  2925	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2926	        assert it["criterion"] == "C6_undecided", name
  2927	        assert "文件名" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2928	    ctrl = item_by_name(data, "普通笔记.md")
  2929	    assert ctrl["criterion"] == "C4_exact_duplicate", ctrl["basis"]

