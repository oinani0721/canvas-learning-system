   581	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   582	UNREPRESENTABLE = "unrepresentable"
   583	
   584	
   585	def _fmt(sec: float, tz, pattern: str) -> str:
   586	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   587	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   588	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   589	    **不**伪造一个看似正常的时间。"""
   590	    try:
   591	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   592	    except (OverflowError, OSError, ValueError):
   593	        return UNREPRESENTABLE
   594	
   595	
   596	def fmt_utc(sec: float) -> str:
   597	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   598	
   599	
   600	def fmt_local(sec: float) -> str:
   601	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
   602	
   603	
   604	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   605	
   606	
   607	def frontmatter_span(lines: list[str]) -> int:
   608	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   609	
   610	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   611	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   612	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   613	    行号是给人核对用的，偏了就等于没有。
   614	    """
   615	    if not lines or lines[0].strip() != "---":
   616	        return 0
   617	    end = None
   618	    for i in range(1, len(lines)):
   619	        if lines[i].strip() in ("---", "..."):
   620	            end = i
   621	            break
   622	    if end is None:
   623	        return 0  # 缺闭合 → 视为无 frontmatter
   624	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   625	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   626	    # 空文件的删除提名，比不提名坏得多。
   627	    for ln in lines[1:end]:
   628	        t = ln.strip()
   629	        if not t or t.startswith("#"):
   630	            continue  # 空行与 YAML 注释不作数
   631	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   632	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   633	
   634	
   635	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   636	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   637	    lines = text.splitlines()
   638	    n = frontmatter_span(lines)
   639	    return (lines[1 : n - 1] if n else []), lines[n:]
   640	
   641	
   642	def _clean_fm_value(raw: str) -> str:
   643	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   644	
   645	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   646	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   647	    （round-3 自审 H1-6）。
   648	    """
   649	    val = (raw or "").strip()
   650	    val = re.sub(r"\s+#.*$", "", val).strip()
   651	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   652	        val = val[1:-1]
   653	    return val
   654	
   655	
   656	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   657	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   658	
   659	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   660	    于是
   661	
   662	        ---
   663	        doi:
   664	        doi: 10.1000/hidden
   665	        ---
   666	
   667	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   668	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   669	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   670	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   671	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   672	    """
   673	    out: list[tuple[str, str]] = []
   674	    for ln in fm_lines:
   675	        m = _FM_KEY_RE.match(ln)
   676	        if m:
   677	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   678	    return out
   679	
   680	
   681	def frontmatter_map(fm_lines: list[str]) -> dict:
   682	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   683	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   684	    `frontmatter_pairs`。"""
   685	    out: dict[str, str] = {}
   686	    for k, v in frontmatter_pairs(fm_lines):
   687	        out.setdefault(k, v)
   688	    return out
   689	
   690	
   691	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
   692	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。
   693	
   694	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   695	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   696	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   697	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   698	    分隔行由状态机精确标记，内容行一律是内容。
   699	
   700	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   701	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   702	
   703	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   704	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   705	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   706	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   707	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   708	    """
   709	    _, rest = split_frontmatter(text)
   710	    rows: list[tuple[str, str]] = []
   711	    stripped_comments: list[str] = []
   712	    in_fence = False
   713	    fence_char = ""
   714	    fence_len = 0
   715	    in_comment = False
   716	    for ln in rest:
   717	        m = _FENCE_RE.match(ln)
   718	        if m and not in_comment:
   719	            tok = m.group(1)
   720	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   721	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   722	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   723	            # 的 info string 允许反引号，不受此限。
   724	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   725	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   726	                # ⛔ 第七轮终审 HIGH（R7-H1）：围栏开启行的 **info string**
   727	                # （`~~~ {source=https://…}`）整行被标成 "fence" 后不进正文，
   728	                # 写在那儿的来源静默消失。这是「来源被引擎剥掉」的**第四种写法**
   729	                # （前三种：跨行 HTML 注释 / fm 整行 YAML 注释 / fm 行尾注释）。
   730	                info = ln[m.end() :].strip()
   731	                if info:
   732	                    stripped_comments.append(info)
   733	                rows.append((ln, "fence"))
   734	                continue
   735	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   736	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   737	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   738	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   739	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   740	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   741	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   742	            # 在 CommonMark 里是围栏内容）。
   743	            if (
   744	                tok[0] == fence_char
   745	                and len(tok) >= fence_len
   746	                and all(c in " \t" for c in ln[m.end() :])
   747	            ):
   748	                in_fence, fence_char, fence_len = False, "", 0
   749	                rows.append((ln, "fence"))
   750	                continue
   751	        if in_fence:
   752	            rows.append((ln, "code"))
   753	            continue
   754	        kept, rem = "", ln
   755	        while rem:
   756	            if in_comment:
   757	                i = rem.find("-->")
   758	                if i < 0:
   759	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   760	                    # （只收了闭合那一行的 `rem[:i]`），于是
   761	                    #   <!--
   762	                    #   source: https://…
   763	                    #   -->
   764	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   765	                    stripped_comments.append(rem)
   766	                    break
   767	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   768	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   769	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   770	                stripped_comments.append(rem[:i])
   771	                rem, in_comment = rem[i + 3 :], False
   772	            else:
   773	                i = rem.find("<!--")
   774	                if i < 0:
   775	                    kept += rem
   776	                    break
   777	                kept += rem[:i]
   778	                rem, in_comment = rem[i + 4 :], True
   779	        rows.append((kept, "text"))
   780	        # ⛔ round-3 审查 HIGH：闭合注释被这里整段剥掉，而来源/生成信号只扫
   781	        # frontmatter，⑨ 兜底也只覆盖 frontmatter —— 于是
   782	        # `<!-- source: https://… -->`、`<!-- DOI:10.1000/… -->`、
   783	        # `<!-- citation: ISBN … -->` 这类「唯一信息写在注释里」的文件
   784	        # C3/C4 双出口全穿。只有**未闭合**注释受保护，闭合的反而不受。
   785	        # 注释内容在上面的闭合分支里逐段收集，与「未闭合注释」对称地作信号。
   786	    return rows, in_comment, stripped_comments
   787	
   788	
   789	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   790	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   791	    三态细节见 `_classify_lines_typed`。"""
   792	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   793	
   794	
   795	def dup_body(text: str) -> str:
   796	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   797	
   798	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   799	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   800	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   801	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   802	    有后果的提名，依据必须逐字。
   803	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   804	    """
   805	    parts: list[str] = []
   806	    for ln, is_code in _classify_lines(text):
   807	        if not is_code and _HEADING_RE.match(ln):
   808	            continue
   809	        # ⛔ 第九轮 HIGH（R9-H1）：此前无条件 `rstrip()` + 丢空行，把**有语义的
   810	        # 空白**一起抹了 —— Markdown 行尾双空格是硬换行、空行是段落边界、围栏
   811	        # 里的空格与空行更是字面内容。于是 `alpha  \nbeta` 与 `alpha\nbeta`
   812	        # 被判「逐字相等」并确定删除。⚠️ 判据名叫「精确重复」，比较形态却是
   813	        # 有损投影 —— 名实不符本身就是缺陷。
   814	        if is_code:
   815	            # 围栏内一律逐字保真（含空行与行尾空格）
   816	            parts.append(nfc(ln))
   817	            continue
   818	        # ⛔ 第十轮 HIGH（R10-H1）：`rstrip()` / `strip()` 是 Unicode 语义，
   819	        # 会把 NBSP 等**有语义的**空白也剥掉，两个 U+00A0 还被改写成两个 ASCII
   820	        # 空格 —— 判据仍在做有损投影。行尾空白只按 ASCII space/tab 处理。
   821	        t = ln.rstrip(" \t")
   822	        if not t.strip(" \t"):
   823	            parts.append("")  # 段落边界是语义，不能丢
   824	            continue
   825	        if len(ln) - len(t) >= 2 and not ln[len(t) :].strip(" \t"):
   826	            t += "  "  # 行尾 ≥2 个 ASCII 空格 = 硬换行，保留其语义
   827	        parts.append(nfc(t))
   828	    return "\n".join(parts)
   829	
   830	
   831	def has_substantive_content(text: str) -> bool:
   832	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   833	
   834	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   835	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   836	    合用一个函数正是 Codex BLOCKER 的根因。
   837	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   838	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   839	    （round-3 自审 B3-3）。
   840	    """
   841	    for ln, kind in _classify_lines_typed(text)[0]:
   842	        if kind == "code":
   843	            if ln.strip():
   844	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   845	            continue
   846	        if kind == "fence":
   847	            continue
   848	        if _HEADING_RE.match(ln):
   849	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   850	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   851	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   852	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   853	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   854	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   855	            # 替用户决定。
   856	            # ⛔ **声明收窄（第五轮终审实测证伪）**：本裁决只关闭 **C3 那一半**。
   857	            # C4 侧 `dup_body()` 仍把标题整行丢掉再比对，所以
   858	            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
   859	            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
   860	            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
   861	            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
   862	            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
   863	            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
   864	            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
   865	            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
   866	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   867	            # ⛔ 第八轮 HIGH 收窄措辞：此前写「只剩五种」并逐一列举 —— 那是
   868	            # **数出来的**，实测还有空围栏、空列表、全空值 frontmatter 同样落
   869	            # C3。**数「剩几种」本身就是过宽的写法**：可达面由判据的性质决定，
   870	            # 不由我列举的完整度决定，列举永远会漏。
   871	            # 准确的说法是性质：`has_substantive_content` 找不到任何一个
   872	            # 「剥掉结构记号后还剩字符」的行时，才判空骨架。
   873	            if _atx_heading_text(ln):
   874	                return True
   875	            continue
   876	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   877	        if t and not _is_structural_line(t):
   878	            return True
   879	    return False
   880	
   881	
   882	def skeleton_note(text: str, size: int) -> str:
   883	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   884	
   885	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   886	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   887	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   888	    """
   889	    if size == 0:
   890	        return "0 字节空文件"
   891	    rows = _classify_lines_typed(text)[0]
   892	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   893	    struct = sum(
   894	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   895	    )
   896	    fences = sum(1 for _, k in rows if k == "fence")
   897	    return (
   898	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   899	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
