{'name': 'nbsp-tail.md', 'criterion': 'C4_exact_duplicate', 'verdict': '建议删', 'confident': True, 'exact_duplicate_of': '节点/canonical.md', 'basis': '归一化正文与 节点/canonical.md 逐字相等（sha256 相同）', 'uncertain_reason': None}
