  2659	def test_fence_info_string_and_semantic_operators_are_not_skeleton(tmp_path):
  2660	    """⛔ 第七轮终审两条 HIGH。
  2661	
  2662	    R7-H1 围栏开启行的 **info string**（`~~~ {source=https://…}`）整行被标成
  2663	    "fence" 后不进正文，写在那儿的来源静默消失 —— 这是「来源被引擎剥掉」的
  2664	    **第四种写法**（前三种：跨行 HTML 注释 / fm 整行 YAML 注释 / fm 行尾注释）。
  2665	    ⚠️ 四种写法各暴露一次这件事本身就是结论：**能放文本的位置是开放集合**，
  2666	    逐个补写法追不上，取证 README §10.3 把这条记为本卡的结构性边界。
  2667	
  2668	    R7-H2 `_ONLY_STRUCT_RE` 的字符表含 `=`/`|`/`:`，于是 `:=`、`=>` 这类**有语义
  2669	    的运算符**被当纯结构忽略，3 字节文件判空骨架确定删除。收窄为「一行只有全部
  2670	    由**同一种**结构字符构成时才算结构行」。
  2671	    """
  2672	    mod = load_module()
  2673	    assert mod._is_structural_line("---") is True
  2674	    assert mod._is_structural_line("***") is True
  2675	    # ⛔ 第八轮 HIGH：上一版把线画在「同字符重复」上，`||`（逻辑或）因此被删。
  2676	    # 真正的分界是「这行是不是 Markdown 的结构记号」——分隔线要 ≥3 个。
  2677	    assert mod._is_structural_line("||") is False, "两个竖线是正文，不是表格分隔"
  2678	    assert mod._is_structural_line("|||") is True, "≥3 个才是结构记号"
  2679	    assert mod._is_structural_line("--") is False, "两个连字符不构成分隔线"
  2680	    assert mod._is_structural_line(":=") is False, "定义符是内容"
  2681	    assert mod._is_structural_line("=>") is False, "推导符是内容"
  2682	    assert mod._is_structural_line("|:-|") is False, "混合结构字符 → 按内容处理"
  2683	
  2684	    vault, out = base_vault(tmp_path)
  2685	    inbox = vault / "_待处理"
  2686	    mk(inbox / "info里的来源.md", "~~~ {source=https://fence.example/p}\n~~~\n", age_days=7)
  2687	    mk(inbox / "info里的注释.md", "~~~ <!-- source: https://c.example/p -->\n~~~\n", age_days=6)
  2688	    mk(inbox / "定义符.md", ":=\n", age_days=5)
  2689	    mk(inbox / "箭头符.md", "=>\n", age_days=4)
  2690	    # ⛔ 正向对照（验伪锚）：真结构行仍算骨架，否则 C3 就被这条修法废掉了
  2691	    mk(inbox / "对照分隔线.md", "---\n\n***\n", age_days=3)
  2692	    mk(inbox / "对照空列表.md", "- \n- \n", age_days=2)
  2693	    mk(inbox / "对照三竖线.md", "|||\n", age_days=1)
  2694	
  2695	    assert run_cli(vault, out).returncode == 0
  2696	    data = load_json(out)
  2697	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2698	    for name in ("info里的来源.md", "info里的注释.md", "定义符.md", "箭头符.md"):
  2699	        it = item_by_name(data, name)
  2700	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2701	        assert it["criterion"] == "C6_undecided", name
  2702	        assert it["confident"] is False, name
  2703	    for name in ("对照分隔线.md", "对照空列表.md", "对照三竖线.md"):
  2704	        ctrl = item_by_name(data, name)
  2705	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2706	        assert ctrl["verdict"] == "建议删", name
