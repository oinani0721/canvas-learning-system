  --vault /private/tmp/card-g56c-edf737ac-root.bn1VcA/atx/vault \
  --now 2026-09-01T00:00:00+08:00 \
  --out-dir /private/tmp/card-g56c-edf737ac-root.bn1VcA/atx/out \
  --batch-size 10
```

