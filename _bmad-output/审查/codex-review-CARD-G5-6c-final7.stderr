1:#!/usr/bin/env python3
257:# ───────────────────── 复用来源装载（fail-closed，不做降级副本） ─────────────────────
259:#: 兄弟 skill 的只读 preview 引擎 —— 写侧物理防御与身份键编码的单一真相源。
265:def _load_split_preview():
295:MAX_FILENAME_BYTES = _SP.MAX_FILENAME_BYTES
297:# ───────────────────────────────── 常量 ─────────────────────────────────
299:SCHEMA_VERSION = 1  # 冻结：本卡产物形状即 v1 契约
300:GENERATOR = "clear-inbox/inbox_preview.py v1.0 (CARD-G5-6 inbox preview, read-only)"
302:INBOX_ID_NAMESPACE = "inbox-item/v1"
303:INBOX_ID_PREFIX = "inb1-"
304:INBOX_ID_BASIS = "inbox-file"
305:ID_STABILITY = "inbox_path_v1"  # ≠ split_preview 的 split_anchor_v1
307:DEFAULT_INBOX_NAME = "_待处理"
308:SLEEPING_DIR_NAME = "Sleeping"
310:#: D15 确认预算：一次性 >20 项完成率趋近 0；每件 3-5 秒的勾选量才会被真正做完。
311:#: 上限硬编码为 10 —— --batch-size 只能在 [1,10] 内调小，不能突破。
312:BATCH_MAX = 10
314:#: 睡满即提醒的门槛（R8 Step 4「睡满 30 天后清仓时自动提醒」）。
315:SLEEP_ALERT_DAYS = 30
317:#: 近似重复：只用于标「疑似·拿不准」，**绝不**产出建议删。
318:NEAR_DUP_RATIO = 0.90
319:NEAR_DUP_BODY_CHAR_CAP = 200_000
320:NEAR_DUP_LEN_RATIO = 1.5  # 长度比超出 [1/1.5, 1.5] 的对直接跳过（并计数留痕）
321:NEAR_DUP_TOP_N = 3  # 每件最多呈现的疑似正本数（按 ratio 降序、路径升序）
323:#: 语料库扫描上界（防 --vault 误指到 home 之类的大树）。
324:CORPUS_FILE_CAP = 5000
325:#: 语料库排除的目录名：产物目录 + 一切隐藏目录（.obsidian/.git/.claude/.trash…）。
326:CORPUS_EXCLUDED_DIR_NAMES = frozenset({"outputs"})
328:#: C2 文头窗口：frontmatter 块 + 其后前 N 行。窗口之外的同款字样不算「文头自述」。
329:HEAD_SCAN_LINES = 20
331:#: C2 字面量标记表（确定性常量，非 LLM 判断）。命中时 basis 带行号与逐字片段。
332:#: ⛔ 每一条都必须是**生成断言**，不是话题提及（Codex HIGH 实证）：原先收了裸词
333:#: `Deep Research`，于是手写笔记 `# Deep Research 产品比较` 也被判成 AI 产物并给出
334:#: 确定的归档去向 —— 那是硬猜。收窄后 `…由 Deep Research 生成` 仍命中。
335:#: ⛔ round-2 H2 再收窄：删去裸词 `AI 生成`/`AI生成`（它们是 `由 AI 生成`/`由AI生成`
336:#: 的严格子串，删除不丢任何带断言锚的命中，只丢 `# AI 生成内容的版权问题` 这类
337:#: 话题误命中）；且匹配加右边界规则（见 `_find_marker_pos`）。
338:#: ⛔ round-3 自审 H2-1 再收窄：删去截断形态 `本文由 AI`/`本报告由 AI` —— 它们以
