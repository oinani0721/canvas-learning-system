  2709	def test_information_in_key_name_blocks_deletion(tmp_path):
  2710	    """⛔ 第八轮 HIGH：信号⑨ 只看**值**，把信息写进**键名**就整条穿透。
  2711	
  2712	    `ISBN_978-7-111-54742-6:`（值为空）是唯一的出处标识，却因为「值为空」不触发
  2713	    兜底，被判空骨架确定删除。⚠️ 信息在键名还是在值里，对「引擎没消费它」这件事
  2714	    毫无区别 —— 这是本卡第 N 次同型：**我按自己消费数据的方式定义了「有信息」，
  2715	    而不是按用户写下东西的方式。**
  2716	    """
  2717	    vault, out = base_vault(tmp_path)
  2718	    inbox = vault / "_待处理"
  2719	    mk(inbox / "ISBN键名.md", "---\nISBN_978-7-111-54742-6:\n---\n", age_days=7)
  2720	    mk(inbox / "馆藏键名.md", "---\nTP311-13-K92-3:\n---\n", age_days=6)
  2721	    # ⛔ 正向对照：引擎**已知**的键即使空值也不触发（否则 C3 会被空 title 废掉）
  2722	    mk(inbox / "空值已知键.md", "---\ntitle:\ntags:\n---\n\n# \n", age_days=5)
  2723	    mk(inbox / "零字节.md", "", age_days=4)
  2724	
  2725	    assert run_cli(vault, out).returncode == 0
  2726	    data = load_json(out)
  2727	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2728	    for name, frag in (("ISBN键名.md", "ISBN_978"), ("馆藏键名.md", "TP311")):
  2729	        it = item_by_name(data, name)
  2730	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2731	        assert it["criterion"] == "C6_undecided", name
  2732	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2733	    for name in ("空值已知键.md", "零字节.md"):
  2734	        ctrl = item_by_name(data, name)
  2735	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2736	        assert ctrl["verdict"] == "建议删", name
