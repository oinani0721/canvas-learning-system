  2819	def test_source_identifier_in_filename_blocks_deletion(tmp_path):
  2820	    """⛔ 第九轮审查 HIGH（R9-H2）：文件名进了 item，但护栏一条都不看它。
  2821	    `ISBN_978-7-111-54742-6.md`、`DOI_10.1000_xyz.md` 这类**唯一来源写在文件名
  2822	    里**的材料，正文一撞上库内某份就被确定删除，文件名里的标识零留痕。
  2823	
  2824	    判据与既有来源信号同源（URL / DOI / ISBN 的**正面形态**），只是扫描面加上
  2825	    文件名；文件名里的分隔符常被换成 `_`，故还原成 `:` 与 `/` 各试一遍。
  2826	    """
  2827	    mod = load_module()
  2828	    assert mod._looks_like_isbn_value("ISBN 978-7-111-54742-6") is True
  2829	    assert mod._looks_like_isbn_value("978-7-111-54742-6") is True
  2830	    assert mod._looks_like_isbn_value("7-111-54742-X") is True, "ISBN-10 末位 X"
  2831	    assert mod._looks_like_isbn_value("2026-09-02") is False, "日期不是 ISBN"
  2832	    assert mod._looks_like_isbn_value("12345") is False, "位数不够"
  2833	
  2834	    vault, out = base_vault(tmp_path)
  2835	    inbox = vault / "_待处理"
  2836	    body = "通用正文一。\n通用正文二。\n"
  2837	    mk(vault / "节点" / "generic.md", body, age_days=40)
  2838	    mk(inbox / "ISBN_978-7-111-54742-6.md", body, age_days=6)
  2839	    mk(inbox / "DOI_10.1000_xyz.md", body, age_days=5)
  2840	    # ⛔ 正向对照：普通文件名的真重复件仍 C4
  2841	    mk(inbox / "普通笔记.md", body, age_days=4)
  2842	
  2843	    assert run_cli(vault, out).returncode == 0
  2844	    data = load_json(out)
  2845	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2846	    for name in ("ISBN_978-7-111-54742-6.md", "DOI_10.1000_xyz.md"):
  2847	        it = item_by_name(data, name)
  2848	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2849	        assert it["criterion"] == "C6_undecided", name
  2850	        assert "文件名" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2851	        assert it["exact_duplicate_of"] == "节点/generic.md", "重复证据仍须留痕"
  2852	    ctrl = item_by_name(data, "普通笔记.md")
  2853	    assert ctrl["criterion"] == "C4_exact_duplicate", ctrl["basis"]
  2854	    assert ctrl["verdict"] == "建议删"
