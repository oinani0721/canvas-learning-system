  2778	def test_c4_comparison_keeps_semantic_whitespace(tmp_path):
  2779	    """⛔ 第九轮审查 HIGH（R9-H1）：`dup_body()` 无条件 rstrip + 丢空行，把**有语义
  2780	    的空白**一起抹了 —— Markdown 行尾双空格是硬换行、空行是段落边界、围栏里的
  2781	    空格与空行更是字面内容。于是 `alpha  \\nbeta` 与 `alpha\\nbeta` 被判「逐字
  2782	    相等」并确定删除。
  2783	
  2784	    ⚠️ 判据名叫「精确重复」，比较形态却是**有损投影** —— 名实不符本身就是缺陷。
  2785	    这与「C4 不看标题」（用户裁决保留）是两回事：那是明确选择，这是实现有损。
  2786	    """
  2787	    mod = load_module()
  2788	    assert mod.dup_body("alpha  \nbeta\n") != mod.dup_body("alpha\nbeta\n"), "硬换行有语义"
  2789	    assert mod.dup_body("a\n\nb\n") != mod.dup_body("a\nb\n"), "空行是段落边界"
  2790	    assert mod.dup_body("```\nk  \n```\n") != mod.dup_body("```\nk\n```\n"), "围栏内逐字"
  2791	    # NFD/NFC 与标题差异仍被吸收（既有语义不得连坐）
  2792	    import unicodedata as _ud
  2793	
  2794	    assert mod.dup_body(_ud.normalize("NFD", "café\n")) == mod.dup_body("café\n")
  2795	    assert mod.dup_body("# A\n\nx\n") == mod.dup_body("# B\n\nx\n"), "标题仍不进比对"
  2796	
  2797	    vault, out = base_vault(tmp_path)
  2798	    inbox = vault / "_待处理"
  2799	    mk(vault / "节点" / "canon-hb.md", "alpha\nbeta\n", age_days=40)
  2800	    mk(vault / "节点" / "canon-fence.md", "```\nkey\n```\n", age_days=40)
  2801	    mk(inbox / "硬换行.md", "alpha  \nbeta\n", age_days=6)
  2802	    mk(inbox / "段落边界.md", "alpha\n\nbeta\n", age_days=5)
  2803	    mk(inbox / "围栏行尾空格.md", "```\nkey  \n```\n", age_days=4)
  2804	    # ⛔ 正向对照：真正逐字相同仍 C4，否则这条修法就把 C4 废了
  2805	    mk(inbox / "真重复.md", "alpha\nbeta\n", age_days=3)
  2806	
  2807	    assert run_cli(vault, out).returncode == 0
  2808	    data = load_json(out)
  2809	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2810	    for name in ("硬换行.md", "段落边界.md", "围栏行尾空格.md"):
  2811	        it = item_by_name(data, name)
  2812	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2813	        assert it["criterion"] != "C4_exact_duplicate", name
  2814	    dup = item_by_name(data, "真重复.md")
  2815	    assert dup["criterion"] == "C4_exact_duplicate", dup["basis"]
  2816	    assert dup["verdict"] == "建议删"
  2817	
