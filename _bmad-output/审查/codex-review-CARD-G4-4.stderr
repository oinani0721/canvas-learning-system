   364	class TestDualVaultIsolationOnTmpLanceDB:
   365	    @pytest.fixture(autouse=True)
   366	    def _seed_db(self, tmp_path):
   367	        self.db = _seed_dual_vault_db(tmp_path)
   368	        self.tmp_path = tmp_path
   369	
   370	    def test_vault_a_query_has_zero_results_from_b(self, monkeypatch):
   371	        pairs = _run_retrieve_lancedb(
   372	            monkeypatch, self.tmp_path, vault="vault_a", query="贝尔不等式"
   373	        )
   374	        ids = [d for d, _ in pairs]
   375	        assert not any(d.endswith("b_unique") for d in ids), (
   376	            f"vault A 的检索结果混入了 vault B 独有笔记: {pairs} — 跨 vault 泄漏"
   377	        )
   378	        contents = " | ".join(c for _, c in pairs)
   379	        assert "贝尔不等式" not in contents, (
   380	            f"vault A 检索到 B 的内容 (按 doc_id 之外的内容复核): {contents}"
   381	        )
   382	
   383	    def test_vault_a_positive_control_hits_a_unique(self, monkeypatch):
   384	        """正向对照 — 隔离测试环境根本查不出数据时的假绿防线。"""
   385	        pairs = _run_retrieve_lancedb(
