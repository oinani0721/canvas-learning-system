  2279	    @staticmethod
  2280	    def _compute_tag_jaccard(tags_a: set, tags_b: set) -> float:
  2281	        """Story 2.8 AC-5: Compute Jaccard similarity between two tag sets."""
  2282	        if not tags_a or not tags_b:
