   220	        ("math"), 新代码注入 D16 group (vault:<vid>:math)。"""
   221	        seen = self._capture_injected_scope(mock_rag_service)
   222	
   223	        response = client.post(
   224	            "/api/v1/rag/query",
   225	            json={"query": "q", "vault_id": proc_vault, "subject_id": "math"},
   226	        )
   227	
   228	        assert response.status_code == 200
   229	        assert seen == [f"vault:{proc_vault}:math"], (
   230	            f"服务看到的 ContextVar = {seen!r} — 不是 group 形态, "
   231	            "「缺省不注入/裸注入」旁路可能回来了"
   232	        )
