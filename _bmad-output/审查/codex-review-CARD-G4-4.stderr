    66	async def list_subjects_from_neo4j(neo4j_driver: "AsyncDriver") -> List[dict]:
    67	    """
    68	    Fetch the dynamic list of user-created subjects from Neo4j.
    69	
    70	    Each subject is stored as a ``:Subject`` node with properties:
    71	        id (str), name (str), createdAt (str), color (str|null).
    72	
    73	    Args:
    74	        neo4j_driver: An async Neo4j driver instance.
    75	
    76	    Returns:
    77	        List of subject dicts with keys: id, name, createdAt, color.
    78	    """
    79	    query = """
    80	    MATCH (s:Subject)
    81	    RETURN s.id AS id, s.name AS name,
    82	           s.createdAt AS createdAt, s.color AS color
    83	    ORDER BY s.createdAt ASC
    84	    """
    85	    subjects: List[dict] = []
    86	    try:
    87	        async with neo4j_driver.session() as session:
    88	            result = await session.run(query)
    89	            records = await result.data()
    90	            for rec in records:
    91	                subjects.append(
    92	                    {
    93	                        "id": rec.get("id", ""),
    94	                        "name": rec.get("name", ""),
    95	                        "created_at": rec.get("createdAt", ""),
    96	                        "color": rec.get("color"),
    97	                    }
    98	                )
    99	    except (OSError, RuntimeError, ValueError) as e:
   100	        logger.warning(f"Failed to list subjects from Neo4j: {e}")
   101	    return subjects
   102	
   103	
   104	# Directories to skip when scanning for subjects
   105	SKIP_DIRECTORIES_LOWER = {
   106	    ".obsidian",
   107	    ".git",
   108	    ".trash",
   109	    "__pycache__",
   110	    "node_modules",
   111	    ".canvas-learning",
   112	    "笔记库",
   113	    "vault",
   114	    "notes",
   115	    "obsidian",
   116	}
