   355	def _make_client(tmp_path):
   356	    """不带 vault override 的 client — 表名完全由 ContextVar 推导 (这是被测行为)。
   357	    跳过 initialize() 的向量模型预载, 手动连 tmp 库。"""
   358	    import lancedb
   359	    from agentic_rag.clients.lancedb_client import LanceDBClient
   360	
   361	    client = LanceDBClient(db_path=str(tmp_path), embedding_dim=_DIM)
   362	    client._db = lancedb.connect(str(tmp_path))
   363	    client._initialized = True
   364	    return client
