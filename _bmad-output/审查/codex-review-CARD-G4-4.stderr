   294	def current_vault_id() -> str:
   295	    """service 层统一读取口 — 当前作用域的 vault 段 (sanitized)。
   296	
   297	    per-request 作用域已注入 → 取其 vault 段 (409 门保证请求路径下它与
   298	    active vault 一致, 唯 hook-cwd 合法例外可不同); 未注入 → 进程
   299	    active vault (``get_current_vault_id()``)。
   300	
   301	    memory_service 写组 (``_vault_scoped_group_id``) 的 vault 来源改经
   302	    这里 — 根治 C6 记录的"进程级单 active vault"双真相源。
   303	    """
   304	    from app.config import get_current_vault_id
   305	    from app.core.subject_config import (
   306	        DEFAULT_SUBJECT_ID,
   307	        canonical_group_id,
   308	        get_current_subject_id,
   309	    )
   310	
   311	    ctx = get_current_subject_id()
   312	    if ctx and ctx != DEFAULT_SUBJECT_ID:
   313	        canon = canonical_group_id(ctx)
   314	        if canon.startswith("vault:"):
   315	            seg = canon.split(":")[1] if len(canon.split(":")) >= 2 else ""
   316	            if seg:
   317	                return seg
   318	    return get_current_vault_id()
