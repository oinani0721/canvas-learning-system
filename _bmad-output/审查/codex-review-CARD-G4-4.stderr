   119	def extract_subject_from_canvas_path(canvas_path: str) -> str:
   120	    """
   121	    Extract subject name from Canvas file path.
   122	
   123	    Rules:
   124	    1. Use the first non-skip directory in the path as subject
   125	    2. If only a filename, use the filename (without extension)
   126	    3. Handle Chinese and Unicode paths
   127	
   128	    Examples:
   129	    - "数学/离散数学.canvas" -> "数学"
   130	    - "托福/听力/托福听力.canvas" -> "托福"
   131	    - "离散数学.canvas" -> "离散数学"
   132	    - "笔记库/物理/力学.canvas" -> "物理" (skips 笔记库)
   133	
   134	    Args:
   135	        canvas_path: Canvas file path
   136	
   137	    Returns:
   138	        Extracted subject name
   139	
   140	    [Source: Story 1.9 AC-2 path inference]
   141	    """
   142	    from pathlib import Path
   143	
   144	    if not canvas_path:
   145	        return DEFAULT_SUBJECT_ID
   146	
   147	    path = Path(canvas_path)
   148	    parts = list(path.parts)
   149	
   150	    # Skip common root directories
   151	    for part in parts:
   152	        part_lower = part.lower()
   153	        if part_lower not in SKIP_DIRECTORIES_LOWER and not part.endswith(".canvas"):
   154	            return part
   155	
   156	    # Fallback: use filename without extension
   157	    return path.stem or DEFAULT_SUBJECT_ID
   158	
   159	
   160	def extract_canvas_name(canvas_path: str) -> str:
   161	    """
   162	    Extract canvas filename without .canvas extension.
   163	
   164	    Used to derive the canvas-level component of group_id for
   165	    per-canvas memory namespace isolation (Epic 6 Feature 6.1).
   166	
   167	    Examples:
   168	        - "数学/离散数学.canvas" -> "离散数学"
   169	        - "Math 54/chapter1/calc.canvas" -> "calc"
   170	        - "random" -> "random"
   171	        - "" -> "untitled"
   172	
   173	    Args:
   174	        canvas_path: Canvas file path (may include directories)
   175	
   176	    Returns:
   177	        Canvas filename stem, or "untitled" if empty/missing.
   178	
   179	    [Source: Phase 3 PRD Epic 6 - group_id Dynamic Binding]
   180	    """
   181	    from pathlib import PurePosixPath
   182	
   183	    if not canvas_path:
   184	        return "untitled"
   185	
   186	    # Use PurePosixPath to handle forward-slash paths consistently
   187	    name = PurePosixPath(canvas_path).stem
   188	
   189	    # PurePosixPath(".canvas").stem returns ".canvas" (hidden file with no real name)
   190	    if not name or name.startswith("."):
   191	        return "untitled"
   192	    return name
   193	
