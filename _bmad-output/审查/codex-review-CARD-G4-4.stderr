    65	def _warn_subject_scope_mismatch(state: CanvasRAGState, *, logger_ctx: str) -> None:
    66	    """CARD-G4-4: state["subject"] 与请求级 VaultScope 二级一致性哨兵。
    67	
    68	    rag 端点经 ``resolve_vault_scope`` 注入 ContextVar (group 含二级 =
    69	    请求 subject_id); ``rag_service.query`` 又把同一 subject_id 写进
    70	    ``state["subject"]`` —— 两者同源 (同一请求字段), 正常路径恒一致。
    71	    本检查是哨兵而非门: 若未来某调用方往 state["subject"] 塞了与请求
    72	    作用域不同的值 (如经 query_with_fallback 旁路), 在此显式告警而非
    73	    静默分裂 —— 检索链用 state["subject"], 记忆注入用 ContextVar, 分裂
    74	    会让两条链落到不同作用域。哨兵自身不得成为业务失败源, 任何异常吞掉。
    75	    """
    76	    try:
    77	        from app.core.subject_config import sanitize_subject_name
    78	        from app.core.vault_scope import current_group_id
    79	
    80	        subject = state.get("subject")
    81	        if not subject:
    82	            return
    83	        parts = current_group_id().split(":")
    84	        if len(parts) >= 3 and parts[2] and parts[2] != sanitize_subject_name(str(subject)):
    85	            logger.warning(
    86	                "[%s] state.subject=%r 与请求级 VaultScope 二级 %r 不一致 — "
    87	                "检索链与记忆注入可能落在不同作用域 (CARD-G4-4 哨兵)",
    88	                logger_ctx,
    89	                subject,
    90	                parts[2],
    91	            )
    92	    except Exception as e:  # noqa: BLE001 — 哨兵失败只损失告警
    93	        logger.debug("[%s] subject-scope sentinel skipped: %s", logger_ctx, e)
    94	
