   167	            "null=本次未产出状态。注意与 HTTP 503 的分工: 503 表示 RAG 服务"
   168	            "整体不可达, 本字段表示这一次检索结果的可信度。"
   169	        ),
   170	    )
   171	    retrieval_status_reason: Optional[str] = Field(
