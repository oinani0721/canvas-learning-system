   291	
   292	        # Story 1.9: Resolve subject scope for retrieval isolation.
   293	        # The `subject` field in the LangGraph state is read by retrieve_lancedb
   294	        # and retrieve_graphiti nodes for scoped search.
   295	        effective_subject = subject_id
   296	
   297	        # Build initial state
   298	        # ✅ Verified from agentic_rag/state.py: CanvasRAGState schema
   299	        initial_state = {
   300	            "messages": [{"role": "user", "content": query}],
   301	            "canvas_file": canvas_file,
   302	            "subject": effective_subject,
   303	            "cross_subject": cross_subject,
   304	            "is_review_canvas": is_review_canvas,
   305	            "fusion_strategy": fusion_strategy
   306	            or ("weighted" if is_review_canvas else "rrf"),
   307	            "reranking_strategy": reranking_strategy or "hybrid_auto",
   308	            "graphiti_results": [],
   309	            "lancedb_results": [],
   310	            "multimodal_results": [],
   311	            "fused_results": [],
   312	            "reranked_results": [],
   313	            "query_rewritten": False,
   314	            "rewrite_count": 0,
   315	        }
   316	
   317	        # Merge runtime config
   318	        runtime_config = {**self._config, **(config or {})}
   319	
   320	        try:
   321	            # ✅ Verified from LangGraph Skill: ainvoke for async execution
   322	            result = await canvas_agentic_rag.ainvoke(
   323	                initial_state, config=runtime_config
   324	            )
   325	
   326	            # ✅ Epic 12.K.2: None value protection - ainvoke may return None
   327	            if result is None:
   328	                logger.warning(
   329	                    f"RAGService: ainvoke returned None for query: {query[:50]}..."
   330	                )
   331	                return self._get_fallback_result(
   332	                    fallback_reason="ainvoke_returned_none"
   333	                )
   334	
   335	            return result
   336	
   337	        except RAGServiceError:
   338	            # Re-raise our custom exceptions
   339	            raise
   340	        except Exception as e:
   341	            logger.error(f"RAGService query failed: {e}")
   342	            raise RAGServiceError(f"RAG query execution failed: {e}") from e
