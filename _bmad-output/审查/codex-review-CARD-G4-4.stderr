   277	import logging as _canon_logging
   278	from functools import lru_cache as _canon_lru_cache
   279	
   280	_canon_logger = _canon_logging.getLogger(__name__)
   281	
   282	
   283	# Round-23 Patch 2: 本地 deprecated mapping 副本 (避免循环依赖 services 层)
   284	# 与 app.services.group_id_migration_service.LEGACY_TO_VAULT_MAPPING 内容必须保持同步.
   285	# core 层是配置基石, 不依赖 services 层. services 层的 mapping 用于一次性迁移脚本.
   286	_DEPRECATED_GROUP_ID_MAPPING = {
   287	    "cs188": "vault:default",
   288	    "canvas-dev": "vault:default",
   289	    "general": "vault:default",
   290	    "main": "vault:default",
   291	}
   292	
   293	
   294	@_canon_lru_cache(maxsize=128)
   295	def canonical_group_id(value: str) -> str:
   296	    """Round-23 Patch 2: group_id 唯一归一化入口.
   297	
   298	    所有 group_id 输入路径必须经此函数, 杜绝以下泄漏:
   299	    - 旧硬编码 (cs188 / canvas-dev / cs_61b:main) 直接进 Neo4j
   300	    - 不同来源大小写/连字符差异 (CS-61B vs cs_61b)
   301	    - 用户输入未 sanitize 直接写库
   302	
   303	    deprecated 字符串触发 WARNING (但仍归一化, 不破坏现有数据读取).
   304	
   305	    归一化 4 条规则 (与 services.group_id_migration_service.map_legacy_group_id 一致):
   306	    1. 空/None/非 str → 'vault:default'
   307	    2. 已 vault: 前缀 → 幂等返回
   308	    3. 命中 _DEPRECATED_GROUP_ID_MAPPING → 映射 + WARNING
   309	    4. 含冒号 (Story 1.9 subject:canvas 格式) → vault:<sanitize(subject)>:<sanitize(canvas)>
   310	    5. 其他 → vault:<sanitize(value)>
   311	
   312	    Args:
   313	        value: 原始 group_id (可能是 deprecated / 已规范 / 任意字符串)
   314	
   315	    Returns:
   316	        归一化后的 vault: 前缀 group_id
   317	
   318	    Examples:
   319	        >>> canonical_group_id("vault:cs_61b")
   320	        'vault:cs_61b'
   321	        >>> canonical_group_id("cs188")  # 触发 WARNING
   322	        'vault:default'
   323	        >>> canonical_group_id("CS 61B")
   324	        'vault:cs_61b'
   325	
   326	    Notes:
   327	        - lru_cache 避免每次 import 重算
   328	        - core 层不依赖 services 层 (避免循环依赖)
   329	    """
   330	    if not isinstance(value, str) or not value.strip():
   331	        _canon_logger.warning(
   332	            "canonical_group_id received empty/non-str input, defaulting to 'vault:default'"
   333	        )
   334	        return "vault:default"
   335	
   336	    if is_vault_group_id(value):
   337	        return value
   338	
   339	    if value in _DEPRECATED_GROUP_ID_MAPPING:
   340	        new_value = _DEPRECATED_GROUP_ID_MAPPING[value]
   341	        _canon_logger.warning(
   342	            "Deprecated group_id '%s' detected — auto-canonicalized to '%s'. "
   343	            "Update callers to use vault: prefix directly.",
   344	            value,
   345	            new_value,
   346	        )
   347	        return new_value
   348	
   349	    if ":" in value:
   350	        parts = value.split(":", 1)
   351	        subject = sanitize_subject_name(parts[0])
   352	        rest = sanitize_subject_name(parts[1]) if len(parts) > 1 else ""
   353	        if rest:
   354	            return f"vault:{subject}:{rest}"
   355	        return f"vault:{subject}"
   356	
   357	    return f"vault:{sanitize_subject_name(value)}"
   358	
   359	
   360	def sanitize_subject_name(name: str) -> str:
   361	    """
   362	    Sanitize a subject name for use as group_id.
   363	
   364	    Preserves Unicode characters (Chinese, Japanese, etc.) while normalizing
   365	    ASCII characters to lowercase and replacing special characters with underscores.
   366	
   367	    Args:
   368	        name: Raw subject name
   369	
   370	    Returns:
   371	        Sanitized name
   372	
   373	    Examples:
   374	        - "数学" -> "数学"
   375	        - "Math 101" -> "math_101"
   376	        - "计算机科学" -> "计算机科学"
   377	        - "托福/听力" -> "托福_听力"
   378	    """
   379	    import re
   380	
   381	    if not name:
   382	        return "default"
   383	
   384	    normalized = name.casefold()
   385	    sanitized = re.sub(r"[^\w]", "_", normalized, flags=re.UNICODE)
   386	    sanitized = re.sub(r"_+", "_", sanitized)
   387	    return sanitized.strip("_") or "default"
   388	
