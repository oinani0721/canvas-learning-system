234:        subject_id: Optional[str] = None,
235:        cross_subject: bool = False,
255:            subject_id: Optional subject for multi-subject scope isolation (Story 1.9)
256:            cross_subject: Whether to expand search to related subjects via Tag Jaccard
292:        # Story 1.9: Resolve subject scope for retrieval isolation.
293:        # The `subject` field in the LangGraph state is read by retrieve_lancedb
295:        effective_subject = subject_id
299:        initial_state = {
302:            "subject": effective_subject,
303:            "cross_subject": cross_subject,
323:                initial_state, config=runtime_config
454:    async def query_with_fallback(
   280	                input_summary={"query": query[:80]},
   281	                output=ServiceStatus.UNAVAILABLE.value,
   282	                reason=f"LangGraph not available: {_IMPORT_ERROR}",
   283	            )
   284	            raise RAGUnavailableError(
