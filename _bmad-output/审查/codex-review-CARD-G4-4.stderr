   189	# ========================================
   190	# Node 1: Graphiti知识图谱检索
   191	# ========================================
   192	
   193	
   194	async def retrieve_graphiti(state: CanvasRAGState, runtime: Runtime[CanvasRAGConfig]) -> Dict[str, Any]:
   195	    """
   196	    Graphiti知识图谱检索节点
   197	
   198	    ✅ Verified from LangGraph Skill:
   199	    - Node signature: async def node(state: State, runtime: Runtime) -> dict
   200	    - Return dict with state updates
   201	
   202	    ✅ Story 12.1: 使用真实GraphitiClient
   203	    - AC 1.1: 初始化Graphiti MCP客户端
   204	    - AC 1.2: search_nodes()接口
   205	    - AC 1.3: 200ms超时自动取消
   206	    - AC 1.4: 结果转换为SearchResult
   207	
   208	    Args:
   209	        state: 当前状态 (包含messages, canvas_file等)
   210	        runtime: 运行时配置
   211	
   212	    Returns:
   213	        State更新字典:
   214	        - graphiti_results: List[SearchResult]
   215	        - graphiti_latency_ms: float
   216	    """
   217	    start_time = time.perf_counter()
   218	
   219	    # 获取查询 (从messages中提取最后一条用户消息)
   220	    messages = state.get("messages", [])
   221	    if messages:
   222	        last_msg = messages[-1]
   223	        query = last_msg.get("content", "") if isinstance(last_msg, dict) else getattr(last_msg, "content", "")
   224	    else:
   225	        query = ""
   226	
   227	    # ✅ Story 23.3: 节点入口日志
   228	    logger.debug(f"[retrieve_graphiti] START - query='{query[:50]}...' canvas={state.get('canvas_file')}")
   229	
   230	    # 获取配置 (Story 12.K.2: Safe config access)
   231	    batch_size = _safe_get_config(runtime, "graphiti_batch_size") or _safe_get_config(
   232	        runtime, "retrieval_batch_size", 10
   233	    )
   234	    canvas_file = state.get("canvas_file")
   235	    subject = state.get("subject")
   236	    _warn_subject_scope_mismatch(state, logger_ctx="retrieve_graphiti")
   237	
   238	    # Story 1.9: Build scoped group_id for Graphiti search isolation.
   239	    # When subject is set, use build_group_id to scope the search.
   240	    scoped_canvas = canvas_file
   241	    if subject:
   242	        try:
   243	            from app.core.subject_config import build_group_id
   244	
   245	            scoped_canvas = build_group_id(subject, canvas_file)
   246	        except ImportError:
   247	            # Running outside backend context — fall back to plain canvas_file
   248	            scoped_canvas = f"{subject}:{canvas_file}" if canvas_file else subject
   249	
   250	    # ✅ Story 12.1: 使用真实Graphiti客户端
   251	    # CARD-G4-2 (2026-08-28): 通道失败不再只吞成 [] — 失败原因落
   252	    # channel_errors (add_dicts reducer 合并并行通道), 汇聚层折算四态。
   253	    channel_errors: Dict[str, str] = {}
   254	    try:
   255	        client = await _get_graphiti_client()
   256	        graphiti_results = await client.search_nodes(query=query, canvas_file=scoped_canvas, num_results=batch_size)
   257	    except Exception as e:
   258	        # Fallback: 返回空结果 + 通道级失败信号
   259	        logger.warning(f"[retrieve_graphiti] Fallback triggered: {e}")
   260	        graphiti_results = []
   261	        channel_errors["graphiti"] = f"{type(e).__name__}: {e}"
   262	
   263	    latency_ms = (time.perf_counter() - start_time) * 1000
   264	
   265	    # ✅ Story 23.3: 节点出口日志
   266	    logger.debug(f"[retrieve_graphiti] END - results={len(graphiti_results)}, latency={latency_ms:.2f}ms")
   267	
   268	    return {
   269	        "graphiti_results": graphiti_results,
   270	        "graphiti_latency_ms": latency_ms,
   271	        "channel_errors": channel_errors,
   272	    }
   273	
