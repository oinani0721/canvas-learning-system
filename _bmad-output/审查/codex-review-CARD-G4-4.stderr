  2340	    async def progressive_scope_search(
  2341	        self,
  2342	        query: str,
  2343	        course_id: str,
  2344	        table_name: str = "vault_notes",
  2345	        num_results: int = 10,
  2346	        min_results_threshold: int = 5,
  2347	        query_type: str = "hybrid",
  2348	        subject: Optional[str] = None,
  2349	        canvas_file: Optional[str] = None,
  2350	        tag_jaccard_bridge_enabled: bool = False,
  2340	    async def progressive_scope_search(
  2341	        self,
  2342	        query: str,
  2343	        course_id: str,
  2344	        table_name: str = "vault_notes",
  2345	        num_results: int = 10,
  2346	        min_results_threshold: int = 5,
  2347	        query_type: str = "hybrid",
  2348	        subject: Optional[str] = None,
  2349	        canvas_file: Optional[str] = None,
  2350	        tag_jaccard_bridge_enabled: bool = False,
  2351	        tag_jaccard_threshold: float = 0.3,
  2352	        category: Optional[str] = None,
  2353	        rrf_k: int = 60,
  2354	    ) -> List[Dict[str, Any]]:
  2355	        """
  2356	        Story 2.8 AC-3: Progressive 4-stage cascading scope search.
  2357	
  2358	        When searching within a specific course, if insufficient results are found,
  2359	        automatically expands to broader scopes:
  2360	          Stage 1: Same course (course = course_id)
  2361	          Stage 2: Related courses (Tag Jaccard similarity > threshold)
  2362	          Stage 3: Same category (category column match)
  2363	          Stage 4: Full library (no filter)
  2364	
  2365	        Each result is tagged with scope_level (1-4) in metadata.
  2366	        Expansion stops when results >= min_results_threshold.
  2367	
  2368	        Args:
  2369	            query: Search query text.
  2370	            course_id: Current course ID for initial scope.
  2371	            table_name: LanceDB table name.
  2372	            num_results: Target number of results.
  2373	            min_results_threshold: Stop expanding when this many results found.
  2374	            query_type: Search type ("vector" or "hybrid").
  2375	            subject: Optional subject filter.
  2376	            canvas_file: Optional canvas file filter.
  2377	            tag_jaccard_bridge_enabled: Whether to use Tag Jaccard for stage 2.
  2378	            tag_jaccard_threshold: Jaccard similarity threshold for related courses.
  2379	            category: Optional category for stage 3 filtering.
  2380	            rrf_k: RRF fusion k parameter (Story 2.11 configurable, default 60).
  2381	
  2382	        Returns:
  2383	            List of search results with scope_level in metadata.
  2384	        """
  2385	        all_results: List[Dict[str, Any]] = []  # noqa: C408
  2386	        seen_doc_ids: set = set()
  2387	
  2388	        def _tag_and_collect(results: List[Dict[str, Any]], scope: int) -> int:
  2389	            """Tag results with scope_level and collect unique ones."""
  2390	            added = 0
  2391	            for r in results:
  2392	                doc_id = r.get("doc_id", "")
  2393	                if doc_id in seen_doc_ids:
  2394	                    continue
  2395	                seen_doc_ids.add(doc_id)
  2396	                r.setdefault("metadata", {})["scope_level"] = scope
  2397	                all_results.append(r)
  2398	                added += 1
  2399	            return added
  2400	
  2401	        # Stage 1: Same course
  2402	        stage1 = await self.search(
  2403	            query=query,
  2404	            table_name=table_name,
  2405	            num_results=num_results,
  2406	            query_type=query_type,
  2407	            course_id=course_id,
  2408	            subject=subject,
  2409	            canvas_file=canvas_file,
  2410	            rrf_k=rrf_k,
  2411	        )
  2412	        _tag_and_collect(stage1, scope=1)
  2413	
  2414	        if len(all_results) >= min_results_threshold:
  2415	            if LOGURU_ENABLED:
  2416	                logger.debug(f"[progressive] Stage 1 sufficient: {len(all_results)} results for course={course_id}")
  2417	            return all_results[:num_results]
  2418	
  2419	        # Stage 2: Related courses via Tag Jaccard
  2420	        if tag_jaccard_bridge_enabled and course_id:
  2421	            related_courses = await self.find_related_courses(
  2422	                current_course=course_id,
  2423	                table_name=table_name,
  2424	                threshold=tag_jaccard_threshold,
  2425	            )
  2426	            for related_course in related_courses:
  2427	                if len(all_results) >= min_results_threshold:
  2428	                    break
  2429	                stage2 = await self.search(
  2430	                    query=query,
  2431	                    table_name=table_name,
  2432	                    num_results=num_results,
  2433	                    query_type=query_type,
  2434	                    course_id=related_course,
  2435	                    subject=subject,
  2436	                    canvas_file=canvas_file,
  2437	                    rrf_k=rrf_k,
  2438	                )
  2439	                _tag_and_collect(stage2, scope=2)
  2440	
  2441	            if LOGURU_ENABLED:
  2442	                logger.debug(
  2443	                    f"[progressive] Stage 2 done: {len(all_results)} results (related_courses={related_courses})"
  2444	                )
  2445	
  2446	            if len(all_results) >= min_results_threshold:
  2447	                return all_results[:num_results]
  2448	
  2449	        # Stage 3: Same category
  2450	        if category:
  2451	            stage3 = await self._search_by_category(
  2452	                query=query,
  2453	                category=category,
  2454	                table_name=table_name,
  2455	                num_results=num_results,
  2456	                query_type=query_type,
  2457	                subject=subject,
  2458	                rrf_k=rrf_k,
  2459	            )
  2460	            _tag_and_collect(stage3, scope=3)
  2461	
  2462	            if LOGURU_ENABLED:
  2463	                logger.debug(f"[progressive] Stage 3 done: {len(all_results)} results (category={category})")
  2464	
  2465	            if len(all_results) >= min_results_threshold:
  2466	                return all_results[:num_results]
  2467	
  2468	        # Stage 4: Full library (no course/category filter)
  2469	        stage4 = await self.search(
  2470	            query=query,
  2471	            table_name=table_name,
  2472	            num_results=num_results,
  2473	            query_type=query_type,
  2474	            subject=subject,
  2475	            canvas_file=canvas_file,
  2476	            rrf_k=rrf_k,
  2477	        )
  2478	        _tag_and_collect(stage4, scope=4)
  2479	
  2480	        if LOGURU_ENABLED:
  2481	            logger.debug(f"[progressive] Stage 4 done: {len(all_results)} total results")
  2482	
  2483	        return all_results[:num_results]
  2484	
