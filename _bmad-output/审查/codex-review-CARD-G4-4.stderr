  3409	    def _convert_to_search_results(
  3410	        self, raw_results: List[Dict[str, Any]], canvas_file: Optional[str] = None
  3411	    ) -> List[Dict[str, Any]]:
  3412	        """
  3413	        转换LanceDB结果为标准SearchResult格式
  3414	
  3415	        ✅ Story 12.2 AC 2.4: 结果转换
  3416	
  3417	        SearchResult格式:
  3418	        {
  3419	            "doc_id": str,
  3420	            "content": str,
  3421	            "score": float,
  3422	            "metadata": {
  3423	                "source": "lancedb",
  3424	                "timestamp": str,
  3425	                "canvas_file": str|None
  3426	            }
  3427	        }
  3428	        """
  3429	        search_results = []
  3430	
  3431	        for i, item in enumerate(raw_results):
  3432	            # 提取内容
  3433	            content = item.get("content") or item.get("text") or item.get("document") or ""
  3434	
  3435	            # 生成文档ID
  3436	            doc_id = item.get("doc_id") or item.get("id") or f"lancedb_{i}"
  3437	            if not doc_id.startswith("lancedb_"):
  3438	                doc_id = f"lancedb_{doc_id}"
  3439	
  3440	            # 计算分数 (LanceDB返回_distance, 需要转换为相似度)
  3441	            distance = item.get("_distance") or item.get("distance") or 0.0
  3442	            # 余弦距离转相似度: score = 1 / (1 + distance)
  3443	            # 或者: score = 1 - distance (如果distance在[0,1]范围)
  3444	            if distance >= 0:
  3445	                score = 1.0 / (1.0 + distance)
  3446	            else:
  3447	                score = 0.0
  3448	
  3449	            # 构建metadata
  3450	            metadata = {
  3451	                "source": "lancedb",
  3452	                "timestamp": datetime.now().isoformat(),
  3453	                "canvas_file": item.get("canvas_file") or canvas_file,
  3454	                "original_distance": distance,
  3455	            }
  3456	
  3457	            # 复制其他metadata字段
  3458	            for key in [
  3459	                "concept",
  3460	                "agent_type",
  3461	                "node_id",
  3462	                "metadata_json",
  3463	                # Story 2.8: Frontmatter / scope metadata
  3464	                "course",
  3465	                "tags_str",
  3466	                "category",
  3467	                # Story 2.9: Image OCR source type
  3468	                "source_type",
  3469	                # Story 2.8: Neighbor expansion marker
  3470	                "_source_type",
  3471	                # RAG-P0 A1: doc_type for source-aware filter/rerank
  3472	                "doc_type",
  3473	                # RAG-S2 T2 (2026-08-09): retrieval_confidence 地基 — RRF 融合
  3474	                # 信号此前被本白名单丢弃, 下游无法区分「双通道确认」与
  3475	                # 「dense-only 命中」(confidence 最强的一维, 零成本透传)。
  3476	                "_rrf_score",
  3477	                "_fts_only",
  3478	                # RAG-S2 T6: FTS 通道成员资格 (fts_confirmed 名实修复) —
  3479	                # _rrf_score 不承载通道信息, 双通道判定改用 _fts_hit
  3480	                "_fts_hit",
  2288	    async def find_related_courses(
  2289	        self,
  2290	        current_course: str,
  2291	        table_name: str = "vault_notes",
  2292	        threshold: float = 0.3,
  2293	    ) -> List[str]:
  2294	        """
  2295	        Story 2.8 AC-5: Find courses with Tag Jaccard similarity above threshold.
  2296	        Scans the table for distinct courses and computes Jaccard similarity
  2297	        with the current course's tag set.
  2298	        """
  2299	        if self._db is None:
  2300	            return list()
  2301	
  2302	        try:
  2303	            # T3 根治 (2026-07-10): 每次 open_table, 不读缓存句柄
  2304	            tbl = self._db.open_table(table_name)
  2305	            self._tables_cache[table_name] = tbl
  2306	            # Story 2-8 H5: Only select course and tags_str columns to avoid
  2307	            # loading full content/vector columns into memory.
  2308	            df = tbl.to_pandas(columns=["course", "tags_str"])
  2309	
  2310	            if "course" not in df.columns or "tags_str" not in df.columns:
  2311	                return list()
  2312	
  2313	            course_tags: Dict[str, set] = {}
  2314	            for _, row in df.iterrows():
  2315	                course = row.get("course", "")
  2316	                tags_str = row.get("tags_str", "")
  2317	                if not course:
  2318	                    continue
  2319	                if course not in course_tags:
  2320	                    course_tags[course] = set()
  2321	                if tags_str:
  2322	                    course_tags[course].update(t.strip() for t in tags_str.split(",") if t.strip())
  2323	
  2324	            current_tags = course_tags.get(current_course, set())
  2325	            if not current_tags:
  2326	                return list()
  2327	
  2328	            related: List[str] = []
  2329	            for other_course, other_tags in course_tags.items():
  2330	                if other_course == current_course:
  2331	                    continue
  2332	                jaccard = self._compute_tag_jaccard(current_tags, other_tags)
  2333	                if jaccard > threshold:
  2334	                    related.append(other_course)
  2335	
  2336	            return related
  2337	        except Exception:
  2338	            return list()
