  1761	
  1762	    # Step 3: Mastery prefix
  1763	    mastery_prefix = ""
  1764	    if mastery_enabled:
  1765	        try:
  1766	            from agentic_rag.mastery_injection import build_mastery_prefix
  1767	
  1768	            # Try to get mastery data from temporal client
  1769	            try:
  1770	                temporal_client = await _get_temporal_client()
  1771	                # Extract concept from query context
  1772	                canvas_file = state.get("canvas_file", "")
  1773	                concept_query = query[:50]
