    78	        import app.core.vault_scope as vault_scope_mod
    79	
    80	        monkeypatch.setattr(
    81	            vault_scope_mod, "current_vault_id", lambda: "req_vault", raising=True
    82	        )
    83	        monkeypatch.setattr(
    84	            app_config_mod, "get_current_vault_id", lambda: "proc_vault", raising=True
    85	        )
    86	
    87	        captured: dict = {}
    88	
    89	        async def _capture_memories(**kwargs):
    90	            captured["group_id"] = kwargs.get("group_id")
    91	            return "", None
    92	
    93	        # graphiti 客户端给活体 MagicMock; lancedb/temporal 客户端一律失败,
    94	        # 让节点走各自的无害降级分支 (本测试只关心 Step 4 的 group_id)。
    95	        monkeypatch.setattr(
    96	            nodes, "_get_graphiti_client", AsyncMock(return_value=MagicMock())
    97	        )
    98	        monkeypatch.setattr(
    99	            nodes,
   100	            "_get_lancedb_client",
   101	            AsyncMock(side_effect=RuntimeError("no lancedb in unit test")),
   102	        )
   103	        monkeypatch.setattr(
   104	            nodes,
   105	            "_get_temporal_client",
   106	            AsyncMock(side_effect=RuntimeError("no temporal in unit test")),
   107	        )
   108	        with patch(
   109	            "agentic_rag.mastery_injection.retrieve_learning_memories",
   110	            new=_capture_memories,
   111	        ):
   112	            state = {"messages": [{"role": "user", "content": "q"}], "subject": None}
   113	
   114	            asyncio.run(nodes.compress_context_node(state, None))
   115	
   116	        assert captured.get("group_id") == "vault:req_vault", (
