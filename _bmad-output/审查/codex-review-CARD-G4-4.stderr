   349	class TestAgentScopeSourceHeader:
   350	    """完成条件 (c): agents 端点 scope_source 三值各一例。
   351	
   352	    VaultScope.source 实际值域 = request-vault / legacy-group / active-vault
   353	    (vault_scope.py:84-86); 卡文笔名 explicit/legacy_group_id/derived_active
   354	    是语义描述不是字面值, 验收单已声明映射。
   355	    """
   356	
   357	    @pytest.fixture(autouse=True)
   358	    def _pin_active_vault(self, monkeypatch):
   359	        import app.config as app_config_mod
   360	
   361	        monkeypatch.setattr(
   362	            app_config_mod, "get_current_vault_id", lambda: "v_active", raising=True
   363	        )
   364	
   365	    @staticmethod
   366	    def _post(monkeypatch, *, vault_id=None, group_id=None, node_id="n1"):
   367	        """node_id 必须逐用例唯一 — agents 的 dedup 缓存是模块级进程态,
   368	        同 (canvas, node, type) 二连发会撞 409。"""
   369	        import uuid
   370	
   371	        client = _agents_client(monkeypatch)
   372	        body: Dict[str, Any] = {
   373	            "score": 85,
   374	            "node_id": f"{node_id}-{uuid.uuid4().hex[:8]}",
   375	            "canvas_name": "b.canvas",
   376	        }
   377	        if vault_id is not None:
   378	            body["vault_id"] = vault_id
   379	        if group_id is not None:
   380	            body["group_id"] = group_id
   381	        return client.post("/api/v1/agents/recommend-action", json=body)
   382	
   383	    def test_explicit_vault_maps_to_request_vault(self, monkeypatch):
   384	        response = self._post(monkeypatch, vault_id="v_active")
   385	        assert response.status_code == 200, response.text
   386	        assert response.headers["X-Vault-Scope-Source"] == "request-vault"
   387	
   388	    def test_legacy_group_id_maps_to_legacy_group(self, monkeypatch):
   389	        response = self._post(monkeypatch, group_id="cs188")
   390	        assert response.status_code == 200, response.text
   391	        assert response.headers["X-Vault-Scope-Source"] == "legacy-group"
   392	
   393	    def test_double_missing_maps_to_active_vault(self, monkeypatch):
   394	        response = self._post(monkeypatch)
   395	        assert response.status_code == 200, response.text
   396	        assert response.headers["X-Vault-Scope-Source"] == "active-vault"
   397	
   398	    def test_conflicting_vault_still_409(self, monkeypatch):
   399	        """agents 契约里 409 不变 (G2-2 语义), header 不出现在失败响应。"""
   400	        response = self._post(monkeypatch, vault_id="definitely_not_active_vault")
   401	        assert response.status_code == 409
   402	        assert "X-Vault-Scope-Source" not in response.headers

