     1	#!/usr/bin/env python3
     2	"""CARD-G4-4 变异负控制 — 串行; 每变异后立即还原 + SHA 逐字节比对。
     3	
     4	纪律: 判据 = 指定门变红 (不是「某处有失败」); 还原以字节为准。
     5	"""
     6	import hashlib
     7	import os
     8	import subprocess
     9	import sys
    10	from pathlib import Path
    11	
    12	BACKEND = Path(os.environ["G44_BACKEND"]).resolve()
    13	
    14	RAG = BACKEND / "app/api/v1/endpoints/rag.py"
    15	NODES = BACKEND / "lib/agentic_rag/nodes.py"
    16	UNIT = BACKEND / "tests/unit/test_agentic_rag_vault_scope.py"
    17	
    18	TARGETS = (RAG, NODES, UNIT)
    19	BACKUP = {p: p.read_bytes() for p in TARGETS}
    20	SHA0 = {p: hashlib.sha256(b).hexdigest() for p, b in BACKUP.items()}
    21	
    22	def run_gate(test_id: str) -> int:
    23	    if test_id.startswith(("TestInner", "TestDual", "TestCurrent")):
    24	        f = "tests/unit/test_agentic_rag_vault_scope.py"
    25	    else:
    26	        f = "tests/api/v1/endpoints/test_rag_vault_scope_api.py"
    27	    r = subprocess.run(
    28	        [".venv/bin/pytest", f"{f}::{test_id}", "-q", "-p", "no:cacheprovider"],
    29	        cwd=str(BACKEND), capture_output=True, text=True, timeout=600,
    30	    )
    31	    return r.returncode
    32	
    33	def restore_and_verify(step: str):
    34	    for p in TARGETS:
    35	        p.write_bytes(BACKUP[p])
    36	    for p in TARGETS:
    37	        now = hashlib.sha256(p.read_bytes()).hexdigest()
    38	        if now != SHA0[p]:
    39	            print(f"!!! [{step}] 还原后 SHA 不一致: {p.name} — 硬失败")
    40	            sys.exit(2)
    41	    print(f"[{step}] 还原逐字节一致 ✓")
    42	
    43	MUTATIONS = []
    44	
    45	def m1():
    46	    s = RAG.read_text()
    47	    old = '''    vault_id: str = Field(
    48	        ...,
    49	        min_length=1,'''
    50	    new = '''    vault_id: Optional[str] = Field(
    51	        None,
    52	        min_length=1,'''
    53	    assert old in s, "M1 anchor not found"
    54	    RAG.write_text(s.replace(old, new, 1))
    55	MUTATIONS.append(("M1-去422", "TestVaultIdRequired::test_missing_vault_id_rejected_with_422", m1))
    56	
    57	def m2():
    58	    s = RAG.read_text()
    59	    old = """    _scope = resolve_vault_scope(
    60	        request.vault_id,
    61	        subject_id=request.subject_id,
    62	        canvas_path=request.canvas_file,
    63	    )"""
    64	    new = """    if request.subject_id:
    65	        from app.core.subject_config import set_current_subject_id
    66	        set_current_subject_id(request.subject_id)"""
    67	    assert old in s, "M2 anchor not found"
    68	    RAG.write_text(s.replace(old, new, 1))
    69	MUTATIONS.append(("M2-去409-恢复旁路", "TestVaultConflict::test_mismatched_vault_rejected_with_409", m2))
    70	
    71	def m3():
    72	    s = NODES.read_text()
    73	    old = "memory_group_id = build_vault_group_id(current_vault_id())"
    74	    new = ("from app.config import get_current_vault_id as _g44_proc\n"
    75	           "                memory_group_id = build_vault_group_id(_g44_proc())")
    76	    assert old in s, "M3 anchor not found"
    77	    NODES.write_text(s.replace(old, new, 1))
    78	MUTATIONS.append(("M3-内链改回进程级", "TestInnerChainReadsRequestScope::test_compress_context_memory_group_uses_request_scope", m3))
    79	
    80	def m4():
    81	    s = UNIT.read_text()
    82	    old = '''        "vault_b_canvas_nodes": ['''
    83	    new = '''        "vault_a_canvas_nodes": [
    84	            {
    85	                "doc_id": "b_unique",
    86	                "content": "贝尔不等式的量子纠缠判据",
    87	                "vector": _vec(0.10),
    88	                "content_tokenized": _jieba_tokens("贝尔不等式的量子纠缠判据"),
    89	                "canvas_file": "b.canvas",
    90	            },
    91	        ],  # M4 同组化变异: B 独有笔记复制进 A 表
    92	        "vault_b_canvas_nodes": ['''
    93	    assert old in s, "M4 anchor not found"
    94	    UNIT.write_text(s.replace(old, new, 1))
    95	MUTATIONS.append(("M4-fixture同组化", "TestDualVaultIsolationOnTmpLanceDB::test_vault_a_query_has_zero_results_from_b", m4))
    96	
    97	def m5():
    98	    """加验: 哨兵改静默 → 一致性告警门死。"""
    99	    s = NODES.read_text()
   100	    old = '"[%s] state.subject=%r 与请求级 VaultScope 二级 %r 不一致 — "'
   101	    new = '"[%s] state.subject=%r 与请求级 VaultScope 二级 %r (debug) "'
   102	    assert old in s, "M5 anchor not found"
   103	    NODES.write_text(s.replace(old, new, 1))
   104	MUTATIONS.append(("M5-哨兵降级debug", "TestSubjectScopeSentinel::test_mismatch_warns", m5))
   105	
   106	failed = []
   107	for name, gate, fn in MUTATIONS:
   108	    fn()
   109	    rc = run_gate(gate)
