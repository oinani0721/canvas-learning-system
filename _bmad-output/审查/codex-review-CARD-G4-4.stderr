   367	def _run_retrieve_lancedb(monkeypatch, tmp_path, *, vault: str, query: str):
   368	    """以 vault 作用域跑真实 retrieve_lancedb 节点, 返回结果 doc_id/content。"""
   369	    client = _make_client(tmp_path)
   370	    monkeypatch.setattr(
   371	        nodes, "_get_lancedb_client", AsyncMock(return_value=client), raising=True
   372	    )
   373	    monkeypatch.setattr(
   374	        "agentic_rag.clients.lancedb_client.LanceDBClient.embed",
   375	        AsyncMock(return_value=_vec(0.15)),
   376	        raising=True,
   377	    )
   378	
   379	    token = _set_scope(f"vault:{vault}")
   380	    try:
   381	        state = {
   382	            "messages": [{"role": "user", "content": query}],
   383	            "canvas_file": None,
   384	            "subject": None,
   385	            "cross_subject": False,
   386	        }
   387	        update = asyncio.run(nodes.retrieve_lancedb(state, None))
   388	    finally:
   389	        _reset_scope(token)
   390	
   391	    results = update.get("lancedb_results", [])
   392	    return [(r.get("doc_id", ""), r.get("content", "")) for r in results]
