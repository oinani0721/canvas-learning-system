   150	    quality_grade: str = Field("low", description="质量评级 (high/medium/low)")
   151	    result_count: int = Field(0, description="结果数量")
   152	    latency_ms: LatencyInfo = Field(default_factory=LatencyInfo, description="延迟信息")
   153	    total_latency_ms: float = Field(0.0, description="总延迟 (ms)")
   154	    metadata: RAGQueryMetadata = Field(
