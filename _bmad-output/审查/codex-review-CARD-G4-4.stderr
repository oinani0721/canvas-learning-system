   253	
   254	_DIM = 8
   255	
   256	
   257	def _vec(seed: float) -> list:
   258	    """固定向量 — 隔离判据靠表命名空间, 不靠向量相似度。"""
   259	    return [seed] * _DIM
   260	
   261	
   262	def _jieba_tokens(content: str) -> str:
   263	    """与 client FTS 查询侧同一分词器, 保证 content_tokenized 形态一致。"""
   264	    try:
   265	        from agentic_rag.clients.lancedb_client import _jieba_tokenize
   266	
   267	        return _jieba_tokenize(content)
   268	    except Exception:
   269	        return content
   270	
   271	
   272	def _seed_dual_vault_db(tmp_path):
   273	    """同一个 tmp 目录预置 vault_a / vault_b 两张命名空间表。
   274	
   275	    「只有它在 B」笔记 (b_unique) 与 A/B 同名不同内容笔记 (same_name_*)
   276	    是隔离判据的核心; A 表另放干扰行保证正向对照不是查空表。
   277	    """
   278	    import lancedb
   279	
   280	    rows = {
   281	        "vault_a_canvas_nodes": [
   282	            {
   283	                "doc_id": "a_unique",
   284	                "content": "红黑树旋转的颜色翻转规则",
   285	                "vector": _vec(0.10),
   286	                "content_tokenized": _jieba_tokens("红黑树旋转的颜色翻转规则"),
   287	                "canvas_file": "a.canvas",
   288	            },
   289	            {
   290	                "doc_id": "same_name_a",
   291	                "content": "递归的基础定义: 函数调用自身",
   292	                "vector": _vec(0.20),
   293	                "content_tokenized": _jieba_tokens("递归的基础定义: 函数调用自身"),
   294	                "canvas_file": "a.canvas",
   295	            },
   296	        ],
   297	        "vault_b_canvas_nodes": [
   298	            {
   299	                "doc_id": "b_unique",
   300	                "content": "贝尔不等式的量子纠缠判据",
   301	                "vector": _vec(0.10),
   302	                "content_tokenized": _jieba_tokens("贝尔不等式的量子纠缠判据"),
   303	                "canvas_file": "b.canvas",
   304	            },
   305	            {
   306	                "doc_id": "same_name_b",
   307	                "content": "递归的进阶定义: 尾递归优化与调用栈",
   308	                "vector": _vec(0.20),
   309	                "content_tokenized": _jieba_tokens("递归的进阶定义: 尾递归优化与调用栈"),
   310	                "canvas_file": "b.canvas",
   311	            },
   312	        ],
   313	    }
   314	    db = lancedb.connect(str(tmp_path))
   315	    for name, data in rows.items():
   316	        db.create_table(name, data=data)
   317	        try:  # FTS 索引尽力建 — 失败则 hybrid 降级 dense-only, 判据不受影响
   318	            db.open_table(name).create_fts_index("content_tokenized", replace=True)
   319	        except Exception:
   320	            pass
   321	    return db
   322	
   323	
   324	def _make_client(tmp_path):
   325	    """不带 vault override 的 client — 表名完全由 ContextVar 推导 (这是被测行为)。
   326	    跳过 initialize() 的向量模型预载, 手动连 tmp 库。"""
   327	    import lancedb
   328	    from agentic_rag.clients.lancedb_client import LanceDBClient
   329	
   330	    client = LanceDBClient(db_path=str(tmp_path), embedding_dim=_DIM)
   331	    client._db = lancedb.connect(str(tmp_path))
   332	    client._initialized = True
   333	    return client
   334	
   335	
   336	def _run_retrieve_lancedb(monkeypatch, tmp_path, *, vault: str, query: str):
   337	    """以 vault 作用域跑真实 retrieve_lancedb 节点, 返回结果 doc_id/content。"""
   338	    client = _make_client(tmp_path)
   339	    monkeypatch.setattr(
   340	        nodes, "_get_lancedb_client", AsyncMock(return_value=client), raising=True
   341	    )
   342	    monkeypatch.setattr(
   343	        "agentic_rag.clients.lancedb_client.LanceDBClient.embed",
   344	        AsyncMock(return_value=_vec(0.15)),
   345	        raising=True,
   346	    )
   347	
   348	    token = _set_scope(f"vault:{vault}")
   349	    try:
   350	        state = {
   351	            "messages": [{"role": "user", "content": query}],
   352	            "canvas_file": None,
   353	            "subject": None,
   354	            "cross_subject": False,
   355	        }
   356	        update = asyncio.run(nodes.retrieve_lancedb(state, None))
   357	    finally:
   358	        _reset_scope(token)
   359	
   360	    results = update.get("lancedb_results", [])
   361	    return [(r.get("doc_id", ""), r.get("content", "")) for r in results]
   362	
