   196	class TestScopeInjectionAndContract:
   197	    @staticmethod
   198	    def _capture_injected_scope(mock_rag_service) -> List[str]:
   199	        """在服务调用点读取 ContextVar。
   200	
   201	        ⚠️ 不能在请求返回后读: TestClient 把 handler 跑在 worker 线程的
   202	        任务上下文里, handler 内 set 的 ContextVar 对测试主线程不可见。
   203	        服务层调用发生在同一任务上下文内, 在 side_effect 里读 = 生产
   204	        下游服务真实看到的值。"""
   205	        from app.core.subject_config import get_current_subject_id
   206	
   207	        seen: List[str] = []
   208	
   209	        async def _spy(**kwargs):
   210	            seen.append(get_current_subject_id())
   211	            return _state()
   212	
   213	        mock_rag_service.query = AsyncMock(side_effect=_spy)
   214	        return seen
