   238	        reranking_strategy: Optional[str] = None,
   239	        config: Optional[Dict[str, Any]] = None,
   240	    ) -> Dict[str, Any]:
   241	        """
   242	        Execute RAG query.
   243	
   244	        ✅ Verified from LangGraph Skill (Pattern: StateGraph invocation):
   245	        ```python
   246	        result = await graph.ainvoke(
   247	            {"messages": [{"role": "user", "content": query}]},
   248	            config=config
   249	        )
   250	        ```
   251	
   252	        Args:
   253	            query: User query string
   254	            canvas_file: Optional canvas file path for context
   255	            subject_id: Optional subject for multi-subject scope isolation (Story 1.9)
   256	            cross_subject: Whether to expand search to related subjects via Tag Jaccard
   257	            is_review_canvas: Whether this is a review canvas (affects fusion strategy)
   258	            fusion_strategy: Override fusion strategy
   259	            reranking_strategy: Override reranking strategy
   260	            config: Optional runtime configuration overrides
   261	
   262	        Returns:
   263	            Dict containing:
   264	            - messages: Response messages
   265	            - reranked_results: Final ranked results
   266	            - quality_grade: Quality assessment
   267	
   268	        Raises:
   269	            RuntimeError: If LangGraph not available
   270	
   271	        [Source: docs/stories/23.1.story.md#Step-4-创建rag_service.py]
   272	        [Source: Story 1.9 Task 6 — retrieval scope isolation]
   273	        """
   274	        if not LANGGRAPH_AVAILABLE:
   275	            # CARD-G4-2: 既有诚实单点收编统一四态 (枚举值替代裸字符串)
   276	            from app.models.service_status import ServiceStatus
   277	
   278	            log_decision(
   279	                function="RAGService.query",
   280	                input_summary={"query": query[:80]},
