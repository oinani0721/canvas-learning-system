  1721	        query = last_msg.get("content", "") if isinstance(last_msg, dict) else getattr(last_msg, "content", "")
  1722	
  1723	    reranked = state.get("reranked_results", [])
  1724	
  1725	    logger.debug(f"[compress_context] START - {len(reranked)} results, max_tokens={max_tokens}")
  1726	
  1727	    # Step 1: Staleness check (non-blocking)
  1728	    stale_count = 0
  1729	    if staleness_enabled and reranked:
  1730	        try:
  1731	            from agentic_rag.compression import staleness_check
  1732	
  1733	            # Get fingerprint lookup from LanceDB
  1734	            try:
  1735	                client = await _get_lancedb_client()
  1736	                fingerprints = client._get_all_fingerprints()
  1737	            except Exception:
  1738	                fingerprints = {}
  1739	
  1740	            if fingerprints:
  1741	                reranked = staleness_check(reranked, fingerprints)
  1742	                stale_count = sum(1 for r in reranked if r.get("metadata", {}).get("stale", False))
  1743	        except Exception as e:
  1744	            logger.debug(f"[compress_context] Staleness check skipped: {e}")
  1745	
  1746	    # Step 2: Context compression
  1747	    compressed_context = ""
  1748	    if reranked:
  1749	        try:
  1750	            from agentic_rag.compression import compress_context
  1751	
  1752	            compressed_context = compress_context(
  1753	                query=query,
  1754	                documents=reranked,
  1755	                max_tokens=max_tokens,
  1756	            )
  1757	        except Exception as e:
