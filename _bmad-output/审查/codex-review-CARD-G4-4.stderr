    49	    """rag_service.query() 返回的最小 state 形态 (四态字段无关本卡, 随手给)。"""
    50	    return {
    51	        "reranked_results": [
    52	            {"doc_id": "node-1", "content": "逆否命题…", "score": 0.9, "metadata": {}}
    53	        ],
    54	        "multimodal_results": [],
    55	        "quality_grade": "high",
    56	        "graphiti_latency_ms": 12.0,
    57	        "lancedb_latency_ms": 8.0,
    58	        "fusion_latency_ms": 1.0,
    59	        "query_rewritten": False,
    60	        "rewrite_count": 0,
    61	        "fusion_strategy": "rrf",
    62	        "reranking_strategy": "hybrid_auto",
    63	        "retrieval_status": "ok",
    64	        "retrieval_status_reason": None,
    65	    }
    66	
    67	
    68	@pytest.fixture
    69	def mock_rag_service() -> MagicMock:
    70	    service = MagicMock()
    71	    service.query = AsyncMock(return_value=_state())
    72	    return service
    73	
