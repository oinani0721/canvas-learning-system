   344	    async def get_weak_concepts_with_status(
   345	        self, canvas_file: str, limit: int = 10
   346	    ) -> "StatusedResult":
   347	        """CARD-G4-2 (2026-08-28): get_weak_concepts 的四态版本。
   348	
   349	        故障不再假装空结果: LangGraph 缺失/记忆客户端失败 → unavailable
   350	        带 reason; 真无学习历史 → empty; 有弱概念 → ok。
   351	        旧 ``get_weak_concepts`` 委托本方法保 list 契约。
   352	
   353	        Returns:
   354	            StatusedResult — items 为弱概念 dict 列表。
   355	        """
   356	        from app.models.service_status import StatusedResult
   357	
   358	        if not LANGGRAPH_AVAILABLE:
   359	            logger.warning(
   360	                "get_weak_concepts: LangGraph not available (unavailable, not empty)"
   361	            )
   362	            return StatusedResult.unavailable(
   363	                f"LangGraph not available: {_IMPORT_ERROR}"
   364	            )
   365	
   366	        # Story 36 fix: Query LearningMemoryClient for low-score concepts
   367	        try:
   368	            from app.clients.graphiti_client import get_learning_memory_client
   369	
   370	            memory_client = get_learning_memory_client()
   371	            # CARD-G4-2 Codex round-1 HIGH-9: initialize() 遇到坏 JSON /
   372	            # 权限错误会**返回 False 而不抛异常**, 随后默认 _data 仍产出
   373	            # []， 被报成 empty。检查布尔值即可, 无需动客户端对外契约。
   374	            initialized = await memory_client.initialize()
   375	            if initialized is False:
   376	                return StatusedResult.unavailable(
   377	                    "learning memory client initialize() returned False "
   378	                    "(数据不可读 — 空结果不可信)"
   379	                )
   380	
   381	            history = await memory_client.get_learning_history(canvas_file, limit=100)
   382	            if not history:
   383	                logger.info(f"get_weak_concepts: no learning history for {canvas_file}")
   384	                return StatusedResult.from_items([])
   385	
   386	            # Aggregate by concept: keep lowest score per concept
   387	            concept_map: Dict[str, Dict[str, Any]] = {}
   388	            for entry in history:
   389	                concept = entry.get("concept", "")
   390	                if not concept:
   391	                    continue
   392	                score = entry.get("score", entry.get("quality_score", 0.5))
   393	                existing = concept_map.get(concept)
   394	                if existing is None or score < existing.get("score", 1.0):
   395	                    concept_map[concept] = {
   396	                        "concept": concept,
   397	                        "score": score,
   398	                        "stability": entry.get("stability", 0.0),
   399	                        "last_review": entry.get(
   400	                            "timestamp", entry.get("created_at", "")
   401	                        ),
   402	                        "review_count": entry.get("review_count", 1),
   403	                        "canvas_file": canvas_file,
   404	                    }
   405	
   406	            # Sort by score ascending (weakest first), return top N
   407	            weak = sorted(concept_map.values(), key=lambda x: x.get("score", 1.0))
   408	            return StatusedResult.from_items(weak[:limit])
   409	
   410	        except (RuntimeError, ConnectionError, OSError, KeyError, ValueError) as e:
   411	            logger.warning(f"get_weak_concepts: failed to query learning memory: {e}")
   412	            return StatusedResult.unavailable(f"{type(e).__name__}: {e}")
   413	
   414	    async def get_weak_concepts(
   415	        self, canvas_file: str, limit: int = 10
   416	    ) -> list[Dict[str, Any]]:
   417	        """
   418	        Get weak concepts from Temporal Memory for a canvas file.
   419	
   420	        Used by review canvas generation to identify concepts needing review.
   421	
   422	        CARD-G4-2 (2026-08-28): 兼容委托 — 保 list 契约 (存量调用方直接
   423	        迭代), 状态语义在 ``get_weak_concepts_with_status``。新代码应改用
   424	        状态方法, 本方法的空 list 无法区分「无数据」与「服务故障」。
   425	
   426	        Args:
   427	            canvas_file: Canvas file path
   428	            limit: Maximum number of concepts to return
   429	
   430	        Returns:
   431	            List of weak concept dicts with stability, last_review, review_count
   432	
   433	        [Source: backend/app/api/v1/endpoints/rag.py#get_weak_concepts]
   434	        """
   435	        result = await self.get_weak_concepts_with_status(canvas_file, limit=limit)
   436	        return result.items
   437	
   438	    def get_status(self) -> Dict[str, Any]:
   439	        """
   440	        Get RAG service status information.
   441	
   442	        Returns:
   443	            Dict with available, initialized, langgraph_available, import_error
   444	
   445	        [Source: backend/app/api/v1/endpoints/rag.py#get_rag_status]
   446	        """
   447	        return {
   448	            "available": LANGGRAPH_AVAILABLE,
   449	            "initialized": self._initialized,
   450	            "langgraph_available": LANGGRAPH_AVAILABLE,
   451	            "import_error": _IMPORT_ERROR,
   452	        }
   453	
   454	    async def query_with_fallback(
   455	        self, query: str, canvas_file: Optional[str] = None, **kwargs
   456	    ) -> Dict[str, Any]:
   457	        """
   458	        Execute RAG query with graceful fallback.
   459	
   460	        If LangGraph not available, returns empty result instead of raising.
   461	
   462	        Args:
   463	            query: User query string
   464	            canvas_file: Optional canvas file path
   465	            **kwargs: Additional arguments passed to query()
   466	
   467	        Returns:
   468	            Query result or empty fallback dict
   469	        """
   470	        # CARD-G4-2 (2026-08-28): fallback dict 加性带四态键 — 调用方可
   471	        # 区分「空结果」和「RAG 挂了」(原 error 键保留, 状态键统一语义)。
   472	        if not LANGGRAPH_AVAILABLE:
   473	            logger.warning(
   474	                f"RAG query fallback: LangGraph not available. Query: {query[:50]}..."
   475	            )
   476	            return {
   477	                "messages": [],
   478	                "results": [],
   479	                "reranked_results": [],
   480	                "multimodal_results": [],
   481	                "quality_grade": None,
   482	                "result_count": 0,
   483	                "total_latency_ms": 0.0,
   484	                "latency_ms": {},
   485	                "metadata": {},
   486	                "error": _IMPORT_ERROR,
   487	                "retrieval_status": "unavailable",
   488	                "retrieval_status_reason": f"LangGraph not available: {_IMPORT_ERROR}",
   489	            }
   490	
   491	        try:
   492	            return await self.query(query, canvas_file, **kwargs)
   493	        except Exception as e:
   494	            logger.error(f"RAG query fallback due to error: {e}")
   495	            return {
   496	                "messages": [],
   497	                "results": [],
   498	                "reranked_results": [],
   499	                "multimodal_results": [],
   500	                "quality_grade": None,
   501	                "result_count": 0,
   502	                "total_latency_ms": 0.0,
   503	                "latency_ms": {},
   504	                "metadata": {},
   505	                "error": str(e),
   506	                "retrieval_status": "unavailable",
   507	                "retrieval_status_reason": str(e),
   508	            }
   509	
   510	
   511	# ============================================================
   512	# Singleton Pattern
   513	# ============================================================
   514	
   515	_rag_service: Optional[RAGService] = None
   516	
   517	
   518	def get_rag_service() -> RAGService:
   519	    """
   520	    Get RAG service singleton.
   521	
   522	    Returns:
   523	        RAGService instance
   524	    """
   525	    global _rag_service
   526	    if _rag_service is None:
   527	        _rag_service = RAGService()
   528	    return _rag_service
   529	
   530	
