  1713	    cache_key = check_duplicate_request(
  1714	        canvas_name=request.canvas_name,
  1715	        node_id=request.node_id,
  1716	        agent_type="verification_question",
  1717	    )
  1718	
  1719	    # AC3a: Get enriched context with adjacent nodes
  1720	    try:
  1721	        enriched = await context_service.enrich_with_adjacent_nodes(
