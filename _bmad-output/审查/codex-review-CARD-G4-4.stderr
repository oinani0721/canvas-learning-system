   236	            _reset_scope(token)
   237	
   238	        assert any("不一致" in r.getMessage() for r in caplog.records), (
   239	            "state.subject 与 VaultScope 二级分裂未告警 — 哨兵失灵"
   240	        )
   241	
   242	    def test_consistent_subject_does_not_warn(self, caplog):
   243	        token = _set_scope("vault:v1:math")
