   647	
   648	    @property
   649	    def active_vault_id(self) -> str:
   650	        """Resolve effective vault_id for table namespace.
   651	
   652	        Resolution order (Wave-2 P0-2 hotfix, 2026-05-12):
   653	        1. ``self._vault_id_override`` — explicit constructor arg (legacy POC tests)
   654	        2. ``app.core.subject_config.get_current_subject_id()`` ContextVar
   655	           — set per-request by ``set_current_subject_id`` in chat / metadata
   656	           endpoints. Strips ``vault:`` prefix and keeps the FIRST segment so
   657	           ``vault:cs_61b:algorithms`` → ``cs_61b``. This is the source of
   658	           truth for multi-vault isolation introduced by Story 2.5.Y.
   659	        3. ``app.config.get_current_vault_id()`` — legacy global active vault.
   660	           Kept as backward-compat fallback for callers that haven't migrated
   661	           to ContextVar (background tasks / CLI / older tests).
   662	        4. ``"default"`` — final fallback when imports fail (e.g. lib used
   663	           standalone outside the FastAPI app).
   664	        """
   665	        if self._vault_id_override is not None:
   666	            return self._vault_id_override
   667	
   668	        # Step 2: prefer ContextVar from subject_config (Story 2.5.Y vault wiring).
   669	        # Endpoints call set_current_subject_id(build_vault_group_id(...)) →
   670	        # ContextVar holds "vault:cs_61b" / "vault:cs_61b:algorithms" / etc.
   671	        # We strip the "vault:" prefix and take the first segment as the
   672	        # LanceDB table-namespace key (matches build_vault_group_id contract).
   673	        #
   674	        # Wave-3 hotfix (ChatGPT v4 verdict #3): narrow exception catch — must
   675	        # let BaseException/KeyboardInterrupt/SystemExit propagate; only swallow
   676	        # the specific import/attr/runtime/value failures expected when the
   677	        # `app.core.subject_config` module is unavailable or its ContextVar
   678	        # accessor misbehaves.
   679	        try:
   680	            from app.core.subject_config import (
   681	                DEFAULT_SUBJECT_ID,
   682	                get_current_subject_id,
   683	            )
   684	
   685	            ctx_value = get_current_subject_id()
   686	            if ctx_value and ctx_value != DEFAULT_SUBJECT_ID:
   687	                # vault:cs_61b → cs_61b ; vault:cs_61b:algorithms → cs_61b
   688	                derived = ctx_value
   689	                if derived.startswith("vault:"):
   690	                    derived = derived[len("vault:") :]
   691	                # take first segment (drop :subject / :canvas suffix)
   692	                first_seg = derived.split(":", 1)[0].strip()
   693	                if first_seg:
   694	                    logger.debug(
   695	                        "[LanceDB vault wiring] active_vault_id resolved from subject_config ContextVar: %s → %s",
   696	                        ctx_value,
   697	                        first_seg,
   698	                    )
   699	                    return first_seg
   700	        except (ImportError, AttributeError, RuntimeError, ValueError) as e:
   701	            # subject_config not importable (lib used standalone) or accessor
   702	            # broke at runtime → fall through to Level 3. Surface in debug log
   703	            # so Ops can spot wiring regressions without flooding warnings on
   704	            # the legitimate standalone-lib path.
   705	            logger.debug(
   706	                "[LanceDB vault wiring] subject_config ContextVar unavailable (%s: %s) — falling back to app.config",
   707	                type(e).__name__,
   708	                e,
   709	            )
   710	
   711	        # Step 3: legacy fallback — global active vault from settings.
   712	        # Same narrow-exception discipline as Level 2.
   713	        try:
   714	            from app.config import get_current_vault_id
   715	
   716	            return get_current_vault_id()
   717	        except (ImportError, AttributeError, RuntimeError, ValueError) as e:
   718	            # Level 4 (final): hard fallback to "default" table namespace.
   719	            # ⛔ This is the cross-vault-leak danger zone — warn loudly so Ops
   720	            # see it in production logs. Reaching here means BOTH the request
   721	            # ContextVar AND the legacy global config are unreachable, which
   722	            # should never happen inside a running FastAPI process.
   723	            logger.warning(
   724	                "[LanceDB vault wiring] active_vault_id fell back to 'default' "
   725	                "— both subject_config ContextVar and app.config unavailable "
   726	                "(last error: %s: %s); possible cross-vault leak",
   727	                type(e).__name__,
   728	                e,
   729	            )
   730	            return "default"
