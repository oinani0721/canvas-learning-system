     1	# CARD-G2-2 (BATCH-2026-08-28-第五批) — 唯一 VaultScope resolver + 409 fail-closed.
     2	"""vault_scope 统一解析契约 + 跨 endpoint 的不一致→409 裁判用例.
     3	
     4	覆盖两层:
     5	
     6	1. ``app.core.vault_scope`` 单元契约 — 409 语义 (boards.py:70-76 先例)、
     7	   双缺失推导 active vault (memory.py 批次1'① 姿势)、legacy 路径不 409
     8	   (本卡显式裁定)、hook-cwd 合法例外、current_group_id()/current_vault_id()
     9	   统一读取口。
    10	2. 端点面 409 行为 — sync/mastery/memory/exam_sessions/boards 五个此前
    11	   各自克隆 resolver 的文件, 显式 vault_id 与进程 active vault 不一致时
    12	   必须 409 (而非静默为他 vault 构组写读)。
    13	
    14	Patch-target 注记: vault_scope 全部延迟 import — 必须 patch
    15	``app.config.get_current_vault_id`` 源命名空间 (C6 同款坑)。
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	from unittest.mock import patch
    21	
    22	import pytest
    23	from fastapi import HTTPException
    24	from fastapi.testclient import TestClient
    25	
    26	from app.core.subject_config import (
    27	    DEFAULT_SUBJECT_ID,
    28	    _current_subject_id,
    29	    get_current_subject_id,
    30	    set_current_subject_id,
    31	)
    32	from app.core.vault_scope import (
    33	    current_group_id,
    34	    current_vault_id,
    35	    resolve_hook_cwd_scope,
    36	    resolve_vault_scope,
    37	)
    38	
    39	ACTIVE = "active_vault"
    40	OTHER = "other_vault"
    41	
    42	
    43	class _ContextVarHygiene:
    44	    """Token-based ContextVar restore (C6 同款): teardown 恢复外层值."""
    45	
    46	    def setup_method(self):
    47	        self._cv_token = _current_subject_id.set(DEFAULT_SUBJECT_ID)
    48	
    49	    def teardown_method(self):
    50	        _current_subject_id.reset(self._cv_token)
    51	
    52	
    53	# ═══════════════════════════════════════════════════════════════════════════
    54	# 1. resolve_vault_scope 单元契约
    55	# ═══════════════════════════════════════════════════════════════════════════
    56	
    57	
    58	class TestResolveVaultScope(_ContextVarHygiene):
    59	    def test_explicit_mismatch_raises_409(self):
    60	        """显式 request vault ≠ active vault → 409 (fail-closed 核心语义)."""
    61	        with patch("app.config.get_current_vault_id", return_value=ACTIVE):
    62	            with pytest.raises(HTTPException) as exc_info:
