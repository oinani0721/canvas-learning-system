  3696	            table_names: 表名列表 (默认使用DEFAULT_TABLES)
  3697	            canvas_file: Canvas文件过滤
  3698	            subject: 学科标识(用于学科隔离过滤)
  3699	            num_results_per_table: 每个表的结果数量
  3700	            query_type: 搜索类型 ("vector" 或 "hybrid")
  3701	            course_id: 课程ID (按课程过滤)
  3702	            tags: 标签列表 (按标签过滤, OR 匹配)
  3703	            rrf_k: RRF fusion k parameter (Story 2.11 configurable, default 60)
  3704	
  3705	        Returns:
  3706	            合并后的搜索结果 (按分数排序)
  3707	        """
  3708	        if table_names is None:
  3709	            table_names = self.DEFAULT_TABLES
  3710	
  3711	        all_results = []
  3712	
  3713	        for table_name in table_names:
  3714	            try:
  3715	                results = await self.search(
  3716	                    query=query,
  3717	                    table_name=table_name,
  3718	                    canvas_file=canvas_file,
  3719	                    subject=subject,
  3720	                    num_results=num_results_per_table,
  3721	                    query_type=query_type,
  3722	                    course_id=course_id,
  3723	                    tags=tags,
  3724	                    rrf_k=rrf_k,
  3725	                )
  3726	                all_results.extend(results)
  3727	            except Exception as e:
  3728	                if LOGURU_ENABLED:
  3729	                    logger.debug(f"Search in {table_name} failed: {e}")
  3730	
  3731	        # 按分数排序
  3732	        all_results.sort(key=lambda x: x.get("score", 0.0), reverse=True)
  3733	
  3734	        return all_results
