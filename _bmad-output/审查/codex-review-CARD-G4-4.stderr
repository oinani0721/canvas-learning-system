   142	
   143	    def __init__(self, config: Optional[Dict[str, Any]] = None):
   144	        """
   145	        Initialize RAGService.
   146	
   147	        Args:
   148	            config: Optional configuration dict for CanvasRAGConfig
   149	
   150	        Raises:
   151	            RuntimeError: If LangGraph not available and strict mode enabled
   152	
   153	        [Source: docs/stories/23.1.story.md#Dev-Notes]
   154	        """
   155	        self._config = config or {}
   156	        self._initialized = False
   157	
   158	        if not LANGGRAPH_AVAILABLE:
   159	            logger.warning(
   160	                "RAGService initialized without LangGraph support. "
   161	                f"Reason: {_IMPORT_ERROR}"
   162	            )
   163	
   164	    @property
   165	    def is_available(self) -> bool:
   166	        """Check if RAG functionality is available."""
   167	        return LANGGRAPH_AVAILABLE
   168	
   169	    @property
   170	    def import_error(self) -> Optional[str]:
   171	        """Get the import error message if LangGraph not available."""
   172	        return _IMPORT_ERROR
   173	
   174	    async def initialize(self) -> bool:
   175	        """
   176	        Initialize the service.
   177	
   178	        Returns:
   179	            True if initialization successful, False otherwise.
   180	        """
   181	        if self._initialized:
   182	            return True
   183	
   184	        if not LANGGRAPH_AVAILABLE:
   185	            logger.warning("RAGService initialization skipped: LangGraph not available")
   186	            return False
   187	
   188	        # Verify StateGraph is compiled
   189	        if not hasattr(canvas_agentic_rag, "ainvoke"):
   190	            logger.error("RAGService: canvas_agentic_rag missing ainvoke method")
   191	            return False
   192	
   193	        self._initialized = True
   194	        logger.info("RAGService initialized successfully")
   195	        return True
