    94	def _vault_segment(group_id: str, fallback: str) -> str:
    95	    """取 D16 group_id 的 vault 段; 非 vault: 前缀时回落 fallback。"""
    96	    if group_id.startswith("vault:"):
    97	        parts = group_id.split(":")
    98	        if len(parts) >= 2 and parts[1]:
    99	            return parts[1]
   100	    return fallback
   101	
   102	
   103	def active_vault_aliases() -> set:
   104	    """当前 active vault 的**全部合法别名** (sanitize 后)。
   105	
   106	    Codex CARD-G2-2 round-1 HIGH-10 整改: ``Settings.vault_id`` 优先取
   107	    ``.canvas-config.yaml`` 的显式稳定 ID, 而插件 / SessionEnd hook /
   108	    exam skill 发来的往往是 **vault 目录名或 display name**。二者在
   109	    「稳定 ID ≠ 目录名」的合法配置下并不相等 —— 只比稳定 ID 会把每一个
   110	    正常请求都误判成跨 vault 并 409, 等于全站瘫痪。
   111	
   112	    因此一致性判定采用别名集合:
   113	      1. ``get_current_vault_id()`` — 稳定 ID (yaml 显式值优先)
   114	      2. ``sanitize_vault_id(ACTIVE_VAULT)`` — 环境变量里的目录名
   115	      3. ``sanitize_vault_id(basename(CANVAS_BASE_PATH))`` — 实际挂载目录名
   116	
   117	    命中任一即视为「指向当前挂载 vault」。fail-closed 不被削弱: 真正
   118	    指向**另一个** vault 的请求三项都不命中, 仍然 409。
   119	    """
   120	    import os
   121	
   122	    from app.config import get_current_vault_id, get_settings, sanitize_vault_id
   123	
   124	    aliases = {get_current_vault_id()}
   125	    try:
   126	        settings = get_settings()
   127	        if settings.ACTIVE_VAULT:
   128	            aliases.add(sanitize_vault_id(settings.ACTIVE_VAULT))
   129	        base = settings.CANVAS_BASE_PATH
   130	        if base:
   131	            aliases.add(sanitize_vault_id(os.path.basename(str(base).rstrip("/"))))
   132	    except Exception as e:  # noqa: BLE001 — 别名扩展失败只收窄到稳定 ID
   133	        logger.debug("vault_scope: alias expansion skipped (%s)", e)
   134	    return {a for a in aliases if a}
   135	
   136	
   137	def resolve_vault_scope(
   138	    vault_id: Optional[str],
   139	    subject_id: Optional[str] = None,
   140	    canvas_path: Optional[str] = None,
   141	    legacy_group_id: Optional[str] = None,
   142	) -> VaultScope:
   143	    """请求边界唯一作用域解析 (模块 docstring 契约 1-4)。
   144	
   145	    Args:
   146	        vault_id: 请求显式携带的 vault 名 (插件 inferVaultId / API 字段)。
   147	        subject_id: 可选 vault 内学科二级。
   148	        canvas_path: 可选 canvas 路径 (subject_id 为空时的二级 fallback)。
   149	        legacy_group_id: deprecated 旧 plugin group_id (仅 vault_id 空时用)。
   150	
   151	    Returns:
   152	        VaultScope — group_id 已注入 ContextVar。
   153	
   154	    Raises:
   155	        fastapi.HTTPException: 409 — 显式 vault_id 与进程 active vault 不一致。
   156	    """
   157	    from app.config import get_current_vault_id, sanitize_vault_id
   158	    from app.core.subject_config import build_vault_group_id, canonical_group_id
   159	
   160	    active_vault = get_current_vault_id()
   161	
   162	    if vault_id and vault_id.strip():
   163	        requested = sanitize_vault_id(vault_id)
   164	        # HIGH-10 整改: 与别名集合比较 (稳定 ID / ACTIVE_VAULT / 挂载目录名),
   165	        # 防「稳定 ID ≠ 目录名」的合法配置被全量误 409。
   166	        if requested not in active_vault_aliases():
   167	            # boards.py:70-76 先例: fail-closed, 防 vault split-brain 把
   168	            # A vault 的请求静默写进 B vault 的作用域。
   169	            from fastapi import HTTPException
   170	
   171	            raise HTTPException(
   172	                status_code=409,
   173	                detail=f"vault 未激活: {requested} (当前挂载: {active_vault}) — "
   174	                "请求 vault 与进程 active vault 不一致, 拒绝静默改写作用域 "
   175	                "(CARD-G2-2 fail-closed)",
   176	            )
   177	        # 归一到稳定 ID: 请求可能用目录名/display name 命中别名, 但落库
   178	        # group 必须恒为稳定 ID, 否则同一 vault 因入口不同分裂成两个桶。
   179	        derived = build_vault_group_id(
   180	            active_vault, subject_id=subject_id, canvas_path=canvas_path
   181	        )
   182	        source = "request-vault"
   183	    elif legacy_group_id and legacy_group_id.strip():
   184	        logger.warning(
   185	            "vault_scope: vault_id missing, falling back to deprecated "
   186	            "group_id=%s. Update caller to pass vault_id.",
   187	            legacy_group_id,
   188	        )
   189	        derived = canonical_group_id(legacy_group_id)
   190	        source = "legacy-group"
   191	    else:
   192	        # 契约 3: 双缺失推导 active vault, 不落 DEFAULT_GROUP_ID 污染桶。
   193	        # 二级 (subject_id/canvas_path) 仍透传 — 与 metadata.py G-DEFAULT
   194	        # 根治版行为对齐 (memory.py 版无二级透传, 此处取两者超集)。
   195	        logger.warning(
   196	            "vault_scope: both vault_id and group_id missing, deriving "
   197	            "ACTIVE vault group (fail-closed, no DEFAULT_GROUP_ID fallback)"
   198	        )
   199	        derived = build_vault_group_id(
   200	            active_vault, subject_id=subject_id, canvas_path=canvas_path
   201	        )
   202	        source = "active-vault"
   203	
   204	    _inject(derived)
   205	    return VaultScope(
   206	        group_id=derived,
   207	        vault_id=_vault_segment(derived, active_vault),
   208	        source=source,
   209	    )
   210	
   211	
   212	def resolve_vault_group_id(
   213	    vault_id: Optional[str],
   214	    subject_id: Optional[str] = None,
   215	    canvas_path: Optional[str] = None,
   216	    legacy_group_id: Optional[str] = None,
   217	) -> str:
   218	    """兼容包装 — 与 Wave-5 Stage B 共享 helper 同签名, 返回 group_id str。
   219	
   220	    既有 endpoint 调用面 (共享 ``_vault_id_resolver`` 的 re-export 与原
   221	    5 处本地克隆的替换点) 统一走这里; 语义差异见模块 docstring
   222	    (409 fail-closed + 双缺失推导 active vault)。
   223	    """
   224	    return resolve_vault_scope(
   225	        vault_id,
   226	        subject_id=subject_id,
   227	        canvas_path=canvas_path,
   228	        legacy_group_id=legacy_group_id,
   229	    ).group_id
   230	
   231	
   232	def resolve_hook_cwd_scope(cwd_vault_id: Optional[str]) -> VaultScope:
   233	    """chat.py hook 路径专用 — cwd 推导 vault 的显式合法构造 (契约 5)。
   234	
   235	    与 ``resolve_vault_scope`` 的区别: cwd 推导出的 vault 与进程 active
   236	    vault 不一致**不是**冲突 (hook 会话本来就可能开在另一 vault 目录),
   237	    不做 409; 推导失败 (None) 回落 active vault。
   238	
   239	    Args:
   240	        cwd_vault_id: ``_vault_id_from_hook_cwd`` 的推导结果 (已 sanitize),
   241	            命中 0 或 >1 个 vault 时为 None。
   242	    """
   243	    from app.config import get_current_vault_id
   244	    from app.core.subject_config import build_vault_group_id
   245	
   246	    active_vault = get_current_vault_id()
   247	    # HIGH-10 后半整改: cwd 推导出的是**目录名**。若它只是当前 vault 的
   248	    # 别名 (稳定 ID ≠ 目录名的合法配置), 必须归一到稳定 ID —— 否则同一
   249	    # vault 的 hook 路径与 API 路径写进两个不同的 group, 互相查不到。
   250	    if cwd_vault_id and cwd_vault_id in active_vault_aliases():
   251	        cwd_vault_id = active_vault
   252	    if cwd_vault_id and cwd_vault_id != active_vault:
   253	        logger.info(
   254	            "vault_scope: hook cwd-derived vault %r differs from active %r — "
   255	            "using cwd vault (documented legal exception, no 409)",
   256	            cwd_vault_id,
   257	            active_vault,
   258	        )
   259	    effective = cwd_vault_id or active_vault
   260	    derived = build_vault_group_id(effective)
   261	    _inject(derived)
   262	    return VaultScope(
   263	        group_id=derived,
   264	        vault_id=effective,
   265	        source="hook-cwd" if cwd_vault_id else "active-vault",
   266	    )
   267	
