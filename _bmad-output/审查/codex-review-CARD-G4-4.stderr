   195	def build_group_id(subject: str, canvas_name: Optional[str] = None) -> str:
   196	    """
   197	    Build a group_id for Neo4j/Graphiti memory isolation (Story 1.9 legacy).
   198	
   199	    ⚠️ Story 2.5.Y 推荐使用 build_vault_group_id() 实现统一 vault: 前缀命名.
   200	    本函数保留是为 Story 1.9 backward compatibility (production data 已用此格式).
   201	
   202	    Args:
   203	        subject: Subject name (e.g., "math", "physics")
   204	        canvas_name: Optional canvas name for further isolation
   205	
   206	    Returns:
   207	        Group ID string for memory isolation (e.g., "math" / "math:calc")
   208	    """
   209	    sanitized = sanitize_subject_name(subject)
   210	    if canvas_name:
   211	        return f"{sanitized}:{sanitize_subject_name(canvas_name)}"
   212	    return sanitized
   213	
   214	
   215	def build_vault_group_id(
   216	    vault_id: str,
   217	    subject_id: Optional[str] = None,
   218	    canvas_path: Optional[str] = None,
   219	) -> str:
   220	    """Story 2.5.Y Task 1 + AC #2 — vault: 前缀命名统一 group_id 构造.
   221	
   222	    新统一格式: ``vault:<vault_id>[:<subject_or_canvas>]``
   223	
   224	    与旧 build_group_id 区别:
   225	    - 强制 ``vault:`` 前缀 (区分新旧数据 + Story 2.5.Y 迁移识别)
   226	    - vault_id 是必填主参数 (Story 1.9 的 subject 作为可选二级)
   227	    - subject_id 与 canvas_path 互斥 (优先 subject_id)
   228	
   229	    Args:
   230	        vault_id: Vault stable identifier (必填), 如 "cs_61b" / "数学"
   231	        subject_id: 可选学科二级隔离 (优先级 > canvas_path)
   232	        canvas_path: 可选 canvas/board 名 (subject_id 为空时使用)
   233	
   234	    Returns:
   235	        统一格式 group_id
   236	
   237	    Examples:
   238	        >>> build_vault_group_id("cs_61b")
   239	        'vault:cs_61b'
   240	        >>> build_vault_group_id("cs_61b", subject_id="algorithms")
   241	        'vault:cs_61b:algorithms'
   242	        >>> build_vault_group_id("cs_61b", canvas_path="admissibility")
   243	        'vault:cs_61b:admissibility'
   244	        >>> build_vault_group_id("数学")
   245	        'vault:数学'
   246	
   247	    Raises:
   248	        ValueError: vault_id 为空 (Story 2.5.Y AC #2 强制要求)
   249	    """
   250	    if not vault_id or not vault_id.strip():
   251	        raise ValueError("vault_id is required for Story 2.5.Y vault: prefix isolation")
   252	
   253	    sanitized_vault = sanitize_subject_name(vault_id)
   254	    base = f"vault:{sanitized_vault}"
   255	
   256	    # subject_id 优先于 canvas_path (互斥)
   257	    if subject_id:
   258	        return f"{base}:{sanitize_subject_name(subject_id)}"
   259	    if canvas_path:
   260	        # canvas_path 可能是完整路径, 提取 stem

