   263	async def rag_query(
   264	    request: RAGQueryRequest,
   265	    rag_service: Annotated[RAGService, Depends(get_rag_service)],
   266	) -> RAGQueryResponse:
   267	    """
   268	    执行 RAG 智能检索查询
   269	
   270	    支持的功能:
   271	    - 多源并行检索 (Graphiti + LanceDB + 多模态)
   272	    - 3种融合算法 (RRF, Weighted, Cascade)
   273	    - 混合 Reranking (Local + Cohere)
   274	    - 质量控制与 Query 重写
   275	
   276	    Args:
   277	        request: RAG 查询请求
   278	        rag_service: RAG 服务 (依赖注入)
   279	
   280	    Returns:
   281	        RAGQueryResponse: 检索结果
   282	
   283	    Raises:
   284	        HTTPException 503: RAG 服务不可用
   285	        HTTPException 500: 查询执行失败
   286	    """
   287	    # CARD-G4-3 Codex round-3 HIGH-1: 这条入口日志在主 try **之外**, 它抛错会
   288	    # 让请求直接 500 且 `rag_service.query` 一次都没被调用 —— 观测面又一次成了
   289	    # 业务面的失败源, 而且它在**本卡已修改的文件里**, 不能推给"服务层硬边界外"。
   290	    # 与 log_retrieval_status_decision 同口径: 观测失败最多损失可观测性。
   291	    try:
   292	        logger.info(
   293	            f"RAG query: {request.query[:50]}... subject={request.subject_id} cross={request.cross_subject}"
   294	        )
   295	    except Exception:  # noqa: BLE001 — 观测面刻意兜底
   296	        pass
   297	
   298	    # CARD-G4-4: 每请求恰一次 VaultScope 解析 (chat.py:284-296 范式)。
   299	    # resolve_vault_scope 内部把解析结果注入 ContextVar (group_id, 含
   300	    # subject/canvas 二级), 替代原「subject_id 有值才 set、缺省不注入」的
   301	    # 旁路 —— 本端点从此没有无作用域路径。vault_id 必填由 pydantic 把守
   302	    # (缺 → 422); 请求 vault ≠ 进程 active vault → 409 fail-closed
   303	    # (CARD-G2-2 契约 2), 禁止静默改写作用域。
   304	    _scope = resolve_vault_scope(
   305	        request.vault_id,
   306	        subject_id=request.subject_id,
   307	        canvas_path=request.canvas_file,
   308	    )
   309	    # 与入口日志同口径: 观测失败最多损失可观测性, 不得成为业务失败源
   310	    # (G4-3 round-3 HIGH-1 确立的纪律; 本卡新增日志一律惰性参数)。
   311	    try:
   312	        logger.info(
   313	            "RAG query scope resolved: vault=%s source=%s group=%s",
   314	            _scope.vault_id,
   315	            _scope.source,
   316	            _scope.group_id,
   317	        )
   318	    except Exception:  # noqa: BLE001 — 观测面刻意兜底
   319	        pass
   320	
   321	    try:
   322	        result = await rag_service.query(
   323	            query=request.query,
   324	            canvas_file=request.canvas_file,
   325	            subject_id=request.subject_id,
   326	            cross_subject=request.cross_subject,
   327	            is_review_canvas=request.is_review_canvas,
   328	            fusion_strategy=request.fusion_strategy,
   329	            reranking_strategy=request.reranking_strategy,
   330	        )
   331	
   332	        # 转换结果格式 (Story 35.8: 含multimodal_results)
   333	        # Map LangGraph state keys → response format
   334	        reranked = result.get("reranked_results", result.get("results", []))
   335	
   336	        # CARD-G4-3: 四态纯透传 + 故障态落 trace。
   337	        # 归一与"仅故障态落账"的判断收在 decision_tracker 单点 (memory 端点
   338	        # 共用同一个), 端点这里只负责取值和搬运。
   339	        retrieval_status = result.get("retrieval_status")
   340	        retrieval_status_reason = result.get("retrieval_status_reason")
   341	        log_retrieval_status_decision(
   342	            function="rag_query",
   343	            status=retrieval_status,
   344	            reason=retrieval_status_reason,
   345	            input_summary={
   346	                "query": request.query[:80],
   347	                "subject_id": request.subject_id,
   348	            },
   349	        )
   350	
   351	        return RAGQueryResponse(
   352	            results=[
   353	                SearchResultItem(
   354	                    doc_id=r.get("doc_id", ""),
   355	                    content=r.get("content", ""),
   356	                    score=r.get("score", 0.0),
   357	                    metadata=r.get("metadata", {}),
   358	                )
   359	                for r in reranked
   360	            ],
   361	            multimodal_results=[
   362	                MultimodalResultItem(
   363	                    id=mm.get("id", ""),
   364	                    media_type=mm.get("media_type", "image"),
   365	                    path=mm.get("path", mm.get("file_path", "")),
   366	                    thumbnail=mm.get("thumbnail", mm.get("content_preview")),
   367	                    relevance_score=mm.get("relevance_score", 0.0),
   368	                    metadata=mm.get("metadata", {}),
   369	                )
   370	                for mm in result.get("multimodal_results", [])
   371	            ],
   372	            # CARD-G4-3 Codex round-1 BLOCKER-1: 必须是 `or "low"` 而不是
   373	            # `.get(..., "low")`。rag_service 的**三个** fallback 出口
   374	            # (:216 / :481 / :500) 都显式写 `"quality_grade": None`, 而
   375	            # `.get` 的默认值只在**键缺失**时生效, 键存在且为 None 时原样返回
   376	            # None → 撞上 `quality_grade: str` 的响应模型 → 500。
   377	            # 后果: 所有 retrieval_status="unavailable" 的真实路径都返回 500,
   378	            # 「unavailable 仍 200」这条本卡判据在真实入口上根本不成立
   379	            # (本卡新增测试此前用合成 state 固定给 quality_grade="high",
   380	            # 因此是假绿 —— 已补真实 RAGService 回归门)。
   381	            quality_grade=result.get("quality_grade") or "low",
   382	            result_count=len(reranked),
   383	            latency_ms=LatencyInfo(
   384	                graphiti=result.get("graphiti_latency_ms"),
   385	                lancedb=result.get("lancedb_latency_ms"),
   386	                multimodal=result.get("multimodal_latency_ms"),
   387	                fusion=result.get("fusion_latency_ms"),
   388	                reranking=result.get("reranking_latency_ms"),
   389	            ),
   390	            total_latency_ms=sum(
   391	                v
   392	                for v in [
   393	                    result.get("graphiti_latency_ms", 0),
   394	                    result.get("lancedb_latency_ms", 0),
   395	                    result.get("multimodal_latency_ms", 0),
   396	                    result.get("fusion_latency_ms", 0),
   397	                    result.get("reranking_latency_ms", 0),
   398	                    result.get("vault_notes_latency_ms", 0),
   399	                ]
   400	                if v
   401	            ),
   402	            metadata=RAGQueryMetadata(
   403	                query_rewritten=result.get("query_rewritten", False),
   404	                rewrite_count=result.get("rewrite_count", 0),
   405	                fusion_strategy=result.get("fusion_strategy"),
   406	                reranking_strategy=result.get("reranking_strategy"),
   407	            ),
   408	            retrieval_status=retrieval_status,
   409	            retrieval_status_reason=retrieval_status_reason,
   410	        )
   411	
   412	    except RAGUnavailableError as e:
   413	        logger.error(f"RAG service unavailable: {e}")
   414	        raise HTTPException(status_code=503, detail=str(e)) from e
   415	
   416	    except RAGServiceError as e:
   417	        logger.error(f"RAG query failed: {e}")
   418	        raise HTTPException(status_code=500, detail=str(e)) from e
