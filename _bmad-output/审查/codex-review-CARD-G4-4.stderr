  1777	                        p_mastery=mastery_data.get("p_mastery"),
  1778	                        memory_retention=mastery_data.get("retention"),
  1779	                        has_exam_records=mastery_data.get("has_exam_records", False),
  1780	                        needs_review=mastery_data.get("needs_review", False),
  1781	                    )
  1782	            except Exception as e:
  1783	                # No mastery data available — skip injection
  1784	                logger.warning(f"[compress_context] Mastery data fetch failed: {e}")
  1785	        except Exception as e:
  1786	            logger.debug(f"[compress_context] Mastery injection skipped: {e}")
  1787	
  1788	    # Step 4: Graphiti learning memories
  1789	    learning_memories = ""
  1790	    # CARD-G4-2 (2026-08-28): memory_degraded 收编进 state 字段 —
  1791	    # 下游/外层可区分「注入空 = 没记忆」vs「注入空 = 检索降级」。
  1792	    memory_degraded_signal: Optional[str] = None
  1793	    try:
  1794	        from agentic_rag.mastery_injection import retrieve_learning_memories
  1795	
  1796	        # Try to get graphiti client
  1797	        try:
  1798	            graphiti_client = await _get_graphiti_client()
  1799	            canvas_file = state.get("canvas_file", "") or ""
  1800	            node_hint = canvas_file or query[:30]
  1801	
  1802	            # ⛔ P1-03 (Codex 审查 2026-08-19): 必须传 group_id。
  1803	            # MemoryService._search_graphiti 在 group_id=None 时会**全组检索**
