   336	    # 在其后, 扩展失败无处可记, 检索面收窄对上层完全不可见。
   337	    channel_errors: Dict[str, str] = {}
   338	
   339	    # Story 1.9: Cross-subject expansion via Tag Jaccard bridge
   340	    cross_subject = state.get("cross_subject", False)
   341	    subjects_to_search: List[str] = [subject] if subject else [None]
   342	
   343	    if cross_subject and subject:
   344	        try:
   345	            from app.clients.neo4j_client import get_neo4j_client
   346	            from app.services.cross_subject_bridge import expand_search_subjects
   347	
   348	            neo4j_client = get_neo4j_client()
   349	            if neo4j_client.enabled and neo4j_client._driver:
   350	                subjects_to_search = await expand_search_subjects(
   351	                    current_subject_id=subject,
   352	                    neo4j_driver=neo4j_client._driver,
   353	                    threshold=0.3,
   354	                )
   355	                logger.info(f"[retrieve_lancedb] Cross-subject expansion: {subject} -> {subjects_to_search}")
   356	            else:
   357	                # HIGH-7: 请求要了跨学科但 Neo4j 不可用 = 覆盖面收窄, 不是
   358	                # 「本来就只有这个学科」——如实记为通道降级。
   359	                channel_errors["lancedb_cross_subject"] = (
   360	                    "neo4j unavailable — cross-subject expansion skipped"
   361	                )
   362	        except ImportError as e:
   363	            logger.debug("[retrieve_lancedb] cross_subject_bridge not available, searching current subject only")
   364	            channel_errors["lancedb_cross_subject"] = f"ImportError: {e}"
   365	        except Exception as e:
   366	            logger.warning(f"[retrieve_lancedb] Cross-subject expansion failed, using current subject: {e}")
   367	            channel_errors["lancedb_cross_subject"] = f"{type(e).__name__}: {e}"
   368	
   369	    # ✅ Story 12.2 + Story 2.4: 使用真实LanceDB客户端 with hybrid search
   370	    # Story 2-8 H1+H2: When course_id is present, use progressive_scope_search
   371	    # (4-stage cascading) + expand_neighbors (1-hop wiki-link expansion) to
   372	    # activate previously dead-code functions.
   373	    # HIGH-7: 在 try 之外初始化, 让异常路径能保留已累积的部分结果。
   374	    lancedb_results: List = []
   375	    try:
   376	        client = await _get_lancedb_client()
   377	
   378	        # Story 1.9: Search across all expanded subjects and merge results
   379	        per_subject_limit = max(1, batch_size // len(subjects_to_search))
   380	        for search_subject in subjects_to_search:
   381	            if course_id:
   382	                # Story 2-8: Use progressive_scope_search for course-scoped queries
   383	                subject_results = await client.progressive_scope_search(
   384	                    query=query,
   385	                    course_id=course_id,
   386	                    table_name="vault_notes",
   387	                    num_results=per_subject_limit,
   388	                    min_results_threshold=min_results_threshold,
   389	                    query_type=search_type,
   390	                    subject=search_subject,
   391	                    canvas_file=canvas_file,
   392	                    tag_jaccard_bridge_enabled=True,
   393	                    tag_jaccard_threshold=tag_jaccard_threshold,
   394	                    rrf_k=rrf_k,
   395	                )
   396	            else:
   397	                subject_results = await client.search_multiple_tables(
   398	                    query=query,
   399	                    canvas_file=canvas_file,
   400	                    subject=search_subject,
   401	                    num_results_per_table=per_subject_limit // 2 + 1,
   402	                    query_type=search_type,
   403	                    course_id=course_id,
   404	                    tags=tags,
   405	                    rrf_k=rrf_k,
   406	                )
   407	            lancedb_results.extend(subject_results)
   408	
   409	        # Story 2-8 H2: 1-hop wiki-link neighbor expansion on search results
   410	        lancedb_results = await client.expand_neighbors(
   411	            results=lancedb_results,
   412	            table_name="vault_notes",
   413	            max_neighbors=neighbor_max_count,
   414	            score_decay=neighbor_score_decay,
   415	        )
   416	
   417	        # Deduplicate by doc_id, keeping highest score
   418	        seen_ids: dict = {}
   419	        for r in lancedb_results:
   420	            doc_id = r.get("doc_id", "")
   421	            if doc_id not in seen_ids or r.get("score", 0) > seen_ids[doc_id].get("score", 0):
   422	                seen_ids[doc_id] = r
   423	        lancedb_results = sorted(seen_ids.values(), key=lambda x: x.get("score", 0), reverse=True)
   424	
