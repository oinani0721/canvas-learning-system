    44	def get_current_subject_id() -> str:
    45	    """
    46	    Get the current subject ID from the request context.
    47	
    48	    The subject_id is set per-request via ``set_current_subject_id`` (called
    49	    from the API dependency layer).  Falls back to DEFAULT_SUBJECT_ID when
    50	    no request context is active (e.g. background tasks, CLI).
