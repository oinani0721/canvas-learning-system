   197	    def _get_fallback_result(self, fallback_reason: str = "unknown") -> Dict[str, Any]:
   198	        """
   199	        Return a safe fallback result dict.
   200	
   201	        Story 12.K.2: Ensures RAG queries never return None.
   202	
   203	        Args:
   204	            fallback_reason: Reason for using fallback (for logging/debugging)
   205	
   206	        Returns:
   207	            Dict with empty but valid structure for downstream processing
   208	        """
   209	        logger.warning(f"RAGService: Using fallback result, reason: {fallback_reason}")
   210	        return {
   211	            "messages": [],
   212	            "results": [],
   213	            "reranked_results": [],
   214	            "fused_results": [],
   215	            "multimodal_results": [],
   216	            "quality_grade": None,
   217	            "result_count": 0,
   218	            "total_latency_ms": 0.0,
   219	            "latency_ms": {},
   220	            "metadata": {},
   221	            "fallback_used": True,
   222	            "fallback_reason": fallback_reason,
   223	            # CARD-G4-2 (2026-08-28): 第三个「空结果」出口同样带四态 —
   224	            # 走到这里意味着图执行没能产出状态 (如 ainvoke 返回 None),
   225	            # 空载荷不可信 = unavailable, 不是 empty。
   226	            "retrieval_status": "unavailable",
   227	            "retrieval_status_reason": f"rag fallback: {fallback_reason}",
   228	        }
