   281	# ═══════════════════════════════════════════════════════════════════════════
   282	# 4. 双 vault 隔离行为 — tmp LanceDB 真库
   283	# ═══════════════════════════════════════════════════════════════════════════
   284	
   285	_DIM = 8
   286	
   287	
   288	def _vec(seed: float) -> list:
   289	    """固定向量 — 隔离判据靠表命名空间, 不靠向量相似度。"""
   290	    return [seed] * _DIM
   291	
   292	
   293	def _jieba_tokens(content: str) -> str:
   294	    """与 client FTS 查询侧同一分词器, 保证 content_tokenized 形态一致。"""
   295	    try:
   296	        from agentic_rag.clients.lancedb_client import _jieba_tokenize
   297	
   298	        return _jieba_tokenize(content)
   299	    except Exception:
   300	        return content
   301	
   302	
   303	def _seed_dual_vault_db(tmp_path):
   304	    """同一个 tmp 目录预置 vault_a / vault_b 两张命名空间表。
   305	
   306	    「只有它在 B」笔记 (b_unique) 与 A/B 同名不同内容笔记 (same_name_*)
   307	    是隔离判据的核心; A 表另放干扰行保证正向对照不是查空表。
   308	    """
   309	    import lancedb
   310	
   311	    rows = {
   312	        "vault_a_canvas_nodes": [
   313	            {
   314	                "doc_id": "a_unique",
   315	                "content": "红黑树旋转的颜色翻转规则",
   316	                "vector": _vec(0.10),
   317	                "content_tokenized": _jieba_tokens("红黑树旋转的颜色翻转规则"),
   318	                "canvas_file": "a.canvas",
   319	            },
   320	            {
   321	                "doc_id": "same_name_a",
   322	                "content": "递归的基础定义: 函数调用自身",
   323	                "vector": _vec(0.20),
   324	                "content_tokenized": _jieba_tokens("递归的基础定义: 函数调用自身"),
   325	                "canvas_file": "a.canvas",
   326	            },
   327	        ],
   328	        "vault_b_canvas_nodes": [
   329	            {
   330	                "doc_id": "b_unique",
   331	                "content": "贝尔不等式的量子纠缠判据",
   332	                "vector": _vec(0.10),
   333	                "content_tokenized": _jieba_tokens("贝尔不等式的量子纠缠判据"),
   334	                "canvas_file": "b.canvas",
   335	            },
   336	            {
   337	                "doc_id": "same_name_b",
   338	                "content": "递归的进阶定义: 尾递归优化与调用栈",
   339	                "vector": _vec(0.20),
   340	                "content_tokenized": _jieba_tokens("递归的进阶定义: 尾递归优化与调用栈"),
   341	                "canvas_file": "b.canvas",
   342	            },
   343	        ],
   344	    }
   345	    db = lancedb.connect(str(tmp_path))
   346	    for name, data in rows.items():
   347	        db.create_table(name, data=data)
   348	        try:  # FTS 索引尽力建 — 失败则 hybrid 降级 dense-only, 判据不受影响
   349	            db.open_table(name).create_fts_index("content_tokenized", replace=True)
   350	        except Exception:
   351	            pass
   352	    return db
   353	
   354	
   355	def _make_client(tmp_path):
   356	    """不带 vault override 的 client — 表名完全由 ContextVar 推导 (这是被测行为)。
   357	    跳过 initialize() 的向量模型预载, 手动连 tmp 库。"""
   358	    import lancedb
   359	    from agentic_rag.clients.lancedb_client import LanceDBClient
   360	
   361	    client = LanceDBClient(db_path=str(tmp_path), embedding_dim=_DIM)
   362	    client._db = lancedb.connect(str(tmp_path))
   363	    client._initialized = True
   364	    return client
   365	
   366	
   367	def _run_retrieve_lancedb(monkeypatch, tmp_path, *, vault: str, query: str):
   368	    """以 vault 作用域跑真实 retrieve_lancedb 节点, 返回结果 doc_id/content。"""
   369	    client = _make_client(tmp_path)
   370	    monkeypatch.setattr(
   371	        nodes, "_get_lancedb_client", AsyncMock(return_value=client), raising=True
   372	    )
   373	    monkeypatch.setattr(
   374	        "agentic_rag.clients.lancedb_client.LanceDBClient.embed",
   375	        AsyncMock(return_value=_vec(0.15)),
   376	        raising=True,
   377	    )
   378	
   379	    token = _set_scope(f"vault:{vault}")
   380	    try:
   381	        state = {
   382	            "messages": [{"role": "user", "content": query}],
   383	            "canvas_file": None,
   384	            "subject": None,
   385	            "cross_subject": False,
   386	        }
   387	        update = asyncio.run(nodes.retrieve_lancedb(state, None))
   388	    finally:
   389	        _reset_scope(token)
   390	
   391	    results = update.get("lancedb_results", [])
   392	    return [(r.get("doc_id", ""), r.get("content", "")) for r in results]
   393	
   394	
   395	class TestDualVaultIsolationOnTmpLanceDB:
   396	    @pytest.fixture(autouse=True)
   397	    def _seed_db(self, tmp_path):
   398	        self.db = _seed_dual_vault_db(tmp_path)
   399	        self.tmp_path = tmp_path
   400	
   401	    def test_vault_a_query_has_zero_results_from_b(self, monkeypatch):
   402	        pairs = _run_retrieve_lancedb(
   403	            monkeypatch, self.tmp_path, vault="vault_a", query="贝尔不等式"
   404	        )
   405	        ids = [d for d, _ in pairs]
   406	        assert not any(d.endswith("b_unique") for d in ids), (
   407	            f"vault A 的检索结果混入了 vault B 独有笔记: {pairs} — 跨 vault 泄漏"
   408	        )
   409	        contents = " | ".join(c for _, c in pairs)
   410	        assert "贝尔不等式" not in contents, (
   411	            f"vault A 检索到 B 的内容 (按 doc_id 之外的内容复核): {contents}"
   412	        )
   413	
   414	    def test_vault_a_positive_control_hits_a_unique(self, monkeypatch):
   415	        """正向对照 — 隔离测试环境根本查不出数据时的假绿防线。"""
   416	        pairs = _run_retrieve_lancedb(
   417	            monkeypatch, self.tmp_path, vault="vault_a", query="红黑树"
   418	        )
   419	        ids = [d for d, _ in pairs]
   420	        assert any(d.endswith("a_unique") for d in ids), f"正向对照失败: vault A 没查到自己的笔记 {pairs}"
   421	
   422	    def test_same_name_note_returns_only_vault_a_version(self, monkeypatch):
   423	        """同名不同内容笔记 — 防「全同组 fixture 假绿」: 隔离破了时
   424	        B 表的同名版本会混进结果, content 断言立刻变红。"""
   425	        pairs = _run_retrieve_lancedb(
   426	            monkeypatch, self.tmp_path, vault="vault_a", query="递归"
   427	        )
   428	        contents = [c for _, c in pairs]
   429	        assert any("基础定义" in c for c in contents), (
   430	            f"vault A 没查到自己的同名笔记 {pairs}"
   431	        )
   432	        assert not any("进阶定义" in c for c in contents), (
   433	            f"vault A 的同名笔记检索混入了 vault B 版本: {pairs}"
   434	        )
   435	
   436	    def test_reverse_direction_vault_b_symmetric(self, monkeypatch):
   437	        pairs = _run_retrieve_lancedb(
   438	            monkeypatch, self.tmp_path, vault="vault_b", query="红黑树"
   439	        )
   440	        ids = [d for d, _ in pairs]
   441	        assert not any(d.endswith("a_unique") for d in ids), f"反向泄漏: vault B 查到了 vault A 独有笔记 {pairs}"
   442	
   443	    def test_shared_db_precondition_tables_coexist(self):
   444	        """前置自证: 两张表物理共存于同一个库 — 排除「物理分库所以查不到」
   445	        的平凡隔离, 证明的是命名空间隔离本身。"""
   446	        names = set(self.db.table_names())
   447	        assert {"vault_a_canvas_nodes", "vault_b_canvas_nodes"} <= names

