  1706	        State updates: compressed_context, mastery_prefix, learning_memories, stale_count
  1707	    """
  1708	    start_time = time.perf_counter()
  1709	
  1710	    # Get config
  1711	    max_tokens = _safe_get_config(runtime, "context_max_tokens", 3000)
  1712	    mastery_enabled = _safe_get_config(runtime, "mastery_injection_enabled", True)
  1713	    memory_max_tokens = _safe_get_config(runtime, "learning_memory_max_tokens", 1000)
  1714	    staleness_enabled = _safe_get_config(runtime, "staleness_check_enabled", True)
  1715	
