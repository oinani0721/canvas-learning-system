   303	def _seed_dual_vault_db(tmp_path):
   304	    """同一个 tmp 目录预置 vault_a / vault_b 两张命名空间表。
   305	
   306	    「只有它在 B」笔记 (b_unique) 与 A/B 同名不同内容笔记 (same_name_*)
   307	    是隔离判据的核心; A 表另放干扰行保证正向对照不是查空表。
   308	    """
   309	    import lancedb
   310	
   311	    rows = {
   312	        "vault_a_canvas_nodes": [
   313	            {
   314	                "doc_id": "a_unique",
   315	                "content": "红黑树旋转的颜色翻转规则",
   316	                "vector": _vec(0.10),
   317	                "content_tokenized": _jieba_tokens("红黑树旋转的颜色翻转规则"),
   318	                "canvas_file": "a.canvas",
   319	            },
   320	            {
   321	                "doc_id": "same_name_a",
   322	                "content": "递归的基础定义: 函数调用自身",
   323	                "vector": _vec(0.20),
   324	                "content_tokenized": _jieba_tokens("递归的基础定义: 函数调用自身"),
   325	                "canvas_file": "a.canvas",
   326	            },
   327	        ],
   328	        "vault_b_canvas_nodes": [
   329	            {
   330	                "doc_id": "b_unique",
   331	                "content": "贝尔不等式的量子纠缠判据",
   332	                "vector": _vec(0.10),
   333	                "content_tokenized": _jieba_tokens("贝尔不等式的量子纠缠判据"),
   334	                "canvas_file": "b.canvas",
   335	            },
   336	            {
   337	                "doc_id": "same_name_b",
   338	                "content": "递归的进阶定义: 尾递归优化与调用栈",
   339	                "vector": _vec(0.20),
   340	                "content_tokenized": _jieba_tokens("递归的进阶定义: 尾递归优化与调用栈"),
   341	                "canvas_file": "b.canvas",
   342	            },
   343	        ],
   344	    }
   345	    db = lancedb.connect(str(tmp_path))
   346	    for name, data in rows.items():
   347	        db.create_table(name, data=data)
   348	        try:  # FTS 索引尽力建 — 失败则 hybrid 降级 dense-only, 判据不受影响
   349	            db.open_table(name).create_fts_index("content_tokenized", replace=True)
   350	        except Exception:
   351	            pass
   352	    return db
