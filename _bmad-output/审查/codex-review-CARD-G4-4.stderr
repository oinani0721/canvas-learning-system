    55	def set_current_subject_id(subject_id: str) -> None:
    56	    """
    57	    Set the subject_id for the current request context.
    58	
    59	    Called by the FastAPI dependency ``resolve_subject_id`` so that any
    60	    downstream service can retrieve it via ``get_current_subject_id()``.
