   723	        if mo:
   724	            old = float(mo.group(1)); break
   725	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   726	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   727	    if ma and mb:
   728	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   729	    elif old is not None:
   730	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   731	    else:
