  1334	def _validate_review_ext(
  1335	    payload: dict, record: dict, manifest: Optional[dict], vault_id: Optional[str] = None
  1336	) -> tuple[list[str], list[str]]:
  1337	    """§六 复习域扩展行 (payload.schema_ext == 'review/1') 的完整语义校验。
  1338	
  1339	    → (violations, warnings)
  1340	
  1341	    绑定面 (round-2 HIGH + round-3 HIGH):
  1342	      - 挂载点: 只许 answer_scored / answer_abandoned (曾可挂 session_archived);
  1343	      - 身份: concept_id == 顶层 node_id;
  1344	      - 时刻: review_time 与 effective_at 同一瞬间 (Z/+00:00 语义比较),
  1345	        且**必须整秒** — W (fsrs_last_review) 只有整秒精度, 小数秒会让
  1346	        同一事件恒满足 `> W` 而二次推进 (round-3 BLOCKER, §6.2 A5);
  1347	      - 评分自洽: grade_norm ∈ [0,1] 必填; answer_scored 的 rating 必须等于
  1348	        rating_from_grade(grade_norm); answer_abandoned 的 rating 恒为 1
  1349	        ([Decision-FSRS-1] 弃答一票否决 Again);
  1350	      - 库指纹: 非降级时须与 G3-4 golden manifest 的 library_version/
  1351	        params_hash **真值相等** (manifest 不可达时降级为形状校验 + WARN);
  1352	        degraded 哨兵成对且原因非空。
  1353	    """
  1354	    problems: list[str] = []
  1355	    warnings: list[str] = []
  1356	
  1357	    event_type = record.get("event_type")
  1358	    if event_type not in REVIEW_EVENT_TYPES:
  1359	        problems.append(
  1360	            f"schema_ext='{REVIEW_EXT_MARKER}' 只许挂在 {sorted(REVIEW_EVENT_TYPES)} 上, 实为 {event_type!r}"
  1361	        )
  1362	
  1363	    rating = payload.get("rating")
