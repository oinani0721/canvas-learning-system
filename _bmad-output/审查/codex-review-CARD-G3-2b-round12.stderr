   131	def _write_ledger(vault: Path, *rows, trailing_lf=True):
   132	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
   133	    if not trailing_lf and text.endswith("\n"):
   134	        text = text[:-1]
   135	    (vault / "learning_events.jsonl").write_text(text, encoding="utf-8")
