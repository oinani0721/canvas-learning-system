  1372	            "未标乱序时不得写该键 (§6.2 字段冻结: false/字符串/对象均会让 pending 排除条件产生歧义)"
  1373	        )
  1374	
  1375	    review_time = payload.get("review_time")
  1376	    ok, why = _parse_ts(review_time, upper_bound=REVIEW_INPUT_MAX)
  1377	    if not ok:
  1378	        problems.append(f"扩展键 review_time {why}")
  1379	    else:
  1380	        if _SUBSECOND_RE.match(review_time):
  1381	            problems.append(
  1382	                f"扩展键 review_time 必须为整秒 {review_time!r} — frontmatter 水位线 "
  1383	                "fsrs_last_review 只有整秒精度 (§6.2 A5), 小数秒会导致同一事件二次推进"
  1384	            )
  1385	        elif not _WHOLE_SECOND_RE.match(review_time):
  1386	            problems.append(
  1387	                f"扩展键 review_time 必须为完整整秒形态 YYYY-MM-DDTHH:MM:SS(Z|±HH:MM), "
  1388	                f"实为 {review_time!r} — 省略秒段与 W 的整秒口径对不齐 (§6.2 A5)"
  1389	            )
  1390	        left, right = _instant(review_time), _instant(record.get("effective_at"))
  1391	        if left is None or right is None or left != right:
  1392	            problems.append(
  1393	                f"扩展键 review_time {review_time!r} 与顶层 effective_at "
