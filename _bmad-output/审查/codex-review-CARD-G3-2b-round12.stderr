   712	# 正常路径用 payload ts, 恢复路径用 durable 行 review_time — 保证恢复产物与
   713	# 直接应用逐字节对齐 (Codex round-2 HIGH: 卡文门②要求字节等值)。
   714	sys.path.insert(0, os.path.join(VAULT, ".claude", "scripts"))
   715	from decay_beta import PRIOR_A, PRIOR_B, from_legacy, mu, update_after_idle
   716	
   717	def _apply_mastery(fm_text, biz_ts, gn=None):
   718	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   719	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   720	    old = None
   721	    for key in ("mastery_score", "mastery", "mastery_level"):
   722	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   723	        if mo:
   724	            old = float(mo.group(1)); break
   725	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   726	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   727	    if ma and mb:
   728	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   729	    elif old is not None:
   730	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   731	    else:
   732	        a_, b_ = PRIOR_A, PRIOR_B
   733	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   734	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   735	    days_idle = 0.0
   736	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   737	    if mle:
   738	        try:
   739	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   740	        except ValueError:
   741	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   742	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   743	    # 用 GN2 而非 GN (内部对抗审查 MEDIUM): durable payload 锁的是 round(GN,2),
   744	    # 而 mastery 若用未舍入的 GN, 同一个 durable 事件在「首跑 gn=0.752」与
   745	    # 「恢复重试 gn=0.7549」两次下会算出不同的 mastery_a —— envelope 判它们
   746	    # 同一件事(两侧 GN2 都是 0.75), 产物却不同。业务量恒取账本锁住的那个值。
   747	    # gn=None ⇒ 用本次评分的 GN2; A2 重放别人的事件时传那行 durable 的 grade_norm。
   748	    a_, b_ = update_after_idle(a_, b_, GN2 if gn is None else float(gn), days_idle)
   749	    return old, a_, b_, round(mu(a_, b_), 2)
   750	
   751	# ── G3-2 三态判别 (复用校验器 classify_card_state, schema §6.2)。
   752	# degraded(残缺卡) → fail-closed: 报错、零写节点、检验白板停在
   753	# scored_pending_node_update 续跑态 (裁决③)。
   754	_fields = fields_from_frontmatter(fm)
   755	_state, _reason = classify_card_state(_fields)
   756	if _state == "degraded":
   757	    raise SystemExit(f"[quiz-answer] 节点调度状态残缺 (classify_card_state: {_reason}), fail-closed 拒写 — 请人工修复 {NODE} 后重跑")
   758	W = _fields.get("fsrs_last_review")
   759	W_inst = _aware(W) if W else None
