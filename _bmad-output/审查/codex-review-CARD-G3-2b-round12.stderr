   526	def _fm_has_event(fm_text, ev_id):
   527	    """F1 判定: calibration_log 里有没有这个 event_id。
   528	
   529	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   530	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   531	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   532	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   533	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   534	
   535	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   536	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   537	    是「有总比没有强」的降级, 出现即告警。
   538	    """
   539	    try:
   540	        import yaml  # F1 判定
   541	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   542	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   543	        if isinstance(_doc, dict):
   544	            _cal = _doc.get("calibration_log")
   545	            if isinstance(_cal, list):
   546	                return any(
   547	                    isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id
   548	                    for _e in _cal
   549	                )
   550	            return False        # null / 标量 / 缺失 ⇒ 没有任何条目
   551	    except ImportError:
   552	        print("[quiz-answer] ⚠️ PyYAML 不可用 — F1 判定退回正则扫描, 只认 block list + `- event_id:` 开头的条目; 尾注释/inline/键顺序变体会假阴性")
   553	    except Exception as _ye:
   554	        raise SystemExit(f"[quiz-answer] frontmatter 的 calibration_log 不是合法 YAML ({_ye}) — F1 判定不可证, fail-closed 拒写 — 请人工修复 {NODE}")
   555	    mcal = re.search(r'^calibration_log:[ \t]*(?:#[^\n]*)?$', fm_text, re.M)
   556	    if not mcal:
   557	        return False
   558	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   559	        if ln and not ln[0].isspace():
   560	            break

