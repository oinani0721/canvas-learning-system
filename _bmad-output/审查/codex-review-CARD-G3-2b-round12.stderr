  3456	def test_round11_writeback_by_parse_result(vault):
  3457	    """写回**按解析结果**重建，不用正则猜结构（round-11 HIGH）。
  3458	
  3459	    ⛔ 前两版都试图用文本特征判断形态（「header 行干净」「条目以两空格开头」），
  3460	    每次都有合法写法不符合特征：一空格缩进的列表、quoted key。
  3461	    **判据要挂在解析结果上，而不是文本外观上。**
  3462	    """
  3463	    import yaml
  3464	
  3465	    LED = vault / "learning_events.jsonl"
  3466	
  3467	    def _parsed():
  3468	        t = (vault / NODE_REL).read_text(encoding="utf-8")
  3469	        m = re.match(r"^---\n(.*?)\n---", t, re.S)
  3470	        return yaml.safe_load(m.group(1)), t
  3471	
  3472	    # ① 一空格缩进的列表（PyYAML 照样解析成 list）
  3473	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3474	    LED.unlink(missing_ok=True)
  3475	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  3476	    t = (vault / NODE_REL).read_text(encoding="utf-8")
  3477	    t2 = re.sub(r"^  - event_id:", " - event_id:", t, count=1, flags=re.M)
  3478	    t2 = re.sub(
  3479	        r"^    (ts|scored_at|attempt_count|exam_board|question_id|self_confidence_raw|self_confidence_norm|grade_norm|abandoned):",
  3480	        r"   \1:",
  3481	        t2,
  3482	        flags=re.M,
  3483	    )
  3484	    assert t2 != t, "预置必须真的改成一空格缩进"
  3485	    (vault / NODE_REL).write_text(t2, encoding="utf-8")
  3486	    n0 = len(_ledger_lines(vault))
  3487	    ri = _run_writer_settled(
  3488	        vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z")
  3489	    )
  3490	    d, after = _parsed()
  3491	    assert isinstance(d, dict), f"产物必须是合法 YAML（此前账本已增行才写坏）: {after[:300]}"
  3492	    if ri.returncode == 0:
  3493	        assert len(d["calibration_log"]) == 2, f"条目须正确追加: {d['calibration_log']}"
  3494	    else:
  3495	        assert len(_ledger_lines(vault)) == n0, "拒绝时必须零写"
  3496	
  3497	    # ② quoted key：不得产出两个语义相同的键
  3498	    (vault / NODE_REL).write_text(
  3499	        NODE_V0.replace("mastery_score:", '"calibration_log": []\nmastery_score:', 1), encoding="utf-8"
  3500	    )
  3501	    LED.unlink(missing_ok=True)
  3502	    rq = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3503	    assert rq.returncode == 0, rq.stderr[:300]
  3504	    d2, after2 = _parsed()
  3505	    assert isinstance(d2, dict), after2[:300]
  3506	    nq = after2.count('"calibration_log"') + len(re.findall(r"^calibration_log:", after2, re.M))
  3507	    assert nq == 1, f"不得同时出现 quoted 与 bare 两个语义相同的键: {after2[:400]}"
  3508	    assert len(d2["calibration_log"]) == 1, d2["calibration_log"]
  3509	
  3510	    # 验伪：正常 block 形态不得回归
  3511	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3512	    LED.unlink(missing_ok=True)
  3513	    for eid, ts in (("板A#q1", TS1), ("板B#q1", "2026-08-02T10:00:00Z")):
  3514	        assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts, review_time=ts)).returncode == 0
  3515	    d3, _ = _parsed()
  3516	    assert len(d3["calibration_log"]) == 2, d3["calibration_log"]
  3517	
