   347	class _DupKey(Exception):
   348	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   349	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   350	
   351	
   352	def _no_dup_keys(pairs):
   353	    _seen = set()
   354	    for _k, _ in pairs:
   355	        if _k in _seen:
   356	            raise _DupKey(repr(_k))
   357	        _seen.add(_k)
   358	    return dict(pairs)
