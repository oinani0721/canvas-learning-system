   381	def _cands_and_sources(fm_text, ev_id, all_ledger_ids=()):
   382	    """校准 token 的候选集 + 来源反查 —— **唯一实现**, 两个调用点共用。
   383	
   384	    ⛔ 为什么必须抽出来 (变异 M53/M72 存活暴露): round-11 把 receipt 验证统一到
   385	    `_resolve_receipt` 时, 这段「候选 + 反查」在 `_fm_has_event_compat` 里**还留着
   386	    一份副本**, 而且两份的成功条件**已经分叉** ——
   387	      · `_resolve_receipt`:      `_sources != {ev_id}` ⇒ 拒 (空集也不可证, B②)
   388	      · `_fm_has_event_compat`:  `if _sources and ...` ⇒ **空集放行**
   389	    也就是说 round-11 那条 BLOCKER 只修了一份。这正是它自己要根治的「修一半」:
   390	    抽了函数却没让所有调用点都用, 下次改判据仍要改两处。
   391	
   392	    返回 (候选 token 列表, 来源 id 集合)。**不**做放行/拒绝裁决 —— 两个调用点的
   393	    严格度差异是**有意的**(见各自 docstring), 由它们各自声明, 而不是靠这里分叉。
   394	    """
   395	    _cands = []
   396	    if _fm_has_event(fm_text, ev_id):
   397	        _cands.append(ev_id)
   398	    _bare = ev_id[5:] if ev_id.startswith("quiz:") else None
   399	    if _bare is not None and _fm_has_event(fm_text, _bare):
   400	        _cands.append(_bare)
   401	    # 反查: 每个账本 id 贡献「完整」token; 带 `quiz:` 前缀的再贡献「历史裸」token。
   402	    _sources = set()
   403	    for _tok in _cands:
   404	        for _lid in all_ledger_ids:
   405	            if _lid == _tok or (_lid.startswith("quiz:") and _lid[5:] == _tok):
   406	                _sources.add(_lid)
   407	    _sources.discard("")
   408	    return (_cands, _sources)
   409	
   410	
   411	def _resolve_receipt(fm_text, ev_id, all_ledger_ids=(), row=None, facts=None, require_source=True):
   412	    """**唯一**的 receipt 解析 + 事实校验入口 (Codex round-11 BLOCKER/HIGH)。
   413	
   414	    ⛔ 为什么必须统一: 此前 receipt 验证散落在**六处**、严格度各不相同 ——
   415	    dup 路径比六项、F1-only 比两项、foreign replay 只看「ID 在不在」(布尔)。
   416	    于是同一份 receipt 在不同分支得到不同结论: 实测把 durable 的采用时刻改掉
   417	    (保留 scored_at 与 receipt), foreign replay 照常「恢复」E1 ⇒ **state 1→2、
   418	    stability 2.31→7.32、同一次评分被算了两遍**; 把 receipt 的 attempt 改成 999
   419	    也照样称「事实一致」。
   420	    这正是 round-10「修一半」那条教训的下一层: **抽出统一函数, 让分歧不可能存在**。
   421	
   422	    返回 (receipt, 唯一来源 id)。任何不可证的情形一律 raise SystemExit。
   423	
   424	    facts: 要逐项核对的事实字典; None 表示只解析不校验事实(仍做来源唯一性证明)。
   425	    row:   对应的账本行; 给出时额外强制「三方同瞬间」(ledger effective_at /
   426	           payload.review_time / receipt ts)。
   427	    """
   428	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   429	    if not _cands:
   430	        return (None, None)          # 没有 receipt —— 由调用方决定这是否可接受
   431	    # ⛔ 成功条件是 `_sources == {ev_id}` —— **空集同样不可证** (round-11 BLOCKER):
   432	    # 账本缺失时来源集合为空, 上一版把它当「唯一」放行 ⇒ 实测另一个完整 id 的评分
   433	    # 被静默吞掉 (rc=0、账本 0 字节、attempt 不变)。
   434	    # ⚠️ `require_source=False` 用于**账本行本就丢失**的分支 (F1-only): 那里
   435	    # 来源集合必然为空, 强制它等于 {ev_id} 就是「要求证明一个前提上不存在的
   436	    # 东西」。⛔ 统一函数不等于所有调用点参数相同 —— 共用逻辑的同时, 每个
   437	    # 调用点要声明它能提供什么证据。
