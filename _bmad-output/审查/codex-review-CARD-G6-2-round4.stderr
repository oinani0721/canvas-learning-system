   303	#: 沙箱 boot 器: node_harness fixture 生成 boot.mjs, 测试文件导入它执行
   304	#: page-script.js (响应里的真实 <script> 原文) 并导出沙箱作用域的函数。
   305	_BOOT_MJS = r"""
   306	import fs from "node:fs";
   307	
   308	const SRC = fs.readFileSync(new URL("./page-script.js", import.meta.url), "utf8");
   309	
   310	export function mkNode(id) {
   311	  const node = {
   312	    id, innerHTML: "", textContent: "", hidden: false, className: "", disabled: false,
   313	    _attrs: {}, _desc: null, parentElement: null,
   314	    setAttribute(k, v) { node._attrs[k] = String(v); },
   315	    getAttribute(k) { return node._attrs[k] ?? null; },
   316	    addEventListener() {},
   317	    querySelector() { return null; },
   318	    querySelectorAll() { return []; },
   319	  };
   320	  return node;
   321	}
   322	
   323	export function matches(node, sel) {
   324	  if (sel === "[data-refresh-vault]") return node._attrs["data-refresh-vault"] !== undefined;
   325	  if (sel === "[data-note-for]") return node._attrs["data-note-for"] !== undefined;
   326	  return false;
   327	}
   328	
   329	export const flush = () => new Promise(r => setTimeout(r, 0));
   330	
   331	export function boot({getJson, postJson, hidden = false} = {}) {
   332	  const els = {};
   333	  const handlers = {};
   334	  const timers = [];
   335	  const calls = {get: 0, post: 0};
   336	  function makeEl(id) {
   337	    const node = mkNode(id);
   338	    node.addEventListener = (t, fn) => { handlers[id + "::" + t] = fn; };
   339	    node.querySelectorAll = sel => (node._desc || []).filter(n => matches(n, sel));
   340	    return node;
   341	  }
   342	  const documentStub = {
   343	    hidden,
   344	    getElementById: id => (els[id] ??= makeEl(id)),
   345	    addEventListener: (t, fn) => { handlers["document::" + t] = fn; },
   346	  };
   347	  const fetchStub = async (url, opts = {}) => {
   348	    if (opts && opts.method === "POST") {
   349	      calls.post += 1;
   350	      const h = typeof postJson === "function" ? postJson(url, opts) : postJson;
   351	      return h === undefined || h === null ? {ok: false, status: 0, json: async () => null} : h;
   352	    }
   353	    calls.get += 1;
   354	    const h = typeof getJson === "function" ? getJson(url) : getJson;
   355	    return h === undefined || h === null ? {ok: false, status: 0, json: async () => null} : h;
   356	  };
   357	  const sandbox = new Function(
   358	    "document", "fetch", "setTimeout", "clearTimeout",
   359	    SRC +
   360	    "\n;return {esc, shDay, parseDueMs, humanizeDue, computePollDelayMs, visibilityAction," +
   361	    " boardLink, nodeLink, nodeDetailHtml, boardTableHtml, restDayHtml, renderVaultCard," +
   362	    " renderPage, renderUnavailableBanner, renderRefreshResult, freshNotes};"
   363	  );
   364	  const api = sandbox(
   365	    documentStub, fetchStub,
   366	    (fn, ms) => { timers.push({fn, ms}); return timers.length; },
   367	    () => {},
   368	  );
   369	  return {api, els, handlers, timers, calls, document: documentStub};
   370	}
   371	"""
   372	
   373	
   374	def _group(pattern: str, text: str, flags: int = 0) -> str:
   375	    """re.search().group(1) 的非 None 断言版 — pyright 严格模式友好。"""
   376	    m = re.search(pattern, text, flags)
   377	    assert m is not None, f"模式未命中: {pattern!r}"
   378	    return m.group(1)
   379	
   380	
   381	def _extract_script(html: str) -> str:
   382	    """从实际响应体取出**整个** <script> 原文 — 且必须与浏览器 tokenizer 同源。
   383	
   384	    HTML 解析对 script 结束符**大小写不敏感**、正文里出现注释开合也会改变
   385	    解析状态 (round-2 HIGH-3 实证: `// </SCRIPT>` 后的"好代码"能骗过大小写
   386	    敏感的正则, 但浏览器根本不会执行它)。所以除定位外, 还要拒绝一切会让
   387	    「正则提取的字节」与「浏览器执行的字节」分叉的序列。
   388	    """
   389	    # 开标签: 大小写不敏感地只允许一个, 且必须恰是字面 <script> (无属性)
   390	    openings = re.findall(r"<script\b[^>]*>", html, flags=re.I)
   391	    assert openings == ["<script>"], f"script 开标签形态变了: {openings!r}"
   392	    _prefix, sep, rest = html.partition("<script>")
   393	    assert sep, "script 开标签未命中"
   394	    # 结束符**总数**恰为 1 (大小写不敏感) — 正文任何位置多出结束符 (哪怕在
   395	    # JS 注释里), 浏览器都会在那里提前终止脚本; maxsplit 截断式提取会把它
   396	    # 当切割点吞掉, 那道门就是死的 (round-3 自查), 数段数才漏不掉。
   397	    # round-3 HIGH-3: 浏览器结束标签语言还接受 solidus 分隔 (`</script/`) 与
   398	    # 携带属性 (`</script x=y>`) — `</script\s*>` 数不到这些形态。fail-closed
   399	    # 升级为数 `</script` 前缀总出现次数 (多一个即红, 不猜后续字符)
   400	    hits = re.findall(r"</script", rest, flags=re.I)
   401	    assert len(hits) == 1, f"script 结束前缀出现 {len(hits)} 次 (应恰 1) — 浏览器会在正文处提前终止"
   402	    src = re.split(r"</script", rest, maxsplit=1, flags=re.I)[0]
   403	    # 正文分叉面: HTML 注释开合改变 tokenizer 状态 (script data escaped)
   404	    assert "<!--" not in src and "-->" not in src, "script 正文含 HTML 注释开合 — tokenizer 状态分叉面"
   405	    assert "__URLS_JSON__" not in src, "占位符没被替换 — 页面发出去的是模板本身"
   406	    return src
   407	
