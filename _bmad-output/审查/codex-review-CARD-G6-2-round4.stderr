   394	      : '<span class="rnote warn">⚠ 已重建（本进程累计 ' + esc(n.count) +
   395	        ' 次）· 数字同步失败，后端恢复后自动重试</span>', atMs: nowMs};
   396	    if (!applyNote(vid) && state.lastData) renderCards(nowMs);
   397	  }
   398	}
   399	function schedule(ms) {
   400	  clearTimeout(state.timer);
   401	  state.timer = null;
   402	  if (document.hidden) { el("nextpoll").textContent = "已暂停（页面隐藏）"; return; }
   403	  state.timer = setTimeout(poll, ms);
   404	  el("nextpoll").textContent = "下次自动刷新 ~" + Math.round(ms / 1000) + " 秒后";
   405	}
   406	async function poll() {
   407	  let delay = RETRY_DELAY_MS;
   408	  const gen = ++state.pollGen;  // 代际: 只有最新一次 GET 可以提交状态 (乱序旧响应整包丢弃)
   409	  try {
   410	    const resp = await fetch(URLS.overview, {cache: "no-store"});
   411	    if (!resp.ok) throw new Error("HTTP " + resp.status);
   412	    const data = await resp.json();
