   707	        }
   708	        for b, g in groups.items()
   709	    ]
   710	    board_rows.sort(key=lambda r: (prio.get(r["board"], len(prio)), -r["due"], r["board"]))
   711	    if rollup_zero is not None:
   712	        zero_rows = [
   713	            {
   714	                "board": z["board"],
   715	                "due": 0,
   716	                "due_new": 0,
   717	                "placeholder": ph_map.get(z["board"]),
   718	                # next_due 空串 = 无未来排期 (占位符专属板) → 无数据 "—"
   719	                "earliest": z["next_due"] or None,
   720	                "nodes": [],  # 零到期板没有到期节点可展开 (未来节点不在 due_nodes 里)
   721	            }
   722	            for z in rollup_zero
   723	            if z["board"] not in groups  # 防御: 同板双列时到期行为准
   724	        ]
   725	        zero_rows.sort(key=lambda r: (r["earliest"] is None, r["earliest"] or "", r["board"]))
   726	    else:
   727	        zero_rows = [
   728	            {
   729	                "board": u["board"],
   730	                "due": 0,
   731	                "due_new": 0,
   732	                "placeholder": None,
   733	                "earliest": u["next_due"],
   734	                "nodes": [],
