   491	
   492	@review_app_router.get(
   493	    "/overview/app",
   494	    response_class=HTMLResponse,
   495	    summary="跨 vault 复习总览 · 交互版 (CARD-G6-2; 单文件内联 HTML, 零外部 URL)",
   496	)
   497	async def review_overview_app(request: Request) -> HTMLResponse:
   498	    """交互复习壳: 自动轮询 GET /overview, 手动按钮 POST /overview/refresh。
   499	
   500	    与零 JS 只读页 (/overview/page) 共存。API 路径按本次请求的路由表注入
   501	    (url_for), 不硬编码。
   502	    """
   503	    urls = {
   504	        "overview": request.url_for("review_overview").path,
   505	        "refresh": request.url_for("review_overview_refresh").path,
   506	    }
   507	    page = (
   508	        _PAGE_TEMPLATE.replace("__URLS_JSON__", _js_json(urls))
   509	        .replace("__STATUS_META_JSON__", _js_json({k: list(v) for k, v in _STATUS_META.items()}))
   510	        .replace("__BUCKET_CN_JSON__", _js_json(_BUCKET_CN))
   511	        .replace("__BUCKET_ORDER_JSON__", _js_json(list(_BUCKET_ORDER)))
   512	    )
   513	    return HTMLResponse(content=page)

