   412	    if not _NODE:
   413	        pytest.fail(
   414	            "node 不可用 — 本文件 10+ 道 JS 门禁止静默 skip 假绿 (Codex round-1 "
   415	            "HIGH-2 fail-closed); 本环境必须装 node, 或实现卡文默认裁决④的 "
   416	            "Python 解析 fallback 后再改本门"
   417	        )
