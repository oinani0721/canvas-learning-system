   340	  return '<span class="rnote err">❌ 刷新失败（HTTP ' + esc(status) + "）" + (detail ? "：" + esc(detail) : "") + "</span>";
   341	}
   342	
   343	// ═══ 副作用壳: 只消费上面纯函数的返回值 ═══
   344	const state = {timer: null, lastOkAt: null, lastData: null, pollGen: 0,
