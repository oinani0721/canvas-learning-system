import ast

ALLOWED_IMPORTS = {
    '__future__.annotations', 'json', 'fastapi.APIRouter', 'fastapi.Request',
    'fastapi.responses.HTMLResponse',
    'app.api.v1.endpoints.review_overview._BUCKET_CN',
    'app.api.v1.endpoints.review_overview._BUCKET_ORDER',
    'app.api.v1.endpoints.review_overview._STATUS_META',
}
ALLOWED_CALL_NAMES = {'APIRouter', 'list', '_js_json', 'HTMLResponse'}
ALLOWED_CALL_ATTRS = {'get', 'replace', 'url_for', 'dumps', 'items'}
ALLOWED_RECEIVERS = {'json', 'request', 'review_app_router', '_STATUS_META', '_PAGE_TEMPLATE'}

def gate(src):
    tree = ast.parse(src)
    collected = set()
    errors = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            collected.update(a.name for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            mod = node.module or ''
            collected.update(f'{mod}.{a.name}' if mod else a.name for a in node.names)
    if collected - ALLOWED_IMPORTS:
        errors.append('import')
    for node in ast.walk(tree):
        if isinstance(node, (ast.Assign, ast.AugAssign, ast.AnnAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            for tgt in targets:
                if isinstance(tgt, ast.Name) and tgt.id in ALLOWED_CALL_NAMES:
                    errors.append('rebind')
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            for arg in node.args.args + node.args.kwonlyargs:
                if arg.arg in ALLOWED_CALL_NAMES:
                    errors.append('shadow')
        if isinstance(node, ast.Call):
            f = node.func
            if isinstance(f, ast.Name):
                if f.id not in ALLOWED_CALL_NAMES:
                    errors.append('call-name')
            elif isinstance(f, ast.Attribute):
                if f.attr not in ALLOWED_CALL_ATTRS:
                    errors.append('call-attr')
                recv_base = ast.unparse(f.value).split('(', 1)[0]
                if not (recv_base in ALLOWED_RECEIVERS or isinstance(f.value, ast.Call)):
                    errors.append('receiver')
            else:
                errors.append('call-shape')
    return 'PASS' if not errors else 'REJECT:' + ','.join(errors)

cases = {
    'tuple_target_rebind': 'list, marker = (str, None)\\nlist(\"x\")',
