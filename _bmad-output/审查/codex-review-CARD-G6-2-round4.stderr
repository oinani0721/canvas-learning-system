   377	  }
   378	  return out;
   379	}
   380	function renderCards(nowMs) {
   381	  el("cards").innerHTML = renderPage(state.lastData, nowMs, freshNotes(nowMs), state.inflight);
   382	}
   383	function settlePendingSync(nowMs, ok, renderedVids) {
   384	  // rebuilt 只发"正在同步…"；数字是否真更新, 由 GET 成败结算 (round-2 HIGH-1)。
   385	  // round-3 HIGH-1 收紧: 成功结算必须**绑定证据** — renderedVids 里要有该库、
