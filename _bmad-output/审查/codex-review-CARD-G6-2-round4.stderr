   304	    '<span class="badge" style="background:' + meta[1] + '">' + esc(meta[0]) + "</span></div>" + body +
   305	    '<div class="actions"><button class="btn"' + (isInflight ? " disabled" : "") +
   306	    ' data-refresh-vault="' + esc(vid) + '">🔄 刷新投影</button>' +
   307	    '<span class="rnote" data-note-for="' + esc(vid) + '">' + (noteHtml || "") + "</span></div></div>";
   308	}
