   426	    }
   427	    state.lastData = data;
   428	    settlePendingSync(nowMs, true, renderedVids);
   429	    el("cards").innerHTML = renderPage(data, nowMs, freshNotes(nowMs), state.inflight);
   430	    el("banner").hidden = true;
   431	    state.lastOkAt = nowMs;
   432	    el("updated").textContent = "上次更新 " + fmtClock(nowMs);
