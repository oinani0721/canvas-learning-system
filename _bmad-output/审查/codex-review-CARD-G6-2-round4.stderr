   696	            raise ValueError("buckets 在场但 boards 缺席 — 非生产器产物 (二者同版一起落盘)")
   697	        bucket_counts = _gate_buckets(payload["buckets"], groups, stats, generated_at, future_map, up_gated)
   698	    board_rows = [
   699	        {
   700	            "board": b,
   701	            "due": g["due"],
   702	            "due_new": g["new"],
   703	            "placeholder": ph_map.get(b),
   704	            "earliest": g["earliest"],
   705	            # CARD-G6-4 加性: 板内到期节点明细 (纯消费既有 due_nodes 行, 零 schema 改动)
