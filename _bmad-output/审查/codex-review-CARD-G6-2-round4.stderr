   479	  } finally {
   480	    delete state.inflight[vid];
   481	    for (const b of vaultButtons(vid)) b.disabled = false;
   482	  }
   483	}
   484	el("cards").addEventListener("click", onRefreshClick);
   485	poll();
   486	</script>
   487	</body>
   488	</html>
