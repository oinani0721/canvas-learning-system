   362	}
   363	function applyNote(vid) {
   364	  const n = state.notes[vid];
   365	  if (!n) return false;
   366	  let patched = false;
   367	  for (const span of el("cards").querySelectorAll("[data-note-for]")) {
   368	    if (span.getAttribute("data-note-for") === vid) { span.innerHTML = n.html; patched = true; }
