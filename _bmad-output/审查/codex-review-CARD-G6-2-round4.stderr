   346	  notes: Object.create(null), inflight: Object.create(null), pendingSync: Object.create(null)};
   347	const el = id => document.getElementById(id);
   348	function fmtClock(ms) {
   349	  return new Intl.DateTimeFormat("zh-CN", {timeZone: "Asia/Shanghai", hour12: false,
   350	    hour: "2-digit", minute: "2-digit", second: "2-digit"}).format(new Date(ms));
   351	}
   352	function setConn(cls, text) {
   353	  const c = el("conn");
   354	  c.className = "conn " + cls;
   355	  c.textContent = text;
   356	}
   357	function vaultButtons(vid) {
   358	  // getAttribute 比对而非把 vid 插进 CSS 选择器 — vid 是外部字符串,
