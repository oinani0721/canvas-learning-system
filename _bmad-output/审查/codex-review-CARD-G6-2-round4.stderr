   780	
   781	def _node_rows(rows: dict[str, dict]) -> list[dict]:
   782	    """板内到期节点明细 (CARD-G6-4) —— 纯消费 _gate_due_groups 已门禁过的行。
   783	
   784	    排序 = 紧迫度降序, 与既有板级 `earliest` 的口径**同一条规则**:
   785	    已排期的到期时刻恒在过去, 越早越紧迫, 所以先按非空时间戳升序; 新卡的
   786	    fsrs_due 是空串 (语义 = 现在), 排在已逾期节点之后 —— 字典序把 "" 当最小
   787	    会让"逾期 3 天"被"现在"盖掉, 那正是 D1 复核抓过的低估紧迫度缺陷, 这里
   788	    不许在明细里重犯一遍。同刻按节点名稳定排序 (防同分随机漂)。
   789	
   790	    bucket / why_due 可能为 None (G3-6a 之前的旧投影没有这两个字段) —— 渲染层
   791	    据此降级为"—", 不伪造分层标签。
   792	    """
   793	    return sorted(
   794	        (
   795	            {
   796	                "node": node,
   797	                "due_reason": meta["reason"],
   798	                "fsrs_due": meta["fsrs_due"],
   799	                "bucket": meta["bucket"],
   800	                "why_due": meta["why_due"],
   801	            }
   802	            for node, meta in rows.items()
   803	        ),
   804	        key=lambda r: (r["fsrs_due"] == "", r["fsrs_due"], r["node"]),
   805	    )
   806	
   807	
   808	def _reject_nonstandard_json(const: str):
   809	    # json.loads 默认放行 NaN/Infinity — 非标准 JSON 不是合法 v3 投影
   810	    raise ValueError(f"非标准 JSON 常量 {const}")
   811	
   812	
   813	def _vault_entry(vault_dir: Path, today: date) -> dict:
   814	    """单 vault 聚合条目 — 诚实四态, 任何脏数据都不许把请求打成 500。"""
   815	    entry: dict = {
   816	        "vault_id": vault_dir.name,
   817	        "path": str(vault_dir),
   818	        "status": "no_projection",
   819	        "projection": None,
   820	        "error": None,
   821	    }
   822	    proj_path = vault_dir.joinpath(*_PROJECTION_REL)
   823	    try:
   824	        raw = proj_path.read_text(encoding="utf-8")
   825	    except FileNotFoundError:
   826	        return entry  # 显式"无投影"降级条目 (推送管道尚未跑过该库)
   827	    except (OSError, UnicodeDecodeError) as e:
   828	        entry["status"] = "corrupt"
   829	        entry["error"] = f"{type(e).__name__}: {str(e)[:200]}"
   830	        return entry
   831	    try:
   832	        payload = json.loads(raw, parse_constant=_reject_nonstandard_json, parse_float=_finite_float)
   833	        if not isinstance(payload, dict):
   834	            raise ValueError("投影根节点不是 JSON object")
   835	        # Codex-D1 H2: JSON "\ud800" 转义会解出孤立 surrogate 字符串,
   836	        # isinstance(str) 门禁放行, 到响应 UTF-8 序列化 / quote() 才炸成
   837	        # 500 — 解析层就地折断 (UnicodeEncodeError ⊂ ValueError → corrupt)
   838	        json.dumps(payload, ensure_ascii=False).encode("utf-8")
   839	        summary = _summarize(payload)
   840	    except Exception as e:  # noqa: BLE001 — 外部文件任意形状, 统一 corrupt 降级
   841	        entry["status"] = "corrupt"
   842	        entry["error"] = f"{type(e).__name__}: {str(e)[:200]}"
   843	        return entry
   844	
   845	    # stale 判定: 只认 A2 生产器的确切形态 (带时区秒级) — 数字串/纯日期/
   846	    # 无时区值不许冒充今日 (Codex-C2 B2); 解析中的任何异常 (含
   847	    # fromisoformat 通过但 astimezone 溢出的 OverflowError, Codex-C2 B1)
   848	    # 都按 stale 降级, 绝不逃逸成 500。
   849	    stale = True
   850	    try:
   851	        if _GENERATED_AT_RE.fullmatch(summary["generated_at"]):
   852	            gen = datetime.fromisoformat(summary["generated_at"].replace("Z", "+00:00"))
   853	            # CARD-D1: 本地日统一 Asia/Shanghai (容器 UTC 下 astimezone()
   854	            # 会用错误的"本地日"跨午夜误判)
   855	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   856	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   857	        stale = True
   858	
   859	    entry["status"] = "stale" if stale else "ok"
   860	    entry["projection"] = summary
   861	    return entry
   862	
   863	
   864	def _collect() -> dict:
   865	    s = get_settings()
   866	    try:
   867	        vaults_root = Path(s.VAULTS_ROOT).resolve()
   868	    except OSError as e:
   869	        # 防御深度 (Codex round-3 提出; 本平台未复现 resolve 抛错, 如实登记):
   870	        # 本端点的全部错误路径都该是 503, 不许有一条能逃逸成 500
   871	        raise HTTPException(
   872	            status_code=503,
   873	            detail={"error": "vaults_root_invalid", "message": f"{type(e).__name__}: {str(e)[:200]}"},
   874	        )
   875	    if not vaults_root.is_dir():
   876	        raise HTTPException(
   877	            status_code=500,
   878	            detail={
   879	                "error": "vaults_root_invalid",
   880	                "message": f"VAULTS_ROOT not a directory: {vaults_root}",
   881	            },
   882	        )
   883	    now = datetime.now(_TZ_SHANGHAI)  # CARD-D1: 全链路上海本地时区
   884	    try:
   885	        vault_dirs = _list_vault_dirs(vaults_root)
   886	    except OSError as e:
   887	        raise HTTPException(
   888	            status_code=500,
   889	            detail={"error": "vaults_root_scan_failed", "message": str(e)},
   890	        )
   891	    vaults = []
   892	    for v in vault_dirs:
   893	        try:
   894	            vaults.append(_vault_entry(v, now.date()))
   895	        except Exception as e:  # noqa: BLE001 — 终极防线 (Codex-C2 B1):
   896	            # 单库任何未预期异常都不许把全局打成 500, 以 corrupt 条目呈现;
   897	            # traceback 落服务端日志 (兜底不等于不可观测)
   898	            logger.exception("review_overview 单库聚合异常", vault=v.name)
   899	            vaults.append(
   900	                {
   901	                    "vault_id": v.name,
   902	                    "path": str(v),
   903	                    "status": "corrupt",
   904	                    "projection": None,
   905	                    "error": f"{type(e).__name__}: {str(e)[:200]}",
   906	                }
   907	            )
   908	    return {
   909	        "generated_at": now.isoformat(timespec="seconds"),
   910	        "vaults_root": str(vaults_root),
   911	        "active_vault": s.ACTIVE_VAULT,
   912	        "vaults": vaults,
   913	    }
   914	
   915	
   916	@review_overview_router.get(
   917	    "/overview",
   918	    summary="跨 vault 复习总览聚合 (CARD-C2)",
   919	)
   920	async def review_overview() -> dict:
   921	    """聚合各 vault 的今日复习投影 — 只读, 缺投影/损坏均显式降级。"""
   922	    return _collect()
