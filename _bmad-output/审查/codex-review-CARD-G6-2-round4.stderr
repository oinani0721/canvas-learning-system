   444	}
   445	document.addEventListener("visibilitychange", () => {
   446	  const act = visibilityAction(document.hidden);
   447	  if (act.cancelTimer) { clearTimeout(state.timer); state.timer = null; }
   448	  if (act.pollNow) poll();
   449	  else if (document.hidden) el("nextpoll").textContent = "已暂停（页面隐藏）";
   450	});
   451	async function onRefreshClick(ev) {
   452	  const btn = ev.target.closest("[data-refresh-vault]");
   453	  if (!btn) return;
   454	  const vid = btn.getAttribute("data-refresh-vault");
   455	  if (state.inflight[vid]) return;  // 同库重建在飞, 不发第二个 POST
   456	  state.inflight[vid] = true;
   457	  state.notes[vid] = {html: '<span class="rnote">⏳ 重建中…</span>', atMs: Date.now()};
   458	  for (const b of vaultButtons(vid)) b.disabled = true;
   459	  applyNote(vid);
   460	  try {
   461	    // 手动按钮是唯一的 POST 路径 (默认裁决②: 自动轮询绝不 POST)
   462	    const resp = await fetch(URLS.refresh, {method: "POST", body: new URLSearchParams({vault_id: vid})});
   463	    let payload = null;
   464	    try { payload = await resp.json(); } catch (_e) { payload = null; }
   465	    state.notes[vid] = {html: renderRefreshResult(resp.status, payload), atMs: Date.now()};
   466	    // 先就地补; 就地补不到 (反馈期间被轮询重绘换过 DOM) 且手上有数据 →
   467	    // 用持久状态重绘恢复 — 反馈从此不依赖「那个 span 还在不在」
