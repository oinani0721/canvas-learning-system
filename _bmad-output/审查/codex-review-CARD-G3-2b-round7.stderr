  2609	        assert rn.returncode != 0, f"node_id={nid!r} 无法路由，静默跳过等于漏算"
  2610	        assert "不可用" in rn.stderr, rn.stderr
  2611	        assert _write_face(vault) == face, "零写"
  2612	    # 验伪：合法的别节点行不得被这条门误伤
  2613	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2614	    row = _review_row()
  2615	    row["node_id"] = "别的节点"
  2616	    row["event_id"] = "quiz:别节点"
  2617	    _write_ledger(vault, row)
  2618	    assert _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z")).returncode == 0
  2619	
  2620	    # H① 输入 ts 用 fullmatch（末尾换行不得穿透）
  2621	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2622	    LED.unlink(missing_ok=True)
  2623	    rt = _run_writer(vault, _payload(event_id="板A#q1", ts="2026-08-02T10:00:00Z\n"))
  2624	    assert rt.returncode != 0, "末尾换行能穿透 match()，必须用 fullmatch"
  2625	    assert not LED.exists() or not _ledger_lines(vault), "不得产出任何账本行"
  2626	
  2627	    # H② NaN/Infinity：输入侧与读取侧都要与严格校验器同口径
  2628	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2629	    LED.unlink(missing_ok=True)
  2630	    rn2 = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, exam_board=float("nan")))
  2631	    assert rn2.returncode != 0, "NaN 会被 json.dumps 原样写成字面量，而校验器拒收"
  2632	    assert not LED.exists() or "NaN" not in LED.read_text(encoding="utf-8"), "不得落库 NaN"
  2633	
  2634	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2635	    _write_ledger(vault, _review_row())
  2636	    raw = LED.read_text(encoding="utf-8")
  2637	    LED.write_text(re.sub(r'"grade_norm":\s*[0-9.]+', '"grade_norm": NaN', raw), encoding="utf-8")
  2638	    face_nan = _write_face(vault)
  2639	    rn3 = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2640	    assert rn3.returncode != 0, "账本里的 NaN 必须被 strict loader 拒（默认 json.loads 会接受）"
  2641	    # 同上：点名拒因 + 零写，否则「恢复已落定」的续跑信号会让门抓不住变异
  2642	    assert ("NaN" in rn3.stderr) or ("非标准" in rn3.stderr) or ("解析" in rn3.stderr), rn3.stderr[:250]
  2643	    assert _write_face(vault) == face_nan, "零写（节点 + 账本）"
  2644	    assert _run_validator(vault).returncode != 0, "校验器同样拒（两侧同口径）"
  2645	
  2646	    # H③ 同 ID 的合法 §6.3 历史行按 A4.5 幂等 no-op，不是拒
  2647	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2648	    LED.unlink(missing_ok=True)
  2649	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1)).returncode == 0
  2650	    rows = list(_ledger_lines(vault))
  2651	    rows[0]["payload"] = {"exam_board": "旧板", "note": "旧写点产物"}
  2652	    LED.write_text(json.dumps(rows[0], ensure_ascii=False) + "\n", encoding="utf-8")
