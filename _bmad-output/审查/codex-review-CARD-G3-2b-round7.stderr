   680	# ── G3-2 rating 同源: 显式算好传给 bridge (bridge 优先用显式 rating),
   681	# payload 存同一个值 — 事件内 rating/grade_norm 自洽是构造性保证。
   682	rating = rating_from_grade(GN2, bool(p.get("abandoned")))
   683	abandoned = bool(p.get("abandoned"))
   684	
   685	# ── G3-2 适用事件集 (本节点 / schema_ext=review/1 / 未标 out_of_order),
   686	# 按 (业务时刻, 行序) 升序。A2 的 pending 与 envelope 门的 attempt ordinal
   687	# 复算**共用同一集合** — 两处若各扫一遍, 「进 pending 的行」与「参与 ordinal
   688	# 计数的行」会分叉。R2 (round-3 BLOCKER): 该集合每一行都参与 W 比较,
   689	# 故逐行机械强制 UTC 整秒 (小数秒行会让同一事件反复判 pending 二次推进)。
   690	_applicable = []
   691	for _ln, _o in _rows:
   692	    _pl = _o.get("payload") if isinstance(_o, dict) else None
   693	    # payload 必须是 object (§一: v2 才可改类型)。非 dict 时旧实现抛裸
   694	    # AttributeError traceback, 不是 clean fail-closed。
   695	    # 顶层不是 JSON object 的行 (如 `[]` / `12345`) 此前被账本读取层收下、
   696	    # 适用集又因 `isinstance(_o, dict)` 为假而静默跳过 —— 写点 rc=0 而校验器
   697	    # rc=1「顶层必须是 JSON object」(Codex round-4 HIGH)。
   698	    if not isinstance(_o, dict):
   699	        raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行的顶层不是 JSON object ({type(_o).__name__}) — 与校验器同口径 fail-closed 拒写")
   700	    # ⛔ 路由信封 (schema §一「路由信封冻结」的**读方义务**, 逐字): 解析出的
   701	    # 记录若缺少可用的 node_id (任何版本), 一律视为**不可路由**并 fail-closed
   702	    # —— 不能因为「它看起来不属于本节点」就跳过, 因为恰恰无法判定归属。
   703	    # ⛔「可用」= 非空字符串且无首尾空白 (Codex round-6 BLOCKER)。此前只判类型,
   704	    # 于是 node_id="" / "   " 的行在归属比较时**不等于**本节点 ⇒ 被当别节点静默
   705	    # 跳过, 而它的 payload 明明指向本概念 —— 实测写点 rc=0、账本照常增行、W 照常
   706	    # 推进, 校验器 rc=1。「无法路由」和「属于别人」是两件事, 前者必须停下。
   707	    _nid_ = _o.get("node_id") if isinstance(_o, dict) else None
   708	    if isinstance(_o, dict) and (not isinstance(_nid_, str) or not _nid_.strip() or _nid_ != _nid_.strip()):
   709	        raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行的 node_id 不可用 ({_nid_!r}; 须为非空且无首尾空白的字符串) — 「无法路由」不等于「属于别人」, 静默跳过等于漏算, 按 §一 路由信封条款 fail-closed 拒写")
   710	    # ⚠️ 归属判断必须排在「缺 payload 就跳过」**之前**: 本节点的行缺 payload
   711	    # 时它仍可能是一次真实评分, 静默跳过就是漏算 (Codex round-4 HIGH: 写点
   712	    # rc=0 而校验器 rc=1)。别的节点的行才轮得到「跳过」。
   713	    if _o.get("node_id") != node_id:
