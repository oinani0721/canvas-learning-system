   723	    if not isinstance(_pl, dict):
   724	        raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行 (本节点) 缺 payload 或其类型不是 object — 无法判定它是不是一次评分, 静默跳过等于漏算, fail-closed 拒写")
   725	    # ⛔ 完整校验必须排在 marker 分流与乱序分流**之前** (Codex round-5 HIGH):
   726	    # 那两条分支都以 `continue` 结束, 排在校验后面就等于「先放行再校验」——
   727	    # 实测一条标了 out_of_order、时刻带首尾空白的行, 校验器 rc=1 而写点 rc=0
   728	    # 并照常写入下一次评分。
   729	    # ⛔ 必须传 manifest (Codex round-5 HIGH): 不传等于**没有执行**算法身份真值
   730	    # 绑定 —— 实测 fsrs_library_version="999.999" + 全零 hash 时校验器 CLI rc=1
   731	    # 而写点照常放行。manifest 不可达时校验器自己会降级为形状检查 + WARN。
   732	    _vio_, _warn_ = validate_record_full(_o, vault_id=_vid, manifest=_GOLDEN_MF)
