   352	# 分诊在下方主流程里做, 这里只放解析函数。
   353	def _fm_has_event_compat(fm_text, ev_id, all_ledger_ids=()):
   354	    """F1 判定: 按**完整** event_id 查; 裸键回落**仅在映射可证唯一时**才做。
   355	
   356	    回落只为**历史兼容** —— 本卡之前写入的校准记录存的是剥前缀形态。新写入一律
   357	    存完整形态, 所以新数据不会再走回落分支。
   358	
   359	    ⛔ 但回落本身会**制造新的别名** (Codex round-5 BLOCKER, 实测): 账本里同时
   360	    存在裸键 `K` 与带前缀的 `quiz:K` 时, 后者回落查 `K` 会命中前者写下的校准
   361	    条目 —— 两个**不同的完整 event_id** 别名成一个, 那次评分静默不入账
   362	    (实测 rc=0、账本 attempts=[1,2]、第三次评分没有校准条目)。
   363	
   364	    所以回落前必须**先证明映射唯一**: 账本里若同时存在 `K` 与 `quiz:K`
   365	    (裸形态相同的两个不同完整 id), 歧义不可消解 —— **停下**, 而不是猜一个。
   366	    """
   367	    if _fm_has_event(fm_text, ev_id):
   368	        return True
   369	    if not ev_id.startswith("quiz:"):
   370	        return False
   371	    _bare = ev_id[5:]
   372	    # 唯一性证明: 账本里裸形态同为 _bare 的完整 id 只能有一个 (就是 ev_id 自己)
   373	    _aliases = {i for i in all_ledger_ids
   374	                if (i[5:] if i.startswith("quiz:") else i) == _bare}
   375	    if len(_aliases) > 1:
   376	        raise SystemExit(
   377	            f"[quiz-answer] 账本里存在裸形态相同的多个 event_id {sorted(_aliases)!r} — "
   378	            f"历史校准条目存的是剥前缀形态, 无法证明它对应其中哪一个; "
   379	            f"猜一个就会让另一个静默不入账, fail-closed 拒写 — 请人工统一这些 id"
   380	        )
   381	    return _fm_has_event(fm_text, _bare)
