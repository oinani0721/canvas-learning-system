  2657	    assert _sha(vault / NODE_REL) == sha, "幂等必须零写"
  2658	    # 验伪：无 marker 却带着 review 扩展键的行仍必须拒（那是被伪装的复习）
  2659	    rows[0]["payload"] = {"vault_id": "canvas_vault_测试", "rating": 3, "review_time": TS1}
