   542	        if mo:
   543	            old = float(mo.group(1)); break
   544	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   545	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   546	    if ma and mb:
   547	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   548	    elif old is not None:
   549	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   550	    else:
   551	        a_, b_ = PRIOR_A, PRIOR_B
