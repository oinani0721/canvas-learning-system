  2389	def test_round5_calibration_key_prefix_collision(vault):
  2390	    """校准记录曾存**剥掉 `quiz:` 前缀**的 event_id, 于是账本里的 `quiz:K` 与
  2391	    `K` 落到同一个键上, F1 判定无法区分。
  2392	
  2393	    ⚠️ 实测漏算链: 账本 3 次评分 (`quiz:K` / `K` / 本次), 第二条因剥前缀后与第一条
  2394	    同名而被误判「已应用」⇒ 跳过复放 ⇒ 校准只记 2 条、attempt 停在 2,
  2395	    **那次复习永久消失且 rc=0 无任何提示**。
  2396	
  2397	    ⚠️ 另两种 attempt 排列恰好被序数门顶住而 fail-closed —— 那是**巧合不是设计**。
  2398	    「被别的门兜住」不等于缺陷不存在: 只要换一个排列 (第二行 attempt 恰等于误判
  2399	    分支算出的期望值) 就穿过去了。这正是本门要锁住的那一个排列。
  2400	
  2401	    修法: 写入存**完整** event_id; F1 查询完整形态优先, 剥前缀形态**仅作历史
  2402	    兼容回落** (回落不能反向做 —— 拿剥前缀的键去撞完整记录正是碰撞的来源)。
  2403	    """
  2404	
  2405	    def _three_scored(id1, id2, n2):
  2406	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2407	        rows = []
  2408	        for eid, rt, n in ((id1, TS1, 1), (id2, "2026-08-01T10:00:01Z", n2)):
  2409	            row = _review_row(**{"payload.review_time": rt, "effective_at": rt})
  2410	            row["event_id"] = eid
  2411	            row["payload"]["attempt_count"] = n
  2412	            rows.append(row)
  2413	        _write_ledger(vault, *rows)
  2414	        r = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2415	        fm = (vault / NODE_REL).read_text(encoding="utf-8")
  2416	        # _fm_fields 只抽 fsrs_*，attempt_count 直接读（容 YAML 引号标量）
  2417	        _m = re.search(r"^attempt_count:\s*[\"']?(\d+)[\"']?\s*$", fm, re.M)
  2418	        return r, re.findall(r"^  - event_id: (.+)$", fm, re.M), (int(_m.group(1)) if _m else None)
  2419	
  2420	    # ① 碰撞 + attempt 恰好对上误判期望 —— 修复前正是这个排列穿过了序数门
  2421	    r, cal, att = _three_scored("quiz:K", "K", 1)
  2422	    assert not (r.returncode == 0 and len(cal) < 3), (
  2423	        f"碰撞键不得静默漏算: rc={r.returncode} 校准{len(cal)}条 attempt={att}"
  2424	    )
  2425	    # ② 碰撞 + 序数自洽 ⇒ **歧义即停**（round-5 修订的口径）。
  2426	    # ⚠️ 我一度把期望写成「都能正常复放」——那是错的：历史校准条目存的是**剥前缀**
  2427	    # 形态，遇到 `K` 与 `quiz:K` 并存时，一条裸键条目到底对应哪一个**无法证明**。
  2428	    # 猜一个就会让另一个静默不入账（正是本门开头那条漏算链）。可证的处置只有停下。
  2429	    r, cal, att = _three_scored("quiz:K", "K", 2)
  2430	    assert r.returncode != 0, f"裸形态相同的两个 event_id 并存时必须 fail-closed: {cal}"
  2431	    assert "裸形态相同的多个 event_id" in r.stderr, r.stderr
  2432	    assert "请人工统一这些 id" in r.stderr, "拒因必须给出可执行的处置方式"
  2433	
  2434	    # 验伪①: 不碰撞的正常场景不得回归
