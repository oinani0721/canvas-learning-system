   520	# **第三次评分静默不入账** (rc=0, attempts 停在 [1,2])。
   521	# 走 compat 是为了兼容历史裸键条目; 它内部会先证明裸形态映射唯一, 歧义则停。
   522	f1 = bool(eid) and _fm_has_event_compat(fm, evid, _EARLY_LEDGER_IDS)
   523	
   524	# 回填 type/source_board（Dashboard 可见性，缺才补）
   525	if not re.search(r'^type:', fm, re.M):
   526	    fm = "type: concept\n" + fm.lstrip("\n")
   527	if p.get("source_board") and not re.search(r'^source_board:', fm, re.M):
   528	    fm = fm.rstrip() + '\nsource_board: ' + json.dumps(p["source_board"], ensure_ascii=False)
