   323	
   324	def _no_dup_keys(pairs):
   325	    _seen = set()
   326	    for _k, _ in pairs:
   327	        if _k in _seen:
   328	            raise _DupKey(repr(_k))
   329	        _seen.add(_k)
   330	    return dict(pairs)
