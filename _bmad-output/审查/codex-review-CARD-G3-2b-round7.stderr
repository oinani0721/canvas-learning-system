   384	def _fm_has_event(fm_text, ev_id):
   385	    mcal = re.search(r'^calibration_log:[ \t]*$', fm_text, re.M)
   386	    if not mcal:
   387	        return False
   388	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   389	        if ln and not ln[0].isspace():
   390	            break
   391	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   392	        if mm:
   393	            v = mm.group(1).strip()
   394	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   395	                try:
   396	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   397	                except ValueError:
   398	                    pass
   399	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   400	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   401	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   402	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   403	                v = v[1:-1].replace("''", "'")
   404	            if v == ev_id:
   405	                return True
   406	    return False
