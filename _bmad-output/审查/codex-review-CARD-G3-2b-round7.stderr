  2700	def test_round6_ordinal_evidence(vault):
  2701	    """⛔ 这两条我一度登记为「不处置」，理由是「改判据整个维度风险高于收益」——
  2702	    **那是判断不是事实**，而且审查者给了具体修法。险些又犯「拿错误声明当不修
  2703	    理由」那个错。
  2704	
  2705	    H⑤：序数把 `review_time <= W` 当成「后续事件已贡献 attempt」的证明。
  2706	        但 **degraded 落账写 attempt + 校准却不写 W**，两者会分道 ——
  2707	        重跑前一个事件时被误报「envelope 冲突」，而它是合法的历史重试。
  2708	        判据改用 **calibration 证据**（与 attempt/mastery 同一次原子写）。
  2709	
  2710	    M③：历史行明明**带着合法 attempt_count**（validator rc=0），拒因却写死
  2711	        「无 attempt_count」——拒因本身是错的。改为先用账本自身能证明的序数回推。
  2712	    """
  2713	    LED = vault / "learning_events.jsonl"
  2714	
  2715	    # ── H⑤：W 停在 E1，而 E2 已贡献 attempt + 校准 ⇒ 重跑 E1 必须幂等
  2716	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2717	    LED.unlink(missing_ok=True)
  2718	    for eid, ts in (("E1#q1", TS1), ("E2#q1", "2026-08-01T11:00:00Z")):
  2719	        assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts)).returncode == 0
  2720	    node = (vault / NODE_REL).read_text(encoding="utf-8")
  2721	    rolled = re.sub(r"^fsrs_last_review:.*$", f'fsrs_last_review: "{TS1}"', node, count=1, flags=re.M)
  2722	    assert rolled != node, "预置必须真的把 W 回退（str 替换失败会静默返回原串）"
  2723	    (vault / NODE_REL).write_text(rolled, encoding="utf-8")
  2724	    assert _run_validator(vault).returncode == 0, "该状态本身合规（degraded 落账的产物形态）"
  2725	    sha = _sha(vault / NODE_REL)
  2726	    r = _run_writer(vault, _payload(event_id="E1#q1", ts=TS1))
  2727	    assert r.returncode == 0, f"E2 已贡献 attempt（校准里有它），重跑 E1 必须幂等: {r.stderr[:300]}"
  2728	    assert "幂等跳过" in r.stdout, r.stdout[:200]
  2729	    assert _sha(vault / NODE_REL) == sha, "幂等必须零写"
  2730	
  2731	    # H⑤ 验伪：**真**的 envelope 冲突（改了分数）仍必须拒
  2732	    r2 = _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, grade_norm=0.11))
  2733	    assert r2.returncode != 0, "评分事实真不一致时仍须拒 —— 否则这条修复把冲突门也放宽了"
  2734	    assert "envelope 冲突" in r2.stderr, r2.stderr[:200]
  2735	
  2736	    # ── M③：历史行带合法 attempt_count ⇒ 账本可证，放行
  2737	    def _with_legacy(payload):
  2738	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2739	        LED.unlink(missing_ok=True)
  2740	        for eid, ts in (("E1#q1", TS1), ("L#q1", "2026-08-01T11:00:00Z")):
  2741	            assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts)).returncode == 0
  2742	        rows = list(_ledger_lines(vault))
  2743	        rows[1]["payload"] = payload
  2744	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  2745	        assert _run_validator(vault).returncode == 0, "改造后的账本本身必须合规"
  2746	        return _run_writer(vault, _payload(event_id="E1#q1", ts=TS1))
  2747	
  2748	    rp = _with_legacy({"exam_board": "旧板", "note": "旧写点产物", "attempt_count": 2})
  2749	    assert rp.returncode == 0, f"历史行带合法 attempt_count ⇒ 账本可证，必须放行: {rp.stderr[:300]}"
  2750	
  2751	    # M③ 验伪：历史行**不带** attempt_count ⇒ 不可证，停下且拒因指名行号与字段
  2752	    rn = _with_legacy({"exam_board": "旧板", "note": "旧写点产物"})
  2753	    assert rn.returncode != 0, "不可证时必须停下（不得伪造期望值）"
  2754	    assert "都没有可用的 attempt_count" in rn.stderr, rn.stderr[:300]
  2755	    assert "补上 attempt_count" in rn.stderr and re.search(r"第 \[\d+", rn.stderr), (
  2756	        f"拒因必须指名哪几行要补什么: {rn.stderr[:300]}"
  2757	    )

