   612	def _normalize_inline_calibration(fm_text):
   613	    """`calibration_log: []` (inline 空列表) 必须先原子改写成 block 形态, 否则
   614	    后面直接在它下面插缩进条目会产出**非法 YAML** (`calibration_log: []` 后跟
   615	    缩进列表) —— 实测首次评分 rc=0 且 attempt/W/账本都已推进, 同事件重跑却报
   616	    「FSRS 已应用但缺校准记录」⇒ 两阶段流程**永久不收敛** (Codex round-6 HIGH)。
   617	    """
   618	    return re.sub(r"^calibration_log:[ \t]*\[[ \t]*\][ \t]*$", "calibration_log:", fm_text, count=1, flags=re.M)
   619	
   620	
   621	def _append_calibration(fm_text, ts_str, ev=None):
   622	    fm_text = _normalize_inline_calibration(fm_text)
   623	    """calibration_log 条目 (正常 / 恢复 / A2 重放三路径共用)。ts_str = 业务生效
   624	    时刻 (review_time — 与 effective_at 同源, 保证恢复产物与直接应用逐字节对齐)。
   625	
   626	    ev=None ⇒ 记本次评分, 字段取本次 payload。
   627	    ev=某条 durable 行 ⇒ **复放**那次评分的校准条目, 字段取该行 payload;
   628	      question_id / self_confidence_* 不在事件载荷里, 记 null。
   629	      ⚠️ 但 event_id / ts / exam_board / grade_norm / abandoned 都在, 够让 F1
   630	      判定命中 —— 于是被恢复的那张检验白板重跑时能走「已完整应用, 幂等跳过」,
   631	      而不是撞上「FSRS 已应用但缺校准记录」的人工裁定 (审查实测: 缺了这一步,
   632	      那张白板**永久卡在** scored_pending_node_update)。
   633	    """
   634	    q_ = lambda v: json.dumps(v, ensure_ascii=False)
   635	    if ev is None:
   636	        # ⛔ 正常路径也必须存**完整**账本 event_id (Codex round-6 BLOCKER):
   637	        # round-5 我只把 foreign 分支改成存完整 id, 正常分支仍存裸 `eid` ——
   638	        # 两条路径写进 calibration_log 的键**不是同一个东西**。实测漏算链:
   639	        # 先提交 event_id="quiz:K" ⇒ 账本行是 `quiz:quiz:K` 而校准记的是 `quiz:K`;
   640	        # 再提交另一个事件 `K`(完整 id 也是 `quiz:K`) ⇒ F1 命中那条校准、判「已完整
   641	        # 应用」而幂等跳过, **那次评分静默不入账**(rc=0, attempt 停在 1)。
   642	        # 修一半比不修更危险: 它把不一致藏进了「已经修过」的地方。
   643	        _e_id, _e_pl = evid, p
   644	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   645	        _e_qid = q_(p.get("question_id", "q1"))
   646	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   647	    else:
   648	        _e_pl = ev.get("payload") or {}
   649	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
   650	        # 剥完之后 `quiz:K` 与 `K` 变成同一个键, F1 判定无法区分 —— 实测账本 3 次
   651	        # 评分只记 2 条校准、attempt 停在 2, **一次复习静默消失且 rc=0 无提示**。
   652	        # (另两种 attempt 排列恰好被序数门兜住而 fail-closed —— 那是巧合不是设计,
   653	        #  「被别的门兜住」不等于缺陷不存在。)
   654	        _e_id = str(ev.get("event_id") or "")
   655	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   656	        _e_qid, _e_scr, scn_ = "null", "null", None
   657	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   658	              f'    ts: {q_(ts_str)}\n'
   659	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   660	              f'    question_id: {_e_qid}\n'
   661	              f'    self_confidence_raw: {_e_scr}\n'
   662	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   663	              f'    grade_norm: {_e_gn}\n'
   664	              f'    abandoned: {"true" if _e_ab else "false"}')
   665	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   666	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   667	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   668	    # 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   669	    mcal_ = re.search(r'^calibration_log:', fm_text, re.M)
   670	    if mcal_:
   671	        lines_ = fm_text.split("\n")
   672	        li_ = next(i for i, ln in enumerate(lines_) if re.match(r'^calibration_log:', ln))
   673	        j_ = li_ + 1
   674	        while j_ < len(lines_) and lines_[j_].startswith("  "):
   675	            j_ += 1
   676	        lines_[j_:j_] = entry_.split("\n")
   677	        return "\n".join(lines_)
   678	    return fm_text.rstrip() + "\ncalibration_log:\n" + entry_
