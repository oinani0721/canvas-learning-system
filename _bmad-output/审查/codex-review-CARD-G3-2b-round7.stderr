   530	# ── G3-2 mastery 计算抽函数 (正常/恢复两路径共用)。biz_ts = 本次业务时刻:
   531	# 正常路径用 payload ts, 恢复路径用 durable 行 review_time — 保证恢复产物与
   532	# 直接应用逐字节对齐 (Codex round-2 HIGH: 卡文门②要求字节等值)。
   533	sys.path.insert(0, os.path.join(VAULT, ".claude", "scripts"))
   534	from decay_beta import PRIOR_A, PRIOR_B, from_legacy, mu, update_after_idle
   535	
   536	def _apply_mastery(fm_text, biz_ts, gn=None):
   537	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   538	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   539	    old = None
   540	    for key in ("mastery_score", "mastery", "mastery_level"):
   541	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   542	        if mo:
   543	            old = float(mo.group(1)); break
   544	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   545	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   546	    if ma and mb:
   547	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   548	    elif old is not None:
   549	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   550	    else:
   551	        a_, b_ = PRIOR_A, PRIOR_B
   552	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   553	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   554	    days_idle = 0.0
   555	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   556	    if mle:
   557	        try:
   558	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   559	        except ValueError:
   560	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   561	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   562	    # 用 GN2 而非 GN (内部对抗审查 MEDIUM): durable payload 锁的是 round(GN,2),
   563	    # 而 mastery 若用未舍入的 GN, 同一个 durable 事件在「首跑 gn=0.752」与
   564	    # 「恢复重试 gn=0.7549」两次下会算出不同的 mastery_a —— envelope 判它们
   565	    # 同一件事(两侧 GN2 都是 0.75), 产物却不同。业务量恒取账本锁住的那个值。
   566	    # gn=None ⇒ 用本次评分的 GN2; A2 重放别人的事件时传那行 durable 的 grade_norm。
   567	    a_, b_ = update_after_idle(a_, b_, GN2 if gn is None else float(gn), days_idle)
   568	    return old, a_, b_, round(mu(a_, b_), 2)
   569	
   570	# ── G3-2 三态判别 (复用校验器 classify_card_state, schema §6.2)。
   571	# degraded(残缺卡) → fail-closed: 报错、零写节点、检验白板停在
   572	# scored_pending_node_update 续跑态 (裁决③)。
   573	_fields = fields_from_frontmatter(fm)
   574	_state, _reason = classify_card_state(_fields)
   575	if _state == "degraded":
   576	    raise SystemExit(f"[quiz-answer] 节点调度状态残缺 (classify_card_state: {_reason}), fail-closed 拒写 — 请人工修复 {NODE} 后重跑")
   577	W = _fields.get("fsrs_last_review")
   578	W_inst = _aware(W) if W else None
   579	
   580	# ── G3-2 vault_id 绑定 (与校验器同函数同链路; 绑不出 = 配置断裂, fail-closed)
   581	_vid = _vault_id_of(Path(EV))
   582	if not _vid:
   583	    raise SystemExit("[quiz-answer] vault 归属无法绑定 (.canvas-config.yaml 缺失/损坏或 backend 不可达), fail-closed 拒写事件")
   584	
   585	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   586	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   587	def _bridge(fm_text, gn, ab, ts, rating=None):
   588	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   589	    if rating is not None:
   590	        payload_in["rating"] = rating
   591	    try:
   592	        _r = subprocess.run(
   593	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   594	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   595	    except Exception as _e:
   596	        return None, str(_e)
   597	    try:
   598	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   599	    except ValueError:
   600	        _out = {}
   601	    if _r.returncode == 2:
   602	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
   603	    if _r.returncode == 0 and _out.get("fm_block"):
   604	        return _out, None
   605	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
   606	    return None, _err
   607	
   608	def _apply_fsrs_block(fm_text, block):
   609	    fm_text = re.sub(r'^(fsrs_due|fsrs_state|fsrs_step|fsrs_stability|fsrs_difficulty|fsrs_last_review):.*\r?\n?', '', fm_text, flags=re.M)
   610	    return re.sub(r'^(type:.*)$', lambda x: x.group(1) + block, fm_text, count=1, flags=re.M)
