   461	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行含非 UTF-8 字节 ({_ue}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   462	        try:
   463	            # ⛔ 不得 .strip() —— 又一次「洗值」分叉 (Codex round-5 线索):
