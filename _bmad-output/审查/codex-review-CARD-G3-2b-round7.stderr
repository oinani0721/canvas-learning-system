   309	def _reject_json_constant(name):
   310	    """与校验器 (validate_learning_events.py) 同口径拒收 NaN / Infinity /
   311	    -Infinity —— RFC 8259 禁止, 跨语言读方会炸。默认 json.loads 会**接受**它们。"""
