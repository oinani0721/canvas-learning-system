   585	def _clean_fm_value(raw: str) -> str:
   586	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   587	
   588	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   589	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   590	    （round-3 自审 H1-6）。
   591	    """
   592	    val = (raw or "").strip()
   593	    val = re.sub(r"\s+#.*$", "", val).strip()
   594	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   595	        val = val[1:-1]
   596	    return val
   597	
   598	
   599	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   600	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   601	
   602	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   603	    于是
   604	
   605	        ---
   606	        doi:
   607	        doi: 10.1000/hidden
   608	        ---
   609	
   610	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   611	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   612	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   613	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   614	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   615	    """
   616	    out: list[tuple[str, str]] = []
   617	    for ln in fm_lines:
   618	        m = _FM_KEY_RE.match(ln)
   619	        if m:
   620	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   621	    return out
   622	
   623	
   624	def frontmatter_map(fm_lines: list[str]) -> dict:
   625	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   626	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   627	    `frontmatter_pairs`。"""
   628	    out: dict[str, str] = {}
   629	    for k, v in frontmatter_pairs(fm_lines):
   630	        out.setdefault(k, v)
   631	    return out
   632	
