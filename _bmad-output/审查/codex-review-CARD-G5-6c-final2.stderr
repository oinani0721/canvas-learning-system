PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 \
.venv/bin/pytest -c /dev/null -p no:cacheprovider \
tests/skills/test_g5_6_clear_inbox.py -q \
