  1026	def find_generation_claim(text: str) -> str | None:
  1027	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
  1028	
  1029	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
  1030	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
  1031	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
  1032	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
  1033	    """
  1034	    for _, ln in head_window(text):
  1035	        for norm in _guard_variants(ln):
  1036	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
  1037	                m = rx.search(norm)
  1038	                if not m:
  1039	                    continue
  1040	                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
  1041	                # `generated by l` —— 人工核对时看不出是哪个模型。补到该词结束。
  1042	                end = m.end()
  1043	                while end < len(norm) and (norm[end].isalnum() or norm[end] in "-_.:"):
  1044	                    end += 1
  1045	                return norm[m.start() : end]
  1046	    return None
  1047	
  1048	
  1049	def _find_marker_pos(ln: str, marker: str) -> int:
  1050	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
  1051	
  1052	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
  1053	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
  1054	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
  1055	    行内更靠后的真命中。
  1056	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
  1057	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
  1058	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
  1059	    只认行尾或标点；漏判方向落 C6，安全。"""
  1060	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
  1061	    start = 0
  1062	    while (i := ln.find(marker, start)) >= 0:
  1063	        j = i + len(marker)
  1064	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
  1065	            return i
  1066	        if not ascii_ending and ln[j].isspace():
  1067	            return i
  1068	        start = i + 1
  1069	    return -1
  1070	
  1071	
  1072	def find_ai_marker(text: str) -> tuple[int, str] | None:
  1073	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
  1074	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
  1075	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
  1076	    —— 行号准确，文本保真。"""
  1077	    for lineno, ln in head_window(text):
  1078	        norm = _norm_ai_line(ln)
  1079	        hits = [
  1080	            (pos, -len(nm), orig)
  1081	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
  1082	            if (pos := _find_marker_pos(norm, nm)) >= 0
  1083	        ]
  1084	        if hits:
  1085	            _, _, marker = min(hits)
  1086	            return lineno, marker
  1087	    return None
  1088	
