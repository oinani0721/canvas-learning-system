  1641	    ask: str | None = None,
  1642	    type_uncertain: bool = False,
  1643	    exact_of: str | None = None,
  1644	    exact_others: list[str] | None = None,
  1645	    near: list[dict] | None = None,
  1646	    conflicts: list[dict] | None = None,
  1647	) -> dict:
  1648	    out = dict(item)
