   799	def skeleton_note(text: str, size: int) -> str:
   800	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   801	
   802	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   803	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   804	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   805	    """
   806	    if size == 0:
   807	        return "0 字节空文件"
   808	    rows = _classify_lines_typed(text)[0]
   809	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   810	    struct = sum(
   811	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   812	    )
   813	    fences = sum(1 for _, k in rows if k == "fence")
   814	    return (
   815	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   816	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   817	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   818	    )
   819	
   820	
   821	def head_window(text: str) -> list[tuple[int, str]]:
   822	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   823	    lines = text.splitlines()
   824	    n = frontmatter_span(lines)
   825	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   826	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   827	        win.append((n + j + 1, ln))
   828	    return win
