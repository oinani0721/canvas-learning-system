  1650	        {
  1651	            "criterion": criterion,
  1652	            "verdict": verdict,
  1653	            "nomination_type": ntype,
  1654	            "target_hint": target,
  1655	            "basis": basis,
  1656	            "confident": confident,
  1657	            "type_uncertain": type_uncertain,
  1658	            "uncertain_reason": uncertain_reason,
  1659	            "ask": ask,
  1660	            "exact_duplicate_of": exact_of,
  1661	            "exact_duplicate_others": exact_others or [],
  1662	            "near_duplicates": near or [],
  1663	            "conflicts": conflicts or [],
  1664	        }
  1665	    )
  1666	    return out
