   550	def frontmatter_span(lines: list[str]) -> int:
   551	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   552	
   553	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   554	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   555	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   556	    行号是给人核对用的，偏了就等于没有。
   557	    """
   558	    if not lines or lines[0].strip() != "---":
   559	        return 0
   560	    end = None
   561	    for i in range(1, len(lines)):
   562	        if lines[i].strip() in ("---", "..."):
   563	            end = i
   564	            break
   565	    if end is None:
   566	        return 0  # 缺闭合 → 视为无 frontmatter
   567	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   568	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   569	    # 空文件的删除提名，比不提名坏得多。
   570	    for ln in lines[1:end]:
   571	        t = ln.strip()
   572	        if not t or t.startswith("#"):
   573	            continue  # 空行与 YAML 注释不作数
   574	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   575	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
