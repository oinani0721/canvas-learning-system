  1026	def find_generation_claim(text: str) -> str | None:
  1027	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
  1028	
  1029	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
  1030	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
  1031	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
  1032	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
  1033	    """
  1034	    for _, ln in head_window(text):
  1035	        for norm in _guard_variants(ln):
  1036	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
  1037	                m = rx.search(norm)
  1038	                if not m:
  1039	                    continue
  1040	                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
  1041	                # `generated by l` —— 人工核对时看不出是哪个模型。补到该词结束。
  1042	                end = m.end()
  1043	                while end < len(norm) and (norm[end].isalnum() or norm[end] in "-_.:"):
  1044	                    end += 1
  1045	                return norm[m.start() : end]
  1046	    return None
