  1020	def _looks_like_doi_value(v: str) -> bool:
  1021	    """值里含 DOI 形态的来源标识（⛔ substring 级，与 `_looks_like_source_value`
  1022	    同口径）。非空才算 —— 卡文 (d) 要的是「**非空** DOI 来源阻止 C3 删除」。"""
  1023	    return bool(v) and bool(_DOI_RE.search(v))
