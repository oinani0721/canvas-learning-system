   272	
   273	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   274	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   275	        # 「跑完了且有测试失败」的只有 rc=1。
   276	        ok = failed == expected and rc == 1 and restored == base_sha
   277	        results.append((name, ok))
   278	        print(f"{'✅' if ok else '❌'} {name}")
   279	        print(f"   期望红: {sorted(expected)}")
   280	        print(f"   实际红: {sorted(failed)}")
   281	        if failed - expected:
