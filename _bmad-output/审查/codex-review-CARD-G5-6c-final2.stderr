   324	    assert it["near_duplicates"], "近似重复必须被记录并呈现给用户"
   325	    assert it["near_duplicates"][0]["path"] == "节点/长文正本.md"
   326	    assert 0.9 <= it["near_duplicates"][0]["ratio"] < 1.0
   327	    assert "疑似" in (it["uncertain_reason"] or "")
