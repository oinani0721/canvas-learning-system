  1597	            True,
  1598	            type_uncertain=typ is None,
  1599	        )
  1600	
  1601	    # ── C6 兜底：拿不准（不给去向、不给类型） ──
  1602	    if within_batch:
  1603	        reason = "本批内有正文逐字相同的另一件，谁是正本不可判 —— 不硬猜"
  1604	    elif near:
  1605	        reason = (
  1606	            "疑似与 "
  1607	            + "、".join(f"{n['path']}(ratio {n['ratio']})" for n in near)
  1608	            + " 高相似，但**未逐字相等** —— 近似不等于重复，不硬猜"
  1609	        )
  1610	    else:
  1611	        reason = (
  1612	            "六判据全不命中：无 source URL、文头无可确定的 AI 自述、有实质正文、"
  1613	            "与库内无逐字相同正本、文件名无 R{n}_ 轮次标记"
  1614	        )
