  2519	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  2520	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  2521	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  2522	
  2523	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  2524	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  2525	    """
  2526	    mod = load_module()
  2527	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  2528	    samples = [
  2529	        "\u200b",
  2530	        "\u200c",
  2531	        "\u200d",
  2532	        "\u2060",
  2533	        "\ufeff",
  2534	        "\u00ad",  # 原表六个
  2535	        "\u2063",
  2536	        "\u200e",
  2537	        "\u200f",
  2538	        "\u061c",
  2539	        "\u034f",  # round-3 新抓
  2540	        "\ufe0f",
  2541	        "\u2062",
  2542	        "\u180e",
  2543	        "\u202e",  # round-3 新抓
  2544	    ]
  2545	    for ch in samples:
  2546	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  2547	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  2548	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  2549	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  2550	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  2551	
