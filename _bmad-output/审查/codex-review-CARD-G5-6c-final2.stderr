   310	def test_c4_near_duplicate_never_suggests_delete(tmp_path):
   311	    """C4 反例(卡片核心红线): 高相似但非逐字相等 → 只标疑似·拿不准, 绝不建议删。"""
   312	    vault, out = base_vault(tmp_path)
