  1947	def test_model_version_generation_claim_is_undigested_signal(tmp_path):
  1948	    """⛔ round-8 BLOCKER-2: 带模型版本的真实生成声明穿透三层护栏。
  1949	
  1950	    `generator: 由 GPT-4 生成` 既不在有限表 (表只到 `由 GPT 生成`, 差一个版本号),
  1951	    也没有独立词「AI」 → 无正文时 `建议删 + confident=true`。
  1952	    修法按**声明骨架**而非**枚举模型名** (卡文 §3 默认裁决): 模型名是开放集合,
  1953	    `由 <某物> 生成` / `generated by <某物>` 这个骨架不随模型名增长
  1954	    （⚠\ufe0f 不等于「闭合」——它自己另有边界，round-3 审查从同一条骨架上又抓出
  1955	    `by_` 无词边界与零宽拆词两处）。
  1956	    ⚠\ufe0f 只降 C6, 绝不进 C2 —— 宽匹配给话题提及发确定归档就是硬猜。
  1957	    """
  1958	    vault, out = base_vault(tmp_path)
  1959	    inbox = vault / "_待处理"
  1960	    # round-8 反例原样
  1961	    mk(inbox / "GPT4声明.md", "---\ngenerator: 由 GPT-4 生成\n---\n", age_days=9)
  1962	    # ⛔ 同族(不得靠枚举): 换任意模型名/版本号都必须接住
  1963	    mk(inbox / "Gemini声明.md", "---\nnote: 本文由 Gemini 2.5 Pro 生成\n---\n", age_days=8)
  1964	    mk(inbox / "英文声明.md", "---\nnote: Generated by Llama-4-Maverick\n---\n", age_days=7)
  1965	    # 字段半边: 值里根本没有「生成」二字, 只有键名在声明
  1966	    mk(inbox / "仅键名声明.md", "---\ngenerator: claude-opus-4\n---\n", age_days=6)
  1967	    # C4 出口也必须拦(护栏是路径属性, 不能只拦 C3)
  1968	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1969	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1970	    mk(inbox / "声明重复件.md", "---\ngenerator: 由 GPT-4o 生成\n---\n" + body, age_days=5)
  1971	    # 正向对照: 无任何生成声明的纯空骨架 → 仍 C3 建议删
  1972	    mk(inbox / "纯空骨架.md", "# \n\n## \n", age_days=4)
  1973	
  1974	    assert run_cli(vault, out).returncode == 0
  1975	    data = load_json(out)
  1976	    assert data["items"], "items 为空则本门恒真 = 假绿"
  1977	    for name in ("GPT4声明.md", "Gemini声明.md", "英文声明.md"):
  1978	        it = item_by_name(data, name)
  1979	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1980	        assert it["criterion"] == "C6_undecided", name
  1981	        assert it["confident"] is False, name
  1982	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1983	        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1984	    key_only = item_by_name(data, "仅键名声明.md")
  1985	    assert key_only["verdict"] != "建议删", key_only["basis"]
  1986	    assert key_only["criterion"] == "C6_undecided"
  1987	    kr = key_only["uncertain_reason"] or ""
  1988	    assert "generator" in kr and "生成来源" in kr, kr
  1989	    for name in ("GPT4声明.md", "Gemini声明.md", "英文声明.md", "仅键名声明.md"):
  1990	        r = item_by_name(data, name)["uncertain_reason"] or ""
  1991	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底，生成信号没被测到: {r}"
  1992	    dup = item_by_name(data, "声明重复件.md")
  1993	    assert dup["verdict"] != "建议删", f"带生成声明的重复件被建议删了: {dup['basis']}"
  1994	    assert dup["criterion"] == "C6_undecided"
  1995	    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
  1996	    # ⛔ 信号只降级, 不扩大 C2: 这些文件不得被判成「AI 自述 → 确定归档」
  1997	    for name in ("GPT4声明.md", "Gemini声明.md", "英文声明.md", "仅键名声明.md"):
  1998	        assert item_by_name(data, name)["criterion"] != "C2_ai_self_declared", name
  1999	    skeleton = item_by_name(data, "纯空骨架.md")
  2000	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2001	    assert skeleton["verdict"] == "建议删"
  2002	
