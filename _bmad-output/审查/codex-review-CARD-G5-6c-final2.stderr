  1854	def build_preview(
  1855	    vault: Path,
  1856	    inbox: Path,
  1857	    inbox_exists: bool,
  1858	    now: datetime,
  1859	    batch_size: int,
  1860	    excluded_roots: list[str],
  1861	) -> dict:
  1862	    now_s = _epoch_s(now)
