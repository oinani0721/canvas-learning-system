  1127	def scan_corpus(
  1128	    vault: Path, excluded_roots: list[str]
  1129	) -> tuple[dict[str, list[str]], list[tuple[str, str]], dict]:
  1130	    """库内 .md 语料：→ (归一化正文 → [相对路径…], [(路径, 正文)…], 统计)。
  1131	
  1132	    排除：一切隐藏目录、`outputs/`、收件箱子树、产物目录子树。
  1133	    ⛔ **空正文不进重复索引** —— 否则库内任意两个空骨架互为「正本」，会撑出一条
  1134	    有后果的建议删，其证据是「两个都是空的」。C3 虽然先命中，但索引本身必须先干净：
  1135	    门要防的是未来次序调整时的静默失效，不只是当下这一次。
  1136	    """
  1137	    by_body: dict[str, list[str]] = {}
  1138	    bodies: list[tuple[str, str]] = []
  1139	    stats = {
  1140	        "files_scanned": 0,
  1141	        "files_indexed": 0,
  1142	        "skipped_empty_body": 0,
  1143	        "skipped_symlink": 0,
  1144	        "skipped_unreadable": 0,
  1145	        "truncated": False,
  1146	        "file_cap": CORPUS_FILE_CAP,
  1147	    }
  1148	    for dirpath, dirnames, filenames in os.walk(vault):
  1149	        dirnames[:] = sorted(
  1150	            d
  1151	            for d in dirnames
  1152	            if not d.startswith(".")
  1153	            and d not in CORPUS_EXCLUDED_DIR_NAMES
  1154	            and os.path.realpath(os.path.join(dirpath, d)) not in excluded_roots
  1155	        )
  1156	        for fn in sorted(filenames):
  1157	            if not fn.endswith(".md"):
  1158	                continue
  1159	            if stats["files_scanned"] >= CORPUS_FILE_CAP:
  1160	                # ⛔ 不在此处 return —— 早退会绕过下面的排序尾巴, 让"截断"与"未截断"
  1161	                # 两条路径产出形态不同的索引。置位后跳出全部循环, 走同一个出口。
  1162	                stats["truncated"] = True
  1163	                dirnames.clear()
  1164	                break
  1165	            p = Path(dirpath) / fn
  1166	            stats["files_scanned"] += 1
  1167	            if p.is_symlink():
  1168	                stats["skipped_symlink"] += 1
  1169	                continue
  1170	            text = read_text_or_none(p)
  1171	            if text is None:
  1172	                stats["skipped_unreadable"] += 1
  1173	                continue
  1174	            if not has_substantive_content(text):
  1175	                stats["skipped_empty_body"] += 1
  1176	                continue
  1177	            body = dup_body(text)
  1178	            if not body:
  1179	                stats["skipped_empty_body"] += 1
  1180	                continue
  1181	            rel = p.relative_to(vault).as_posix()
  1182	            by_body.setdefault(body, []).append(rel)
  1183	            bodies.append((rel, body))
  1184	            stats["files_indexed"] += 1
  1185	        if stats["truncated"]:
  1186	            break
  1187	    for v in by_body.values():
  1188	        v.sort()
  1189	    bodies.sort()
  1190	    return by_body, bodies, stats
  1191	
