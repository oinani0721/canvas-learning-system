  2124	def test_duplicate_frontmatter_key_does_not_mask_source(tmp_path):
  2125	    """⛔ round-2 审查 BLOCKER: `frontmatter_map` 用 `setdefault` 只留**首值**，
  2126	
  2127	        ---
  2128	        doi:
  2129	        doi: 10.1000/hidden
  2130	        ---
  2131	
  2132	    折叠后只剩一个空值，所有基于 `fm.items()` 的护栏信号全扫不到那个 DOI ——
  2133	    同形 `url:` 反例同时穿透 C3 与 C4 两个出口。护栏改扫 `frontmatter_pairs`
  2134	    的全量键值对；判据侧的首值语义不动。
  2135	    """
  2136	    mod = load_module()
  2137	    pairs = mod.frontmatter_pairs(["doi:", "doi: 10.1000/hidden"])
  2138	    assert pairs == [("doi", ""), ("doi", "10.1000/hidden")], pairs
  2139	    assert mod.frontmatter_map(["doi:", "doi: 10.1000/hidden"]) == {"doi": ""}, (
  2140	        "判据侧首值语义必须保持不动 —— 改它是有后果的行为变更"
  2141	    )
  2142	
  2143	    vault, out = base_vault(tmp_path)
  2144	    inbox = vault / "_待处理"
  2145	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2146	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2147	    mk(inbox / "重复DOI键.md", "---\ndoi:\ndoi: 10.1000/hidden\n---\n", age_days=9)
  2148	    mk(inbox / "重复URL键.md", "---\nurl:\nurl: https://example.test/hidden\n---\n", age_days=8)
  2149	    mk(
  2150	        inbox / "重复DOI重复件.md",
  2151	        "---\ndoi:\ndoi: 10.1000/dup-hidden\n---\n" + body,
  2152	        age_days=7,
  2153	    )
  2154	    mk(inbox / "纯空骨架.md", "# \n\n## \n", age_days=6)
  2155	
  2156	    assert run_cli(vault, out).returncode == 0
  2157	    data = load_json(out)
  2158	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2159	    for name, frag in (
  2160	        ("重复DOI键.md", "10.1000/hidden"),
  2161	        ("重复URL键.md", "example.test/hidden"),
  2162	        ("重复DOI重复件.md", "10.1000/dup-hidden"),
  2163	    ):
  2164	        it = item_by_name(data, name)
  2165	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2166	        assert it["criterion"] == "C6_undecided", name
  2167	        assert it["confident"] is False, name
  2168	        r = it["uncertain_reason"] or ""
  2169	        assert frag in r, r
  2170	        # ⛔ 信号归属：兜底 reason 也会把值原样打出来，`frag in r` 单独不够判别。
  2171	        assert ("DOI 来源标识" in r) or ("来源 URL" in r), f"{name} 未由来源族接住: {r}"
  2172	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2173	    dup = item_by_name(data, "重复DOI重复件.md")
  2174	    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "C4 出口也要拦，且证据留痕"
  2175	    skeleton = item_by_name(data, "纯空骨架.md")
  2176	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2177	    assert skeleton["verdict"] == "建议删"
