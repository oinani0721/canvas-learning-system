  2377	def test_nbsp_heading_narrowing_locks_each_consumer(tmp_path):
  2378	    """⛔ round-2 审查 LOW: NBSP 门只直锁正则，`_HEADING_RE` 的三处消费面
  2379	    (`has_substantive_content` / `skeleton_note` / `dup_body`) 仅由端到端间接覆盖。
  2380	    本门对三处各下一条纯函数断言 —— 未来任一消费点改口径会当场红。
  2381	    """
  2382	    mod = load_module()
  2383	    nbsp_line = "#\u00a0keep\n"
  2384	    tab_line = "#\t\n"
  2385	
  2386	    # ① has_substantive_content：NBSP 行是正文，制表符行是标题（无正文）
  2387	    assert mod.has_substantive_content(nbsp_line) is True
  2388	    assert mod.has_substantive_content(tab_line) is False
  2389	
  2390	    # ② skeleton_note：NBSP 行不得被计入「标题 N 行」
  2391	    note_nbsp = mod.skeleton_note(nbsp_line, len(nbsp_line.encode()))
  2392	    assert "标题 0 行" in note_nbsp, note_nbsp
  2393	    note_tab = mod.skeleton_note(tab_line, len(tab_line.encode()))
  2394	    assert "标题 1 行" in note_tab, note_tab  # 空标题仍被计为标题行
  2395	
  2396	    # ③ dup_body：标题不进比对，故 NBSP 行必须**留在**归一化正文里
  2397	    assert mod.dup_body(nbsp_line) == "#\u00a0keep", mod.dup_body(nbsp_line)
  2398	    assert mod.dup_body(tab_line) == "", mod.dup_body(tab_line)
  2399	    # 连带：两份只差「井号后是 NBSP 还是制表符」的文件不得被判逐字相等
  2400	    assert mod.dup_body(nbsp_line) != mod.dup_body(tab_line)
