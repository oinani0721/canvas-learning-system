  1009	def _norm_fm_key(k: str) -> str:
  1010	    """frontmatter 键名归一：casefold + `-`→`_`。
  1011	
  1012	    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
  1013	    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
  1014	    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
  1015	    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
  1016	    """
  1017	    return k.casefold().replace("-", "_")
