   752	def has_substantive_content(text: str) -> bool:
   753	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   754	
   755	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   756	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   757	    合用一个函数正是 Codex BLOCKER 的根因。
   758	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   759	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   760	    （round-3 自审 B3-3）。
   761	    """
   762	    for ln, kind in _classify_lines_typed(text)[0]:
   763	        if kind == "code":
   764	            if ln.strip():
   765	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   766	            continue
   767	        if kind == "fence":
   768	            continue
   769	        if _HEADING_RE.match(ln):
   770	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   771	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   772	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   773	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   774	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   775	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   776	            # 替用户决定。
   777	            # ⛔ **声明收窄（第五轮终审实测证伪）**：本裁决只关闭 **C3 那一半**。
   778	            # C4 侧 `dup_body()` 仍把标题整行丢掉再比对，所以
   779	            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
   780	            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
   781	            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
   782	            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
   783	            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
   784	            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
   785	            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
   786	            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
   787	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   788	            # 仍可确定删除的是「一个字都没写」的五种：0 字节 / 纯空行 /
   789	            # 纯分隔线 / 空标题模板（`# ` 后无内容）/ 只有引用符。
   790	            if ln.lstrip(" \t#").strip():
   791	                return True
   792	            continue
   793	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   794	        if t and not _ONLY_STRUCT_RE.match(t):
   795	            return True
   796	    return False
