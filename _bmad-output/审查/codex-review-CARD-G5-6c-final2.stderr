   577	
   578	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   579	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   580	    lines = text.splitlines()
   581	    n = frontmatter_span(lines)
   582	    return (lines[1 : n - 1] if n else []), lines[n:]
