  1617	        # round-5 自审 F6：只挂在 else 曾让「批内重复 + AI 嫌疑」件的理由缺嫌疑面。
  1618	        reason += f"；文头有「{ai_suspect}」字样但按边界规则不算确定自述，请你过目定夺"
  1619	    return finish(
  1620	        "C6_undecided",
  1621	        V_UNSURE,
  1622	        None,
  1623	        None,
  1624	        "无机械判据可施加",
  1625	        False,
  1626	        uncertain_reason=reason,
  1627	        ask=UNDECIDED_ASK,
  1628	    )
