   927	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   928	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   929	
   930	#: ⛔ 护栏级 AI 信号（结构性，不依赖枚举表）：文本含独立「AI」字样即算嫌疑。
   931	#: 「独立」= 左右都**不是 ASCII 字母**（`\bAI\b` 在 CJK 邻接时无词边界 ——
   932	#: round-7 BLOCKER-1：`由AI系统生成` 曾穿透）。有限标记表无论怎么扩都追不上
   933	#: 自然语言的肯定式声明（round-6 BLOCKER-1：`This report was generated by an
   934	#: AI system` 不含任何表项，双层全盲，无正文时掉进 C3 建议删）。本信号只降
   935	#: C6 不裁决 —— C2 确定命中仍走有限表 + 边界规则（宽匹配会给话题提及发确定
   936	#: 归档，那是硬猜）。
   937	_AI_WORD_RE = re.compile(r"(?<![A-Za-z])AI(?![A-Za-z])", re.IGNORECASE)
   938	
   939	#: ⛔ 护栏级**生成断言结构**（round-8 BLOCKER-2）：`generator: 由 GPT-4 生成`
   940	#: 里既没有表项（表只收到 `由 GPT 生成`，`GPT-4` 差一个版本号）也没有独立词
   941	#: 「AI」，三层护栏全盲 → 无正文时掉进 C3 `建议删 + confident=true`。
   942	#: 修法按**声明骨架**而不是**枚举模型名**（卡文 §3 默认裁决）：模型名是开放
   943	#: 集合，`GPT-4` 之后还有 `GPT-4o`/`Claude 3.5`/`Gemini 2.5`/下个月发布的那个，
   944	#: 枚举永远追不上；「由 <某物> 生成」这个断言骨架是闭合的。
   945	#: ⚠️ 只作**未消化信号降 C6**，绝不进 C2：宽匹配给话题提及发确定归档就是硬猜
   946	#: （`由编译器生成`、`generated by hand` 都会命中本条 —— 它们降 C6，方向安全）。
   947	#: 中文：`由` 与 `生成` 之间任意个**非句读**字符（句读收尾防跨句吞成假断言）。
   948	#: ⛔ round-2 审查 BLOCKER：原先写 `{1,40}?` 加了长度上界，于是
   949	#: `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
   950	#: （中间 65 字符）穿透 —— **上界本身就是缝隙**，而当初说「断言骨架是闭合的」
   951	#: 正因为这个上界而不成立。去掉上界后骨架才真的闭合（同一行、中间不跨句读）。
   952	#: 放宽的代价是 `由于…最终生成了报告` 这类也会命中，但那只降 C6（拿不准、不删），
   953	#: 误命中方向安全 —— 用一点召回换掉一条确定删除的路径，是划算的。
   954	_GEN_CLAIM_CN_RE = re.compile(r"由[^。；！？\n]*?生成")
   955	#: 英文：在归一（连续空白折叠为单空格 + casefold）后的行上匹配，故只写单空格。
   956	#: ⛔ round-2 审查 BLOCKER：原先写 `generated by \S`（字面空格 + 非空），于是
   957	#: `Generated by: GPT-4` 穿透 —— `by` 后面是冒号不是空格。改为 `by` 词边界后
   958	#: 允许任意非词字符（冒号/破折号/空格）再要求一个词字符：
   959	#: ⛔ round-3 审查 HIGH：上一版写 `generated by\b\W*\w`，而 `_` 属于 `\w` ——
   960	#: `Generated by_GPT-4` 的 `by` 与 `_` 之间**没有**词边界，整条穿透（C3 与 C4
   961	#: 两个出口都中）。词边界这个概念在这里本来就不对：要判的是「by 是不是一个
   962	#: 完整的词」，直接写成「后面不是字母数字」才准确，分隔符则连下划线一起吃。
   963	#:   `generated by: gpt-4` ✅ / `generated by llama` ✅ / `generated by_gpt-4` ✅
   964	#:   / `generated byte` ❌（by 后面是字母）/ 行尾 `generated by` ❌（没有主语）
   965	_GEN_CLAIM_EN_RE = re.compile(r"generated by(?![^\W_])[\W_]*[^\W_]")
   966	
   967	#: ⛔ 护栏级**生成器声明字段**（round-8 BLOCKER-2 的另一半）：键名本身就是声明。
   968	#: `generator: gpt-4`（值里没有「生成」二字）只有本条能接住，`本文由 GPT-4 生成`
   969	#: 写在正文里（无 frontmatter）只有 `_GEN_CLAIM_*` 能接住 —— 两条互补，都不冗余。
   970	#: 键名归一口径见 `_norm_fm_key`。
   971	_GENERATOR_DECL_KEYS = frozenset(
   972	    {"generator", "generated_by", "ai_generated", "model", "llm", "ai"}
   973	)
   974	
   975	#: ⛔ 来源声明键别名（round-8 HIGH）：`Source: DOI:10.1000/xyz` 的唯一来源标识
   976	#: 曾被当作不存在 —— `"source" in fm` 是**大小写敏感**的字面查找，取不到 `Source`；
   977	#: 而值不含 `http(s)://`，`url_bearing_keys` 也接不住。⚠️ 本别名集合只用于
   978	#: **护栏**：C1 仍只认字面小写 `source` 键（R8 稿约定），DOI 更不冒充 URL 或 C1
   979	#: （卡文 §3 默认裁决）—— 信号只把来源摆上台面降 C6，不给出「留原地/一手」提名。
   980	_SOURCE_DECL_KEYS = frozenset({"source", "sources"})

