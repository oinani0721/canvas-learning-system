  2179	
  2180	def test_any_nonempty_frontmatter_value_blocks_confident_deletion(tmp_path):
  2181	    """⛔ round-2 HIGH → round-3 HIGH: 这条口径**两轮才收敛到位**。
  2182	
  2183	    round-2: `citation: ISBN 978-7-111-54742-6` 不沾 URL 也不沾 DOI，八类信号
  2184	    全盲被判 C3 确定删除。当时的答案是**方向反转** —— 从枚举「危险的键名/值形态」
  2185	    改为枚举「已知无害的键名」白名单，默认拦住。
  2186	    round-3: 白名单被打穿 —— **放行的是键名，可信息在值里**。`title: ISBN 978-…`、
  2187	    `aliases: <馆藏号>`、`title: <这份材料唯一写下的那句话>` 全都因键名在白名单
  2188	    而确定删除；C4 侧更直接，引擎挂着「正文重复证据不覆盖这些元数据」的冲突却
  2189	    仍 confident=true。
  2190	    「这个键名无害」是个无法机械成立的断言：`title` 可能是一句 t，也可能是这份
  2191	    材料唯一写下来的东西 —— 引擎分不出，分不出就不能替用户决定。
  2192	    现口径: frontmatter 里**任何非空值**都让 C3/C4 让位给 C6。
  2193	    """
  2194	    vault, out = base_vault(tmp_path)
  2195	    inbox = vault / "_待处理"
  2196	    # round-2 原始反例
  2197	    mk(inbox / "ISBN来源.md", "---\ncitation: ISBN 978-7-111-54742-6\n---\n", age_days=9)
  2198	    mk(inbox / "馆藏号.md", "---\nshelfmark: TP311.13/K92-3\n---\n", age_days=8)
  2199	    # ⛔ round-3 反例: 信息藏在**白名单键**的值里
  2200	    mk(inbox / "标题即来源.md", "---\ntitle: ISBN 978-7-111-54742-6\n---\n", age_days=7)
  2201	    mk(inbox / "别名即馆藏.md", "---\naliases: TP311.13/K92-3\n---\n", age_days=6)
  2202	    mk(inbox / "标题即唯一内容.md", "---\ntitle: 微积分基本定理的两种证法\n---\n", age_days=5)
  2203	    # C4 出口同样要拦
  2204	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2205	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2206	    mk(inbox / "标题独有重复件.md", "---\ntitle: 只有这里写了出处\n---\n" + body, age_days=4)
  2207	    # ⛔ 正向对照(验伪锚): C3 在新口径下的三种可达面，一条都不能失守
  2208	    mk(inbox / "零字节.md", "", age_days=3)
  2209	    mk(inbox / "无fm骨架.md", "# \n\n## \n", age_days=2)
  2210	    mk(inbox / "全空值fm骨架.md", "---\ntitle:\ntags:\n---\n\n# \n", age_days=1)
  2211	
  2212	    assert run_cli(vault, out).returncode == 0
  2213	    data = load_json(out)
  2214	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2215	    for name, frag in (
  2216	        ("ISBN来源.md", "978-7-111-54742-6"),
  2217	        ("馆藏号.md", "TP311.13/K92-3"),
  2218	        ("标题即来源.md", "978-7-111-54742-6"),
  2219	        ("别名即馆藏.md", "TP311.13/K92-3"),
  2220	        ("标题即唯一内容.md", "微积分基本定理的两种证法"),
  2221	        ("标题独有重复件.md", "只有这里写了出处"),
  2222	    ):
  2223	        it = item_by_name(data, name)
  2224	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2225	        assert it["criterion"] == "C6_undecided", name
  2226	        assert it["confident"] is False, name
  2227	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2228	        # ⛔ 值必须逐字留痕 —— 拦住了却把线索一起吞掉等于没拦
  2229	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2230	    assert item_by_name(data, "标题独有重复件.md")["exact_duplicate_of"] == "节点/库内正本.md"
  2231	    # ⛔ C3 的三种可达面: 一条都不能失守，否则「少删」就变成了「判据死了」
  2232	    for name in ("零字节.md", "无fm骨架.md", "全空值fm骨架.md"):
  2233	        ctrl = item_by_name(data, name)
  2234	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2235	        assert ctrl["verdict"] == "建议删", name
  2236	        assert ctrl["confident"] is True, name
