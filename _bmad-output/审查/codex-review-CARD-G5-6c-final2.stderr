   314	    mk(vault / "节点" / "长文正本.md", "# 正本\n\n" + "\n".join(lines) + "\n", age_days=40)
   315	    mutated = list(lines)
   316	    mutated[7] = "第 8 行被我改写过, 因此不是逐字重复。"
   317	    mk(vault / "_待处理" / "长文疑似.md", "# 疑似\n\n" + "\n".join(mutated) + "\n", age_days=2)
