   221	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   222	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   223	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   224	    failed = {
   225	        ln.split("::")[1].split(" ")[0].strip()
   226	        for ln in out.splitlines()
   227	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   228	    }
   229	    tail = [
   230	        ln
   231	        for ln in out.splitlines()
   232	        if "passed" in ln or "failed" in ln or "error" in ln
   233	    ]
   234	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
