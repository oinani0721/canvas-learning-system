   499	# ───────────────────────────── 时间 ─────────────────────────────
   500	
   501	
   502	def parse_now(raw: str) -> datetime:
   503	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   504	    try:
   505	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   506	    except ValueError as e:
   507	        raise SystemExit(
   508	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   509	        ) from e
   510	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   511	
   512	
   513	def _epoch_s(dt: datetime) -> float:
   514	    return dt.timestamp()
   515	
   516	
   517	def days_between(now_s: float, then_s: float) -> int:
   518	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   519	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   520	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   521	    return int(round(now_s - then_s)) // 86400
   522	
   523	
   524	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   525	UNREPRESENTABLE = "unrepresentable"
   526	
   527	
   528	def _fmt(sec: float, tz, pattern: str) -> str:
   529	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   530	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   531	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   532	    **不**伪造一个看似正常的时间。"""
   533	    try:
   534	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   535	    except (OverflowError, OSError, ValueError):
   536	        return UNREPRESENTABLE
   537	
   538	
   539	def fmt_utc(sec: float) -> str:
   540	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   541	
   542	
   543	def fmt_local(sec: float) -> str:
   544	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
   545	
   546	
   547	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   548	
   549	
   550	def frontmatter_span(lines: list[str]) -> int:
   551	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   552	
   553	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   554	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   555	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   556	    行号是给人核对用的，偏了就等于没有。
   557	    """
   558	    if not lines or lines[0].strip() != "---":
   559	        return 0
   560	    end = None
   561	    for i in range(1, len(lines)):
   562	        if lines[i].strip() in ("---", "..."):
   563	            end = i
   564	            break
   565	    if end is None:
   566	        return 0  # 缺闭合 → 视为无 frontmatter
   567	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   568	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   569	    # 空文件的删除提名，比不提名坏得多。
   570	    for ln in lines[1:end]:
   571	        t = ln.strip()
   572	        if not t or t.startswith("#"):
   573	            continue  # 空行与 YAML 注释不作数
   574	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   575	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   576	
   577	
   578	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   579	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   580	    lines = text.splitlines()
   581	    n = frontmatter_span(lines)
   582	    return (lines[1 : n - 1] if n else []), lines[n:]
   583	
   584	
   585	def _clean_fm_value(raw: str) -> str:
   586	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   587	
   588	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   589	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   590	    （round-3 自审 H1-6）。
   591	    """
   592	    val = (raw or "").strip()
   593	    val = re.sub(r"\s+#.*$", "", val).strip()
   594	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   595	        val = val[1:-1]
   596	    return val
   597	
   598	
   599	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   600	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   601	
   602	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   603	    于是
   604	
   605	        ---
   606	        doi:
   607	        doi: 10.1000/hidden
   608	        ---
   609	
   610	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   611	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   612	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   613	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   614	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   615	    """
   616	    out: list[tuple[str, str]] = []
   617	    for ln in fm_lines:
   618	        m = _FM_KEY_RE.match(ln)
   619	        if m:
   620	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   621	    return out
   622	
   623	
   624	def frontmatter_map(fm_lines: list[str]) -> dict:
   625	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   626	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   627	    `frontmatter_pairs`。"""
   628	    out: dict[str, str] = {}
   629	    for k, v in frontmatter_pairs(fm_lines):
   630	        out.setdefault(k, v)
   631	    return out
   632	
   633	
   634	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
   635	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。
   636	
   637	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   638	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   639	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   640	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   641	    分隔行由状态机精确标记，内容行一律是内容。
   642	
   643	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   644	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   645	
   646	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   647	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   648	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   649	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   650	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   651	    """
   652	    _, rest = split_frontmatter(text)
   653	    rows: list[tuple[str, str]] = []
   654	    stripped_comments: list[str] = []
   655	    in_fence = False
   656	    fence_char = ""
   657	    fence_len = 0
   658	    in_comment = False
   659	    for ln in rest:
   660	        m = _FENCE_RE.match(ln)
   661	        if m and not in_comment:
   662	            tok = m.group(1)
   663	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   664	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   665	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   666	            # 的 info string 允许反引号，不受此限。
   667	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   668	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   669	                rows.append((ln, "fence"))
   670	                continue
   671	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   672	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   673	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   674	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   675	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   676	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   677	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   678	            # 在 CommonMark 里是围栏内容）。
   679	            if (
   680	                tok[0] == fence_char
   681	                and len(tok) >= fence_len
   682	                and all(c in " \t" for c in ln[m.end() :])
   683	            ):
   684	                in_fence, fence_char, fence_len = False, "", 0
   685	                rows.append((ln, "fence"))
   686	                continue
   687	        if in_fence:
   688	            rows.append((ln, "code"))
   689	            continue
   690	        kept, rem = "", ln
   691	        while rem:
   692	            if in_comment:
   693	                i = rem.find("-->")
   694	                if i < 0:
   695	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   696	                    # （只收了闭合那一行的 `rem[:i]`），于是
   697	                    #   <!--
   698	                    #   source: https://…
   699	                    #   -->
   700	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   701	                    stripped_comments.append(rem)
   702	                    break
   703	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   704	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   705	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   706	                stripped_comments.append(rem[:i])
   707	                rem, in_comment = rem[i + 3 :], False
   708	            else:
   709	                i = rem.find("<!--")
   710	                if i < 0:
   711	                    kept += rem
   712	                    break
   713	                kept += rem[:i]
   714	                rem, in_comment = rem[i + 4 :], True
   715	        rows.append((kept, "text"))
   716	        # ⛔ round-3 审查 HIGH：闭合注释被这里整段剥掉，而来源/生成信号只扫
   717	        # frontmatter，⑨ 兜底也只覆盖 frontmatter —— 于是
   718	        # `<!-- source: https://… -->`、`<!-- DOI:10.1000/… -->`、
   719	        # `<!-- citation: ISBN … -->` 这类「唯一信息写在注释里」的文件
   720	        # C3/C4 双出口全穿。只有**未闭合**注释受保护，闭合的反而不受。
   721	        # 注释内容在上面的闭合分支里逐段收集，与「未闭合注释」对称地作信号。
   722	    return rows, in_comment, stripped_comments
   723	
   724	
   725	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   726	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   727	    三态细节见 `_classify_lines_typed`。"""
   728	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   729	
   730	
   731	def dup_body(text: str) -> str:
   732	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   733	
   734	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   735	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   736	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   737	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   738	    有后果的提名，依据必须逐字。
   739	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   740	    """
   741	    parts: list[str] = []
   742	    for ln, is_code in _classify_lines(text):
   743	        if not is_code and _HEADING_RE.match(ln):
   744	            continue
   745	        t = ln.rstrip()
   746	        if not t:
   747	            continue
   748	        parts.append(nfc(t))
   749	    return "\n".join(parts)
   750	
   751	
   752	def has_substantive_content(text: str) -> bool:
   753	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   754	
   755	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   756	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   757	    合用一个函数正是 Codex BLOCKER 的根因。
   758	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   759	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   760	    （round-3 自审 B3-3）。
   761	    """
   762	    for ln, kind in _classify_lines_typed(text)[0]:
   763	        if kind == "code":
   764	            if ln.strip():
   765	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   766	            continue
   767	        if kind == "fence":
   768	            continue
   769	        if _HEADING_RE.match(ln):
   770	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   771	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   772	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   773	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   774	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   775	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   776	            # 替用户决定。
   777	            # ⛔ **声明收窄（第五轮终审实测证伪）**：本裁决只关闭 **C3 那一半**。
   778	            # C4 侧 `dup_body()` 仍把标题整行丢掉再比对，所以
   779	            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
   780	            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
   781	            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
   782	            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
   783	            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
   784	            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
   785	            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
   786	            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
   787	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   788	            # 仍可确定删除的是「一个字都没写」的五种：0 字节 / 纯空行 /
   789	            # 纯分隔线 / 空标题模板（`# ` 后无内容）/ 只有引用符。
   790	            if ln.lstrip(" \t#").strip():
   791	                return True
   792	            continue
   793	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   794	        if t and not _ONLY_STRUCT_RE.match(t):
   795	            return True
   796	    return False
   797	
   798	
   799	def skeleton_note(text: str, size: int) -> str:
   800	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   801	
   802	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   803	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   804	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   805	    """
   806	    if size == 0:
   807	        return "0 字节空文件"
   808	    rows = _classify_lines_typed(text)[0]
   809	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   810	    struct = sum(
   811	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   812	    )
   813	    fences = sum(1 for _, k in rows if k == "fence")
   814	    return (
   815	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   816	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   817	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   818	    )
   819	
   820	
   821	def head_window(text: str) -> list[tuple[int, str]]:
   822	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   823	    lines = text.splitlines()
   824	    n = frontmatter_span(lines)
   825	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   826	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   827	        win.append((n + j + 1, ln))
   828	    return win
   829	
   830	
   831	def _norm_ai_line(ln: str) -> str:
   832	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   833	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   834	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   835	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   836	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   837	    return " ".join(ln.split()).casefold()
   838	
   839	
   840	#: 不可见字符：**按 Unicode 类别判定，不枚举**。
   841	#: ⛔ round-3 审查 BLOCKER：上一版写成六个码点的有限表
   842	#: （ZWSP/ZWNJ/ZWJ/WORD JOINER/BOM/SOFT HYPHEN），于是 U+2063 INVISIBLE
   843	#: SEPARATOR 以及 U+200E/200F/061C/034F/FE0F/2062/180E/202E 共 9 个同族**全部
   844	#: 穿透**，C3 与 C4 两个出口都中。这与 round-2 的模型名教训是同一件事：
   845	#: **不可见字符不是一张能数完的表**，判它得按类别而不是按名单。
   846	#:   Cf = 格式字符（零宽空格/连接符/双向控制/不可见分隔符…）
   847	#:   Mn = 非间距标记（VS16、CGJ 这类零宽度记号）
   848	#:   Cc = 控制字符
   849	#: ⚠️ 只用在**护栏匹配面**：剥掉组合记号会改变带重音文本的词形，但护栏只判
   850	#: 「这行像不像生成声明」，方向是更容易命中；产物输出一律走原文，不受影响。
   851	#: ⛔ **类别判定同样不完备，如实登记原理上限**（round-4 验证实测）：
   852	#: `U+3164 HANGUL FILLER`（Lo，字母）与 `U+2800 BRAILLE PATTERN BLANK`（So，符号）
   853	#: 在屏幕上是空白，但 Unicode 把它们归为字母/符号，`isspace()` 也是 False ——
   854	#: 机械上它们就是普通字符。把 Lo/So 整类剥掉会连正常韩文与盲文一起剥，那是
   855	#: 更坏的交易。**「视觉上不可见」需要字形宽度数据才判得了，不是字符属性能决定的**，
   856	#: 因此 `# Genera<U+3164>ted by GPT-4` 这类构造仍会落 C3 建议删。
   857	#: 结构化的兜底得改 C3 对**标题行**的处理（现在标题不算实质正文），那是判据面
   858	#: 的语义变更，超出 CARD-G5-6c 范围 —— 登记待裁决，不在本卡内改。
   859	_INVISIBLE_CATEGORIES = frozenset({"Cf", "Mn", "Cc"})
   860	
   861	
   862	def _strip_invisible(s: str, repl: str) -> str:
   863	    """把不可见字符替换成 `repl`（`" "` 还原词间分隔；`""` 还原词内断裂）。
   864	
   865	    ⛔ round-4 验证 BLOCKER 的一半：**删版必须连空白类一起删**。
   866	    `Genera<U+200A>ted`（HAIR SPACE，Zs）此前只被 `_norm_ai_line` 的 `split()`
   867	    折叠成普通空格，词照样是拆开的 —— 删版不删它，两个变体就都还原不出
   868	    `generated`。
   869	    ⚠️ 但删版**保留 ASCII 空格与制表符**：把它们也删掉，`generated by GPT-4`
   870	    在删版里就成了 `generatedbyGPT-4`，骨架永远认不出，删版等于自废。
   871	    要删的是「看不见、又不是正常词间空格」的那一类 —— Cf/Mn/Cc 加上**非 ASCII**
   872	    的空白（Zs/Zl/Zp，如 HAIR SPACE）。两个变体这才真正互补：
   873	      `Genera<U+200A>ted by GPT-4` → 删版还原出 `Generated by GPT-4`；
   874	      `Generated<U+200A>by GPT-4`  → 换空格版还原出 `Generated by GPT-4`。
   875	    """
   876	    return "".join(
   877	        repl
   878	        if (
   879	            unicodedata.category(c) in _INVISIBLE_CATEGORIES
   880	            or (c.isspace() and c not in " \t")
   881	        )
   882	        else c
   883	        for c in s
   884	    )
   885	
   886	
   887	def _guard_variants(ln: str) -> tuple[str, str]:
   888	    """护栏归一的**两种**零宽还原，都要试。
   889	
   890	    ⛔ round-3 审查 BLOCKER：上一版只做「零宽→空格」，那只对**词间**插入成立
   891	    （`by<ZWSP>GPT` → `by GPT`）。零宽插在**词内部**时（`genera<ZWSP>ted`），
   892	    换空格反而把关键词拆成 `genera ted`，骨架与标记表一起失效 —— 比不处理更糟。
   893	    两种还原互补，没有哪一种单独够用：
   894	      · 换空格：还原词间分隔（`by<ZWSP>GPT` → `by gpt`）；
   895	      · 直接删：还原词内断裂（`genera<ZWSP>ted` → `generated`）。
   896	    调用方对两个变体分别匹配，任一命中即算 —— 护栏宁可宽。
   897	    """
   898	    return (
   899	        _norm_ai_line(_strip_invisible(ln, " ")),
   900	        _norm_ai_line(_strip_invisible(ln, "")),
   901	    )
   902	
   903	
   904	def _norm_guard_line(ln: str) -> str:
   905	    """**护栏专用**归一：先把零宽字符换成空格，再走 `_norm_ai_line`。
   906	
   907	    ⛔ 刻意与 C2 判据用的 `_norm_ai_line` 分家，不是图省事：C2 命中意味着
   908	    「AI 自述 · 确定归档 · confident=true」，是**有后果的提名**，扩大它的命中面
   909	    必须是明写的决定；护栏只降 C6，宽一点的代价仅是少几条「建议删」。
   910	    两者混用等于让一次护栏加宽顺带扩大确定提名面。
   911	
   912	    ⚠️ **承重面如实声明**（round-2 负控 M-ZEROWIDTH 实测，别高估这一层）：
   913	    回退本函数后套件**一门都不红**，因为 `Generated by<ZWSP>GPT-4` 与
   914	    `本文由<ZWSP>X<ZWSP>生成` 在 `_norm_ai_line` 下**已经**命中骨架 ——
   915	    `_GEN_CLAIM_EN_RE` 的非词字符段会吃掉零宽（Cf 类不算词字符），
   916	    `_GEN_CLAIM_CN_RE` 的非句读字符类同样吃它。一条修法顺手覆盖了另一条。
   917	    本函数真正承重的只有 `raw_ai_marker`：零宽插在标记表项**中间**时
   918	    （`Generated by<ZWSP>AI Lab`、`由<ZWSP>AI<ZWSP>生成`），不剥零宽就匹配不到
   919	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
   920	    ⚠️ 所以它是一层**理由质量**而非安全底线：两种情况下材料都不会被删，
   921	    差别只在 `uncertain_reason` 说的是「疑似 AI 自述」还是「生成断言结构」。
   922	    留着它是因为前者对人更有用；但不要把它写成安全防线。
   923	    """
   924	    return _norm_ai_line(_strip_invisible(ln, " "))
