  1864	    total = len(items_raw)
  1865	    batch_raw = items_raw[:batch_size]
  1866	    deferred = [
  1867	        {
  1868	            "name": it["name"],
  1869	            "age_days": it["age_days"],
  1870	            "mtime_local": it["mtime_local"],
  1871	        }
  1872	        for it in items_raw[batch_size:]
