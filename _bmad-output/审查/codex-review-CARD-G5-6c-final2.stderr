  1740	def build_sleeping(inbox: Path, now_s: float, exists: bool) -> dict:
  1741	    d = inbox / SLEEPING_DIR_NAME
  1742	    if not exists or not d.is_dir() or d.is_symlink():
  1743	        return {
  1744	            "dir": f"{inbox.name}/{SLEEPING_DIR_NAME}",
  1745	            "exists": False,
  1746	            "count": 0,
  1747	            "oldest_days": None,
  1748	            "over_30d_count": 0,
  1749	            "alert_threshold_days": SLEEP_ALERT_DAYS,
  1750	            "items": [],
  1751	            "skipped": [],
  1752	        }
  1753	    out: list[dict] = []
  1754	    skipped: list[dict] = []
  1755	    with os.scandir(d) as it:
  1756	        entries = sorted(it, key=lambda e: e.name)
  1757	    for entry in entries:
  1758	        # ⛔ 与收件箱同一条纪律：跳过必须留痕，不静默消失。
  1759	        if entry.is_symlink():
  1760	            skipped.append({"name": entry.name, "reason": "条目是 symlink，不跟随"})
  1761	            continue
  1762	        if entry.is_dir():
  1763	            skipped.append(
  1764	                {"name": entry.name, "reason": "Sleeping/ 下的子目录不计入台账"}
  1765	            )
  1766	            continue
  1767	        p = Path(entry.path)
  1768	        try:
  1769	            st = p.stat()
  1770	        except OSError as e:
  1771	            skipped.append(
  1772	                {
  1773	                    "name": entry.name,
  1774	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1775	                }
  1776	            )
  1777	            continue
  1778	        source, slept_at, days = (
  1779	            "mtime",
  1780	            fmt_utc(st.st_mtime),
  1781	            days_between(now_s, st.st_mtime),
  1782	        )
  1783	        text = read_text_or_none(p)
  1784	        if text is not None:
  1785	            raw = frontmatter_map(split_frontmatter(text)[0]).get("slept_at", "")
  1786	            parsed = _parse_slept_at(raw)
  1787	            if parsed is not None:
  1788	                source, slept_at = "frontmatter", raw
  1789	                days = days_between(now_s, _epoch_s(parsed))
  1790	            elif raw:
  1791	                source = "mtime(frontmatter slept_at 不可解析，如实退回文件 mtime)"
  1792	        out.append(
  1793	            {
  1794	                "name": entry.name,
  1795	                "slept_at": slept_at,
  1796	                "slept_at_source": source,
  1797	                "slept_days": days,
  1798	                "over_30d": days >= SLEEP_ALERT_DAYS,
  1799	            }
  1800	        )
  1801	    out.sort(key=lambda x: (-x["slept_days"], x["name"]))
  1802	    return {
  1803	        "dir": f"{inbox.name}/{SLEEPING_DIR_NAME}",
  1804	        "exists": True,
  1805	        "count": len(out),
  1806	        "oldest_days": max((x["slept_days"] for x in out), default=None),
  1807	        "over_30d_count": sum(1 for x in out if x["over_30d"]),
  1808	        "alert_threshold_days": SLEEP_ALERT_DAYS,
  1809	        "items": out,
  1810	        "skipped": skipped,
  1811	    }
  1812	
  1813	
  1814	def _parse_slept_at(raw: str) -> datetime | None:
  1815	    if not raw:
  1816	        return None
  1817	    try:
  1818	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  1819	    except ValueError:
  1820	        try:
  1821	            d = date.fromisoformat(raw)
  1822	        except ValueError:
  1823	            return None
  1824	        dt = datetime(d.year, d.month, d.day)
  1825	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
  1826	
