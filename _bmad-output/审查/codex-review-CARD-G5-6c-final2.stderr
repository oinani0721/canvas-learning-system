     1	#!/usr/bin/env python3
     2	"""CARD-G5-6c round-8 三条新反例的 tmp fixture 落盘 + 字节自证。
     3	
     4	不可见字符一律走 \\uXXXX 转义写，禁止在源码里直接敲 —— 编辑器/工具链
     5	会把 NBSP 与普通空格互换，肉眼与 diff 都看不出来。
     6	"""
     7	
     8	import pathlib
     9	import sys
    10	
    11	REPRO = pathlib.Path(sys.argv[1])
    12	
    13	CASES = {
    14	    # round-8 BLOCKER-1：`#` + U+00A0 + `keep` + 换行，权威字节 23c2a06b6565700a
    15	    "NEW_HEADING": ("hash-NBSP.md", "#\u00a0keep\n"),
    16	    # round-8 BLOCKER-2：带模型版本的真实生成声明
    17	    "NEW_AI": ("GPT4声明.md", "---\ngenerator: 由 GPT-4 生成\n---\n"),
    18	    # round-8 HIGH：大写 Source 键 + DOI 来源标识
    19	    "NEW_SOURCE": ("DOI来源.md", "---\nSource: DOI:10.1000/xyz\n---\n"),
    20	}
    21	
    22	EXPECTED_HEX = {"NEW_HEADING": "23c2a06b6565700a"}
    23	
    24	for key, (name, body) in CASES.items():
    25	    p = REPRO / key / "vault" / "_待处理" / name
    26	    # ⛔ round-2 审查 MEDIUM：原先只 write_bytes，在**全新目标目录**下必然
    27	    # FileNotFoundError —— 取证脚本只在我自己那次已经手工建好目录的环境里能跑，
    28	    # 复现者拿到手是坏的。取证包必须自足。
    29	    p.parent.mkdir(parents=True, exist_ok=True)
    30	    (REPRO / key / "out").mkdir(parents=True, exist_ok=True)
    31	    raw = body.encode("utf-8")
    32	    p.write_bytes(raw)
