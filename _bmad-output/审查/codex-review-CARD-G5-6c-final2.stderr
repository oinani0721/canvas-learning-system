 for n in tree.body:
  key=n.name if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) else next((t.id for t in n.targets if isinstance(t,ast.Name)),None) if isinstance(n,(ast.Assign,ast.AnnAssign)) else None
  if key in names: out[key]=ast.dump(n,include_attributes=False)
 return out
