  1193	def near_duplicates(
  1194	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
  1195	) -> list[dict]:
  1196	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
  1197	    if not body:
  1198	        return []
  1199	    a_lines = body.split("\n")
  1200	    la = len(body)
  1201	    hits: list[tuple[float, str]] = []
