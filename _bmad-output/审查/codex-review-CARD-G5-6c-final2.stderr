  1828	def build_receipt(data: dict) -> str:
  1829	    inv, sl = data["inventory"], data["sleeping"]
  1830	    if not data["inbox_exists"]:
  1831	        head = f"{data['inbox_dir']} 尚未创建（等同空仓，该 vault 还没开始用收件箱）。"
  1832	    elif inv["total"] == 0:
  1833	        head = f"{data['inbox_dir']} 已空，没有待处理材料。"
  1834	    else:
  1835	        head = f"{data['inbox_dir']} 共 {inv['total']} 件" + (
  1836	            f"，本批取最旧的 {len(data['items'])} 件（其余 {len(inv['deferred'])} 件留待下次）。"
  1837	            if inv["over_budget"]
  1838	            else f"，本批全取（{len(data['items'])} 件）。"
  1839	        )
  1840	    if not sl["exists"]:
  1841	        tail = "Sleeping/ 未建立，无睡眠台账。"
  1842	    elif sl["count"] == 0:
  1843	        tail = "Sleeping/ 是空的。"
  1844	    else:
  1845	        tail = f"Sleeping 睡着 {sl['count']} 件（最久 {sl['oldest_days']} 天"
  1846	        tail += (
  1847	            f"，其中 {sl['over_30d_count']} 件已睡满 {SLEEP_ALERT_DAYS} 天 ⚠️）。"
  1848	            if sl["over_30d_count"]
  1849	            else "）。"
  1850	        )
  1851	    return head + " " + tail
  1852	
