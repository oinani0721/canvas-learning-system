  1672	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1673	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1674	    items: list[dict] = []
  1675	    skipped: list[dict] = []
  1676	    with os.scandir(inbox) as it:
  1677	        entries = sorted(it, key=lambda e: e.name)
  1678	    for entry in entries:
  1679	        p = Path(entry.path)
  1680	        if entry.is_symlink():
  1681	            skipped.append(
  1682	                {
  1683	                    "name": entry.name,
  1684	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1685	                }
  1686	            )
  1687	            continue
  1688	        if entry.is_dir():
  1689	            if entry.name == SLEEPING_DIR_NAME:
  1690	                continue  # 走 Sleeping 台账
  1691	            skipped.append(
  1692	                {
  1693	                    "name": entry.name,
  1694	                    "reason": "子目录不在本卡盘点范围（只盘点顶层文件与 Sleeping/ 台账）",
  1695	                }
  1696	            )
  1697	            continue
  1698	        if not entry.is_file():
  1699	            # FIFO / 设备 / 套接字：read_bytes 可能直接阻塞，绝不碰
  1700	            skipped.append(
  1701	                {
  1702	                    "name": entry.name,
  1703	                    "reason": "不是普通文件（FIFO / 设备 / 套接字等），不读取",
  1704	                }
  1705	            )
  1706	            continue
  1707	        try:
  1708	            st = p.stat()
  1709	        except OSError as e:
  1710	            # 扫目录与取属性之间材料被移走 —— 跳过留痕, 不让一次竞态崩掉整份 preview
  1711	            skipped.append(
  1712	                {
  1713	                    "name": entry.name,
  1714	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1715	                }
  1716	            )
  1717	            continue
  1718	        items.append(
  1719	            {
  1720	                "stable_id": compute_inbox_stable_id(
  1721	                    f"{nfc(inbox.name)}/{nfc(entry.name)}"
  1722	                ),
  1723	                "name": entry.name,
  1724	                "rel_path": f"{inbox.name}/{entry.name}",
  1725	                "size_bytes": st.st_size,
  1726	                "mtime_utc": fmt_utc(st.st_mtime),
  1727	                "mtime_local": fmt_local(st.st_mtime),
  1728	                "age_days": days_between(now_s, st.st_mtime),
  1729	                # 排序用纳秒整数（float 秒会把相差 1ns 的两件折叠成相等，
  1730	                # 于是"最旧优先"退化成按文件名 —— Codex LOW 实证）
  1731	                "_mtime_ns": st.st_mtime_ns,
  1732	                "_path": str(p),
  1733	            }
  1734	        )
  1735	    # 最旧优先；同 mtime 按名字升序 —— 二跑同序的唯一保证
  1736	    items.sort(key=lambda d: (d["_mtime_ns"], d["name"]))
  1737	    return items, skipped
  1738	
