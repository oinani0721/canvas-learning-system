  1878	        "body_char_cap": NEAR_DUP_BODY_CHAR_CAP,
  1879	        "length_prefilter_ratio": NEAR_DUP_LEN_RATIO,
  1880	        "top_n_reported": NEAR_DUP_TOP_N,
  1881	        "compared_pairs": 0,
  1882	        "skipped_oversize": 0,
  1883	        "skipped_length_prefilter": 0,
  1884	        "note": "「跳过」≠「无重复」：跳过的对从未比对过，产物如实分列两个计数。",
  1885	    }
  1886	
  1887	    texts = {it["rel_path"]: read_text_or_none(Path(it["_path"])) for it in batch_raw}
  1888	    batch_body_counts: dict[str, int] = {}
  1889	    for it in batch_raw:
  1890	        t = texts[it["rel_path"]]
  1891	        if t is None:
  1892	            continue
  1893	        b = dup_body(t) if has_substantive_content(t) else ""
  1894	        if b:
  1895	            batch_body_counts[b] = batch_body_counts.get(b, 0) + 1
  1896	
  1897	    items: list[dict] = []
  1898	    for idx, it in enumerate(batch_raw, start=1):
  1899	        text = texts[it["rel_path"]]
  1900	        base = {k: v for k, v in it.items() if not k.startswith("_")}

