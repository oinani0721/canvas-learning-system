   886	def _strip_invisible(s: str, repl: str) -> str:
   887	    """把不可见字符替换成 `repl`（`" "` 还原词间分隔；`""` 还原词内断裂）。
   888	
   889	    ⛔ round-4 验证 BLOCKER 的一半：**删版必须连空白类一起删**。
   890	    `Genera<U+200A>ted`（HAIR SPACE，Zs）此前只被 `_norm_ai_line` 的 `split()`
   891	    折叠成普通空格，词照样是拆开的 —— 删版不删它，两个变体就都还原不出
   892	    `generated`。
   893	    ⚠️ 但删版**保留 ASCII 空格与制表符**：把它们也删掉，`generated by GPT-4`
   894	    在删版里就成了 `generatedbyGPT-4`，骨架永远认不出，删版等于自废。
   895	    要删的是「看不见、又不是正常词间空格」的那一类 —— Cf/Mn/Cc 加上**非 ASCII**
   896	    的空白（Zs/Zl/Zp，如 HAIR SPACE）。两个变体这才真正互补：
   897	      `Genera<U+200A>ted by GPT-4` → 删版还原出 `Generated by GPT-4`；
   898	      `Generated<U+200A>by GPT-4`  → 换空格版还原出 `Generated by GPT-4`。
   899	    """
   900	    return "".join(
   901	        repl
   902	        if (
   903	            unicodedata.category(c) in _INVISIBLE_CATEGORIES
   904	            or (c.isspace() and c not in " \t")
   905	        )
   906	        else c
   907	        for c in s
   908	    )
