  1059	        for norm in _guard_variants(ln):
  1060	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
  1061	                m = rx.search(norm)
  1062	                if not m:
  1063	                    continue
