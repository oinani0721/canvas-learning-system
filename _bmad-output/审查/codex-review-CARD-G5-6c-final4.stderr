   911	def _guard_variants(ln: str) -> tuple[str, str]:
   912	    """护栏归一的**两种**零宽还原，都要试。
   913	
   914	    ⛔ round-3 审查 BLOCKER：上一版只做「零宽→空格」，那只对**词间**插入成立
   915	    （`by<ZWSP>GPT` → `by GPT`）。零宽插在**词内部**时（`genera<ZWSP>ted`），
   916	    换空格反而把关键词拆成 `genera ted`，骨架与标记表一起失效 —— 比不处理更糟。
   917	    两种还原互补，没有哪一种单独够用：
   918	      · 换空格：还原词间分隔（`by<ZWSP>GPT` → `by gpt`）；
   919	      · 直接删：还原词内断裂（`genera<ZWSP>ted` → `generated`）。
   920	    调用方对两个变体分别匹配，任一命中即算 —— 护栏宁可宽。
   921	    """
   922	    return (
   923	        _norm_ai_line(_strip_invisible(ln, " ")),
   924	        _norm_ai_line(_strip_invisible(ln, "")),
   925	    )
