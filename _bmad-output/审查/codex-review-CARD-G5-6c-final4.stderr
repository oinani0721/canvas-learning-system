   420	_BAD_LABEL = re.compile(r'[\\/`$"\']|\.\.|^\.|[\x00-\x1f]')
   421	
   422	#: 人话时区：**固定 +08:00**，刻意不走 `ZoneInfo("Asia/Shanghai")`。
   423	#: ⛔ 理由是本卡有「二跑逐字节相等」硬门，而该门必须**跨宿主**成立：ZoneInfo 在装了
   424	#: tzdata 的机器上会给 1986-1991 年的日期套上夏令时（实测 1988-07-01 → +09:00），
   425	#: 没装 tzdata 的机器退化成 +08:00 —— 同一份输入在两台机器产出不同字节。
   426	#: 代价是那六年的历史时刻不带夏令时；收件箱材料不可能有 1980 年代的 mtime，
   427	#: 拿一个不可能发生的历史精度去换一个每次都要成立的确定性，是划算的。
   428	#: （与 `scripts/daily_review_pick.py` 优先 ZoneInfo 的口径有意分歧，理由如上。）
   429	_TZ_SHANGHAI = timezone(timedelta(hours=8))
   430	
   431	#: ATX 标题：**最多 3 个字面空格**缩进（⛔ 与 _FENCE_RE 同口径，\s 会放行
   432	#: 制表符/NBSP —— `\t# keep` 是缩进代码、`\xa0# keep` 是普通正文，都曾被当
   433	#: 标题剥掉 → 空骨架建议删，round-7 BLOCKER-2）。
   434	#: ⛔ **井号后的分隔同样只认 ASCII 空格/制表符**（CommonMark §4.2：开头的 `#`
   435	#: 序列后必须跟空格、制表符或行尾）：round-8 BLOCKER-1 实证前置缩进收窄后
   436	#: 后边界仍写着 `(?:\s|$)`，而 Python `re` 的 `\s` 在 str 模式下是 Unicode
   437	#: 语义 —— `#\xa0keep`（字节 23c2a06b6565700a）被当成标题剥掉 → 「标题 1 行、
   438	#: 实质正文 0 字符」→ `建议删 + confident=true`。同一条规则的两半只修一半，
   439	#: 等于没修。⚠️ 边界如实声明：本条只管**标题判定**；`#` 孤行（`# ` / `#\xa0`
   440	#: 这类井号后无实质内容者）经 `_ONLY_STRUCT_RE` 归入「纯结构行」，与普通空格
   441	#: 版本同桶 —— 那是既有的结构行口径，不是本条收窄出来的新差异。
   442	_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:[ \t]|$)")
   443	_LIST_PREFIX_RE = re.compile(r"^\s*(?:[-*+]\s+|\d{1,3}[.)]\s+|>\s?)+")
   444	#: 纯结构行（分隔线 / 表格分隔 / 空列表符）。⛔ 不含 `~`：`~~~` 是代码围栏标记，
   445	#: 由 `_classify_lines` 的状态机处理；把它当"结构"曾让整段围栏代码凭空消失。
   446	#: ⛔ 第七轮终审 HIGH（R7-H2）：原表含 `=`/`|`/`:`，于是 `:=`、`=>`、`||` 这类
   447	#: **有语义的运算符**被当纯结构忽略，3 字节文件被判空骨架确定删除。
   448	#: 收窄口径：一行只有在**全部由同一种结构字符（加空白）构成**时才算结构行 ——
   449	#: `---`/`***`/`|||`/`>>>` 是结构，`:=`/`=>`/`||=` 是内容。
   450	#: ⚠️ `||` 仍算结构（同字符重复），`:=`/`=>` 不算 —— 这条线画在「混合了不同
   451	#: 结构字符」上，不是「有没有出现结构字符」。
   452	_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
   453	_STRUCT_CHARS = "-=*_|:#>"
   454	
   455	
   456	def _is_structural_line(t: str) -> bool:
   457	    """纯结构行判定（分隔线 / 表格分隔 / 空列表符）。"""
   458	    if not _ONLY_STRUCT_RE.match(t):
   459	        return False
   460	    kinds = {c for c in t if c in _STRUCT_CHARS}
   461	    return len(kinds) <= 1
   462	
   463	
   464	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   465	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   466	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   467	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   468	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   469	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   470	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   471	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   472	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   473	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   474	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   475	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   476	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   477	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   478	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   479	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   480	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   481	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   482	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   483	#: 里仍保留作防御深度。
   484	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
   485	
   486	
   487	def _is_primary_source_url(src: str) -> bool:
   488	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   489	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   490	    if not _URL_RE.match(src):
   491	        return False
   492	    try:
   493	        parts = urlsplit(src)
   494	    except ValueError:
   495	        return False
   496	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   497	
   498	
   499	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
   500	
   501	
   502	# ───────────────────────────── 身份键 ─────────────────────────────
   503	
   504	
   505	def compute_inbox_stable_id(rel_path: str) -> str:
   506	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   507	
   508	    编码纪律复用 `split_preview.compute_stable_id`（长度前缀载荷，对任意字节单射），
   509	    命名空间经 heading-path 槽位注入，返回值改挂自有前缀 —— 见文件头「身份空间
   510	    不可互换」。**不**把 mtime/size/内容进键：那样一改正文就换身份，diff 无意义。
   511	    """
   512	    raw = _SP.compute_stable_id(rel_path, [INBOX_ID_NAMESPACE], 1, INBOX_ID_BASIS)
   513	    return INBOX_ID_PREFIX + raw[len(_SP.STABLE_ID_PREFIX) :]
   514	
   515	
   516	# ───────────────────────────── 时间 ─────────────────────────────
   517	
   518	
   519	def parse_now(raw: str) -> datetime:
   520	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   521	    try:
   522	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   523	    except ValueError as e:
   524	        raise SystemExit(
   525	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   526	        ) from e
   527	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   528	
   529	
   530	def _epoch_s(dt: datetime) -> float:
   531	    return dt.timestamp()
   532	
   533	
   534	def days_between(now_s: float, then_s: float) -> int:
   535	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   536	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   537	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   538	    return int(round(now_s - then_s)) // 86400
   539	
   540	
   541	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   542	UNREPRESENTABLE = "unrepresentable"
   543	
   544	
   545	def _fmt(sec: float, tz, pattern: str) -> str:
   546	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   547	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   548	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   549	    **不**伪造一个看似正常的时间。"""
   550	    try:
   551	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   552	    except (OverflowError, OSError, ValueError):
   553	        return UNREPRESENTABLE
   554	
   555	
   556	def fmt_utc(sec: float) -> str:
   557	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   558	
   559	
   560	def fmt_local(sec: float) -> str:
   561	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
   562	
   563	
   564	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   565	
   566	
   567	def frontmatter_span(lines: list[str]) -> int:
   568	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   569	
   570	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   571	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   572	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   573	    行号是给人核对用的，偏了就等于没有。
   574	    """
   575	    if not lines or lines[0].strip() != "---":
   576	        return 0
   577	    end = None
   578	    for i in range(1, len(lines)):
   579	        if lines[i].strip() in ("---", "..."):
   580	            end = i
   581	            break
   582	    if end is None:
   583	        return 0  # 缺闭合 → 视为无 frontmatter
   584	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   585	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   586	    # 空文件的删除提名，比不提名坏得多。
   587	    for ln in lines[1:end]:
   588	        t = ln.strip()
   589	        if not t or t.startswith("#"):
   590	            continue  # 空行与 YAML 注释不作数
   591	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   592	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   593	
   594	
   595	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   596	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   597	    lines = text.splitlines()
   598	    n = frontmatter_span(lines)
   599	    return (lines[1 : n - 1] if n else []), lines[n:]
   600	
   601	
   602	def _clean_fm_value(raw: str) -> str:
   603	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   604	
   605	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   606	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   607	    （round-3 自审 H1-6）。
   608	    """
   609	    val = (raw or "").strip()
   610	    val = re.sub(r"\s+#.*$", "", val).strip()
   611	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   612	        val = val[1:-1]
   613	    return val
   614	
   615	
   616	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   617	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   618	
   619	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   620	    于是
   621	
   622	        ---
   623	        doi:
   624	        doi: 10.1000/hidden
   625	        ---
   626	
   627	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   628	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   629	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   630	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   631	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   632	    """
   633	    out: list[tuple[str, str]] = []
   634	    for ln in fm_lines:
   635	        m = _FM_KEY_RE.match(ln)
   636	        if m:
   637	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   638	    return out
   639	
   640	
   641	def frontmatter_map(fm_lines: list[str]) -> dict:
   642	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   643	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   644	    `frontmatter_pairs`。"""
   645	    out: dict[str, str] = {}
   646	    for k, v in frontmatter_pairs(fm_lines):
   647	        out.setdefault(k, v)
   648	    return out
   649	
   650	
   651	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
   652	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。
   653	
   654	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   655	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   656	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   657	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   658	    分隔行由状态机精确标记，内容行一律是内容。
   659	
   660	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   661	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   662	
   663	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   664	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   665	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   666	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   667	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   668	    """
   669	    _, rest = split_frontmatter(text)
   670	    rows: list[tuple[str, str]] = []
   671	    stripped_comments: list[str] = []
   672	    in_fence = False
   673	    fence_char = ""
   674	    fence_len = 0
   675	    in_comment = False
   676	    for ln in rest:
   677	        m = _FENCE_RE.match(ln)
   678	        if m and not in_comment:
   679	            tok = m.group(1)
   680	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   681	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   682	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   683	            # 的 info string 允许反引号，不受此限。
   684	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   685	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   686	                # ⛔ 第七轮终审 HIGH（R7-H1）：围栏开启行的 **info string**
   687	                # （`~~~ {source=https://…}`）整行被标成 "fence" 后不进正文，
   688	                # 写在那儿的来源静默消失。这是「来源被引擎剥掉」的**第四种写法**
   689	                # （前三种：跨行 HTML 注释 / fm 整行 YAML 注释 / fm 行尾注释）。
   690	                info = ln[m.end() :].strip()
   691	                if info:
   692	                    stripped_comments.append(info)
   693	                rows.append((ln, "fence"))
   694	                continue
   695	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   696	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   697	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   698	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   699	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   700	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   701	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   702	            # 在 CommonMark 里是围栏内容）。
   703	            if (
   704	                tok[0] == fence_char
   705	                and len(tok) >= fence_len
   706	                and all(c in " \t" for c in ln[m.end() :])
   707	            ):
   708	                in_fence, fence_char, fence_len = False, "", 0
   709	                rows.append((ln, "fence"))
   710	                continue
   711	        if in_fence:
   712	            rows.append((ln, "code"))
   713	            continue
   714	        kept, rem = "", ln
   715	        while rem:
   716	            if in_comment:
   717	                i = rem.find("-->")
   718	                if i < 0:
   719	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   720	                    # （只收了闭合那一行的 `rem[:i]`），于是
   721	                    #   <!--
   722	                    #   source: https://…
   723	                    #   -->
   724	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   725	                    stripped_comments.append(rem)
   726	                    break
   727	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   728	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   729	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   730	                stripped_comments.append(rem[:i])
   731	                rem, in_comment = rem[i + 3 :], False
   732	            else:
   733	                i = rem.find("<!--")
   734	                if i < 0:
   735	                    kept += rem
   736	                    break
   737	                kept += rem[:i]
   738	                rem, in_comment = rem[i + 4 :], True
   739	        rows.append((kept, "text"))
   740	        # ⛔ round-3 审查 HIGH：闭合注释被这里整段剥掉，而来源/生成信号只扫
   741	        # frontmatter，⑨ 兜底也只覆盖 frontmatter —— 于是
   742	        # `<!-- source: https://… -->`、`<!-- DOI:10.1000/… -->`、
   743	        # `<!-- citation: ISBN … -->` 这类「唯一信息写在注释里」的文件
   744	        # C3/C4 双出口全穿。只有**未闭合**注释受保护，闭合的反而不受。
   745	        # 注释内容在上面的闭合分支里逐段收集，与「未闭合注释」对称地作信号。
   746	    return rows, in_comment, stripped_comments
   747	
   748	
   749	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   750	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   751	    三态细节见 `_classify_lines_typed`。"""
   752	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   753	
   754	
   755	def dup_body(text: str) -> str:
   756	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   757	
   758	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   759	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   760	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   761	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   762	    有后果的提名，依据必须逐字。
   763	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   764	    """
   765	    parts: list[str] = []
   766	    for ln, is_code in _classify_lines(text):
   767	        if not is_code and _HEADING_RE.match(ln):
   768	            continue
   769	        t = ln.rstrip()
   770	        if not t:
   771	            continue
   772	        parts.append(nfc(t))
   773	    return "\n".join(parts)
   774	
   775	
   776	def has_substantive_content(text: str) -> bool:
   777	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   778	
   779	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
