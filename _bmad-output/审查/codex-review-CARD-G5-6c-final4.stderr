  1096	def find_ai_marker(text: str) -> tuple[int, str] | None:
  1097	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
  1098	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
  1099	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
  1100	    —— 行号准确，文本保真。"""
  1101	    for lineno, ln in head_window(text):
  1102	        norm = _norm_ai_line(ln)
  1103	        hits = [
  1104	            (pos, -len(nm), orig)
  1105	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
  1106	            if (pos := _find_marker_pos(norm, nm)) >= 0
  1107	        ]
  1108	        if hits:
  1109	            _, _, marker = min(hits)
  1110	            return lineno, marker
  1111	    return None
