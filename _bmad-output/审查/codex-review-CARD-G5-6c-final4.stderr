  1050	def find_generation_claim(text: str) -> str | None:
  1051	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
  1052	
  1053	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
  1054	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
  1055	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
  1056	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
  1057	    """
