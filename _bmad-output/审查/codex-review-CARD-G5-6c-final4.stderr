                r'_GEN_CLAIM_CN_RE = re.compile(r"由[^。；！？\n]{1,40}?生成")',
            ),
            (
                r'_GEN_CLAIM_EN_RE = re.compile(r"generated by(?![^\W_])[\W_]*[^\W_]")',
                r'_GEN_CLAIM_EN_RE = re.compile(r"generated by \S")',
            ),
        ],
    ),
    (
        # ⚠️ 期望是 {G_ZW} 而不是 {G_LONG}：首轮把它写成 G_LONG，实跑「少红」——
        # 零宽在 `Generated by<ZWSP>GPT-4` 形态下已被骨架的非词字符段吃掉，
        # 这一层在那里**不承重**。真正承重的是零宽切断标记表项时的 raw_ai_marker。
        # 期望集合被实测证伪 → 改的是期望，也改了实现文档，不是把判据放宽。
        # ⚠️ 期望含 G_INVIS：新加的不可见字符门端到端半边断言 reason 归属
        # 「生成断言结构」，回退双变体后词内零宽不还原、骨架认不出，它同样红。
        # 这是本 runner 第二次抓到我把期望写窄 —— 记全真实覆盖面，判据不放宽。
        "M-ZEROWIDTH  护栏归一退回旧归一（不剥零宽）",
        {G_ZW, G_INVIS},
        [
            # ⛔ 两个调用点都退 —— 只退一个会被另一个兜住，变异测不出这一层
            # （reference_mutation_must_disable_all_layers）。
            # round-3 起零宽走 `_guard_variants` 双变体（换空格 + 直接删）。
            # 回退成只有换空格那一版 = round-2 行为，词内插入重新失效。
            (
                "    return (\n"
                '        _norm_ai_line(_strip_invisible(ln, " ")),\n'
                '        _norm_ai_line(_strip_invisible(ln, "")),\n'
                "    )\n",
                '    return (_norm_ai_line(_strip_invisible(ln, " ")),)\n',
            ),
        ],
    ),
    (
        "M-GENSIGNAL  生成断言结构 + 生成器键两层全回退",
        {G_LONG, G_GENKEY, G_INVIS},
        [
            ("    gen_claim = find_generation_claim(text)\n", "    gen_claim = None\n"),
            (
                "    generator_pairs = [\n"
                "        (k, v) for k, v in fm_pairs if _norm_fm_key(k) in _GENERATOR_DECL_KEYS\n"
                "    ]\n",
                "    generator_pairs = []\n",
            ),
        ],
    ),
    (
        "M-SRCALIAS   来源键名归一退回字面小写 source",
        {G_DOI},
        [
            (
                "    source_alias_pairs = [\n"
                "        (k, v) for k, v in fm_pairs if _norm_fm_key(k) in _SOURCE_DECL_KEYS\n"
                "    ]",
                '    source_alias_pairs = [(k, v) for k, v in fm_pairs if k == "source"]',
            )
        ],
    ),
    (
        "M-DOIVAL     DOI 值形态信号回退",
        {G_DOI, G_DUPKEY},
        [
            (
                "    doi_bearing_pairs = [(k, v) for k, v in fm_pairs if _looks_like_doi_value(v)]\n",
                "    doi_bearing_pairs = []\n",
            )
        ],
    ),
    (
        "M-PAIRS      护栏扫描面退回折叠后的 map（重复键遮蔽复现）",
        {G_DUPKEY},
        [
            (
                "    fm_pairs = frontmatter_pairs(fm_lines)\n",
                "    fm_pairs = list(fm.items())\n",
            )
        ],
    ),
    (
        # round-3 起白名单整个取消（放行键名而信息在值里，被审查打穿），
        # 兜底改为「任何非空值」；变异锚点随之改变。
        # ⚠️ 期望里必须带上 G_UNPARSED：round-3 给那道门加了「带非空元数据的重复件
        # 落 C6」这条断言，它同样靠⑨承重。首跑把期望写成只有 G_UNKNOWN，实测**多红**
        # 一门 —— 说明我对波及面的理解不准。改的是期望（把真实覆盖面记全），
        # 不是放宽判据；判据仍是集合相等。
        "M-FALLBACK   兜底信号⑨回退（方向退回 fail-open）",
        {G_UNKNOWN, G_UNPARSED},
        [
            (
                "    unknown_value_pairs = [(k, v) for k, v in fm_pairs if v]\n",
                "    unknown_value_pairs = []\n",
            )
        ],
    ),
    (
        # round-3 BLOCKER：不可见字符退回六码点有限表（U+2063 等 9 个同族重新穿透）
        "M-INVISENUM  不可见字符判定退回有限枚举",
        {G_INVIS},
        [
            (
                "            unicodedata.category(c) in _INVISIBLE_CATEGORIES\n"
                '            or (c.isspace() and c not in " \\t")\n',
                '            c in "\\u200b\\u200c\\u200d\\u2060\\ufeff\\u00ad"\n'
                "            or False\n",
            )
        ],
    ),
    (
        # round-3 HIGH：闭合注释信号⑩回退（唯一来源写在注释里的文件重新被删）
        # ⚠️ 期望含 G_R7：第七轮把围栏 info string 也并进了信号⑩，那道门的
        # info 反例同样靠它承重。这是本 runner 第四次抓到我把期望写窄 ——
        # 每次给信号扩覆盖面，都要回头问一遍「哪些门现在也依赖它了」。
        "M-COMMENT    闭合注释未消化信号⑩回退",
        {G_COMMENT, G_COMMENT2, G_R7},
        [
            (
                "    commented_out = [ln for ln in stripped_comments if ln.strip()] + fm_comment_lines\n",
                "    commented_out = []\n",
            )
        ],
    ),
    (
        # 用户裁决（2026-09-02）：标题里写了字算实质正文。回退后
        # 「只写了标题的笔记」与「隐形字符伪装的标题」重新被确定删除。
        "M-HEADING    标题不算实质正文（回退用户裁决）",
        {G_HEADCONTENT},
        [
            (
                '            if ln.lstrip(" \\t#").strip():\n'
                "                return True\n",
                "            if False:\n                return True\n",
            )
        ],
    ),
    (
        # 第七轮 HIGH：结构行判定退回「出现过结构字符就算结构」
        "M-STRUCT     结构行判定退回字符集匹配",
        {G_R7},
        [("    return len(kinds) <= 1\n", "    return True\n")],
    ),
]


def sha(p: pathlib.Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


