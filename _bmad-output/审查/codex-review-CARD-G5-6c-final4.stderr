  1897	# ───── I. round-8 定向整改回归门 (CARD-G5-6c: NBSP 标题 / 模型声明 / DOI 来源) ─────
  1898	
  1899	
  1900	def test_nbsp_after_hash_is_not_an_atx_heading(tmp_path):
  1901	    """⛔ round-8 BLOCKER-1: ATX 的**井号后分隔**也只认 ASCII 空格/制表符。
  1902	
  1903	    前置缩进在 round-7 已收窄为字面空格, 但 `#{1,6}` 后仍写着 `(?:\\s|$)` ——
  1904	    Python `re` 的 `\\s` 在 str 模式下是 Unicode 语义, `#\\xa0keep`
  1905	    (字节 23c2a06b6565700a) 被当标题剥掉 → 「标题 1 行、实质正文 0 字符」
  1906	    → `建议删 + confident=true`。同一条规则的两半只修一半, 等于没修。
  1907	    """
  1908	    mod = load_module()
  1909	    # 纯函数半边: CommonMark §4.2 = 空格 / 制表符 / 行尾
  1910	    assert mod._HEADING_RE.match("# x"), "ASCII 空格必须仍是合法分隔"
  1911	    assert mod._HEADING_RE.match("#\tx"), "制表符是 CommonMark 合法分隔, 不得连坐收窄"
  1912	    assert mod._HEADING_RE.match("#"), "行尾 ATX (空标题) 必须仍成立"
  1913	    assert mod._HEADING_RE.match("   ###### x"), "3 空格缩进 + 六级标题仍成立"
  1914	    assert not mod._HEADING_RE.match("#\u00a0x"), "NBSP 不是 ATX 分隔 (round-8 BLOCKER-1)"
  1915	    # ⛔ 验伪锚: 防「按反例特判 NBSP」的窄修 —— 全角/EM 空格是同族 Unicode 空白
  1916	    assert not mod._HEADING_RE.match("#\u2003x"), "EM SPACE 同属 Unicode 空白, 不得只排 NBSP"
  1917	    assert not mod._HEADING_RE.match("#\u3000x"), "IDEOGRAPHIC SPACE 同上"
  1918	    assert not mod._HEADING_RE.match("#x"), "井号后无分隔本就不是标题 (口径不得放宽)"
  1919	
  1920	    # 端到端半边: 真实 CLI
  1921	    vault, out = base_vault(tmp_path)
  1922	    inbox = vault / "_待处理"
  1923	    mk(inbox / "井号NBSP.md", "#\u00a0keep\n", age_days=6)
  1924	    # ⛔ 正向对照(验伪锚): 井号后制表符**是**标题 → 无正文仍 C3 建议删。
  1925	    # 若有人把修复写成只认空格 `(?:[ ]|$)`, 本条会红。
  1926	    # 用户裁决后「标题里写了字」算内容，故 tab 对照改测「它被当成标题」的另一面：
  1927	    # 井号后是制表符 ⇒ 是标题 ⇒ 标题里的字算内容 ⇒ 落 C6（与 NBSP 同落点，
  1928	    # 但依据不同：NBSP 那份是「整行都是正文」）。C3 对照另用空标题模板。
  1929	    mk(inbox / "井号TAB标题.md", "#\tonly heading\n", age_days=5)
  1930	    mk(inbox / "空标题模板.md", "# \n\n## \n", age_days=3)
  1931	    # 正向对照: 顶格空格标题 + 无正文 → 仍 C3 建议删
  1932	    mk(inbox / "顶格标题.md", "# \n\n## \n", age_days=4)
  1933	
  1934	    assert run_cli(vault, out).returncode == 0
  1935	    data = load_json(out)
  1936	    assert data["items"], "items 为空则本门恒真 = 假绿"
  1937	    it = item_by_name(data, "井号NBSP.md")
  1938	    assert it["verdict"] != "建议删", f"NBSP 井号行被建议删了: {it['basis']}"
  1939	    assert it["criterion"] == "C6_undecided", it["criterion"]
  1940	    assert it["confident"] is False
  1941	    assert it["target_hint"] is None and it["nomination_type"] is None
  1942	    ctrl = item_by_name(data, "空标题模板.md")
  1943	    assert ctrl["criterion"] == "C3_empty_or_skeleton", ctrl["basis"]
  1944	    assert ctrl["verdict"] == "建议删"
  1945	
