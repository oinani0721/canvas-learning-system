  1890	    assert fm["created"] == "2026-01-01T00:00:00+08:00", "值里的冒号不得截断值"
  1891	    fm = mod.frontmatter_map(["title : x"])
  1892	    assert fm["title"] == "x", "冒号前空格的键 (pyyaml 认) 必须解析出值"
  1893	    fm = mod.frontmatter_map(["source:https://x"])
  1894	    assert "source" not in fm, "冒号后无空格不认键, URL 不得被吞成值"
