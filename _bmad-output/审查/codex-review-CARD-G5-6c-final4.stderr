  2462	def test_source_inside_closed_html_comment_blocks_deletion(tmp_path):
  2463	    """⛔ round-3 审查 HIGH: 唯一来源写在**闭合** HTML 注释里时 C3/C4 双出口全穿。
  2464	
  2465	    根因是保护面不对称: `<!--` 没等到 `-->` (未闭合) 受①保护, 而闭合注释被
  2466	    `_classify_lines_typed` 整段剥掉后**无人接** —— 来源扫描与⑨兜底都只看
  2467	    frontmatter。信号⑩与①对称补上: ①保护「不知道被吞了什么」, ⑩保护「知道被
  2468	    吞了什么, 但引擎没消费它」。
  2469	    ⚠\ufe0f 语义代价如实: 任何带非空闭合注释的骨架件都不再确定删除, 不只是带来源的
  2470	    那些 —— 因为「注释里那句话重不重要」同样不可机械判定 (与取消白名单同源)。
  2471	    """
  2472	    vault, out = base_vault(tmp_path)
  2473	    inbox = vault / "_待处理"
  2474	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2475	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2476	    for name, text in (
  2477	        # ⛔ 标题必须留空：用户裁决后「标题里写了字」本身就算实质正文，会先把
  2478	        # 材料接住，信号⑩ 根本轮不到 —— 那样本门测的就不是它声称测的那条防线。
  2479	        ("注释里的URL.md", "# \n\n<!-- source: https://example.test/p -->\n"),
  2480	        ("注释里的DOI.md", "# \n\n<!-- DOI:10.1000/hidden -->\n"),
  2481	        ("注释里的ISBN.md", "# \n\n<!-- citation: ISBN 978-7-111-54742-6 -->\n"),
  2482	        ("注释里的生成声明.md", "# \n\n<!-- generated with GPT-4 -->\n"),
  2483	        # ⛔ 第五轮终审 HIGH：跨行注释的**中间整行**此前没被收集（只收闭合那行），
  2484	        # 来源整条丢掉；单行注释反而受保护 —— 保护面不该取决于换不换行。
  2485	        ("多行注释来源.md", "# \n\n<!--\nsource: https://multi.example/p\n-->\n"),
  2486	        # ⛔ 第五轮终审 HIGH：frontmatter 里的 YAML 注释被 `startswith("#")` 跳过，
  2487	        # 既不进 unparsed_fm 也不进 map，唯一来源写在那儿照样被确定删除。
  2488	        ("fm里YAML注释.md", "---\n# source: https://fm-comment.example/p\ntitle:\n---\n"),
  2489	        # ⛔ 第六轮终审 HIGH（R6-H1）：**行尾** YAML 注释同样被剥掉且没人收。
  2490	        # 与整行注释、跨行 HTML 注释是同一件事：引擎剥掉了内容就该说出来。
  2491	        ("fm行尾注释.md", '---\ntitle: "" # source: https://inline.example/only\n---\n'),
  2492	        ("注释里的URL重复件.md", "<!-- source: https://only-here.test/p -->\n" + body),
  2493	    ):
  2494	        mk(inbox / name, text, age_days=6)
  2495	    # ⛔ 正向对照(验伪锚): 没有注释的空骨架 → 仍 C3 确定删除
  2496	    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)
  2497	    # ⛔ 正向对照: 合法 source + 行尾注释 → 仍 C1。判据排在信号之前,
  2498	    # 信号⑩ 扩到行尾注释后不得把它抢走(既有门 yaml_inline_comment 的语义)。
  2499	    mk(
  2500	        inbox / "C1带行尾注释.md",
  2501	        '---\nsource: "https://ok.test/x" # 官方来源\n---\n',
  2502	        age_days=2,
  2503	    )
  2504	
  2505	    assert run_cli(vault, out).returncode == 0
  2506	    data = load_json(out)
  2507	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2508	    for name in (
  2509	        "注释里的URL.md",
  2510	        "注释里的DOI.md",
  2511	        "注释里的ISBN.md",
  2512	        "注释里的生成声明.md",
  2513	        "注释里的URL重复件.md",
  2514	        "多行注释来源.md",
  2515	        "fm里YAML注释.md",
  2516	        "fm行尾注释.md",
  2517	    ):
  2518	        it = item_by_name(data, name)
  2519	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2520	        assert it["criterion"] == "C6_undecided", name
  2521	        assert it["confident"] is False, name
  2522	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2523	        assert "注释" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2524	    assert item_by_name(data, "注释里的URL重复件.md")["exact_duplicate_of"] == "节点/库内正本.md"
  2525	    ctrl = item_by_name(data, "无注释骨架.md")
  2526	    assert ctrl["criterion"] == "C3_empty_or_skeleton", ctrl["basis"]
  2527	    assert ctrl["verdict"] == "建议删"
  2528	    c1 = item_by_name(data, "C1带行尾注释.md")
  2529	    assert c1["criterion"] == "C1_source_url", f"信号⑩ 不得抢在判据前面: {c1['basis']}"
  2530	    assert "官方来源" not in c1["basis"], c1["basis"]
  2531	
