   823	def skeleton_note(text: str, size: int) -> str:
   824	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   825	
   826	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   827	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   828	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   829	    """
   830	    if size == 0:
   870	#:   Cf = 格式字符（零宽空格/连接符/双向控制/不可见分隔符…）
   871	#:   Mn = 非间距标记（VS16、CGJ 这类零宽度记号）
   872	#:   Cc = 控制字符
   873	#: ⚠️ 只用在**护栏匹配面**：剥掉组合记号会改变带重音文本的词形，但护栏只判
   874	#: 「这行像不像生成声明」，方向是更容易命中；产物输出一律走原文，不受影响。
   875	#: ⛔ **类别判定同样不完备，如实登记原理上限**（round-4 验证实测）：
   876	#: `U+3164 HANGUL FILLER`（Lo，字母）与 `U+2800 BRAILLE PATTERN BLANK`（So，符号）
   877	#: 在屏幕上是空白，但 Unicode 把它们归为字母/符号，`isspace()` 也是 False ——
   878	#: 机械上它们就是普通字符。把 Lo/So 整类剥掉会连正常韩文与盲文一起剥，那是
   879	#: 更坏的交易。**「视觉上不可见」需要字形宽度数据才判得了，不是字符属性能决定的**，
   880	#: 因此 `# Genera<U+3164>ted by GPT-4` 这类构造仍会落 C3 建议删。
   881	#: 结构化的兜底得改 C3 对**标题行**的处理（现在标题不算实质正文），那是判据面
   882	#: 的语义变更，超出 CARD-G5-6c 范围 —— 登记待裁决，不在本卡内改。
   883	_INVISIBLE_CATEGORIES = frozenset({"Cf", "Mn", "Cc"})
   884	
   885	
   886	def _strip_invisible(s: str, repl: str) -> str:
   887	    """把不可见字符替换成 `repl`（`" "` 还原词间分隔；`""` 还原词内断裂）。
   888	
   889	    ⛔ round-4 验证 BLOCKER 的一半：**删版必须连空白类一起删**。
   890	    `Genera<U+200A>ted`（HAIR SPACE，Zs）此前只被 `_norm_ai_line` 的 `split()`
   891	    折叠成普通空格，词照样是拆开的 —— 删版不删它，两个变体就都还原不出
   892	    `generated`。
   893	    ⚠️ 但删版**保留 ASCII 空格与制表符**：把它们也删掉，`generated by GPT-4`
   894	    在删版里就成了 `generatedbyGPT-4`，骨架永远认不出，删版等于自废。
   895	    要删的是「看不见、又不是正常词间空格」的那一类 —— Cf/Mn/Cc 加上**非 ASCII**
   896	    的空白（Zs/Zl/Zp，如 HAIR SPACE）。两个变体这才真正互补：
   897	      `Genera<U+200A>ted by GPT-4` → 删版还原出 `Generated by GPT-4`；
   898	      `Generated<U+200A>by GPT-4`  → 换空格版还原出 `Generated by GPT-4`。
   899	    """
   900	    return "".join(
   901	        repl
   902	        if (
   903	            unicodedata.category(c) in _INVISIBLE_CATEGORIES
   904	            or (c.isspace() and c not in " \t")
   905	        )
   906	        else c
   907	        for c in s
   908	    )
