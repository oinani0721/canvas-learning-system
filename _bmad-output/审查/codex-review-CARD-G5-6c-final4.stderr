  1073	def _find_marker_pos(ln: str, marker: str) -> int:
  1074	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
  1075	
  1076	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
  1077	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
  1078	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
  1079	    行内更靠后的真命中。
  1080	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
  1081	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
  1082	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
  1083	    只认行尾或标点；漏判方向落 C6，安全。"""
  1084	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
  1085	    start = 0
  1086	    while (i := ln.find(marker, start)) >= 0:
  1087	        j = i + len(marker)
  1088	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
  1089	            return i
  1090	        if not ascii_ending and ln[j].isspace():
  1091	            return i
  1092	        start = i + 1
  1093	    return -1
