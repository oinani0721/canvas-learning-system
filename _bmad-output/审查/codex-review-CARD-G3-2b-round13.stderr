  3893	def test_round12_empty_eid_rejected_at_entry(vault):
  3894	    """空的本地 event_id 必须在**任何写入之前**被拒（HIGH④）。
  3895	
  3896	    ⛔ 原非收敛链：`event_id=""` 首跑 rc=0（产出合法完整 id `quiz:`、attempt=1、
  3897	    validator rc=0），同一输入第二跑 rc=1「FSRS 已应用但缺校准记录」——
  3898	    因为 `f1 = bool(eid) and …` 让空 eid 恒假，而 receipt 明明存在。
  3899	    """
  3900	    LED = vault / "learning_events.jsonl"
  3901	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3902	    LED.unlink(missing_ok=True)
  3903	    face = _write_face(vault)
  3904	    # ⚠️ 两种形态由**不同的**门拦，拒因必须各自点名（不退化成「随便什么理由拒了都行」）：
  3905	    #   ""    → 本轮新增的空 id 门
  3906	    #   "   " → 更早的「幂等键首尾含空白」门（它排在前面）
  3907	    for bad, needle in (("", "event_id 为空"), ("   ", "首尾含空白")):
  3908	        r = _run_writer(vault, _payload(event_id=bad, ts=TS1, review_time=TS1))
  3909	        assert r.returncode != 0, f"空/纯空白 event_id 必须拒: {bad!r}"
  3910	        assert needle in r.stderr, f"[{bad!r}] 拒因须点名 {needle!r}: {r.stderr[:250]}"
  3911	        assert _write_face(vault) == face, f"[{bad!r}] 零写 —— 不得先落账再发现认不出"
  3912	    # 验伪：非空 id 首跑→重跑必须收敛（这正是原缺陷的反面）
  3913	    r1 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3914	    assert r1.returncode == 0, r1.stderr[:250]
  3915	    n1 = len(_ledger_lines(vault))
  3916	    r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3917	    assert r2.returncode == 0, f"同输入重跑必须收敛而不是报缺校准记录: {r2.stderr[:250]}"
  3918	    assert len(_ledger_lines(vault)) == n1, "重跑不得新增账本行"
