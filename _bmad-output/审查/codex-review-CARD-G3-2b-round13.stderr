  1105	def _state_domain_problems(state: dict) -> list[str]:
  1106	    """snapshot state 的数值域 —— 与 `classify_card_state()` 同判据。
  1107	
  1108	    round-15 Codex: 原实现只查类型不查域, `stability=-1.0, difficulty=99.0`
  1109	    能算出无违规的 hash, 而同文件的三态判别对同一组值判 degraded。
  1110	    """
  1111	    problems: list[str] = []
  1112	    stability = state.get("fsrs_stability")
  1113	    if isinstance(stability, float) and not (0 < stability <= STABILITY_MAX):
  1114	        problems.append(f"fsrs_stability {stability!r} 不在可调度域 (0, {STABILITY_MAX}]")
  1115	    difficulty = state.get("fsrs_difficulty")
  1116	    low, high = DIFFICULTY_RANGE
  1117	    if isinstance(difficulty, float) and not (low <= difficulty <= high):
  1118	        problems.append(f"fsrs_difficulty {difficulty!r} 不在可调度域 [{low}, {high}]")
  1119	    return problems
