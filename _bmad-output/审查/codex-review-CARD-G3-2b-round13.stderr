   887	def _apply_fsrs_block(fm_text, block):
   888	    fm_text = re.sub(r'^(fsrs_due|fsrs_state|fsrs_step|fsrs_stability|fsrs_difficulty|fsrs_last_review):.*\r?\n?', '', fm_text, flags=re.M)
