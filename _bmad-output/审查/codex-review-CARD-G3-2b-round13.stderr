  1257	#: 极简可证形态 (round-7 终局决策): 逐行状态机仍会对合法 YAML 错绑
  1258	#: (plain scalar 折行 `vault_id: first` + 缩进续行, PyYAML 真值是
  1259	#: "first second"; `description: it's fine` 的撇号被当跨行引号起点)。
  1260	#: 手写 YAML 子集打不赢, 改为**只在形态确定无歧义时绑定**, 其余不绑定 + WARN:
  1261	#:   (1) 全文件恰有一处行首 `vault_id:`;
  1262	#:   (2) 该行是 `vault_id: "<无转义无换行>"` 或 `vault_id: <安全裸词>`;
  1263	#:   (3) 下一行不是缩进行 (排除 plain scalar 折行续接)。
  1264	#: 代价: `vault_id: team#1` 等形态退化为不绑定 (保守: 失一层防护 != 错绑),
  1265	#: 且 vault_id 本就是文件名安全 slug, 现网与部署模板均落在白名单形态内。
  1266	def _sanitize_vault_id(value: str) -> Optional[str]:
  1267	    """走 backend 的真实 `sanitize_vault_id`（同仓可达时），否则 None。
  1268	
  1269	    ⚠️ round-11 HIGH#2: 只做 `safe_load + strip` **仍与生产分叉** ——
  1270	    `Settings.vault_id` 还会调 `sanitize_vault_id()`（`config.py:1020`），
  1271	    实测 `vault_id: team#1` 生产得 `team_1` 而本脚本曾绑定 `team#1`。
  1272	    复制该函数会重演"手写副本漂移"，故直接 import 真实实现；不可达时
  1273	    (脚本被拷到别处) **不绑定**，由调用方 WARN 降级。
  1274	    """
  1275	    backend_root = Path(__file__).resolve().parents[1]
  1276	    if str(backend_root) not in sys.path:
  1277	        sys.path.insert(0, str(backend_root))
  1278	    try:
  1279	        from app.config import sanitize_vault_id  # noqa: PLC0415
  1280	    except Exception:  # noqa: BLE001 — 任何导入失败都降级为不绑定
  1281	        return None
  1282	    try:
  1283	        sanitized = sanitize_vault_id(value)
  1284	    except Exception:  # noqa: BLE001
  1285	        return None
  1286	    return sanitized if sanitized and sanitized != "default" else None
