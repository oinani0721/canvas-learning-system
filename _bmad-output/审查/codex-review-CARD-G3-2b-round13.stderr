   864	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   865	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   866	def _bridge(fm_text, gn, ab, ts, rating=None):
   867	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   868	    if rating is not None:
   869	        payload_in["rating"] = rating
   870	    try:
   871	        _r = subprocess.run(
   872	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   873	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   874	    except Exception as _e:
   875	        return None, str(_e)
   876	    try:
   877	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   878	    except ValueError:
   879	        _out = {}
   880	    if _r.returncode == 2:
   881	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
   882	    if _r.returncode == 0 and _out.get("fm_block"):
   883	        return _out, None
   884	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
   885	    return None, _err
