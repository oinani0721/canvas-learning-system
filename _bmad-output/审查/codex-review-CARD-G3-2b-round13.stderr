   936	        _e_qid = q_(p.get("question_id", "q1"))
   937	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   938	    else:
   939	        _e_pl = ev.get("payload") or {}
   940	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
