  1289	def _vault_id_of(ledger_path: Path) -> Optional[str]:
  1290	    """账本所在 vault 的**规范化** vault_id（同目录 .canvas-config.yaml）。
  1291	
  1292	    ⚠️ **round-10/11 终局：与 backend 生产入口逐环节同源。**
  1293	    此前 r5~r9 手写 YAML 子集反复静默错绑；r10 改走 `yaml.safe_load` 后
  1294	    r11 又发现只做 `safe_load + strip` 仍与生产分叉——生产 `Settings.vault_id`
  1295	    的完整链是 **`safe_load` → `isinstance(str)` → `sanitize_vault_id()` →
  1296	    `!= "default"` 才采信**（`config.py:782-795`）。现逐环节复用同一实现：
  1297	    解析用 PyYAML，规范化用 backend 的 `sanitize_vault_id` 本体。
  1298	
  1299	    任一环节不可达（PyYAML 缺失 / backend 不可 import）⇒ **不绑定 + WARN**，
  1300	    校验器其余功能不受影响。
  1301	    """
  1302	    config = ledger_path.parent / ".canvas-config.yaml"
  1303	    if not config.is_file():
  1304	        return None
  1305	    try:
  1306	        import yaml  # noqa: PLC0415 — 可选依赖, 不可用时降级
  1307	    except ImportError:
  1308	        return None
