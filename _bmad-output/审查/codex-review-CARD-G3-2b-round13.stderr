   220	def _int_lexeme(value: object) -> Optional[int]:
   221	    """纯整数 (int 本身, 或 ^[+-]?\\d+$ 的字符串) → int; 否则 None。
   222	
   223	    round-7: 用 float() 判整数会让 `fsrs_state: 1.0` 通过, 而真实 bridge
   224	    的 `int(fields.get("fsrs_state", 1))` 对 "1.0" 抛 ValueError。
   225	    """
   226	    if isinstance(value, bool):
   227	        return None
   228	    if isinstance(value, int):
   229	        return value
   230	    if isinstance(value, str) and _INT_LEXEME_RE.match(value.strip()):
   231	        try:
   232	            return int(value.strip())
   233	        except ValueError:
   234	            # round-8 MEDIUM: 5000 位纯整数触发 stdlib int_max_str_digits 限额
   235	            return None
   236	    return None
