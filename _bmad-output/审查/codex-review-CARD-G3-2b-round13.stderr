   408	def _cands_and_sources(fm_text, ev_id, all_ledger_ids=()):
   409	    """校准 token 的候选集 + 来源反查 —— **唯一实现**, 两个调用点共用。
   410	
   411	    ⛔ 为什么必须抽出来 (变异 M53/M72 存活暴露): round-11 把 receipt 验证统一到
   412	    `_resolve_receipt` 时, 这段「候选 + 反查」在 `_fm_has_event_compat` 里**还留着
   413	    一份副本**, 而且两份的成功条件**已经分叉** ——
   414	      · `_resolve_receipt`:      `_sources != {ev_id}` ⇒ 拒 (空集也不可证, B②)
   415	      · `_fm_has_event_compat`:  `if _sources and ...` ⇒ **空集放行**
   416	    也就是说 round-11 那条 BLOCKER 只修了一份。这正是它自己要根治的「修一半」:
   417	    抽了函数却没让所有调用点都用, 下次改判据仍要改两处。
   418	
   419	    返回 (候选 token 列表, 来源 id 集合)。**不**做放行/拒绝裁决 —— 两个调用点的
   420	    严格度差异是**有意的**(见各自 docstring), 由它们各自声明, 而不是靠这里分叉。
   421	    """
   422	    _cands = []
   423	    if _fm_has_event(fm_text, ev_id):
   424	        _cands.append(ev_id)
   425	    _bare = ev_id[5:] if ev_id.startswith("quiz:") else None
   426	    if _bare is not None and _fm_has_event(fm_text, _bare):
   427	        _cands.append(_bare)
   428	    # 反查: 每个账本 id 贡献「完整」token; 带 `quiz:` 前缀的再贡献「历史裸」token。
   429	    _sources = set()
   430	    for _tok in _cands:
   431	        for _lid in all_ledger_ids:
   432	            if _lid == _tok or (_lid.startswith("quiz:") and _lid[5:] == _tok):
   433	                _sources.add(_lid)
   434	    _sources.discard("")
   435	    return (_cands, _sources)
   436	
