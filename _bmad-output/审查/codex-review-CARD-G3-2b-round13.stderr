   483	def _resolve_receipt(fm_text, ev_id, all_ledger_ids=(), row=None, facts=None, require_source=True):
   484	    """**唯一**的 receipt 解析 + 事实校验入口 (Codex round-11 BLOCKER/HIGH)。
   485	
   486	    ⛔ 为什么必须统一: 此前 receipt 验证散落在**六处**、严格度各不相同 ——
   487	    dup 路径比六项、F1-only 比两项、foreign replay 只看「ID 在不在」(布尔)。
   488	    于是同一份 receipt 在不同分支得到不同结论: 实测把 durable 的采用时刻改掉
   489	    (保留 scored_at 与 receipt), foreign replay 照常「恢复」E1 ⇒ **state 1→2、
   490	    stability 2.31→7.32、同一次评分被算了两遍**; 把 receipt 的 attempt 改成 999
   491	    也照样称「事实一致」。
   492	    这正是 round-10「修一半」那条教训的下一层: **抽出统一函数, 让分歧不可能存在**。
   493	
   494	    返回 (receipt, 唯一来源 id)。任何不可证的情形一律 raise SystemExit。
   495	
   496	    facts: 要逐项核对的事实字典; None 表示只解析不校验事实(仍做来源唯一性证明)。
   497	    row:   对应的账本行; 给出时额外强制「三方同瞬间」(ledger effective_at /
   498	           payload.review_time / receipt ts)。
   499	    """
   500	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   501	    if not _cands:
   502	        return (None, None)          # 没有 receipt —— 由调用方决定这是否可接受
   503	    # ⛔ 成功条件是 `_sources == {ev_id}` —— **空集同样不可证** (round-11 BLOCKER):
   504	    # 账本缺失时来源集合为空, 上一版把它当「唯一」放行 ⇒ 实测另一个完整 id 的评分
   505	    # 被静默吞掉 (rc=0、账本 0 字节、attempt 不变)。
   506	    # ⚠️ `require_source=False` 用于**账本行本就丢失**的分支 (F1-only): 那里
   507	    # 来源集合必然为空, 强制它等于 {ev_id} 就是「要求证明一个前提上不存在的
   508	    # 东西」。⛔ 统一函数不等于所有调用点参数相同 —— 共用逻辑的同时, 每个
   509	    # 调用点要声明它能提供什么证据。
   510	    # ⛔ round-12 BLOCKER①: 账本来源丢失(集合为空)时, 历史裸形态与完整形态的 receipt
   511	    # **字节上不可区分**。此时唯一可证的凭据是条目自带的 `id_form: full` 标记 ——
   512	    # 没有它就无从证明这条 receipt 存的是完整 id, 猜一个就会让另一次评分静默消失。
   513	    if not _sources:
   514	        _probe = None
   515	        for _tok in _cands:
   516	            _probe = _receipt_of(fm_text, _tok)
   517	            if _probe is not None:
   518	                break
   519	        if not (isinstance(_probe, dict) and _probe.get("id_form") == "full"):
   520	            raise SystemExit(
   521	                f"[quiz-answer] 账本里找不到 {ev_id!r} 的来源行, 而校准记录里那条 receipt "
   522	                f"没有 `id_form: full` 标记 — 无法区分它存的是**完整 id** 还是**历史裸形态**"
   523	                f"(两种情形下这条记录字节完全相同, 评分事实也相同), 猜一个就会让另一次评分"
   524	                f"静默消失, fail-closed 拒写 — 请人工确认后给该条目补上 `id_form: full`"
   525	            )
   526	    if require_source and _sources != {ev_id}:
   527	        raise SystemExit(
   528	            f"[quiz-answer] 校准记录里命中 {ev_id!r} 的条目, 但它的来源集合是 "
   529	            f"{sorted(_sources)!r} 而非恰好 {{{ev_id!r}}} — "
   530	            f"{'账本缺失, 历史裸形态的来源无从证明' if not _sources else '完整形态与历史裸形态无法区分'}; "
   531	            f"猜一个就会让另一次评分静默不入账, fail-closed 拒写 — 请人工统一这些 id"
   532	        )
   533	    _rcpt = None
   534	    for _tok in _cands:
   535	        _rcpt = _receipt_of(fm_text, _tok)
   536	        if _rcpt is not None:
   537	            break
   538	    if not isinstance(_rcpt, dict):
   539	        raise SystemExit(f"[quiz-answer] {ev_id} 在 calibration_log 里命中却读不出条目 — receipt 不可解析, fail-closed 拒写 — 请人工核对 {NODE}")
   540	
   541	    if facts:
   542	        # ⛔ 键集冻结 (round-12): 调用方**不能**传部分清单。传了就是编程错误 ——
   543	        # 四个站点曾各传 0/5/0/3 项, 于是同一份 receipt 在不同分支得到不同结论。
   544	        if set(facts) != set(_FACT_KEYS):
   545	            raise SystemExit(
   546	                f"[quiz-answer] 内部错误: receipt 事实清单不完整 "
   547	                f"(给了 {sorted(facts)}, 冻结键集是 {sorted(_FACT_KEYS)}) — "
   548	                f"缺项比较等于放行, fail-closed 拒写"
   549	            )
   550	        _mis = []
   551	        for _k, (_want, _ok) in facts.items():
   552	            _got = _rcpt.get(_k)
   553	            if _got is None:
   554	                _mis.append(f"receipt 缺 {_k}")
   555	            elif not _ok(_got):
   556	                _mis.append(f"receipt 的 {_k} 类型非法 ({_got!r})")
   557	            elif _got != _want:
   558	                _mis.append(f"{_k} {_got!r} != 期望 {_want!r}")
   559	        if _mis:
   560	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 与评分事实不一致 ({'; '.join(_mis)}) — 同一个 event_id 承载了两次不同的评分, fail-closed 拒写 — 请人工核对后修正 event_id 或账本")
   561	
   562	    if row is not None:
   563	        # ⛔ 三方同瞬间 (round-11 BLOCKER): ledger 的 effective_at / payload
   564	        # 的 review_time / receipt 的 ts 记的是同一个「调度采用时刻」。
   565	        # 只比 scored_at 时, 改掉采用时刻就能让同一次评分二次推进 FSRS。
   566	        _rts = _rcpt.get("ts")
   567	        if not isinstance(_rts, str) or not _rts or _rts != _rts.strip():
   568	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 缺可用的 ts (采用时刻) 或首尾含空白 ({_rts!r}) — 无法绑定账本的调度时刻; ⛔ 不做 strip(那会把两个不同的字面撞成一个), fail-closed 拒写")
   569	        _rp = row.get("payload") or {}
   570	        try:
   571	            _a = _instant_only(_rp.get("review_time"), f"{ev_id} 的 payload.review_time")
   572	            _b = _instant_only(row.get("effective_at"), f"{ev_id} 的 effective_at")
   573	            _c = _instant_only(_rts, f"{ev_id} 的 receipt ts")
   574	        except SystemExit:
   575	            raise SystemExit(f"[quiz-answer] {ev_id} 的三个采用时刻里有不可解析的值 (review_time={_rp.get('review_time')!r} / effective_at={row.get('effective_at')!r} / receipt ts={_rts!r}), fail-closed 拒写")
   576	        if not (_a == _b == _c):
   577	            raise SystemExit(f"[quiz-answer] {ev_id} 的账本采用时刻 (effective_at={row.get('effective_at')!r} / review_time={_rp.get('review_time')!r}) 与 receipt 的 ts={_rts!r} 不是同一瞬间 — 同一次评分的调度时刻被改过, 放行会二次推进 FSRS, fail-closed 拒写 — 请人工核对账本与 {os.path.basename(NODE)}")
   578	    return (_rcpt, ev_id)
