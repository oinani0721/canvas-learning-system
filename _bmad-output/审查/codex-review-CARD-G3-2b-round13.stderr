   622	def _fm_has_event(fm_text, ev_id):
   623	    """F1 判定: calibration_log 里有没有这个 event_id。
   624	
   625	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   626	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   627	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   628	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   629	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   630	
   631	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   632	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   633	    是「有总比没有强」的降级, 出现即告警。
   634	    """
   635	    try:
   636	        import yaml  # F1 判定
   637	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   638	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   639	        if isinstance(_doc, dict):
   640	            _cal = _doc.get("calibration_log")
   641	            if isinstance(_cal, list):
   642	                return any(
   643	                    isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id
   644	                    for _e in _cal
   645	                )
   646	            return False        # null / 标量 / 缺失 ⇒ 没有任何条目
   647	    except ImportError:
   648	        print("[quiz-answer] ⚠️ PyYAML 不可用 — F1 判定退回正则扫描, 只认 block list + `- event_id:` 开头的条目; 尾注释/inline/键顺序变体会假阴性")
   649	    except Exception as _ye:
   650	        raise SystemExit(f"[quiz-answer] frontmatter 的 calibration_log 不是合法 YAML ({_ye}) — F1 判定不可证, fail-closed 拒写 — 请人工修复 {NODE}")
   651	    mcal = re.search(r'^calibration_log:[ \t]*(?:#[^\n]*)?$', fm_text, re.M)
   652	    if not mcal:
   653	        return False
   654	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   655	        if ln and not ln[0].isspace():
   656	            break
   657	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   658	        if mm:
   659	            v = mm.group(1).strip()
   660	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   661	                try:
   662	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   663	                except ValueError:
   664	                    pass
   665	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   666	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   667	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   668	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   669	                v = v[1:-1].replace("''", "'")
   670	            if v == ev_id:
   671	                return True
   672	    return False
