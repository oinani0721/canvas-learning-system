   110	_ONE_MINUTE = timedelta(minutes=1)
   111	
   112	
   113	def _steps_to_minutes(steps) -> list[int]:
   114	    """timedelta 序列 → 整分钟列表。非整分钟步长直接抛错, 不静默截断。
   115	
   116	    用 timedelta 整除/取余 (内部纯整数微秒), 不走 total_seconds() 浮点 ——
   117	    json.dumps 把 1.0 写成 "1.0"、1 写成 "1", hash 会分叉。
   118	    """
   119	    minutes: list[int] = []
   120	    for td in steps:
   121	        if td % _ONE_MINUTE != timedelta(0):
   122	            raise ValueError(f"学习步长 {td!r} 非整分钟, 无法用 *_steps_minutes 表达")
   123	        minutes.append(td // _ONE_MINUTE)
   124	    return minutes
   125	
