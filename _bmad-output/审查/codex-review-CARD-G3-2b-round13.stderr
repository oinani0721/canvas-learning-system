   750	                _why = "该行有终止 LF ⇒ 完整写入的损坏行, 非截断" if _ln == _n_lines else "中间行"
   751	                raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行损坏 (非 JSON; {_why}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
