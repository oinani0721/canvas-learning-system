  3857	def test_round12_b1_receipt_provenance(vault):
  3858	    """B①：账本来源丢失时，**没有 `id_form: full`** 的 receipt 不可证，必须停。
  3859	
  3860	    ⛔ 两个世界字节完全相同：一条历史裸形态 receipt（`quiz:K`）与一条新写的完整形态
  3861	    receipt（完整 id 恰也是 `quiz:K`）—— 连评分事实都相同，再多事实也分不开。
  3862	    唯一可证的凭据是条目自带的形态标记。
  3863	    """
  3864	    LED = vault / "learning_events.jsonl"
