   296	def _instant_only(s, ctx):
   297	    """tz-aware 解析 → UTC 瞬间。**不施加整秒/UTC 字面门** —— 用于只需要比较
   298	    「是不是同一个绝对时刻」的场合。
   299	
   300	    ⚠️ 别拿 _durable_instant 去当它用: 契约 §6.1:106 对 effective_at 的要求
   301	    只有「与 review_time **同一瞬间**（按绝对时刻比较——Z 与 +00:00 是同一瞬间
   302	    的两种写法, **不按原字符串比**）」, 整秒只约束 review_time。校验器也正是
   303	    这么实现的(_instant 比较)。用严格字面门去卡 effective_at 就比契约严一档,
   304	    `+08:00` 写法会被写点拒而校验器放行 —— 又一次实现与契约两个口径。
   305	    """
   306	    if not isinstance(s, str) or not s.strip():
   307	        raise SystemExit(f"[quiz-answer] {ctx} 非字符串时刻 ({s!r}), fail-closed 拒写")
   308	    try:
   309	        _d = datetime.fromisoformat(s.strip().replace("Z", "+00:00"))
   310	    except ValueError:
   311	        raise SystemExit(f"[quiz-answer] {ctx} 不可解析 ({s!r}), fail-closed 拒写")
   312	    if _d.tzinfo is None:
   313	        raise SystemExit(f"[quiz-answer] {ctx} 缺时区 ({s!r}; §三 要求 tz-aware), fail-closed 拒写")
   314	    return _d.astimezone(timezone.utc)
   315	
   316	
   317	def _durable_instant(rt, ctx):
   318	    """durable 行的 review_time → UTC 整秒 aware datetime; 不合规即 fail-closed。
   319	
   320	    Codex round-3 BLOCKER (R2): A2 会把小数秒 durable review_time 交给 bridge,
   321	    bridge 入口 _whole_second 截成整秒写进 W ⇒ 「10:00:00.5 > 10:00:00」恒真,
   322	    同一账本行每次重跑都判 pending 并**再推进一次 FSRS** (§6.2 A5 禁止的二次
   323	    apply; 实测账本始终一行而 W 逐次 +1s)。
   324	    ⛔ 只验不改: 消费时顺手规范化 = 把损坏行洗成合法行, 缺陷从写入面挪进不可
   325	    见面。本写点的 _iso() 恒产出整秒 UTC, 校验器对 review/1 行也机械强制整秒 —
   326	    出现小数秒/非 UTC 即外部污染, 停下人工修, 不猜。
   327	    """
   328	    if not isinstance(rt, str) or not rt.strip():
   329	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非字符串 ({rt!r}), fail-closed 拒写")
   330	    # 整秒判据复用**校验器本体**的 _WHOLE_SECOND_RE (禁第三套, DD-03/DD-13):
   331	    # 判据必须是**字面**而非解析后的值 —— '10:00:00.000000Z' 的 microsecond
   332	    # 恰为 0, 只看值会放行它, 而校验器按字面判 FAIL ⇒ 写点放行、validator 拒,
   333	    # 实现与契约又成两个口径 (正是 R6 那类缺陷的重演)。同源即无分叉。
   334	    if not _WHOLE_SECOND_RE.match(rt.strip()):
   335	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非 canonical 整秒形态 ({rt!r}; §6.2 A5 要求 YYYY-MM-DDThh:mm:ss 加 Z 或 ±hh:mm, 无小数秒 — 含小数秒会让同一行二次推进 FSRS), fail-closed 拒写")
   336	    try:
   337	        _dt = datetime.fromisoformat(rt.strip().replace("Z", "+00:00"))
   338	    except ValueError:
   339	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 不可解析 ({rt!r}), fail-closed 拒写")
   340	    # 字面门放行 ±hh:mm 任意偏移 (校验器口径); A2 消费面比校验器**严一档**,
   341	    # 只收 UTC (卡文 (b)) —— 本写点恒产出 Z, 非 UTC 行必为外部写入。
   342	    if _dt.tzinfo is None or _dt.utcoffset() != timedelta(0):
   343	        raise SystemExit(f"[quiz-answer] {ctx} 的 review_time 非 UTC ({rt!r}; §6.2 A6 要求 tz-aware UTC 时刻), fail-closed 拒写")
   344	    return _dt
