   130	#: §三 冻结受理语法的正词法 (round-2: fromisoformat 另收 week-date / 省略分钟 /
   131	#: '+00' / 逗号小数 / offset 秒; round-3: offset 分钟须 00-59, 原 \d{2} 收了 +00:60)
   132	_TS_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}(:\d{2}(\.\d+)?)?(Z|[+-]\d{2}:[0-5]\d)$")
   133	#: 小数秒段 — review/1 事件禁用 (round-3 BLOCKER: W 只有整秒精度, 见 §6.2 A5)
   134	_SUBSECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}\.\d+")
   135	#: review/1 的 review_time 完整形态: 必须含秒段且无小数秒 (round-4 HIGH#1 —
   136	#: 省略秒的 '10:00+00:00' 不是任何写点会产出的形态, 与 W 的整秒口径对不齐)
   137	_WHOLE_SECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}(Z|[+-]\d{2}:[0-5]\d)$")
   138	
   139	
   140	def _parse_ts(value: object, upper_bound: Optional[datetime] = None) -> tuple[bool, str]:
   141	    """扩展格式 ISO-8601 datetime 且 timezone-aware → (True, ''); 否则 (False, 原因)。
   142	
   143	    受理语法 (§三, 白名单正则): YYYY-MM-DD[Tt ]HH:MM[:SS[.f+]](Z|±HH:[0-5]M)。
   144	    先过正则再 fromisoformat 验语义 (月/日/时分秒取值合法)。
   145	    """
   146	    if not isinstance(value, str) or not value:
   147	        return False, "必须为非空字符串"
   148	    if not _TS_RE.match(value):
   149	        return False, f"不符 §三 受理语法 YYYY-MM-DD[T ]HH:MM[:SS[.f]](Z|±HH:MM): {value!r}"
   150	    text = value[:-1] + "+00:00" if value.endswith("Z") else value
   151	    try:
   152	        parsed = datetime.fromisoformat(text)
   153	    except ValueError:
   154	        return False, f"非法日期时间取值: {value!r}"
   155	    if parsed.tzinfo is None:
   156	        return False, f"缺 timezone (必须 aware): {value!r}"
   157	    try:
   158	        # round-5 MEDIUM: UTC 归一化会越界的极端日期 (如 0001-01-01+08:00)
   159	        # 在 bridge 的 astimezone(UTC) 处会抛 OverflowError — 提前拦
   160	        normalized = parsed.astimezone(timezone.utc)
   161	    except (OverflowError, OSError, ValueError):
   162	        return False, f"UTC 归一化越界 (下游 astimezone 会溢出): {value!r}"
   163	    # round-11 MEDIUM: 原用 `is` 判身份, 传值相等但新建的 datetime 会错误接受端点
   164	    bound_exclusive = upper_bound is not None and upper_bound == REVIEW_INPUT_MAX
   165	    if (normalized >= REVIEW_INPUT_MAX) if bound_exclusive else (normalized > (upper_bound or TIMESTAMP_MAX)):
   166	        # A7 (round-6 MEDIUM, round-7 分档): review 输入用更保守的
   167	        # REVIEW_INPUT_MAX (调度还要叠加 interval + A3 的 +1s);
   168	        # 一般时间戳只拦 UTC 归一化本身会溢出的极端值
   169	        bound = upper_bound or TIMESTAMP_MAX
   170	        relation = "须严格小于" if bound_exclusive else "不得超过"
   171	        return False, f"A7 时间域: {relation} {bound.date()} : {value!r}"
   172	    return True, ""
   173	
   174	
   175	#: A7 上界分两档 (round-7 MEDIUM: 原实现把一个上界通用到所有时间字段,
   500	    ⚠️ 只接受**字节**而非路径: proof 校验必须在单一快照上完成, 否则抽取与
   501	    prefix 可能读到不同版本 (round-15 Codex HIGH: 两次 read_bytes 之间的
   502	    并发追加会让最外层尾部门失效)。
   503	    """
   504	    problems: list[str] = []
   505	    scan = {
   506	        "applicable": [],
   507	        "node_event_lines": [],
   508	        "unextended_lines": [],
   509	        "degraded_lines": [],
   510	        "vault_ids": set(),
   511	        "vault_id_lines": set(),
   512	        "review_ext_lines": [],
   513	        "bad_lines": [],
   514	        "blank_lines": [],
   515	        "unknown_version_lines": [],
   516	        "unroutable_lines": [],
   517	    }
   518	    for idx, chunk in enumerate(_split_ledger_lines(raw), start=1):
   519	        if not chunk.strip():
   520	            # round-16 Codex MEDIUM: 主体校验判空行违规 (append-only JSONL 不
   521	            # 应出现), scanner 原本静默跳过 —— 两处口径必须一致
   522	            scan["blank_lines"].append(idx)
   523	            continue
   524	        try:
   525	            record = _strict_loads(chunk.decode("utf-8"))
   526	        except (UnicodeDecodeError, ValueError, RecursionError):
   527	            # round-15 Codex MEDIUM: 原实现静默 continue —— 但无法判断坏行
   528	            # 是否本应参与该节点的 proof, 静默跳过即静默削弱尾部门 ⇒ fail-closed
   529	            scan["bad_lines"].append(idx)
   530	            continue
   531	        if not isinstance(record, dict):
   532	            continue
   533	        # round-20 Codex MEDIUM: 原实现**先按 v1 的 node_id 过滤、再判版本** ——
   534	        # 一条改名/删除了 node_id 的合法 v2 行会被当成"不属于本节点"整个跳过,
   535	        # scanner 完全看不见它 ⇒ proof 静默放过无法解释的记录。§一 已冻结
   536	        # 路由信封 (event_id/event_version/node_id 任何版本都必须保留), 故缺
   537	        # node_id 的记录一律**不可路由**并 fail-closed —— 恰恰因为无法判定归属。
   538	        raw_node = record.get("node_id")
   539	        if not isinstance(raw_node, str):
   540	            scan["unroutable_lines"].append(idx)
   541	            continue
   542	        if raw_node != node_id:
   543	            continue
   544	        # round-19 Codex MEDIUM: 主体按 §一 前向兼容规则跳过未知 event_version,
   545	        # 而 scanner 原本解析后直接按 v1 取字段 —— 一条**合法的** v2 行会被当 v1
   546	        # 解释 (其 vault_id 进集合、其 review/1 标记被采信), 造成合法 proof 假阳性。
   547	        # proof 侧既不能解释它, 也不能假装它不存在 ⇒ 记录并 fail-closed。
   548	        if record.get("event_version") != EVENT_VERSION:
   549	            scan["unknown_version_lines"].append(idx)
   550	            continue
   551	        scan["node_event_lines"].append(idx)
   552	        payload = record.get("payload")
   553	        if not isinstance(payload, dict) or payload.get("schema_ext") != REVIEW_EXT_MARKER:
   554	            # round-16 Codex MEDIUM: §6.2 要求的是"其全部**复习事件**都带
   555	            # review/1", 不是全部节点事件 —— 原实现把同节点的 callout_ingested
   556	            # 等合法非复习事件也算作"历史不完整", 误拒 new_card
   557	            if record.get("event_type") in REVIEW_EVENT_TYPES:
   558	                scan["unextended_lines"].append(idx)
   559	            continue
   560	        # round-18 Codex HIGH: vault 归属必须在 out_of_order 的 continue **之前**
   561	        # 收集 —— 否则一条"真正的乱序"行可以把**另一个 vault** 的合规事件整个藏起来
   562	        # (实测: L1 vault=A 正常、L2 vault=B 标真乱序 ⇒ scan.vault_ids 只剩 {A},
   563	        # proof 声称 vault=A 返回 [])。§6.2 声称 scanner 抽取的是该节点事件的
   564	        # vault 集合, 不是"适用集的 vault 集合"。
   565	        vault_id = payload.get("vault_id")
   566	        if isinstance(vault_id, str) and vault_id:
   567	            scan["vault_ids"].add(vault_id)
   568	            scan["vault_id_lines"].add(idx)
   569	        scan["review_ext_lines"].append(idx)
   570	
   571	        if "out_of_order" in payload:
   572	            # round-16 Codex HIGH: 原实现按"键是否存在"排除 —— 写
   573	            # `out_of_order: false` 即可把尾部事件从适用集里藏掉, 绕过尾部门。
   574	            # §6.2 冻结: 该键唯一合法值是布尔 true, 未标则不写该键。
   575	            if payload["out_of_order"] is not True:
   576	                problems.append(
   577	                    f"第 {idx} 行: out_of_order 形态非法 ({payload['out_of_order']!r}) — "
   578	                    f"§6.2 冻结其唯一合法值为布尔 true, 未标则不写该键; 该行仍计入适用集"
   579	                )
   580	            else:
   581	                # round-17 Codex HIGH: 形态合法**不等于**语义为真 —— §6.2 定义
   582	                # 乱序 = "review_time 早于已应用的最新事件"。若某行标了
   583	                # out_of_order 而其 review_time 却**晚于前面所有适用事件**, 它
   584	                # 就是一个被伪装成乱序的真实后继, 排除它即绕过尾部门。
   585	                marked_at = _instant(payload.get("review_time"))
   586	                prior = [_instant(ts) for _, ts, _ in scan["applicable"]]
   587	                prior = [i for i in prior if i is not None and i.tzinfo is not None]
   588	                if marked_at is not None and marked_at.tzinfo is not None and (not prior or marked_at > max(prior)):
   589	                    problems.append(
   590	                        f"第 {idx} 行标了 out_of_order, 但其 review_time 晚于此前所有适用事件 — "
   591	                        f"§6.2 的乱序判据是 review_time <= W, 该行是被伪装成乱序的真实后继; 仍计入适用集"
   592	                    )
   593	                else:
   594	                    continue
   595	        review_time = payload.get("review_time")
   596	        event_id = record.get("event_id")
   597	        if not isinstance(review_time, str) or not isinstance(event_id, str):
   598	            problems.append(f"第 {idx} 行: review_time/event_id 非字符串, 无法参与 proof")
   599	            continue
   600	        if any(
   601	            isinstance(payload.get(key), str) and payload[key].startswith(DEGRADED_PREFIX)
   602	            for key in ("fsrs_library_version", "fsrs_params_hash")
   603	        ):
   604	            scan["degraded_lines"].append(idx)  # 双哨兵不重复记同一行 (round-16 LOW)
   605	        scan["applicable"].append((idx, review_time, event_id))
   606	    return scan, problems
