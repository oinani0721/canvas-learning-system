   891	def _normalize_inline_calibration(fm_text):
   892	    """`calibration_log: []` (inline 空列表) 必须先原子改写成 block 形态, 否则
   893	    后面直接在它下面插缩进条目会产出**非法 YAML** (`calibration_log: []` 后跟
   894	    缩进列表) —— 实测首次评分 rc=0 且 attempt/W/账本都已推进, 同事件重跑却报
   895	    「FSRS 已应用但缺校准记录」⇒ 两阶段流程**永久不收敛** (Codex round-6 HIGH)。
   896	    """
   897	    # 同样容尾注释: `calibration_log: [] # comment` 若不规范化会被写成非法 YAML。
   898	    # ⛔ `null` / `~` 也必须规范化 (Codex round-9 HIGH): 它们同样是**合法 YAML**,
   899	    # 直接在其下插缩进条目会产出 `mapping values are not allowed here` 的非法
   900	    # 文档 —— 首跑 rc=0 但节点从此不可解析, 后续所有评分连锁失败。
   901	    return re.sub(
   902	        r"^calibration_log:[ \t]*(?:\[[ \t]*\]|null|Null|NULL|~)?[ \t]*(#[^\n]*)?$",
   903	        lambda m: "calibration_log:" + (" " + m.group(1) if m.group(1) else ""),
   904	        fm_text, count=1, flags=re.M,
   905	    )
