   815	def _apply_mastery(fm_text, biz_ts, gn=None):
   816	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   817	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   818	    old = None
   819	    for key in ("mastery_score", "mastery", "mastery_level"):
   820	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   821	        if mo:
   822	            old = float(mo.group(1)); break
   823	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   824	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   825	    if ma and mb:
   826	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   827	    elif old is not None:
   828	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   829	    else:
   830	        a_, b_ = PRIOR_A, PRIOR_B
   831	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   832	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   833	    days_idle = 0.0
   834	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   835	    if mle:
   836	        try:
   837	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   838	        except ValueError:
   839	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   840	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   841	    # 用 GN2 而非 GN (内部对抗审查 MEDIUM): durable payload 锁的是 round(GN,2),
   842	    # 而 mastery 若用未舍入的 GN, 同一个 durable 事件在「首跑 gn=0.752」与
   843	    # 「恢复重试 gn=0.7549」两次下会算出不同的 mastery_a —— envelope 判它们
   844	    # 同一件事(两侧 GN2 都是 0.75), 产物却不同。业务量恒取账本锁住的那个值。
   845	    # gn=None ⇒ 用本次评分的 GN2; A2 重放别人的事件时传那行 durable 的 grade_norm。
   846	    a_, b_ = update_after_idle(a_, b_, GN2 if gn is None else float(gn), days_idle)
   847	    return old, a_, b_, round(mu(a_, b_), 2)
   848	
   849	# ── G3-2 三态判别 (复用校验器 classify_card_state, schema §6.2)。
   850	# degraded(残缺卡) → fail-closed: 报错、零写节点、检验白板停在
   851	# scored_pending_node_update 续跑态 (裁决③)。
   852	_fields = fields_from_frontmatter(fm)
   853	_state, _reason = classify_card_state(_fields)
   854	if _state == "degraded":
   855	    raise SystemExit(f"[quiz-answer] 节点调度状态残缺 (classify_card_state: {_reason}), fail-closed 拒写 — 请人工修复 {NODE} 后重跑")
   856	W = _fields.get("fsrs_last_review")
   857	W_inst = _aware(W) if W else None
   858	
   859	# ── G3-2 vault_id 绑定 (与校验器同函数同链路; 绑不出 = 配置断裂, fail-closed)
   860	_vid = _vault_id_of(Path(EV))
   861	if not _vid:
   862	    raise SystemExit("[quiz-answer] vault 归属无法绑定 (.canvas-config.yaml 缺失/损坏或 backend 不可达), fail-closed 拒写事件")
