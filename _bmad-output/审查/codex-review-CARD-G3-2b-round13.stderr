   369	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   370	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   371	# 出现重复时停下, 不猜)。误报方向 fail-closed (顶格错位文本会被当键) 可接受。
   372	FSRS_KEYS = ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review")
   373	_watched = ("type", "source_board", "mastery_score", "mastery", "mastery_level",
   374	            "mastery_a", "mastery_b", "attempt_count", "last_examined", "calibration_log") + FSRS_KEYS
   375	_keycount = {}
   376	for _mm in re.finditer(r'^([A-Za-z_][A-Za-z0-9_-]*):', fm, re.M):
   377	    _keycount[_mm.group(1)] = _keycount.get(_mm.group(1), 0) + 1
   378	_dupkeys = sorted(k for k, c in _keycount.items() if c > 1 and k in _watched)
   379	if _dupkeys:
   380	    raise SystemExit(f"[quiz-answer] frontmatter 重复键 {_dupkeys} (解析歧义不可证), fail-closed 拒写 — 请手工修复节点后重跑")
