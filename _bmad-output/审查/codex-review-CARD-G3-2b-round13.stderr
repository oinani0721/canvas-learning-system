   465	def _split_ledger_lines(raw: bytes) -> list[bytes]:
   466	    """账本字节 → 物理行列表 (1-based 行号 = 索引 + 1)。
   467	
   468	    ⚠️ 必须按 \\n 切分, **不能**用 splitlines(): 后者还会在 \\r / \\v / \\f /
   469	    \\x1c-\\x1e / \\x85 处断行, 与主体校验 (二进制文件迭代, 只认 \\n) 和
   470	    prefix 计算的行号定义不一致 —— 一条含裸 CR 的记录会让两套编号错位,
   471	    cursor_line 与 prefix 指向不同的行 (round-15 自查实证)。
   472	    """
   473	    chunks = raw.split(b"\n")
   474	    if chunks and chunks[-1] == b"":
   475	        chunks.pop()  # 末尾 LF 不产生额外空行
   476	    return chunks
   477	
   478	
   479	def scan_ledger_bytes(raw: bytes, node_id: object) -> tuple[dict, list[str]]:
   480	    """在**同一份字节快照**上扫出 proof 所需的全部账本事实。
   481	
   482	    返回 (scan, problems)。scan 各键:
   483	      - `applicable`：[(行号, review_time, event_id)] —— node 相同、
   484	        `event_version == 1`、`schema_ext == "review/1"`、未标 `out_of_order`
   485	        (或标了但语义不成立) 的事件;
   486	      - `node_event_lines`：该节点**全部 v1 事件**的行号 (不限 review/1; 未知
   487	        版本的行不在其中, 单列于 `unknown_version_lines`) ——
   488	        §6.2 genesis 锚要求的是"最早一条事件", 不是"最早适用事件";
   489	      - `unextended_lines`：该节点**无 review/1 扩展**的事件行号 —— 存在即
   490	        禁止走 new_card 分支 (§6.2: 账本历史不完整时须人工裁定);
   491	      - `degraded_lines`：算法身份为 `degraded:*` 哨兵的适用事件行号;
   492	      - `vault_ids`：该节点**全部 review/1 事件** payload 里出现过的 vault_id
   493	        集合 (含标了 out_of_order 的行 —— round-18 HIGH: 若只收适用集, 一条合法
   494	        乱序行就能把另一个 vault 的事件藏起来);
   495	      - `review_ext_lines`：该节点全部 review/1 行的行号 (vault 覆盖率的分母);
   496	      - `unknown_version_lines`：该节点 event_version != 1 的行号 (proof 无法解释);
   497	      - `unroutable_lines`：缺少可用 node_id 的行号 (归属不可判定, §一 路由信封);
   498	      - `bad_lines`：无法解码/解析的行号。
   499	
   500	    ⚠️ 只接受**字节**而非路径: proof 校验必须在单一快照上完成, 否则抽取与

