  3967	    LED.write_text(json.dumps(row, ensure_ascii=False) + "\n", encoding="utf-8")
  3968	    assert _run_validator(vault).returncode == 0, "被篡改的行本身仍合规（正是它难抓的原因）"
  3969	    r = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3970	    assert r.returncode != 0, "水位线为空时采用时刻≠原始时刻的行必须拒"
