  3988	def test_round12_high3_legacy_row_missing_scored_at_is_actionable(vault):
  3989	    """HIGH③：round-8 之前的旧行没有 `scored_at`，A3 推过之后重跑无法自行收敛。
  3990	
  3991	    ⛔ 判定不变（原始时刻在旧行里根本没记，确实不可证），变的是**拒因**：必须点名
  3992	    「账本行缺字段」并给出可执行的迁移，而不是笼统的「与本次评分事实不一致」。
  3993	
  3994	    ⚠️ 门的两半各自说明它证明了什么：
  3995	    - **干净场景**（唯一的问题就是缺字段，校准条目保留）：拒因点名差异，
  3996	      **补上账本行的 `scored_at` 后确实收敛**（rc=0）——这条是可验证的承诺。
  3997	    - **无 receipt 场景**（校准条目也丢了）：触发本轮新增的迁移指引；补完之后会
  3998	      转到「已应用但缺校准记录」那条指引 —— 那是**另一个**问题，指引里已如实写明。
  3999	    """
  4000	    LED = vault / "learning_events.jsonl"
  4001	
  4002	    def _legacy(drop_receipt):
  4003	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4004	        LED.unlink(missing_ok=True)
  4005	        assert _run_writer_settled(vault, _payload(event_id="E0#q1", ts=TS1, review_time=TS1)).returncode == 0
  4006	        assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  4007	        rows = list(_ledger_lines(vault))
  4008	        assert rows[-1]["payload"]["review_time"] != rows[-1]["payload"]["scored_at"], "本例必须真的触发过 A3"
  4009	        del rows[-1]["payload"]["scored_at"]
  4010	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  4011	        if drop_receipt:
  4012	            nd = (vault / NODE_REL).read_text(encoding="utf-8")
  4013	            nd2 = re.sub(r'\n  - event_id: "quiz:板A#q1"(?:\n    [^\n]*)*', "", nd, count=1)
  4014	            assert nd2 != nd, "预置必须真的删掉板A的校准条目"
  4015	            (vault / NODE_REL).write_text(nd2, encoding="utf-8")
  4016	        assert _run_validator(vault).returncode == 0, "旧行本身合规（正是它难抓的原因）"
  4017	
  4018	    # ── 干净场景：拒因点名差异，且**补账本即收敛**
  4019	    _legacy(drop_receipt=False)
  4020	    face = _write_face(vault)
  4021	    r = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  4022	    assert r.returncode != 0
  4023	    assert "scored_at" in r.stderr, f"拒因必须点名是哪个字段对不上: {r.stderr[:300]}"
  4024	    assert _write_face(vault) == face, "零写"
  4025	    rows2 = list(_ledger_lines(vault))
  4026	    rows2[-1]["payload"]["scored_at"] = TS1
  4027	    LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows2) + "\n", encoding="utf-8")
  4028	    r_ok = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  4029	    assert r_ok.returncode == 0, f"⛔ 补上账本的 scored_at 后必须真的收敛: {r_ok.stderr[:300]}"
  4030	
  4031	    # ── 无 receipt 场景：触发迁移指引，且指引**不得**承诺一步到位
  4032	    _legacy(drop_receipt=True)
  4033	    face2 = _write_face(vault)
  4034	    r2 = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  4035	    assert r2.returncode != 0
  4036	    assert "没有 scored_at" in r2.stderr, f"拒因必须点名旧行缺字段: {r2.stderr[:300]}"
  4037	    assert "永远不会自行收敛" in r2.stderr, "必须告诉用户重跑无用"
