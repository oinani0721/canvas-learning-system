   318	    if not has_step or not step_ok:
   319	        return "degraded", "state=3(Relearning) 须带非负整数 fsrs_step (缺失时真实 review() 抛 AssertionError)"
   320	    problem = _domain_ok()
   321	    if problem:
   322	        return "degraded", f"state=3 的 {problem}"
   323	    return "normal", "Relearning 且 step 与 S/D 齐备"
