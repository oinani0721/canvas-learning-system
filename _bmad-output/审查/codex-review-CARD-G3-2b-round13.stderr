  3779	def test_round12_facts_list_is_frozen(vault):
  3780	    """事实清单**冻结**：四个判断「已应用」的站点不得各传各的。
  3781	
  3782	    ⛔ round-12 的 3 条 BLOCKER + HIGH① 共同根因就是这个：round-11 抽出了统一
  3783	    resolver，却**没有统一各调用点的事实清单** —— `≤W` 扫描 0 项（只查 ID 在不在）、
  3784	    F1-only 5 项（漏 `exam_board`）、dup 0 项、foreign 3 项。
  3785	    「抽了函数却让调用方随意传缺项」是「修一半」的又一变体。
  3786	    """
  3787	    src = SKILL.read_text(encoding="utf-8")
  3788	    assert "_FACT_KEYS = (" in src, "事实键集必须具名冻结"
  3789	    assert src.count("def _facts_of_row(") == 1 and src.count("def _facts_of_current(") == 1
  3790	    # 四个站点全部走构造器，没有手写清单残留
  3791	    assert src.count("facts=_facts_of_row(") == 3, "≤W / dup / foreign 三处必须走行构造器"
  3792	    assert src.count("facts=_facts_of_current(") == 1, "F1-only 必须走候选构造器"
  3793	    assert '"scored_at": (_SCORED_AT, lambda' not in src, "不得残留手写事实清单"
  3794	    # 传缺项必须是**编程错误**而不是静默放行
  3795	    # ⛔ 判据要挂在**守卫本身**上，不是挂在消息串上：把 `if set(...) != set(...)` 改成
