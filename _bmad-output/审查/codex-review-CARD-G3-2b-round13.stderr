   609	def extract_applicable(source, node_id: object) -> tuple[list[tuple[int, str, str]], list[str]]:
   610	    """`scan_ledger_bytes()` 的便捷入口 → (适用事件, 违规)。接受 Path 或 bytes。"""
   611	    raw, read_problems = _ledger_bytes(source)
   612	    if raw is None:
   613	        return [], read_problems
   614	    scan, problems = scan_ledger_bytes(raw, node_id)
   615	    return scan["applicable"], read_problems + problems
   616	
   617	
   618	def _ledger_bytes(source) -> tuple[Optional[bytes], list[str]]:
   619	    if isinstance(source, (bytes, bytearray)):
   620	        return bytes(source), []
   621	    try:
   622	        return Path(source).read_bytes(), []
   623	    except OSError as exc:
   624	        return None, [f"账本不可读: {exc}"]
   625	
   626	
   627	def ledger_prefix(source, cursor_line: int) -> tuple[Optional[str], bool, list[str]]:
   628	    """账本从第 0 字节到第 `cursor_line` 行终止 LF (含) 的 sha256。接受 Path 或 bytes。
   629	
   630	    返回 (sha256 十六进制, 该行是否无终止 LF, 违规)。§6.2 `ledger_prefix_sha256`
   631	    与 `prefix_ends_without_lf` 的**可执行定义** —— 此前只有散文, 无法复算。
   632	    """
   633	    raw, problems = _ledger_bytes(source)
   634	    if raw is None:
   635	        return None, False, problems
   636	    offset = 0
   637	    for seen in range(1, cursor_line + 1):
   638	        nl = raw.find(b"\n", offset)
   639	        if nl == -1:
   640	            if seen == cursor_line and offset < len(raw):
   641	                return hashlib.sha256(raw).hexdigest(), True, []
   642	            return None, False, [f"账本不足 {cursor_line} 行"]
   643	        offset = nl + 1
   644	    return hashlib.sha256(raw[:offset]).hexdigest(), False, []
   645	
   646	
   647	def _frontmatter_fsrs_keys(text: str) -> tuple[list[str], bool]:
   648	    """frontmatter 原文 → (顶层 `fsrs_*` 键列表, 是否用真 YAML 解析)。
   649	
   650	    round-15 Codex HIGH/NEW-FINDING 双向修正:
   651	      - 加引号的顶层键 `"fsrs_state": 2` 是合法 YAML, 原正则识别不出 (漏检);
   652	      - block scalar 正文里的 `fsrs_state: ...` 是字符串内容不是键, 原正则
   653	        误判 (误拒)。
   654	    有 PyYAML 时按真语义取顶层键; 无则退化为**行首** (第 0 列) 正则 ——
   655	    顶层键必在第 0 列, 故缩进的 block scalar 正文不再误命中。
   656	    """
   657	    try:
   658	        import yaml
   659	    except ImportError:
   660	        yaml = None
   661	    if yaml is not None:
   662	        try:
   663	            data = yaml.safe_load(text)
   664	        except Exception:
   665	            return ["<frontmatter 无法解析>"], True
   666	        if data is None:
   667	            return [], True
   668	        if not isinstance(data, dict):
   669	            return ["<frontmatter 顶层非映射>"], True
   670	        return sorted(k for k in data if isinstance(k, str) and k.startswith("fsrs_")), True
   671	    # round-16 Codex HIGH: 无 PyYAML 时的正则 fallback 会漏掉 YAML 转义键
   672	    # (如 `"fsrs_state": 2` 语义即 fsrs_state), 而 schema 并未授权"依赖
   673	    # 不可达就削弱 genesis 门" ⇒ 该路径必须 fail-closed。正则命中的仍一并报出。
   674	    found = {m.group(1) for m in re.finditer(r"(?m)^[\"']?(fsrs_[A-Za-z0-9_]*)[\"']?\s*:", text)}
   675	    return sorted(found), False
   676	
   677	
   678	def _verify_proof_level(
   679	    proof: object,
   680	    applicable: list[tuple[int, str, str]],
   681	    *,
   682	    scan: Optional[dict] = None,
   683	    ledger_raw: Optional[bytes] = None,
   684	    ledger_vault_id: Optional[str] = None,
   685	    is_top_level: bool = True,
   686	    _depth: int = 0,
