  3947	def test_round12_high2_adopted_time_in_crash_window(vault):
  3948	    """HIGH②：append 后崩溃、frontmatter 尚无 receipt 时，采用时刻仍必须可证。
  3949	
  3950	    ⛔ 实测漏算链：把 durable 的 `effective_at` 与 `payload.review_time` **同步**改到
  3951	    12-01（`scored_at` 保持 08-01）⇒ 旧实现 writer rc=0、validator 全程 rc=0，
  3952	    而水位线被恢复成 12-01 —— 此后所有早于 12 月的真实复习都被当成「已过水位线」而漏算。
  3953	    三方绑定在这里帮不上忙：receipt 不存在，没有第三个瞬间可比。
  3954	
  3955	    可判别的约束来自 **A3 语义本身**：A3 只在水位线**非空**时才把采用时刻推到 W+1s，
  3956	    所以「水位线为空」⇒ 该行的 `review_time` 必等于 `scored_at`。
  3957	    """
  3958	    LED = vault / "learning_events.jsonl"
  3959	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3960	    LED.unlink(missing_ok=True)
  3961	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  3962	    row = list(_ledger_lines(vault))[0]
  3963	    # 崩溃窗：节点回到初始（无 receipt、W 为空），账本保留那一行
  3964	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3965	    row["effective_at"] = "2026-12-01T10:00:00Z"
