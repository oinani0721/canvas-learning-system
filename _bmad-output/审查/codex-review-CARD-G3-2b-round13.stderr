  4039	    assert _write_face(vault) == face2, "零写"
  4040	
  4041	    # ── 验伪：**不缺** scored_at 的真实事实冲突不得被说成「需要迁移」
  4042	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4043	    LED.unlink(missing_ok=True)
  4044	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  4045	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
