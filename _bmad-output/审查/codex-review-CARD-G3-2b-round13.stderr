   101	def _review_row(**over):
   102	    """一条 canonical review/1 durable 行 (与生产写点键集逐字同形)。"""
   103	    row = {
   104	        "event_id": "quiz:板A#q1",
   105	        "event_version": 1,
   106	        "event_type": "answer_scored",
   107	        "node_id": "测试节点",
   108	        "recorded_at": TS1,
   109	        "effective_at": TS1,
   110	        "payload": {
   111	            "schema_ext": "review/1",
   112	            "vault_id": "canvas_vault_测试",
   113	            "concept_id": "测试节点",
   114	            "rating": 3,
   115	            "grade_norm": 0.75,
   116	            "review_time": TS1,
   117	            "fsrs_library_version": "degraded:historic-run",
   118	            "fsrs_params_hash": "degraded:historic-run",
   119	            "exam_board": "检验白板/板A.md",
   120	            "attempt_count": 1,
   121	        },
   122	    }
   123	    for k, v in over.items():
   124	        if k.startswith("payload."):
   125	            row["payload"][k.split(".", 1)[1]] = v
   126	        else:
   127	            row[k] = v
   128	    return row
   129	
   130	
   131	def _write_ledger(vault: Path, *rows, trailing_lf=True):
   132	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
   133	    if not trailing_lf and text.endswith("\n"):
   134	        text = text[:-1]
   135	    (vault / "learning_events.jsonl").write_text(text, encoding="utf-8")
   136	
   137	
   138	def _payload(**kw):
   139	    """⚠️ `review_time`（稳定业务时刻）**默认与 ts 相等**，但那正是 round-8
   140	    MEDIUM 指出的盲区：AST 统计 181 次调用只有 11 次显式传它，且所有首写都令
   141	    `review_time == ts` —— 于是「首写用了哪个时刻」这个区别**在测试里根本不
   142	    存在**，3 条 BLOCKER 全绿。门㊼ 专门覆盖 `review_time != ts` 的组合。
   143	    """
   144	    base = {
   145	        "node": NODE_REL,
   146	        "grade_norm": 0.752,
   147	        "ts": TS1,
   148	        "review_time": TS1,
   149	        "event_id": EID,
   150	        "exam_board": "检验白板/测试检验-2026-08-01-1000.md",
   151	        "question_id": "q1",
   152	        "source_board": "[[原白板/CS 61B]]",
   153	        "self_confidence_raw": "半懂",
   154	        "self_confidence_norm": 0.5,
   155	        "abandoned": False,
   156	        "callout": "",
   157	    }
   158	    # ⚠️ `review_time` 的默认值取决于**这是不是同一次评分**：
   159	    #   · 只改 `ts`、`event_id` 不变 ⇒ 「同一次评分在另一时刻**续跑**」
   160	    #     ⇒ review_time 保持不变（`ts` = 日志行何时写的，`review_time` = 评分
   161	    #       何时发生的）。让它跟着 ts 走，门就从「测续跑」变成「测换业务时刻」，
   162	    #       会被 envelope 正确拒绝 —— 那是门的语义被改了，不是实现坏了。
   163	    #   · 换了 `event_id` ⇒ 另一次评分 ⇒ review_time 跟随 ts。
   164	    # 要测「同 ID 换业务时刻」必须**显式**传不同的 review_time（门㊼ 就这么做）。
   165	    if "ts" in kw and "review_time" not in kw and "event_id" in kw:
   166	        # 同时给了 event_id 与 ts ⇒ 这是**另一次**评分 ⇒ 业务时刻跟随 ts。
   167	        # 只给 ts（event_id 用默认）⇒ 同一次评分的**续跑** ⇒ 业务时刻不变。
   168	        base["review_time"] = kw["ts"]
   169	    base.update(kw)
   170	    return base
   171	
   172	
   173	@pytest.fixture()
   174	def vault(tmp_path):
   175	    """完整镜像布局: REPO=tmp_path, VAULT=tmp_path/canvas-vault。
   176	
   177	    被测代码 (validator/bridge/decay_beta) 全部 symlink 引真文件 —
   178	    主树漂移即被本文件测到, fsrs 真实参与。
   179	    ⚠️ Codex round-1 MEDIUM 如实声明: bridge 是 symlink, 其 `_venv_python()`
   180	    对 `__file__` 调 resolve() 会穿回 WT — re-exec 实际命中 **WT 的 venv**
   181	    (与 fixture 同一解释器, 结果等价), tmp 的目录级 backend/.venv symlink
   182	    **不参与** re-exec 选路 (保留它是为了 bridge 若改为 copy 布局仍可达,
   183	    及文件级 symlink 会丢 pyvenv.cfg 的实测教训)。本 fixture 证明的是
   184	    「bridge re-exec 链可达且 fsrs 真实参与」, 不是「tmp candidate 被选中」。
   185	    """
   186	    repo = tmp_path
   187	    v = repo / "canvas-vault"
   188	    (v / "节点").mkdir(parents=True)
   189	    (v / ".claude" / "scripts").mkdir(parents=True)
   190	    (repo / "backend" / "scripts").mkdir(parents=True)
   191	    (repo / "backend" / ".venv").symlink_to(WT / "backend" / ".venv", target_is_directory=True)
   192	    (repo / "backend" / "scripts" / "validate_learning_events.py").symlink_to(VALIDATOR)
   193	    (v / ".claude" / "scripts" / "fsrs_bridge.py").symlink_to(VAULT_SCRIPTS / "fsrs_bridge.py")
   194	    (v / ".claude" / "scripts" / "decay_beta.py").symlink_to(VAULT_SCRIPTS / "decay_beta.py")
   195	    # 故意连字符+中文: 校验器绑定的是 sanitize 后的 canvas_vault_测试;
   196	    # 写侧漏 sanitize (写原始形式) 会在 validator 绑定比对处翻红
   197	    (v / ".canvas-config.yaml").write_text(
   198	        '# 测试 config\nvault_id: "canvas-vault-测试"\nsubject: cs-61b\n', encoding="utf-8"
   199	    )
   200	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   201	    return v
