   369	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   370	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   371	# 出现重复时停下, 不猜)。误报方向 fail-closed (顶格错位文本会被当键) 可接受。
   372	FSRS_KEYS = ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review")
   373	_watched = ("type", "source_board", "mastery_score", "mastery", "mastery_level",
   374	            "mastery_a", "mastery_b", "attempt_count", "last_examined", "calibration_log") + FSRS_KEYS
   375	_keycount = {}
   376	for _mm in re.finditer(r'^([A-Za-z_][A-Za-z0-9_-]*):', fm, re.M):
   377	    _keycount[_mm.group(1)] = _keycount.get(_mm.group(1), 0) + 1
   378	_dupkeys = sorted(k for k, c in _keycount.items() if c > 1 and k in _watched)
   379	if _dupkeys:
   380	    raise SystemExit(f"[quiz-answer] frontmatter 重复键 {_dupkeys} (解析歧义不可证), fail-closed 拒写 — 请手工修复节点后重跑")
   381	
   382	# ── G3-2 幂等分诊前置判定。两个独立域:
   383	#   F1 = 本 event_id 已在 frontmatter calibration_log (解析层判定, 非子串 —
   384	#        live 实证 Obsidian 会把 yaml 引号规范化掉, json.dumps 子串恒不命中;
   385	#        双引号形态经 json.loads 与写侧 json.dumps 同源反解, 单引号/裸词剥引号)
   386	#   L1 = 账本已有 parsed event_id == evid 的行 (parsed-field equality, 禁子串)
   387	# ⛔ F1 单独不能证明 FSRS 已推进 (degraded 落账写过 calibration 但没写 W —
   388	# Codex round-2 BLOCKER): 「已应用」的机械判据是 W >= durable.review_time,
   389	# 分诊在下方主流程里做, 这里只放解析函数。
   390	# ⚠️ 定义位置: 本函数必须排在**所有**调用点之前 —— 写点是扁平脚本, `≤W` 全账
   391	# 扫描(round-12 起也走 resolver)在文件中段就执行, 而 `_receipt_of` 原先定义在
   392	# 它后面 ⇒ NameError。移到 resolver 全家之前。
   393	def _receipt_of(fm_text, ev_id):
   394	    """从 calibration_log 取出该 event_id 的条目 (结构化读, 与 F1 同源)。"""
   395	    try:
   396	        import yaml  # receipt 读取
   397	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   398	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   399	        if isinstance(_doc, dict) and isinstance(_doc.get("calibration_log"), list):
   400	            for _e in _doc["calibration_log"]:
   401	                if isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id:
   402	                    return _e
   403	    except Exception:
   404	        pass
   405	    return None
