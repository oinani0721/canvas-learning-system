  1122	def _aware_instant(value: object) -> Optional[datetime]:
  1123	    """`_instant()` 的 **timezone-aware 限定**版 —— naive 一律 None。
  1124	
  1125	    round-15 Codex MEDIUM: naive 与 aware 的 datetime 相比会抛 TypeError,
  1126	    proof 校验必须报违规而不是崩溃。
  1127	    """
  1128	    parsed = _instant(value)
  1129	    if parsed is None or parsed.tzinfo is None:
  1130	        return None
  1131	    return parsed
