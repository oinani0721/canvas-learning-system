   288	# ── 门① 同 event_id 重放两次 → frontmatter 不二次推进、账本一行 ──
   289	
   290	
   291	def test_same_event_id_replay_no_double_advance(vault):
   292	    r = _run_writer(vault, _payload())
   293	    assert r.returncode == 0, r.stdout + r.stderr
   294	    w1 = _fm_fields(vault)["fsrs_last_review"]
   295	    ledger = vault / "learning_events.jsonl"
   296	    n1 = len(_ledger_lines(vault))
   297	    # 二跑: recorded_at 变化不构成事实差异 (envelope 显式排除), 必须 no-op
   298	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
   299	    assert r2.returncode == 0, r2.stdout + r2.stderr
   300	    assert _fm_fields(vault)["fsrs_last_review"] == w1, "同 event_id 重放不得二次推进 W"
   301	    assert len(_ledger_lines(vault)) == n1 == 1, "账本必须恰 1 行"
   302	    assert "幂等跳过" in r2.stdout
   303	
   304	
   305	# ── 门② 中断注入: 事件已落账、frontmatter 未推进 → A2 重放恢复 ──
   306	
   307	
   308	def test_crash_window_ledger_without_frontmatter_recovers(vault):
   309	    """卡文 (c)② 字面判据: 恢复产物与直接应用**逐字节相同** (round-2 HIGH:
   310	    旧版只比 FSRS 子集; 现全部副作用 last_examined/calibration.ts 以 durable
   311	    业务时刻为基准, 整节点字节对拍)。"""
   312	    r = _run_writer(vault, _payload())
   313	    assert r.returncode == 0, r.stdout + r.stderr
   314	    golden_bytes = (vault / NODE_REL).read_bytes()
   315	    # 模拟崩溃窗口①: 回滚 frontmatter 到评分前 (账本保留该事件)
   316	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   317	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
   318	    assert r2.returncode == 0, r2.stdout + r2.stderr
   319	    assert len(_ledger_lines(vault)) == 1, "恢复路径不得二次 append"
   320	    assert (vault / NODE_REL).read_bytes() == golden_bytes, (
   321	        "恢复产物必须与直接应用逐字节相同 (side effects 以 durable review_time 为基准)"
   322	    )
   323	    assert "A2 重放已应用" in r2.stdout or "崩溃窗口" in r2.stdout
   324	
   325	
   326	# ── 门③ 追加即崩 (事件未落账) → 账本与 frontmatter 一致 (零写) ──
   327	
   328	
   329	def test_fail_before_append_keeps_ledger_and_node_consistent(vault):
   330	    """bridge exit 2 (naive ts) 在 append 之前 fail-closed — 系统保持评分前
   331	    一致态, 重跑即可 (scored_pending_node_update 续跑语义)。"""
   332	    _face_node = _write_face(vault)
   333	    r = _run_writer(vault, _payload(ts="2026-08-01T10:00:00"))
   334	    assert r.returncode != 0, "naive ts 必须拒绝"
   335	    assert _write_face(vault) == _face_node, "fail-closed 必须零写（节点 + 账本）"
   336	    assert not (vault / "learning_events.jsonl").exists(), "fail-closed 必须零写账本"
   337	
   338	
   339	# ── 门④ 等时 → W+1s (A3 推进口径) ──
   340	
   341	
   342	def test_equal_timestamp_advances_w_plus_one_second(vault):
   343	    (vault / NODE_REL).write_text(NODE_REVIEW_W10, encoding="utf-8")
   344	    r = _run_writer(vault, _payload(ts="2026-08-01T10:00:00Z"))
   345	    assert r.returncode == 0, r.stdout + r.stderr
   346	    rec = _ledger_lines(vault)[0]
   347	    assert rec["payload"]["review_time"] == "2026-08-01T10:00:01Z", "等时必须推进 W+1s"
   348	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-01T10:00:01Z"
   349	    assert rec["payload"]["review_time"] == rec["effective_at"], "review_time 与 effective_at 同一瞬间"
   350	    assert _run_validator(vault).returncode == 0
   351	
