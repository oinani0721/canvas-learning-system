   405	def canonical_state_bytes(state: object) -> tuple[Optional[bytes], list[str]]:
   406	    """proof 里的"状态对象" → canonical JSON 字节 (§6.2 状态对象的唯一形状)。
   407	
   408	    键集按 fsrs_state 分档 (Review 五键省略 fsrs_step); 值类型归一化 (时刻为
   409	    UTC 整秒 Z 串、state/step 为整数 number、S/D 为 float)。返回 (字节, 违规)。
   410	    """
   411	    problems: list[str] = []
   412	    if not isinstance(state, dict):
   413	        return None, ["state 必须是 JSON object"]
   414	
   415	    raw_state = state.get("fsrs_state")
   416	    if not isinstance(raw_state, int) or isinstance(raw_state, bool) or raw_state not in _STATE_KEYS_BY_FSRS_STATE:
   417	        return None, [f"fsrs_state 必须是 number 1/2/3, 得到 {raw_state!r}"]
   418	
   419	    expected = set(_STATE_KEYS_BY_FSRS_STATE[raw_state])
   420	    actual = set(state)
   421	    if actual != expected:
   422	        problems.append(
   423	            f"fsrs_state={raw_state} 的键集必须恰为 {sorted(expected)}, "
   424	            f"多出 {sorted(actual - expected)} / 缺失 {sorted(expected - actual)}"
   425	        )
   426	
   427	    for key, bound in (("fsrs_last_review", REVIEW_INPUT_MAX), ("fsrs_due", TIMESTAMP_MAX)):
   428	        value = state.get(key)
   429	        if not isinstance(value, str) or not _CANONICAL_TS_RE.match(value):
   430	            problems.append(f"{key} 必须是 UTC 整秒 'Z' 串 (%Y-%m-%dT%H:%M:%SZ), 得到 {value!r}")
   431	            continue
   432	        # round-14 Codex MEDIUM: 只过正则会放行 '2026-99-99T99:99:99Z' —— 词法
   433	        # 合规不等于取值合法, 必须真解析 (并复用 A7 的域上界)
   434	        ok, why = _parse_ts(value, upper_bound=bound)
   435	        if not ok:
   436	            problems.append(f"{key} 取值非法: {why}")
   437	
   438	    if "fsrs_step" in expected:
   439	        step = state.get("fsrs_step")
   440	        if not isinstance(step, int) or isinstance(step, bool) or step < 0:
   441	            problems.append(f"fsrs_step 必须是非负整数 number, 得到 {step!r}")
   442	
   443	    for key in ("fsrs_stability", "fsrs_difficulty"):
   444	        value = state.get(key)
   445	        # canonical 要求 float: 整数值也须为 10.0 而非 10 (bool 是 int 子类, 排除)
   446	        if isinstance(value, bool) or not isinstance(value, float):
   447	            problems.append(f"{key} 必须是 JSON float (整数值也写 10.0), 得到 {value!r}")
   448	        elif not math.isfinite(value):
   449	            problems.append(f"{key} 必须有限, 得到 {value!r}")
   450	
   451	    if problems:
   452	        return None, problems
   453	    blob = json.dumps(state, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
   454	    return blob.encode("utf-8"), []
   455	
   456	
   457	def state_hash(state: object) -> tuple[Optional[str], list[str]]:
   458	    """canonical 状态对象 → sha256 十六进制串。"""
   459	    blob, problems = canonical_state_bytes(state)
   460	    if blob is None:
   461	        return None, problems
   462	    return hashlib.sha256(blob).hexdigest(), []
   463	
