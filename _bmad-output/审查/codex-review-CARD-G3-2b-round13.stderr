   365	# ── 门⑥ 残缺卡 → fail-closed 零写 (裁决③) ──
   366	
   367	
   368	def test_degraded_card_fail_closed_zero_write(vault):
   369	    broken = NODE_V0.replace(
   370	        "mastery_score: 0.5\n",
   371	        "mastery_score: 0.5\nfsrs_last_review: 2026-08-01T10:00:00Z\n",
   372	    )  # 只有 W 缺 due/state → classify degraded
   373	    (vault / NODE_REL).write_text(broken, encoding="utf-8")
   374	    _face_deg = _write_face(vault)
   375	    sha = _sha(vault / NODE_REL)
   376	    r = _run_writer(vault, _payload())
   377	    assert r.returncode != 0, "残缺卡必须 fail-closed"
   378	    assert "残缺" in r.stderr or "fail-closed" in r.stderr, r.stderr
