   401	        },
   402	        ensure_ascii=False,
   403	    )
   404	    torn = '{"event_id": "quiz:被截断的事件", "event_version": 1, "event_ty'
   405	    ledger.write_text(full + "\n" + torn, encoding="utf-8")  # 第二行为 partial JSON, 无尾 LF
   406	    r = _run_writer(vault, _payload())
   407	    assert r.returncode == 0, r.stdout + r.stderr
   408	    assert "截断尾行" in r.stdout, "截断尾行必须留痕"
   409	    lines = [ln for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   410	    assert len(lines) == 3, f"新事件必须独立成行 (LF 守卫隔离截断行), 实得 {len(lines)} 行"
   411	    assert json.loads(lines[0])["event_id"] == "exam:旧板", "完整旧行必须原样保留"
   412	    assert json.loads(lines[2])["event_id"] == "quiz:" + EID, "新事件行必须独立可解析"
