  1548	def validate_file(path: Path) -> tuple[list[str], list[str]]:
  1549	    """整文件校验 → (violations, warnings), 均按行号升序。
  1550	
  1551	    逐行二进制读+独立 UTF-8 解码: 单行坏字节序列 = 该行违规,
  1552	    不中断其余行的校验 (Codex round-1: 原 text-mode 读会炸 traceback)。
  1553	    """
  1554	    violations: list[str] = []
  1555	    warnings: list[str] = []
  1556	    seen_ids: dict[str, int] = {}
  1557	    manifest = _golden_manifest()
  1558	    vault_id = _vault_id_of(path)
  1559	
  1560	    with open(path, "rb") as f:
  1561	        for lineno, raw in enumerate(f, 1):
  1562	            try:
  1563	                decoded = raw.decode("utf-8")
  1564	            except UnicodeDecodeError as e:
  1565	                violations.append(f"LINE {lineno}: 非法 UTF-8 字节序列 (offset {e.start}) — 疑似损坏行")

