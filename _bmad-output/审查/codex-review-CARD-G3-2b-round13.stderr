   353	# ── 门⑤ 小数秒输入 → 整秒 (A5) ──
   354	
   355	
   356	def test_fractional_second_input_truncated_to_whole_second(vault):
   357	    r = _run_writer(vault, _payload(ts="2026-08-01T10:00:00.731Z"))
   358	    assert r.returncode == 0, r.stdout + r.stderr
   359	    rec = _ledger_lines(vault)[0]
   360	    assert rec["payload"]["review_time"] == "2026-08-01T10:00:00Z", "小数秒必须入口截断"
   361	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-01T10:00:00Z"
   362	    assert _run_validator(vault).returncode == 0, "整秒产物必须过校验器"
