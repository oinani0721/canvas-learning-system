   438	# ⛔ 事实清单**冻结** (Codex round-12 BLOCKER×3 + HIGH① 的共同根因):
   439	# round-11 抽出了统一的 resolver, 但**没有统一各调用点的事实清单** —— 四个判断
   440	# 「这次评分是否已应用」的站点各传各的:
   441	#   ≤W 全账扫描  0 项(只查 ID 在不在)  ⇒ validator-valid 的事实污染永久漏算一行
   442	#   F1-only      5 项(漏 exam_board)   ⇒ 同 ID 换白板的另一次评分被静默吞掉
   443	#   dup          0 项(只做三方绑定)
   444	#   foreign      3 项(漏 event_id/attempt/board)
   445	# 「抽了函数却让调用方随意传缺项」是「修一半」的又一变体。
   446	# 解法: 键集冻结 + 由**构造器**产出, 调用方不能传部分清单 —— 让「缺项」不可能。
   447	# ⚠️ `event_id` **不在**清单里(round-12 实测): 它的身份已由 `_cands_and_sources`
   448	# 的候选匹配 + 来源唯一性证明过; 在这里再做一次**原始相等**比较, 口径比契约更严 ——
   449	# 历史裸形态 receipt(`老键`)对完整 id(`quiz:老键`)是**合法**的兼容回落, 相等比较
   450	# 会把它判成「两次不同的评分」而误拒(实测: 旧笔记从此每次都被拒)。
   451	# ⛔ 「加严」不等于「更安全」—— 加在已被证明过的维度上, 只会制造误拒。
   452	_FACT_KEYS = ("scored_at", "attempt_count", "grade_norm", "abandoned", "exam_board")
   453	_ok_str = lambda v: isinstance(v, str) and bool(v) and v == v.strip()
   454	_ok_gn = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
   455	_ok_att = lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 1
   456	_ok_bool = lambda v: isinstance(v, bool)
   457	_ok_board = lambda v: isinstance(v, str)          # 空板名合法(旧行可能没记)
   458	
   459	
   460	def _facts_of_row(_o):
   461	    """从**账本行**构造完整六项事实（dup 之外的所有站点共用）。"""
   462	    _pl = _o.get("payload") or {}
   463	    return {
   464	        "scored_at": (str(_pl.get("scored_at") or _pl.get("review_time") or ""), _ok_str),
   465	        "attempt_count": (_pl.get("attempt_count"), _ok_att),
   466	        "grade_norm": (round(float(_pl.get("grade_norm", 0.0)), 2), _ok_gn),
   467	        "abandoned": (_o.get("event_type") == "answer_abandoned", _ok_bool),
   468	        "exam_board": (str(_pl.get("exam_board") or ""), _ok_board),
   469	    }
   470	
   471	
   472	def _facts_of_current(_sa, _att, _gn, _ab, _board):
   473	    """从**本次候选**构造完整六项事实（F1-only / dup 用）。"""
   474	    return {
   475	        "scored_at": (_sa, _ok_str),
   476	        "attempt_count": (_att, _ok_att),
   477	        "grade_norm": (_gn, _ok_gn),
   478	        "abandoned": (bool(_ab), _ok_bool),
   479	        "exam_board": (str(_board or ""), _ok_board),
   480	    }
