  1073	            ancestor,
  1074	            applicable,
  1075	            scan=scan,
  1076	            ledger_raw=ledger_raw,
  1077	            ledger_vault_id=ledger_vault_id,
  1078	            is_top_level=False,
  1079	            _depth=depth + 1,
  1080	        )
  1081	    )
  1082	    if isinstance(snap_hash, str) and ancestor.get("result_hash") != snap_hash:
  1083	        problems.append("等式2 失败: snapshot_hash != ancestor_proof.result_hash")
  1084	
  1085	    anc_rt = ancestor.get("review_time")
  1086	    anc_instant = _aware_instant(anc_rt)
  1087	    state_w = state.get("fsrs_last_review") if isinstance(state, dict) else None
  1088	    state_w_instant = _aware_instant(state_w)
  1089	    if state_w_instant is None or anc_instant is None or state_w_instant != anc_instant:
  1090	        problems.append("等式3 失败: state.fsrs_last_review != ancestor_proof.review_time (按绝对瞬间)")
  1091	
  1092	    anc_cursor = ancestor.get("cursor_line")
  1093	    if not isinstance(anc_cursor, int) or isinstance(anc_cursor, bool):
  1094	        return _ABORT, None, problems + ["ancestor_proof.cursor_line 必须是整数"]
  1095	    if anc_cursor >= cursor:
  1096	        problems.append(f"链未严格递减: ancestor.cursor_line={anc_cursor} >= 本层 {cursor}")
  1097	    for key in ("vault_id", "node_id"):
  1098	        if ancestor.get(key) != proof.get(key):
  1099	            problems.append(f"链上 {key} 必须相同")
  1100	    if anc_instant is None:
  1101	        problems.append("ancestor_proof.review_time 不可解析")
  1102	    return anc_cursor, anc_instant, problems
