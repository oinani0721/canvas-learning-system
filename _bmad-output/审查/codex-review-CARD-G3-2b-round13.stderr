  1042	def _check_snapshot(
  1043	    proof: dict,
  1044	    origin: dict,
  1045	    applicable: list,
  1046	    cursor: int,
  1047	    scan: Optional[dict],
  1048	    ledger_raw: Optional[bytes],
  1049	    ledger_vault_id: Optional[str],
  1050	    depth: int,
  1051	):
  1052	    """`origin.kind == "snapshot"` 的三等式、链约束与递归。→ (左端点, ancestor 时刻, 违规)。"""
  1053	    problems: list[str] = []
  1054	    ancestor = origin.get("ancestor_proof")
  1055	    snap_hash = origin.get("snapshot_hash")
  1056	    state = origin.get("state")
  1057	
  1058	    computed, state_problems = state_hash(state)
  1059	    problems.extend(f"origin.state: {p}" for p in state_problems)
  1060	    if isinstance(state, dict):
  1061	        problems.extend(f"origin.state: {p}" for p in _state_domain_problems(state))
  1062	    if not isinstance(snap_hash, str) or not _SHA256_HEX_RE.match(snap_hash):
  1063	        problems.append(f"origin.snapshot_hash 必须是 64 位十六进制, 得到 {snap_hash!r}")
  1064	    elif computed is not None and snap_hash != computed:
  1065	        problems.append("等式1 失败: snapshot_hash != sha256(canonical(state))")
  1066	    if not isinstance(ancestor, dict):
  1067	        return _ABORT, None, problems + ["origin.kind=snapshot 必须附 ancestor_proof object"]
  1068	
  1069	    # 递归: ancestor 是中间层, 不受尾部约束 (round-13 冻结)
  1070	    problems.extend(
  1071	        f"ancestor_proof: {p}"
  1072	        for p in _verify_proof_level(
  1073	            ancestor,
  1074	            applicable,
  1075	            scan=scan,
  1076	            ledger_raw=ledger_raw,
  1077	            ledger_vault_id=ledger_vault_id,
  1078	            is_top_level=False,
  1079	            _depth=depth + 1,
  1080	        )
  1081	    )
  1082	    if isinstance(snap_hash, str) and ancestor.get("result_hash") != snap_hash:
  1083	        problems.append("等式2 失败: snapshot_hash != ancestor_proof.result_hash")
  1084	
  1085	    anc_rt = ancestor.get("review_time")
  1086	    anc_instant = _aware_instant(anc_rt)
  1087	    state_w = state.get("fsrs_last_review") if isinstance(state, dict) else None
  1088	    state_w_instant = _aware_instant(state_w)
  1089	    if state_w_instant is None or anc_instant is None or state_w_instant != anc_instant:
  1090	        problems.append("等式3 失败: state.fsrs_last_review != ancestor_proof.review_time (按绝对瞬间)")
  1091	
  1092	    anc_cursor = ancestor.get("cursor_line")
  1093	    if not isinstance(anc_cursor, int) or isinstance(anc_cursor, bool):
  1094	        return _ABORT, None, problems + ["ancestor_proof.cursor_line 必须是整数"]
  1095	    if anc_cursor >= cursor:
  1096	        problems.append(f"链未严格递减: ancestor.cursor_line={anc_cursor} >= 本层 {cursor}")
  1097	    for key in ("vault_id", "node_id"):
  1098	        if ancestor.get(key) != proof.get(key):
  1099	            problems.append(f"链上 {key} 必须相同")
  1100	    if anc_instant is None:
  1101	        problems.append("ancestor_proof.review_time 不可解析")
  1102	    return anc_cursor, anc_instant, problems
