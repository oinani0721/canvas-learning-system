  2877	def test_round7_ordinal_gap_and_self_node_id(vault):
  2878	    """H① 本次事件自身的 node_id 门；H② 序数证明跨越缺字段行时按 gap 折算。"""
  2879	    LED = vault / "learning_events.jsonl"
  2880	
  2881	    # H① 从节点路径派生的 node_id 也要过「非空且无首尾空白」
  2882	    blank = vault / "节点" / " .md"
  2883	    blank.write_text(NODE_V0, encoding="utf-8")
  2884	    LED.unlink(missing_ok=True)
  2885	    rb = _run_writer(vault, _payload(node="节点/ .md", event_id="板A#q1", ts=TS1, review_time=TS1))
  2886	    assert rb.returncode != 0, "写出去的事件将永远路由不到任何节点"
  2887	    assert "派生出的 node_id 不可用" in rb.stderr, rb.stderr[:250]
  2888	    assert not LED.exists() or not _ledger_lines(vault), "不得先落账"
  2889	
  2890	    # H② E1(真值 1) → 历史 L2(无 count) → 历史 L3(3)
  2891	    def _chain(e1_count):
  2892	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2893	        LED.unlink(missing_ok=True)
  2894	        for eid, ts in (("E1#q1", TS1), ("L2#q1", "2026-08-01T11:00:00Z"), ("L3#q1", "2026-08-01T12:00:00Z")):
  2895	            assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts, review_time=ts)).returncode == 0
  2896	        rows = list(_ledger_lines(vault))
  2897	        rows[0]["payload"]["attempt_count"] = e1_count
  2898	        # ⚠️ round-12: dup 路径新增「receipt 与账本行逐项核对」。若只篡改账本行的
  2899	        # attempt 而不同步 receipt, **那道检查会先拦住**, 于是本门要测的序数计算
  2900	        # 根本走不到 —— 门看着还红, 实际已不测序数(M77 就绑在这道门上)。
  2901	        # 门要让场景**只坏一件事**: 同步 receipt, 使唯一的错误来源是序数本身。
  2902	        _nd = (vault / NODE_REL).read_text(encoding="utf-8")
  2903	        _nd2 = re.sub(
  2904	            r'(- event_id: "quiz:E1#q1"\n(?:    [^\n]*\n)*?    attempt_count: )\d+',
  2905	            lambda m: m.group(1) + str(e1_count),
  2906	            _nd,
  2907	            count=1,
  2908	        )
  2909	        # ⚠️ 真值那一趟(e1_count==1)receipt 本就是 1, 替换后文本相同 ——
  2910	        # 「预置必须真的改变」这条断言在那一趟**恒假**。只在值确实不同时才要求改变。
  2911	        assert _nd2 != _nd or e1_count == 1, "预置必须真的同步 receipt 的 attempt"
  2912	        (vault / NODE_REL).write_text(_nd2, encoding="utf-8")
  2913	        rows[1]["payload"] = {"exam_board": "旧板", "note": "无 count"}
  2914	        rows[2]["payload"] = {"exam_board": "旧板", "note": "有 count", "attempt_count": 3}
  2915	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  2916	        assert _run_validator(vault).returncode == 0, "该账本本身合规"
  2917	        return _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1))
  2918	
  2919	    # 修复前是**反的**：错值 2 被接受、真值 1 被报冲突。
  2920	    assert _chain(1).returncode == 0, "真值必须放行"
  2921	    r_wrong = _chain(2)
  2922	    assert r_wrong.returncode != 0, "错值必须拒 —— 固定减 1 会把它当成对的"
  2923	    assert "envelope 冲突" in r_wrong.stderr, r_wrong.stderr[:250]
