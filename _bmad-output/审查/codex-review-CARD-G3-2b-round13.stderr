   356	class _DupKey(Exception):
   357	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   358	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   359	
   360	
   361	def _no_dup_keys(pairs):
   362	    _seen = set()
   363	    for _k, _ in pairs:
   364	        if _k in _seen:
   365	            raise _DupKey(repr(_k))
   366	        _seen.add(_k)
   367	    return dict(pairs)
