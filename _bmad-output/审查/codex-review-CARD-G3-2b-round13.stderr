   421	def test_envelope_conflict_rejected_and_same_envelope_noop(vault):
   422	    # ①同 id 同 envelope: 完整成功后再跑, 绝不二次 apply (W 不动即证明)
   423	    r = _run_writer(vault, _payload())
   424	    assert r.returncode == 0, r.stdout + r.stderr
   425	    sha = _sha(vault / NODE_REL)
   426	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
   427	    assert r2.returncode == 0
   428	    assert _sha(vault / NODE_REL) == sha, "同 id 同 envelope 重放不得二次 apply"
   429	    # ②同 id 不同事实 (abandoned 翻转 event_type) → fail-closed 拒写
   430	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 回到崩溃窗口①前置态
   431	    _sha_pre_conflict = _sha(vault / NODE_REL)
   432	    r3 = _run_writer(vault, _payload(abandoned=True))
   433	    assert r3.returncode != 0, "同 id 不同 event_type 必须 envelope 冲突拒绝"
   434	    assert "envelope 冲突" in r3.stderr, r3.stderr
   435	    assert len(_ledger_lines(vault)) == 1, "冲突拒绝不得追加"
   436	    assert _sha(vault / NODE_REL) == _sha_pre_conflict, "冲突拒绝必须整节点零写（不只是 fsrs 字段）"
   437	    # ③Codex round-1 BLOCKER: 五字段局部比对抓不到的篡改 — durable 行被
   438	    # 改动 payload 事实键 (exam_board) / 顶层 event_version 后, 恢复必须拒。
   439	    base_event = _ledger_lines(vault)[0]
   440	    for tweak, desc in (
   441	        ({"payload.exam_board": "检验白板/被篡改.md"}, "payload 事实键 exam_board"),
   442	        ({"event_version": 2}, "顶层 event_version"),
   443	    ):
   444	        tampered = json.loads(json.dumps(base_event))
   445	        key, val = next(iter(tweak.items()))
   446	        if "." in key:
   447	            tampered["payload"][key.split(".")[1]] = val
   448	        else:
   449	            tampered[key] = val
   450	        ledger = vault / "learning_events.jsonl"
   451	        ledger.write_text(json.dumps(tampered, ensure_ascii=False) + "\n", encoding="utf-8")
   452	        rt = _run_writer(vault, _payload())
   453	        assert rt.returncode != 0, f"篡改 {desc} 后恢复必须拒绝"
   454	        # event_version 篡改现被更早的**版本门**接管（未知版本不得按 v1 应用，
   455	        # 也不能跳过——跳过就漏算了）；payload 事实键仍走 envelope。
   456	        assert ("envelope 冲突" in rt.stderr) or ("非 v1" in rt.stderr), rt.stderr
   457	    # 恢复正常 durable 行后 (原样回写), 同一续跑必须成功 (崩溃窗口①恢复)
   458	    (vault / "learning_events.jsonl").write_text(json.dumps(base_event, ensure_ascii=False) + "\n", encoding="utf-8")
   459	    r4 = _run_writer(vault, _payload())
   460	    assert r4.returncode == 0, r4.stdout + r4.stderr
   461	    assert "恢复" in r4.stdout and "崩溃窗口" in r4.stdout
