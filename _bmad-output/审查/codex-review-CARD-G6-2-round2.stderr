   200	  // 要等生产器重跑才会变 → 回落上限 60s, 不空转。
   201	  let best = null;
   202	  const vaults = data && Array.isArray(data.vaults) ? data.vaults : [];
   203	  for (const v of vaults) {
   204	    const nu = v && v.projection && v.projection.next_upcoming;
   205	    const ms = nu ? parseDueMs(nu.next_due) : null;
   206	    if (ms !== null && ms > nowMs && (best === null || ms < best)) best = ms;
   207	  }
   208	  const raw = best === null ? POLL_MAX_MS : best - nowMs;
   209	  return Math.min(POLL_MAX_MS, Math.max(POLL_MIN_MS, raw));
   210	}
   211	function visibilityAction(hidden) {
   212	  // 页面隐藏 → 只取消排程; 回到前台 → 取消旧排程并立即拉一轮
   213	  return hidden ? {cancelTimer: true, pollNow: false} : {cancelTimer: true, pollNow: true};
   214	}
   215	function boardLink(vaultId, board) {
   216	  // encodeURIComponent 与服务端 quote(safe="") 同语义: "/" 也编码
   217	  return "obsidian://open?vault=" + encodeURIComponent(vaultId) + "&file=" + encodeURIComponent("原白板/" + board + ".md");
   218	}
   219	function nodeLink(vaultId, node) {
   220	  return "obsidian://open?vault=" + encodeURIComponent(vaultId) + "&file=" + encodeURIComponent("节点/" + node + ".md");
   221	}
   222	function nodeDetailHtml(vaultId, nodes, nowMs) {
   223	  if (!Array.isArray(nodes) || !nodes.length) return "";
   224	  const items = nodes.map(n => {
   225	    const due = humanizeDue(n.fsrs_due, nowMs);
   226	    const tag = n.bucket == null ? "" :
   227	      '<span class="nodetag">' + esc(BUCKET_CN[n.bucket] || n.bucket) + "</span>";
   228	    const why = !n.why_due ? "" : '<div class="whydue">' + esc(n.why_due) + "</div>";
   229	    return '<li class="nodeli"><a href="' + esc(nodeLink(vaultId, n.node)) + '">' + esc(n.node) + "</a>" + tag +
   230	      '<span style="color:' + due.color + ';font-size:12px;margin-left:6px">' + esc(due.text) + "</span>" + why + "</li>";
   231	  });
   232	  return '<details style="margin:2px 0 4px"><summary style="cursor:pointer;color:#6b7280;font-size:12px">节点明细（' +
   233	    nodes.length + '）</summary><ul style="margin:6px 0 0;padding:0 0 0 6px">' + items.join("") + "</ul></details>";
   234	}
   235	function boardTableHtml(vaultId, boards, nowMs) {
   236	  if (!Array.isArray(boards) || !boards.length) return "";
   237	  const head = ["白板名", "到期", "新卡", "待剖析", "最早到期"].map(c => "<th>" + c + "</th>").join("");
   238	  const rows = boards.map(r => {
   239	    const due = humanizeDue(r.earliest, nowMs);
   240	    const ph = r.placeholder == null ? "—" : String(r.placeholder);
   241	    // W6 加性字段: 缺省整块不出现 (沿 bucket_counts 缺省纪律)
   242	    const est = Number.isFinite(r.estimated_minutes) ?
   243	      '<span class="estmin">约 ' + r.estimated_minutes + " 分钟</span>" : "";
   244	    let out = '<tr><td><a href="' + esc(boardLink(vaultId, r.board)) + '">' + esc(r.board) + "</a>" + est + "</td>" +
   245	      '<td class="num">' + (r.due ? "<b>" + r.due + "</b>" : '<span style="color:#9ca3af">0</span>') + "</td>" +
   246	      '<td class="num">' + r.due_new + "</td>" +
   247	      '<td class="num">' + esc(ph) + "</td>" +
   248	      '<td style="white-space:nowrap;color:' + due.color + '">' + esc(due.text) + "</td></tr>";
   249	    if (typeof r.why_this_board === "string" && r.why_this_board)
   250	      out += '<tr><td colspan="5" class="why">💡 ' + esc(r.why_this_board) + "</td></tr>";
   251	    const detail = nodeDetailHtml(vaultId, r.nodes, nowMs);
   252	    if (detail) out += '<tr><td colspan="5" style="padding-top:0">' + detail + "</td></tr>";
   253	    return out;
   254	  }).join("");
   255	  return '<div class="tblwrap"><table><thead><tr>' + head + "</tr></thead><tbody>" + rows + "</tbody></table></div>";
   256	}
   257	function restDayHtml(proj) {
   258	  // 休息日空状态 (status ok 且 due_count===0) — 文案对齐
   259	  // daily_review_pick.py:599「今日无到期节点，休息一天」/ :564「按计划推进」
   260	  const nu = proj.next_upcoming;
   261	  const tail = nu ? '<div style="color:#6b7280;font-size:13px;margin-top:4px">按计划推进 · 最近到期 ' +
   262	    esc(nu.board) + " · " + esc(String(nu.next_due).slice(0, 10)) + "</div>" : "";
   263	  return '<div class="restday">✅ 今日无到期节点，休息一天。' + tail + "</div>";
   264	}
   265	function renderVaultCard(entry, nowMs, noteHtml, isInflight) {
   266	  // 未知 status 防御: 原字面灰徽标 (未来第五态不白屏)
   267	  const meta = STATUS_META[entry.status] || [entry.status, "#6b7280"];
   268	  const vid = entry.vault_id;
   269	  let body = "";
   270	  const proj = entry.projection;
   271	  if (proj) {
   272	    if (entry.status === "ok" && proj.due_count === 0) {
   273	      body = restDayHtml(proj);
   274	    } else {
   275	      const bc = proj.bucket_counts;
   276	      const layers = bc == null ? "" :
   277	        '<div class="layers">分层 · ' + BUCKET_ORDER.map(b => esc(BUCKET_CN[b]) + " " + bc[b]).join(" · ") + "</div>";
   278	      body = '<div class="big">到期 <b>' + proj.due_count + "</b><small> · 新卡 " + proj.due_new_count +
   279	        " · 待剖析 " + proj.placeholder_backlog + "</small></div>" + layers +
   280	        boardTableHtml(vid, proj.boards, nowMs);
   281	    }
   282	    body += '<div class="gen">生成于 ' + esc(String(proj.generated_at)) + "</div>" +
   283	      '<a href="obsidian://open?vault=' + esc(encodeURIComponent(vid)) + '">在 Obsidian 中打开 ↗</a>';
   284	    // W6 加性顶层 rank_manifest: 在场才出现, 不解析内部形状
   285	    if (proj.rank_manifest != null) body += '<div class="manifest">📋 本次板序含排序依据（rank_manifest）</div>';
   286	  } else if (entry.status === "no_projection") {
   287	    body = '<div class="degraded">该库尚无今日复习投影 — 推送管道尚未为它跑过<br>' +
   288	      "深链已降级：需在 Obsidian 打开过该库后才提供跳转</div>";
   289	  } else {
   290	    body = '<div class="corrupt-err">投影文件无法解析<br><code>' + esc(String(entry.error || "")) + "</code></div>";
   291	  }
   292	  // noteHtml 是 renderRefreshResult 的成品 HTML (内部已 esc), 由调用方从
   293	  // 持久状态传入 — 重绘后反馈得以恢复 (Codex round-1 HIGH-1)
   294	  return '<div class="card"><div class="card-head"><b>' + esc(vid) + "</b>" +
   295	    '<span class="badge" style="background:' + meta[1] + '">' + esc(meta[0]) + "</span></div>" + body +
   296	    '<div class="actions"><button class="btn"' + (isInflight ? " disabled" : "") +
   297	    ' data-refresh-vault="' + esc(vid) + '">🔄 刷新投影</button>' +
   298	    '<span class="rnote" data-note-for="' + esc(vid) + '">' + (noteHtml || "") + "</span></div></div>";
   299	}
   300	function renderPage(data, nowMs, notes, inflight) {
   301	  const vaults = data && Array.isArray(data.vaults) ? data.vaults : [];
   302	  if (!vaults.length) return '<div class="empty">VAULTS_ROOT 下未发现任何 vault (需含 .obsidian/ 目录)</div>';
   303	  return vaults.map(e => renderVaultCard(e, nowMs, (notes && notes[e.vault_id]) || "",
   304	    !!(inflight && inflight[e.vault_id]))).join("");
   305	}
   306	function renderUnavailableBanner(detail, lastOkText) {
   307	  const keep = lastOkText ? "页面保留 " + esc(lastOkText) + " 的最后一次成功数据。" : "尚未成功获取过数据。";
   308	  return "<b>⚠ 后端离线/不可用</b> — " + esc(detail) + "。" + keep + "自动重试中…";
   309	}
   310	function renderRefreshResult(status, payload) {
   311	  // POST /overview/refresh 响应可见化 — rebuilt/debounced/in_progress/失败
   312	  // 四种结局都尽量带上 rebuild_count (进程内累计); 去抖与失败绝不长得像成功
   313	  // (零 JS 页 round-3 修过的「与成功同形的 303」不许在交互壳还魂)
   314	  const count = payload && payload.rebuild_count !== undefined && payload.rebuild_count !== null
   315	    ? "（本进程累计 " + esc(payload.rebuild_count) + " 次）" : "";
   316	  if (status === 200 && payload && payload.reason === "rebuilt")
   317	    return '<span class="rnote ok">✅ 已重建' + count + " · 数字已更新</span>";
   318	  if (status === 200 && payload && payload.reason === "debounced") {
   319	    const wait = Number(payload.retry_after_seconds);
   320	    return '<span class="rnote warn">⏱ ' + esc(payload.debounce_ttl_seconds) + " 秒内已重建过" + count +
   321	      "，本次未重算" +
   322	      (Number.isFinite(wait) && wait > 0 ? " · 约 " + Math.ceil(wait) + " 秒后可再试" : "") + "</span>";
   323	  }
   324	  if (status === 200 && payload && payload.reason === "in_progress")
   325	    return '<span class="rnote warn">⏳ 该库已有一次重建在跑' + count + "，本次未重复启动</span>";
   326	  let detail = "";
   327	  if (payload && payload.detail)
   328	    detail = typeof payload.detail === "string" ? payload.detail : (payload.detail.message || JSON.stringify(payload.detail));
   329	  if (status === 0) return '<span class="rnote err">❌ 刷新失败（网络错误）：' + esc(detail || "连接失败") + "</span>";
   330	  return '<span class="rnote err">❌ 刷新失败（HTTP ' + esc(status) + "）" + (detail ? "：" + esc(detail) : "") + "</span>";
   331	}
   332	
   333	// ═══ 副作用壳: 只消费上面纯函数的返回值 ═══
   334	const state = {timer: null, lastOkAt: null, lastData: null, notes: {}, inflight: {}};
   335	const el = id => document.getElementById(id);
   336	function fmtClock(ms) {
   337	  return new Intl.DateTimeFormat("zh-CN", {timeZone: "Asia/Shanghai", hour12: false,
   338	    hour: "2-digit", minute: "2-digit", second: "2-digit"}).format(new Date(ms));
   339	}
   340	function setConn(cls, text) {
   341	  const c = el("conn");
   342	  c.className = "conn " + cls;
   343	  c.textContent = text;
   344	}
   345	function vaultButtons(vid) {
   346	  // getAttribute 比对而非把 vid 插进 CSS 选择器 — vid 是外部字符串,
   347	  // 进选择器会被当选择器语法解析 (引号/反斜杠注入面)
   348	  return Array.from(el("cards").querySelectorAll("[data-refresh-vault]"))
   349	    .filter(b => b.getAttribute("data-refresh-vault") === vid);
   350	}
   351	function applyNote(vid) {
   352	  const n = state.notes[vid];
   353	  if (!n) return false;
   354	  let patched = false;
   355	  for (const span of el("cards").querySelectorAll("[data-note-for]")) {
   356	    if (span.getAttribute("data-note-for") === vid) { span.innerHTML = n.html; patched = true; }
   357	  }
   358	  return patched;
   359	}
   360	function freshNotes(nowMs) {
   361	  const out = {};
   362	  for (const vid of Object.keys(state.notes)) {
   363	    if (nowMs - state.notes[vid].atMs < NOTE_TTL_MS) out[vid] = state.notes[vid].html;
   364	  }
   365	  return out;
   366	}
   367	function renderCards(nowMs) {
   368	  el("cards").innerHTML = renderPage(state.lastData, nowMs, freshNotes(nowMs), state.inflight);
   369	}
   370	function schedule(ms) {
   371	  clearTimeout(state.timer);
   372	  state.timer = null;
   373	  if (document.hidden) { el("nextpoll").textContent = "已暂停（页面隐藏）"; return; }
   374	  state.timer = setTimeout(poll, ms);
   375	  el("nextpoll").textContent = "下次自动刷新 ~" + Math.round(ms / 1000) + " 秒后";
   376	}
   377	async function poll() {
   378	  let delay = RETRY_DELAY_MS;
   379	  try {
   380	    const resp = await fetch(URLS.overview, {cache: "no-store"});
   381	    if (!resp.ok) throw new Error("HTTP " + resp.status);
   382	    const data = await resp.json();
   383	    const nowMs = Date.now();
   384	    state.lastData = data;
   385	    renderCards(nowMs);
   386	    el("banner").hidden = true;
   387	    state.lastOkAt = nowMs;
   388	    el("updated").textContent = "上次更新 " + fmtClock(nowMs);
   389	    setConn("ok", "已连接");
   390	    delay = computePollDelayMs(data, nowMs);
   391	  } catch (e) {
   392	    el("banner").innerHTML = renderUnavailableBanner(String((e && e.message) || e),
   393	      state.lastOkAt ? fmtClock(state.lastOkAt) : null);
   394	    el("banner").hidden = false;
   395	    setConn("down", "后端不可用");
   396	  }
   397	  schedule(delay);
   398	}
   399	document.addEventListener("visibilitychange", () => {
   400	  const act = visibilityAction(document.hidden);
   401	  if (act.cancelTimer) { clearTimeout(state.timer); state.timer = null; }
   402	  if (act.pollNow) poll();
   403	  else if (document.hidden) el("nextpoll").textContent = "已暂停（页面隐藏）";
   404	});
   405	async function onRefreshClick(ev) {
   406	  const btn = ev.target.closest("[data-refresh-vault]");
   407	  if (!btn) return;
   408	  const vid = btn.getAttribute("data-refresh-vault");
   409	  if (state.inflight[vid]) return;  // 同库重建在飞, 不发第二个 POST
   410	  state.inflight[vid] = true;
   411	  state.notes[vid] = {html: '<span class="rnote">⏳ 重建中…</span>', atMs: Date.now()};
   412	  for (const b of vaultButtons(vid)) b.disabled = true;
   413	  applyNote(vid);
   414	  try {
   415	    // 手动按钮是唯一的 POST 路径 (默认裁决②: 自动轮询绝不 POST)
   416	    const resp = await fetch(URLS.refresh, {method: "POST", body: new URLSearchParams({vault_id: vid})});
   417	    let payload = null;
   418	    try { payload = await resp.json(); } catch (_e) { payload = null; }
   419	    state.notes[vid] = {html: renderRefreshResult(resp.status, payload), atMs: Date.now()};
   420	    // 先就地补; 就地补不到 (反馈期间被轮询重绘换过 DOM) 且手上有数据 →
   421	    // 用持久状态重绘恢复 — 反馈从此不依赖「那个 span 还在不在」
   422	    if (!applyNote(vid) && state.lastData) renderCards(Date.now());
   423	    if (resp.ok && payload && payload.rebuilt) poll();  // 真重建 → 立即重拉 (反馈在 state.notes, 重绘不丢)
   424	  } catch (e) {
   425	    state.notes[vid] = {html: renderRefreshResult(0, {detail: String((e && e.message) || e)}), atMs: Date.now()};
   426	    if (!applyNote(vid) && state.lastData) renderCards(Date.now());
   427	  } finally {
   428	    delete state.inflight[vid];
   429	    for (const b of vaultButtons(vid)) b.disabled = false;
   430	  }
   431	}
   432	el("cards").addEventListener("click", onRefreshClick);
   433	poll();
   434	</script>
   435	</body>
   436	</html>
   437	"""
   438	
   439	
   440	@review_app_router.get(
   441	    "/overview/app",
   442	    response_class=HTMLResponse,
   443	    summary="跨 vault 复习总览 · 交互版 (CARD-G6-2; 单文件内联 HTML, 零外部 URL)",
   444	)
   445	async def review_overview_app(request: Request) -> HTMLResponse:
   446	    """交互复习壳: 自动轮询 GET /overview, 手动按钮 POST /overview/refresh。
   447	
   448	    与零 JS 只读页 (/overview/page) 共存。API 路径按本次请求的路由表注入
   449	    (url_for), 不硬编码。
   450	    """
   451	    urls = {
   452	        "overview": request.url_for("review_overview").path,
   453	        "refresh": request.url_for("review_overview_refresh").path,
   454	    }
   455	    page = (
   456	        _PAGE_TEMPLATE.replace("__URLS_JSON__", _js_json(urls))
   457	        .replace("__STATUS_META_JSON__", _js_json({k: list(v) for k, v in _STATUS_META.items()}))
   458	        .replace("__BUCKET_CN_JSON__", _js_json(_BUCKET_CN))
   459	        .replace("__BUCKET_ORDER_JSON__", _js_json(list(_BUCKET_ORDER)))
   460	    )
   461	    return HTMLResponse(content=page)

