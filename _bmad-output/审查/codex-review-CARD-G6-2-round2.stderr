   227	
   228	def test_review_app_module_imports_are_closed():
   229	    """AST 结构门 (Codex round-1 HIGH-4 后新增): 本模块只允许「模板注入」
   230	    这一种依赖形态 —— import 白名单 + 禁内建读盘/执行调用。
   231	
   232	    字符串黑名单 (`"subprocess" not in src`) 可被 json.load(open(...)) /
   233	    Path.open() 等措辞绕过; AST 门直接枚举 import 与调用形态, 新增任何
   234	    依赖 = 红, 不存在换拼法绕过的问题。
   235	    """
   236	    ALLOWED_IMPORTS = {
   237	        "__future__.annotations",
   238	        "json",
   239	        "fastapi.APIRouter",
   240	        "fastapi.Request",
   241	        "fastapi.responses.HTMLResponse",
   242	        "app.api.v1.endpoints.review_overview._BUCKET_CN",
   243	        "app.api.v1.endpoints.review_overview._BUCKET_ORDER",
   244	        "app.api.v1.endpoints.review_overview._STATUS_META",
   245	    }
   246	    src = (_ENDPOINTS_DIR / "review_app.py").read_text(encoding="utf-8")
   247	    tree = ast.parse(src)
   248	    collected: set[str] = set()
   249	    for node in ast.walk(tree):
   250	        if isinstance(node, ast.Import):
   251	            collected.update(a.name for a in node.names)
   252	        elif isinstance(node, ast.ImportFrom):
   253	            mod = node.module or ""
   254	            collected.update(f"{mod}.{a.name}" if mod else a.name for a in node.names)
   255	    banned = collected - ALLOWED_IMPORTS
   256	    assert not banned, f"出现白名单外的 import: {sorted(banned)} — 第二套管道的载体"
   257	    for node in ast.walk(tree):
   258	        if isinstance(node, ast.Call):
