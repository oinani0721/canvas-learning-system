   949	def test_js_humanize_due_matches_server_side_wording(node_harness):
   950	    """同源锁: JS 的到期人话与服务端 _humanize_due 逐条相同。
   951	
   952	    期望值由**服务端函数当场算出**再喂进 node —— 哪天两页文案分家
   953	    (或时区口径漂移), 本门先红。
   954	    """
   955	    from datetime import datetime, timedelta, timezone
   956	
   957	    now_utc = datetime.fromtimestamp(_NOW_MS / 1000, tz=timezone.utc)
   958	    cases = []
   959	    for label, ts in (
   960	        ("空串=现在", ""),
   961	        ("逾期2天", (now_utc - timedelta(days=2)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   962	        ("今天", now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")),
   963	        ("明天", (now_utc + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   964	        ("5天后", (now_utc + timedelta(days=5)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   965	        ("同年月日", (now_utc + timedelta(days=30)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   966	        ("跨年", (now_utc + timedelta(days=400)).strftime("%Y-%m-%dT%H:%M:%SZ")),
   967	        ("畸形", "20260901"),
   968	    ):
   969	        expected, _color = _humanize_due(ts, now_utc)
   970	        cases.append({"label": label, "ts": ts, "expected": expected})
   971	    # None 走 "—" 分支 (板级无数据)
   972	    cases.append({"label": "无数据", "ts": None, "expected": _humanize_due(None, now_utc)[0]})
   973	
   974	    proc = _run_node(
   975	        node_harness,
   976	        "import test from 'node:test';\nimport assert from 'node:assert/strict';\n"
   977	        "import {boot} from './boot.mjs';\n"
   978	        f"const NOW = {_NOW_MS};\nconst CASES = {json.dumps(cases, ensure_ascii=False)};\n"
   979	        r"""
   980	const humanizeDue = boot().api.humanizeDue;
   981	for (const c of CASES) {
   982	  test("与服务端一致: " + c.label, () => {
   983	    assert.equal(humanizeDue(c.ts, NOW).text, c.expected);
   984	  });
   985	}
   986	""",
   987	    )
   988	    _assert_node_green(proc)
   989	
   990	
   991	#: 固定时钟毫秒 (与 _FIX_JS 的 NOW 同源; 放在文件尾供上面的对拍测试引用)
   992	_NOW_MS = 1_788_000_000_000

