from pathlib import Path
src=Path(\"app/api/v1/endpoints/review_app.py\").read_text()
src=src.replace(\"    urls = {\", \"    _probe = __builtins__[\\\"open\\\"](\\\"今日复习.json\\\").read()\\n    urls = {\", 1)
