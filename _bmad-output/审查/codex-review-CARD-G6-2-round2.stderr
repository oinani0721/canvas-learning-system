   877	def test_js_shows_authoritative_due_count_never_recomputes(node_harness):
   878	    """完成条件 (硬边界): JS 内不实现任何 due 算法 —— 只消费投影。
   879	
   880	    行为门 (非否定断言): 喂一份 due_count=7 而 boards 明细只有 2+1 的投影
   881	    (服务端 _summarize 允许这种并陈: stats 是权威计数, 明细可因脏行降级),
   882	    页面必须显示 7。若 JS 私下按明细重算, 会显示 3, 本门变红。
   883	    """
   884	    proc = _run_node(
   885	        node_harness,
   886	        _BOOT_PRELUDE
   887	        + _FIX_JS
   888	        + r"""
   889	test("显示服务端权威 due_count, 不按明细重加", () => {
   890	  const v = JSON.parse(JSON.stringify(OK_VAULT));
   891	  v.projection.due_count = 7;   // 权威计数
   892	  // 明细仍是 2+1=3 —— 若 JS 重算就会显示 3
   893	  const h = boot().api.renderVaultCard(v, NOW);
   894	  assert.match(h, /到期 <b>7<\/b>/);
   895	  assert.ok(!/到期 <b>3<\/b>/.test(h), "页面重算了到期数 — 违反『只消费投影』");
   896	});
   897	test("板行到期数直接取 boards[].due, 不按 nodes 长度重数", () => {
   898	  const v = JSON.parse(JSON.stringify(OK_VAULT));
   899	  v.projection.boards[0].due = 9;   // 明细只有 1 个 node
   900	  assert.match(boot().api.renderVaultCard(v, NOW), /<b>9<\/b>/);
   901	});
   902	test("休息日判定读 due_count, 不读 boards 是否为空", () => {
   903	  const v = JSON.parse(JSON.stringify(OK_VAULT));
   904	  v.projection.boards = [];        // 明细空, 但权威计数非零
   905	  const h = boot().api.renderVaultCard(v, NOW);
   906	  assert.ok(!h.includes("休息一天"), "权威计数非零时不许说休息");
   907	  assert.match(h, /到期 <b>3<\/b>/);
   908	});
   909	""",
   910	    )
   911	    _assert_node_green(proc)
