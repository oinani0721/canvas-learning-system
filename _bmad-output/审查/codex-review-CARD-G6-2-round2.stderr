 succeeded in 0ms:
   270	#: 沙箱 boot 器: node_harness fixture 生成 boot.mjs, 测试文件导入它执行
   271	#: page-script.js (响应里的真实 <script> 原文) 并导出沙箱作用域的函数。
   272	_BOOT_MJS = r"""
   273	import fs from "node:fs";
   274	
   275	const SRC = fs.readFileSync(new URL("./page-script.js", import.meta.url), "utf8");
   276	
   277	export function mkNode(id) {
   278	  const node = {
   279	    id, innerHTML: "", textContent: "", hidden: false, className: "", disabled: false,
   280	    _attrs: {}, _desc: null, parentElement: null,
   281	    setAttribute(k, v) { node._attrs[k] = String(v); },
   282	    getAttribute(k) { return node._attrs[k] ?? null; },
   283	    addEventListener() {},
   284	    querySelector() { return null; },
   285	    querySelectorAll() { return []; },
   286	  };
   287	  return node;
   288	}
   289	
   290	export function matches(node, sel) {
   291	  if (sel === "[data-refresh-vault]") return node._attrs["data-refresh-vault"] !== undefined;
   292	  if (sel === "[data-note-for]") return node._attrs["data-note-for"] !== undefined;
   293	  return false;
   294	}
   295	
   296	export const flush = () => new Promise(r => setTimeout(r, 0));
   297	
   298	export function boot({getJson, postJson, hidden = false} = {}) {
   299	  const els = {};
   300	  const handlers = {};
   301	  const timers = [];
   302	  const calls = {get: 0, post: 0};
   303	  function makeEl(id) {
   304	    const node = mkNode(id);
   305	    node.addEventListener = (t, fn) => { handlers[id + "::" + t] = fn; };
   306	    node.querySelectorAll = sel => (node._desc || []).filter(n => matches(n, sel));
   307	    return node;
   308	  }
   309	  const documentStub = {
   310	    hidden,
   311	    getElementById: id => (els[id] ??= makeEl(id)),
   312	    addEventListener: (t, fn) => { handlers["document::" + t] = fn; },
   313	  };
   314	  const fetchStub = async (url, opts = {}) => {
   315	    if (opts && opts.method === "POST") {
   316	      calls.post += 1;
   317	      const h = typeof postJson === "function" ? postJson(url, opts) : postJson;
   318	      return h === undefined || h === null ? {ok: false, status: 0, json: async () => null} : h;
   319	    }
   320	    calls.get += 1;
   321	    const h = typeof getJson === "function" ? getJson(url) : getJson;
   322	    return h === undefined || h === null ? {ok: false, status: 0, json: async () => null} : h;
   323	  };
   324	  const sandbox = new Function(
   325	    "document", "fetch", "setTimeout", "clearTimeout",
   326	    SRC +
   327	    "\n;return {esc, shDay, parseDueMs, humanizeDue, computePollDelayMs, visibilityAction," +
   328	    " boardLink, nodeLink, nodeDetailHtml, boardTableHtml, restDayHtml, renderVaultCard," +
   329	    " renderPage, renderUnavailableBanner, renderRefreshResult, freshNotes};"
   330	  );
   331	  const api = sandbox(
   332	    documentStub, fetchStub,
   333	    (fn, ms) => { timers.push({fn, ms}); return timers.length; },
   334	    () => {},
   335	  );
   336	  return {api, els, handlers, timers, calls, document: documentStub};
   337	}
   338	"""
   339	
   340	
   341	def _group(pattern: str, text: str, flags: int = 0) -> str:
   342	    """re.search().group(1) 的非 None 断言版 — pyright 严格模式友好。"""
   343	    m = re.search(pattern, text, flags)
   344	    assert m is not None, f"模式未命中: {pattern!r}"
   345	    return m.group(1)
   346	
   347	
   348	def _extract_script(html: str) -> str:
   349	    """从实际响应体取出**整个** <script> 原文 (不是任何按标记的割取)。"""
   350	    assert html.count("<script>") == 1 and "<script " not in html, "script 标签形态变了, 提取契约失效"
   351	    m = re.search(r"<script>\n(.*?)</script>", html, re.S)
   352	    assert m is not None, "script 主体未命中"
   353	    src = m.group(1)
   354	    assert "__URLS_JSON__" not in src, "占位符没被替换 — 页面发出去的是模板本身"
   355	    return src
   356	
   357	
   358	@pytest.fixture
   359	def node_harness(tmp_path, page_html):
   360	    """真实脚本 + 沙箱 boot 器写入 tmp; node 不可用时 fail-closed (不 skip)。"""
   361	    if _NODE is None:
   362	        pytest.fail(
   363	            "node 不可用 — 本文件 10+ 道 JS 门禁止静默 skip 假绿 (Codex round-1 "
   364	            "HIGH-2 fail-closed); 本环境必须装 node, 或实现卡文默认裁决④的 "
   365	            "Python 解析 fallback 后再改本门"
   366	        )
   367	    (tmp_path / "page-script.js").write_text(_extract_script(page_html), encoding="utf-8")
   368	    (tmp_path / "boot.mjs").write_text(_BOOT_MJS, encoding="utf-8")
   369	    return tmp_path
   370	
   371	
   372	def _run_node(tmp_path: Path, test_src: str) -> subprocess.CompletedProcess:
   373	    (tmp_path / "case.test.mjs").write_text(test_src, encoding="utf-8")
   374	    return subprocess.run(
   375	        [_NODE, "--test", "case.test.mjs"],
   376	        cwd=tmp_path,
   377	        capture_output=True,
   378	        text=True,
   379	        timeout=120,
   380	    )
   381	
   382	
   383	def _assert_node_green(proc: subprocess.CompletedProcess):
   384	    assert proc.returncode == 0, f"node --test 失败:\n{proc.stdout}\n{proc.stderr}"
   385	    # skipped 必须为 0 — 门不许被 conditional skip 悄悄掏空 (HIGH-2 配套);
   386	    # 零计数 (`# skipped 0` / `skipped 0`) 放行, 非零即红
   387	    assert not re.search(r"\bskipped?\s*[:=]?\s*[1-9]", proc.stdout), f"出现非零 skip:\n{proc.stdout}"
