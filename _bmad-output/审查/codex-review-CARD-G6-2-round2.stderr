   616	def _list_vault_dirs(vaults_root: Path) -> list[Path]:
   617	    """与 GET /vault/list 同一条候选规则: 非隐藏目录且含 .obsidian/。"""
   618	    dirs: list[Path] = []
   619	    for entry in sorted(vaults_root.iterdir()):
   620	        if not entry.is_dir() or entry.name.startswith("."):
   621	            continue
   622	        if not (entry / ".obsidian").is_dir():
   623	            continue
   624	        dirs.append(entry)
   625	    return dirs
