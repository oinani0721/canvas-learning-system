   315	
   316	def run_gate(node_id: str) -> subprocess.CompletedProcess:
   317	    return subprocess.run(
   318	        PYTEST + [f"{TESTFILE}::{node_id}"],
   319	        cwd=BACKEND,
   320	        capture_output=True,
   321	        text=True,
   322	        timeout=600,
   323	    )
   324	
   325	
   326	def main() -> int:
   327	    if not TARGET.exists():
   328	        print(f"FATAL: 找不到被测文件 {TARGET}", file=sys.stderr)
   329	        return 2
   330	    original = TARGET.read_bytes()
   331	    original_text = original.decode("utf-8")
   332	
   333	    # 前置: 基线必须全绿 —— 基线本来就红的话, 后面每条"变红"都不算数
   334	    base = subprocess.run(PYTEST + [TESTFILE], cwd=BACKEND, capture_output=True, text=True, timeout=900)
   335	    if base.returncode != 0:
   336	        print("FATAL: 基线不绿, 负验证无意义\n" + base.stdout[-3000:], file=sys.stderr)
   337	        return 2
   338	    print(f"基线全绿 ✓  ({MUTATIONS.__len__()} 条变异待跑, 串行)")
   339	
   340	    failures: list[str] = []
   341	    restore_broken = False
   342	    for idx, (mid, desc, old, new, gate) in enumerate(MUTATIONS, 1):
   343	        hits = original_text.count(old)
   344	        if hits != 1:
   345	            failures.append(f"{mid} 锚点在原文命中 {hits} 次 (须恰好 1) — 变异会静默空转")
   346	            print(f"[{idx:>2}/{len(MUTATIONS)}] {mid} ✗ 锚点命中 {hits} 次: {desc}")
   347	            continue
   348	        mutated = original_text.replace(old, new, 1)
   349	        assert mutated != original_text, f"{mid} 替换后文件未变"
   350	        TARGET.write_text(mutated, encoding="utf-8")
   351	        try:
   352	            proc = run_gate(gate)
   353	            out = proc.stdout + proc.stderr
   354	            red = (
   355	                proc.returncode != 0
   356	                and re.search(r"\b1 failed\b", out) is not None
   357	                and f"FAILED {TESTFILE}::{gate}" in out
   358	            )
   359	        finally:
   360	            TARGET.write_bytes(original)
   361	            restored = TARGET.read_bytes()
   362	            if restored != original:
   363	                print(f"FATAL: {mid} 还原后字节不一致 — 停止", file=sys.stderr)
   364	                restore_broken = True
   365	        if restore_broken:
   366	            return 2
   367	        mark = "✓ 变红" if red else "✗ 仍绿 (门不承重!)"
   368	        print(f"[{idx:>2}/{len(MUTATIONS)}] {mid} {mark} · {gate} · {desc}")
   369	        if not red:
   370	            failures.append(f"{mid} ({gate}) 未变红: {desc}")
   371	
   372	    # 收尾: 还原后基线必须仍然全绿 (证明脚本没留下残渣)
   373	    after = subprocess.run(PYTEST + [TESTFILE], cwd=BACKEND, capture_output=True, text=True, timeout=900)
   374	    if after.returncode != 0:
   375	        print("FATAL: 跑完后基线不绿 — 文件被污染\n" + after.stdout[-3000:], file=sys.stderr)
   376	        return 2
   377	
   378	    print()
   379	    if failures:
   380	        print(f"负验证 FAIL: {len(failures)}/{len(MUTATIONS)} 条未按预期变红")
   381	        for f in failures:
   382	            print("  - " + f)
   383	        return 1
   384	    print(f"负验证 PASS: {len(MUTATIONS)}/{len(MUTATIONS)} 条变异均被**指定的那道门**抓住; 还原后基线仍全绿")
   385	    return 0
   386	
   387	
   388	if __name__ == "__main__":
   389	    sys.exit(main())

