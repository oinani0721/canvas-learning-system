   730	test("去抖 → 明说本次没重算 + 累计次数 + 还要等多久", () => {
   731	  const h = boot().api.renderRefreshResult(200, {rebuilt: false, reason: "debounced",
   732	    debounce_ttl_seconds: 10, retry_after_seconds: 6.2, rebuild_count: 3});
   733	  assert.match(h, /10 秒内已重建过/);
   734	  assert.match(h, /累计 3 次/);
   735	  assert.match(h, /本次未重算/);
   736	  assert.match(h, /约 7 秒后可再试/);
   737	  assert.match(h, /rnote warn/);
   738	  assert.ok(!h.includes("✅") && !/rnote ok/.test(h), "去抖不许长得像成功");
   739	});
   740	test("in_progress → 说清没重复启动 + 累计次数", () => {
   741	  const h = boot().api.renderRefreshResult(200, {rebuilt: false, reason: "in_progress", rebuild_count: 5});
   742	  assert.match(h, /已有一次重建在跑/);
   743	  assert.match(h, /累计 5 次/);
   744	  assert.ok(!/rnote ok/.test(h));
   745	});
   746	test("rebuild_count 缺省也不显示 undefined", () => {
   747	  const h = boot().api.renderRefreshResult(200, {rebuilt: true, reason: "rebuilt"});
   748	  assert.match(h, /已重建/);
   749	  assert.ok(!h.includes("undefined") && !h.includes("null"));
   750	});
   751	test("503 → 显示状态码与后端给的原因", () => {
   752	  const h = boot().api.renderRefreshResult(503, {detail: {error: "pick_missing", message: "生产器脚本不可用"}});
   753	  assert.match(h, /HTTP 503/);
   754	  assert.match(h, /生产器脚本不可用/);
   755	  assert.match(h, /rnote err/);
   756	});
   757	test("403 同源门 → 原样呈现, 不吞", () => {
   758	  const h = boot().api.renderRefreshResult(403, {detail: {error: "cross_site_blocked", message: "跨站请求被拒"}});
   759	  assert.match(h, /HTTP 403/);
   760	  assert.match(h, /跨站请求被拒/);
   761	});
   762	test("网络错误 (status 0) → 明确说网络失败", () => {
   763	  assert.match(boot().api.renderRefreshResult(0, {detail: "Failed to fetch"}), /网络错误/);
   764	});
   765	test("响应体不是 JSON (payload=null) 也不白, 给状态码", () => {
   766	  assert.match(boot().api.renderRefreshResult(500, null), /HTTP 500/);
   767	});
   768	""",
   769	    )
   770	    _assert_node_green(proc)
