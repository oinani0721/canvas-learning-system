   664	def test_js_new_due_card_appears_after_next_due_passes(node_harness):
   665	    """完成条件 c 的行为链: next_due=now+6s → 6 秒后那一轮的响应里出现新到期卡。
   666	
   667	    壳的职责分两半, 这里各锁一半:
   668	      ① 节奏 —— computePollDelayMs 让下一次 GET 恰好落在 6 秒后;
   669	      ② 呈现 —— 那一轮服务端返回的新 JSON (生产器已重算) 渲染出该板。
   670	    到期与否由投影裁定, 页面不参与判定 —— 所以第二半喂的是"服务端已经改了
   671	    的数据", 而不是让 JS 自己把未到期算成到期。
   672	    """
   673	    proc = _run_node(
   674	        node_harness,
   675	        _BOOT_PRELUDE
   676	        + _FIX_JS
   677	        + r"""
   678	const dueAt = new Date(NOW + 6000).toISOString().replace(/\.\d{3}Z$/, "Z");
   679	// 第一轮: 该板未到期 (休息日), next_upcoming 指向 6 秒后
   680	const before = {vaults: [{vault_id: "v", status: "ok", error: null, projection: {
   681	  due_count: 0, due_new_count: 0, placeholder_backlog: 0, bucket_counts: null,
   682	  generated_at: "2026-08-29T09:05:00+08:00", boards: [],
   683	  next_upcoming: {board: "堆与优先队列", next_due: dueAt, node: "二叉堆"}}}]};
   684	// 第二轮 (6 秒后, 生产器已重算): 同一板成为到期卡
   685	const after = {vaults: [{vault_id: "v", status: "ok", error: null, projection: {
   686	  due_count: 1, due_new_count: 0, placeholder_backlog: 0, bucket_counts: null,
   687	  generated_at: "2026-08-29T09:05:06+08:00", next_upcoming: null,
   688	  boards: [{board: "堆与优先队列", due: 1, due_new: 0, placeholder: null,
   689	            earliest: dueAt, nodes: [{node: "二叉堆", due_reason: "scheduled",
   690	            fsrs_due: dueAt, bucket: "due_now", why_due: "排期到点"}]}]}}]};
   691	
   692	test("① 下一次 GET 排在 next_due 时刻 (6 秒)", () => {
   693	  assert.equal(boot().api.computePollDelayMs(before, NOW), 6000);
   694	});
   695	test("② 到点前那一轮: 休息日, 页面没有该到期卡", () => {
   696	  const h = boot().api.renderPage(before, NOW);
   697	  assert.match(h, /休息一天/);
   698	  assert.ok(!h.includes("二叉堆"), "还没到期就不该出现节点");
   699	});
   700	test("③ 到点后那一轮: 到期卡与节点明细出现", () => {
   701	  const h = boot().api.renderPage(after, NOW + 6000);
   702	  assert.match(h, /到期 <b>1<\/b>/);
   703	  assert.match(h, /堆与优先队列/);
   704	  assert.match(h, /二叉堆/);
   705	  assert.ok(!h.includes("休息一天"));
   706	});
   707	""",
   708	    )
   709	    _assert_node_green(proc)
