   595	def test_js_poll_interval_clamped_and_visibility_pauses(node_harness):
   596	    """完成条件 c: 轮询周期 clamp(next_due−now, 5s, 60s) + 隐藏暂停。
   597	
   598	    clamp 断言一半走纯函数, 一半走真实接线: boot 成功拉取后, 实际排程的
   599	    setTimeout 延迟必须等于 computePollDelayMs 的裁决。
   600	    """
   601	    proc = _run_node(
   602	        node_harness,
   603	        _BOOT_PRELUDE
   604	        + _FIX_JS
   605	        + r"""
   606	function at(secondsFromNow) {  // 构造一个 now+N 秒的 next_due 投影
   607	  const iso = new Date(NOW + secondsFromNow * 1000).toISOString().replace(/\.\d{3}Z$/, "Z");
   608	  return {vaults: [{vault_id: "v", status: "ok",
   609	    projection: {next_upcoming: {board: "b", next_due: iso, node: "n"}}}]};
   610	}
   611	test("6 秒后到期 → 6 秒后再问 (区间内原样)", () => {
   612	  assert.equal(boot().api.computePollDelayMs(at(6), NOW), 6000);
   613	});
   614	test("2 秒后到期 → 夹到下限 5 秒 (不打爆后端)", () => {
   615	  assert.equal(boot().api.computePollDelayMs(at(2), NOW), 5000);
   616	});
   617	test("1 小时后到期 → 夹到上限 60 秒 (不睡死)", () => {
   618	  assert.equal(boot().api.computePollDelayMs(at(3600), NOW), 60000);
   619	});
   620	test("已过期的 next_due → 回落上限, 不空转", () => {
   621	  assert.equal(boot().api.computePollDelayMs(at(-100), NOW), 60000);
   622	});
   623	test("没有任何 upcoming → 回落上限", () => {
   624	  assert.equal(boot().api.computePollDelayMs({vaults: [NO_PROJ, CORRUPT]}, NOW), 60000);
   625	  assert.equal(boot().api.computePollDelayMs({vaults: []}, NOW), 60000);
   626	  assert.equal(boot().api.computePollDelayMs(null, NOW), 60000);
   627	});
   628	test("多库取最近的那个未来时刻", () => {
   629	  const data = {vaults: [at(50).vaults[0], at(8).vaults[0], at(-5).vaults[0]]};
   630	  assert.equal(boot().api.computePollDelayMs(data, NOW), 8000);
   631	});
   632	test("畸形 next_due 不炸, 按无排期处理", () => {
   633	  const bad = {vaults: [{vault_id: "v", status: "ok",
   634	    projection: {next_upcoming: {board: "b", next_due: "20260901", node: "n"}}}]};
   635	  assert.equal(boot().api.computePollDelayMs(bad, NOW), 60000);
   636	});
   637	test("页面隐藏 → 取消排程且不拉取", () => {
   638	  assert.deepEqual(boot().api.visibilityAction(true), {cancelTimer: true, pollNow: false});
   639	});
   640	test("回到前台 → 取消旧排程并立即拉一轮", () => {
   641	  assert.deepEqual(boot().api.visibilityAction(false), {cancelTimer: true, pollNow: true});
   642	});
   643	test("接线: 成功轮询后实际排程延迟 = clamp 裁决 (60s 上限路径)", async () => {
   644	  const b = boot({getJson: EMPTY_OK()});
   645	  await flush();
   646	  assert.equal(b.calls.get, 1);
   647	  assert.equal(b.timers.length, 1);
   648	  assert.equal(b.timers[0].ms, 60000, "next_due 在远期 → 排程必须落在 60s 上限");
   649	  assert.match(b.els["nextpoll"].textContent, /60 秒后/);
   650	  assert.equal(b.els["conn"].className, "conn ok");
   651	});
   652	test("接线: 页面以隐藏态启动 → 首轮照拉, 但不排下一轮", async () => {
   653	  const b = boot({getJson: EMPTY_OK(), hidden: true});
   654	  await flush();
   655	  assert.equal(b.calls.get, 1, "首轮拉取不受隐藏影响 (数据还是要拿的)");
   656	  assert.equal(b.timers.length, 0, "隐藏期间不得排下一轮");
   657	  assert.match(b.els["nextpoll"].textContent, /已暂停/);
   658	});
   659	""",
   660	    )
   661	    _assert_node_green(proc)
