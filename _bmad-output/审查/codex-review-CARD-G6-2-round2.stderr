   923	    error: '</script><script>alert(2)</script>', projection: null}, 0);
   924	  assert.ok(!h.includes("<img"), "库名未转义");
   925	  assert.ok(!h.includes("<script"), "错误串未转义");
   926	  assert.match(h, /&lt;img/);
