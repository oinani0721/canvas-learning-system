   914	def test_js_escapes_hostile_names_and_encodes_deep_links(node_harness):
   915	    """XSS / 深链编码: 库名、板名、节点名、错误串都来自外部 JSON。"""
   916	    proc = _run_node(
   917	        node_harness,
   918	        _BOOT_PRELUDE
   919	        + _FIX_JS
   920	        + r"""
   921	test("恶意库名不产生可执行标签", () => {
