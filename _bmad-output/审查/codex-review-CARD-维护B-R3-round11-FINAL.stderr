  2931	    # `## 你现在可以做的（本轮）` 定位失败, 动作段白名单被整块跳过
  2932	    acts = re.search(
  2933	        _SECTION_RE("## 你现在可以做的") + r"(.*?)(?=^#{2}(?:[^\S\n]|$)|\Z)",
  2934	        text,
  2935	        re.M | re.S,
  2936	    )
  2937	    if acts:
