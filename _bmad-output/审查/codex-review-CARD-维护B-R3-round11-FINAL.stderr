  2770	def _verify_report(path: str) -> int:
  2771	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2772	
  2773	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2774	    """
  2775	    try:
  2776	        text_raw = Path(path).read_text(encoding="utf-8")
  2777	    except (OSError, UnicodeDecodeError) as e:
  2778	        print(f"✗ 报告不可读: {type(e).__name__}")
  2779	        return 1
  2780	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2781	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2782	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2783	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2784	    if not fm_m:
  2785	        print("✗ 报告缺 frontmatter 块")
  2786	        return 1
  2787	    fm = fm_m.group(1)
  2788	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2789	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2790	    if "<!--" in fm or "-->" in fm:
  2791	        print("✗ frontmatter 块内含 HTML 注释标记")
  2792	        return 1
  2793	    problems: list[str] = []
  2794	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2795	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——

