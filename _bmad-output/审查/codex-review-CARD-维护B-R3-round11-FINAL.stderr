  2940	        items = re.findall(
  2941	            r"^\d+\.\s.*(?:\n(?!\d+\.\s|##|\s*$).*)*", acts.group(1), re.M
  2942	        )
  2943	        if not items:
  2944	            problems.append("「你现在可以做的」没有编号动作项")
  2945	        for it in items:
