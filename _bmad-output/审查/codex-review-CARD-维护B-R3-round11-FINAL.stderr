  2031	    assert base.returncode == 0, f"基线真报告本身就不过 verifier:\n{base.stdout}"
  2032	    rp.write_text(rp.read_text(encoding="utf-8") + extra, encoding="utf-8")
  2033	    return run_verify(rp)
