   840	def _crash_text(stdout: str, stderr: str | None) -> str:
   841	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   842	
   843	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   844	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   845	    """
   846	    return stdout + "\n" + (stderr or "")
   847	
   848	
   849	def _looks_like_crash(out: str) -> bool:
   850	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   900	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   901	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   902	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   903	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   904	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   905	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   906	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   907	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   908	    return bool(
   909	        any(name not in LEGIT_RED for name in exc_names)
   910	        or "Traceback (most recent call last):" in out
   911	        or "INTERNALERROR" in out
   912	        or errors > 0
   913	    )
   914	
   915	
   916	def run_suite(targets: list[str], keyword: str | None = None) -> tuple[int, str, int, int, bool, set[str]]:
   917	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数, 是否崩溃)。
   918	
   919	    ⛔ round-36：`targets` 是**精确 nodeid 列表**（基线态传套件路径 + keyword）。
   920	    原先靠 `-k` 选门，12 条变体的 keyword 一选就是好几个用例，
   921	    「有失败」证明不了「**指定**门死了」——见 `DESIGNATED` 的说明。
   922	
   923	    ⛔ round-27（冻结审查 v8）：注解与 docstring 原写**四元组**，实际返回五元组
   924	    （`crash` 是 round-10 加的）—— 又一处「说的与做的不符」。
   925	
   926	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   927	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   928	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   929	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   930	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   931	    要求"确实收集到用例"且"确实有失败"才算变红。
   932	    """
   933	    r = subprocess.run(
   934	        [str(PYTEST), *targets, "-q", "-rf", "-p", "no:cacheprovider"] + (["-k", keyword] if keyword else []),
   935	        cwd=ROOT / "backend",
   936	        capture_output=True,
   937	        text=True,
   938	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   939	        timeout=600,
   940	    )
   941	    out = r.stdout
   942	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   943	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   944	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   945	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   946	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   947	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   948	    both = _crash_text(out, r.stderr)
   949	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   950	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   951	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   952	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   953	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   954	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   955	    # 的形式混进证据, 且永远不会有人去查。
   956	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   957	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   958	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   959	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   960	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   961	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   962	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   963	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   964	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   965	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   966	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   967	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   968	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   969	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   970	    crash = _looks_like_crash(both)
   971	    # ⛔ round-37（Codex HIGH）：只汇总 `N failed` 是**计数**，不是**身份**。
   972	    # 「指名 A、结果 B 死了」在计数上与「A 死了」完全一样。`-rf` 让 pytest 打出
   973	    # `FAILED <nodeid>` 短摘要，这里解析出**真实失败的门**交给判据比对集合。
   974	    failed_ids = {m.group(1).split("::")[-1] for m in re.finditer(r"^FAILED\s+(\S+)", out, re.M)}
   975	    return r.returncode, out[-400:], passed + failed, failed, crash, failed_ids
   976	
