  1899	def _count_token_value(token: str) -> int | None:
  1900	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1901	
  1902	    只两种情形给值:
  1903	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1904	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1905	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1906	    """
  1907	    if not token:
  1908	        return None
  1909	    if token.isascii() and token.isdigit():
  1910	        return int(token)
  1911	    return _cjk_single_to_int(token)
  1912	
  1913	
  1914	def _cjk_single_to_int(s: str) -> int | None:
  1915	    """中文数词 → int; **只认单字数词**, 其余一律 None (不猜)。
  1916	
  1917	    ⛔ 对抗审查 BLOCKER: D2 的数字原为 `[0-9]+`, 于是「本板共有九十八万个子节点」
  1918	    这类**完全虚构**的规模自陈整域免检。scan 的计数都是 ASCII 整数, 报告换个写法
  1919	    不该换来免检 —— 归一后照常比对。
  1920	
  1921	    ⛔ round-5 (Codex 定向复核 HIGH) + R3 收口: 原实现是**多位文法解析器**
  1922	    `_cjk_to_int`, 两条毛病一体:
  1923	      1. 提取正则 `[零〇一二两三四五六七八九十百千万亿]+` 与 `_CJK_NUM`/`_CJK_UNIT`
  1924	         **完全同集** ⇒ 任何非空匹配必返回某个整数, 所谓「解析失败 fail-closed」
  1925	         分支**静态不可达** (死代码冒充防线);
  1926	      2. 连续数字字不校验文法, 只反复覆盖 `digit` ⇒ 「五四」得 4、「一零」得 0,
  1927	         按**局部值**查池。而 0 恒在池内 (`abs(a-a)`), 于是
  1928	         `本板共有一零个子节点。` 这句**纯虚构**自陈实测 exit 0 放行
  1929	         (红证据 `_bmad-output/审查/evidence-maintb-r3/b-prefix-red-repro.txt`)。
  1930	
  1931	    终态口径 (R3 冻结, 不得再引入多位解析器): 值 = 单字映射, **绝对确定**才认;
  1932	    多字 / 单字量词 (十百千万亿, 不在 `_CJK_NUM`) / 集合外字符一律 None,
  1933	    由调用方按「无法验证 / 无法解析」fail-closed 处理, 不静默放行。
  1934	    代价如实记: 合法的多字中文数词计数也会被拒 —— 诊断已提示「请改用阿拉伯
  1935	    数字」, 且报告为机器渲染 (模板与合成语料无多字合法用例, 实测零误伤)。
  1936	    """
  1937	    return _CJK_NUM.get(s) if len(s) == 1 else None
  1938	
