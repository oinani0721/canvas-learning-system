  2948	                    f"动作项缺白名单动词(无动作的信号移去 AI 侧对账): {it.strip()[:40]}"
  2949	                )
  2950	        # M7 五轮: 结构性拦截 — 动作段只许编号项, 任何编号项之外的正文行
  2951	        # (无论措辞, 同义改写也一样) 都是越界内容, 词表补丁竞赛到此为止。
  2952	        leftover = acts.group(1)
  2953	        for it in items:
  2954	            leftover = leftover.replace(it, "")
  2955	        stray = [ln.strip() for ln in leftover.splitlines() if ln.strip()]
  2956	        if stray:
  2957	            problems.append(
  2958	                f"动作段含编号项之外的正文行(移去对应段落): {stray[0][:40]}"
  2959	            )
  2960	    for p in problems:
  2961	        print(f"✗ {p}")
  2962	    if problems:
  2963	        print(f"VERIFY FAIL ({len(problems)} 项) — 改写报告后重跑本命令")
  2964	        return 1
  2965	    print("VERIFY PASS — 可以发回执")

