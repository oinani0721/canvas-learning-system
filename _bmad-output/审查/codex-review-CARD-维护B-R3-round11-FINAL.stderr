   912	def _verify_signal_schema(key: str, sig, problems: list[str]) -> bool:
   913	    """signals.<key> 子对象 schema fail-closed (Codex round-2 M2)。
   914	
   915	    只校验顶层 signals 是 dict 不够 — 把子对象削成 {"availability":"无据"}
   916	    就能让报告写四条"无据"蒙混过关。必需五键齐全 / availability 属枚举 /
   917	    无据 ⇒ value is None 且 denominator == 0 / 有数 ⇒ value 是整数。
   918	    """
   919	    if not isinstance(sig, dict):
   920	        problems.append(f"数字终核: scan JSON signals.{key} 形状损坏")
   921	        return False
   922	    missing = [f for f in _SIGNAL_REQUIRED_FIELDS if f not in sig]
   923	    if missing:
   924	        problems.append(f"数字终核: signals.{key} 缺必备字段 {missing}")
   925	        return False
   926	    avail = sig.get("availability")
   927	    if avail not in _AVAIL_ENUM:
   928	        problems.append(f"数字终核: signals.{key}.availability 非法值 {avail!r}")
   929	        return False
   930	    if avail == AVAIL_NODATA:
   931	        if sig.get("value") is not None or sig.get("denominator") != 0:
   932	            problems.append(f"数字终核: signals.{key} 标无据却带数值 (契约违反)")
   933	            return False
   934	    else:
   935	        # round-3 M2: Python 里 bool 是 int 子类 — `value: true` 配报告 "1/N"
   936	        # 曾整条通过。显式排除 bool。
   937	        for f in ("value", "denominator"):
   938	            v = sig.get(f)
   939	            if isinstance(v, bool) or not isinstance(v, int):
   940	                problems.append(
   941	                    f"数字终核: signals.{key}.{f} 非整数 ({type(v).__name__})"
   942	                )
   943	                return False
   944	        # round-4 新增 FAIL: 年龄信号有数档时 percentile_ref 必须是含三个整数
   945	        # 分位的对象 — 置 null 时报告渲染成 "None/None/None" 曾照样通过。
   946	        if key == "unanswered_question_age":
   947	            pr = sig.get("percentile_ref")
   948	            if not isinstance(pr, dict):
   949	                problems.append(
   950	                    f"数字终核: signals.{key} 有数档但 percentile_ref 非对象"
   951	                )
   952	                return False
   953	            for pk in ("p25_days", "p50_days", "p75_days"):
   954	                pv = pr.get(pk)
   955	                if isinstance(pv, bool) or not isinstance(pv, int):
   956	                    problems.append(
   957	                        f"数字终核: signals.{key}.percentile_ref.{pk} 非整数"
   958	                    )
   959	                    return False
   960	    return True
