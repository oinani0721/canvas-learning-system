   965	def test_r2_non_whole_second_durable_review_time_fail_closed(vault):
   966	    """bridge 入口 _whole_second 会把 10:00:00.500Z 截成 10:00:00Z 写进 W,
   967	    而账本那行仍是 .500Z ⇒ 「.500 > .000」恒真, 同一行**每次重跑都判 pending
   968	    并再推进一次 FSRS** (实测: 账本始终一行, W 逐次 +1s = §6.2 A5 禁止的二次
   969	    apply)。修复方向必须是 apply 前只验不改 — 消费时归一化会把损坏行洗成
   970	    合法行, 把缺陷从写入面挪进不可见面。"""
   971	    # 判据必须落在**字面**上, 不是解析后的值 (自查补): '.000000Z' 的
   972	    # microsecond 恰为 0, 只看值会放行它, 而校验器的 _WHOLE_SECOND_RE 按字面
   973	    # 判 FAIL ⇒ 写点放行、validator 拒, 实现与契约又成两个口径。
   974	    for rt_bad, why in (
   975	        ("2026-08-01T10:00:00.500Z", "小数秒"),
   976	        ("2026-08-01T10:00:00.000000Z", "小数秒"),  # 零值小数秒字面: 值合规、字面不合规
   977	        ("2026-08-01T10:00:00.0Z", "小数秒"),
   978	        ("2026-08-01T10:00:00+00:00:00", "小数秒"),  # 非 canonical 偏移字面
   979	        ("2026-08-01T10:00+00:00", "小数秒"),  # 省略秒段 (§6.2 round-4 HIGH#1)
   980	        ("2026-08-01T18:00:00+08:00", "非 UTC"),  # 字面合规但偏移非零
   981	    ):
   982	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   983	        _write_ledger(vault, _review_row(**{"payload.review_time": rt_bad, "effective_at": rt_bad}))
   984	        sha = _sha(vault / NODE_REL)
   985	        # ①该行即本次事件 (dup 路径)
   986	        r = _run_writer(vault, _payload(event_id="板A#q1"))
   987	        assert r.returncode != 0, f"{why} durable 行 (dup 路径) 必须 fail-closed"
   988	        assert why in r.stderr, r.stderr
   989	        assert _sha(vault / NODE_REL) == sha and len(_ledger_lines(vault)) == 1, "零写"
   990	        # ②该行是别的事件 (foreign pending 路径) — 同样在重放前拒
