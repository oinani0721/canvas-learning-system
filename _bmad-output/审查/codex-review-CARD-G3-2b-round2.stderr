  1098	    assert "完整写入的损坏行" in r.stderr, r.stderr
  1099	    assert _sha(vault / NODE_REL) == sha, "零写节点"
  1100	    assert len(ledger.read_text(encoding="utf-8").splitlines()) == 2, "零写账本"
