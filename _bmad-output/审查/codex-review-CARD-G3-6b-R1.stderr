     2	# 每日复习推送 — 编排壳 (DAILY-REVIEW-PUSH-2026-07-29, CARD-C1a per-vault 化)。
     3	# 只做两件事: per-vault 互斥锁 (终审 A7: 手工/kickstart/定时可能重叠) +
     4	# 固定解释器调 runner。业务逻辑全在 daily_review_run.py (--now 可测)。
     5	set -uo pipefail
     6	
     7	REPO="/Users/Heishing/Desktop/canvas/canvas-learning-system"
     8	WT="$REPO/.claude/worktrees/feature-obsidian-hybrid-dev"
     9	
    10	PY="$WT/backend/.venv/bin/python"
    11	[ -x "$PY" ] || PY="/usr/bin/python3"   # venv 缺失兜底 (runner 仅 stdlib)
    12	
    13	# 参数解析: 只认全称 --vault / --vault=; runner argparse 已设
    14	# allow_abbrev=False 与此同源 (Codex-C1a F1: argparse 缩写 --v 曾让锁
    15	# 与 runner 指向不同 vault)。取最后一次出现, 与 argparse 语义一致。
    16	VAULT_ARG=""
    17	prev=""
    18	for a in "$@"; do
    19	    [ "$prev" = "--vault" ] && VAULT_ARG="$a"
    20	    case "$a" in --vault=*) VAULT_ARG="${a#--vault=}";; esac
    21	    prev="$a"
    22	done
    23	VAULT_ARG="${VAULT_ARG:-$REPO/canvas-vault}"
    24	
    25	# 锁 key 与 runner state 同源 (send_bark.vault_key + symlink resolve)。
    26	# 用 -c 免 heredoc 的 TMPDIR 依赖; 算不出 key 即整体不跑 (fail hard, 78)
    27	# — runner 用同一解释器, key 都算不出 runner 也必跑不了; 回退 basename
    28	# 会造成中文/长名锁分域 (Codex-C1a F1)。
    29	KEY=$("$PY" -c '
    30	import sys
    31	from pathlib import Path
    32	sys.dont_write_bytecode = True
    33	sys.path.insert(0, sys.argv[2])
    34	import send_bark
    35	p = Path(sys.argv[1])

