   335	def _fm_int(fm: str, key: str):
   336	    """整数型 frontmatter (fsrs_state)。非整数 / 溢出 / 缺失一律 None = 无状态。
   337	
   338	    S1: 未知状态不吞节点 — 只是不享受 learning_queue 分层优待, 仍按到期落
   339	    due_now。inf.is_integer() 为 False, 巨值串因此也走 None 分支。
   340	    """
   341	    v = _fm_num(fm, key)
   342	    if v is None or not float(v).is_integer():
   343	        return None
   344	    return int(v)
