   323	def _board_name(raw: str | None):
   324	    """source_board 归一化 → 板名 (live 数据实为 wikilink '[[原白板/X]]')。"""
   325	    if not raw:
   326	        return None
   327	    name = raw.strip()
   328	    if name.startswith("[[") and name.endswith("]]"):
   329	        name = name[2:-2]
   330	    name = name.split("|")[0]                 # [[path|alias]] 取 path
   331	    name = name.rsplit("/", 1)[-1].strip()    # 原白板/X → X
   332	    return name or None
   333	
