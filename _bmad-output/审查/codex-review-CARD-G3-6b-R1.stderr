   837	def _body(top: dict) -> str:
   838	    idle = "从未考察" if top["idle_days"] is None else f"已闲置 {top['idle_days']} 天"
   839	    if top["pending"] >= 2:
   840	        return f"{top['top_node']} 等 {top['pending']} 节点待巩固 · {idle}"
   841	    return f"{top['top_node']} 待巩固 · {idle}"
