  1087	def main():
  1088	    # allow_abbrev=False 与 runner/push.sh 同源 (Codex-C1a F1)
  1089	    ap = argparse.ArgumentParser(description="每日复习选板", allow_abbrev=False)
  1090	    ap.add_argument("--vault", required=True)
  1091	    ap.add_argument("--state", help="daily-review.state.json (只读, 取 board_last_recommended)")
  1092	    ap.add_argument("--now", help="ISO 时间覆盖 (测试用)")
  1093	    ap.add_argument("--write", action="store_true", help="写 outputs/今日复习.md+json")
  1094	    args = ap.parse_args()
  1095	
  1096	    vault = Path(args.vault)
  1097	    # 裸时间当本地时区, 与 daily_review_run.py 语义统一 (Code-Review L6)
  1098	    if args.now:
  1099	        dt = datetime.fromisoformat(args.now.replace("Z", "+00:00"))
  1100	        now = dt if dt.tzinfo else dt.astimezone()
  1101	        # Codex-G3-6a round-1 HIGH: 日历极值时刻 (如 9999-12-31T23:59:59Z)
  1102	        # 在本地/上海时区换算时 OverflowError —— HEAD 起就会在
  1103	        # payload["date"] 处抛 traceback 中断整轮, 本卡把桶位判定挪到更前
  1104	        # 只是让崩点提前。与其抛 traceback, 在入口一次性拒绝并说清原因
  1105	        # (不改任何冻结字段的计算)。
  1106	        try:
  1107	            now.astimezone()
  1108	            now.astimezone(_TZ_SHANGHAI)
  1109	        except (OverflowError, OSError):
  1110	            ap.error(f"--now 超出可换算范围 (本地/上海时区换算溢出): {args.now}")
  1111	    else:
  1112	        now = datetime.now(timezone.utc)
  1113	    blr = {}
  1114	    if args.state and Path(args.state).exists():
  1115	        try:
  1116	            blr = json.loads(Path(args.state).read_text(encoding="utf-8")).get(
  1117	                "board_last_recommended", {})
  1118	        except (json.JSONDecodeError, OSError):
  1119	            pass  # state 损坏由 runner 处置, 选点侧降级为无记录
  1120	
  1121	    payload, ranked = build_payload(vault, now, blr, load_decay(vault))
  1122	    if args.write:
  1123	        out = vault / "outputs"
  1124	        out.mkdir(parents=True, exist_ok=True)
  1125	        # CARD-G6-1: 两份内容先全部渲染好, 再连着发布两次 —— md 与 json 是
  1126	        # 一对, 两个写者并发时可能各中一半 (md 来自 B、json 来自 A, Codex
  1127	        # 探针 PAIR_FINAL 实测成立)。把渲染/序列化挪到两次 rename 之前,
  1128	        # 窗口从"一次 json.dumps 的时长"收窄到"一次文件 I/O 的时长"。
  1129	        # ⚠ 只是收窄不是消除: 真正的配对原子性要目录级换名或跨进程锁,
  1130	        # VirtioFS 上锁行为不可证, 本卡不假装做到 (如实登记)。
  1131	        md_text = render_md(payload, ranked)
  1132	        json_text = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
  1133	        atomic_write(out / "今日复习.md", md_text)
  1134	        atomic_write(out / "今日复习.json", json_text)
  1135	    print(json.dumps(payload, ensure_ascii=False))
  1136	
  1137	
  1138	if __name__ == "__main__":
  1139	    main()

