   602	
   603	def _recorded_claim(recorded: dict, key: str, subkey: str | None = None):
   604	    """recorded 小节取值, 剥掉 "_" 开头的说明键; 形状不符返 None (= 未登记)。"""
   605	    node = recorded.get(key)
   606	    if not isinstance(node, dict):
   607	        return None
   608	    if subkey is not None:
   609	        return node.get(subkey)
   610	    return {k: v for k, v in node.items() if not k.startswith("_")}
   611	
   612	
   613	def _warn_recorded_drift(recorded: dict, effective: dict):
   614	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   615	
   616	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   617	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   618	    """
   619	    for label, claimed, actual in (
   620	        ("ranking_factors.order",
   621	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   622	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   623	        ("decay_beta_constants",
   624	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   625	    ):
   626	        if claimed is not None and claimed != actual:
   627	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   628	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
   629	
   630	
   631	def _implementation_sha(path=None) -> str:
   632	    """S5 本生成器源码的实现指纹 (Codex round-2 HIGH)。
   633	
   634	    因子清单/精度常量只能覆盖「登记过的配置面」, 覆不完取值绑定这类字面
   635	    代码 —— 把 pick.py 自身字节也摘进指纹。
   636	
   637	    ⚠ 保证的精确边界 (CARD-G3-6b-R1 收窄: 原措辞"任何排序规则改动必然变
   638	    sha"宽于可证面, 与 round-3 实测反例冲突):
   639	
   640	    1. 摘的是**本 .py 源文件的字节**。改源文件 (精度/绑定/方向/新因子, 乃至
   641	       一个注释) 必变 sha —— 这正是本卡针对的「善意配置/代码演进无痕漂移」。
   642	       粒度因此从「系数」变粗为「实现+系数」, 属预期内的保守取舍。
   643	    2. **单向保证**: 排序规则变 ⟹ sha 变。逆命题不成立, 且是刻意放弃的 ——
   644	       摘全文件使指纹对注释也敏感; 追加重复因子键同样「sha 变而排序不变」
   645	       (Codex round-2 LOW 的实测方向)。不可拿 sha 变没变去推断「改了什么」,
   646	       它只证明「变了」。
   647	    3. **不覆盖运行时字节码**: 绕过 .py 直接执行被改的 __pycache__/*.pyc
   648	       (伪造 mtime 使 Python 取旧 pyc) 可让排序变而本 sha 不变 —— round-3
   649	       已实测复现。该面属主动篡改运行时的威胁模型, 明确排除在本卡之外;
   650	       本函数**不宣称运行时完整性** (见验收单「本卡未证明什么」第 4 条)。
   651	    """
   652	    p = Path(path) if path is not None else Path(__file__).resolve()
   653	    return hashlib.sha256(p.read_bytes()).hexdigest()
   654	
   655	
   656	def effective_rank_config(decay, version, minutes: dict) -> dict:
   657	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   658	
   659	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   660	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   661	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   662	    该变), 上限与因子序/取整精度取代码常量, 分钟取 manifest 生效值,
   663	    implementation_sha256 摘本文件字节 (round-2 HIGH: 取值绑定无法全部
   664	    数据化, 由实现指纹兜住「改**源文件**规则而指纹不动」—— 其单向性与
   665	    不覆盖运行时 .pyc 的边界见 _implementation_sha 的三条声明)。
   666	    """
   667	    return {
   668	        "version": version,
   669	        "ranking_factors": list(TIE_FACTOR_KEYS),
   670	        "tie_pick_round_digits": int(TIE_PICK_ROUND_DIGITS),
   671	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   672	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   673	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   674	        "implementation_sha256": _implementation_sha(),
   675	    }
   676	
   677	
   678	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   679	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   680	    effective = effective_rank_config(decay, version, minutes)
   681	    _warn_recorded_drift(recorded, effective)
   682	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   683	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   684	
   685	
   686	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   687	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   688	
   689	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   690	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   691	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   692	    """
   693	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   694	    overdue_days = None
   695	    if scheduled:
   696	        earliest_sh = _sh_local(min(scheduled))
   697	        if earliest_sh is not None:
   698	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   699	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   700	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   701	
   702	    rec = board_last_recommended.get(board, "")
   703	    gap = None
   704	    if rec:
   705	        try:
   706	            # 不夹负值 (Codex round-1 MEDIUM): 记录晚于今天属异常状态, 如实
   707	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   708	            # 「今天刚推荐过」, 违反 S4 不虚构。
   709	            gap = (today_sh - date.fromisoformat(rec)).days
   710	        except (ValueError, TypeError):
   711	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   712	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   713	            gap = None
   714	    return {
   715	        "due_total": len(due),
   716	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   717	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   718	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   719	        "overdue_days": overdue_days,
   720	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   721	        "never_recommended": not rec,
   722	        "recommend_gap_days": gap,
   723	    }
   724	
   725	
   726	def why_this_board(f: dict) -> str:
   727	    """S4 模板: factors → 恒非空人话串。纯函数 — 同一 factors 恒得同一句。
   728	
   729	    契约测试把落盘的 factors 原样喂回本函数, 要求与落盘的 why_this_board
   730	    逐字相同 —— 解释与数字之间没有第二条通路 (没有 LLM, 没有渲染层再算)。
   731	    """
   732	    scale = f"{int(f['due_total'])} 个节点到期"
   733	    if f["due_new"]:
   734	        scale += f"（其中 {int(f['due_new'])} 张新卡）"
   735	    parts = [scale]
   736	    if f["due_scheduled"]:
   737	        od = f["overdue_days"]
   738	        if od is None:
   739	            parts.append("最早到期时刻超出可显示范围")
   740	        elif od > 0:
   741	            parts.append(f"最早的已逾期 {int(od)} 天")
   742	        else:
   743	            parts.append("最早的今天到期")
   744	    if f["due_malformed"]:
   745	        parts.append(f"含 {int(f['due_malformed'])} 个到期时间无法解析的节点")
   746	    parts.append("最该考的从未考察" if f["idle_days"] is None
   747	                 else f"最该考的已闲置 {int(f['idle_days'])} 天")
   748	    if f["never_recommended"]:
   749	        parts.append("这块板从未被推荐过")
   750	    elif f["recommend_gap_days"] is None:
   751	        parts.append("上次推荐日期无法解析")
   752	    elif f["recommend_gap_days"] < 0:
   753	        # 记录晚于今天 (时钟回拨/时区错乱/手滑改了 state) — 如实说异常,
   754	        # 不 clamp 成 0 伪装成"今天刚推荐过" (Codex round-1 MEDIUM)
   755	        parts.append("上次推荐日期晚于今天")
   756	    elif f["recommend_gap_days"] == 0:
   757	        parts.append("今天已推荐过")
   758	    else:
   759	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   760	    return " · ".join(parts)
