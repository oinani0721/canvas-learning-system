   549	def load_rank_manifest(path=None):
   550	    """S5 读系数清单 → (version, minutes, recorded)。缺失/损坏 = 诚实降级。
   551	
   552	    返回的 minutes 恒是可用的一对非负 int: manifest 给不出合法值时逐项回落
   553	    内置默认并 stderr 点名 —— 配置文件丢了不该让每日推送整轮失败, 但也绝不
   554	    静默 (静默降级 = 把配置断裂伪装成"就该是这个数")。version 只在文件与
   555	    version 字段双双可用时为整数, 其余一律 None ("没有版本"而非假装有)。
   556	    """
   557	    path = Path(path) if path is not None else Path(__file__).resolve().parent / MANIFEST_FILENAME
   558	    minutes = dict(DEFAULT_MINUTES)
   559	    try:
   560	        raw = json.loads(path.read_text(encoding="utf-8"))
   561	    except (OSError, ValueError) as e:  # ValueError ⊃ JSONDecodeError
   562	        print(f"[pick] 系数清单不可用, 用内置默认: {path} ({type(e).__name__})", file=sys.stderr)
   563	        return None, minutes, {}
   564	    if not isinstance(raw, dict):
   565	        print(f"[pick] 系数清单不是 object, 用内置默认: {path}", file=sys.stderr)
   566	        return None, minutes, {}
   567	
   568	    version = raw.get("version")
   569	    if not isinstance(version, int) or isinstance(version, bool):
   570	        print(f"[pick] 系数清单 version 非整数, 记为 None: {version!r}", file=sys.stderr)
   571	        version = None
   572	
   573	    auth = raw.get("authoritative")
   574	    # 三层 (authoritative 节 / estimated_minutes 子节 / 叶键) 任何一层缺失、
   575	    # null 或形状不符都必须点名回落, 不许静默 (Codex round-2 MEDIUM: 前一轮
   576	    # 只修了叶键, 父节缺失照样无声 —— 配置断裂被伪装成"就该是这个数")
   577	    if not isinstance(auth, dict):
   578	        print(f"[pick] authoritative 节缺失或形状不符({auth!r}), 分钟用内置默认",
   579	              file=sys.stderr)
   580	        cfg = None
   581	    else:
   582	        cfg = auth.get("estimated_minutes")
   583	        if not isinstance(cfg, dict):
   584	            print(f"[pick] authoritative.estimated_minutes 缺失或形状不符({cfg!r}), "
   585	                  "分钟用内置默认", file=sys.stderr)
   586	            cfg = {}
   587	    if isinstance(cfg, dict):
   588	        for k in DEFAULT_MINUTES:
   589	            v = cfg.get(k)
   590	            if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
   591	                minutes[k] = v
   592	            else:
   593	                # 缺键与非法值同等待遇: 点名后再回落 (Codex round-1 MEDIUM —
   594	                # 只验"在场但坏", 会放过"压根没写"的半份配置, 让静默回落
   595	                # 伪装成用户确实配了)
   596	                print(f"[pick] estimated_minutes.{k} 缺失或非法({v!r}), 用内置默认 {minutes[k]}",
   597	                      file=sys.stderr)
   598	
   599	    recorded = raw.get("recorded")
   600	    return version, minutes, (recorded if isinstance(recorded, dict) else {})
