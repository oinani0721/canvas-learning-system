    22	PRIOR_B = 2.1
    23	
    24	#: 遗忘因子 — 每次观测前 a,b 同乘 γ, 有效记忆窗口 ~1/(1-γ) = 10 次观测
    25	GAMMA = 0.9
    26	
    27	#: 选点探索权重 (μ − β·σ)
