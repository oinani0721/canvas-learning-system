   773	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   774	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   775	
   776	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   777	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   778	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   779	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   780	    """
   781	    minutes = minutes or DEFAULT_MINUTES
   782	    today_sh = _today_sh(now)
   783	    boards: dict[str, list] = {}
   784	    unassigned = []
   785	    for n in nodes:
   786	        if not n["board"]:
   787	            unassigned.append(n["node"])
   788	            continue
   789	        boards.setdefault(n["board"], []).append(n)
   790	
   791	    ranked, upcoming = [], []
   792	    for board, members in boards.items():
   793	        due = [n for n in members if n["due_now"]]
   794	        if not due:
   795	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   796	            nxt = min(members, key=lambda n: n["fsrs_due"])
   797	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   798	            continue
   799	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   800	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   801	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   802	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   803	        tie_parts = {
   804	            "priority_pick": round(top["pick"], TIE_PICK_ROUND_DIGITS),
   805	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   806	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   807	            "board": board,
   808	        }
   809	        ranked.append({
   810	            "board": board,
   811	            "top_node": top["node"],
   812	            "priority": round(top["pick"], 4),
   813	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   814	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   815	            "difficulty": top["difficulty"],
   816	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   817	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   818	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   819	            "why_this_board": why_this_board(factors),
   820	            "estimated_minutes": estimated_minutes(factors, minutes),
   821	            "factors": factors,
   822	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   823	        })
   824	    ranked.sort(key=lambda r: r["_tie"])
   825	    for r in ranked:
   826	        del r["_tie"]
   827	    upcoming.sort(key=lambda u: u["next_due"])
   828	    return ranked, upcoming, unassigned
