   986	        f" / 未归板={s['unassigned']} / 损坏={s['corrupt']}",
   987	        "",
   988	        "| 板 | 优先分 | 到期待复习 | 最该考 | 难度 | 闲置 | 板内下次到期 |",
   989	        "|---|---|---|---|---|---|---|",
   990	    ]
   991	    for r in ranked:
   992	        idle = "从未考" if r["idle_days"] is None else f"{r['idle_days']} 天"
   993	        nxt = r["next_due"][:10] if r["next_due"] else "-"
   994	        diff = r["difficulty"] or "-"
   995	        lines.append(
   996	            f"| {r['board']} | {r['priority']} | {r['pending']} | {r['top_node']} | {diff} | {idle} | {nxt} |"
   997	        )
   998	    if payload.get("upcoming"):
   999	        for u in payload["upcoming"]:
  1000	            lines.append(f"| {u['board']} | - | 0（未到期） | - | - | - | {u['next_due'][:10]} |")
  1001	    # CARD-G3-6b 加性段 (S4): 表格零改动, 只在其后追加「为什么是这几块板」
  1002	    # —— 与 G3-6a 分层队列段同一条纪律 (加标签不改既有面)。句子由白名单模板
