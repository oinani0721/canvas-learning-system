  1603	def _tie_fixture_vault(tmp_path) -> tuple[Path, Path]:
  1604	    """排序金样 fixture: 四块板 pick 全同 (同 mastery 无 fsrs_due), tie-break
  1605	    逐级可辨 —— 乙板有推荐记录 (blr 罚后), 其余三块按 板名 排。state 单独
  1606	    成文件供两个版本的 CLI 同参消费。"""
  1607	    vault = tmp_path / "tiefixture"
  1608	    (vault / ".claude" / "scripts").mkdir(parents=True)
  1609	    (vault / "节点").mkdir()
  1610	    shutil.copy(WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py", vault / ".claude" / "scripts")
  1611	    for board in ("甲板", "乙板", "丙板", "丁板"):
  1612	        (vault / "节点" / f"{board}节点.md").write_text(
  1613	            "---\ntype: concept\n"
  1614	            f'source_board: "[[原白板/{board}]]"\n'
  1615	            "mastery_a: 2.0\nmastery_b: 3.0\n---\n真实内容。\n",
  1616	            encoding="utf-8",
  1617	        )
  1618	    state = tmp_path / "state.json"
  1619	    state.write_text(json.dumps({"board_last_recommended": {"乙板": "2026-07-28"}}), encoding="utf-8")
  1620	    return vault, state
  1621	
  1622	
  1623	def test_g36b_top_boards_order_matches_head_baseline(tmp_path):
  1624	    """S4 排序金样锁: 本卡产出与开工基线 (9af18b27) 的 top_boards 顺序逐字
  1625	    相同 —— 本卡只加解释不改序, 改序另立卡。
  1626	
  1627	    走真实 CLI 链路 (subprocess 双跑, 不 import 复刻): 导出基线版 pick.py,
  1628	    与工作区版用同一 vault/同一 --now/同一 --state 各跑一次, 对比 stdout
  1629	    JSON。tie-break 全级在场 (同分 + blr 记录 + 板名) — 排序逻辑任何一处
  1630	    变化都会在此翻车。live 现网对比另由验收单探针承担, 本测试是 fixture 级
  1631	    常态门。"""
  1632	    show = subprocess.run(
  1633	        ["git", "-C", str(WT), "show", f"{_BASELINE_SHA}:scripts/daily_review_pick.py"], capture_output=True, text=True
  1634	    )
  1635	    if show.returncode != 0:
  1636	        pytest.skip(f"基线 {_BASELINE_SHA} 不可达 (git show 失败) — live 对比见验收单")
  1637	    head_pick = tmp_path / "head_pick.py"
  1638	    head_pick.write_text(show.stdout, encoding="utf-8")
  1639	    vault, state = _tie_fixture_vault(tmp_path)
  1640	
  1641	    def run(script: Path) -> dict:
  1642	        r = subprocess.run(
  1643	            [
  1644	                sys.executable,
  1645	                str(script),
  1646	                "--vault",
  1647	                str(vault),
  1648	                "--now",
  1649	                "2026-07-30T01:00:00+00:00",
  1650	                "--state",
  1651	                str(state),
  1652	            ],
  1653	            capture_output=True,
  1654	            text=True,
  1655	            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
  1656	        )
  1657	        assert r.returncode == 0, f"{script.name} 退出 {r.returncode}: {r.stderr[-400:]}"
  1658	        return json.loads(r.stdout)
  1659	
  1660	    head_payload, ours_payload = run(head_pick), run(WT / "scripts" / "daily_review_pick.py")
  1661	    # 旧七字段逐行逐字相等 + 板序相等 —— 本卡三件套 (why/minutes/factors)
  1662	    # 只在 ours 里, 不参与对比
  1663	    assert [tb["board"] for tb in head_payload["top_boards"]] == [tb["board"] for tb in ours_payload["top_boards"]], (
  1664	        "板序漂移 — 排序被本卡改动"
  1665	    )
  1666	    for h, o in zip(head_payload["top_boards"], ours_payload["top_boards"]):
  1667	        assert h == {k: o[k] for k in h}, f"{h['board']}: 旧七字段值漂移"
  1668	    # upcoming / due_nodes / boards / buckets 同序同值 (rollup 与分桶也不许动)。
  1669	    # 基线已含 G3-6a (bucket/why_due/buckets 都在), due_nodes 行缺的只有本卡的
  1670	    # idle_days — 把 ours 投影到基线行的键集上逐行比
  1671	    assert head_payload["upcoming"] == ours_payload["upcoming"]
  1672	    assert len(head_payload["due_nodes"]) == len(ours_payload["due_nodes"])
  1673	    for h, r in zip(head_payload["due_nodes"], ours_payload["due_nodes"]):
  1674	        assert h == {k: r[k] for k in h}, f"due_nodes 行 {h['node']}: 旧字段值漂移"
  1675	    assert head_payload["boards"] == ours_payload["boards"]
  1676	    assert head_payload["buckets"] == ours_payload["buckets"]
  1677	    # 且 ours 的确带上了三件套 (对比不是空集对空集)
  1678	    assert all("why_this_board" in tb and "factors" in tb for tb in ours_payload["top_boards"])
  1679	    assert len(ours_payload["top_boards"]) == 3 and ours_payload["truncated"]["top_boards"] is True
  1680	
