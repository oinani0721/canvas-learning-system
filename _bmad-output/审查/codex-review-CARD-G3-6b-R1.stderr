   347	def _sh_local(ts: str):
   348	    """UTC-Z 定长时间串 → Asia/Shanghai aware datetime; 不可表示时 None。
   349	
   350	    ts 已由 scan_nodes 的 fsrs_due 门禁保证形态 (非规范值早被 fail-open
   351	    清空)。年份极值 (9999-12-31T23:59:59Z + 8h) astimezone 会 OverflowError
   352	    — 人话层绝不崩全轮, 交由调用方走兜底文案 / 归 future。
   353	    """
   354	    try:
   355	        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(
   356	            tzinfo=timezone.utc).astimezone(_TZ_SHANGHAI)
   357	    except (ValueError, OverflowError, OSError):
   358	        return None
   359	
   360	
   361	def _today_sh(now: datetime):
   362	    """判桶的「今天」基准 (Asia/Shanghai 日)。
   363	
   364	    极值 now (年份边界) 换算会 OverflowError —— 此处退化为 UTC 日而非崩掉
   365	    整轮 (S3 极值兜底同款诚实降级)。注意: HEAD 起 build_payload 的
   366	    payload["date"] 对同类极值本就会抛 OverflowError, main() 已在入口显式
   367	    拒绝这类 --now; 本兜底是给直接调用 build_payload 的路径留的防线。
   368	
   369	    Codex round-2 MEDIUM: UTC 回退本身也可能溢出 (如 year=1 且 offset=+14,
   370	    换算要减 14 小时 → 年份下溢), 故最后再退一档到 now 自身表示的日期 ——
   371	    该值恒可得, 三档保证本函数永不抛。
   372	    """
   373	    for tz in (_TZ_SHANGHAI, timezone.utc):
   374	        try:
   375	            return now.astimezone(tz).date()
   376	        except (OverflowError, OSError):
   377	            continue
   378	    return now.date()
