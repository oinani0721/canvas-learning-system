   671	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   672	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   673	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   674	        "implementation_sha256": _implementation_sha(),
   675	    }
   676	
   677	
   678	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   679	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   680	    effective = effective_rank_config(decay, version, minutes)
   681	    _warn_recorded_drift(recorded, effective)
   682	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   683	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   684	
   685	
   686	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   687	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   688	
   689	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   690	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   691	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   692	    """
   693	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   694	    overdue_days = None
   695	    if scheduled:
   696	        earliest_sh = _sh_local(min(scheduled))
   697	        if earliest_sh is not None:
   698	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   699	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   700	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   701	
   702	    rec = board_last_recommended.get(board, "")
   703	    gap = None
   704	    if rec:
   705	        try:
   706	            # 不夹负值 (Codex round-1 MEDIUM): 记录晚于今天属异常状态, 如实
   707	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   708	            # 「今天刚推荐过」, 违反 S4 不虚构。
   709	            gap = (today_sh - date.fromisoformat(rec)).days
   710	        except (ValueError, TypeError):
   711	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   712	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   713	            gap = None
   714	    return {
   715	        "due_total": len(due),
   716	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   717	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   718	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   719	        "overdue_days": overdue_days,
   720	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   721	        "never_recommended": not rec,
   722	        "recommend_gap_days": gap,
   723	    }
   724	
   725	
   726	def why_this_board(f: dict) -> str:
   727	    """S4 模板: factors → 恒非空人话串。纯函数 — 同一 factors 恒得同一句。
   728	
   729	    契约测试把落盘的 factors 原样喂回本函数, 要求与落盘的 why_this_board
   730	    逐字相同 —— 解释与数字之间没有第二条通路 (没有 LLM, 没有渲染层再算)。
   731	    """
   732	    scale = f"{int(f['due_total'])} 个节点到期"
   733	    if f["due_new"]:
   734	        scale += f"（其中 {int(f['due_new'])} 张新卡）"
   735	    parts = [scale]
   736	    if f["due_scheduled"]:
   737	        od = f["overdue_days"]
   738	        if od is None:
   739	            parts.append("最早到期时刻超出可显示范围")
   740	        elif od > 0:
   741	            parts.append(f"最早的已逾期 {int(od)} 天")
   742	        else:
   743	            parts.append("最早的今天到期")
   744	    if f["due_malformed"]:
   745	        parts.append(f"含 {int(f['due_malformed'])} 个到期时间无法解析的节点")
   746	    parts.append("最该考的从未考察" if f["idle_days"] is None
   747	                 else f"最该考的已闲置 {int(f['idle_days'])} 天")
   748	    if f["never_recommended"]:
   749	        parts.append("这块板从未被推荐过")
   750	    elif f["recommend_gap_days"] is None:
   751	        parts.append("上次推荐日期无法解析")
   752	    elif f["recommend_gap_days"] < 0:
   753	        # 记录晚于今天 (时钟回拨/时区错乱/手滑改了 state) — 如实说异常,
   754	        # 不 clamp 成 0 伪装成"今天刚推荐过" (Codex round-1 MEDIUM)
   755	        parts.append("上次推荐日期晚于今天")
   756	    elif f["recommend_gap_days"] == 0:
   757	        parts.append("今天已推荐过")
   758	    else:
   759	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   760	    return " · ".join(parts)
   761	
   762	
   763	def estimated_minutes(f: dict, minutes: dict) -> int:
   764	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   765	
   766	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   767	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   768	    """
   769	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   770	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
   771	
   772	
   773	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   774	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   775	
   776	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   777	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   778	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   779	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   780	    """
   781	    minutes = minutes or DEFAULT_MINUTES
   782	    today_sh = _today_sh(now)
   783	    boards: dict[str, list] = {}
   784	    unassigned = []
   785	    for n in nodes:
   786	        if not n["board"]:
   787	            unassigned.append(n["node"])
   788	            continue
   789	        boards.setdefault(n["board"], []).append(n)
   790	
   791	    ranked, upcoming = [], []
   792	    for board, members in boards.items():
   793	        due = [n for n in members if n["due_now"]]
   794	        if not due:
   795	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   796	            nxt = min(members, key=lambda n: n["fsrs_due"])
   797	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   798	            continue
   799	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   800	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   801	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   802	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   803	        tie_parts = {
   804	            "priority_pick": round(top["pick"], TIE_PICK_ROUND_DIGITS),
   805	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   806	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   807	            "board": board,
   808	        }
   809	        ranked.append({
   810	            "board": board,
   811	            "top_node": top["node"],
   812	            "priority": round(top["pick"], 4),
   813	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   814	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   815	            "difficulty": top["difficulty"],
   816	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   817	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   818	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   819	            "why_this_board": why_this_board(factors),
   820	            "estimated_minutes": estimated_minutes(factors, minutes),
   821	            "factors": factors,
   822	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   823	        })
   824	    ranked.sort(key=lambda r: r["_tie"])
   825	    for r in ranked:
   826	        del r["_tie"]
   827	    upcoming.sort(key=lambda u: u["next_due"])
   828	    return ranked, upcoming, unassigned
   829	
   830	
   831	def _title(board: str) -> str:
   832	    prefix = "📚 今日复习 · "
   833	    room = TITLE_LIMIT - len(prefix)
   834	    return prefix + (board if len(board) <= room else board[: room - 1] + "…")
   835	
   836	
   837	def _body(top: dict) -> str:
   838	    idle = "从未考察" if top["idle_days"] is None else f"已闲置 {top['idle_days']} 天"
   839	    if top["pending"] >= 2:
   840	        return f"{top['top_node']} 等 {top['pending']} 节点待巩固 · {idle}"
   841	    return f"{top['top_node']} 待巩固 · {idle}"
   842	
   843	
