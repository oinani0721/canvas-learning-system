     # 同一实现的指纹可由任意路径副本复算 (摘的是字节不是身份)
     twin = tmp_path / "twin_pick.py"
     twin.write_bytes((WT / "scripts" / "daily_review_pick.py").read_bytes())
     assert picker._implementation_sha(twin) == cfg["implementation_sha256"]
