   631	def _implementation_sha(path=None) -> str:
   632	    """S5 本生成器源码的实现指纹 (Codex round-2 HIGH)。
   633	
   634	    因子清单/精度常量只能覆盖「登记过的配置面」, 覆不完取值绑定这类字面
   635	    代码 —— 把 pick.py 自身字节也摘进指纹。
   636	
   637	    ⚠ 保证的精确边界 (CARD-G3-6b-R1 收窄: 原措辞"任何排序规则改动必然变
   638	    sha"宽于可证面, 与 round-3 实测反例冲突):
   639	
   640	    1. 摘的是**本 .py 源文件的字节**。改源文件 (精度/绑定/方向/新因子, 乃至
   641	       一个注释) 必变 sha —— 这正是本卡针对的「善意配置/代码演进无痕漂移」。
   642	       粒度因此从「系数」变粗为「实现+系数」, 属预期内的保守取舍。
   643	    2. **单向保证**: 排序规则变 ⟹ sha 变。逆命题不成立, 且是刻意放弃的 ——
   644	       摘全文件使指纹对注释也敏感; 追加重复因子键同样「sha 变而排序不变」
   645	       (Codex round-2 LOW 的实测方向)。不可拿 sha 变没变去推断「改了什么」,
   646	       它只证明「变了」。
   647	    3. **不覆盖运行时字节码**: 绕过 .py 直接执行被改的 __pycache__/*.pyc
   648	       (伪造 mtime 使 Python 取旧 pyc) 可让排序变而本 sha 不变 —— round-3
   649	       已实测复现。该面属主动篡改运行时的威胁模型, 明确排除在本卡之外;
   650	       本函数**不宣称运行时完整性** (见验收单「本卡未证明什么」第 4 条)。
   651	    """
   652	    p = Path(path) if path is not None else Path(__file__).resolve()
   653	    return hashlib.sha256(p.read_bytes()).hexdigest()
   654	
   655	
   656	def effective_rank_config(decay, version, minutes: dict) -> dict:
   657	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   658	
   659	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   660	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   661	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   662	    该变), 上限与因子序/取整精度取代码常量, 分钟取 manifest 生效值,
   663	    implementation_sha256 摘本文件字节 (round-2 HIGH: 取值绑定无法全部
   664	    数据化, 由实现指纹兜住「改**源文件**规则而指纹不动」—— 其单向性与
   665	    不覆盖运行时 .pyc 的边界见 _implementation_sha 的三条声明)。
   666	    """
   667	    return {
   668	        "version": version,
   669	        "ranking_factors": list(TIE_FACTOR_KEYS),
   670	        "tie_pick_round_digits": int(TIE_PICK_ROUND_DIGITS),
   671	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   672	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   673	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   674	        "implementation_sha256": _implementation_sha(),
   675	    }
   676	
