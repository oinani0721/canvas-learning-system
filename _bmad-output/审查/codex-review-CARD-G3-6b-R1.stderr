   404	def assign_bucket(n: dict, now: datetime) -> tuple[str, str]:
   405	    """S1 级联判桶 + S3 模板生成 → (bucket, why_due)。
   406	
   407	    调用前提: n 已归板 (划分域)。级联顺序即 BUCKET_ORDER — 先匹配先归,
   408	    因此每个域内节点恰好落一桶 (互斥), 且 due_now 布尔二分被五桶穷尽
   409	    (完备)。why_due 恒非空。
   410	    """
   411	    today_sh = _today_sh(now)
   412	    idle = _idle_cn(n["idle_days"])
   413	    if n["due_now"]:
   414	        if not n["fsrs_due"] and not n["due_fail_open"]:
   415	            return BUCKET_NEW, f"新卡未排期，视同即刻到期 · {idle}"
   416	        if n["fsrs_state"] in LEARNING_STATES:
   417	            phase = "重学中" if n["fsrs_state"] == 3 else "学习中"
   418	            return BUCKET_LEARNING, f"{phase} · {_overdue_cn(n, today_sh)} · {idle}"
   419	        return BUCKET_DUE_NOW, f"到期待复习 · {_overdue_cn(n, today_sh)} · {idle}"
   420	    # 未到期两桶: fsrs_due 恒为规范非空串 (空串必定 due_now)
   421	    due_sh = _sh_local(n["fsrs_due"])
   422	    if due_sh is None:
   423	        # 不可表示 = 年份极值远期, 定义上不可能是"今天" → future 兜底
   424	        return BUCKET_FUTURE, "到期时刻超出可显示范围，按未来排期处理"
   425	    delta = (due_sh.date() - today_sh).days
   426	    if delta == 0:
   427	        return BUCKET_DUE_TODAY, f"今天 {due_sh:%H:%M} 到期（尚未到点）"
   428	    when = "明天" if delta == 1 else f"{delta} 天后"
   429	    return BUCKET_FUTURE, f"{when} {due_sh.month}月{due_sh.day}日 {due_sh:%H:%M} 到期"
