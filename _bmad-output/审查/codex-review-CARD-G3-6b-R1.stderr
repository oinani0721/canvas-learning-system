   391	def _overdue_cn(n: dict, today_sh) -> str:
   392	    """S3 到期片段 (仅已到期节点)。脏日期如实点名原值摘录, 不装能解析。"""
   393	    if n["due_fail_open"]:
   394	        return f"到期时间无法解析({_safe_raw(n['fsrs_due_raw'])})，保守视同到期"
   395	    due_sh = _sh_local(n["fsrs_due"])
   396	    if due_sh is None:
   397	        return "到期时刻超出可显示范围"
   398	    delta = (due_sh.date() - today_sh).days
   399	    if delta < 0:
   400	        return f"已逾期 {-delta} 天（{due_sh.month}月{due_sh.day}日到期）"
   401	    return f"今天 {due_sh:%H:%M} 到期"
