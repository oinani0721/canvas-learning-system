   307	def _aware(s: str) -> datetime:
   308	    dt = datetime.fromisoformat(str(s).strip().replace("Z", "+00:00"))
   309	    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
   310	
   311	
   312	def _fm_num(fm: str, key: str):
   313	    # 容负号 (Code-Review L5): mastery_a: -3 应进 corrupt 分支而非静默当无字段
   314	    m = re.search(rf'^{key}:\s*"?(-?[0-9]*\.?[0-9]+)"?\s*$', fm, re.M)
   315	    return float(m.group(1)) if m else None
   316	
   317	
   318	def _fm_str(fm: str, key: str):
   319	    m = re.search(rf'^{key}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   320	    return m.group(1).strip() if m else None
   321	
