   536	    assert run_cli(vault, out).returncode == 0
   537	    it = load_json(out)["items"][0]
   538	    assert it["criterion"] == "C4_exact_duplicate"
   539	    assert it["verdict"] == "建议删"
   540	    assert len(it["exact_duplicate_others"]) == 1
   541	    assert any(c["kind"] == "multiple_canonical_candidates" for c in it["conflicts"])
   542	    assert "不可判" in it["basis"]
