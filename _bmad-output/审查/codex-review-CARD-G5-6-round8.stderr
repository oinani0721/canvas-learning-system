  1845	def test_frontmatter_map_value_fidelity():
  1846	    """⛔ round-3 自审 GATE-1/H3-3: _FM_KEY_RE 的**值提取**半边此前无任何门锁 ——
  1847	    回退旧正则 63 条照样全绿。本门锁三个行为: 值含冒号的键完整保留 /
  1848	    冒号前空格的键被解析 / 冒号后无空格仍不认键 (值不吞 URL)。"""
  1849	    mod = load_module()
  1850	    fm = mod.frontmatter_map(["created: 2026-01-01T00:00:00+08:00"])
  1851	    assert fm["created"] == "2026-01-01T00:00:00+08:00", "值里的冒号不得截断值"
  1852	    fm = mod.frontmatter_map(["title : x"])
  1853	    assert fm["title"] == "x", "冒号前空格的键 (pyyaml 认) 必须解析出值"
  1854	    fm = mod.frontmatter_map(["source:https://x"])
  1855	    assert "source" not in fm, "冒号后无空格不认键, URL 不得被吞成值"

