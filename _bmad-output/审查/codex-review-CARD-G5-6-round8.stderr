   366	def _is_primary_source_url(src: str) -> bool:
   367	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   368	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   369	    if not _URL_RE.match(src):
   370	        return False
   371	    try:
   372	        parts = urlsplit(src)
   373	    except ValueError:
   374	        return False
   375	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   376	
   377	
   378	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
