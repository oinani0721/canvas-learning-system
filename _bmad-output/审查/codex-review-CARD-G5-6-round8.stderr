   650	def test_no_destructive_nomination_without_mechanical_evidence(tmp_path):
   651	    """全局不变式: 建议删 ⟸ 只能来自 C3(空/骨架) 或 C4(精确重复且给出正本)。"""
   652	    vault, out = base_vault(tmp_path)
   653	    inbox = vault / "_待处理"
   654	    body = "库内已有的一段正文。\n第二行。\n"
   655	    mk(vault / "节点" / "正本.md", body, age_days=40)
   656	    mk(inbox / "空的.md", "", age_days=9)
   657	    mk(inbox / "骨架.md", "# 只有标题\n\n## 二级\n", age_days=8)
   658	    mk(inbox / "重复的.md", body, age_days=7)
   659	    mk(inbox / "普通的.md", "# 普通\n\n一些内容。\n再一行。\n", age_days=6)
   660	    lines = [f"共同第 {i} 行。" for i in range(1, 41)]
   661	    mk(vault / "节点" / "长正本.md", "\n".join(lines) + "\n", age_days=40)
   662	    mutated = list(lines)
   663	    mutated[3] = "这一行被改了。"
   664	    mk(inbox / "近似的.md", "\n".join(mutated) + "\n", age_days=5)
   665	
   666	    assert run_cli(vault, out).returncode == 0
   667	    items = load_json(out)["items"]
   668	    assert items, "items 为空时本门条件循环恒真 = 假绿 (round-4 MEDIUM)"
   669	    for it in items:
   670	        if it["verdict"] == "建议删":
   671	            assert it["criterion"] in ("C3_empty_or_skeleton", "C4_exact_duplicate")
   672	            if it["criterion"] == "C4_exact_duplicate":
   673	                assert it["exact_duplicate_of"], "建议删(重复) 必须指出正本在哪"
   674	        if it["confident"] is False:
   675	            assert it["verdict"] == "拿不准"
