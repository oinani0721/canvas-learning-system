   245	+        # 负例必须同时钉住「没有被破坏性提名」
   246	+        assert it["verdict"] != "建议删", name
   247	+        assert it["confident"] is False, name
   248	+        assert it["target_hint"] is None and it["nomination_type"] is None, name
   249	+    tail = item_by_name(data, "行尾自述.md")
   250	+    assert tail["criterion"] == "C2_ai_self_declared"
   251	+    assert "第 3 行" in tail["basis"], f"依据必须带行号: {tail['basis']}"
   252	+    punct = item_by_name(data, "标点自述.md")
   253	+    assert punct["criterion"] == "C2_ai_self_declared"
   254	+    assert "由 AI 生成" in punct["basis"], f"依据必须带逐字片段: {punct['basis']}"
   255	+    en = item_by_name(data, "英文句点自述.md")
