   664	
   665	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   666	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   667	
   668	#: ⛔ 护栏级 AI 信号（结构性，不依赖枚举表）：文本含独立「AI」字样即算嫌疑。
   669	#: 「独立」= 左右都**不是 ASCII 字母**（`\bAI\b` 在 CJK 邻接时无词边界 ——
   670	#: round-7 BLOCKER-1：`由AI系统生成` 曾穿透）。有限标记表无论怎么扩都追不上
   671	#: 自然语言的肯定式声明（round-6 BLOCKER-1：`This report was generated by an
   672	#: AI system` 不含任何表项，双层全盲，无正文时掉进 C3 建议删）。本信号只降
   673	#: C6 不裁决 —— C2 确定命中仍走有限表 + 边界规则（宽匹配会给话题提及发确定
   674	#: 归档，那是硬猜）。
   675	_AI_WORD_RE = re.compile(r"(?<![A-Za-z])AI(?![A-Za-z])", re.IGNORECASE)
   676	
