  1403	def build_preview(
  1404	    vault: Path,
  1405	    inbox: Path,
  1406	    inbox_exists: bool,
  1407	    now: datetime,
  1408	    batch_size: int,
  1409	    excluded_roots: list[str],
  1410	) -> dict:
  1411	    now_s = _epoch_s(now)
  1412	    items_raw, skipped = list_inbox(inbox, now_s) if inbox_exists else ([], [])
  1413	    total = len(items_raw)
  1414	    batch_raw = items_raw[:batch_size]
  1415	    deferred = [
  1416	        {
  1417	            "name": it["name"],
  1418	            "age_days": it["age_days"],
  1419	            "mtime_local": it["mtime_local"],
  1420	        }
  1421	        for it in items_raw[batch_size:]
  1422	    ]
  1423	
  1424	    dup_index, corpus_bodies, corpus_stats = scan_corpus(vault, excluded_roots)
  1425	    scan = {
  1426	        "ratio_threshold": NEAR_DUP_RATIO,
  1427	        "body_char_cap": NEAR_DUP_BODY_CHAR_CAP,
  1428	        "length_prefilter_ratio": NEAR_DUP_LEN_RATIO,
  1429	        "top_n_reported": NEAR_DUP_TOP_N,
  1430	        "compared_pairs": 0,
  1431	        "skipped_oversize": 0,
  1432	        "skipped_length_prefilter": 0,
  1433	        "note": "「跳过」≠「无重复」：跳过的对从未比对过，产物如实分列两个计数。",
  1434	    }
  1435	
  1436	    texts = {it["rel_path"]: read_text_or_none(Path(it["_path"])) for it in batch_raw}
  1437	    batch_body_counts: dict[str, int] = {}
  1438	    for it in batch_raw:
  1439	        t = texts[it["rel_path"]]
  1440	        if t is None:
  1441	            continue
  1442	        b = dup_body(t) if has_substantive_content(t) else ""
  1443	        if b:
  1444	            batch_body_counts[b] = batch_body_counts.get(b, 0) + 1
  1445	
  1446	    items: list[dict] = []
  1447	    for idx, it in enumerate(batch_raw, start=1):
  1448	        text = texts[it["rel_path"]]
  1449	        base = {k: v for k, v in it.items() if not k.startswith("_")}
  1450	        base["index"] = idx
  1451	        base["text_readable"] = text is not None
  1452	        items.append(
  1453	            nominate(base, text, dup_index, corpus_bodies, scan, batch_body_counts)
  1454	        )
  1455	
  1456	    data = {
  1457	        "schema_version": SCHEMA_VERSION,
  1458	        "generator": GENERATOR,
  1459	        "id_namespace": INBOX_ID_NAMESPACE,
  1460	        "id_stability": ID_STABILITY,
  1461	        "vault_fingerprint": "vf1-"
  1462	        + hashlib.sha256(os.path.realpath(vault).encode("utf-8")).hexdigest()[:16],
  1463	        "now": now.isoformat(),
  1464	        "now_utc": fmt_utc(now_s),
  1465	        "now_local": fmt_local(now_s),
  1466	        "inbox_dir": f"{inbox.name}/",
  1467	        "inbox_exists": inbox_exists,
  1468	        "label": inbox.name,
  1469	        "criteria_order": list(CRITERIA_ORDER),
  1470	        "verdict_vocabulary": VERDICT_VOCABULARY,
  1471	        "corpus": corpus_stats,
  1472	        "inventory": {
  1473	            "total": total,
  1474	            "batch_size": batch_size,
  1475	            "batch_max": BATCH_MAX,
  1476	            "batch_rule": "最旧优先（mtime 升序，同 mtime 按文件名升序），"
  1477	            f"单批上限 {BATCH_MAX} 件（D15 确认预算：一次性 >20 项完成率趋近 0）",
  1478	            "over_budget": total > batch_size,
  1479	            "deferred": deferred,
  1480	            "skipped": skipped,
  1481	        },
  1482	        "items": items,
  1483	        "sleeping": build_sleeping(inbox, now_s, inbox_exists),
  1484	        "near_dup_scan": scan,
  1485	        "last_cleanup": None,
  1486	        "last_cleanup_note": LAST_CLEANUP_NOTE,
  1487	        "not_executed_disclaimer": NOT_EXECUTED,
  1488	    }
  1489	    data["receipt"] = build_receipt(data)
  1490	    return data
