   413	def days_between(now_s: float, then_s: float) -> int:
   414	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   415	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   416	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   417	    return int(round(now_s - then_s)) // 86400
   418	
   419	
   420	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   421	UNREPRESENTABLE = "unrepresentable"
   422	
   423	
   424	def _fmt(sec: float, tz, pattern: str) -> str:
   425	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   426	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   427	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   428	    **不**伪造一个看似正常的时间。"""
   429	    try:
   430	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   431	    except (OverflowError, OSError, ValueError):
   432	        return UNREPRESENTABLE
   433	
   434	
   435	def fmt_utc(sec: float) -> str:
   436	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   437	
   438	
   439	def fmt_local(sec: float) -> str:
   440	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
