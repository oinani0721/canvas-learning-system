  1773	def test_cjk_adjacent_ai_is_undigested_signal(tmp_path):
  1774	    """⛔ round-7 BLOCKER-1: CJK 邻接的 AI 字样没有 Unicode 词边界 ——
  1775	    `由AI系统生成` 曾穿透 \\bAI\\b 信号与有限表。词判定改「左右非 ASCII 字母」。"""
