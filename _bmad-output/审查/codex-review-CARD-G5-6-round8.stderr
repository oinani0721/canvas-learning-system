   239	        '_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:\\s|$)")',
   240	        '_HEADING_RE = re.compile(r"^\\s{0,3}#{1,6}(?:\\s|$)")',
   241	        "test_tab_and_nbsp_indented_heading_is_content",
   242	    ),
   243	    (
   244	        "M30-来源值收回前缀判定(YAML标签/MD链接再穿透)",
   245	        '        t = v.casefold()\n        return "http://" in t or "https://" in t',
   246	        '        t = v.strip()\n        if t.startswith("<") and t.endswith(">"):\n            t = t[1:-1].strip()\n        return t.casefold().startswith(("http://", "https://"))',
   247	        "test_wrapped_url_values_are_undigested_signals",
   248	    ),
   249	]
   250	
   251	
   252	def run_gate(gate: str) -> subprocess.CompletedProcess:
   253	    return subprocess.run(
   254	        [
   255	            str(WT / "backend/.venv/bin/pytest"),
   256	            f"{TESTFILE}::{gate}",
   257	            "-q",
   258	            "-p",
   259	            "no:cacheprovider",
   260	        ],
   261	        cwd=WT / "backend",
   262	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   263	        capture_output=True,
   264	        text=True,
   265	    )
   266	
   267	
   268	def main() -> int:
   269	    pristine = SCRIPT.read_bytes()
   270	    BACKUP.write_bytes(pristine)
   271	    results = []
   272	    ok = True
   273	    for name, old, new, gate in MUTATIONS:
   274	        content = SCRIPT.read_text(encoding="utf-8")
   275	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   276	        mutated = content.replace(old, new, 1)
   277	        if name.startswith("M7"):
   278	            m7b_old = "url_bearing_keys = [k for k, v in fm.items() if v and _looks_like_source_value(v)]"
   279	            assert m7b_old in mutated, "M7: 信号③b 原串不在场"
   280	            mutated = mutated.replace(m7b_old, "url_bearing_keys = []", 1)
   281	        if name.startswith(("M17", "M19")):
   282	            m6_old = "        if ai_word_hit:"
   283	            assert m6_old in mutated, f"{name}: 信号⑥原串不在场"
   284	            mutated = mutated.replace(m6_old, "        if False and ai_word_hit:", 1)
   285	        if name.startswith("M5"):
   286	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   287	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   288	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   289	            mutated = mutated.replace(looks_old, looks_rev, 1)
   290	        assert mutated != content, f"{name}: 替换后内容未变化"
   291	        SCRIPT.write_text(mutated, encoding="utf-8")
   292	        try:
   293	            r = run_gate(gate)
   294	            out = r.stdout + r.stderr
   295	            failed_marker = f"FAILED {TESTFILE}::{gate}"
   296	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   297	            results.append((name, gate, r.returncode, killed))
   298	            if not killed:
   299	                ok = False
   300	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   301	                print(out[-1500:])
   302	        finally:
   303	            SCRIPT.write_bytes(pristine)
   304	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   305	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   306	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   307	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
   308	    print()
   309	    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
   310	          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
   311	    return 0 if ok else 1
   312	
   313	
   314	if __name__ == "__main__":
   315	    sys.exit(main())
