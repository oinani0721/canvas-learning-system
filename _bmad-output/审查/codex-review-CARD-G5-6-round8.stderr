   599	def has_substantive_content(text: str) -> bool:
   600	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   601	
   602	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   603	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   604	    合用一个函数正是 Codex BLOCKER 的根因。
   605	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   606	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   607	    （round-3 自审 B3-3）。
   608	    """
   609	    for ln, kind in _classify_lines_typed(text)[0]:
   610	        if kind == "code":
   611	            if ln.strip():
   612	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   613	            continue
   614	        if kind == "fence":
   615	            continue
   616	        if _HEADING_RE.match(ln):
   617	            continue
   618	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   619	        if t and not _ONLY_STRUCT_RE.match(t):
   620	            return True
   621	    return False
