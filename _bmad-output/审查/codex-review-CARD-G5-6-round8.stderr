   758	def test_local_timezone_is_fixed_offset_not_tzdata_dependent(tmp_path):
   759	    """人话时区必须是固定 +08:00: ZoneInfo 会给 1986-1991 套夏令时(实测 1988-07-01
   760	    → +09:00), 于是同一份输入在装/不装 tzdata 的两台机器上产出不同字节 ——
   761	    「二跑逐字节相等」就只在同一台机器上成立, 那不叫确定性。"""
   762	    mod = load_module()
   763	    for y in (1988, 2026):
   764	        assert mod._TZ_SHANGHAI.utcoffset(datetime(y, 7, 1)) == timedelta(hours=8)
   765	
