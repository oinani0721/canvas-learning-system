  1818	def test_wrapped_url_values_are_undigested_signals(tmp_path):
  1819	    """⛔ round-7 BLOCKER-3: 来源值判定必须 substring 级 —— YAML 标签
  1820	    (`!!str https://…`) 与引号包 Markdown 链接 (`"[来源](https://…)") 曾因
  1821	    前缀判定穿透。值内任意位置含 http(s):// 即算来源声明。"""
  1822	    vault, out = base_vault(tmp_path)
  1823	    inbox = vault / "_待处理"
  1824	    mk(inbox / "yaml标签URL.md", "---\nURL: !!str https://example.test/x\n---\n", age_days=6)
  1825	    mk(
  1826	        inbox / "md链接URL.md",
  1827	        '---\nURL: "[来源](https://example.test/x)"\n---\n',
  1828	        age_days=5,
  1829	    )
  1830	    # 正向对照: 值不含 http(s):// 的键 → 纯空骨架仍 C3
  1831	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1832	
  1833	    assert run_cli(vault, out).returncode == 0
  1834	    data = load_json(out)
  1835	    for name in ("yaml标签URL.md", "md链接URL.md"):
  1836	        it = item_by_name(data, name)
  1837	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1838	        assert it["criterion"] == "C6_undecided", name
  1839	        assert "example.test" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1840	    skeleton = item_by_name(data, "纯空骨架.md")
  1841	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1842	    assert skeleton["verdict"] == "建议删"
