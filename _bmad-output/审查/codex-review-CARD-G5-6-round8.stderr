   319	
   320	#: 标签（= 收件箱目录 basename，进产物文件名）的非法字符类。
   321	#: ⛔ 与 split_preview._BAD_NAME **逐字同源**：该常量为私有，故此处平行定义，
   322	#: 由裁判 `test_reuses_split_preview_helpers_by_import` 断言两者 pattern 逐字相等，
   323	#: 防「两套判据各自漂移」。
   324	_BAD_LABEL = re.compile(r'[\\/`$"\']|\.\.|^\.|[\x00-\x1f]')
   325	
   326	#: 人话时区：**固定 +08:00**，刻意不走 `ZoneInfo("Asia/Shanghai")`。
   327	#: ⛔ 理由是本卡有「二跑逐字节相等」硬门，而该门必须**跨宿主**成立：ZoneInfo 在装了
   328	#: tzdata 的机器上会给 1986-1991 年的日期套上夏令时（实测 1988-07-01 → +09:00），
   329	#: 没装 tzdata 的机器退化成 +08:00 —— 同一份输入在两台机器产出不同字节。
   330	#: 代价是那六年的历史时刻不带夏令时；收件箱材料不可能有 1980 年代的 mtime，
   331	#: 拿一个不可能发生的历史精度去换一个每次都要成立的确定性，是划算的。
   332	#: （与 `scripts/daily_review_pick.py` 优先 ZoneInfo 的口径有意分歧，理由如上。）
   333	_TZ_SHANGHAI = timezone(timedelta(hours=8))
   334	
   335	#: ATX 标题：**最多 3 个字面空格**缩进（⛔ 与 _FENCE_RE 同口径，\s 会放行
   336	#: 制表符/NBSP —— `\t# keep` 是缩进代码、`\xa0# keep` 是普通正文，都曾被当
   337	#: 标题剥掉 → 空骨架建议删，round-7 BLOCKER-2）。
   338	_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:\s|$)")
   339	_LIST_PREFIX_RE = re.compile(r"^\s*(?:[-*+]\s+|\d{1,3}[.)]\s+|>\s?)+")
   340	#: 纯结构行（分隔线 / 表格分隔 / 空列表符）。⛔ 不含 `~`：`~~~` 是代码围栏标记，
   341	#: 由 `_classify_lines` 的状态机处理；把它当"结构"曾让整段围栏代码凭空消失。
   342	_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
   343	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   344	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   345	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   346	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   347	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   348	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   349	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   350	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   351	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   352	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   353	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   354	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   355	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   356	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   357	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   358	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   359	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   360	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   361	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   362	#: 里仍保留作防御深度。
   363	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
