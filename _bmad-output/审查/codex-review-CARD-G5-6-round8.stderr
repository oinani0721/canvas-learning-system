  1221	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1222	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1223	    items: list[dict] = []
  1224	    skipped: list[dict] = []
  1225	    with os.scandir(inbox) as it:
  1226	        entries = sorted(it, key=lambda e: e.name)
  1227	    for entry in entries:
  1228	        p = Path(entry.path)
  1229	        if entry.is_symlink():
  1230	            skipped.append(
  1231	                {
  1232	                    "name": entry.name,
  1233	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1234	                }
  1235	            )
  1236	            continue
  1237	        if entry.is_dir():
  1238	            if entry.name == SLEEPING_DIR_NAME:
  1239	                continue  # 走 Sleeping 台账
  1240	            skipped.append(
  1241	                {
  1242	                    "name": entry.name,
  1243	                    "reason": "子目录不在本卡盘点范围（只盘点顶层文件与 Sleeping/ 台账）",
  1244	                }
  1245	            )
  1246	            continue
  1247	        if not entry.is_file():
  1248	            # FIFO / 设备 / 套接字：read_bytes 可能直接阻塞，绝不碰
  1249	            skipped.append(
  1250	                {
  1251	                    "name": entry.name,
  1252	                    "reason": "不是普通文件（FIFO / 设备 / 套接字等），不读取",
  1253	                }
  1254	            )
  1255	            continue
  1256	        try:
  1257	            st = p.stat()
  1258	        except OSError as e:
  1259	            # 扫目录与取属性之间材料被移走 —— 跳过留痕, 不让一次竞态崩掉整份 preview
  1260	            skipped.append(
  1261	                {
  1262	                    "name": entry.name,
  1263	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1264	                }
  1265	            )
  1266	            continue
  1267	        items.append(
  1268	            {
  1269	                "stable_id": compute_inbox_stable_id(
  1270	                    f"{nfc(inbox.name)}/{nfc(entry.name)}"
  1271	                ),
  1272	                "name": entry.name,
  1273	                "rel_path": f"{inbox.name}/{entry.name}",
  1274	                "size_bytes": st.st_size,
  1275	                "mtime_utc": fmt_utc(st.st_mtime),
  1276	                "mtime_local": fmt_local(st.st_mtime),
  1277	                "age_days": days_between(now_s, st.st_mtime),
  1278	                # 排序用纳秒整数（float 秒会把相差 1ns 的两件折叠成相等，
  1279	                # 于是"最旧优先"退化成按文件名 —— Codex LOW 实证）
  1280	                "_mtime_ns": st.st_mtime_ns,
  1281	                "_path": str(p),
  1282	            }
  1283	        )
  1284	    # 最旧优先；同 mtime 按名字升序 —— 二跑同序的唯一保证
  1285	    items.sort(key=lambda d: (d["_mtime_ns"], d["name"]))
  1286	    return items, skipped
  1287	
  1288	
  1289	def build_sleeping(inbox: Path, now_s: float, exists: bool) -> dict:
  1290	    d = inbox / SLEEPING_DIR_NAME
  1291	    if not exists or not d.is_dir() or d.is_symlink():
  1292	        return {
  1293	            "dir": f"{inbox.name}/{SLEEPING_DIR_NAME}",
  1294	            "exists": False,
  1295	            "count": 0,
  1296	            "oldest_days": None,
  1297	            "over_30d_count": 0,
  1298	            "alert_threshold_days": SLEEP_ALERT_DAYS,
  1299	            "items": [],
  1300	            "skipped": [],
  1301	        }
  1302	    out: list[dict] = []
  1303	    skipped: list[dict] = []
  1304	    with os.scandir(d) as it:
  1305	        entries = sorted(it, key=lambda e: e.name)
  1306	    for entry in entries:
  1307	        # ⛔ 与收件箱同一条纪律：跳过必须留痕，不静默消失。
  1308	        if entry.is_symlink():
  1309	            skipped.append({"name": entry.name, "reason": "条目是 symlink，不跟随"})
  1310	            continue
  1311	        if entry.is_dir():
  1312	            skipped.append(
  1313	                {"name": entry.name, "reason": "Sleeping/ 下的子目录不计入台账"}
  1314	            )
  1315	            continue
  1316	        p = Path(entry.path)
  1317	        try:
  1318	            st = p.stat()
  1319	        except OSError as e:
  1320	            skipped.append(
  1321	                {
  1322	                    "name": entry.name,
  1323	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1324	                }
  1325	            )
  1326	            continue
  1327	        source, slept_at, days = (
  1328	            "mtime",
  1329	            fmt_utc(st.st_mtime),
  1330	            days_between(now_s, st.st_mtime),
  1331	        )
  1332	        text = read_text_or_none(p)
  1333	        if text is not None:
  1334	            raw = frontmatter_map(split_frontmatter(text)[0]).get("slept_at", "")
  1335	            parsed = _parse_slept_at(raw)
  1336	            if parsed is not None:
  1337	                source, slept_at = "frontmatter", raw
  1338	                days = days_between(now_s, _epoch_s(parsed))
  1339	            elif raw:
  1340	                source = "mtime(frontmatter slept_at 不可解析，如实退回文件 mtime)"
  1341	        out.append(
  1342	            {
  1343	                "name": entry.name,
  1344	                "slept_at": slept_at,
  1345	                "slept_at_source": source,
  1346	                "slept_days": days,
  1347	                "over_30d": days >= SLEEP_ALERT_DAYS,
  1348	            }
  1349	        )
  1350	    out.sort(key=lambda x: (-x["slept_days"], x["name"]))
  1351	    return {
  1352	        "dir": f"{inbox.name}/{SLEEPING_DIR_NAME}",
  1353	        "exists": True,
  1354	        "count": len(out),
  1355	        "oldest_days": max((x["slept_days"] for x in out), default=None),
  1356	        "over_30d_count": sum(1 for x in out if x["over_30d"]),
  1357	        "alert_threshold_days": SLEEP_ALERT_DAYS,
  1358	        "items": out,
  1359	        "skipped": skipped,
  1360	    }
  1361	
  1362	
  1363	def _parse_slept_at(raw: str) -> datetime | None:
  1364	    if not raw:
  1365	        return None
  1366	    try:
  1367	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  1368	    except ValueError:
  1369	        try:
  1370	            d = date.fromisoformat(raw)
  1371	        except ValueError:
  1372	            return None
  1373	        dt = datetime(d.year, d.month, d.day)
  1374	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
