   481	def frontmatter_map(fm_lines: list[str]) -> dict:
   482	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   483	    out: dict[str, str] = {}
   484	    for ln in fm_lines:
   485	        m = _FM_KEY_RE.match(ln)
   486	        if not m:
   487	            continue
   488	        val = (m.group(2) or "").strip()
   489	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   490	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   491	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   492	        val = re.sub(r"\s+#.*$", "", val).strip()
   493	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   494	            val = val[1:-1]
   495	        out.setdefault(m.group(1), val)
   496	    return out
