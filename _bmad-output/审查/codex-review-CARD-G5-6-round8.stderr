  1090	                V_UNSURE,
  1091	                None,
  1092	                None,
  1093	                "无机械判据可施加",
  1094	                False,
  1095	                uncertain_reason=(
  1096	                    f"{signal}；且正文与 {exact_of} 逐字相同 —— 但「整个文件"
  1097	                    "多余」只有正文证据支撑，上述信号未消化，删不删由你定"
  1098	                ),
  1099	                ask=UNDECIDED_ASK,
  1100	            )
  1101	        if fm:
  1102	            # ⛔ round-5 自审：C4 的正文证据不覆盖 frontmatter 元数据（tags/created
  1103	            # 等引擎不消费的键）。不降级（重复多余性成立），但元数据存在必须留痕
  1104	            # —— 删除是不可逆执行，痕迹是人的最后一道核对面。
  1105	            conflicts.append(
  1106	                {
  1107	                    "kind": "frontmatter_metadata_present",
  1108	                    "detail": "本件 frontmatter 还带有元数据键（"
  1109	                    + "、".join(sorted(fm))
  1110	                    + "），正文重复证据不覆盖它们 —— 执行删除前请过目",
  1111	                }
  1112	            )
  1113	        if exact_others:
  1114	            basis = (
  1115	                f"库内已有 {len(exact_all)} 份正文逐字相同的文件："
  1116	                + "、".join(exact_all)
  1117	                + "。⛔ 哪一份算「正本」不可判（无机械依据），"
  1118	                "但收件箱这份相对它们是多余的，故仍建议删"
  1119	            )
  1120	            conflicts.append(
  1121	                {
  1122	                    "kind": "multiple_canonical_candidates",
  1123	                    "detail": f"库内有 {len(exact_all)} 份同正文文件，"
  1124	                    f"`exact_duplicate_of` 取相对路径字典序最小者仅为**可预测的代表**，"
  1125	                    "不主张它比其余几份更正本",
  1126	                }
  1127	            )
  1128	        else:
  1129	            basis = f"归一化正文与 {exact_of} 逐字相等（sha256 相同）"
  1130	        return finish("C4_exact_duplicate", V_DELETE, None, None, basis, True)
  1131	
  1132	    # ── C5 R{n}_ 文件名 ──
  1133	    if rnd:
  1134	        typ = round_type(name)
  1135	        return finish(
  1136	            "C5_round_filename",
  1137	            V_ARCHIVE,
  1138	            typ,
  1139	            f"R{rnd}/",
  1140	            f"文件名带 R{rnd}_ → 归轮次目录"
  1141	            + (
  1142	                f"；子模式命中 → 类型 {typ}"
  1143	                if typ
  1144	                else "；子模式未命中 → 类型留空（去向确定，类型拿不准，不硬填）"
  1145	            ),
  1146	            True,
  1147	            type_uncertain=typ is None,
  1148	        )
  1149	
  1150	    # ── C6 兜底：拿不准（不给去向、不给类型） ──
  1151	    if within_batch:
  1152	        reason = "本批内有正文逐字相同的另一件，谁是正本不可判 —— 不硬猜"
  1153	    elif near:
  1154	        reason = (
  1155	            "疑似与 "
  1156	            + "、".join(f"{n['path']}(ratio {n['ratio']})" for n in near)
  1157	            + " 高相似，但**未逐字相等** —— 近似不等于重复，不硬猜"
  1158	        )
  1159	    else:
  1160	        reason = (
  1161	            "六判据全不命中：无 source URL、文头无可确定的 AI 自述、有实质正文、"
  1162	            "与库内无逐字相同正本、文件名无 R{n}_ 轮次标记"
  1163	        )
  1164	    if ai_suspect:
  1165	        # 嫌疑提示对 within_batch / near / 全不命中三个分支统一补挂 ——
  1166	        # round-5 自审 F6：只挂在 else 曾让「批内重复 + AI 嫌疑」件的理由缺嫌疑面。
  1167	        reason += f"；文头有「{ai_suspect}」字样但按边界规则不算确定自述，请你过目定夺"
  1168	    return finish(
  1169	        "C6_undecided",
  1170	        V_UNSURE,
  1171	        None,
  1172	        None,
  1173	        "无机械判据可施加",
  1174	        False,
  1175	        uncertain_reason=reason,
  1176	        ask=UNDECIDED_ASK,
  1177	    )
