   499	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   500	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   501	
   502	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   503	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   504	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   505	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   506	    分隔行由状态机精确标记，内容行一律是内容。
   507	
   508	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   509	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   510	
   511	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   512	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   513	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   514	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   515	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   516	    """
   517	    _, rest = split_frontmatter(text)
   518	    rows: list[tuple[str, str]] = []
   519	    in_fence = False
   520	    fence_char = ""
   521	    fence_len = 0
   522	    in_comment = False
   523	    for ln in rest:
   524	        m = _FENCE_RE.match(ln)
   525	        if m and not in_comment:
   526	            tok = m.group(1)
   527	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   528	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   529	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   530	            # 的 info string 允许反引号，不受此限。
   531	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   532	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   533	                rows.append((ln, "fence"))
   534	                continue
   535	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   536	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   537	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   538	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   539	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   540	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   541	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   542	            # 在 CommonMark 里是围栏内容）。
   543	            if (
   544	                tok[0] == fence_char
   545	                and len(tok) >= fence_len
   546	                and all(c in " \t" for c in ln[m.end() :])
   547	            ):
   548	                in_fence, fence_char, fence_len = False, "", 0
   549	                rows.append((ln, "fence"))
   550	                continue
   551	        if in_fence:
   552	            rows.append((ln, "code"))
   553	            continue
   554	        kept, rem = "", ln
   555	        while rem:
   556	            if in_comment:
   557	                i = rem.find("-->")
   558	                if i < 0:
   559	                    break
   560	                rem, in_comment = rem[i + 3 :], False
   561	            else:
   562	                i = rem.find("<!--")
   563	                if i < 0:
   564	                    kept += rem
   565	                    break
   566	                kept += rem[:i]
   567	                rem, in_comment = rem[i + 4 :], True
   568	        rows.append((kept, "text"))
   569	    return rows, in_comment
