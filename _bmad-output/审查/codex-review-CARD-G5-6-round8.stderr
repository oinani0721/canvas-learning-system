   610	def test_near_dup_scan_counts_are_actually_exercised(tmp_path):
   611	    """⛔ LOW 回归: 「跳过 ≠ 无重复」的计数必须真的被算出来。
   612	    原测试只查键存在 —— 把两个计数永久写死成 0 它也照样通过。"""
   613	    vault, out = base_vault(tmp_path)
   614	    long_body = "\n".join(f"第 {i} 行。" for i in range(1, 60)) + "\n"
   615	    mk(vault / "节点" / "长正本.md", long_body, age_days=40)
   616	    mk(vault / "节点" / "短文.md", "很短。\n第二行。\n", age_days=40)
   617	    mk(
   618	        vault / "_待处理" / "中等.md",
   619	        "# t\n\n" + "\n".join(f"第 {i} 行。" for i in range(1, 58)) + "\n",
   620	        age_days=2,
   621	    )
   622	
   623	    assert run_cli(vault, out).returncode == 0
   624	    scan = load_json(out)["near_dup_scan"]
   625	    assert scan["compared_pairs"] >= 1, "长度相近的一对必须真的比过"
   626	    assert scan["skipped_length_prefilter"] >= 1, "长度差悬殊的一对必须计入跳过"
