   261	+def test_bare_ai_markers_are_removed_from_table():
   262	+    """⛔ H2 回归(表锁): 裸词「AI 生成」「AI生成」是「由 AI 生成」「由AI生成」的
   263	+    严格子串; 截断形态「本文由 AI」「本报告由 AI」被「由 AI 生成」覆盖断言形态 ——
   264	+    从表中删除不丢任何带断言锚的命中, 只丢话题提及类误命中。"""
   265	+    mod = load_module()
   266	+    assert "AI 生成" not in mod.AI_MARKERS
   267	+    assert "AI生成" not in mod.AI_MARKERS
   268	+    assert "本文由 AI" not in mod.AI_MARKERS
   269	+    assert "本报告由 AI" not in mod.AI_MARKERS
   270	+
   271	+
   272	+def test_bare_url_line_is_not_a_frontmatter_key(tmp_path):
   273	+    """⛔ H3 回归: 正文行 `http://example.com/path` 里的 `http:` 不是 YAML 键 ——
   274	+    整篇不得被吞成 frontmatter 后判成「空骨架 → 建议删」, 更不得给出
   275	+    「其余皆空行」这类假依据。"""
   276	+    vault, out = base_vault(tmp_path)
   277	+    mk(vault / "_待处理" / "裸URL行.md", "---\nhttp://example.com/path\n---\n", age_days=3)
   278	+    # 正向对照: 真正的 frontmatter source 键仍走 C1
   279	+    mk(
   280	+        vault / "_待处理" / "真source.md",
   281	+        "---\nsource: http://example.com/path\n---\n\n正文一。\n正文二。\n",
   282	+        age_days=2,
   283	+    )
   284	+    assert run_cli(vault, out).returncode == 0
   285	+    data = load_json(out)
   286	+    it = item_by_name(data, "裸URL行.md")
   287	+    assert it["criterion"] != "C3_empty_or_skeleton"
   288	+    assert it["verdict"] != "建议删"
   289	+    assert "其余皆空行" not in it["basis"], f"假依据: {it['basis']}"
   290	+    pos = item_by_name(data, "真source.md")
   291	+    assert pos["criterion"] == "C1_source_url"
   292	+
   293	+
   294	+def test_frontmatter_span_requires_key_then_space_or_eol():
   295	+    """⛔ H3 回归(纯函数): YAML 映射键必须是 `key:` 后接空白或行尾;
   296	+    `https://example.com` 的 `https:` 不满足 → span 必须为 0。"""
   297	+    mod = load_module()
   298	+    bad = "---\nhttps://example.com\n---\n\n正文。\n".splitlines()
   299	+    assert mod.frontmatter_span(bad) == 0
   300	+    good = "---\ntags:\n---\n\n正文。\n".splitlines()
   301	+    assert mod.frontmatter_span(good) == 3
   302	+
   303	+
   304	+def test_key_without_space_after_colon_falls_to_c6(tmp_path):
   305	+    """D2 连带钉住: `source:https://x`(冒号后无空格) 此后不再识别为键 → 该行成为
   306	+    正文、材料落 C6 拿不准 —— 方向安全(不误判一手), 且此偏差已写进文件头声明。"""
   307	+    vault, out = base_vault(tmp_path)
   308	+    mk(
   309	+        vault / "_待处理" / "无空格键.md",
   310	+        "---\nsource:https://example.com/x\n---\n\n正文一。\n正文二。\n",
   311	+        age_days=3,
   312	+    )
   313	+    assert run_cli(vault, out).returncode == 0
   314	+    it = load_json(out)["items"][0]
   315	+    assert it["criterion"] == "C6_undecided"
   316	+    assert it["verdict"] == "拿不准"
   317	+
   318	+
   319	+def test_md_multi_canonical_declares_undecidable_not_crowned(tmp_path):
   320	+    """⛔ H4 回归: JSON basis 声明「哪一份算正本不可判」时, 人读 MD §四不得再
   321	+    钦定「正本 `字典序首项`」—— 那与 basis 自相矛盾。单正本时 MD 仍明确给出
   322	+    正本路径 (正向对照同测, 防修过头)。只改 MD 渲染, JSON schema v1 冻结。"""
   323	+    vault, out = base_vault(tmp_path)
   324	+    body = "同一段被存过两次的正文。\n第二行。\n"
   325	+    mk(vault / "节点" / "甲本.md", body, age_days=40)
   326	+    (vault / "归档").mkdir()
   327	+    mk(vault / "归档" / "乙本.md", body, age_days=39)
   328	+    mk(vault / "_待处理" / "第三份.md", body, age_days=2)
   329	+    single = "只存过一次的正文。\n它的第二行。\n"
   330	+    mk(vault / "节点" / "唯一正本.md", single, age_days=40)
   331	+    mk(vault / "_待处理" / "唯一副本.md", single, age_days=3)
   332	+
   333	+    assert run_cli(vault, out).returncode == 0
   334	+    md = products(out)[1].read_text(encoding="utf-8")
   335	+    multi_line = next(ln for ln in md.splitlines() if ln.startswith("- **第三份.md**"))
   336	+    assert "不可判" in multi_line, f"MD 钦定了正本: {multi_line}"
   337	+    assert "正本 `" not in multi_line, multi_line
   338	+    assert "另有副本" not in multi_line, multi_line
   339	+    # 不可判 ≠ 不给线索: 两个候选路径都要向人呈现
   340	+    assert "节点/甲本.md" in multi_line and "归档/乙本.md" in multi_line

