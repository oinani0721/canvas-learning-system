  1612	def test_slept_at_is_undigested_signal(tmp_path):
  1613	    """⛔ round-5 自审 F3 (MEDIUM): slept_at 是引擎自己在 Sleeping 台账解析的
  1614	    账本状态键 —— 收件箱文件带它意味着「从 Sleeping 移回、正待处置」。
  1615	    带 slept_at 的重复件/骨架件曾被建议删且起睡时间戳零留痕。"""
  1616	    vault, out = base_vault(tmp_path)
  1617	    body = "从 Sleeping 移回来的正文。\n第二行。\n"
  1618	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1619	    mk(
  1620	        vault / "_待处理" / "移回重复件.md",
  1621	        "---\ntitle: 移回\nslept_at: 2026-08-01\n---\n" + body,
  1622	        age_days=5,
  1623	    )
  1624	    mk(vault / "_待处理" / "移回骨架.md", "---\nslept_at: 2026-07-01\n---\n\n# 只有标题\n", age_days=4)
  1625	    # 正向对照: 无 slept_at 的重复件 → 仍 C4 建议删
  1626	    mk(vault / "_待处理" / "普通重复件.md", body, age_days=3)
  1627	
  1628	    assert run_cli(vault, out).returncode == 0
  1629	    data = load_json(out)
  1630	    for name in ("移回重复件.md", "移回骨架.md"):
  1631	        it = item_by_name(data, name)
  1632	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1633	        assert it["criterion"] == "C6_undecided", name
  1634	        assert "slept_at" in (it["uncertain_reason"] or ""), name
  1635	    dup = item_by_name(data, "普通重复件.md")
  1636	    assert dup["criterion"] == "C4_exact_duplicate"
  1637	    assert dup["verdict"] == "建议删"
