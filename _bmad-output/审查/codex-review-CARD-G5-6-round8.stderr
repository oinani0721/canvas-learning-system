   624	def skeleton_note(text: str, size: int) -> str:
   625	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   626	
   627	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   628	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   629	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   630	    """
   631	    if size == 0:
   632	        return "0 字节空文件"
   633	    rows = _classify_lines_typed(text)[0]
   634	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   635	    struct = sum(
   636	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   637	    )
   638	    fences = sum(1 for _, k in rows if k == "fence")
   639	    return (
   640	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   641	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   642	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   643	    )
   644	
   645	
   646	def head_window(text: str) -> list[tuple[int, str]]:
   647	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   648	    lines = text.splitlines()
   649	    n = frontmatter_span(lines)
   650	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   651	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   652	        win.append((n + j + 1, ln))
   653	    return win
   654	
   655	
   656	def _norm_ai_line(ln: str) -> str:
   657	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   658	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   659	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   660	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   661	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   662	    return " ".join(ln.split()).casefold()
