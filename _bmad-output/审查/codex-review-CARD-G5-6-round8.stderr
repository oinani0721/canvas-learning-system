   572	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   573	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   574	    三态细节见 `_classify_lines_typed`。"""
   575	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
