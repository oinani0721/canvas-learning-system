   492	def test_topic_mention_is_not_ai_self_declaration(tmp_path):
   493	    """⛔ HIGH 回归: 「Deep Research」作为**话题**出现 ≠ 自述由 AI 生成。
   494	    手写的产品比较笔记不该被归档进 DR 报告目录 —— 那是给不出证据还硬给去向。"""
   495	    vault, out = base_vault(tmp_path)
   496	    inbox = vault / "_待处理"
   497	    mk(
   498	        inbox / "话题提及.md",
   499	        "# Deep Research 产品比较\n\n我自己用下来的心得。\n第二行。\n",
   500	        age_days=4,
   501	    )
   502	    mk(
   503	        inbox / "真自述.md",
