   745	# ───────────────────────────── 扫描 ─────────────────────────────
   746	
   747	
   748	def read_text_or_none(p: Path) -> str | None:
   749	    try:
   750	        return p.read_bytes().decode("utf-8")
   751	    except (OSError, UnicodeDecodeError):
   752	        return None
   753	
   754	
   755	def scan_corpus(
   756	    vault: Path, excluded_roots: list[str]
   757	) -> tuple[dict[str, list[str]], list[tuple[str, str]], dict]:
   758	    """库内 .md 语料：→ (归一化正文 → [相对路径…], [(路径, 正文)…], 统计)。
   759	
   760	    排除：一切隐藏目录、`outputs/`、收件箱子树、产物目录子树。
   761	    ⛔ **空正文不进重复索引** —— 否则库内任意两个空骨架互为「正本」，会撑出一条
   762	    有后果的建议删，其证据是「两个都是空的」。C3 虽然先命中，但索引本身必须先干净：
   763	    门要防的是未来次序调整时的静默失效，不只是当下这一次。
   764	    """
   765	    by_body: dict[str, list[str]] = {}
   766	    bodies: list[tuple[str, str]] = []
   767	    stats = {
   768	        "files_scanned": 0,
   769	        "files_indexed": 0,
   770	        "skipped_empty_body": 0,
   771	        "skipped_symlink": 0,
   772	        "skipped_unreadable": 0,
   773	        "truncated": False,
   774	        "file_cap": CORPUS_FILE_CAP,
   775	    }
   776	    for dirpath, dirnames, filenames in os.walk(vault):
   777	        dirnames[:] = sorted(
   778	            d
   779	            for d in dirnames
   780	            if not d.startswith(".")
   781	            and d not in CORPUS_EXCLUDED_DIR_NAMES
   782	            and os.path.realpath(os.path.join(dirpath, d)) not in excluded_roots
   783	        )
   784	        for fn in sorted(filenames):
   785	            if not fn.endswith(".md"):
   786	                continue
   787	            if stats["files_scanned"] >= CORPUS_FILE_CAP:
   788	                # ⛔ 不在此处 return —— 早退会绕过下面的排序尾巴, 让"截断"与"未截断"
   789	                # 两条路径产出形态不同的索引。置位后跳出全部循环, 走同一个出口。
   790	                stats["truncated"] = True
   791	                dirnames.clear()
   792	                break
   793	            p = Path(dirpath) / fn
   794	            stats["files_scanned"] += 1
   795	            if p.is_symlink():
   796	                stats["skipped_symlink"] += 1
   797	                continue
   798	            text = read_text_or_none(p)
   799	            if text is None:
   800	                stats["skipped_unreadable"] += 1
   801	                continue
   802	            if not has_substantive_content(text):
   803	                stats["skipped_empty_body"] += 1
   804	                continue
   805	            body = dup_body(text)
   806	            if not body:
   807	                stats["skipped_empty_body"] += 1
   808	                continue
   809	            rel = p.relative_to(vault).as_posix()
   810	            by_body.setdefault(body, []).append(rel)
   811	            bodies.append((rel, body))
   812	            stats["files_indexed"] += 1
   813	        if stats["truncated"]:
   814	            break
   815	    for v in by_body.values():
   816	        v.sort()
   817	    bodies.sort()
   818	    return by_body, bodies, stats
   819	
   820	
   821	def near_duplicates(
   822	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
   823	) -> list[dict]:
   824	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
   825	    if not body:
   826	        return []
   827	    a_lines = body.split("\n")
   828	    la = len(body)
   829	    hits: list[tuple[float, str]] = []
   830	    for rel, other in corpus_bodies:
   831	        if other == body:
   832	            continue  # 逐字相等归 C4，不重复计入疑似
   833	        lb = len(other)
   834	        if la > NEAR_DUP_BODY_CHAR_CAP or lb > NEAR_DUP_BODY_CHAR_CAP:
   835	            scan["skipped_oversize"] += 1
   836	            continue
   837	        if not (1 / NEAR_DUP_LEN_RATIO <= (lb / la if la else 0) <= NEAR_DUP_LEN_RATIO):
   838	            scan["skipped_length_prefilter"] += 1
   839	            continue
   840	        scan["compared_pairs"] += 1
   841	        sm = difflib.SequenceMatcher(None, a_lines, other.split("\n"), autojunk=False)
   842	        if sm.real_quick_ratio() < NEAR_DUP_RATIO or sm.quick_ratio() < NEAR_DUP_RATIO:
   843	            continue
   844	        r = sm.ratio()
   845	        if r >= NEAR_DUP_RATIO:
   846	            hits.append((r, rel))
   847	    hits.sort(key=lambda x: (-x[0], x[1]))
   848	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
   849	
