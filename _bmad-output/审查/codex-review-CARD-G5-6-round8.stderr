   700	
   701	def find_ai_marker(text: str) -> tuple[int, str] | None:
   702	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   703	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   704	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   705	    —— 行号准确，文本保真。"""
   706	    for lineno, ln in head_window(text):
   707	        norm = _norm_ai_line(ln)
   708	        hits = [
   709	            (pos, -len(nm), orig)
   710	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   711	            if (pos := _find_marker_pos(norm, nm)) >= 0
   712	        ]
   713	        if hits:
   714	            _, _, marker = min(hits)
   715	            return lineno, marker
   716	    return None
   717	
   718	
   719	def raw_ai_marker(text: str) -> str | None:
   720	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   721	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
   722	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
   723	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
   724	    返回原表原文（uncertain_reason 展示用）。"""
   725	    for _, ln in head_window(text):
   726	        norm = _norm_ai_line(ln)
   727	        for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
   728	            if nm in norm:
   729	                return orig
   730	    return None
   731	
   732	
   733	def round_of(name: str) -> str | None:
   734	    m = _ROUND_RE.search(name)
   735	    return m.group(1) if m else None
   736	
   737	
   738	def round_type(name: str) -> str | None:
   739	    for pat, typ in ROUND_SUBPATTERNS:
   740	        if pat in name:
   741	            return typ
   742	    return None
