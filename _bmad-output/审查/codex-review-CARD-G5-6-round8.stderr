   179	+def test_ai_marker_needs_boundary_after_literal(tmp_path):
   180	+    """⛔ H2 回归: 标记右侧必须满足边界规则 —— 话题提及不是生成断言, 不得被归档。
   181	+    ⛔ round-3 自审 H2-1 扩: 汉字收尾标记后须为行尾/空白/标点; ASCII 字母收尾
   182	+    标记(`Generated by AI`)后空白**不算**边界 —— `Generated by AI Lab` 是机构名,
   183	+    `本文由 AI 领域…` 是话题, 放行空白就是把边界规则对这些标记变成空操作。"""
   184	+    vault, out = base_vault(tmp_path)
   185	+    inbox = vault / "_待处理"
   186	+    mk(
   187	+        inbox / "版权话题.md",
   188	+        "# AI 生成内容的版权问题\n\n话题正文一。\n话题正文二。\n",
   189	+        age_days=9,
   190	+    )
   191	+    mk(
   192	+        inbox / "由字版权话题.md",
   193	+        "# 由 AI 生成内容的版权问题\n\n话题正文三。\n话题正文四。\n",
   194	+        age_days=8,
   195	+    )
   196	+    mk(
   197	+        inbox / "评测话题.md",
   198	+        "# Deep Research 生成质量评测\n\n评测正文一。\n评测正文二。\n",
   199	+        age_days=7,
   200	+    )
   201	+    mk(
   202	+        inbox / "本文由话题.md",
   203	+        "# 访谈整理\n\n本文由 AI 领域的三位研究者共同撰写，记录分歧。\n访谈正文二。\n",
   204	+        age_days=6,
   205	+    )
   206	+    mk(
   207	+        inbox / "英文机构.md",
   208	+        "# Lab notes\n\nGenerated by AI Lab researchers in Beijing.\n笔记正文二。\n",
   209	+        age_days=5,
   210	+    )
   211	+    # 正向对照: 行尾/标点/加粗收尾仍命中, 依据带行号与逐字片段
   212	+    mk(
   213	+        inbox / "行尾自述.md",
   214	+        "# 报告甲\n\n> 本文由 AI 生成\n\n自述正文一。\n自述正文二。\n",
   215	+        age_days=4,
   216	+    )
   217	+    mk(
   218	+        inbox / "标点自述.md",
   219	+        "# 报告乙\n\n由 AI 生成，仅供参考\n\n自述正文三。\n自述正文四。\n",
   220	+        age_days=3,
   221	+    )
   222	+    mk(
   223	+        inbox / "英文句点自述.md",
   224	+        "# Report\n\nThis draft was generated by AI.\n报告正文二。\n",
   225	+        age_days=2,
   226	+    )
   227	+    mk(
   228	+        inbox / "加粗自述.md",
   229	+        "# 报告丙\n\n**由 AI 生成**\n\n自述正文五。\n自述正文六。\n",
   230	+        age_days=1,
   231	+    )
   232	+
   233	+    assert run_cli(vault, out).returncode == 0
   234	+    data = load_json(out)
   235	+    for name in (
   236	+        "版权话题.md",
   237	+        "由字版权话题.md",
   238	+        "评测话题.md",
   239	+        "本文由话题.md",
