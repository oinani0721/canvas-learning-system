   678	def _find_marker_pos(ln: str, marker: str) -> int:
   679	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   680	
   681	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   682	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   683	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   684	    行内更靠后的真命中。
   685	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   686	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   687	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   688	    只认行尾或标点；漏判方向落 C6，安全。"""
   689	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   690	    start = 0
   691	    while (i := ln.find(marker, start)) >= 0:
   692	        j = i + len(marker)
   693	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   694	            return i
   695	        if not ascii_ending and ln[j].isspace():
   696	            return i
   697	        start = i + 1
   698	    return -1
