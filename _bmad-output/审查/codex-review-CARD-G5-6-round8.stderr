   398	def parse_now(raw: str) -> datetime:
   399	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   400	    try:
   401	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   402	    except ValueError as e:
   403	        raise SystemExit(
   404	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   405	        ) from e
   406	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   407	
   408	
   409	def _epoch_s(dt: datetime) -> float:
   410	    return dt.timestamp()
   411	
