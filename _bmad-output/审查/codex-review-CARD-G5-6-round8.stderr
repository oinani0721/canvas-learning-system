   443	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   444	
   445	
   446	def frontmatter_span(lines: list[str]) -> int:
   447	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   448	
   449	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   450	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   451	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   452	    行号是给人核对用的，偏了就等于没有。
   453	    """
   454	    if not lines or lines[0].strip() != "---":
   455	        return 0
   456	    end = None
   457	    for i in range(1, len(lines)):
   458	        if lines[i].strip() in ("---", "..."):
   459	            end = i
   460	            break

