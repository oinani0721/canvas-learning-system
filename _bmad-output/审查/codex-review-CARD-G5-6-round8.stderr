   589	def test_criteria_order_c4_does_not_outrank_c2_c5(tmp_path):
   590	    """⛔ MEDIUM 回归: 次序覆盖不能只有 C1+C4 一对。
   591	    这里构造 C2/C5 与 C4 的冲突 —— 把实现里的 C4 上移到任一条之前, 本条必红。"""
   592	    vault, out = base_vault(tmp_path)
   593	    inbox = vault / "_待处理"
   594	    ai_body = "> 本文由 Deep Research 生成\n\n共有的正文。\n第二行。\n"
   595	    mk(vault / "节点" / "AI正本.md", ai_body, age_days=40)
   596	    mk(inbox / "AI副本.md", ai_body, age_days=5)
   597	    rnd_body = "轮次材料的正文。\n第二行。\n"
   598	    mk(vault / "节点" / "轮次正本.md", rnd_body, age_days=40)
   599	    mk(inbox / "R77_副本.md", rnd_body, age_days=4)
