  1670	def validate_label(label: str) -> None:
  1671	    if not label or _BAD_LABEL.search(label):
  1672	        raise SystemExit(
  1673	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
  1674	        )
