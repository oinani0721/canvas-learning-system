  1689	def main() -> int:
  1690	    ap = argparse.ArgumentParser(
  1691	        description="待处理盘点提名 preview（只读, CARD-G5-6）"
  1692	    )
  1693	    ap.add_argument("--vault", required=True, help="vault 根目录")
  1694	    ap.add_argument(
  1695	        "--now", required=True, help="基准时刻 ISO-8601（裸时间按 Asia/Shanghai 解释）"
  1696	    )
  1697	    ap.add_argument(
  1698	        "--inbox-dir",
  1699	        default=None,
  1700	        help=f"收件箱目录（缺省 <vault>/{DEFAULT_INBOX_NAME}）。"
  1701	        "显式给定却不存在 = 拒绝；缺省路径不存在 = 空仓回执",
  1702	    )
  1703	    ap.add_argument(
  1704	        "--out-dir",
  1705	        default=None,
  1706	        help="产物目录（缺省 <vault>/outputs；父目录必须已存在）",
  1707	    )
  1708	    ap.add_argument(
  1709	        "--batch-size", type=int, default=BATCH_MAX, help=f"单批件数（1..{BATCH_MAX}）"
  1710	    )
  1711	    args = ap.parse_args()
  1712	
  1713	    # ⛔ 次序铁律：全部输入守卫跑完**再**碰 out-dir —— 拒绝路径必须零产物。
  1714	    if not (1 <= args.batch_size <= BATCH_MAX):
  1715	        raise SystemExit(
  1716	            f"✗ --batch-size 必须在 1..{BATCH_MAX}（D15 确认预算上限，不得突破）, 实得 {args.batch_size}"
  1717	        )
  1718	    now = parse_now(args.now)
  1719	
  1720	    vault = Path(args.vault)
  1721	    if vault.is_symlink():
  1722	        raise SystemExit(f"✗ vault 路径本身是 symlink, 拒绝越界读取: {vault}")
  1723	    if not vault.is_dir():
  1724	        raise SystemExit(f"✗ vault 不存在或不是目录: {vault}")
  1725	    vault = vault.resolve()
  1726	
  1727	    explicit = args.inbox_dir is not None
  1728	    inbox = Path(args.inbox_dir) if explicit else vault / DEFAULT_INBOX_NAME
  1729	    if inbox.is_symlink():
  1730	        raise SystemExit(f"✗ 收件箱目录本身是 symlink, 拒绝越界读取: {inbox}")
  1731	    inbox_exists = inbox.is_dir()
  1732	    if explicit and not inbox_exists:
  1733	        # 用户明确指了路径却找不到 = 写错了。绝不能报成「空仓」把 typo 掩盖掉。
  1734	        raise SystemExit(f"✗ --inbox-dir 指定的目录不存在: {inbox}")
  1735	
  1736	    validate_label(inbox.name)
  1737	    validate_product_filename(inbox.name)
  1738	
  1739	    out_dir_arg = Path(args.out_dir) if args.out_dir else vault / "outputs"
  1740	    inbox_real, out_real = os.path.realpath(inbox), os.path.realpath(out_dir_arg)
  1741	    if out_real == inbox_real or out_real.startswith(inbox_real + os.sep):
  1742	        # ⛔ 否则第一次跑落下的两份产物，第二次跑会被当成待处理材料盘点进来 ——
  1743	        # 「同输入二跑逐字节相等」当场不成立，而且是那种跑两次才看得见的不成立。
  1744	        raise SystemExit(
  1745	            f"✗ 产物目录不能位于收件箱内, 拒绝运行（二跑会把上一次的产物当成待处理材料）: {out_dir_arg}"
  1746	        )
  1747	    excluded = [inbox_real, out_real]
  1748	
  1749	    data = build_preview(vault, inbox, inbox_exists, now, args.batch_size, excluded)
  1750	    payload_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
  1751	    payload_md = render_md(data)
  1752	
  1753	    out_dir = _SP.prepare_out_dir(out_dir_arg)
  1754	    json_path = out_dir / f"inbox-preview-{inbox.name}.json"
  1755	    md_path = out_dir / f"inbox-preview-{inbox.name}.md"
  1756	    _SP.write_pair_atomically_checked(
  1757	        [(json_path, payload_json), (md_path, payload_md)]
  1758	    )
  1759	
  1760	    print(
  1761	        f"✓ preview 已生成（只读引擎, 未动 vault 任何既有文件）: {json_path} / {md_path}"
  1762	    )
  1763	    print(f"  {data['receipt']}")
  1764	    unsure = sum(1 for i in data["items"] if not i["confident"])
  1765	    print(
  1766	        f"  本批 {len(data['items'])} 件 · 拿不准 {unsure} 件 · "
  1767	        f"建议删 {sum(1 for i in data['items'] if i['verdict'] == V_DELETE)} 件"
  1768	    )
  1769	    return 0
  1770	
