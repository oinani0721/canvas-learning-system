  1681	    body = "别名键重复件的正文。\n第二行。\n"
  1682	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1683	    mk(
  1684	        vault / "_待处理" / "坏url别名重复.md",
  1685	        "---\nurl: https://:443/broken\n---\n" + body,
  1686	        age_days=5,
  1687	    )
  1688	    # 正向对照: 值不是 URL 的别名键 → 不触发 → 纯空骨架仍 C3
  1689	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1690	
  1691	    assert run_cli(vault, out).returncode == 0
  1692	    data = load_json(out)
  1693	    for name in ("坏Source别名.md", "坏url别名重复.md"):
  1694	        it = item_by_name(data, name)
  1695	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1696	        assert it["criterion"] == "C6_undecided", name
  1697	        assert ":443" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1698	    skeleton = item_by_name(data, "纯空骨架.md")
  1699	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1700	    assert skeleton["verdict"] == "建议删"
