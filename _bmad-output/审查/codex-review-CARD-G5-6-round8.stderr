  1377	def build_receipt(data: dict) -> str:
  1378	    inv, sl = data["inventory"], data["sleeping"]
  1379	    if not data["inbox_exists"]:
  1380	        head = f"{data['inbox_dir']} 尚未创建（等同空仓，该 vault 还没开始用收件箱）。"

exec
/bin/zsh -lc "nl -ba canvas-vault/.claude/skills/clear-inbox/scripts/inbox_preview.py | sed -n '1381,1773p'" in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-v6-inbox
 succeeded in 0ms:
  1381	    elif inv["total"] == 0:
  1382	        head = f"{data['inbox_dir']} 已空，没有待处理材料。"
  1383	    else:
  1384	        head = f"{data['inbox_dir']} 共 {inv['total']} 件" + (
  1385	            f"，本批取最旧的 {len(data['items'])} 件（其余 {len(inv['deferred'])} 件留待下次）。"
  1386	            if inv["over_budget"]
  1387	            else f"，本批全取（{len(data['items'])} 件）。"
  1388	        )
  1389	    if not sl["exists"]:
  1390	        tail = "Sleeping/ 未建立，无睡眠台账。"
  1391	    elif sl["count"] == 0:
  1392	        tail = "Sleeping/ 是空的。"
  1393	    else:
  1394	        tail = f"Sleeping 睡着 {sl['count']} 件（最久 {sl['oldest_days']} 天"
  1395	        tail += (
  1396	            f"，其中 {sl['over_30d_count']} 件已睡满 {SLEEP_ALERT_DAYS} 天 ⚠️）。"
  1397	            if sl["over_30d_count"]
  1398	            else "）。"
  1399	        )
  1400	    return head + " " + tail
