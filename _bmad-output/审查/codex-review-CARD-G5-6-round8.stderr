   576	def test_non_regular_file_is_skipped_without_reading(tmp_path):
   577	    """⛔ MEDIUM 回归: FIFO 不得被 read_bytes —— 那会直接挂住整个进程。"""
   578	    vault, out = base_vault(tmp_path)
   579	    os.mkfifo(vault / "_待处理" / "管道.md")
   580	    mk(vault / "_待处理" / "正常.md", "# t\n\n正文一。\n正文二。\n", age_days=2)
   581	
   582	    r = run_cli(vault, out)
   583	    assert r.returncode == 0, "读到 FIFO 挂住了"
   584	    data = load_json(out)
   585	    assert [i["name"] for i in data["items"]] == ["正常.md"]
   586	    assert any(x["name"] == "管道.md" for x in data["inventory"]["skipped"])
