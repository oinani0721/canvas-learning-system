  1495	
  1496	def render_md(d: dict) -> str:
  1497	    L: list[str] = []
  1498	    L.append(f"# 待处理盘点 preview · {d['label']}")
  1499	    L.append("")
  1500	    L.append(f"> {d['not_executed_disclaimer']}")
  1501	    L.append(
  1502	        f"> 基准时刻 `--now`：{d['now_local']}（Asia/Shanghai）· schema v{d['schema_version']}"
  1503	    )
  1504	    L.append("")
  1505	    L.append("## 一、回执")
  1506	    L.append("")
  1507	    L.append(d["receipt"])
  1508	    L.append("")
  1509	    L.append(f"- 上次清仓：**不可得** —— {d['last_cleanup_note']}")
  1510	    c = d["corpus"]
  1511	    L.append(
  1512	        f"- 语料库：扫描 {c['files_scanned']} 份 .md，进重复索引 {c['files_indexed']} 份"
  1513	        f"（空正文 {c['skipped_empty_body']} 份不进索引 · symlink {c['skipped_symlink']} · "
  1514	        f"不可读 {c['skipped_unreadable']}）"
  1515	        + (
  1516	            "　⚠️ **已达扫描上限被截断**，「无重复」仅代表已扫部分"
  1517	            if c["truncated"]
  1518	            else ""
  1519	        )
  1520	    )
  1521	    L.append("")
  1522	
  1523	    L.append(f"## 二、本批提名（{len(d['items'])} 件，最旧优先）")
  1524	    L.append("")
  1525	    if not d["items"]:
  1526	        L.append("_（本批无材料）_")
  1527	    else:
  1528	        L.append("| # | 文件 | 年龄 | 建议去向 | 提名类型 | 判据 | 依据 | 冲突 |")
  1529	        L.append("|---|---|---|---|---|---|---|---|")
  1530	        for it in d["items"]:
  1531	            conflict = (
  1532	                "；".join(f"{x['kind']}" for x in it["conflicts"])
  1533	                if it["conflicts"]
  1534	                else "—"
  1535	            )
  1536	            target = f"（→ {it['target_hint']}）" if it["target_hint"] else ""
  1537	            L.append(
