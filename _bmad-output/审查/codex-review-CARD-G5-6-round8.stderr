   767	def test_zero_write_side_full_tree_snapshot(tmp_path):
   768	    """全树 sha256+mtime_ns+mode 前后逐项相等 (out-dir 在 vault 树外)。"""
   769	    vault, out = base_vault(tmp_path)
   770	    inbox = vault / "_待处理"
   771	    mk(vault / "节点" / "正本.md", "库内正文。\n第二行。\n", age_days=40)
   772	    mk(vault / "原白板" / "板.md", "# 板\n\n## Concepts\n- 正本\n", age_days=30)
   773	    mk(inbox / "空的.md", "", age_days=9)
   774	    mk(inbox / "剪藏.md", "---\nsource: https://a.test/x\n---\n\n正文。\n二行。\n", age_days=5)
   775	    mk(inbox / "重复.md", "库内正文。\n第二行。\n", age_days=4)
   776	    mk(inbox / "Sleeping" / "睡着的.md", "---\nslept_at: 2026-07-01\n---\n\n正文。\n", age_days=20)
   777	
   778	    before = snapshot(vault)
   779	    assert run_cli(vault, out).returncode == 0
   780	    after = snapshot(vault)
   781	    assert before == after, "只读引擎修改了 vault 树"
   782	    assert products(out)[0].exists() and products(out)[1].exists()
