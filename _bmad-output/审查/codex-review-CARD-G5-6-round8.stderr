  1755	def test_backtick_info_string_is_not_a_fence_open(tmp_path):
  1756	    """⛔ round-6 BLOCKER-3: 反引号围栏的 info string 含反引号时不是合法开启行
  1757	    (CommonMark 4.4) —— ```foo`bar 曾被当开启、下一行被当关闭、正文再被
  1758	    标题剥掉 → 空骨架建议删。tilde 围栏的 info string 允许反引号。"""
  1759	    vault, out = base_vault(tmp_path)
  1760	    mk(vault / "_待处理" / "反引号info.md", "```foo`bar\n```\n# keep\n", age_days=6)
  1761	    # 正向对照: 合法 info string 开启 + 关闭 → 围栏正常 (内容行非空)
  1762	    mk(vault / "_待处理" / "正常info.md", "```python\n# keep\n```\n", age_days=5)
  1763	
  1764	    assert run_cli(vault, out).returncode == 0
  1765	    data = load_json(out)
  1766	    it = item_by_name(data, "反引号info.md")
  1767	    assert it["verdict"] != "建议删", f"非法 info string 围栏件被建议删了: {it['basis']}"
  1768	    assert it["criterion"] != "C3_empty_or_skeleton"
  1769	    normal = item_by_name(data, "正常info.md")
  1770	    assert normal["criterion"] != "C3_empty_or_skeleton", "合法围栏不得误伤"
