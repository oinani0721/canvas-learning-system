  1796	def test_tab_and_nbsp_indented_heading_is_content(tmp_path):
  1797	    """⛔ round-7 BLOCKER-2: ATX 标题缩进必须限字面空格 —— `\\t# keep` 是缩进
  1798	    代码、`\\xa0# keep` 是普通正文, 都曾被 `^\\s{0,3}` 当标题剥掉 → 空骨架
  1799	    建议删 (与 B3-4 围栏缩进同族的教训)。"""
  1800	    vault, out = base_vault(tmp_path)
  1801	    inbox = vault / "_待处理"
  1802	    mk(inbox / "tab缩进标题.md", "\t# keep\n", age_days=6)
  1803	    mk(inbox / "nbsp缩进标题.md", "\xa0# keep\n", age_days=5)
  1804	    # 正向对照: 顶格标题 + 无正文 → 仍 C3 建议删
  1805	    mk(inbox / "顶格标题.md", "# 标题\n\n## 小节\n", age_days=4)
  1806	
  1807	    assert run_cli(vault, out).returncode == 0
