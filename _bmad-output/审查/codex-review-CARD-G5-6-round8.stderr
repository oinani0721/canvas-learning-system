  1180	def _fill(
  1181	    item: dict,
  1182	    criterion: str,
  1183	    verdict: str,
  1184	    ntype: str | None,
  1185	    target: str | None,
  1186	    basis: str,
  1187	    confident: bool,
  1188	    *,
  1189	    uncertain_reason: str | None = None,
  1190	    ask: str | None = None,
  1191	    type_uncertain: bool = False,
  1192	    exact_of: str | None = None,
  1193	    exact_others: list[str] | None = None,
  1194	    near: list[dict] | None = None,
  1195	    conflicts: list[dict] | None = None,
  1196	) -> dict:
  1197	    out = dict(item)
  1198	    out.update(
  1199	        {
  1200	            "criterion": criterion,
  1201	            "verdict": verdict,
  1202	            "nomination_type": ntype,
  1203	            "target_hint": target,
  1204	            "basis": basis,
  1205	            "confident": confident,
  1206	            "type_uncertain": type_uncertain,
  1207	            "uncertain_reason": uncertain_reason,
  1208	            "ask": ask,
  1209	            "exact_duplicate_of": exact_of,
  1210	            "exact_duplicate_others": exact_others or [],
  1211	            "near_duplicates": near or [],
  1212	            "conflicts": conflicts or [],
  1213	        }
  1214	    )
  1215	    return out
