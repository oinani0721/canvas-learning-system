   369	def test_truncated_tail_line_without_lf_guard(vault):
   370	    """§二 截断自愈: 真实崩溃产物是 **半个 JSON** 且无尾 LF — 读取时跳过
   371	    留痕, 追加前 LF 守卫隔离, 新事件必须独立可解析 (Codex round-1 HIGH:
   372	    旧版只测「完整 JSON 缺 LF」, partial-JSON 在读取阶段就 fail-closed,
   373	    自愈路径不可达)。"""
   374	    ledger = vault / "learning_events.jsonl"
   375	    full = json.dumps(
   376	        {
   377	            "event_id": "exam:旧板",
   378	            "event_version": 1,
   379	            "event_type": "exam_created",
   380	            "node_id": "旧节点",
