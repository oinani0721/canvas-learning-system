   491	        return None, str(_e)
   492	    try:
   493	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   494	    except ValueError:
   495	        _out = {}
   496	    if _r.returncode == 2:
   497	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
