   291	class _DupKey(Exception):
   292	    """JSON 对象内出现重复键。**不继承 ValueError** —— 否则会被账本读取的
   293	    「坏行」分支当成解析失败吞掉, 末行还会被当截断容忍。"""
   294	
   295	
   296	def _no_dup_keys(pairs):
   297	    _seen = set()
   298	    for _k, _ in pairs:
   299	        if _k in _seen:
   300	            raise _DupKey(repr(_k))
   301	        _seen.add(_k)
   302	    return dict(pairs)
