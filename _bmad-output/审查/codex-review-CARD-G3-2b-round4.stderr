  1224	def _looks_like_review_ext(payload: dict) -> bool:
  1225	    """payload 带扩展键但无合法 marker → 视为规避扩展校验的写法。
  1226	
  1227	    历史行 payload 只有 grade_norm/exam_board/attempt_count, 不含这些键,
  1228	    因此对存量零误报 (round-3: 去掉 marker 曾等于免检)。
  1229	    """
  1230	    return bool(REVIEW_EXT_KEYS & set(payload.keys()))
