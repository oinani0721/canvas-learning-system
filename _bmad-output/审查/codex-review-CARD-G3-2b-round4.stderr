  1702	# ── 门㊲ 内部对抗审查（8 个核查面并行探测 + 每条 3 票独立复现）找出的 7 条 ──
  1703	# 两轮 Codex 正文都被内容过滤器拦下后补跑的内部审查。7 条全部实测复现过。
  1704	
  1705	
  1706	def test_internal_audit_findings(vault):
  1707	    import unicodedata
  1708	
  1709	    # ① BLOCKER：A2 重放的 pending 行必须**评分事实完整**。
  1710	    # R5 只挡住「显式 rating 与 grade_norm 不自洽」，挡不住「rating 干脆没有」——
  1711	    # 缺 rating 时 bridge 回落到推导，grade_norm 也缺时用默认 0.0 ⇒ 一次可能是
  1712	    # 「答对」的评分被当成 Rating.Again（完全忘记）静默应用（实测 rc=0、W 照常推进）。
  1713	    for bad, desc in (
  1714	        ({"payload.rating": None}, "rating=null"),
  1715	        ({"payload.rating": 3.0}, "rating 是 float"),
  1716	        ({"payload.grade_norm": 1.5}, "grade_norm 越界"),
  1717	        ({"payload.grade_norm": "0.75"}, "grade_norm 是字符串"),
  1718	    ):
  1719	        _write_ledger(vault, _review_row(event_id="quiz:板A#q1", **bad))
  1720	        r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1721	        assert r.returncode != 0, f"[{desc}] 评分事实不完整的行不得被重放"
  1722	        assert len(_ledger_lines(vault)) == 1, f"[{desc}] 零写"
  1723	    # 缺键（而非 null）同样拒
  1724	    row = _review_row(event_id="quiz:板A#q1")
  1725	    row["payload"].pop("rating")
  1726	    _write_ledger(vault, row)
  1727	    assert _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z")).returncode != 0
  1728	    # 验伪：合法行照常重放
  1729	    _write_ledger(vault, _review_row(event_id="quiz:板A#q1"))
  1730	    rok = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1731	    assert rok.returncode == 0 and "A2 重放已应用" in rok.stdout, rok.stdout + rok.stderr
  1732	
  1733	    # ② BLOCKER：A2 重放必须同步 attempt_count，否则写点自己破坏 ordinal 回推的前提。
  1734	    # E1 崩溃 → 先答 E2 → 重放 E1 不推进 attempt ⇒ E2 以同一基数写出 attempt=1，
  1735	    # durable 变成 [1,1]；此后原样重跑 E1，ordinal 回推算出 0 而 durable 是 1 ⇒
  1736	    # 合法历史重放被误报冲突（实测复现）。attempt 与 mastery 不同：它**有事件载荷**。
  1737	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1738	    (vault / "learning_events.jsonl").unlink()
  1739	    assert _run_writer(vault, _payload()).returncode == 0
  1740	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 崩溃窗口①
  1741	    # 两阶段（恢复先落定 → 重跑写本次）；attempt 的不变量在**最终**状态上验。
  1742	    r2 = _run_writer_settled(
  1743	        vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md")
  1744	    )
  1745	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1746	    assert "A2 重放已应用" in r2.stdout
  1747	    assert [x["payload"]["attempt_count"] for x in _ledger_lines(vault)] == [1, 2], (
  1748	        "A2 重放必须把 attempt 推到 durable 值，否则下一个事件会复用同一序数"
  1749	    )
  1750	    assert re.search(r'^attempt_count:\s*"?(\d+)"?\s*$', _fm(vault), re.M).group(1) == "2"
  1751	
  1752	    # ③ BLOCKER：账本按**字节**切行再逐行 decode。
  1753	    # BOM 首行（别的编辑器存过）整文件 decode 时会让一条**完整合法**的事件行解析
  1754	    # 失败、被当截断跳过、那次评分静默丢失；而腰斩一个多字节字符恰恰是最典型的
  1755	    # 崩溃产物——整文件 decode 一失败就全盘拒，自愈路径反而对它不可达。
  1756	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1757	    row = _review_row(event_id="quiz:板A#q1")
  1758	    RJ = json.dumps(row, ensure_ascii=False).encode("utf-8")
  1759	    good = _review_row(event_id="quiz:旧板", **{"payload.review_time": "2026-07-01T10:00:00Z"})
  1760	    good["effective_at"] = "2026-07-01T10:00:00Z"
  1761	    good["node_id"] = "别的节点"
  1762	    G = json.dumps(good, ensure_ascii=False).encode("utf-8") + b"\n"
  1763	    half_cjk = '{"event_id": "quiz:损'.encode("utf-8")[:-1]  # 腰斩「损」字
  1764	    for content, expect, desc in (
  1765	        (b"\xef\xbb\xbf" + RJ, "replay", "BOM + 完整合法行（无 LF）"),
  1766	        (b"\xef\xbb\xbf" + RJ + b"\n", "replay", "BOM + 完整合法行（带 LF）"),
  1767	        (G + half_cjk, "tolerate", "腰斩 CJK 的末行（无 LF）= 真截断"),
  1768	        (G + half_cjk + b"\n", "reject", "腰斩 CJK 的末行（带 LF）= 完整损坏"),
  1769	        (b"\xff\xfe bad\n" + RJ, "reject", "首行非 UTF-8 且不是末行"),
  1770	    ):
  1771	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
