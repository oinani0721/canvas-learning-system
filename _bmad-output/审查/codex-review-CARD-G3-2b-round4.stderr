    51	    candidates = [
    52	        Path(__file__).resolve().parents[3] / "backend" / ".venv" / "bin" / "python",
    53	        Path(
    54	            "/Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/"
    55	            "feature-obsidian-hybrid-dev/backend/.venv/bin/python"
    56	        ),
    57	    ]
    58	    for c in candidates:
    59	        if c.exists():
    60	            return str(c)
    61	    return None
    62	
    63	FIELD_ORDER = (
    64	    "fsrs_due", "fsrs_state", "fsrs_step",
    65	    "fsrs_stability", "fsrs_difficulty", "fsrs_last_review",
    66	)
