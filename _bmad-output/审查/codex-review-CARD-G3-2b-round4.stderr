   304	# ── G3-2 frontmatter 重复键 fail-closed (schema §6.2 三态边界声明: 重复键
   305	# 信息在解析层即丢失, 责任在解析处; 本正则解析器不保留重复键 ⇒ 写/读的键
   306	# 出现重复时停下, 不猜)。误报方向 fail-closed (顶格错位文本会被当键) 可接受。
   307	FSRS_KEYS = ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review")
   308	_watched = ("type", "source_board", "mastery_score", "mastery", "mastery_level",
   309	            "mastery_a", "mastery_b", "attempt_count", "last_examined", "calibration_log") + FSRS_KEYS
   310	_keycount = {}
   311	for _mm in re.finditer(r'^([A-Za-z_][A-Za-z0-9_-]*):', fm, re.M):
   312	    _keycount[_mm.group(1)] = _keycount.get(_mm.group(1), 0) + 1
   313	_dupkeys = sorted(k for k, c in _keycount.items() if c > 1 and k in _watched)
   314	if _dupkeys:
   315	    raise SystemExit(f"[quiz-answer] frontmatter 重复键 {_dupkeys} (解析歧义不可证), fail-closed 拒写 — 请手工修复节点后重跑")
   316	
   317	# ── G3-2 幂等分诊前置判定。两个独立域:
   318	#   F1 = 本 event_id 已在 frontmatter calibration_log (解析层判定, 非子串 —
   319	#        live 实证 Obsidian 会把 yaml 引号规范化掉, json.dumps 子串恒不命中;
   320	#        双引号形态经 json.loads 与写侧 json.dumps 同源反解, 单引号/裸词剥引号)
   321	#   L1 = 账本已有 parsed event_id == evid 的行 (parsed-field equality, 禁子串)
   322	# ⛔ F1 单独不能证明 FSRS 已推进 (degraded 落账写过 calibration 但没写 W —
   323	# Codex round-2 BLOCKER): 「已应用」的机械判据是 W >= durable.review_time,
   324	# 分诊在下方主流程里做, 这里只放解析函数。
   325	def _fm_has_event(fm_text, ev_id):
   326	    mcal = re.search(r'^calibration_log:[ \t]*$', fm_text, re.M)
   327	    if not mcal:
   328	        return False
   329	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   330	        if ln and not ln[0].isspace():
   331	            break
   332	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   333	        if mm:
   334	            v = mm.group(1).strip()
   335	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   336	                try:
   337	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   338	                except ValueError:
   339	                    pass
   340	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   341	                v = v[1:-1]
   342	            if v == ev_id:
   343	                return True
   344	    return False
