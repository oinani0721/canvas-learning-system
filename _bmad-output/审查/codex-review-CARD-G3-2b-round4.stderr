   457	    assert pl["schema_ext"] == "review/1"
   458	    assert pl["vault_id"] == "canvas_vault_测试", "vault_id 必须是 sanitize 规范化形式"
   459	    assert pl["concept_id"] == rec["node_id"]
   460	    assert pl["review_time"] == rec["effective_at"]
   461	    # golden 绑定: 非 degraded 时与 manifest 真值相等 (校验器已查, 这里锁键存在)
   462	    manifest = json.loads((WT / "backend" / "tests" / "regression" / "fsrs_golden_manifest.json").read_text())
   463	    assert pl["fsrs_library_version"] == manifest["library_version"]
   464	    assert pl["fsrs_params_hash"] == manifest["params_hash"]
   465	    # rating 与 grade_norm 同源 (bridge rating_from_grade 口径, 档界 GN2=0.75→3)
   466	    assert pl["rating"] == 3 and pl["grade_norm"] == 0.75
   467	    assert _fm_fields(vault)["fsrs_last_review"] == pl["review_time"], "W 必须等于 review_time"
