   502	# ── 门⑫ 裁决② degraded: 事件仍落账 + 哨兵成对 + W 不推进 ──
   503	
   504	
   505	def test_fsrs_unavailable_degraded_sentinels_pair_and_w_frozen(vault):
   506	    """FSRS_BRIDGE_REEXEC=1 阻断 re-exec; bridge 子进程用系统 python3
   507	    (无 fsrs, 本机实证) → 诚实 exit 3 → 裁决②路径。"""
   508	    r = _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"})
   509	    assert r.returncode == 0, r.stdout + r.stderr
   510	    assert "degraded" in r.stdout
   511	    rec = _ledger_lines(vault)[0]
   512	    pl = rec["payload"]
   513	    assert pl["fsrs_library_version"].startswith("degraded:"), "库版本必须填哨兵"
   514	    assert pl["fsrs_params_hash"].startswith("degraded:"), "参数 hash 必须填哨兵"
   515	    assert pl["fsrs_library_version"] == pl["fsrs_params_hash"], "两键哨兵必须成对 (同因)"
   516	    assert pl["fsrs_library_version"][len("degraded:") :].strip(), "哨兵原因必须非空"
   517	    assert not _fm_fields(vault), "degraded 不得写任何 fsrs_* 字段 (W 不推进)"
   518	    assert "mastery_score" in _fm(vault), "衰减 Beta 照常写"
   519	    assert _run_validator(vault).returncode == 0, "哨兵成对产物必须过校验器"
   520	    # degraded 事件 review_time > W(无 W = -inf) → 留 pending; fsrs 恢复后
   521	    # 下次评分的 A2 会自动补应用 (write-ahead 的价值, 产品可见)
   522	
   523	
   524	# ── 门⑬ 耐久序列 + 写序 (A4.3/A4.4): spy 调用序列 ──
   525	# ⚠️ 本门证明耐久序列**被调用** (fsync 覆盖账本/temp/父目录, append fsync 先于
   526	# os.replace), 不证明掉电后数据存活 — 后者需真实断电, 不在本卡。
   527	
   528	
   529	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   530	    events: list[tuple] = []
   531	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   532	
   533	    def spy_fsync(fd):
   534	        try:
   535	            st = os.fstat(fd)
   536	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   537	            events.append(("fsync", kind, st.st_ino))
   538	        except OSError:
   539	            events.append(("fsync", "unknown", -1))
   540	        return real_fsync(fd)
   541	
   542	    def spy_replace(src, dst):
   543	        events.append(("replace", str(src), str(dst)))
   544	        return real_replace(src, dst)
   545	
   546	    monkeypatch.setattr(os, "fsync", spy_fsync)
   547	    monkeypatch.setattr(os, "replace", spy_replace)
   548	    monkeypatch.chdir(vault)
   549	    saved_path = list(sys.path)
   550	    saved_modules = {
   551	        k: sys.modules.pop(k) for k in ("fsrs_bridge", "decay_beta", "validate_learning_events") if k in sys.modules
   552	    }
   553	    try:
   554	        exec(compile(_writer_code(vault, _payload()), "quiz-answer-SKILL-extract", "exec"), {})
   555	    except SystemExit as e:
   556	        assert e.code in (0, None), f"静态块异常退出: {e.code}"
   557	    finally:
   558	        sys.path[:] = saved_path
   559	        sys.modules.pop("fsrs_bridge", None)
   560	        sys.modules.pop("decay_beta", None)
   561	        sys.modules.pop("validate_learning_events", None)
   562	        sys.modules.update(saved_modules)
   563	
   564	    ledger, node = vault / "learning_events.jsonl", vault / NODE_REL
   565	    ledger_ino, node_ino = ledger.stat().st_ino, node.stat().st_ino
   566	    fsyncs = [e for e in events if e[0] == "fsync"]
   567	    replaces = [e for e in events if e[0] == "replace"]
   568	    assert len(replaces) == 1, f"恰一次原子发布, 实得 {len(replaces)}"
   569	    replace_idx = events.index(replaces[0])
   570	    # 账本 fsync (file) 与 temp fsync (temp inode == 发布后节点 inode)
   571	    fsynced_files = {e[2] for e in fsyncs if e[1] == "file"}
   572	    assert ledger_ino in fsynced_files, "账本 fd 必须 fsync (A4.3)"
   573	    assert node_ino in fsynced_files, "temp fd 必须 fsync (A4.4; replace 保留 inode)"
   574	    dir_count = sum(1 for e in fsyncs if e[1] == "dir")
   575	    assert dir_count >= 2, f"首建账本父目录 + 节点父目录均须 fsync, 实得 dir fsync {dir_count} 次"
   576	    # Codex round-1 验证限制: dir fsync 必须绑定两个**不同**目录 inode
   577	    # (VAULT 根 = 账本父目录, 节点/ = 节点父目录), 不是同一目录刷两次
   578	    dir_inodes = {e[2] for e in fsyncs if e[1] == "dir"}
   579	    assert len(dir_inodes) >= 2, f"两个不同父目录都要 fsync, 实得 {len(dir_inodes)} 个 inode"
   580	    assert vault.stat().st_ino in dir_inodes, "账本父目录 (VAULT 根) 必须 fsync"
   581	    assert (vault / "节点").stat().st_ino in dir_inodes, "节点父目录必须 fsync"
   582	    # 写序: 账本 durable 必须先于 os.replace (真 write-ahead, 非改名)
   583	    ledger_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == ledger_ino)
   584	    temp_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == node_ino)
   585	    assert ledger_fsync_idx < replace_idx, "账本 fsync 必须先于 frontmatter 发布 (A1 write-ahead)"
   586	    assert temp_fsync_idx < replace_idx, "temp fsync 必须先于 os.replace (A4.4)"
   587	
