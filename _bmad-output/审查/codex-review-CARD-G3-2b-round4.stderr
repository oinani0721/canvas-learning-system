  1378	def test_self_audit_coverage_gaps(vault):
  1379	    import subprocess
  1380	    import unicodedata
  1381	
  1382	    # ① 分层防线的另一半：门㉕ 只测「篡改身份键的值」，没测「删掉整个键」。
  1383	    # 删键后 envelope 照样放行（两键排除出等价面 = 有意），必须由 validator 兜住。
  1384	    r = _run_writer(vault, _payload())
  1385	    assert r.returncode == 0, r.stdout + r.stderr
  1386	    base = _ledger_lines(vault)[0]
  1387	    assert _run_validator(vault).returncode == 0, "基线：完整行必须过校验器"
  1388	    for key in ("fsrs_library_version", "fsrs_params_hash"):
  1389	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
