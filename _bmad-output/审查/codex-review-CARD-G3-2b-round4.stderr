  1237	    sha_stripped = _sha(vault / NODE_REL)
  1238	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1239	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1240	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1241	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1242	
