golden_sha = ce.sha(v / ce.NODE_REL)
row = ce.rows(v)[0]
(v / ce.NODE_REL).write_text(ce.NODE_V0, encoding=\"utf-8\")
row[\"effective_at\"] = \"2026-08-09T10:00:00Z\"; row[\"payload\"][\"review_time\"] = \"2026-08-09T10:00:00Z\"
ce.write_rows(v, row)
r = ce.run(v, event_id=\"time#q1\", ts=T1)
show(\"CASE-time-self-copy\", writer_rc=r.returncode, stderr=tail(r), W=field(v,\"fsrs_last_review\"), bytes_equal=(ce.sha(v / ce.NODE_REL)==golden_sha), validator=verdict(v))

# 6. 换未入账参数：同一 durable 事件恢复成功但整节点字节不同。
v = ce.new_vault(\"06-byte-params\")
call_a = \"> ["'!note]'"\\n> CALL_A\"
call_b = \"> ["'!note]'"\\n> CALL_B\"
r0 = ce.run(v, event_id=\"bytes#q1\", ts=T1, question_id=\"q1\", self_confidence_raw=\"半懂\", self_confidence_norm=0.5, callout=call_a)
golden_sha = ce.sha(v / ce.NODE_REL)
(v / ce.NODE_REL).write_text(ce.NODE_V0, encoding=\"utf-8\")
r = ce.run(v, event_id=\"bytes#q1\", ts=\"2026-09-01T10:00:00Z\", question_id=\"q2\", self_confidence_raw=\"全懂\", self_confidence_norm=1.0, callout=call_b)
show(\"CASE-byte-params\", initial_rc=r0.returncode, recovery_rc=r.returncode, bytes_equal=(ce.sha(v / ce.NODE_REL)==golden_sha), has_A=(\"CALL_A\" in note(v)), has_B=(\"CALL_B\" in note(v)), q2=(\"question_id: \\\"q2\\\"\" in note(v)))

# 7. 可解析但不可路由/目标 payload 缺失：consumer 放行，validator 拒。
