   447	# ── 门⑨ 产物过校验器 (含 golden 绑定) + vault_id 规范化 ──
   448	
   449	
   450	def test_ledger_passes_validator_with_golden_binding(vault):
   451	    r = _run_writer(vault, _payload())
   452	    assert r.returncode == 0, r.stdout + r.stderr
   453	    v = _run_validator(vault)
