   480	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   481	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   482	def _bridge(fm_text, gn, ab, ts, rating=None):
   483	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   484	    if rating is not None:
   485	        payload_in["rating"] = rating
   486	    try:
   487	        _r = subprocess.run(
   488	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   489	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
