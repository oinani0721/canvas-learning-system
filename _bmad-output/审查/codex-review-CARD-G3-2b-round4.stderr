   299	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   300	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
   301	    assert r2.returncode == 0, r2.stdout + r2.stderr
   302	    assert len(_ledger_lines(vault)) == 1, "恢复路径不得二次 append"
   303	    assert (vault / NODE_REL).read_bytes() == golden_bytes, (
   304	        "恢复产物必须与直接应用逐字节相同 (side effects 以 durable review_time 为基准)"
   305	    )
   306	    assert "A2 重放已应用" in r2.stdout or "崩溃窗口" in r2.stdout
