  1139	    assert "完整写入的损坏行" in r.stderr, r.stderr
  1140	    assert _sha(vault / NODE_REL) == sha, "零写节点"
  1141	    assert len(ledger.read_text(encoding="utf-8").splitlines()) == 2, "零写账本"
  1142	    # ②同一坏行去掉终止 LF → 仍按截断自愈容忍 (对照, 防本门变成「坏行恒拒」)
  1143	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
