   293	            r.returncode != 0 and "不自洽" in r.stderr and sha(v / NODE_REL) == s and len(rows(v)) == 1,
   294	            f"rc={r.returncode} 账本={len(rows(v))}行 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   295	        )
   296	    write_rows(v, _pending_row())
   297	    r = run_settled(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   298	    check("R5/验伪-契约值3 照常重放", r.returncode == 0 and len(rows(v)) == 2, f"rc={r.returncode}")
