   868	    if p.get("source_board") and not re.search(r'^source_board:', fm, re.M):
   869	        fm = fm.rstrip() + '\nsource_board: ' + json.dumps(p["source_board"], ensure_ascii=False)
   870	    if f1:
   871	        # degraded 遗留 (f1=T): mastery/calibration 已应用 — 只补 FSRS。
   872	        # 再算一次 EMA 会双吃成绩 (round-2 场景②: 首评 degraded 后重试)。
   873	        print(f"[quiz-answer] A2 恢复(degraded 遗留): 仅补 FSRS @ {review_time}, EMA/校准不重复应用")
   874	    else:
   875	        # 崩溃窗口① (f1=F): 评分链其余副作用全部未应用 → 全套补齐
   876	        old, A, B, new = _apply_mastery(fm, review_time)
   877	        # attempt 权威值取 durable 行本身 (dup 自己刚被 A2 重放写进 fm, 再 +1
   878	        # 会双加)。恢复 = 复现首次成功时写下的那个值, 不是「再记一次」。
   879	        _dup_att = _dpl.get("attempt_count")
   880	        if isinstance(_dup_att, int) and not isinstance(_dup_att, bool) and _dup_att >= 0:
   881	            n_att = _dup_att
   882	        else:
   883	            mo_att = re.search(_ATT_RE, fm, re.M)
   884	            n_att = (int(mo_att.group(1)) if mo_att else 0) + 1
   885	        fm = re.sub(r'^(mastery_score|mastery|mastery_level|mastery_a|mastery_b|attempt_count|last_examined):.*\r?\n?', '', fm, flags=re.M)
   886	        fm = re.sub(r'^(type:.*)$', lambda x: x.group(1) + f"\nmastery_score: {new}\nmastery_a: {round(A, 4)}\nmastery_b: {round(B, 4)}\nattempt_count: {n_att}\nlast_examined: " + json.dumps(review_time, ensure_ascii=False), fm, count=1, flags=re.M)
   887	        fm = _append_calibration(fm, review_time)
