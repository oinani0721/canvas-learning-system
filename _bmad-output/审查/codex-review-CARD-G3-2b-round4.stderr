     9	  - recorded_at / effective_at: 双时间戳 (记录时刻 vs 业务生效时刻,
    10	    补录历史事件时两者分离)
    11	  - event_type: 限 9 类核心动作 (EVENT_TYPES), 未知类型拒绝 — 防事件膨胀
    12	    (callout_ingested 2026-07-23 对账评审入集后 "8 类" 注释曾未同步)
    13	
    14	写点 (批次3' 接入 4 个, node_derived 留批次4' 拆分补强):
    15	  backend: candidate_created (蒸馏) / candidate_accepted / candidate_disputed
    16	           (= dispute 三件套第三件「可追溯」suppression log) / session_archived
    17	  vault:   answer_scored / answer_abandoned (quiz-answer) / exam_created
    18	           (start-exam-board) — SKILL 静态 python 直接 append 同一文件
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import json
    24	import logging
    25	import os
    26	import threading
    27	from datetime import datetime, timezone
    28	from pathlib import Path
    29	from typing import Any, Optional
    30	
    31	logger = logging.getLogger(__name__)
    32	
    33	EVENT_VERSION = 1
    34	
    35	#: 核心动作白名单 — 新增类型必须走对账评审, 不得随手扩
    36	#: (callout_ingested 经 2026-07-23 燃料策略对账批次5' 方案评审加入)
    37	EVENT_TYPES = frozenset(
    38	    {
    39	        "node_derived",
    40	        "exam_created",
    41	        "answer_scored",
    42	        "answer_abandoned",
    43	        "candidate_created",
    44	        "candidate_accepted",
    45	        "candidate_disputed",
    46	        "session_archived",
    47	        "callout_ingested",
    48	    }
    49	)
    50	
    51	_write_lock = threading.Lock()
    52	
    53	
    54	def _log_path() -> Path:
    55	    from app.config import settings
    56	
    57	    canvas_base = getattr(settings, "CANVAS_BASE_PATH", None) or "/vaults/canvas-vault"
    58	    return Path(canvas_base) / "learning_events.jsonl"
    59	
    60	
    61	def append_event(
    62	    event_type: str,
    63	    event_id: str,
    64	    node_id: str = "",
    65	    payload: Optional[dict[str, Any]] = None,
    66	    effective_at: Optional[str] = None,
    67	) -> bool:
    68	    """append-only 落一条学习事件; event_id 已存在 → 幂等跳过。
    69	
    70	    永不抛异常 (记录失败不得影响主链) — 返回 False 表示未写入
    71	    (幂等跳过或 IO 失败, 区别见日志)。
    72	    """
    73	    try:
    74	        if event_type not in EVENT_TYPES:
    75	            logger.warning("[learning-events] 拒绝未知 event_type=%r (9 类白名单)", event_type)
    76	            return False
    77	        if not event_id:
    78	            logger.warning("[learning-events] 拒绝空 event_id (幂等键必填)")
    79	            return False
    80	
    81	        path = _log_path()
    82	        path.parent.mkdir(parents=True, exist_ok=True)
    83	
    84	        with _write_lock:
    85	            # 幂等: 文件内已有该 event_id → 跳过 (日志量级小, 全文扫描可接受;
    86	            # 大文件时可换尾部 N 行 + 索引)。
    87	            # G3-2 (CARD-G3-2, schema §二/§6.2 A4.5): 查重改为 parsed-field
    88	            # equality — 原子串匹配 (`json.dumps(event_id) in line`) 在任意
    89	            # 历史行 payload 文本恰好含该 JSON 串形时会把新事件误判 duplicate
    90	            # 而**零次落账** (丢一次真实事实)。幂等语义不变 (event_id 唯一),
    91	            # 只修正查重实现的正确性; 无法解析的行不算命中 (留痕后跳过)。
    92	            if path.exists() and path.stat().st_size > 0:
    93	                # (round-2 HIGH: 空文件 seek(-1, SEEK_END) 抛 OSError, 守卫
    94	                # 必须 size>0 才读尾字节 — 否则首事件永远写不进去)
    95	                with open(path, encoding="utf-8") as f:
    96	                    for line in f:
    97	                        try:
    98	                            record = json.loads(line)
    99	                        except ValueError:
   100	                            # 坏行 (截断/损坏) 不构成 duplicate 证据, 但要留痕
   101	                            logger.warning(
   102	                                "[learning-events] 账本存在无法解析的行 (截断/损坏), 查重跳过该行: %r", line[:80]
   103	                            )
   104	                            continue
   105	                        if isinstance(record, dict) and record.get("event_id") == event_id:
   106	                            return False
   107	                # G3-2 LF 守卫 (schema §二 截断自愈): 尾行无换行时先补 LF 再
   108	                # 追加 — 否则新事件粘进坏行连坐损坏 (Codex round-1 HIGH:
   109	                # 预置 partial JSON 后 append 会把两个 JSON 粘成一行坏行)。
   110	                with open(path, "rb") as bf:
   111	                    bf.seek(-1, os.SEEK_END)
   112	                    if bf.read(1) != b"\n":
   113	                        with open(path, "a", encoding="utf-8") as tf:
   114	                            tf.write("\n")
   115	                        logger.warning("[learning-events] 检测到无换行结尾的尾行 (疑似截断), 已补 LF 隔离后再追加")
   116	            now = datetime.now(timezone.utc).isoformat()
   117	            record = {
   118	                "event_id": event_id,
   119	                "event_version": EVENT_VERSION,
   120	                "event_type": event_type,
   121	                "node_id": node_id,
   122	                "recorded_at": now,
   123	                "effective_at": effective_at or now,
   124	                "payload": payload or {},
   125	            }
   126	            with open(path, "a", encoding="utf-8") as f:
   127	                f.write(json.dumps(record, ensure_ascii=False) + "\n")
   128	        return True
   129	    except Exception as e:  # noqa: BLE001 — 日志兜底, 不炸主链
   130	        logger.warning("[learning-events] append 失败 (主链不受影响): %s", e)
   131	        return False
