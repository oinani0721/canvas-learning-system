   576	    if not isinstance(_pl, dict):
   577	        continue
   578	    if _o.get("node_id") != node_id:
   579	        continue
   580	    if _pl.get("schema_ext") != "review/1":
   581	        # ⛔ 降级绕过封堵 (§6.1, 与校验器同口径): 本节点的行只有在**既没有
   582	        # schema_ext、也没有任何扩展键**时才是真·历史行 (§6.3, 旧写点产物,
   583	        # 不进 pending)。marker 拼错或被抹掉却带着扩展键 —— 那是一次真实复习
   584	        # 被伪装成历史行, 静默跳过它就是永久漏算。
   585	        # 实测反例: 把 schema_ext 改成 "review/01", writer 照常 rc=0 且账本
   586	        # 两行, 但那次复习完全消失 (fsrs_state 1 而非 2, due 差一周);
   587	        # 同一种坏行带**本次** id 会被 dup 分支拦下, 带别人的 id 就静默丢 ——
   588	        # 同一份数据两种命运, 正是 §6.1 要封的那个口子。
   589	        # ⚠️ 判据只看「marker 在不在」，**不看 payload 带了哪些键** —— 与校验器
   590	        # 逐字同源。§6.3 的历史行本来就可能带 grade_norm / attempt_count /
   591	        # exam_board（旧写点产物），校验器对无 marker 行**不判** payload 键集；
   592	        # 我第一版按「带扩展键就算降级」写，当场误伤了门⑭ 的合法历史行 fixture
   593	        # —— 这是本卡第四次「实现比契约严」，判据必须收回到契约那条线上。
   594	        # 📌 如实登记的缺口：把 marker **整个抹掉**、只留扩展键的行，两侧（写点与
   595	        #    校验器）都会当历史行放过。要堵它得先改契约 §6.3 的键集豁免，
   596	        #    单侧收紧只会再造一次口径分叉 ⇒ 移交，不在本卡修。
   597	        if "schema_ext" in _pl:
   598	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行 (本节点) 的 schema_ext={_pl.get('schema_ext')!r} 不是 'review/1' — §6.1 禁止以未知 marker 降级绕过扩展校验; 静默把它当历史行跳过等于漏算一次真实复习, fail-closed 拒写")
