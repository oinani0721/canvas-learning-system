show(\"CASE-missing-payload\", writer_rc=r.returncode, ledger_ids=[x.get(\"event_id\") for x in ce.rows(v)], validator=verdict(v))

# 8. review_time 首尾空白被 strip 接受；validator 按原字面拒。
v = ce.new_vault(\"09-time-space\")
row = ce._pending_row(); spaced = \" 2026-08-01T10:00:00Z \"; row[\"payload\"][\"review_time\"] = spaced; row[\"effective_at\"] = spaced
ce.write_rows(v, row)
r = ce.run_settled(v, event_id=\"fresh-space#q1\", ts=T2)
show(\"CASE-time-space\", writer_rc=r.returncode, W=field(v,\"fsrs_last_review\"), validator=verdict(v))

# 9. bool event_version 被 True==1 当 v1 消费；validator 拒。
v = ce.new_vault(\"10-bool-version\")
