import copy, importlib.util, json, os, re, subprocess, sys
from pathlib import Path

WT = Path.cwd()
sp = importlib.util.spec_from_file_location(\"ce\", WT / \"backend/scripts/g32b_r1r7_counterexamples.py\")
ce = importlib.util.module_from_spec(sp)
sp.loader.exec_module(ce)
ce.CE_ROOT = Path(\"/private/tmp/codex-card-w7-ledger.pI3Db3/manual-cases\")
ce.CE_ROOT.mkdir(parents=True, exist_ok=True)

T1 = \"2026-08-01T10:00:00Z\"
T2 = \"2026-08-02T10:00:00Z\"
T3 = \"2026-08-03T10:00:00Z\"

def note(v): return (v / ce.NODE_REL).read_text(encoding=\"utf-8\")
def field(v, key):
    m = re.search(rf'"'^{re.escape(key)}:'"\\s*[\\\"\\']?(["'^'"\\\"\\'\\n]+)[\\\"\\']?\\s*"'$'"', note(v), re.M)
    return m.group(1).strip() if m else None
def cal_ids(v): return re.findall(r'"'^'"\\s*-\\s*event_id:\\s*(.+?)\\s*"'$'"', note(v), re.M)
def verdict(v):
    q = subprocess.run([sys.executable, str(ce.VALIDATOR), str(v / \"learning_events.jsonl\")], capture_output=True, text=True)
    first = next((x for x in q.stdout.splitlines() if \"LINE \" in x), \"\")
    return q.returncode, first[:180]
def tail(r): return (r.stderr.strip().splitlines() or r.stdout.strip().splitlines() or [\"\"])[-1][:220]
def show(tag, **vals): print(tag + \" \" + json.dumps(vals, ensure_ascii=False, sort_keys=True))

# 1. 扩展键仍在但 marker 整体被删：consumer 跳过，validator 拒。
v = ce.new_vault(\"01-markerless\")
row = ce._pending_row()
row[\"event_id\"] = \"quiz:markerless#q1\"
row[\"payload\"].pop(\"schema_ext\")
ce.write_rows(v, row)
r = ce.run(v, event_id=\"fresh#q1\", ts=T2)
show(\"CASE-markerless\", writer_rc=r.returncode, ledger_ids=[x.get(\"event_id\") for x in ce.rows(v)], W=field(v,\"fsrs_last_review\"), calibration=cal_ids(v), validator=verdict(v))

# 2. 多 pending：current dup 在前、foreign 在后；首轮越过 current，次轮永久停。
v = ce.new_vault(\"02-current-first\")
e1 = ce._pending_row(); e1[\"event_id\"] = \"quiz:current#q1\"; e1[\"payload\"][\"exam_board\"] = \"检验白板/测试检验-2026-08-01-1000.md\"
e2 = ce._pending_row(); e2[\"event_id\"] = \"quiz:foreign#q1\"; e2[\"recorded_at\"] = T2; e2[\"effective_at\"] = T2; e2[\"payload\"][\"review_time\"] = T2; e2[\"payload\"][\"attempt_count\"] = 2; e2[\"payload\"][\"exam_board\"] = \"检验白板/foreign.md\"
ce.write_rows(v, e1, e2)
r1 = ce.run(v, event_id=\"current#q1\", ts=T1)
state1 = dict(rc=r1.returncode, W=field(v,\"fsrs_last_review\"), attempt=field(v,\"attempt_count\"), calibration=cal_ids(v), stderr=tail(r1))
r2 = ce.run(v, event_id=\"current#q1\", ts=T1)
show(\"CASE-current-first\", first=state1, second_rc=r2.returncode, second_stderr=tail(r2), ledger_ids=[x.get(\"event_id\") for x in ce.rows(v)])

# 3. full event_id -> bare calibration 的非单射：quiz:x 与 x 共用 calibration x。
v = ce.new_vault(\"03-id-collision\")
r0 = ce.run(v, event_id=\"x\", ts=T1)
base = ce.rows(v)[0]
mastery_before = field(v,\"mastery_score\")
foreign = copy.deepcopy(base)
foreign[\"event_id\"] = \"x\"; foreign[\"recorded_at\"] = T2; foreign[\"effective_at\"] = T2
foreign[\"payload\"][\"review_time\"] = T2; foreign[\"payload\"][\"attempt_count\"] = 2; foreign[\"payload\"][\"exam_board\"] = \"检验白板/foreign-x.md\"
ce.write_rows(v, base, foreign)
r1 = ce.run(v, event_id=\"y\", ts=T3)
show(\"CASE-id-collision\", initial_rc=r0.returncode, recovery_rc=r1.returncode, recovery_stderr=tail(r1), mastery_before=mastery_before, mastery_after=field(v,\"mastery_score\"), W=field(v,\"fsrs_last_review\"), attempt=field(v,\"attempt_count\"), calibration=cal_ids(v), validator=verdict(v))

# 4. 单调 max 掩盖 ordinal：已有 99，pending 声称 1；恢复不加，随后新评分只到 100。
node99 = ce.NODE_V0.replace(\"mastery_score: 0.5\\n\", \"mastery_score: 0.5\\nattempt_count: 99\\n\")
v = ce.new_vault(\"04-ordinal-max\", node99)
pending = ce._pending_row(); pending[\"event_id\"] = \"quiz:old-pending#q1\"
ce.write_rows(v, pending)
r1 = ce.run(v, event_id=\"new#q1\", ts=T2)
after_replay = field(v,\"attempt_count\")
r2 = ce.run(v, event_id=\"new#q1\", ts=T2)
show(\"CASE-ordinal-max\", first_rc=r1.returncode, after_replay=after_replay, second_rc=r2.returncode, final_attempt=field(v,\"attempt_count\"), ledger_attempts=[x.get(\"payload\",{}).get(\"attempt_count\") for x in ce.rows(v)], calibration=cal_ids(v), validator=verdict(v))

# 5. candidate 时刻取 durable：同时篡改 effective_at/review_time 不冲突，validator 也通过。
v = ce.new_vault(\"05-time-self-copy\")
