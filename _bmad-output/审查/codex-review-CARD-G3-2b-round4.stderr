   383	            "payload": {"exam_board": "检验白板/旧板.md"},
   384	        },
   385	        ensure_ascii=False,
   386	    )
   387	    torn = '{"event_id": "quiz:被截断的事件", "event_version": 1, "event_ty'
   388	    ledger.write_text(full + "\n" + torn, encoding="utf-8")  # 第二行为 partial JSON, 无尾 LF
   389	    r = _run_writer(vault, _payload())
   390	    assert r.returncode == 0, r.stdout + r.stderr
   391	    assert "截断尾行" in r.stdout, "截断尾行必须留痕"
   392	    lines = [ln for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   393	    assert len(lines) == 3, f"新事件必须独立成行 (LF 守卫隔离截断行), 实得 {len(lines)} 行"
   394	    assert json.loads(lines[0])["event_id"] == "exam:旧板", "完整旧行必须原样保留"
   395	    assert json.loads(lines[2])["event_id"] == "quiz:" + EID, "新事件行必须独立可解析"
   396	    # 校验器如实把坏行报 FAIL (审计暴露损坏), 但坏行不连坐新行
   397	    v = _run_validator(vault)
   398	    assert v.returncode == 1 and "JSON 解析失败" in v.stdout, "坏行必须被校验器如实暴露"
