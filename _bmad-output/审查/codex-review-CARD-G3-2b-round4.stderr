   523	        _e_qid = q_(p.get("question_id", "q1"))
   524	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   525	    else:
   526	        _e_pl = ev.get("payload") or {}
   527	        _raw_id = str(ev.get("event_id") or "")
   528	        _e_id = _raw_id[5:] if _raw_id.startswith("quiz:") else _raw_id
   529	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   530	        _e_qid, _e_scr, scn_ = "null", "null", None
   531	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   532	              f'    ts: {q_(ts_str)}\n'
   533	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   534	              f'    question_id: {_e_qid}\n'
   535	              f'    self_confidence_raw: {_e_scr}\n'
   536	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   537	              f'    grade_norm: {_e_gn}\n'
   538	              f'    abandoned: {"true" if _e_ab else "false"}')
   539	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   540	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   541	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
