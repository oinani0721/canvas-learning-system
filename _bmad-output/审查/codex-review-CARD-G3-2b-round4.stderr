  1629	    # ③ 分层成立（非缺陷，锁住）：rating 自洽门不会误拒任何**旧版合法写入**的行。
  1630	    # grade_norm 落盘的是 round(GN,2)，分档边界要 gn = 1/6、1/2、5/6，只有 1/2 是精确
  1631	    # 两位小数，而 1.0+3.0*0.5 == 2.5 走 `g < 2.5` 为 False ⇒ 稳定落在 3。
  1632	    sys.path.insert(0, str(VAULT_SCRIPTS))
  1633	    try:
  1634	        import fsrs_bridge as fb
  1635	
  1636	        # ⚠️ 原写法是「同一函数对 json 往返前后的同一个值给出相同结果」——
  1637	        # CPython 的 float repr 是最短往返, 两侧实参**逐比特相同**, 于是该断言
  1638	        # 恒真: 把 rating_from_grade 换成「恒返回 1」或「二值化」都照样绿
  1639	        # (实测三个实现全通过)。期望值必须有**独立来源**: 这里直接写 §6.1
  1640	        # [Decision-FSRS-1] 的分档契约值 (g = 1 + 3·gn, 按 1.5/2.5/3.5 落四档)。
  1641	        for gn, expect in ((0.0, 1), (0.16, 1), (0.17, 2), (0.49, 2), (0.5, 3), (0.83, 3), (0.84, 4), (1.0, 4)):
  1642	            got = fb.rating_from_grade(gn, False)
  1643	            assert got == expect, f"grade_norm {gn} 的契约档位是 {expect}, 实为 {got}"
  1644	        assert fb.rating_from_grade(0.5, False) == 3, "边界 gn=0.5 必须稳定落 3（1+3*0.5 恰为 2.5，走 g<2.5 为假）"
  1645	        # 往返稳定性单独验一次（这一条本身不承担分档正确性）
  1646	        for cents in (0, 17, 50, 84, 100):
  1647	            gn = cents / 100.0
  1648	            assert float(json.loads(json.dumps(gn))) == gn, f"{gn} JSON 往返不精确"
  1649	    finally:
  1650	        sys.path.remove(str(VAULT_SCRIPTS))
  1651	        sys.modules.pop("fsrs_bridge", None)
