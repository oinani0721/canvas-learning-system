  1241	        return None
  1242	    try:
  1243	        data = json.loads(candidate.read_text(encoding="utf-8"))
  1244	    except (OSError, ValueError, RecursionError):
  1245	        return None
  1246	    if not isinstance(data, dict):
  1247	        return None
  1248	    version, params_hash = data.get("library_version"), data.get("params_hash")
  1249	    # round-5 MEDIUM: 只查"是字符串"不够 — 空串或畸形值会让真值绑定形同虚设
  1250	    if not isinstance(version, str) or not _VERSION_RE.match(version):
