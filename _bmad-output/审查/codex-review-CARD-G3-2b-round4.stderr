    91	    payload.update(over)
    92	    pfile = vault.parent / "payload.json"
    93	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    94	    return subprocess.run(
    95	        [sys.executable, "-c", CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))],
    96	        capture_output=True,
    97	        text=True,
    98	        timeout=180,
    99	        cwd=str(vault),
   100	        env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"),
   101	    )
