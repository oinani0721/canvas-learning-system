   346	# ── G3-2 账本读取 (parsed)。⚠️ 单写者前提 (G3-3 前无锁): 同一 vault 内不得
   347	# 并行运行任何两个 quiz-answer (账本 per-vault 共享文件, 与是否同节点无关,
   348	# schema §6.2 A4.5) — 本块无任何互斥, 并行会在「读-算-写」间隙双写/丢失。
   349	# 尾行截断 (崩溃产物, §二 截断自愈) → 跳过并留痕, 由追加前 LF 守卫隔离;
   350	# 中间坏行 = 真实损坏 → fail-closed 人工介入。
   351	# Codex round-3 MEDIUM (R7): 「可容忍的截断」必须同时满足 ①是最后一行 ②文件
   352	# **不以 LF 结尾**。带终止 LF 的坏末行是**完整写入后损坏**的行 (write 已整行
   353	# 提交), 不是被腰斩的半行 — 旧实现只看「最后一行解析失败」, 于是真实损坏被
   354	# 当截断容忍, writer 照常 rc=0 追加并推进节点。EOF 的 LF 状态是区分二者的
   355	# 唯一机械证据, 读取时必须保留。
   356	# ⛔ 必须二进制读: 文本模式的 universal newlines 会把裸 \r 与 \r\n 都读成 \n,
   357	# 于是「EOF 有没有 LF」这个**字节**判据在解析层就已失真 —— 以裸 \r 结尾的
   358	# 截断文件会被误判成「完整写入的损坏行」而 fail-closed (实测)。追加侧的 LF
   359	# 守卫读的正是最后一个字节, 两处判据必须同源。行切分同样严格按 LF (JSONL 定义)。
   360	_rows = []
   361	if os.path.exists(EV):
   362	    # ⛔ 按**字节**切行再逐行 decode, 不整文件 decode。三个理由:
   363	    # ① 文本模式 open(encoding=) 的 universal newlines 会把裸 \r 与 \r\n 都读成
   364	    #    \n, 「EOF 有没有 LF」这个字节判据在解析层就失真;
   365	    # ② 整文件 decode 一失败就全盘 fail-closed, 而**腰斩一个多字节字符**恰恰是
   366	    #    最典型的崩溃产物 —— 切口落在 ASCII 处能自愈、落在 CJK 字符中间就把工具
   367	    #    永久卡死, 同一种崩溃两种命运。逐行 decode 让自愈路径对两者都可达;
   368	    # ③ 首行可能带 BOM (别的编辑器存过)。BOM 是编码标记不是内容, 整文件 decode
   369	    #    会把它留在首行里让 json.loads 失败, 于是一条**完整合法**的事件行被当
   370	    #    截断跳过、那次评分静默丢失。utf-8-sig 只剥文件开头的 BOM。
   371	    _raw_bytes = open(EV, "rb").read()
   372	    _byte_lines = _raw_bytes.split(b"\n")
   373	    # 判据是「**最后一个非空行**有没有终止 LF」, 不是「文件末尾有没有 LF」。
   374	    # 反例 (Codex round-2 线索 "R7 blank bug", 实测复现): 账本以 `坏行\n   ` 结尾
   375	    # (坏行后跟一个纯空白行、文件不以 LF 收尾) 时, 按文件末尾判会得出「无 LF ⇒
   376	    # 截断」, 可那个坏行明明**后面还跟着东西**, 它是完整落盘后损坏的。
   377	    # split 后: 该行索引 < len-1 ⟺ 它后面还有片段 ⟺ 它有终止 LF。
   378	    _last_idx = max((i for i, x in enumerate(_byte_lines) if x.strip()), default=-1)
   379	    _ends_with_lf = _last_idx >= 0 and _last_idx < len(_byte_lines) - 1
   380	    _n_lines = len([x for x in _byte_lines if x.strip()])
   381	    for _ln, _bline in enumerate((x for x in _byte_lines if x.strip()), 1):
   382	        try:
   383	            _line = _bline.decode("utf-8-sig" if _ln == 1 else "utf-8")
   384	        except UnicodeDecodeError as _ue:
   385	            if _ln == _n_lines and not _ends_with_lf:
   386	                print(f"[quiz-answer] 账本第 {_ln} 行为截断尾行 (崩溃产物: 半个多字节字符且无终止 LF) — 追加时 LF 守卫隔离, 不阻塞本次评分")
   387	                continue
   388	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行含非 UTF-8 字节 ({_ue}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   389	        try:
   390	            _rows.append((_ln, json.loads(_line.strip(), object_pairs_hook=_no_dup_keys)))
   391	        except _DupKey as _dk:
   392	            # 与 frontmatter 重复键同一口径 (解析层信息丢失, 责任在解析处):
   393	            # json.loads 静默取最后一个值, 于是一行里的两个 grade_norm 只有后者
   394	            # 参与 envelope 比较 —— 前者是什么无从证明。_DupKey 不继承 ValueError,
   395	            # 故不会被下面的坏行分支吞掉。
   396	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行 JSON 含重复键 {_dk} (解析层取最后一个值, 歧义不可证), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   397	        except ValueError:
   398	            if _ln == _n_lines and not _ends_with_lf:
   399	                print(f"[quiz-answer] 账本第 {_ln} 行为截断尾行 (崩溃产物: 非 JSON 且无终止 LF) — 追加时 LF 守卫隔离, 不阻塞本次评分")
   400	            else:
   401	                _why = "该行有终止 LF ⇒ 完整写入的损坏行, 非截断" if _ln == _n_lines else "中间行"
   402	                raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行损坏 (非 JSON; {_why}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   403	# 幂等键全文件唯一 (§三): 账本被外部工具写出重复 event_id 时, A2 会把两条
   404	# 同 id 行各重放一次 = 确定性二次 apply (Codex round-2 BLOCKER) → 拒写人工修复
   405	_seen_ids = {}
   406	for _, _o in _rows:
   407	    if isinstance(_o, dict):
   408	        _k = _o.get("event_id")
   409	        if isinstance(_k, str) and _k:
   410	            _seen_ids[_k] = _seen_ids.get(_k, 0) + 1
   411	_id_dupes = sorted(k for k, c in _seen_ids.items() if c > 1)
   412	if _id_dupes:
   413	    raise SystemExit(f"[quiz-answer] 账本 event_id 重复 {_id_dupes[:3]} (幂等键全文件唯一被破坏), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   414	_dup_entry = next((( _ln, _o) for _ln, _o in _rows if isinstance(_o, dict) and _o.get("event_id") == evid), None)
   415	dup = _dup_entry[1] if _dup_entry is not None else None
   416	_dup_line = _dup_entry[0] if _dup_entry is not None else None  # R3: ordinal 复算的全序键之一
   417	f1 = bool(eid) and _fm_has_event(fm, eid)
   418	
   419	# 回填 type/source_board（Dashboard 可见性，缺才补）
   420	if not re.search(r'^type:', fm, re.M):
   500	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
   501	    return None, _err
   502	
   503	def _apply_fsrs_block(fm_text, block):
   504	    fm_text = re.sub(r'^(fsrs_due|fsrs_state|fsrs_step|fsrs_stability|fsrs_difficulty|fsrs_last_review):.*\r?\n?', '', fm_text, flags=re.M)
   505	    return re.sub(r'^(type:.*)$', lambda x: x.group(1) + block, fm_text, count=1, flags=re.M)
   506	
   507	def _append_calibration(fm_text, ts_str, ev=None):
   508	    """calibration_log 条目 (正常 / 恢复 / A2 重放三路径共用)。ts_str = 业务生效
   509	    时刻 (review_time — 与 effective_at 同源, 保证恢复产物与直接应用逐字节对齐)。
   510	
   511	    ev=None ⇒ 记本次评分, 字段取本次 payload。
   512	    ev=某条 durable 行 ⇒ **复放**那次评分的校准条目, 字段取该行 payload;
   513	      question_id / self_confidence_* 不在事件载荷里, 记 null。
   514	      ⚠️ 但 event_id / ts / exam_board / grade_norm / abandoned 都在, 够让 F1
   515	      判定命中 —— 于是被恢复的那张检验白板重跑时能走「已完整应用, 幂等跳过」,
   516	      而不是撞上「FSRS 已应用但缺校准记录」的人工裁定 (审查实测: 缺了这一步,
   517	      那张白板**永久卡在** scored_pending_node_update)。
   518	    """
   519	    q_ = lambda v: json.dumps(v, ensure_ascii=False)
   520	    if ev is None:
   521	        _e_id, _e_pl = eid, p
   522	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   523	        _e_qid = q_(p.get("question_id", "q1"))
   524	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   525	    else:
   526	        _e_pl = ev.get("payload") or {}
   527	        _raw_id = str(ev.get("event_id") or "")
   528	        _e_id = _raw_id[5:] if _raw_id.startswith("quiz:") else _raw_id
   529	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   530	        _e_qid, _e_scr, scn_ = "null", "null", None
   531	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   532	              f'    ts: {q_(ts_str)}\n'
   533	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   534	              f'    question_id: {_e_qid}\n'
   535	              f'    self_confidence_raw: {_e_scr}\n'
   536	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   537	              f'    grade_norm: {_e_gn}\n'
   538	              f'    abandoned: {"true" if _e_ab else "false"}')
   539	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   540	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   541	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   542	    # 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   543	    mcal_ = re.search(r'^calibration_log:', fm_text, re.M)
   544	    if mcal_:
   545	        lines_ = fm_text.split("\n")
   546	        li_ = next(i for i, ln in enumerate(lines_) if re.match(r'^calibration_log:', ln))
   547	        j_ = li_ + 1
   548	        while j_ < len(lines_) and lines_[j_].startswith("  "):
   549	            j_ += 1
   550	        lines_[j_:j_] = entry_.split("\n")
   551	        return "\n".join(lines_)
   552	    return fm_text.rstrip() + "\ncalibration_log:\n" + entry_
   553	
   554	# ── G3-2 rating 同源: 显式算好传给 bridge (bridge 优先用显式 rating),
   555	# payload 存同一个值 — 事件内 rating/grade_norm 自洽是构造性保证。
   556	rating = rating_from_grade(GN2, bool(p.get("abandoned")))
   557	abandoned = bool(p.get("abandoned"))
   558	
   559	# ── G3-2 适用事件集 (本节点 / schema_ext=review/1 / 未标 out_of_order),
   560	# 按 (业务时刻, 行序) 升序。A2 的 pending 与 envelope 门的 attempt ordinal
   561	# 复算**共用同一集合** — 两处若各扫一遍, 「进 pending 的行」与「参与 ordinal
   562	# 计数的行」会分叉。R2 (round-3 BLOCKER): 该集合每一行都参与 W 比较,
   563	# 故逐行机械强制 UTC 整秒 (小数秒行会让同一事件反复判 pending 二次推进)。
   564	_applicable = []
   565	for _ln, _o in _rows:
   566	    _pl = _o.get("payload") if isinstance(_o, dict) else None
   567	    # payload 必须是 object (§一: v2 才可改类型)。非 dict 时旧实现抛裸
   568	    # AttributeError traceback, 不是 clean fail-closed。
   569	    if isinstance(_o, dict) and "payload" in _o and not isinstance(_pl, dict):
   570	        raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行的 payload 不是 object ({type(_pl).__name__}) — v1 冻结它为 object, fail-closed 拒写")
   571	    # ⛔ 路由信封 (schema §一「路由信封冻结」的**读方义务**, 逐字): 解析出的
   572	    # 记录若缺少可用的 node_id (任何版本), 一律视为**不可路由**并 fail-closed
   573	    # —— 不能因为「它看起来不属于本节点」就跳过, 因为恰恰无法判定归属。
   574	    if isinstance(_o, dict) and not isinstance(_o.get("node_id"), str):
