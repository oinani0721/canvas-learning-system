    45	def _venv_python() -> str | None:
    46	    """候选顺序: 相对本 vault 的仓库根 backend/.venv (worktree 与主仓副本各自
    47	    成立, Code-Review H1: 不能让 live vault 的 FSRS 写侧系于 dev worktree
    48	    存亡) → 硬编码 worktree 路径兜底。"""
