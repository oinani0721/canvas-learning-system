   928	def test_identity_tampering_caught_by_validator_not_envelope(vault):
   929	    """fsrs_library_version/params_hash 是环境快照, 排除在 envelope 等价面外
   930	    (验收单声明); 其完整性由校验器 golden 绑定门承担 — 本门锁这个分层。"""
   931	    r = _run_writer(vault, _payload())
   932	    assert r.returncode == 0, r.stdout + r.stderr
   933	    base = _ledger_lines(vault)[0]
   934	    # 回滚 frontmatter → 崩溃窗口① + 身份键被篡改的 durable 行
