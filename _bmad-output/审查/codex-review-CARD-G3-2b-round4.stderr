   350	def n1_n5():
   351	    """round-1 后续：Codex 正文被内容过滤器拦下，按 stderr 保留的推理标题线索
   352	    逐条实测出的五个残留面（4 条复现为真缺陷 + 1 条诊断不精确）。"""
   353	    print("\n── N1 (BLOCKER) 标 out_of_order 但 review_time > W：被伪装成乱序的真实后继 ──")
   354	    v = new_vault("n1")
   355	    late = _pending_row(out_of_order=True, review_time="2026-08-05T10:00:00Z")
   356	    late["effective_at"] = "2026-08-05T10:00:00Z"
   357	    write_rows(v, late)
   358	    s = sha(v / NODE_REL)
   359	    r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   360	    check(
   361	        "N1/伪装成乱序的后继",
   362	        r.returncode != 0 and "伪装成乱序的真实后继" in r.stderr and sha(v / NODE_REL) == s,
   363	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   364	    )
   365	    for bad in (False, "true", 1):
   366	        write_rows(v, _pending_row(out_of_order=bad))
   367	        rb = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   368	        check(f"N1/形态 {bad!r} 非法", rb.returncode != 0 and "形态非法" in rb.stderr, f"rc={rb.returncode}")
   369	    (v / "learning_events.jsonl").unlink()
   370	    assert run(v).returncode == 0
   371	    early = _pending_row(out_of_order=True, review_time="2026-07-01T10:00:00Z")
   372	    early["effective_at"] = "2026-07-01T10:00:00Z"
   373	    early["event_id"] = "quiz:补录旧事件"
   374	    write_rows(v, rows(v)[0], early)
   375	    ro = run(v, event_id="板C#q1", ts="2026-08-03T10:00:00Z")
   376	    check(
   377	        "N1/验伪-合法乱序 (review_time ≤ W) 放行且不推进 W",
   378	        ro.returncode == 0 and fsrs_fields(v).get("fsrs_last_review") == "2026-08-03T10:00:00Z",
   379	        f"rc={ro.returncode} W={fsrs_fields(v).get('fsrs_last_review')}",
   380	    )
   381	
   382	    print("\n── N2 (HIGH) EOF 的 LF 判据必须落在字节上（文本模式会把裸 \\r 读成 \\n）──")
   383	    v = new_vault("n2")
   384	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   385	    good["event_id"] = "quiz:旧板"
   386	    good["effective_at"] = "2026-07-01T10:00:00Z"
   387	    good["node_id"] = "别的节点"
   388	    torn = '{"event_id": "quiz:损坏行", "event_ty'
   389	    head = (json.dumps(good, ensure_ascii=False) + "\n").encode("utf-8") + torn.encode("utf-8")
   390	    (v / "learning_events.jsonl").write_bytes(head + b"\r")
   391	    r = run(v)
   392	    check(
   393	        "N2/裸 \\r 结尾按字节算截断",
   394	        r.returncode == 0 and "截断尾行" in r.stdout,
   395	        f"rc={r.returncode} | {last_line(r.stdout)[:90]}",
   396	    )
   397	    (v / "learning_events.jsonl").write_bytes(head + b"\r\n")
   398	    rb = run(v, event_id="板D#q1", ts="2026-08-04T10:00:00Z")
   399	    check(
   400	        "N2/对照-真带 LF 仍 fail-closed",
   401	        rb.returncode != 0 and "完整写入的损坏行" in rb.stderr,
   402	        f"rc={rb.returncode}",
   403	    )
   404	    # R7-blank（Codex round-2 线索 "R7 blank bug"，实测复现）：判据必须落在
   405	    # 「**最后一个非空行**有没有终止 LF」上，不是「文件末尾有没有 LF」——
   406	    # 坏行后跟一个纯空白行、文件不以 LF 收尾时，旧判据说「截断」，可那行明明
   407	    # 后面还跟着东西。
   408	    (v / "learning_events.jsonl").write_bytes(head + b"\n   ")
   409	    rc2 = run(v, event_id="板E#q1", ts="2026-08-06T10:00:00Z")
   410	    check(
   411	        "N2/R7-blank：坏行带 LF + 末尾空白行 → 仍是完整损坏",
   412	        rc2.returncode != 0 and "完整写入的损坏行" in rc2.stderr,
   413	        f"rc={rc2.returncode} | {last_line(rc2.stderr)}",
   414	    )
   415	    (v / "learning_events.jsonl").write_bytes(head + b"   ")
   416	    rd = run(v, event_id="板F#q1", ts="2026-08-07T10:00:00Z")
   417	    check(
   418	        "N2/R7-blank 验伪：坏行无 LF 但有尾随空格 → 仍算截断",
   419	        rd.returncode == 0 and "截断尾行" in rd.stdout,
   420	        f"rc={rd.returncode}",
   421	    )
   422	
   423	    print("\n── N3 (MEDIUM) 账本行 JSON 重复键：loads 静默取最后一个 ──")
   424	    v = new_vault("n3")
   425	    row = _pending_row()
   426	    row["event_id"] = "quiz:" + EID
   427	    text = json.dumps(row, ensure_ascii=False)
   428	    dup = text.replace('"grade_norm": 0.75', '"grade_norm": 0.11, "grade_norm": 0.75', 1)
   429	    assert dup.count('"grade_norm"') == 2
   430	    (v / "learning_events.jsonl").write_text(dup + "\n", encoding="utf-8")
   431	    r = run(v)
   432	    check(
   433	        "N3/重复键歧义",
   434	        r.returncode != 0 and "重复键" in r.stderr and not fsrs_fields(v),
   435	        f"rc={r.returncode} | {last_line(r.stderr)}",
   436	    )
   437	
   438	    print("\n── N4 (MEDIUM) 非法 UTF-8 字节须 clean fail-closed，不是 traceback ──")
   439	    v = new_vault("n4")
   440	    (v / "learning_events.jsonl").write_bytes(b'{"event_id": "quiz:x"}\n\xff\xfe bad\n')
   441	    r = run(v)
   442	    check(
