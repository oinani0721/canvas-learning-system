  1245	    (vault / "learning_events.jsonl").unlink()
  1246	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1247	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1248	    ema_before = {
