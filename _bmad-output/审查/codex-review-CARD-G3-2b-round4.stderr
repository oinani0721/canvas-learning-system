   482	def _bridge(fm_text, gn, ab, ts, rating=None):
   483	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   484	    if rating is not None:
   485	        payload_in["rating"] = rating
   486	    try:
   487	        _r = subprocess.run(
   488	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   489	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   490	    except Exception as _e:
   491	        return None, str(_e)
   492	    try:
   493	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   494	    except ValueError:
   495	        _out = {}
   496	    if _r.returncode == 2:
   497	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
   498	    if _r.returncode == 0 and _out.get("fm_block"):
   499	        return _out, None
   500	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
   501	    return None, _err
