   589	# ── 门⑭ 历史行 (无 review/1 扩展) 不进 pending (§6.3) ──
   590	
   591	
   592	def test_legacy_rows_never_replayed(vault):
   593	    legacy = json.dumps(
   594	        {
   595	            "event_id": "quiz:旧事件",
   596	            "event_version": 1,
   597	            "event_type": "answer_scored",
   598	            "node_id": "测试节点",
   599	            "recorded_at": "2026-07-01T10:00:00Z",
   600	            "effective_at": "2026-07-01T10:00:00Z",
   601	            "payload": {"grade_norm": 1.0, "exam_board": "x", "attempt_count": 1},
   602	        },
   603	        ensure_ascii=False,
   604	    )
   605	    (vault / "learning_events.jsonl").write_text(legacy + "\n", encoding="utf-8")
   606	    r = _run_writer(vault, _payload(ts="2026-08-02T10:00:00Z"))
   607	    assert r.returncode == 0, r.stdout + r.stderr
   608	    # 无 fsrs_* 字段的新卡: 旧事件不可重放 (无 review_time, 视为已应用),
   609	    # W 恰为新事件时刻 — 若旧行被误重放 W 会先落到 2026-07-01
   610	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
   611	    assert len(_ledger_lines(vault)) == 2
   612	    assert _run_validator(vault).returncode == 0
