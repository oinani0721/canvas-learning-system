   312	def test_fail_before_append_keeps_ledger_and_node_consistent(vault):
   313	    """bridge exit 2 (naive ts) 在 append 之前 fail-closed — 系统保持评分前
   314	    一致态, 重跑即可 (scored_pending_node_update 续跑语义)。"""
   315	    _face_node = _write_face(vault)
   316	    r = _run_writer(vault, _payload(ts="2026-08-01T10:00:00"))
   317	    assert r.returncode != 0, "naive ts 必须拒绝"
   318	    assert _write_face(vault) == _face_node, "fail-closed 必须零写（节点 + 账本）"
   319	    assert not (vault / "learning_events.jsonl").exists(), "fail-closed 必须零写账本"
