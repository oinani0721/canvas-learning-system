   198	def r2():
   199	    print("\n── R2 (BLOCKER) 小数秒 / 非 UTC durable review_time → 必须 fail-closed ──")
   200	    for bad, why in (("2026-08-01T10:00:00.500Z", "小数秒"), ("2026-08-01T18:00:00+08:00", "非 UTC")):
   201	        v = new_vault(f"r2-{why}")
   202	        assert run(v).returncode == 0
   203	        base = rows(v)[0]
   204	        (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   205	        t = json.loads(json.dumps(base))
   206	        t["payload"]["review_time"] = bad
   207	        t["effective_at"] = bad
   208	        write_rows(v, t)
   209	        s = sha(v / NODE_REL)
   210	        r = run(v)
   211	        check(
   212	            f"R2/{why}-dup路径",
   213	            r.returncode != 0 and why in r.stderr and sha(v / NODE_REL) == s,
   214	            f"rc={r.returncode} 节点零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   215	        )
   216	        rf = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   217	        check(
   218	            f"R2/{why}-foreign pending 路径",
   219	            rf.returncode != 0 and why in rf.stderr and len(rows(v)) == 1,
   220	            f"rc={rf.returncode} 账本={len(rows(v))}行",
   221	        )
