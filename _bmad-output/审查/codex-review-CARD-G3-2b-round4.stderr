  1188	
  1189	def _strip_calibration(vault: Path) -> None:
  1190	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1191	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1192	    head, fm, body = text.split("---\n", 2)
  1193	    lines, out, skipping = fm.split("\n"), [], False
  1194	    for ln in lines:
  1195	        if ln.startswith("calibration_log:"):
  1196	            skipping = True
  1197	            continue
  1198	        if skipping and (ln.startswith("  ") or ln == ""):
  1199	            continue
  1200	        skipping = False
  1201	        out.append(ln)
  1202	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1203	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1204	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1205	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
