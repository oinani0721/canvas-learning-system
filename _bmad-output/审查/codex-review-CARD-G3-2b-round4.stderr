   889	        if cal and cal not in body:
   890	            body = body.rstrip() + "\n\n" + cal + "\n"
   891	        print(f"[quiz-answer] A2 恢复(崩溃窗口①): mastery {old}->{new}; FSRS+EMA+校准全套补齐 @ {review_time}")
   892	    # ── A4.4 原子发布 (恢复路径)
   893	    _f = open(NODE + ".quiz-tmp", "w", encoding="utf-8")
   894	    _f.write(f"---\n{fm}\n---\n{body}")
   895	    _f.flush()
   896	    os.fsync(_f.fileno())
   897	    _f.close()
   898	    os.replace(NODE + ".quiz-tmp", NODE)
   899	    _dfd = os.open(os.path.dirname(NODE) or ".", os.O_RDONLY)
   900	    try:
   901	        os.fsync(_dfd)
   902	    finally:
   903	        os.close(_dfd)
   904	    os.remove(P)
   905	    raise SystemExit(0)
