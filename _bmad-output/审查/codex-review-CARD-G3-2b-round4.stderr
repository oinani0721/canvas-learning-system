   944	# ══ CARD-G3-2b: Codex round-3 残留 R1-R7 的生产入口反例门 (㉖-㉜) ══
   945	# 全部用**逐字提取的生产 PYEOF 块**驱动 (CODE), 反例态由账本/节点预置构造 —
   946	# 测试内不重写任何一套判定逻辑。
   947	
   948	
   949	# ── 门㉖ R1 (BLOCKER): durable payload 的未知额外键必须冲突, 不得被自抄放行 ──
   950	
   951	
   952	def test_r1_unknown_durable_payload_key_conflicts(vault):
   953	    """旧实现的 candidate 以 durable payload 为底 spread (`{**_dpl, ...}`),
   954	    未知额外键被原样抄进 candidate ⇒ 比较退化成「自己比自己」。
   955	    实测穿透链: 给崩溃窗口①的 durable 行加 payload.out_of_order=true →
   956	    envelope 放行, 而 A2 适用集按定义排除该行 ⇒ FSRS 永不应用, writer 仍
   957	    rc=0 写下 calibration/mastery, 节点 fsrs_* 全空、账本仍一行。
   958	    正确行为: 键集本身是等价面的一部分 — 多一键/少一键一律冲突。"""
   959	    r = _run_writer(vault, _payload())
   960	    assert r.returncode == 0, r.stdout + r.stderr
   961	    base = _ledger_lines(vault)[0]
   962	    # ⚠️ round-1 后续: `out_of_order` 现被更早的语义门接管 (见门㉞ N1) —— 只有
   963	    # **合法乱序形态**(review_time ≤ W) 的该键才会走到 envelope 门。这里保 W
   964	    # 不回滚地测它, 保证 R1 的原始穿透链仍被本门覆盖: 本次评分事实里没有这个
   965	    # 键, 键集不等即冲突。
   966	    base_oo = json.loads(json.dumps(base))
   967	    base_oo["payload"]["out_of_order"] = True  # review_time == W ⇒ 合法乱序
   968	    _write_ledger(vault, base_oo)
   969	    r_oo = _run_writer(vault, _payload(ts="2026-09-01T07:00:00Z"))
   970	    assert r_oo.returncode != 0, "合法乱序形态的 out_of_order 键仍须 envelope 冲突"
   971	    assert "envelope 冲突" in r_oo.stderr, r_oo.stderr
   972	    assert len(_ledger_lines(vault)) == 1
   973	    for tweak, desc in (
   974	        ({"note": "外部工具注入的备注"}, "任意未知额外键"),
   975	        ({"vault_id": "canvas_vault_测试", "extra_nested": {"a": 1}}, "未知嵌套键"),
   976	    ):
   977	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 回到崩溃窗口①前置态
   978	        _sha_v0 = _sha(vault / NODE_REL)
   979	        tampered = json.loads(json.dumps(base))
   980	        tampered["payload"].update(tweak)
   981	        _write_ledger(vault, tampered)
   982	        rt = _run_writer(vault, _payload())
   983	        assert rt.returncode != 0, f"{desc}: 必须 envelope 冲突 (旧实现 rc=0 且 fsrs_* 全空)"
   984	        assert "envelope 冲突" in rt.stderr, rt.stderr
   985	        assert _sha(vault / NODE_REL) == _sha_v0, f"{desc}: 冲突拒绝必须整节点零写"
   986	        assert len(_ledger_lines(vault)) == 1, f"{desc}: 冲突拒绝不得追加"
   987	    # 反向: durable 行**缺**一个固定生产键 — 旧实现会被 candidate 的覆盖补回,
   988	    # 同样穿透。少键必须与多键同等冲突。
   989	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   990	    short = json.loads(json.dumps(base))
   991	    short["payload"].pop("exam_board")
   992	    _write_ledger(vault, short)
   993	    rs = _run_writer(vault, _payload())
   994	    assert rs.returncode != 0 and "envelope 冲突" in rs.stderr, rs.stderr
   995	    # 对照 (验伪): 原样 durable 行必须照常恢复 — 本门不是「恒拒」的假门
   996	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   997	    _write_ledger(vault, base)
   998	    rok = _run_writer(vault, _payload())
   999	    assert rok.returncode == 0, rok.stdout + rok.stderr
  1000	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "未被篡改的 durable 行必须正常恢复"
