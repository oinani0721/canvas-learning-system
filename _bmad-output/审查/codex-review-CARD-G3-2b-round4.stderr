  1653	    # ④ 分层成立（非缺陷，锁住）：fixture 脚本的写入面守卫不被 symlink 劫持。
  1654	    # ⚠️ 原写法是「源码里有 resolve() 和 MARKER 这两个词」—— 审查实测：把
  1655	    # _guard_target() 函数体整体挖空、连调用点一起删掉，两条断言**仍全真**
  1656	    # （resolve() 在该文件另有无关出现：WT = Path(__file__).resolve()...）。
  1657	    # 断言必须绑定被审对象本身：直接**调用守卫**，看它在两种攻击形态下是否拒。
  1658	    import importlib.util as _ilu
  1659	
  1660	    _spec = _ilu.spec_from_file_location(
  1661	        "g32b_build_fixture_gate", WT / "backend" / "scripts" / "g32b_build_fixture.py"
  1662	    )
  1663	    _mod = _ilu.module_from_spec(_spec)
  1664	    _spec.loader.exec_module(_mod)
  1665	    probe = Path("/private/tmp/g32b-gate-toctou-probe")
  1666	    victim = Path("/private/tmp/g32b-gate-toctou-victim")
  1667	    for p in (probe, victim):
  1668	        if p.is_symlink():
  1669	            p.unlink()
  1670	        elif p.exists():
  1671	            subprocess.run(["rm", "-rf", str(p)], check=True)
  1672	    victim.mkdir()
  1673	    _orig_root = _mod.FIXTURE_ROOT
  1674	    try:
  1675	        # ① symlink 劫持：目标是指向别处的软链 ⇒ 守卫必须拒
  1676	        probe.symlink_to(victim, target_is_directory=True)
  1677	        _mod.FIXTURE_ROOT = probe
  1678	        with pytest.raises(SystemExit) as ei:
  1679	            _mod._guard_target()
  1680	        assert "resolve" in str(ei.value) or "拒跑" in str(ei.value), str(ei.value)
  1681	        probe.unlink()
  1682	        # ② 陌生目录（无 marker）⇒ 守卫必须拒，绝不 rmtree 别人的目录
  1683	        probe.mkdir()
  1684	        (probe / "别人的重要文件.txt").write_text("不该被删", encoding="utf-8")
  1685	        _mod.FIXTURE_ROOT = probe
  1686	        with pytest.raises(SystemExit) as ei2:
  1687	            _mod._guard_target()
  1688	        assert "标记文件" in str(ei2.value) or "拒绝删除" in str(ei2.value), str(ei2.value)
  1689	        assert (probe / "别人的重要文件.txt").exists(), "守卫拒跑时不得动目标目录"
  1690	        # ③ 验伪：带 marker 的自己的目录必须放行（否则这门是「恒拒」的假门）
  1691	        (probe / _mod.MARKER).write_text("x", encoding="utf-8")
  1692	        _mod._guard_target()
  1693	    finally:
  1694	        _mod.FIXTURE_ROOT = _orig_root
  1695	        if probe.is_symlink():
  1696	            probe.unlink()
  1697	        else:
  1698	            subprocess.run(["rm", "-rf", str(probe)], check=True)
  1699	        subprocess.run(["rm", "-rf", str(victim)], check=True)
