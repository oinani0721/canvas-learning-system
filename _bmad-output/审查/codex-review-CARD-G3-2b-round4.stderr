   103	
   104	def run_settled(vault: Path, **over):
   105	    """跑写点；若因「A2 恢复先落定」被要求重跑，就再跑一次并返回合并结果。
   106	
   107	    存在 foreign pending 时写点会先把恢复结果原子发布、再以非零码退出要求重跑
   108	    （Codex round-3 BLOCKER 的修法：恢复与新写不在同一次运行里混做）。
   109	    """
   110	    r = run(vault, **over)
   111	    if r.returncode != 0 and "恢复已落定" in r.stderr:
   112	        r2 = run(vault, **over)
   113	        return subprocess.CompletedProcess(r2.args, r2.returncode, r.stdout + r2.stdout, r.stderr + r2.stderr)
   114	    return r
   115	
   116	
   117	def rows(vault: Path):
   118	    p = vault / "learning_events.jsonl"
   119	    return [json.loads(x) for x in p.read_text(encoding="utf-8").splitlines() if x.strip()] if p.exists() else []
   120	
   121	
   122	def write_rows(vault: Path, *recs, trailing_lf=True):
   123	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs)
   124	    (vault / "learning_events.jsonl").write_text(text if trailing_lf else text[:-1], encoding="utf-8")
   125	
   126	
   127	def sha(p: Path) -> str:
   128	    return hashlib.sha256(p.read_bytes()).hexdigest()
   129	
   130	
   131	def fsrs_fields(vault: Path) -> dict:
   132	    fm = (vault / NODE_REL).read_text(encoding="utf-8").split("---\n")[1]
   133	    out = {}
   134	    for k in ("fsrs_due", "fsrs_state", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   135	        m = re.search(rf'^{k}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   136	        if m:
   137	            out[k] = m.group(1)
   138	    return out
   139	
   140	
   141	def last_line(text: str) -> str:
   142	    lines = text.strip().splitlines()
   143	    return lines[-1][:110] if lines else ""
   144	
   145	
   146	RESULTS: list[tuple[str, bool, str]] = []
   147	
   148	
   149	def check(tag: str, ok: bool, detail: str) -> None:
   150	    RESULTS.append((tag, ok, detail))
   151	    print(f"  [{'PASS' if ok else 'FAIL'}] {tag}: {detail}")
   152	
