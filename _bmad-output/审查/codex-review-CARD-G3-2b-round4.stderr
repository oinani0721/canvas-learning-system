   615	# ── 门⑮ 跨事件 A2: 别的事件落账未应用 → 本次评分前重放至空 ──
   616	
   617	
   618	def test_pending_foreign_event_replayed_before_new_write(vault):
   619	    """run1 为事件 A 落账未应用 (崩溃), run2 换一张板考同一节点 (事件 B):
   620	    A2 必须先重放 A 再计算 B — 单写者下交错窗口由 A2 消灭。"""
   621	    event_a = {
   622	        "event_id": "quiz:板A#q1",
   623	        "event_version": 1,
   624	        "event_type": "answer_scored",
   625	        "node_id": "测试节点",
   626	        "recorded_at": TS1,
   627	        "effective_at": TS1,
   628	        "payload": {
   629	            "schema_ext": "review/1",
   630	            "vault_id": "canvas_vault_测试",
   631	            "concept_id": "测试节点",
   632	            "rating": 3,
   633	            "grade_norm": 0.75,
   634	            "review_time": TS1,
   635	            "fsrs_library_version": "degraded:historic-run",  # 哨兵行
   636	            "fsrs_params_hash": "degraded:historic-run",
   637	            "exam_board": "检验白板/板A.md",
   638	            "attempt_count": 1,
   639	        },
   640	    }
   641	    (vault / "learning_events.jsonl").write_text(json.dumps(event_a, ensure_ascii=False) + "\n", encoding="utf-8")
   642	    # 两阶段（Codex round-3 BLOCKER 的修法）：第一次跑只把 A 的恢复结果原子
   643	    # 发布下去并要求重跑；第二次跑 pending 已空，B 在干净基线上写入。
   644	    r0 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md"))
   645	    assert r0.returncode != 0, "存在 foreign pending 时不得在同一次运行里既恢复又追加"
   646	    assert "A2 重放已应用" in r0.stdout, "事件 A 必须被重放"
   647	    assert "恢复已落定" in r0.stderr, r0.stderr
   648	    # ⚠️ 此处原断言是「必须如实告知**永久丢失**」—— 门锁住了那句错误声明。
   649	    # 载荷其实都在 payload 里，现在逐项复放，提示也随之改成「已复放」。
   650	    assert "已按各自的账本载荷复放" in r0.stdout, "被恢复事件的评分链副作用必须逐项复放"
   651	    assert "question_id 与理解自评" in r0.stdout, "唯一补不回的两项要如实说明"
   652	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "恢复结果必须已落盘（W = A 的时刻）"
   653	    assert len(_ledger_lines(vault)) == 1, "第一阶段不得追加本次事件"
   654	    r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md"))
   655	    assert r.returncode == 0, r.stdout + r.stderr
   656	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z", "W 反映 B"
   657	    recs = _ledger_lines(vault)
   658	    assert [x["event_id"] for x in recs] == ["quiz:板A#q1", "quiz:板B#q1"]
   659	    assert _run_validator(vault).returncode == 0
   660	    # A2 重放 A 后 W=TS1; 若跳过重放直接算 B, B 会从新卡基线出发 — 与正确
   661	    # 基线 (A 已应用) 的 FSRS 六字段必然不同; 对拍 bridge 直调两次的结果:
   662	    sys.path.insert(0, str(VAULT_SCRIPTS))
   663	    try:
   664	        import fsrs_bridge as fb
   665	
   666	        base = fb.review({}, 0.75, False, TS1)  # A (rating 3)
   667	        got = _fm_fields(vault)
   668	        expect2 = fb.review({k: v for k, v in base.items() if k != "fm_block"}, 0.75, False, "2026-08-02T10:00:00Z")
   669	        assert float(got["fsrs_stability"]) == expect2["fsrs_stability"], (
   670	            f"A2 重放未生效或基线错: {got['fsrs_stability']} != {expect2['fsrs_stability']}"
   671	        )
   672	    finally:
   673	        sys.path.remove(str(VAULT_SCRIPTS))
   674	        sys.modules.pop("fsrs_bridge", None)
   675	
   676	
   677	# ── 门⑯ 子串查重陷阱: payload 文本含 JSON 串形不得误判 duplicate ──
   678	# Codex round-1 MEDIUM: 中文 EID + 转义 note 形态下旧子串谓词实测不命中
   679	# (杀不掉旧实现) — 陷阱必须用 ASCII event_id 且 payload 字段值**直接等于**
   680	# 该 event_id 文本, 让 `json.dumps(eid) in line` (旧实现) 确定命中。
   681	
   682	TRAP_EID = "trap-eid-123"
   683	
   684	
   685	def test_substring_dedup_trap(vault):
   686	    """A4.5 parsed-field equality: 预置行的 payload 文本里恰好含
   687	    `"quiz:<新eid>"` 的 JSON 串形时, 子串查重会误判 duplicate 而**零次落账**
   688	    (旧实现的真实缺陷, schema §九登记)。正确行为 = 正常追加第 2 行。
   689	    陷阱载体 = payload **键名** (键名引号不被 JSON 转义, 值内引号恒转义为
   690	    \\" 导致 needle 尾引号匹配不上 — 首版陷阱因此被验伪断言自己抓出)。
   691	    验伪: 该陷阱对旧子串谓词 `json.dumps(evid) in line` 必须命中。"""
   692	    trap_needle = json.dumps("quiz:" + TRAP_EID, ensure_ascii=False)  # "quiz:trap-eid-123"
   693	    other = {
   694	        "event_id": "quiz:另一事件",
   695	        "event_version": 1,
   696	        "event_type": "answer_scored",
   697	        "node_id": "测试节点",
   698	        "recorded_at": TS1,
   699	        "effective_at": TS1,
   700	        "payload": {"quiz:" + TRAP_EID: "字段名恰好等于新事件 id 的 JSON 串形"},  # 不含 schema_ext
   701	    }
   702	    line_text = json.dumps(other, ensure_ascii=False)
   703	    assert trap_needle in line_text, "陷阱行必须真的命中旧子串谓词 (否则本门为假门)"
   704	    (vault / "learning_events.jsonl").write_text(line_text + "\n", encoding="utf-8")
   705	    r = _run_writer(vault, _payload(event_id=TRAP_EID))
   706	    assert r.returncode == 0, r.stdout + r.stderr
   707	    recs = _ledger_lines(vault)
   708	    assert len(recs) == 2, f"parsed 查重不得被子串误判, 实得 {len(recs)} 行: {[x['event_id'] for x in recs]}"
   709	    assert recs[1]["event_id"] == "quiz:" + TRAP_EID
   710	
   711	
   712	# ── 门⑰ A2 重放失败 → 一律 fail-closed 零写 (Codex round-1 BLOCKER) ──
   713	
   714	
   715	def test_pending_replay_failure_blocks_everything(vault):
   716	    """存在 pending 且重放失败 (fsrs 不可用) 时: 既不 degraded 落账、也不
   717	    发布 frontmatter — A2 「追加前重放至空」无例外。"""
   718	    event_a = {
   719	        "event_id": "quiz:板A#q1",
   720	        "event_version": 1,
   721	        "event_type": "answer_scored",
   722	        "node_id": "测试节点",
   723	        "recorded_at": TS1,
   724	        "effective_at": TS1,
   725	        "payload": {
   726	            "schema_ext": "review/1",
   727	            "vault_id": "canvas_vault_测试",
   728	            "concept_id": "测试节点",
   729	            "rating": 3,
   730	            "grade_norm": 0.75,
   731	            "review_time": TS1,
   732	            "fsrs_library_version": "degraded:historic-run",
   733	            "fsrs_params_hash": "degraded:historic-run",
   734	            "exam_board": "检验白板/板A.md",
   735	            "attempt_count": 1,
   736	        },
   737	    }
   738	    (vault / "learning_events.jsonl").write_text(json.dumps(event_a, ensure_ascii=False) + "\n", encoding="utf-8")
   739	    sha = _sha(vault / NODE_REL)
   740	    r = _run_writer(
   741	        vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"), env_extra={"FSRS_BRIDGE_REEXEC": "1"}
   742	    )
   743	    assert r.returncode != 0, "pending 重放失败必须 fail-closed"
   744	    assert "重放失败" in r.stderr, r.stderr
   745	    assert _sha(vault / NODE_REL) == sha, "零写节点"
   746	    assert len(_ledger_lines(vault)) == 1, "零写账本 (不得 degraded 追加)"
   747	    # 变体: pending 行 rating 非法 (float 1.5) → bridge 严格 int 拒 → 同 fail-closed
   748	    bad_rating = json.loads(json.dumps(event_a))
   749	    bad_rating["payload"]["rating"] = 1.5
   750	    (vault / "learning_events.jsonl").write_text(json.dumps(bad_rating, ensure_ascii=False) + "\n", encoding="utf-8")
   751	    r2 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
   752	    assert r2.returncode != 0, "非法 rating 的 pending 行必须被 bridge 拒绝并 fail-closed"
   753	    assert len(_ledger_lines(vault)) == 1
   754	    # 变体 (round-2 HIGH): abandoned 行 rating=1.5 — abandoned 分支不得绕过类型门
   755	    bad_ab = json.loads(json.dumps(event_a))
