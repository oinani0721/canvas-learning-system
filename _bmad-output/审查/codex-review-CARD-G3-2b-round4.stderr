  1199	def _instant(value: object) -> Optional[datetime]:
  1200	    """已过 _parse_ts 的串 → 绝对瞬间 (用于跨字段语义比较: 'Z' 与 '+00:00'
  1201	    是同一瞬间的两种写法, 不得因原字符串不等而误判 — round-3 MEDIUM)。"""
  1202	    if not isinstance(value, str):
  1203	        return None
  1204	    text = value[:-1] + "+00:00" if value.endswith("Z") else value
  1205	    try:
  1206	        return datetime.fromisoformat(text)
  1207	    except ValueError:
  1208	        return None
