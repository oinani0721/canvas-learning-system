  1429	        expected = _rating_from_grade_norm(float(grade_norm))
  1430	        if rating != expected:
  1431	            problems.append(
  1432	                f"rating {rating} 与 grade_norm {grade_norm} 不自洽 (rating_from_grade 口径应为 {expected})"
  1433	            )
  1434	
  1435	    # 防御: _golden_manifest 已保证 dict|None, 此处对任意坏值也不炸
  1436	    # (round-4 MEDIUM: 非 dict manifest 曾可触发 AttributeError)
  1437	    manifest = manifest if isinstance(manifest, dict) else None
  1438	    truth_version = manifest.get("library_version") if manifest else None
  1439	    truth_hash = manifest.get("params_hash") if manifest else None
  1440	    degraded_flags = []
  1441	    for key, shape_re, shape_desc, truth in (
  1442	        ("fsrs_library_version", _VERSION_RE, "数字点版 (如 6.3.1)", truth_version),
  1443	        ("fsrs_params_hash", _HASH_RE, "64 位小写 hex (sha256)", truth_hash),
  1444	    ):
  1445	        value = payload.get(key)
  1446	        if not isinstance(value, str) or not value:
  1447	            problems.append(f"扩展键 {key} 必须为非空字符串 (降级时用 'degraded:<原因>')")
  1448	            degraded_flags.append(None)
  1449	            continue
  1450	        if value.startswith(DEGRADED_PREFIX):
  1451	            degraded_flags.append(True)
  1452	            if not value[len(DEGRADED_PREFIX) :].strip():
  1453	                problems.append(f"扩展键 {key} 的 degraded 哨兵必须带非空原因")
  1454	            continue
  1455	        degraded_flags.append(False)
  1456	        if not shape_re.match(value):
  1457	            problems.append(f"扩展键 {key} 形状非法 (须为{shape_desc}或 degraded 哨兵): {value!r}")
  1458	        elif truth is None:
  1459	            warnings.append(f"{key} 只做形状校验 — 未找到同仓 fsrs_golden_manifest.json, 无法绑定真值")
  1460	        elif value != truth:
  1461	            problems.append(
  1462	                f"扩展键 {key} {value!r} != G3-4 golden manifest 真值 {truth!r} (§6.1 库指纹必须与冻结基线同源)"
  1463	            )
  1464	    if len(set(f for f in degraded_flags if f is not None)) > 1:
  1465	        problems.append(
  1466	            "fsrs_library_version 与 fsrs_params_hash 的 degraded 状态必须成对 "
  1467	            "(§6.1: 降级时两键同为哨兵, 正常时两键同为真实值)"
  1468	        )
  1469	    return problems, warnings
