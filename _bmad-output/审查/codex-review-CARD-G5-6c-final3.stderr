diff --git a//private/tmp/card-g56c-r7.o7v1JT/make_frontmatter_matrix.py b//private/tmp/card-g56c-r7.o7v1JT/make_frontmatter_matrix.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ff85795b972c40480cdfbd858807b3b21000342
--- /dev/null
+++ b//private/tmp/card-g56c-r7.o7v1JT/make_frontmatter_matrix.py
@@ -0,0 +1,30 @@
+from pathlib import Path
+import os
+
+root = Path("/private/tmp/card-g56c-r7.o7v1JT/frontmatter-matrix")
+vault = root / "vault"
+inbox = vault / "_待处理"
+for directory in (vault / "原白板", vault / "节点", inbox):
+    directory.mkdir(parents=True, exist_ok=False)
+
+cases = {
+    "01-yaml-full-comment.md": "---\n# source: https://full.example/p\ntitle:\n---\n",
+    "02-yaml-inline-comment.md": '---\ntitle: "" # source: https://inline.example/p\n---\n',
+    "03-c1-inline-comment.md": '---\nsource: "https://ok.example/p" # 官方来源\n---\n',
+    "04-html-multiline-comment.md": "# \n<!--\nsource: https://multi.example/p\n-->\n",
+    "05-empty-multiline-comment.md": "# \n<!--\n\n-->\n",
+    "06-first-malformed-source.md": "---\nsource:https://first.example/p\n---\n# \n",
+    "07-later-malformed-source.md": "---\ntitle:\nsource:https://later.example/p\n---\n# \n",
+    "08-block-scalar-source.md": "---\nsource: |\n  https://block.example/p\n---\n# \n",
+    "09-isbn-in-key.md": "---\nISBN-978-7-111-54742-6:\n---\n# \n",
+    "10-empty-fm.md": "---\ntitle:\ntags:\n---\n# \n",
+}
+
+for age, (name, text) in enumerate(cases.items(), start=1):
+    path = inbox / name
+    path.write_text(text, encoding="utf-8")
+    ts = 1_700_100_000 + age
+    os.utime(path, (ts, ts))
+
+for name, text in cases.items():
+    print(f"{name}\t{text.encode('utf-8').hex()}")
