命令：

```sh
R3=/private/tmp/card-g56c-r7.o7v1JT/new-matrix
python3 -B "$P" \
  --vault "$R3/vault" \
  --now 2026-09-01T00:00:00+08:00 \
  --out-dir "$R3/out" \
  --batch-size 10

jq -c '.items[0:3][] |
