def test_schema_v1_full_key_sets_are_frozen(tmp_path):
    """⛔ round-2 审查 MEDIUM: `test_schema_version_frozen_at_one` 只锁
    `schema_version`/`id_namespace`/disclaimer —— 删改大多数 top/item/nested 键
    仍能保持它绿。schema v1 是**冻结**契约，键集合必须整体上锁。

    期望值取自 round-2 审查报告 §二.3 实测清单（独立来源，不是从本次输出反抄
    —— 自抄期望值等于让门给自己签字，见 reference_gate_design_pitfalls）。
    """
    vault, out = base_vault(tmp_path)
    inbox = vault / "_待处理"
    mk(inbox / "a.md", "# A\n\n正文内容一。\n正文内容二。\n", age_days=3)
    mk(inbox / "b.md", "---\nsource: https://x.test/p\n---\n\n正文。\n正文二。\n", age_days=2)
    # ⛔ round-3 审查 MEDIUM: 原先建在 `vault/Sleeping`，而生产读的是
    # `<收件箱>/Sleeping` —— fixture 建错位置 ⇒ sleeping.items 恒空 ⇒ 那一层的
    # 键集合根本没被锁（在副本里给 sleeping.items[*] 加一个键，88 门照样全绿）。
    (inbox / "Sleeping").mkdir(exist_ok=True)
    mk(inbox / "Sleeping" / "s.md", "---\nslept_at: 2026-07-01\n---\n\n睡着的。\n", age_days=40)

    assert run_cli(vault, out).returncode == 0
    data = load_json(out)
    assert data["schema_version"] == 1
    assert data["items"], "items 为空则 item_keys 断言恒真 = 假绿"

    expected_top = {
        "corpus",
        "criteria_order",
        "generator",
        "id_namespace",
        "id_stability",
        "inbox_dir",
        "inbox_exists",
        "inventory",
        "items",
        "label",
        "last_cleanup",
        "last_cleanup_note",
        "near_dup_scan",
        "not_executed_disclaimer",
        "now",
        "now_local",
        "now_utc",
        "receipt",
        "schema_version",
        "sleeping",
        "vault_fingerprint",
        "verdict_vocabulary",
    }
    expected_item = {
        "age_days",
        "ask",
        "basis",
        "confident",
        "conflicts",
        "criterion",
        "exact_duplicate_of",
        "exact_duplicate_others",
        "index",
        "mtime_local",
        "mtime_utc",
        "name",
        "near_duplicates",
        "nomination_type",
        "rel_path",
        "size_bytes",
        "stable_id",
        "target_hint",
        "text_readable",
        "type_uncertain",
        "uncertain_reason",
        "verdict",
    }
    expected_nested = {
        "corpus": {
            "file_cap",
            "files_indexed",
            "files_scanned",
            "skipped_empty_body",
            "skipped_symlink",
            "skipped_unreadable",
            "truncated",
        },
        "inventory": {
            "batch_max",
            "batch_rule",
            "batch_size",
            "deferred",
            "over_budget",
            "skipped",
            "total",
        },
        "sleeping": {
            "alert_threshold_days",
            "count",
            "dir",
            "exists",
            "items",
            "oldest_days",
            "over_30d_count",
            "skipped",
        },
        "near_dup_scan": {
            "body_char_cap",
            "compared_pairs",
            "length_prefilter_ratio",
            "note",
            "ratio_threshold",
            "skipped_length_prefilter",
            "skipped_oversize",
            "top_n_reported",
        },
        "verdict_vocabulary": {
            "all",
            "card_enumerated",
            "human_only",
            "human_only_note",
            "reachable_by_engine",
        },
    }
    assert set(data) == expected_top, f"顶层键集合漂移: {set(data) ^ expected_top}"
    for it in data["items"]:
        assert set(it) == expected_item, f"item 键集合漂移: {set(it) ^ expected_item}"
    for section, want in expected_nested.items():
        got = set(data[section])
        assert got == want, f"{section} 键集合漂移: {got ^ want}"
    # ⛔ sleeping.items 必须非空，否则下面这条键锁是空转（round-3 审查 MEDIUM）
    assert data["sleeping"]["items"], "Sleeping fixture 没被引擎读到 —— 键锁会空转"
    for si in data["sleeping"]["items"]:
        # 期望值取自生产构造点 inbox_preview.py:1683-1688（独立来源，不是从本次
        # 输出反抄 —— 上一稿凭印象猜键名，当场被这条断言打回，这正是它的作用）
        assert set(si) == {
            "name",
            "slept_at",
            "slept_at_source",
            "slept_days",
            "over_30d",
        }, f"sleeping.items 键集合漂移: {set(si)}"


def test_nbsp_heading_narrowing_locks_each_consumer(tmp_path):
    """⛔ round-2 审查 LOW: NBSP 门只直锁正则，`_HEADING_RE` 的三处消费面
    (`has_substantive_content` / `skeleton_note` / `dup_body`) 仅由端到端间接覆盖。
    本门对三处各下一条纯函数断言 —— 未来任一消费点改口径会当场红。
    """
    mod = load_module()
    nbsp_line = "#\u00a0keep\n"
    tab_line = "#\t\n"

    # ① has_substantive_content：NBSP 行是正文，制表符行是标题（无正文）
    assert mod.has_substantive_content(nbsp_line) is True
    assert mod.has_substantive_content(tab_line) is False

    # ② skeleton_note：NBSP 行不得被计入「标题 N 行」
    note_nbsp = mod.skeleton_note(nbsp_line, len(nbsp_line.encode()))
    assert "标题 0 行" in note_nbsp, note_nbsp
    note_tab = mod.skeleton_note(tab_line, len(tab_line.encode()))
    assert "标题 1 行" in note_tab, note_tab  # 空标题仍被计为标题行

    # ③ dup_body：标题不进比对，故 NBSP 行必须**留在**归一化正文里
    assert mod.dup_body(nbsp_line) == "#\u00a0keep", mod.dup_body(nbsp_line)
    assert mod.dup_body(tab_line) == "", mod.dup_body(tab_line)
    # 连带：两份只差「井号后是 NBSP 还是制表符」的文件不得被判逐字相等
    assert mod.dup_body(nbsp_line) != mod.dup_body(tab_line)


def test_zero_width_split_marker_still_reads_as_ai_suspect(tmp_path):
    """⛔ round-2 负控 M-ZEROWIDTH 照出的**不承重层**，本门是它唯一的裁判。

    回退 `_norm_guard_line` 后套件一门都不红 —— 因为 `Generated by<ZWSP>GPT-4`
    在旧归一下**已经**命中生成骨架（骨架里的非词字符段/非句读字符类都吃零宽），
    一条修法顺手覆盖了另一条。`_norm_guard_line` 真正承重的只有 `raw_ai_marker`:
    零宽插在**标记表项中间**时（`Generated by<ZWSP>AI Lab`），不剥零宽就匹配不到
    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。

    ⚠\ufe0f 如实声明本门测的是**理由质量**不是安全: 两种情况材料都不会被删，
    差别只在 uncertain_reason 说的是「疑似 AI 自述」还是「生成断言结构」。
    留着这一层是因为前者对人更有用 —— 但不写成安全防线，也就不能假装它是。
    """
    mod = load_module()
    zw = "\u200b"

    # 纯函数半边: 零宽切断表项时，只有护栏归一能还原出表项
    def _raw_hit(line, norm_fn):
        n = norm_fn(line)
        return next((o for nm, o in zip(mod._AI_MARKERS_NORM, mod.AI_MARKERS) if nm in n), None)

    line = f"note: Generated by{zw}AI Lab"
    assert _raw_hit(line, mod._norm_ai_line) is None, "旧归一本就认不出（这是本门的前提）"
    assert _raw_hit(line, mod._norm_guard_line) == "Generated by AI"

    # ⛔ round-3 审查 BLOCKER: 零宽换空格只对**词间**插入成立；插在**词内部**时
    # 反而把关键词拆开（`Genera<ZWSP>ted` → `genera ted`），骨架与标记表一起失效
    # —— 比不处理更糟。故两种还原都要试：换空格还原词间，直接删还原词内。
    spaced, stripped = mod._guard_variants(f"title: Genera{zw}ted by GPT-4")
    assert "genera ted" in spaced, "换空格版必然拆词（这是需要第二个变体的理由）"
    assert mod._GEN_CLAIM_EN_RE.search(spaced) is None, "拆词后骨架认不出（前提）"
    assert mod._GEN_CLAIM_EN_RE.search(stripped), "直接删版必须还原出 generated by"
    # 反向：词间插入靠换空格版，直接删会把 by 与 GPT 粘成 bygpt
    sp2, st2 = mod._guard_variants(f"title: Generated by{zw}GPT-4")
    assert mod._GEN_CLAIM_EN_RE.search(sp2), "换空格版必须还原词间分隔"
    assert "bygpt" in st2, "直接删版会粘连（这是需要第一个变体的理由）"
    # C2 判据不得被这一层带宽：确定归档面必须原地不动
    assert mod.find_ai_marker(line) is None, "护栏加宽不得顺带扩大 C2 确定提名面"

    vault, out = base_vault(tmp_path)
    inbox = vault / "_待处理"
    mk(inbox / "零宽切断表项.md", f"---\nnote: Generated by{zw}AI Lab\n---\n", age_days=6)
    mk(inbox / "纯空骨架.md", "# \n\n## \n", age_days=5)

    assert run_cli(vault, out).returncode == 0
    data = load_json(out)
    assert data["items"], "items 为空则本门恒真 = 假绿"
    it = item_by_name(data, "零宽切断表项.md")
    assert it["verdict"] != "建议删", it["basis"]
    assert it["criterion"] == "C6_undecided"
    assert it["confident"] is False
    # ⛔ 信号归属就是本门的全部判别力: 回退护栏归一后这里会变成「生成断言结构」
    r = it["uncertain_reason"] or ""
    assert "疑似 AI 生成自述" in r, f"未由 ai_suspect 接住（护栏归一没起作用）: {r}"
    skeleton = item_by_name(data, "纯空骨架.md")
    assert skeleton["criterion"] == "C3_empty_or_skeleton"
    assert skeleton["verdict"] == "建议删"


def test_source_inside_closed_html_comment_blocks_deletion(tmp_path):
    """⛔ round-3 审查 HIGH: 唯一来源写在**闭合** HTML 注释里时 C3/C4 双出口全穿。

    根因是保护面不对称: `<!--` 没等到 `-->` (未闭合) 受①保护, 而闭合注释被
    `_classify_lines_typed` 整段剥掉后**无人接** —— 来源扫描与⑨兜底都只看
    frontmatter。信号⑩与①对称补上: ①保护「不知道被吞了什么」, ⑩保护「知道被
    吞了什么, 但引擎没消费它」。
    ⚠\ufe0f 语义代价如实: 任何带非空闭合注释的骨架件都不再确定删除, 不只是带来源的
    那些 —— 因为「注释里那句话重不重要」同样不可机械判定 (与取消白名单同源)。
    """
    vault, out = base_vault(tmp_path)
    inbox = vault / "_待处理"
    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
    mk(vault / "节点" / "库内正本.md", body, age_days=40)
    for name, text in (
        # ⛔ 标题必须留空：用户裁决后「标题里写了字」本身就算实质正文，会先把
        # 材料接住，信号⑩ 根本轮不到 —— 那样本门测的就不是它声称测的那条防线。
        ("注释里的URL.md", "# \n\n<!-- source: https://example.test/p -->\n"),
        ("注释里的DOI.md", "# \n\n<!-- DOI:10.1000/hidden -->\n"),
        ("注释里的ISBN.md", "# \n\n<!-- citation: ISBN 978-7-111-54742-6 -->\n"),
        ("注释里的生成声明.md", "# \n\n<!-- generated with GPT-4 -->\n"),
        # ⛔ 第五轮终审 HIGH：跨行注释的**中间整行**此前没被收集（只收闭合那行），
        # 来源整条丢掉；单行注释反而受保护 —— 保护面不该取决于换不换行。
        ("多行注释来源.md", "# \n\n<!--\nsource: https://multi.example/p\n-->\n"),
        # ⛔ 第五轮终审 HIGH：frontmatter 里的 YAML 注释被 `startswith("#")` 跳过，
        # 既不进 unparsed_fm 也不进 map，唯一来源写在那儿照样被确定删除。
        ("fm里YAML注释.md", "---\n# source: https://fm-comment.example/p\ntitle:\n---\n"),
        # ⛔ 第六轮终审 HIGH（R6-H1）：**行尾** YAML 注释同样被剥掉且没人收。
        # 与整行注释、跨行 HTML 注释是同一件事：引擎剥掉了内容就该说出来。
        ("fm行尾注释.md", '---\ntitle: "" # source: https://inline.example/only\n---\n'),
        ("注释里的URL重复件.md", "<!-- source: https://only-here.test/p -->\n" + body),
    ):
        mk(inbox / name, text, age_days=6)
    # ⛔ 正向对照(验伪锚): 没有注释的空骨架 → 仍 C3 确定删除
    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)
    # ⛔ 正向对照: 合法 source + 行尾注释 → 仍 C1。判据排在信号之前,
    # 信号⑩ 扩到行尾注释后不得把它抢走(既有门 yaml_inline_comment 的语义)。
    mk(
        inbox / "C1带行尾注释.md",
        '---\nsource: "https://ok.test/x" # 官方来源\n---\n',
        age_days=2,
    )

    assert run_cli(vault, out).returncode == 0
    data = load_json(out)
    assert data["items"], "items 为空则本门恒真 = 假绿"
    for name in (
        "注释里的URL.md",
        "注释里的DOI.md",
        "注释里的ISBN.md",
        "注释里的生成声明.md",
        "注释里的URL重复件.md",
        "多行注释来源.md",
        "fm里YAML注释.md",
        "fm行尾注释.md",
    ):
        it = item_by_name(data, name)
        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
        assert it["criterion"] == "C6_undecided", name
        assert it["confident"] is False, name
        assert it["target_hint"] is None and it["nomination_type"] is None, name
        assert "注释" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
    assert item_by_name(data, "注释里的URL重复件.md")["exact_duplicate_of"] == "节点/库内正本.md"
    ctrl = item_by_name(data, "无注释骨架.md")
    assert ctrl["criterion"] == "C3_empty_or_skeleton", ctrl["basis"]
    assert ctrl["verdict"] == "建议删"
    c1 = item_by_name(data, "C1带行尾注释.md")
    assert c1["criterion"] == "C1_source_url", f"信号⑩ 不得抢在判据前面: {c1['basis']}"
    assert "官方来源" not in c1["basis"], c1["basis"]


def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。

    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
    """
    mod = load_module()
    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
    samples = [
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060",
        "\ufeff",
        "\u00ad",  # 原表六个
        "\u2063",
        "\u200e",
        "\u200f",
        "\u061c",
        "\u034f",  # round-3 新抓
        "\ufe0f",
        "\u2062",
        "\u180e",
        "\u202e",  # round-3 新抓
    ]
    for ch in samples:
        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"

    # 端到端半边: 用 round-3 审查的原始反例形态
    vault, out = base_vault(tmp_path)
    inbox = vault / "_待处理"
    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
    mk(vault / "节点" / "库内正本.md", body, age_days=40)
    # ⛔ 端到端半边走 **frontmatter**：标题侧在用户裁决后已由「标题里写了字算
    # 实质正文」直接保护，隐形字符再怎么插也走不到护栏 —— 拿它当端到端样本，
    # 本门就测不到 `_strip_invisible` 那一层（纯函数半边仍直锁该函数）。
    mk(inbox / "u2063英文声明.md", "---\nnote: Genera\u2063ted by GPT-4\n---\n", age_days=7)
    mk(inbox / "u2063中文声明.md", "---\nnote: 本文由 GPT-4 生\u2063成\n---\n", age_days=6)
    mk(
        inbox / "u2063重复件.md",
        "---\nnote: Genera\u2063ted by GPT-4\n---\n" + body,
        age_days=5,
    )
    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)

    assert run_cli(vault, out).returncode == 0
    data = load_json(out)
    for name in ("u2063英文声明.md", "u2063中文声明.md", "u2063重复件.md"):
        it = item_by_name(data, name)
        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
        assert it["criterion"] == "C6_undecided", name
        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
    ctrl = item_by_name(data, "无注释骨架.md")
    assert ctrl["criterion"] == "C3_empty_or_skeleton"
    assert ctrl["verdict"] == "建议删"


def test_heading_with_text_counts_as_substantive_content(tmp_path):
    """⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。

    起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了标题、正文
    还没动笔」的日常笔记，旧口径下是 `建议删 + confident=true` —— 那不是对抗
    构造，是真实使用场景。论证与本卡「取消 frontmatter 白名单」逐字同构：
    标题可能是随手一个字，也可能是这份材料唯一写下来的东西，引擎分不出，
    分不出就不该替用户决定。
    它顺带关闭了 U+3164/U+2800 那条此前未闭合的 BLOCKER —— 隐形字符伪装成正常
    标题时，标题里仍然「有字」。

    ⚠\ufe0f 代价如实（本门同时锁住代价的边界）：C3 的可确定删除面收窄到「一个字都
    没写」的五种。这五种是正向对照，一条都不能失守，否则「少删」就变成
    「判据死了」。
    """
    mod = load_module()
    assert mod.has_substantive_content("# 微积分基本定理的两种证法\n") is True
    assert mod.has_substantive_content("# \n\n## \n") is False, "空标题模板仍是骨架"
    assert mod.has_substantive_content("#\t\n") is False, "井号+制表符+空 仍是骨架"

    vault, out = base_vault(tmp_path)
    inbox = vault / "_待处理"
    mk(inbox / "只写了标题.md", "# 微积分基本定理的两种证法\n", age_days=9)
    mk(inbox / "标题加空小节.md", "# 待整理\n\n## \n", age_days=8)
    # ⛔ 关闭的 BLOCKER：隐形字符伪装成正常标题
    mk(inbox / "隐形字符标题.md", "# Genera\u3164ted by GPT-4\n", age_days=7)
    mk(inbox / "盲文空白标题.md", "# Genera\u2800ted by GPT-4\n", age_days=6)
    # ⛔ 正向对照（验伪锚）：C3 在新口径下**仅剩**的五种可达面
    mk(inbox / "C3-零字节.md", "", age_days=5)
    mk(inbox / "C3-纯空行.md", "\n\n\n", age_days=4)
    mk(inbox / "C3-纯分隔线.md", "---\n\n***\n", age_days=3)
    mk(inbox / "C3-空标题模板.md", "# \n\n## \n\n### \n", age_days=2)
    mk(inbox / "C3-只有引用符.md", "> \n> \n", age_days=1)

    assert run_cli(vault, out).returncode == 0
    data = load_json(out)
    assert data["items"], "items 为空则本门恒真 = 假绿"
    for name in ("只写了标题.md", "标题加空小节.md", "隐形字符标题.md", "盲文空白标题.md"):
        it = item_by_name(data, name)
        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
        assert it["criterion"] == "C6_undecided", name
        assert it["confident"] is False, name
    for name in (
        "C3-零字节.md",
        "C3-纯空行.md",
        "C3-纯分隔线.md",
        "C3-空标题模板.md",
        "C3-只有引用符.md",
    ):
        ctrl = item_by_name(data, name)
        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
        assert ctrl["verdict"] == "建议删", name
        assert ctrl["confident"] is True, name

