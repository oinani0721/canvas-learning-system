    59	def _exec_no_bytecode(spec, mod):
    60	    """⛔ 裁判自己也不许往 vault 里落 `__pycache__` —— 否则「零写侧」的证据链
    61	    是被测程序干净、而验证它的测试在旁边写文件。"""
    62	    prev = sys.dont_write_bytecode
    63	    sys.dont_write_bytecode = True
    64	    try:
    65	        spec.loader.exec_module(mod)
    66	    finally:
    67	        sys.dont_write_bytecode = prev
    68	
    69	
    70	def load_module():
    71	    if not SCRIPT.exists():
    72	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
    73	    spec = importlib.util.spec_from_file_location("inbox_preview", SCRIPT)
    74	    mod = importlib.util.module_from_spec(spec)
    75	    _exec_no_bytecode(spec, mod)
    76	    return mod
    77	
