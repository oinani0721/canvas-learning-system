   831	def _norm_ai_line(ln: str) -> str:
   832	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   833	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   834	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   835	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   836	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   837	    return " ".join(ln.split()).casefold()
   838	
   839	
   840	#: 不可见字符：**按 Unicode 类别判定，不枚举**。
   841	#: ⛔ round-3 审查 BLOCKER：上一版写成六个码点的有限表
   842	#: （ZWSP/ZWNJ/ZWJ/WORD JOINER/BOM/SOFT HYPHEN），于是 U+2063 INVISIBLE
   843	#: SEPARATOR 以及 U+200E/200F/061C/034F/FE0F/2062/180E/202E 共 9 个同族**全部
   844	#: 穿透**，C3 与 C4 两个出口都中。这与 round-2 的模型名教训是同一件事：
   845	#: **不可见字符不是一张能数完的表**，判它得按类别而不是按名单。
   846	#:   Cf = 格式字符（零宽空格/连接符/双向控制/不可见分隔符…）
   847	#:   Mn = 非间距标记（VS16、CGJ 这类零宽度记号）
   848	#:   Cc = 控制字符
   849	#: ⚠️ 只用在**护栏匹配面**：剥掉组合记号会改变带重音文本的词形，但护栏只判
   850	#: 「这行像不像生成声明」，方向是更容易命中；产物输出一律走原文，不受影响。
   851	#: ⛔ **类别判定同样不完备，如实登记原理上限**（round-4 验证实测）：
   852	#: `U+3164 HANGUL FILLER`（Lo，字母）与 `U+2800 BRAILLE PATTERN BLANK`（So，符号）
   853	#: 在屏幕上是空白，但 Unicode 把它们归为字母/符号，`isspace()` 也是 False ——
   854	#: 机械上它们就是普通字符。把 Lo/So 整类剥掉会连正常韩文与盲文一起剥，那是
   855	#: 更坏的交易。**「视觉上不可见」需要字形宽度数据才判得了，不是字符属性能决定的**，
   856	#: 因此 `# Genera<U+3164>ted by GPT-4` 这类构造仍会落 C3 建议删。
   857	#: 结构化的兜底得改 C3 对**标题行**的处理（现在标题不算实质正文），那是判据面
   858	#: 的语义变更，超出 CARD-G5-6c 范围 —— 登记待裁决，不在本卡内改。
   859	_INVISIBLE_CATEGORIES = frozenset({"Cf", "Mn", "Cc"})
   860	
   861	
   862	def _strip_invisible(s: str, repl: str) -> str:
   863	    """把不可见字符替换成 `repl`（`" "` 还原词间分隔；`""` 还原词内断裂）。
   864	
   865	    ⛔ round-4 验证 BLOCKER 的一半：**删版必须连空白类一起删**。
   866	    `Genera<U+200A>ted`（HAIR SPACE，Zs）此前只被 `_norm_ai_line` 的 `split()`
   867	    折叠成普通空格，词照样是拆开的 —— 删版不删它，两个变体就都还原不出
   868	    `generated`。
   869	    ⚠️ 但删版**保留 ASCII 空格与制表符**：把它们也删掉，`generated by GPT-4`
   870	    在删版里就成了 `generatedbyGPT-4`，骨架永远认不出，删版等于自废。
   871	    要删的是「看不见、又不是正常词间空格」的那一类 —— Cf/Mn/Cc 加上**非 ASCII**
   872	    的空白（Zs/Zl/Zp，如 HAIR SPACE）。两个变体这才真正互补：
   873	      `Genera<U+200A>ted by GPT-4` → 删版还原出 `Generated by GPT-4`；
   874	      `Generated<U+200A>by GPT-4`  → 换空格版还原出 `Generated by GPT-4`。
   875	    """
   876	    return "".join(
   877	        repl
   878	        if (
   879	            unicodedata.category(c) in _INVISIBLE_CATEGORIES
   880	            or (c.isspace() and c not in " \t")
   881	        )
   882	        else c
   883	        for c in s
   884	    )
   885	
   886	
   887	def _guard_variants(ln: str) -> tuple[str, str]:
   888	    """护栏归一的**两种**零宽还原，都要试。
   889	
   890	    ⛔ round-3 审查 BLOCKER：上一版只做「零宽→空格」，那只对**词间**插入成立
   891	    （`by<ZWSP>GPT` → `by GPT`）。零宽插在**词内部**时（`genera<ZWSP>ted`），
   892	    换空格反而把关键词拆成 `genera ted`，骨架与标记表一起失效 —— 比不处理更糟。
   893	    两种还原互补，没有哪一种单独够用：
   894	      · 换空格：还原词间分隔（`by<ZWSP>GPT` → `by gpt`）；
   895	      · 直接删：还原词内断裂（`genera<ZWSP>ted` → `generated`）。
   896	    调用方对两个变体分别匹配，任一命中即算 —— 护栏宁可宽。
   897	    """
   898	    return (
   899	        _norm_ai_line(_strip_invisible(ln, " ")),
   900	        _norm_ai_line(_strip_invisible(ln, "")),
   901	    )
   902	
   903	
   904	def _norm_guard_line(ln: str) -> str:
   905	    """**护栏专用**归一：先把零宽字符换成空格，再走 `_norm_ai_line`。
  1418	    doi_bearing_pairs = [(k, v) for k, v in fm_pairs if _looks_like_doi_value(v)]
  1419	    slept_pairs = [(k, v) for k, v in fm_pairs if _norm_fm_key(k) == "slept_at"]
  1420	    # 兜底信号⑨（round-2 方向反转 → round-3 取消白名单，见上方常量段的两轮记录）：
  1421	    # frontmatter 里**任何非空值**都算引擎没消化的独有信息。`citation: ISBN …`、
  1422	    # `title: <这份材料唯一写下来的那句话>`、长模型名、`Generated by:` 与零宽变体
  1423	    # 全部由它兜住 —— 具体信号只负责给出更好的理由，安全底线在这一条。
  1424	    unknown_value_pairs = [(k, v) for k, v in fm_pairs if v]
  1425	    # 未消化信号⑩（round-3 审查 HIGH）：被**闭合** HTML 注释剥掉的原文行。
  1426	    # ⚠️ 与①（未闭合注释）对称：①保护的是「不知道被吞了什么」，⑩保护的是
