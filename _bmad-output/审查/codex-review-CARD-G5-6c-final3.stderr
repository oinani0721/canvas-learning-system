  1162	    # 围栏内容行哪怕每行都长得像围栏标记, 也是实质正文 (Markdown 围栏语法速查)
  1163	    mk(
  1164	        inbox / "围栏速查.md",
  1165	        "# Markdown 围栏语法速查\n\n## 空围栏怎么写\n\n````\n```\n```\n~~~\n~~~\n````\n",
  1166	        age_days=4,
  1167	    )
  1168	    # 正向对照: 只有围栏无内容 → 仍是空骨架; 正常围栏包着注释 → 仍非空骨架
  1169	    mk(inbox / "只有围栏.md", "````\n````\n", age_days=2)
  1170	    mk(inbox / "正常围栏.md", "```\n# keep\n```\n", age_days=1)
  1171	
