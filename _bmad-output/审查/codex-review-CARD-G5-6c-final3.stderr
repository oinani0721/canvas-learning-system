   731	def dup_body(text: str) -> str:
   732	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   733	
   734	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   735	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   736	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   737	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   738	    有后果的提名，依据必须逐字。
   739	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   740	    """
   741	    parts: list[str] = []
   742	    for ln, is_code in _classify_lines(text):
   743	        if not is_code and _HEADING_RE.match(ln):
   744	            continue
   745	        t = ln.rstrip()
   746	        if not t:
   747	            continue
   748	        parts.append(nfc(t))
   749	    return "\n".join(parts)
