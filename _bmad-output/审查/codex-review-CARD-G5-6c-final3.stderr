   429	_TZ_SHANGHAI = timezone(timedelta(hours=8))
   430	
   431	#: ATX 标题：**最多 3 个字面空格**缩进（⛔ 与 _FENCE_RE 同口径，\s 会放行
   432	#: 制表符/NBSP —— `\t# keep` 是缩进代码、`\xa0# keep` 是普通正文，都曾被当
   433	#: 标题剥掉 → 空骨架建议删，round-7 BLOCKER-2）。
   434	#: ⛔ **井号后的分隔同样只认 ASCII 空格/制表符**（CommonMark §4.2：开头的 `#`
   435	#: 序列后必须跟空格、制表符或行尾）：round-8 BLOCKER-1 实证前置缩进收窄后
   436	#: 后边界仍写着 `(?:\s|$)`，而 Python `re` 的 `\s` 在 str 模式下是 Unicode
   437	#: 语义 —— `#\xa0keep`（字节 23c2a06b6565700a）被当成标题剥掉 → 「标题 1 行、
   438	#: 实质正文 0 字符」→ `建议删 + confident=true`。同一条规则的两半只修一半，
   439	#: 等于没修。⚠️ 边界如实声明：本条只管**标题判定**；`#` 孤行（`# ` / `#\xa0`
   440	#: 这类井号后无实质内容者）经 `_ONLY_STRUCT_RE` 归入「纯结构行」，与普通空格
   441	#: 版本同桶 —— 那是既有的结构行口径，不是本条收窄出来的新差异。
   442	_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:[ \t]|$)")
   443	_LIST_PREFIX_RE = re.compile(r"^\s*(?:[-*+]\s+|\d{1,3}[.)]\s+|>\s?)+")
   444	#: 纯结构行（分隔线 / 表格分隔 / 空列表符）。⛔ 不含 `~`：`~~~` 是代码围栏标记，
   445	#: 由 `_classify_lines` 的状态机处理；把它当"结构"曾让整段围栏代码凭空消失。
   446	_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
   447	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   448	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   449	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   450	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   451	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   452	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   453	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   454	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   455	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   456	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   457	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   458	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   459	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   460	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   461	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   462	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   463	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   464	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   465	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   466	#: 里仍保留作防御深度。
   467	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
   468	
   469	
   470	def _is_primary_source_url(src: str) -> bool:
   471	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   472	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   473	    if not _URL_RE.match(src):
   474	        return False
   475	    try:
   476	        parts = urlsplit(src)
   477	    except ValueError:
   478	        return False
   479	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   480	
