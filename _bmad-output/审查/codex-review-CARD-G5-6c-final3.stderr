  2595	def test_heading_with_text_counts_as_substantive_content(tmp_path):
  2596	    """⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
  2597	
  2598	    起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了标题、正文
  2599	    还没动笔」的日常笔记，旧口径下是 `建议删 + confident=true` —— 那不是对抗
  2600	    构造，是真实使用场景。论证与本卡「取消 frontmatter 白名单」逐字同构：
  2601	    标题可能是随手一个字，也可能是这份材料唯一写下来的东西，引擎分不出，
  2602	    分不出就不该替用户决定。
  2603	    它顺带关闭了 U+3164/U+2800 那条此前未闭合的 BLOCKER —— 隐形字符伪装成正常
  2604	    标题时，标题里仍然「有字」。
  2605	
  2606	    ⚠\ufe0f 代价如实（本门同时锁住代价的边界）：C3 的可确定删除面收窄到「一个字都
  2607	    没写」的五种。这五种是正向对照，一条都不能失守，否则「少删」就变成
  2608	    「判据死了」。
  2609	    """
  2610	    mod = load_module()
  2611	    assert mod.has_substantive_content("# 微积分基本定理的两种证法\n") is True
  2612	    assert mod.has_substantive_content("# \n\n## \n") is False, "空标题模板仍是骨架"
  2613	    assert mod.has_substantive_content("#\t\n") is False, "井号+制表符+空 仍是骨架"
  2614	
  2615	    vault, out = base_vault(tmp_path)
  2616	    inbox = vault / "_待处理"
  2617	    mk(inbox / "只写了标题.md", "# 微积分基本定理的两种证法\n", age_days=9)
  2618	    mk(inbox / "标题加空小节.md", "# 待整理\n\n## \n", age_days=8)
  2619	    # ⛔ 关闭的 BLOCKER：隐形字符伪装成正常标题
  2620	    mk(inbox / "隐形字符标题.md", "# Genera\u3164ted by GPT-4\n", age_days=7)
  2621	    mk(inbox / "盲文空白标题.md", "# Genera\u2800ted by GPT-4\n", age_days=6)
  2622	    # ⛔ 正向对照（验伪锚）：C3 在新口径下**仅剩**的五种可达面
  2623	    mk(inbox / "C3-零字节.md", "", age_days=5)
  2624	    mk(inbox / "C3-纯空行.md", "\n\n\n", age_days=4)
  2625	    mk(inbox / "C3-纯分隔线.md", "---\n\n***\n", age_days=3)
  2626	    mk(inbox / "C3-空标题模板.md", "# \n\n## \n\n### \n", age_days=2)
  2627	    mk(inbox / "C3-只有引用符.md", "> \n> \n", age_days=1)
  2628	
  2629	    assert run_cli(vault, out).returncode == 0
  2630	    data = load_json(out)
  2631	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2632	    for name in ("只写了标题.md", "标题加空小节.md", "隐形字符标题.md", "盲文空白标题.md"):
  2633	        it = item_by_name(data, name)
  2634	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2635	        assert it["criterion"] == "C6_undecided", name
  2636	        assert it["confident"] is False, name
  2637	    for name in (
  2638	        "C3-零字节.md",
  2639	        "C3-纯空行.md",
  2640	        "C3-纯分隔线.md",
  2641	        "C3-空标题模板.md",
  2642	        "C3-只有引用符.md",
  2643	    ):
  2644	        ctrl = item_by_name(data, name)
  2645	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2646	        assert ctrl["verdict"] == "建议删", name
  2647	        assert ctrl["confident"] is True, name
   752	def has_substantive_content(text: str) -> bool:
   753	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   754	
   755	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   756	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   757	    合用一个函数正是 Codex BLOCKER 的根因。
   758	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   759	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   760	    （round-3 自审 B3-3）。
   761	    """
   762	    for ln, kind in _classify_lines_typed(text)[0]:
   763	        if kind == "code":
   764	            if ln.strip():
   765	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   766	            continue
   767	        if kind == "fence":
   768	            continue
   769	        if _HEADING_RE.match(ln):
   770	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   771	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   772	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   773	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   774	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   775	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   776	            # 替用户决定。
   777	            # ⛔ **声明收窄（第五轮终审实测证伪）**：本裁决只关闭 **C3 那一半**。
   778	            # C4 侧 `dup_body()` 仍把标题整行丢掉再比对，所以
   779	            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
   780	            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
   781	            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
   782	            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
   783	            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
   784	            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
   785	            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
   786	            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
   787	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   788	            # 仍可确定删除的是「一个字都没写」的五种：0 字节 / 纯空行 /
   789	            # 纯分隔线 / 空标题模板（`# ` 后无内容）/ 只有引用符。
   790	            if ln.lstrip(" \t#").strip():
   791	                return True
   792	            continue
   793	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   794	        if t and not _ONLY_STRUCT_RE.match(t):
   795	            return True
   796	    return False
