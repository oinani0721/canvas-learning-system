index 0000000000000000000000000000000000000000..993424cf197fa9c23c8958a35763c837bd80bb0a
--- /dev/null
+++ b//private/tmp/card-g56c-r7.o7v1JT/make_new_matrix.py
@@ -0,0 +1,30 @@
+from pathlib import Path
+import os
+
+root = Path("/private/tmp/card-g56c-r7.o7v1JT/new-matrix")
+vault = root / "vault"
+inbox = vault / "_待处理"
+for directory in (vault / "原白板", vault / "节点", inbox):
+    directory.mkdir(parents=True, exist_ok=False)
+
+cases = {
+    "01-body-define-symbol.md": ":=\n",
+    "02-body-arrow-symbol.md": "=>\n",
+    "03-body-logical-or.md": "||\n",
+    "04-fence-info-only.md": "```python title=\"母本第37页\"\n```\n",
+    "05-empty-fence.md": "```\n```\n",
+    "06-empty-task.md": "- [ ]\n",
+    "07-empty-callout.md": "> [!note]\n",
+    "08-format-only-heading.md": "# ** **\n",
+    "09-comment-outside-fence.md": "# \n<!-- source: https://outside.example/p -->\n",
+    "10-comment-inside-fence.md": "```html\n<!-- source: https://inside.example/p -->\n```\n",
+}
+
+for age, (name, text) in enumerate(cases.items(), start=1):
+    path = inbox / name
+    path.write_text(text, encoding="utf-8")
+    ts = 1_700_000_000 + age
+    os.utime(path, (ts, ts))
+
+for name, text in cases.items():
+    print(f"{name}\t{text.encode('utf-8').hex()}")

