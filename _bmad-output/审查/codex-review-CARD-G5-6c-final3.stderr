   634	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
   635	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。
   636	
   637	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   638	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   639	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   640	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   641	    分隔行由状态机精确标记，内容行一律是内容。
   642	
   643	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   644	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   645	
   646	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   647	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   648	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   649	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   650	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   651	    """
   652	    _, rest = split_frontmatter(text)
   653	    rows: list[tuple[str, str]] = []
   654	    stripped_comments: list[str] = []
   655	    in_fence = False
   656	    fence_char = ""
   657	    fence_len = 0
   658	    in_comment = False
   659	    for ln in rest:
   660	        m = _FENCE_RE.match(ln)
   661	        if m and not in_comment:
   662	            tok = m.group(1)
   663	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   664	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   665	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   666	            # 的 info string 允许反引号，不受此限。
   667	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   668	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   669	                rows.append((ln, "fence"))
   670	                continue
   671	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   672	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   673	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   674	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   675	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   676	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   677	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   678	            # 在 CommonMark 里是围栏内容）。
   679	            if (
   680	                tok[0] == fence_char
   681	                and len(tok) >= fence_len
   682	                and all(c in " \t" for c in ln[m.end() :])
   683	            ):
   684	                in_fence, fence_char, fence_len = False, "", 0
   685	                rows.append((ln, "fence"))
   686	                continue
   687	        if in_fence:
   688	            rows.append((ln, "code"))
   689	            continue
   690	        kept, rem = "", ln
   691	        while rem:
   692	            if in_comment:
   693	                i = rem.find("-->")
   694	                if i < 0:
   695	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   696	                    # （只收了闭合那一行的 `rem[:i]`），于是
   697	                    #   <!--
   698	                    #   source: https://…
   699	                    #   -->
   700	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   701	                    stripped_comments.append(rem)
   702	                    break
   703	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   704	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   705	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   706	                stripped_comments.append(rem[:i])
   707	                rem, in_comment = rem[i + 3 :], False
   708	            else:
   709	                i = rem.find("<!--")
   710	                if i < 0:
   711	                    kept += rem
   712	                    break
   713	                kept += rem[:i]
   714	                rem, in_comment = rem[i + 4 :], True
   715	        rows.append((kept, "text"))
   716	        # ⛔ round-3 审查 HIGH：闭合注释被这里整段剥掉，而来源/生成信号只扫
   717	        # frontmatter，⑨ 兜底也只覆盖 frontmatter —— 于是
   718	        # `<!-- source: https://… -->`、`<!-- DOI:10.1000/… -->`、
   719	        # `<!-- citation: ISBN … -->` 这类「唯一信息写在注释里」的文件
   720	        # C3/C4 双出口全穿。只有**未闭合**注释受保护，闭合的反而不受。
