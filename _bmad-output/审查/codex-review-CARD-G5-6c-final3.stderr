  1078	        norm = _norm_ai_line(ln)
  1079	        hits = [
  1080	            (pos, -len(nm), orig)
  1081	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
  1082	            if (pos := _find_marker_pos(norm, nm)) >= 0
  1083	        ]
