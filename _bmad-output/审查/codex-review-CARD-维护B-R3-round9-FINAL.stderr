  3409	    for tok, joined in (("九**五**", "九五"), ("九十八万**五**", "九十八万五")):
  3410	        r = verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3411	        assert r.returncode != 0, f"fallback {tok} 碎片被放行:\n{r.stdout}"
  3412	        assert _one_problem_has(r.stdout, "无法验证", joined), (
  3413	            f"fallback {tok}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3414	        )
  3415	
  3416	    # ── 放行面（同权重）：合法形态不得被这道收紧反噬 ──
  3417	    for name, line in (
  3418	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3419	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
  3420	        ("ASCII 在池 22", "- 本板共有22个子节点。【实测】"),
  3795	    """R3 round-6：渲染归一 + 六处非渲染缺口，逐条锁住。
  3796	
  3797	    **它证明什么**：
  3798	      · `_visible_text()` 把 HTML 实体（含 `&#xff19;` 这类全角实体，**先解实体
  3799	        再转全角**，顺序反了就永远转不成 ASCII）、HTML 标签、无别名 wikilink 的
  3800	        显示文本、零宽字符、强调标记统一归一到"读者看到的文本"；
  3801	      · 句式门 `总计/合计/共有` 其后接**任一数词样字符**（原只认 ASCII 数字，
  3802	        `总计五个` / `总计：987654个` 整句不进检查面）；
  3803	      · 区间分隔符含全角波浪等变体；负数计数恒 FAIL；量词表补常用字。
