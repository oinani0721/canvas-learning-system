   839	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   840	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   841	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   842	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   843	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   844	    if CHILD_CRASH_MARK in out:
   845	        return True
   846	    LEGIT_RED = {"assert", "AssertionError"}
   847	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   848	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   849	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   850	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   851	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   852	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   853	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   854	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   855	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   856	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   857	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   858	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   859	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   860	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   861	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   862	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   863	    return bool(
   864	        any(name not in LEGIT_RED for name in exc_names)
   865	        or "Traceback (most recent call last):" in out
   866	        or "INTERNALERROR" in out
   867	        or errors > 0
   868	    )
