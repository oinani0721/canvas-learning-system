  3666	def test_domain_r8_entities_ranges_and_table_gaps_cli(tmp_path):
  3667	    """R3 round-5 行为门：HTML 实体 / 区间共用式 / 两张封闭表的补漏。
  3668	
  3669	    七条实测反例（修前全部 exit 0，见 evidence-maintb-r3/m-round4-high-repro.txt）：
  3670	      1. `总计987654-0个…` —— 区间**先挖空、后判句式**，挖空后 `_D2_CLAIM_RE` 的
  3671	         「共有/总计 + 数字」分支失锚 ⇒ continue，已收集的坏端点不再报。
  3672	      2. `本板共有987654<b>-</b>0个…` —— 区间正则是裸 ASCII 窄路径，不复用数串式。
  3673	      3. `987654<b>,</b>000个` / fallback `1<b>,</b>005` —— 千分位只认紧邻逗号。
  3674	      4. `987654&#46;0个` / `987654&#20010;` —— HTML 字符实体未规范化。
  3675	      5. `.5个` / `．五个` —— 小数式要求分隔符两侧都有数串。
  3676	      6. `九兆五个` —— `兆` 不在定界集 ⇒ 从尾片重锚（与 `廿五` 同机制）。
  3677	      7. `987654层关系` —— `层` 不在量词表 ⇒ 整句零校验。
  3678	
  3679	    **它证明什么**：句式判定取自**挖空之前**的行；区间端点走与普通计数**同一个**
  3680	    判值器（中文/混写端点不再免检）且两端都报；HTML 实体先解再核；小数左侧可缺；
  3681	    两张封闭表补入常用字符后对应形态被拦。
  3682	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 与 `_D2_QUANT` **仍是封闭表**——
  3683	    补的是"已知常用"，不是全集。`html.unescape` 也只覆盖标准实体。
  3684	    根本口径见验收单 §五之四：源码级归一化在对抗范式下不可清零。
  3685	    """
  3686	    vault = standard_vault(tmp_path)
  3687	    scan = collect_json(vault)
  3688	    pool = _load_recap_scan()._derived_number_pool(scan)
  3689	    assert 0 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3690	    report = write_report(vault, scan)
  3691	    base_text = report.read_text(encoding="utf-8")
  3692	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3693	
  3694	    def verify(anchor: str, injected: str):
  3695	        text = base_text.replace(anchor, injected, 1)
  3696	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3697	        report.write_text(text, encoding="utf-8")
  3698	        return run_verify(report)
  3699	
  3700	    def d2(line: str):
  3701	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3702	
  3703	    def fb(tok: str):
  3704	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3705	
  3706	    # 1/2：区间。⛔ Codex 指出既有门都用「大数在一端 + 池内 0」，一个只检查
  3707	    # max(ends) 的实现仍会全绿 ⇒ 这里补「双端均坏、逐个报」与非 `个` 量词。
  3708	    for name, line, tokens in (
  3709	        ("裸『总计』句式", "- 总计987654-0个子节点。【实测】", ("987654",)),
  3710	        ("连接字符连字符", "- 本板共有987654<b>-</b>0个子节点。【实测】", ("987654",)),
