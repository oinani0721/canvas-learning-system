  5069	            {"ledger": {"derived": [{"node_id": "DerivedX", "tips_count": 5}]}},
  5070	        ),
  5071	        (
  5072	            "## 台账\n\n### 种子\n\n- SeedA — 批注 2 条\n\n```\n- SeedA — 批注 999 条\n```\n\n## 末\n",
  5073	            None,
  5074	            "小节内围栏中的字面行不得被当台账行",
  5075	            None,
  5076	        ),
  5077	    ):
  5078	        ps = run(text, scan)
  5079	        if want is None:
