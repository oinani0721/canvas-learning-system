  5086	def test_domain_r25_section_criterion_unified_cli(tmp_path):
  5087	    """R3 round-29（冻结审查 v10）：段落标题**唯一口径** + 围栏内假标题不截断小节。
  5088	
  5089	    ⛔ `_SECTION_RE` 的 docstring 明写：「存在性检查与下游定位**必须共用本函数** ——
  5090	    两处口径一旦不同，就会出现『算在场却定位不到』的缝隙」。round-28 我在种子扫描里
  5091	    **自己写了两式**，正好犯了它警告的那件事：
  5092	
  5093	      · `## 台账（x`（未闭合括号）—— 必需段门认在场，我的式子不认 ⇒ 种子校验器
  5094	        拿到零个 section 直接返回，`999` **完全不绑定**；
  5095	      · 反向，我新接受的 `   ## 台账` / `## 台账 ###` 又会被必需段门拒绝。
  5096	
  5097	    ⇒ 改回共用 `_SECTION_RE`。缩进标题与 ATX 闭合井号两侧**一致地不接受**：
  5098	    写成那样的报告会被必需段门直接判 FAIL（本门第 ④ 段端到端验证），整体 fail-closed。
  5099	    要放宽就得改 `_SECTION_RE` 本体让两侧同时动 —— 不在本轮范围。
  5100	
  5101	    **它证明什么**：口径分叉的两个方向都堵上；围栏内假标题不再截断小节；
  5102	    「不接受缩进标题」在 CLI 全链路上是 fail-closed 而非漏网。
  5103	    **它不证明什么**：不证明 `_SECTION_RE` 的接受集与 CommonMark 一致
  5104	    （它**不**接受合法的 0-3 格缩进与 ATX 闭合序列）—— 那是**声明过的统一口径**，
  5105	    要改需连同全部消费方一起改，如实登记。
  5106	    """
  5107	    rs = _load_recap_scan()
  5108	    S = {"ledger": {"seeds": [{"node_id": "SeedA", "tips_count": 2}]}}
  5109	
  5110	    def run(text: str) -> list[str]:
  5111	        ps: list[str] = []
  5112	        rs._verify_seed_ledger_counts(text, S, ps)
  5113	        return ps
  5114	
  5115	    # ① 口径分叉的正向：必需段门认在场的形态，种子绑定也必须认
  5116	    ps = run("## 台账（x\n### 种子\n- SeedA — 批注 999 条\n\n## 末\n")
  5117	    assert any("999" in p for p in ps), f"`## 台账（x` 下的冲突行未绑定：{ps!r}"
  5118	    # 与全局口径同源（漂移即被抓）
  5119	    import re as _re
  5120	
  5121	    assert _re.match(rs._SECTION_RE("## 台账"), "## 台账（x"), "前提：必需段门确实接受该形态"
  5122	
  5123	    # ② 围栏内的假标题不得截断小节
  5124	    ps = run("## 台账\n\n### 种子\n\n```\n## 假标题\n```\n\n- SeedA — 批注 999 条\n\n## 末\n")
  5125	    assert any("999" in p for p in ps), f"围栏内假标题截断了小节：{ps!r}"
  5126	
  5127	    # ③ 一致地不接受（两侧同口径）
  5128	    for text, why, want in (
  5129	        (
  5130	            "   ## 台账\n\n   ### 种子\n\n- SeedA — 批注 999 条\n\n## 末\n",
  5131	            "缩进 ATX 标题",
  5132	            None,  # ⛔ round-33：缩进 `## 台账` ⇒ 取不到台账段 ⇒ helper 静默（CLI 由必需段门 fail-closed）
  5133	        ),
  5134	        ("## 台账\n\n### 种子 ###\n\n- SeedA — 批注 999 条\n\n## 末\n", "ATX 闭合井号", "找不到可绑定"),
  5135	    ):
  5136	        # ⛔ round-30：H2 不合口径 ⇒ 不扫描（由全局必需段门兜底，见第 ④ 段）；
  5137	        #    H3 不合口径 ⇒ **本函数自己 fail-closed**（H3 没有全局门）。
  5138	        ps = run(text)
  5139	        if want is None:
  5140	            assert ps == [], f"{why}：与全局口径不一致地被接受了"
  5141	        else:
  5142	            assert any(want in p for p in ps), f"{why}：H3 不合口径未 fail-closed —— {ps!r}"
  5143	
  5144	    # ④ 端到端：不接受 ≠ 漏网 —— 必需段门必须把这种报告判 FAIL
  5145	    vault = standard_vault(tmp_path)
  5146	    scan = collect_json(vault)
  5147	    report = write_report(vault, scan)
  5148	    base = report.read_text(encoding="utf-8")
  5149	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  5150	    mt = re.search(r"^## 台账.*$", base, re.M)
  5151	    assert mt, "前提：报告必须含『## 台账』段"
  5152	    report.write_text(base.replace(mt.group(0), "   " + mt.group(0), 1), encoding="utf-8")
  5153	    assert run_verify(report).returncode != 0, "缩进 `## 台账` 的报告未被必需段门拒 —— 那样「不接受」就成了漏网"
  5154	
