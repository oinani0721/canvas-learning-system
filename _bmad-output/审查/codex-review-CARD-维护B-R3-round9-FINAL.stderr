   460	                "role": n.get("role", "unknown"),
   461	                "role_source": "manifest",
   462	                "is_stub": bool(n.get("is_stub")),
   463	                "mastery_score": _finite(mastery.get("score")),
   464	                "mastery_source": _oneline(mastery.get("source") or "", 40) or None,
   465	                "attempt_count": _int_or_none(n.get("attempt_count")),
   466	                "last_examined": _oneline(n.get("last_examined") or "", 64) or None,
   467	                "created_at": _oneline(n.get("created_at") or "", 64) or None,
   468	                "created_from": _oneline(n.get("created_from") or "", 80) or None,
   469	                # G5-4 加性: 后端已 resolve_node_id 归一为 stem;
   470	                # _passthrough_note_ref 只对残留 wikilink 形态补归一 (幂等, M1)
   471	                "source_note": _passthrough_note_ref(n.get("source_note")),
   472	                "pick_rank": _int_or_none(pick.get("pick_rank")),
   473	                "relation_type": _oneline(rel.get("type") or "", 40) or None,
   474	                # Codex round-2 M1: relation_target 与 source_note 同归一,
   475	                # 否则同一来源在两字段/两模式间形态不一 (一个 stem 一个原串);
   476	                # round-3 M1: 用幂等的 passthrough 版 (后端已 resolve 过)
   477	                "relation_target": _passthrough_note_ref(rel.get("target_node_id")),
   478	                "derived_at": _oneline(rel.get("derived_at") or "", 64) or None,
   479	                "derived_reason": _oneline(rel.get("derived_reason") or "", 200)
   480	                or None,
