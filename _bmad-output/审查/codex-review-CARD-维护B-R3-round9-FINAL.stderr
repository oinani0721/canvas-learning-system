  3168	    **它不证明什么**: 不证明调用方正确使用了它——那是下面三道门的事。
  3169	    """
  3170	    rs = _load_recap_scan()
  3171	
  3172	    assert not hasattr(rs, "_cjk_to_int"), "多位中文数词解析器复活了——R3 冻结口径禁止重新引入（round-5 HIGH 的根因）"
  3173	    # ⛔ 期望值必须有**独立来源**: 第一版写成 `for ch, want in rs._CJK_NUM.items()`
  3174	    # ——期望值与被测值取自同一张表，把 `零/〇` 的映射改成 7 全套件照样 253 全绿
  3175	    # （车道对抗审查实测）。自抄期望 = 自证恒真 = 假门。这里逐字写死。
  3176	    EXPECT = {
  3177	        "零": 0,
  3178	        "〇": 0,
  3179	        "一": 1,
  3180	        "二": 2,
  3181	        "两": 2,
  3182	        "三": 3,
  3183	        "四": 4,
  3184	        "五": 5,
  3185	        "六": 6,
  3186	        "七": 7,
  3187	        "八": 8,
  3188	        "九": 9,
  3189	    }
  3190	    UNITS = {"十": 10, "百": 100, "千": 1000, "万": 10000, "亿": 100000000}
  3191	    assert rs._CJK_NUM == EXPECT, f"单字数词表被改动: {rs._CJK_NUM}"
  3192	    assert rs._CJK_UNIT == UNITS, f"量词表被改动: {rs._CJK_UNIT}"
  3193	    for ch, want in EXPECT.items():
  3194	        assert rs._cjk_single_to_int(ch) == want, f"单字数词 {ch} 取值错"
  3195	    for ch in UNITS:  # 十百千万亿 不在 _CJK_NUM ⇒ 单字量词同样无法确定
  3196	        assert rs._cjk_single_to_int(ch) is None, f"单字量词 {ch} 必须 fail-closed"
  3197	    for s in ("一零", "五四", "九十八万", "零一", "十二", "两三", "", "甲", "五个"):
  3198	        assert rs._cjk_single_to_int(s) is None, f"{s!r} 必须判「无法确定」（不猜）"
  3199	
  3200	    # 提取面必须覆盖判据面: **抓得到才拒得掉**。提取面漏字 ⇒ 该字组成的串落到
  3201	    # 检查面之外 = 漏拦（不是 fail-closed）。
  3202	    assert set(rs._CJK_NUM_CHARS) == set(EXPECT) | set(UNITS)
  3203	    # ⛔ R3 round-3: 取数用的是**宽集合**（数词样字符），它只用于**定界**、不赋值。
  3204	    # 表外数词字（廿卅/大写金融数字）必须进得来——进不来 ⇒ `廿五个` 会从 `五`
  3205	    # 重锚按 5 查池而放行（Codex round-2 HIGH，车道实测 rc=0）。
  3206	    # ⛔ 精确相等而非子集包含（Codex round-3 属实指出：子集断言锁不住声明里的
  3207	    # `卌` 与各种异体，表少一个字就意味着那类写法会从尾片重锚）。
  3208	    assert set(rs._NUMERAL_LIKE_CHARS) == (
  3209	        set(rs._CJK_NUM_CHARS)
  3210	        | set("0123456789")
  3211	        | set(
  3212	            "廿卅卌壹贰貳叁參参肆伍陆陸柒捌玖拾佰仟萬亿億两兩兆京垓秭穰仨俩①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳〡〢〣〤〥〦〧〨〩〸〹〺"
  3213	        )
  3214	    ), f"定界集漂移: {rs._NUMERAL_LIKE_CHARS}"
  3215	    # 宽集合只定界不赋值：表外字符进来只会让整串"无法确定"，不会被猜成某个数。
  3216	    for s in ("廿五", "壹佰", "九十八万5", "五四", "一零"):
  3217	        assert rs._count_token_value(s) is None, f"{s!r} 不得被赋值"
  3218	    for s, want in (("980005", 980005), ("016", 16), ("五", 5), ("0", 0)):
  3219	        assert rs._count_token_value(s) == want, f"{s!r} 取值错"
  3220	    m = rs._NUM_RUN_RE.match("九十八万")
  3221	    assert m and m.group(0) == "九十八万", "提取面抓不到连续多字串 = 漏拦"
  3222	    # ⛔ 且必须**跨排版噪声/不可见字符**整体抓 —— 断开就只剩尾片，判据再「绝对
  3223	    # 确定」也没用（拿到的 token 不是那句话里的数）。这一条是 R3 round-2 的
  3224	    # BLOCKER：`九十八万**五**个` 渲染出来就是「九十八万五个」，实测曾 exit 0。
  3225	    for name, s in (
  3226	        ("粗体", "九十八万**五"),
  3227	        ("空白", "九十八万 五"),
  3228	        ("nbsp", "九十八万&nbsp;五"),
  3229	        ("零宽", "九十八万\u200b五"),
  3230	        ("空标签", "九十八万<span></span>五"),
  3231	        ("HTML注释", "九十八万<!--x-->五"),
  3232	    ):
  3233	        m = rs._NUM_RUN_RE.match(s)
  3234	        assert m and m.group(0) == s, f"{name}切断: 提取面只抓到 {m and m.group(0)!r}"
  3235	        assert rs._join_free(m.group(0)) == "九十八万五", f"{name}: 剥噪声后不是原数"
  3236	        assert rs._cjk_single_to_int(rs._join_free(m.group(0))) is None
