   871	def run_suite(targets: list[str], keyword: str | None = None) -> tuple[int, str, int, int, bool]:
   872	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数, 是否崩溃)。
   873	
   874	    ⛔ round-36：`targets` 是**精确 nodeid 列表**（基线态传套件路径 + keyword）。
   875	    原先靠 `-k` 选门，12 条变体的 keyword 一选就是好几个用例，
   876	    「有失败」证明不了「**指定**门死了」——见 `DESIGNATED` 的说明。
   877	
   878	    ⛔ round-27（冻结审查 v8）：注解与 docstring 原写**四元组**，实际返回五元组
   879	    （`crash` 是 round-10 加的）—— 又一处「说的与做的不符」。
   880	
   881	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   882	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   883	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   884	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   885	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   886	    要求"确实收集到用例"且"确实有失败"才算变红。
   887	    """
   888	    r = subprocess.run(
   889	        [str(PYTEST), *targets, "-q", "-p", "no:cacheprovider"] + (["-k", keyword] if keyword else []),
   890	        cwd=ROOT / "backend",
   891	        capture_output=True,
   892	        text=True,
   893	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   894	        timeout=600,
   895	    )
   896	    out = r.stdout
   897	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   898	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   899	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   900	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   901	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   902	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   903	    both = _crash_text(out, r.stderr)
   904	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   905	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   906	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   907	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   908	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   909	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   910	    # 的形式混进证据, 且永远不会有人去查。
   911	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   912	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   913	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   914	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   915	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   916	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   917	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   918	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   919	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   920	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   921	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   922	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   923	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   924	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   925	    crash = _looks_like_crash(both)
   926	    return r.returncode, out[-400:], passed + failed, failed, crash
