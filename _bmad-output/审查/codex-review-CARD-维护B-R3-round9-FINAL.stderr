  5002	def test_domain_r24_fence_closer_atx_and_tail_prefix():
  5003	    """R3 round-28（冻结审查 v9）：顶层围栏闭合 / ATX 缩进与闭合序列 / 尾巴前缀。
  5004	
  5005	    审查方给的反例与我的处置：
  5006	      · **顶层**围栏内的 `- ``` ` 被当成闭栏、下一行重新开栏 ⇒ 用户可见正文被剥到
  5007	        EOF。CommonMark 里闭栏必须在**同一容器**内。⇒ 判闭栏时引用前缀恒剥，
  5008	        **列表 marker 只在开栏本身就在列表项内时才剥**。
  5009	        ⚠️ 第一版我不分容器一律禁列表 marker，当场打红 `strip_code_blocks` 单元
  5010	        契约门（列表项内围栏本来就由下一个 `- ``` ` 闭合）；
  5011	      · round-27 的 `(?<![\u4e00-\u9fff])批注` 排除了**所有**汉字前缀 ⇒
  5012	        `累计/共/已批注 999 条` 全部放过。⇒ 只排除**否定前缀**「未」；
  5013	      · ATX 标题的合法 0-3 格缩进不识别；`### 种子###`（闭合井号前无空白）误认；
  5014	      · `seeds` 缺失/非 list 时**静默回落**到摊平全部角色 —— 那正是本轮要堵的洞。
  5015	
  5016	    **它证明什么**：八种形态的行为（含三种前缀、两种标题、fail-closed、小节内围栏）。
  5017	    **它不证明什么**：**列表 continuation 未建模**（`- item` 之后的相对内容列），
  5018	    审查方判为需重做设计；`_strip_code_blocks` 的行数前提准确表述是
  5019	    **索引映射保持、尾项由越界兜底补偿**（末尾空项会丢），不是无条件行数恒等。
  5020	    """
  5021	    rs = _load_recap_scan()
  5022	
  5023	    # 顶层围栏内的列表 marker 行不是闭栏 ⇒ 其后的可见正文必须留下
  5024	    assert "本板共有987654个子节点" in rs._strip_code_blocks("```\n- ```\n```\n本板共有987654个子节点"), (
  5025	        "顶层围栏内的 `- ```` 被误当闭栏，可见正文被剥到 EOF"
  5026	    )
  5027	    # 列表项内围栏仍由下一个 `- ```` 闭合（round-2 固化形态，不得回归）
  5028	    assert rs._strip_code_blocks("- ```\n  x：无据\n- ```").strip() == "", "列表项内围栏未整块剥空"
  5029	
  5030	    SEEDS = {
  5031	        "ledger": {
  5032	            "seeds": [{"node_id": "SeedA", "tips_count": 2}],
  5033	            "derived": [{"node_id": "DerivedX", "tips_count": 5}],
  5034	        }
  5035	    }
  5036	
  5037	    def run(text: str, scan=None) -> list[str]:
  5038	        ps: list[str] = []
  5039	        rs._verify_seed_ledger_counts(text, scan or SEEDS, ps)
  5040	        return ps
  5041	
  5042	    def L(row: str) -> str:
  5043	        return f"## 台账\n\n### 种子\n\n{row}\n\n## 末\n"
  5044	
  5045	    for text, want, why, scan in (
  5046	        (L("- SeedA — 批注 2 条（累计批注 999 条）"), "尾巴里又出现", "尾巴 `累计批注`", None),
  5047	        (L("- SeedA — 批注 2 条（共批注 999 条）"), "尾巴里又出现", "尾巴 `共批注`", None),
  5048	        (L("- SeedA — 批注 2 条（已批注 999 条）"), "尾巴里又出现", "尾巴 `已批注`", None),
  5049	        (L("- SeedA — 批注 2 条（未批注 999 条）"), None, "反向：`未批注` 不得误伤", None),
  5050	        # ⛔ round-29：同上 —— `_SECTION_RE` 不接受前导缩进，两侧一致地不接受。
  5051	        (
  5052	            "   ## 台账\n\n   ### 种子\n\n- SeedA — 批注 999 条\n\n## 末\n",
  5053	            None,
  5054	            "⛔ round-33：缩进 `## 台账` ⇒ 取不到台账段 ⇒ helper 静默；"
  5055	            "整体由**必需段门**判 FAIL（R25 第 ④ 段端到端验证）",
  5056	            None,
  5057	        ),
  5058	        # ⛔ round-30：同上，H3 不合口径不再静默跳过。
  5059	        (
