  1826	def _normalize_number_seps(line: str) -> str:
  1827	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1828	
  1829	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1830	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1831	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1832	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1833	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1834	    """
  1835	    # ⛔ R3 round-6: 解 HTML 实体已上移到 _visible_text() —— 两个消费点都在最前面
  1836	    # 跑它, 此处再解一次是**冗余**（且 `&amp;#46;` 会被双重解码成 `.`, 反而错）。
  1837	    # 一个性质只应有一个实现位置; 留在这里就是死代码。
  1838	    # ⛔ R3 round-5 (Codex round-4 HIGH-3): 逗号两侧也可能夹连接字符 ——
  1839	    # `987654<b>,</b>000个` 渲染成 `987654,000个`, 原式(要求逗号紧邻数字)不命中。
  1840	    # ⛔ R3 round-35（2026-09-03 内部多维复核 BLOCKER）：原式的
  1841	    #    `(?=[0-9]{3}(?![0-9]))`「恰好三位分组」前瞻制造了**第三态** ——
  1842	    #    分隔符既**不被删**（不满足前瞻）也**不算连接字符**（不在 _D2_JOIN_ONE 里），
  1843	    #    于是成为**硬断点**，`_NUM_RUN_PAT` 从它之后重锚到尾片：
  1844	    #      · `987654,0`  ⇒ 只看到 `0`，而 0 因 `abs(a-a)` **恒在池内** ⇒ 放行
  1845	    #      · `987654，0` / `987654'0`（全角逗号 / 本函数自己声明的 Swiss 撇号）同上
  1846	    #      · `1,05`      ⇒ 读者读 105，校验器读 5
  1847	    #      · `987654,000` ⇒ 拦下 ✓（**只差「分组是否恰好三位」**）
  1848	    #    与 round-2 的「九十八万**五** / 980 005」是**同一个尾片重锚病**，
  1849	    #    只是断点字符换成了本函数自己声明为「数串内部分隔符」的那几个。
  1850	    #    ⇒ 降级为**无条件**数串内噪声（一律删，不看位数），与 _D2_JOIN_ONE 同级。
  1851	    #    `int("105")` 本就按十进制解析，删分隔符不会改变量级；
  1852	    #    真正危险的是留下任何字符停在「不删也不断」的第三态。
  1853	    #    ⚠️ 仍要求两侧都是数字，`见 1,と` 这类非数字上下文不受影响。
  1854	    return re.sub(
  1855	        rf"([0-9]){_D2_JOIN_ONE}*[,，'’]{_D2_JOIN_ONE}*(?=[0-9])",
  1856	        r"\1",
  1857	        line,
  1858	    )
