  5241	            {"seeds": []},
  5242	        ),
  5243	        (
  5244	            "小节之外",
  5245	            "第六形态 b：认可的空小节 + 第二个不认可 H3 + Ghost（非零种子板）",
  5246	            "## 台账\n\n### 种子\n\n\n\n### 种子 ###\n\n- Ghost — 批注 9 条\n\n## 末\n",
  5247	            {"seeds": [{"node_id": "S", "tips_count": 2}]},
  5248	        ),
  5249	        (
  5250	            "含非对象条目",
  5251	            "损坏 seeds=[None] 不得被当成合法零种子",
  5252	            "## 台账\n\n### 种子\n\n- X — 批注 1 条\n\n## 末\n",
  5253	            {"seeds": [None]},
  5254	        ),
  5255	        (
  5256	            None,
  5257	            "对照：合法零种子且无种子小节",
  5258	            "## 台账\n\n### 派生\n\n- X — 批注 1 条\n\n## 末\n",
  5259	            {"seeds": [], "derived": [{"node_id": "X", "tips_count": 1}]},
  5260	        ),
  5261	        (
  5262	            None,
  5263	            "对照：合法认可小节 + 数字对",
  5264	            "## 台账\n\n### 种子\n\n- S — 批注 2 条\n\n## 末\n",
  5265	            {"seeds": [{"node_id": "S", "tips_count": 2}]},
  5266	        ),
  5267	        (
  5268	            "小节之外",
