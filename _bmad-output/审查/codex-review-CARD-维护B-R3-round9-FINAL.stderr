  3365	    pool = _load_recap_scan()._derived_number_pool(scan)
  3366	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3367	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3368	    report = write_report(vault, scan)
  3369	    base_text = report.read_text(encoding="utf-8")
  3370	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3371	
  3372	    def verify(anchor: str, injected: str):
  3373	        text = base_text.replace(anchor, injected, 1)
  3374	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3375	        report.write_text(text, encoding="utf-8")
  3376	        return run_verify(report)
  3377	
  3378	    def d2(line: str):
  3379	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3380	
  3381	    # ── 拦截面：渲染后连续、源码被切断 ──
  3382	    for name, line in (
  3383	        ("粗体", "- 本板共有九十八万**五**个子节点。【实测】"),
  3384	        ("空白", "- 本板共有九十八万 五个子节点。【实测】"),
  3385	        ("nbsp", "- 本板共有九十八万&nbsp;五个子节点。【实测】"),
  3386	        ("空标签", "- 本板共有九十八万<span></span>五个子节点。【实测】"),
  3387	        ("修饰字余", "- 本板共有九十八万余五个子节点。【实测】"),
  3388	        ("行内代码", "- 本板共有九十八万`x`五个子节点。【实测】"),
  3389	    ):
  3390	        r = d2(name and line)
  3391	        assert r.returncode != 0, f"CJK {name}切断被放行:\n{r.stdout}"
  3392	        assert _one_problem_has(r.stdout, "无法解析", "九十八万五"), (
  3393	            f"CJK {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
