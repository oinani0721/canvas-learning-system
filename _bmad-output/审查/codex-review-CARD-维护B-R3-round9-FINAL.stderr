  3328	        assert r.returncode != 0, f"{tok}: D2 段多字数词自陈被放行:\n{r.stdout}"
  3329	        assert "无法解析" in r.stdout, f"{tok}: 应走「无法解析」fail-closed:\n{r.stdout}"
  3330	        assert "找不到同值来源" not in r.stdout, f"{tok}: 仍按局部值查池:\n{r.stdout}"
  3331	    r = _mutate_report(tmp_path / "d2-五", prose_case("五"))
  3332	    assert r.returncode == 0, f"值在池的单字自陈被误伤:\n{r.stdout}"
