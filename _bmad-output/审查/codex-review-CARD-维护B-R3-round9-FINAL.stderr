  3306	def test_domain_r5_prose_cjk_multichar_fail_closed_cli(tmp_path):
  3307	    """R3 行为门②: D2 叙述段的多字中文数词计数同样 fail-closed。
  3308	
  3309	    ⛔ 这是 R3 开工实测的**漏拦**（不是假想）: c754b043 只封了 fallback 一侧，
  3310	    `- 本板共有一零个子节点。【实测】` 在开工 HEAD `c754b043` 上 **exit 0 放行**
  3311	    （`_cjk_to_int("一零") == 0`，0 恒在池内）。红证据:
  3312	    `_bmad-output/审查/evidence-maintb-r3/b-prefix-red-repro.txt`。
  3313	
  3314	    **它证明什么**: 该形态现在 exit 1、诊断为「无法解析」，且不再产生按局部值的
  3315	    池比对结论；值在池的单字自陈（`共有五个`）不误伤。
  3316	    **它不证明什么**: 不证明 D2 对**所有**数字形态的绑定力——池碰撞判据的固有
  3317	    边界见 test_domain_block_bare_count_in_prose 的说明，本卡未改变它。
  3318	    """
  3319	
  3320	    def prose_case(tok: str):
  3321	        def m(text, scan):
  3322	            return text.replace("## 三维审查", f"## 三维审查\n\n- 本板共有{tok}个子节点。【实测】", 1)
  3323	
  3324	        return m
  3325	
  3326	    for tok in ("一零", "五四", "九十八万", "十"):
