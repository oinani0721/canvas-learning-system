  5306	def test_domain_r28_tips_binding_visible_space_cli(tmp_path):
  5307	    """R3 round-34（B1，冻结审查 v9~v14 **连续七轮**点名）：tips 两数的渲染空间绑定。
  5308	
  5309	    ⛔ 这是本卡**最老、最明确、修法最现成**的一条未闭合项 —— 每轮我都登记「未改」，
  5310	    而修法从 round-18 起就已存在（`_visible_block`，与种子小节 / 五元组 /
  5311	    ③段信号行**逐字同型**，那三处都已被审查判 ✅）。
  5312	    它一直排在队尾，不是被遗忘，是**优先级的结构性偏差**：新问题天然显得更紧急，
  5313	    而「已经登记过 N 轮」在心理上会被当成「已经处理过」。
  5314	
  5315	    实测三条（修前 exit 0）：保留正确行 + 追加**渲染等价但源码不命中**的冲突行
  5316	      · `- tips 批**注**共 999 条`
  5317	      · `- tips 批<b>注</b>共 999 条`
  5318	      · `- 其中理解度未**闭**环 999 条`
  5319	
  5320	    ⚠️ **复现方法本身有个坑**：第一版载荷把整行复制过去（含 `其中理解度未闭环 4 条`），
  5321	    结果被**相邻**那条模式的唯一性检查拦下 —— 典型的**纵深遮蔽**，差点让我误判
  5322	    「不可复现」。干净载荷必须只含被切断的那**一个**模式。
  5323	
  5324	    **它证明什么**：段抓取与两条模式的 in_sec/all_hits 都在渲染空间比对。
  5325	    **它不证明什么**：不改变 tips 绑定的**语义**（仍是「段内恰一条 + 全文逐条等值」）；
  5326	    也不覆盖中文数词 / 带圈数字等非 `Nd` 形态（见接手清单 B3）。
  5327	    """
  5328	    vault = standard_vault(tmp_path)
  5329	    scan = collect_json(vault)
  5330	    report = write_report(vault, scan)
  5331	    base = report.read_text(encoding="utf-8")
  5332	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  5333	
  5334	    tips = next((ln for ln in base.splitlines() if re.search(r"tips 批注共\s*\d+\s*条", ln)), None)
  5335	    assert tips, "前提：报告必须含 tips 标准计数行"
  5336	
  5337	    def with_conflict(conflict: str):
  5338	        text = base.replace(tips, tips + "\n" + conflict, 1)
  5339	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  5340	        report.write_text(text, encoding="utf-8")
  5341	        return run_verify(report)
  5342	
  5343	    for conflict, why in (
  5344	        ("- tips 批**注**共 999 条", "第一条模式被强调标记切开"),
  5345	        ("- tips 批<b>注</b>共 999 条", "第一条模式被 HTML 标签切开"),
  5346	        ("- 其中理解度未**闭**环 999 条", "第二条模式被强调标记切开"),
  5347	        ("- tips 批注共 999 条", "对照：裸冲突行"),
  5348	    ):
  5349	        r = with_conflict(conflict)
  5350	        assert r.returncode != 0, f"{why}：冲突行被放行 —— {conflict!r}"
  5351	        assert _one_problem_has(r.stdout, "999"), f"{why}：诊断未指向冲突值 999\n{r.stdout}"
  5352	
  5353	    # 不得误伤：把**正确行本身**写成渲染等价的强调形态，仍须通过
  5354	    report.write_text(
  5355	        base.replace(tips, tips.replace("tips 批注共", "tips 批**注**共", 1), 1),
  5356	        encoding="utf-8",
  5357	    )
  5358	    assert run_verify(report).returncode == 0, "渲染等价的合规 tips 行被误判"
  5359	
  5360	
  5361	def test_domain_r29_separator_third_state_cli(tmp_path):
  5362	    """R3 round-35（2026-09-03 内部多维复核 BLOCKER）：分隔符的**第三态**。
  5363	
  5364	    ⛔ `_normalize_number_seps` 原式带 `(?=[0-9]{3}(?![0-9]))`「恰好三位分组」前瞻，
  5365	    于是 `,，'’` 在同一个函数里有**两种互斥语义**，并制造出**第三态**：
  5366	    分隔符既**不被删**（不满足前瞻）也**不算连接字符**（不在 `_D2_JOIN_ONE` 里）
  5367	    ⇒ 成为**硬断点**，`_NUM_RUN_PAT` 从它之后重锚到尾片。
  5368	
  5369	    实测四条（修前全部 exit 0）：
  5370	      · `987654,0`  —— 只看到 `0`，而 0 因 `abs(a-a)` **恒在池内**
  5371	      · `987654，0` —— 全角逗号
  5372	      · `987654'0`  —— Swiss 撇号，**本函数自己声明**的分隔符
  5373	      · `1,05`      —— 读者读 105，校验器读 5
  5374	    对照 `987654,000` 修前即拦下 —— **只差「分组是否恰好三位」**。
  5375	
  5376	    这与 round-2 的「九十八万**五** / 980 005」是**同一个尾片重锚病**，
  5377	    只是断点字符换成了本函数自己声明为「数串内部分隔符」的那几个。
  5378	
  5379	    **它证明什么**：分隔符一律按数串内噪声删除（与 `_D2_JOIN_ONE` 同级），
  5380	    不再有「不删也不断」的第三态；合法千分位不受影响。
  5381	    **它不证明什么**：不覆盖非数字上下文里的逗号（两侧仍要求数字）；
  5382	    也不改变 D2「碰撞判据非字段绑定」这个设计层性质（见接手清单 A1/A2）。
  5383	    """
  5384	    rs = _load_recap_scan()
  5385	    vault = standard_vault(tmp_path)
  5386	    scan = collect_json(vault)
  5387	    pool = rs._derived_number_pool(scan)
  5388	    assert 987654 not in pool, "前提：987654 必须在池外"
  5389	    assert 0 in pool, "前提：0 因 abs(a-a) 恒在池内 —— 这正是尾片重锚危险的原因"
  5390	
  5391	    report = write_report(vault, scan)
  5392	    base = report.read_text(encoding="utf-8")
  5393	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  5394	
  5395	    def inject(line: str):
  5396	        text = base.replace("## 三维审查", f"## 三维审查\n\n{line}", 1)
  5397	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  5398	        report.write_text(text, encoding="utf-8")
  5399	        return run_verify(report)
  5400	
  5401	    for line, why in (
  5402	        ("- 本板共有987654,0个子节点。【实测】", "半角逗号 + 非三位尾段"),
  5403	        ("- 本板共有987654，0个子节点。【实测】", "全角逗号"),
  5404	        ("- 本板共有987654'0个子节点。【实测】", "Swiss 撇号（本函数自己声明的分隔符）"),
  5405	        ("- 本板共有1,05个子节点。【实测】", "读者读 105，校验器曾只读 5"),
  5406	        ("- 本板共有987654,000个子节点。【实测】", "对照：恰好三位分组（修前即拦）"),
  5407	    ):
  5408	        r = inject(line)
  5409	        assert r.returncode != 0, f"{why}：分隔符第三态放行 —— {line!r}"
  5410	
  5411	    # 归一行为本身：一律删，不看位数
  5412	    assert rs._normalize_number_seps("987654,0") == "9876540"
  5413	    assert rs._normalize_number_seps("1,05") == "105"
  5414	    assert rs._normalize_number_seps("987654,000") == "987654000"
  5415	    # 非数字上下文不受影响
  5416	    assert rs._normalize_number_seps("见 1,と") == "见 1,と"

