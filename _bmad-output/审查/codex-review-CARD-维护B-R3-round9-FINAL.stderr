   635	def _has_provenance(row: dict) -> bool:
   636	    """来源锚点在位判定: source_note 或 relation.target 任一非空。
   637	
   638	    fallback 模式 relation_target 恒 None (C5 既有语义, 派生子女无据不破) →
   639	    F1 后 fallback 也从 derived-from 抄录 relation_target (同 manifest 侧
   640	    _node_relation 退路分支), 两模式来源口径对齐; 差异仅剩 relationships[]
   641	    列表 (fallback 无 yaml 库不解析) — 由 availability 档位如实反映。
   642	    """
   643	    return bool(row.get("source_note") or row.get("relation_target"))
