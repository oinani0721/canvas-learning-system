   795	def _crash_text(stdout: str, stderr: str | None) -> str:
   796	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   797	
   798	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   799	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   800	    """
  3335	# ── R3 round-2：车道对抗审查（5 镜头 17 agent）确认的 1 BLOCKER + 4 HIGH ──────
  3336	# 全部同一根因：**提取面**在排版噪声/不可见字符处断开，匹配重锚到紧邻量词的尾片，
  3337	# 于是「判据绝对确定」变得无关紧要——判据拿到的 token 不是那句话里的数。
  3338	# ⛔ 归因如实：该性质在开工 HEAD `c754b043` 上**同样存在**（验证者用 git show 重放
  3339	# 实证），**不是 R3 引入的回归**；但 R3 的门与 docstring 宣称「多字中文数词一律
  3340	# fail-closed」，被一个 `**` 击穿 = 声明比证据宽，按本仓口径算真缺陷，必须闭合。
  3341	
  3342	
  3343	def test_domain_r5_noise_split_number_run_cli(tmp_path):
  3344	    """R3 round-2 行为门：排版噪声/不可见字符**不得**成为数串的断点。
  3345	
  3346	    `- 本板共有九十八万**五**个子节点。【实测】` 在 Obsidian 里渲染成
  3347	    「本板共有九十八万五个子节点」（粗体的五），而验证器原先只抓到尾片 `五`，
  3348	    `_cjk_single_to_int('五')==5` 且 5 在池内 ⇒ 纯虚构的 980005 **exit 0 放行**。
  3349	    ASCII 侧同形：`980 005个`（空格千分位）只查到 `005`。
  3350	
  3351	    **它证明什么**：数串跨连接字符（排版标记 / `&nbsp;` / 空白 / 短 HTML 标签与
  3352	    注释 / 零宽与双向控制）整体抓取并剥噪声后再判 —— D2 侧覆盖 CJK 与 ASCII，
  3353	    fallback 侧本门只覆盖 CJK；合法的单字/池内数值不受影响。
  3354	    ⚠️ 措辞收窄（Codex round-2 属实指出）：本门原写「CJK 与 ASCII × D2 与
  3355	    fallback 全覆盖」，但矩阵里 fallback 只喂了 CJK——而当时 fallback 的 ASCII
  3356	    侧**确实还是** ``re.findall(r"\\d+")`` 的碎片取数。该缺口由
  3357	    `test_domain_r6_cross_class_and_offtable_numeral_cli` 闭合并配门。
  3358	    **它不证明什么**：连接集是**封闭表**（与量词表同口径）。表外字符仍能切断数串
  3359	    （`九十八万x五个` / `九十八万、五个` / `[[x|]]` 的残留 `|]]`）——那些断点
  3360	    **渲染后可见**，读者不会读成一个连续的数；表外的**不可见**载体（如超长 HTML
  3361	    注释）是真残余，登记在验收单 §五之三，本门不宣称覆盖。
  3362	    """
  3363	    vault = standard_vault(tmp_path)
  3364	    scan = collect_json(vault)
  3365	    pool = _load_recap_scan()._derived_number_pool(scan)
  3366	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3367	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3368	    report = write_report(vault, scan)
  3369	    base_text = report.read_text(encoding="utf-8")
  3370	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3371	
  3372	    def verify(anchor: str, injected: str):
  3373	        text = base_text.replace(anchor, injected, 1)
  3374	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3375	        report.write_text(text, encoding="utf-8")
  3376	        return run_verify(report)
  3377	
  3378	    def d2(line: str):
  3379	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3380	
  3381	    # ── 拦截面：渲染后连续、源码被切断 ──
  3382	    for name, line in (
  3383	        ("粗体", "- 本板共有九十八万**五**个子节点。【实测】"),
  3384	        ("空白", "- 本板共有九十八万 五个子节点。【实测】"),
  3385	        ("nbsp", "- 本板共有九十八万&nbsp;五个子节点。【实测】"),
  3386	        ("空标签", "- 本板共有九十八万<span></span>五个子节点。【实测】"),
  3387	        ("修饰字余", "- 本板共有九十八万余五个子节点。【实测】"),
  3388	        ("行内代码", "- 本板共有九十八万`x`五个子节点。【实测】"),
  3389	    ):
  3390	        r = d2(name and line)
  3391	        assert r.returncode != 0, f"CJK {name}切断被放行:\n{r.stdout}"
  3392	        assert _one_problem_has(r.stdout, "无法解析", "九十八万五"), (
  3393	            f"CJK {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3394	        )
  3395	    for name, line, whole in (
  3396	        ("空格千分位", "- 本板共有980 005个子节点。【实测】", "980005"),
  3397	        ("粗体", "- 本板共有98765**4**个子节点。【实测】", "987654"),
  3398	        # ⛔ 与「前导零归一化」的交互：行级剥零会把 `1 000`(渲染=1000, SI 千分位)
  3399	        # 先剥成 `1 0` 再拼成 `10` 落进池内 ⇒ 放行。归一化必须作用在拼接后的
  3400	        # token 上（车道实测，本卡修复时自己踩出来的洞）。
  3401	        ("SI千分位+前导零", "- 本板共有1 000个子节点。【实测】", "1000"),
  3402	    ):
  3403	        r = d2(line)
  3404	        assert r.returncode != 0, f"ASCII {name}切断被放行:\n{r.stdout}"
  3405	        assert _one_problem_has(r.stdout, "找不到同值来源", whole), (
  3406	            f"ASCII {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3407	        )
  3408	    # fallback 允许式侧同根（碎片逐片查池全部命中 ⇒ 整体虚构值放行）
  3409	    for tok, joined in (("九**五**", "九五"), ("九十八万**五**", "九十八万五")):
  3410	        r = verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3411	        assert r.returncode != 0, f"fallback {tok} 碎片被放行:\n{r.stdout}"
  3412	        assert _one_problem_has(r.stdout, "无法验证", joined), (
  3798	      · `_visible_text()` 把 HTML 实体（含 `&#xff19;` 这类全角实体，**先解实体
  3799	        再转全角**，顺序反了就永远转不成 ASCII）、HTML 标签、无别名 wikilink 的
  3800	        显示文本、零宽字符、强调标记统一归一到"读者看到的文本"；
  3801	      · 句式门 `总计/合计/共有` 其后接**任一数词样字符**（原只认 ASCII 数字，
  3802	        `总计五个` / `总计：987654个` 整句不进检查面）；
  3803	      · 区间分隔符含全角波浪等变体；负数计数恒 FAIL；量词表补常用字。
  3804	    **它不证明什么**：三张表（数词/量词/分隔符）**仍是封闭表**；
  3805	    `_visible_text` **不是完整 markdown 渲染器**，是针对本域已知构造的收敛器；
  3806	    inline code 内容是**有意豁免**的字段值（E2 设计选择），本门不覆盖。
  3807	    """
  3808	    rs = _load_recap_scan()
  3809	    # 归一器单元契约：顺序错了 `&#xff19;` 就会停在全角 `９`（round-5 HIGH-3）
  3810	    assert rs._visible_text("&#xff19;&#xff18;") == "98", "解实体必须早于全角转换"
  3811	    assert rs._visible_text("987654<b>-</b>0") == "987654-0"
