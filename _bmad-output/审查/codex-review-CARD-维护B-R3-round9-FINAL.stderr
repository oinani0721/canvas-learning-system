  5215	def test_domain_r27_seedish_h3_and_corrupt_seeds():
  5216	    """R3 round-32（冻结审查 v13 的第六形态）：不被口径认可的种子 H3 必须自己报。
  5217	
  5218	    ⛔ 只收集**认可的**小节，等于把「不合口径的种子 H3」整块**排除在审计面之外**：
  5219	      · `seeds=[]` + `### 种子 ###` + `- Ghost — 批注 9 条` ⇒ 零 section 且零种子，
  5220	        函数直接返回，Ghost 行**永不受审**；
  5221	      · 更强：先放一个**认可的空** `### 种子`，再放第二个**不认可**的 H3 + Ghost 行
  5222	        ⇒ 第二块永不审，**非零种子板同样可绕**。
  5223	
  5224	    同批：损坏的 `seeds=[None]` 会被过滤成空 rows，再因**原值仍是 list** 被当成
  5225	    合法零种子 ⇒ 损坏数据静默通过。现改为 fail-closed。
  5226	
  5227	    **它证明什么**：六种形态各自正确（三报三放行），含围栏内形似标题不误报。
  5228	    **它不证明什么**：不覆盖 `ledger` 为扁平 list 的损坏形态；
  5229	    也不改变 `_SECTION_RE` 的接受集本身（放宽须改本体让两侧同动）。
  5230	    """
  5231	    rs = _load_recap_scan()
  5232	
  5233	    # ⛔ round-33：原先只断言「有报错」，于是 survivor-64 变异后靠**另一条**
  5234	    #    诊断（「不在 ledger」）就能让门保持绿 —— 实测未承重。
