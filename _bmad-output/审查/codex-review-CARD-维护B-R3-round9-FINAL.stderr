  3239	def test_domain_r5_derive_allow_single_char_value_enters_pool():
  3240	    """R3 单元门: 单字数词必须**带着自己的值**进池比对；多字不得按局部值查池。
  3241	
  3242	    ⚠️ 为什么用合成 scan 而不是标准 fixture: 标准 fixture 的数值池是 `[0..16, 22]`，
  3243	    **覆盖了 `_CJK_NUM` 的全部值（0-9）** ⇒ CLI 层根本构造不出「单字且值不在池」
  3244	    的用例，只写 `五` 放行会退化成**空洞证明**（没查池也 rc=0）。合成 scan 把池
  3245	    收窄到 `[0,1,2]`，`九` 才能证明 9 确实进了池比对。合成语料非 live 正文。
  3246	
  3247	    **它证明什么**: 单字 → 按自身值查池（九→`行内数字 9 无出处` / 二→放行）；
  3248	    多字 → 走「无法验证」且**不产生任何按局部值的池诊断**（`一零` 的 0、
  3249	    `五四` 的 4、`九十八万` 的 980000 都不得出现在诊断里）。
  3250	    **它不证明什么**: 不证明整条 verifier 的段切分与白名单匹配——那是 CLI 门的事。
  3251	    """
  3252	    rs = _load_recap_scan()
  3253	    synth = {"data_mode": "fallback_local", "counts": {"members": 1, "seeds": 1}}
  3254	    pool = rs._derived_number_pool(synth)
  3255	    assert pool == {0, 1, 2}, f"合成池漂移，判别前提失效: {sorted(pool)}"
  3256	
  3257	    def probs_for(tok: str) -> list[str]:
  3258	        out: list[str] = []
  3259	        rs._verify_fallback_derive_numbers(f"#### 派生子女 {tok} 个 的说明\n", synth, out)
  3260	        return out
  3261	
  3262	    assert any("行内数字 9 无出处" in p for p in probs_for("九")), "单字未按自身值查池"
  3263	    assert probs_for("二") == [], "值在池的单字被误伤"
  3264	    for tok, leaked in (("一零", "0"), ("五四", "4"), ("九十八万", "980000")):
  3265	        got = probs_for(tok)
  3266	        assert any("无法验证" in p for p in got), f"{tok}: 多字未 fail-closed: {got}"
  3267	        assert not any("无出处" in p for p in got), f"{tok}: 仍按局部值查池: {got}"
  3268	        assert not any(leaked in p for p in got), f"{tok}: 诊断里泄出解析值 {leaked}: {got}"
  3269	
