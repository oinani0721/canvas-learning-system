   496	def _ledger_from_local(vault: Path, members: list[str]) -> list[dict]:
   497	    node_dir = vault / "节点"
   498	    rows = []
   499	    for name in members:
   500	        node_path = _contained_md(node_dir, name)
   501	        if node_path is None:
   502	            rows.append(
   503	                {
   504	                    "node_id": name,
   505	                    "role": "unknown",
   506	                    "role_source": "invalid_name",
   507	                    "exists": False,
   508	                    "tips": [],
   509	                    "tips_count": 0,
   510	                    "tips_open": 0,
   511	                }
   512	            )
   513	            continue
   514	        if not node_path.is_file():
   515	            rows.append(
   516	                {
   517	                    "node_id": name,
   518	                    "role": "unknown",
   519	                    "role_source": "local_missing",
   520	                    "exists": False,
   521	                    "tips": [],
   522	                    "tips_count": 0,
   523	                    "tips_open": 0,
   524	                }
   525	            )
   526	            continue
   527	        try:
   528	            fm, body = _frontmatter_and_body(_read(node_path))
   529	        except (OSError, UnicodeDecodeError):
   530	            rows.append(
   531	                {
   532	                    "node_id": name,
   533	                    "role": "unknown",
   534	                    "role_source": "local_unreadable",
   535	                    "exists": False,
   536	                    "tips": [],
   537	                    "tips_count": 0,
   538	                    "tips_open": 0,
   539	                }
   540	            )
   541	            continue
   542	        mastery = None
   543	        for key in ("mastery_score", "mastery", "mastery_level"):
   544	            v = _fm_scalar(fm, key)
   545	            if v is not None:
   546	                mastery = _finite(v)
   547	                break
   548	        tips = _row_tips(_parse_tips_from_frontmatter(fm))
   549	        # F1 (Codex G5-4 round-1): derived-from 是来源锚点 — fallback 不解析它
   550	        # 会让同一 vault 的来源覆盖/无来源信号与 manifest 模式分叉 (manifest 侧
   551	        # _node_relation 的退路分支就是 derived-from)。对齐: 有可解析的
   552	        # derived-from → relation_target/relation_type 同型落 ledger;
   553	        # 派生子女计数仍恒无据 (C5 铁律不破, 由 derived_children=None 承载)。
   554	        derived_target = _strip_note_ref(
   555	            _fm_scalar(fm, "derived-from") or _fm_scalar(fm, "derived_from")
   556	        )
   557	        # H1/W1/W3 (Codex round-2/3 + workflow): role 判定对齐后端
   558	        # board_manifest_service._node_role 的 **truthiness** 语义 —
   559	        #   · 裸子串 "derived-from" in fm 会被 tips 正文里提到该词的节点触发
   560	        #     (假 derived → 假"无来源结论"点名);
   561	        #   · 只认连字符会让 derived_from: 写法的节点 role=seed 却带
   562	        #     relation_target, 自相矛盾;
   563	        #   · **键存在**也不对: 后端对 `derived-from: null` / 空值取 falsy 判
   564	        #     seed, 键存在检测会判 derived → round-3 H1 实测分叉。
   565	        # 故: 有可解析的 derived 目标 (derived_target 非空) 或 relationships
   566	        # 块 或 created_from==ai_linked_doc → derived, 与后端三支同构。
   567	        # round-4: relationships 也要 truthiness — 后端 fm.get("relationships")
   568	        # 对 `relationships:` (空值/null) 取 None → falsy → 不算派生。故要求
   569	        # 键后**确有列表内容**: 同行流式 `[...]` 非空, 或次行起有缩进 `- ` 项。
   570	        mrel = re.search(r"^relationships[^\S\n]*:[^\S\n]*(.*)$", fm, re.M)
   571	        has_relationships = False
   572	        if mrel:
   573	            inline = re.split(r"(?:^|\s)#", mrel.group(1), maxsplit=1)[0].strip()
   574	            # round-4 H1: 与后端 truthiness 对齐的 falsy 全集
   575	            if inline and inline.lower() not in (
   576	                "null",
   577	                "~",
   578	                "false",
   579	                "0",
   580	                "[]",
   581	                "{}",
   582	                "[ ]",
   583	                "{ }",
   584	                "''",
   585	                '""',
   586	            ):
   587	                has_relationships = True
   588	            elif not inline:
   589	                # 空值 → 看次行是否真有列表项 (缩进 `- `) 或缩进 mapping 键
   590	                tail = fm[mrel.end() :]
   591	                has_relationships = bool(
   592	                    re.match(r"\s*\n[^\S\n]+(?:-[^\S\n]|\S+[^\S\n]*:)", tail)
   593	                )
   594	        is_derived = bool(
   595	            derived_target
   596	            or has_relationships
   597	            or _fm_scalar(fm, "created_from") == "ai_linked_doc"
   598	        )
   599	        rows.append(
   600	            {
   601	                "node_id": name,
   602	                # 种子 = 无派生痕迹 (设计稿 §四); 本地推定, 报告标【推定】
   603	                # 口径对齐 board_manifest_service._node_role 的 truthiness 三支
   604	                "role": "derived" if is_derived else "seed",
   605	                "role_source": "local_inferred",
   606	                "is_stub": STUB_PLACEHOLDER in body,
   607	                "mastery_score": mastery,
   608	                "mastery_source": "local_frontmatter"
   609	                if mastery is not None
   610	                else "absent",
   611	                "attempt_count": _fm_scalar(fm, "attempt_count"),
   612	                "last_examined": _fm_scalar(fm, "last_examined"),
   613	                "created_at": None,
   614	                "created_from": _fm_scalar(fm, "created_from"),
   615	                # G5-4 加性: frontmatter 抄录, 剥 wikilink 归一 stem (可比性)
   616	                "source_note": _strip_note_ref(_fm_scalar(fm, "source_note")),
   617	                "pick_rank": None,
   618	                "relation_type": "derived_from" if derived_target else None,
   619	                "relation_target": derived_target,
   620	                "derived_at": None,
   621	                "derived_reason": None,
   622	                "tips": tips,
   623	                "tips_count": len(tips),
   624	                "tips_open": sum(
   625	                    1 for t in tips if t.get("understanding") != "understood"
   626	                ),
   627	                "error_candidates_pending": 0,
   628	                "body_callout_count": len(_CALLOUT_RE.findall(body))
   629	                + len(_USER_INLINE_RE.findall(body)),
   630	            }
   631	        )
   632	    return rows
