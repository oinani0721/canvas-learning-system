    93	def run_collect(vault: Path, board: str = BOARD, *extra: str) -> subprocess.CompletedProcess:
    94	    if not SCRIPT.exists():  # 防「脚本不存在 → 非零退出 → 拒绝类断言假绿」
    95	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
