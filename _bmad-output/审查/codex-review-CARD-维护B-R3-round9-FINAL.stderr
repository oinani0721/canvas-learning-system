   645	
   646	def _build_signals(
   647	    ledger: list[dict],
   648	    all_tips: list[dict],
   649	    dated: list[dict],
   650	    data_mode: str,
   651	    scan_at: str,
   652	    now: datetime,
   653	) -> dict:
   654	    """一梯队偏航信号 (CARD-G5-4) — 全部确定性可复算, 0 阈值。
   655	
   656	    结构契约 (测试锁定): 四信号各含 value / denominator / percentile_ref
   657	    (板内分位参考) / availability / asof 五键; 判定字段一律不存在 —
   658	    判偏航留人。denominator == 0 → value=null + availability="无据"。
   659	    """
   660	    measured = AVAIL_MEASURED if data_mode == "manifest" else AVAIL_FILE
   661	    members = len(ledger)
   662	    derived_rows = [r for r in ledger if r.get("role") == "derived"]
   663	
   664	    # 信号1 · 未答问题年龄 — dated tips 的年龄天数分布 (整数天, floor);
   665	    # added_at 在未来 (时钟漂移/投毒) → 按 0 天计, 不产出负年龄。
   666	    ages = sorted(
   667	        max(0, int((now - _parse_dt(t["added_at"])).total_seconds() // 86400))
   668	        for t in dated
   669	    )
   670	    sig_age = {
   671	        "value": ages[-1] if ages else None,
   672	        "denominator": len(ages),
   673	        "percentile_ref": (
   674	            {
   675	                "p25_days": _pctl(ages, 0.25),
   676	                "p50_days": _pctl(ages, 0.50),
   677	                "p75_days": _pctl(ages, 0.75),
   678	                "max_days": ages[-1],
   679	            }
   680	            if ages
   681	            else None
   682	        ),
   683	        # 时序封顶【文件】: added_at=最后变更时间 (C5 已知边界), manifest 也不升档
   684	        "availability": AVAIL_FILE if ages else AVAIL_NODATA,
   685	        "asof": scan_at,
   686	        "undated": len(all_tips) - len(dated),
   687	        "note": (
   688	            "value=最老年龄(天); added_at=最后变更时间(C5 边界), 时序封顶文件档; "
   689	            "未答=全部 tips 上界(无已答标记); 无时间戳条目不参与"
   690	        ),
   691	    }
   692	
   693	    # 信号2 · 来源覆盖率 — 成员含来源锚点占比; 二值分布无分位,
   694	    # 板内参考改用 by_role 拆分 (percentile_ref 如实置 null)
   695	    prov_count = sum(1 for r in ledger if _has_provenance(r))
   696	    by_role: dict[str, dict[str, int]] = {}
   697	    for r in ledger:
   698	        role = r.get("role") if r.get("role") in ("seed", "derived") else "unknown"
   699	        bucket = by_role.setdefault(role, {"with_provenance": 0, "total": 0})
   700	        bucket["total"] += 1
   701	        if _has_provenance(r):
   702	            bucket["with_provenance"] += 1
   703	    sig_cov = {
   704	        "value": prov_count if members else None,
   705	        "denominator": members,
   706	        "percentile_ref": None,
   707	        "by_role": by_role,
   708	        "availability": measured if members else AVAIL_NODATA,
   709	        "asof": scan_at,
   710	        "note": "来源锚点=source_note 或 relation.target; 二值信号无分位, 板内参考=by_role",
