  3398	        # ⛔ 与「前导零归一化」的交互：行级剥零会把 `1 000`(渲染=1000, SI 千分位)
  3399	        # 先剥成 `1 0` 再拼成 `10` 落进池内 ⇒ 放行。归一化必须作用在拼接后的
  3400	        # token 上（车道实测，本卡修复时自己踩出来的洞）。
  3401	        ("SI千分位+前导零", "- 本板共有1 000个子节点。【实测】", "1000"),
  3402	    ):
  3403	        r = d2(line)
  3404	        assert r.returncode != 0, f"ASCII {name}切断被放行:\n{r.stdout}"
  3405	        assert _one_problem_has(r.stdout, "找不到同值来源", whole), (
  3406	            f"ASCII {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3407	        )
