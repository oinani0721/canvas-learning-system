  5156	def test_domain_r26_zero_seed_board_not_false_positive():
  5157	    """R3 round-31（冻结审查 v12）：round-30 的 H3 fail-closed **误伤了合法零种子板**。
  5158	
  5159	    ⛔ 生成侧允许 `ledger.seeds == []` / `counts.seeds == 0` —— 那种板本来就没有
  5160	    种子小节。round-30 我加的「台账段在场却找不到种子小节即报」对它是**误伤**；
  5161	    另一条「无可用 ledger」也把 `seeds == []` 与「根本没有 ledger」混为一谈。
  5162	
  5163	    ⚠️ 修的过程中我自己又开了一个洞：第一版对 `seeds == []` **提前 return**，
  5164	    于是零种子板里写的任何台账行都被**静默放行**（实测漏）。⇒ 不提前返回，
  5165	    让绑定面为空自然走「不在 ledger 里」。
  5166	
  5167	    **它证明什么**：五种形态各自正确（两放行三拦截），且「合法零种子」与
  5168	    「绑定面为空就放行」被区分开。
  5169	    **它不证明什么**：不覆盖 `ledger` 为扁平 list 的零种子形态（无角色信息，
  5170	    本函数维持原样，如实登记）。
  5171	    """
  5172	    rs = _load_recap_scan()
  5173	
  5174	    for want_problem, why, text, ledger in (
  5175	        (
  5176	            False,
  5177	            "合法零种子：seeds=[] 且报告无种子小节",
  5178	            "## 台账\n\n### 派生\n\n- X — 批注 1 条\n\n## 末\n",
  5179	            {"seeds": [], "derived": [{"node_id": "X", "tips_count": 1}]},
  5180	        ),
  5181	        (
  5182	            False,
  5183	            "合法零种子：种子小节为真正的空",
  5184	            "## 台账\n\n### 种子\n\n\n\n## 末\n",
  5185	            {"seeds": []},
  5186	        ),
  5187	        (
  5188	            True,
  5189	            "确有种子却找不到小节 ⇒ fail-closed",
  5190	            "## 台账\n\n### 派生\n\n- X — 批注 1 条\n\n## 末\n",
  5191	            {"seeds": [{"node_id": "S", "tips_count": 2}]},
  5192	        ),
  5193	        (
  5194	            True,
  5195	            "零种子板却写了台账行 ⇒ 报『不在 ledger』（不得因空绑定面而静默放行）",
  5196	            "## 台账\n\n### 种子\n\n- Ghost — 批注 9 条\n\n## 末\n",
  5197	            {"seeds": []},
  5198	        ),
  5199	        (
  5200	            True,
  5201	            "无 ledger **且有认可的 H3** ⇒ fail-closed"
  5202	            "（⚠️ round-32 收窄措辞：无 ledger 且**无**认可 H3 的情形本门不覆盖）",
  5203	            "## 台账\n\n### 种子\n\n- S — 批注 2 条\n\n## 末\n",
  5204	            None,
  5205	        ),
  5206	    ):
  5207	        ps: list[str] = []
  5208	        rs._verify_seed_ledger_counts(text, {"ledger": ledger} if ledger is not None else {}, ps)
  5209	        if want_problem:
  5210	            assert ps, f"{why}：应报错却放行"
  5211	        else:
  5212	            assert ps == [], f"{why}：合法输入被误伤 —— {ps!r}"
