  1933	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  1934	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  1935	
  1936	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  1937	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  1938	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  1939	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  1940	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  1941	    """
  1942	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  1943	    if not mb:
  1944	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  1945	        return
  1946	    board_id = mb.group(1).strip()
  1947	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  1948	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  1949	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  1950	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
