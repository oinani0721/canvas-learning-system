  3449	def test_domain_r6_cross_class_and_offtable_numeral_cli(tmp_path):
  3450	    """R3 round-3 行为门：跨类 / 表外数词字 / CJK 小数都不得按尾片查池。
  3451	
  3452	    四条实测反例（修前全部 exit 0）：
  3453	      · `本板共有九十八万5个子节点` —— CJK run 停在 `万`，ASCII 只取 `5`
  3454	      · `本板共有廿五个子节点` —— `廿` 表外，从 `五` 重锚按 5 查池（读者读 25）
  3455	      · `本板共有壹佰个子节点` —— 两字全表外，一个 token 都抽不出
  3456	      · `本板共有五点五个 / 5点5个` —— `点` 在量词表里，被拆成两个 5 分别碰池
  3457	      · fallback `#### 派生子女 1 000 个` —— `\\d+` 拆成碎片逐片碰池
  3458	
  3459	    **它证明什么**：D2 与 fallback、CJK 与 ASCII 走**同一条**取数规则；
  3460	    诊断类别与还原后的完整 token 出现在**同一条** problem 里；
  3461	    合法形态（含 `3点建议` 里 `点` 的正当量词用法）不被反噬。
  3462	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 仍是**封闭表**（廿卅卌 + 大写金融
  3463	    数字 + 异体），表外的其它数词写法仍可能重锚；量词表同样封闭。见 §五之三。
  3464	    """
  3465	    vault = standard_vault(tmp_path)
  3466	    scan = collect_json(vault)
  3467	    pool = _load_recap_scan()._derived_number_pool(scan)
  3468	    assert {5, 3, 16, 22} <= pool, f"放行面前提失效: {sorted(pool)}"
  3469	    report = write_report(vault, scan)
  3470	    base_text = report.read_text(encoding="utf-8")
  3471	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3472	
  3473	    def verify(anchor: str, injected: str):
  3474	        text = base_text.replace(anchor, injected, 1)
  3475	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3476	        report.write_text(text, encoding="utf-8")
  3477	        return run_verify(report)
  3478	
  3479	    def d2(line: str):
  3480	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3481	
  3482	    def fb(tok: str):
  3483	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3484	
  3485	    # 拦截面：诊断必须同时点名「无法解析」与**还原后的完整 token**
  3486	    for name, line, token in (
  3487	        ("跨类混写", "- 本板共有九十八万5个子节点。【实测】", "九十八万5"),
  3488	        ("表外廿", "- 本板共有廿五个子节点。【实测】", "廿五"),
  3489	        ("表外大写金融数字", "- 本板共有壹佰个子节点。【实测】", "壹佰"),
  3490	        ("多字+切断", "- 本板共有九十八万**五**个子节点。【实测】", "九十八万五"),
  3491	    ):
  3492	        r = d2(line)
  3493	        assert r.returncode != 0, f"D2 {name} 被放行:\n{r.stdout}"
  3494	        assert _one_problem_has(r.stdout, "无法解析", token), (
  3495	            f"D2 {name}: 诊断类别与完整 token 未绑在同一条 problem:\n{r.stdout}"
  3496	        )
  3497	    # CJK/混写小数：与 ASCII 小数同口径恒 FAIL
  3498	    for name, line, token in (
  3499	        ("CJK 小数", "- 本板共有五点五个子节点。【实测】", "五点五"),
  3500	        ("混写小数", "- 本板共有5点5个子节点。【实测】", "5点5"),
  3501	    ):
  3502	        r = d2(line)
  3503	        assert r.returncode != 0, f"D2 {name} 被放行:\n{r.stdout}"
  3504	        assert _one_problem_has(r.stdout, "小数形态", token), f"D2 {name}: 未按小数形态点名:\n{r.stdout}"
  3505	    # fallback 侧 ASCII 也必须整串取（round-2 只补了 CJK 侧，是本轮 HIGH 之一）
  3506	    for name, tok, token in (
  3507	        ("ASCII SI千分位", "1 000", "1000"),
  3508	        ("ASCII 标记切断", "9**5", "95"),
  3509	    ):
  3510	        r = fb(tok)
  3511	        assert r.returncode != 0, f"fallback {name} 被放行:\n{r.stdout}"
  3512	        assert _one_problem_has(r.stdout, "无出处", token), f"fallback {name}: 未按整串值点名:\n{r.stdout}"
  3513	    r = fb("廿五")
  3514	    assert r.returncode != 0 and _one_problem_has(r.stdout, "无法验证", "廿五"), (
  3515	        f"fallback 表外数词未 fail-closed:\n{r.stdout}"
  3516	    )
  3517	
  3518	    # 放行面（同权重）
  3519	    for name, line in (
  3520	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3521	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
  3522	        ("前导零 016=16", "- 本板共有016个子节点。【实测】"),
  3523	        ("池内 22", "- 本板共有22个子节点。【实测】"),
  3524	        ("`点` 的正当量词用法", "- 本板共有3点建议。【实测】"),
  3525	        ("round-5 原始误伤 十分", "- 说明十分清楚。【实测】"),
  3526	        ("round-5 原始误伤 一致", "- 统计口径尚未一致。【实测】"),
  3527	    ):
  3528	        r = d2(line)
  3529	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
  3530	    for name, tok in (("fallback 单字在池", "五"), ("fallback ASCII 在池", "3")):
  3531	        r = fb(tok)
  3532	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
