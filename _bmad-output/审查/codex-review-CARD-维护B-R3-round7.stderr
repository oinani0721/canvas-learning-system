  1613	def _visible_text(line: str) -> str:
  1614	    """源码行 → **读者在 Obsidian 里看到的文本**（本域收敛器，非完整渲染器）。
  1615	
  1616	    顺序有讲究（每一步都对应前几轮的一条实测 HIGH）：
  1617	      1. **先解 HTML 实体**再做全角转换 —— 反过来会让 `&#xff19;` 解出 `９`
  1618	         之后再没有机会转成 ASCII（round-5 HIGH-3 实测）;
  1619	      2. 剥 HTML 标签 —— `<b>` 长度不限, 原先只有 ≤22 字符的短标签算连接字符;
  1620	      3. wikilink 取**显示文本** —— 有别名取别名, 无别名取目标本身
  1621	         （原实现把无别名链接的目标挖空, 而那正是读者看到的字, round-5 HIGH-8）;
  1622	      4. 去零宽/双向控制字符;
  1623	      5. 去强调标记 `*_~` —— 未配对时渲染可见, 这里一并去掉是**安全向**的过度
  1624	         归一（查到的值 ⊇ 读者看到的数, 不构成虚构通道）。
  1625	
  1660	
  1661	
  1662	def _count_token_value(token: str) -> int | None:
  1663	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1664	
  1665	    只两种情形给值:
  1666	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1667	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1668	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1669	    """
  1670	    if not token:
  1671	        return None
  1672	    if token.isascii() and token.isdigit():
  1673	        return int(token)
  1674	    return _cjk_single_to_int(token)
