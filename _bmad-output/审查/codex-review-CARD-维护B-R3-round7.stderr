  3241	def test_domain_r5_derive_allow_cjk_pool_collision_cli(tmp_path):
  3242	    """R3 行为门①: fallback 允许式行内多字数词一律 fail-closed，单字不误伤。
  3243	
  3244	    **它证明什么**: 走完整 CLI（`--verify`）时，`一零`/`五四`（局部值**实测在池**，
  3245	    即碰撞前提成立）与 `九十八万`/`十` 全部 exit 1 且诊断为「无法验证」，
  3246	    诊断里不出现任何池比对结论；值在池的单字 `五` 放行。
  3247	    **它不证明什么**: 不证明「单字带自身值查池」——本 fixture 池覆盖 0-9，
  3248	    该性质由 test_domain_r5_derive_allow_single_char_value_enters_pool 证明。
  3249	    """
  3250	    rs = _load_recap_scan()
  3251	    vault = standard_vault(tmp_path)
  3252	    scan = collect_json(vault)
  3253	    pool = rs._derived_number_pool(scan)
  3254	    # ⛔ 碰撞前提必须**实测**: 局部值真的在池里，这条门才是在测「按错值查池会放行」；
  3255	    # 前提不成立时它只是在测别的东西（MEMORY `reference_gate_design_pitfalls`）。
  3256	    assert {0, 4, 5} <= pool, f"碰撞前提失效（局部值不在池）: {sorted(pool)}"
  3257	    report = write_report(vault, scan)
  3258	    base_text = report.read_text(encoding="utf-8")
  3259	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3260	
  3261	    def verify_with(tok: str):
  3262	        text = base_text.replace("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：", 1)
  3263	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3264	        report.write_text(text, encoding="utf-8")
  3265	        return run_verify(report)
  3266	
  3267	    for tok in ("一零", "五四", "九十八万", "十"):
  3268	        r = verify_with(tok)
  3269	        assert r.returncode != 0, f"{tok}: 中文数词绕过被放行:\n{r.stdout}"
  3270	        assert "无法验证" in r.stdout, f"{tok}: 应走「无法验证」fail-closed:\n{r.stdout}"
  3271	        assert "无出处" not in r.stdout, f"{tok}: 仍按局部/末位值查池:\n{r.stdout}"
  3272	    r = verify_with("五")
  3273	    assert r.returncode == 0, f"值在池的单字数词被误伤:\n{r.stdout}"
  3274	
