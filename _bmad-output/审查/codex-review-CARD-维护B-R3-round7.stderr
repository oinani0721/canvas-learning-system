  1374	def _join_free(s: str) -> str:
  1375	    """剥掉数串内部的排版噪声/不可见字符, 还原成**不被排版切断**的数串。
  1376	
  1377	    ⚠️ 措辞收窄 (Codex round-2 属实指出): 原写"还原读者**看到**的那个数"过宽 ——
  1378	    连接集里未配对的 `*`/`_`/`~`、`<br>` 这类短标签、修饰字 `[多余来几约近超]`
  1379	    渲染后是**可见**的, 拼起来并不等于读者看到的数 (`1*0个` 会被当成 10)。
  1380	    但那是**安全向**的过度拼接: 查到的值 ⊇ 读者看到的数, 不构成虚构通道 ——
  1381	    危险的是**欠拼接** (数串被切开、只按尾片查池)。故行为保留、措辞收窄。
  1382	    """
  1383	    return _D2_JOIN_RE.sub("", s)
