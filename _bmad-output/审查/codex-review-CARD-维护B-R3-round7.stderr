   440	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   441	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   442	
   443	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   444	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   445	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   446	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   447	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   448	    要求"确实收集到用例"且"确实有失败"才算变红。
   449	    """
   450	    r = subprocess.run(
   451	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   452	        cwd=ROOT / "backend",
   453	        capture_output=True,
   454	        text=True,
   455	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   456	        timeout=600,
   457	    )
   458	    out = r.stdout
   459	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   460	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   460	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   461	    return r.returncode, out[-400:], passed + failed, failed
   462	
   463	
   464	def main() -> int:
   465	    try:
   466	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   467	    except FileExistsError:
   468	        print(
   469	            f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。"
   470	        )
   471	        return 2
   472	    try:
   473	        original = TARGET.read_bytes()
   474	        backup_sha = hashlib.sha256(original).hexdigest()
   475	
   476	        rc0, out0, n0, f0 = run_suite("domain_")
   477	        if rc0 != 0 or f0 or n0 == 0:
   478	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   479	            return 2
   480	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   481	
   482	        failures = 0
   483	        for name, subs, keyword in MUTANTS:
   484	            text = original.decode("utf-8")
   485	            for old, new in subs:
   486	                if old not in text:
   487	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   488	                    failures += 1
   489	                    text = None
   490	                    break
   491	                text = text.replace(old, new, 1)
   492	            if text is None:
   493	                continue
   494	            TARGET.write_text(text, encoding="utf-8")
   495	            try:
   496	                rc, out, n, f = run_suite(keyword)
   497	            finally:
   498	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   499	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   500	            assert got == backup_sha, (
   501	                f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   502	            )
   503	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   504	            if n == 0:
   505	                print(
   506	                    f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红"
   507	                )
   508	                failures += 1
   509	            elif f == 0:
   510	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   511	                failures += 1
   512	            else:
   513	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   514	
   515	        print(
   516	            f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）"
   517	        )
   518	        return 1 if failures else 0
   519	    finally:
   520	        LOCK.rmdir()
   521	
   522	
   523	if __name__ == "__main__":
   524	    sys.exit(main())

