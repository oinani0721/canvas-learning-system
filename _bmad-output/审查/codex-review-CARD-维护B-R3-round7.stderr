  3538	    assert r.returncode != 0 and _one_problem_has(r.stdout, "找不到同值来源", "980005"), (
  3539	        # ⛔ 必须同时绑「找不到同值来源」——只断言出现 980005 的话，
  3540	        # 实现改成「无法解析 980005」这条门照样绿，就证不出"按 980005 **查池**"
  3541	        # 这件事（Codex round-3 属实指出）。
  3542	        f"千分位逗号形态应按完整量级 980005 **查池**:\n{r.stdout}"
