  3752	def test_domain_r9_visible_text_and_round5_closures_cli(tmp_path):
  3753	    """R3 round-6：渲染归一 + 六处非渲染缺口，逐条锁住。
  3754	
  3755	    **它证明什么**：
  3756	      · `_visible_text()` 把 HTML 实体（含 `&#xff19;` 这类全角实体，**先解实体
  3757	        再转全角**，顺序反了就永远转不成 ASCII）、HTML 标签、无别名 wikilink 的
  3758	        显示文本、零宽字符、强调标记统一归一到"读者看到的文本"；
  3759	      · 句式门 `总计/合计/共有` 其后接**任一数词样字符**（原只认 ASCII 数字，
  3760	        `总计五个` / `总计：987654个` 整句不进检查面）；
  3761	      · 区间分隔符含全角波浪等变体；负数计数恒 FAIL；量词表补常用字。
  3762	    **它不证明什么**：三张表（数词/量词/分隔符）**仍是封闭表**；
  3763	    `_visible_text` **不是完整 markdown 渲染器**，是针对本域已知构造的收敛器；
  3764	    inline code 内容是**有意豁免**的字段值（E2 设计选择），本门不覆盖。
  3765	    """
  3766	    rs = _load_recap_scan()
  3767	    # 归一器单元契约：顺序错了 `&#xff19;` 就会停在全角 `９`（round-5 HIGH-3）
  3768	    assert rs._visible_text("&#xff19;&#xff18;") == "98", "解实体必须早于全角转换"
  3769	    assert rs._visible_text("987654<b>-</b>0") == "987654-0"
  3770	    assert rs._visible_text("[[987654]]") == "987654", "无别名 wikilink 的目标就是显示文本"
  3771	    assert rs._visible_text("[[节点/A|五]]") == "五", "有别名时显示的是别名"
  3772	    assert rs._visible_text("98​7") == "987", "零宽字符不得切断数串"
  3773	    # ⛔ round-6 自查回归（Codex round-6 HIGH-1，车道实测确认并含**误伤**）：
  3774	    # 第一版 `_VIS_EMPHASIS_RE = [*_~]` 无条件剥 `~`，而 `_visible_text` 跑在
  3775	    # `_D2_RANGE_RE` **之前** ⇒ 合法区间 `2~3个` 被拼成 `23`（池外）而 FAIL。
  3776	    # ⚠️ 这条门此前只用**全角 `～`**，恰好漏掉 ASCII `~`。
  3777	    assert rs._visible_text("987654~0") == "987654~0", "单个 ~ 是区间号，不得剥"
  3778	    assert rs._visible_text("98~~7~~6") == "9876", "成对 ~~ 是删除线，须剥"
  3779	
  3780	    vault = standard_vault(tmp_path)
  3781	    scan = collect_json(vault)
  3782	    pool = _load_recap_scan()._derived_number_pool(scan)
  3783	    assert 5 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3784	    report = write_report(vault, scan)
  3785	    base_text = report.read_text(encoding="utf-8")
  3786	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3787	
  3788	    def d2(line: str):
  3789	        text = base_text.replace("## 三维审查", f"## 三维审查\n\n{line}", 1)
  3790	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3791	        report.write_text(text, encoding="utf-8")
  3792	        return run_verify(report)
  3793	
  3794	    for name, line, needles in (
  3795	        (
  3796	            "实体全角数字",
  3797	            "- 本板共有&#xff19;&#xff18;&#xff17;&#xff16;&#xff15;&#xff14;个子节点。【实测】",
  3798	            ("找不到同值来源", "987654"),
  3799	        ),
  3800	        (
