  3276	def test_domain_r5_prose_cjk_multichar_fail_closed_cli(tmp_path):
  3277	    """R3 行为门②: D2 叙述段的多字中文数词计数同样 fail-closed。
  3278	
  3279	    ⛔ 这是 R3 开工实测的**漏拦**（不是假想）: c754b043 只封了 fallback 一侧，
  3280	    `- 本板共有一零个子节点。【实测】` 在开工 HEAD `c754b043` 上 **exit 0 放行**
  3281	    （`_cjk_to_int("一零") == 0`，0 恒在池内）。红证据:
  3282	    `_bmad-output/审查/evidence-maintb-r3/b-prefix-red-repro.txt`。
  3283	
  3284	    **它证明什么**: 该形态现在 exit 1、诊断为「无法解析」，且不再产生按局部值的
  3285	    池比对结论；值在池的单字自陈（`共有五个`）不误伤。
  3286	    **它不证明什么**: 不证明 D2 对**所有**数字形态的绑定力——池碰撞判据的固有
  3287	    边界见 test_domain_block_bare_count_in_prose 的说明，本卡未改变它。
  3288	    """
  3289	
  3290	    def prose_case(tok: str):
  3291	        def m(text, scan):
  3292	            return text.replace("## 三维审查", f"## 三维审查\n\n- 本板共有{tok}个子节点。【实测】", 1)
  3293	
  3294	        return m
  3295	
  3296	    for tok in ("一零", "五四", "九十八万", "十"):
  3297	        r = _mutate_report(tmp_path / f"d2-{tok}", prose_case(tok))
  3298	        assert r.returncode != 0, f"{tok}: D2 段多字数词自陈被放行:\n{r.stdout}"
  3299	        assert "无法解析" in r.stdout, f"{tok}: 应走「无法解析」fail-closed:\n{r.stdout}"
  3300	        assert "找不到同值来源" not in r.stdout, f"{tok}: 仍按局部值查池:\n{r.stdout}"
  3301	    r = _mutate_report(tmp_path / "d2-五", prose_case("五"))
  3302	    assert r.returncode == 0, f"值在池的单字自陈被误伤:\n{r.stdout}"
