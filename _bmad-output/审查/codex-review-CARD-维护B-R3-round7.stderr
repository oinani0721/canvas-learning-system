  3636	def test_domain_r8_entities_ranges_and_table_gaps_cli(tmp_path):
  3637	    """R3 round-5 行为门：HTML 实体 / 区间共用式 / 两张封闭表的补漏。
  3638	
  3639	    七条实测反例（修前全部 exit 0，见 evidence-maintb-r3/m-round4-high-repro.txt）：
  3640	      1. `总计987654-0个…` —— 区间**先挖空、后判句式**，挖空后 `_D2_CLAIM_RE` 的
  3641	         「共有/总计 + 数字」分支失锚 ⇒ continue，已收集的坏端点不再报。
  3642	      2. `本板共有987654<b>-</b>0个…` —— 区间正则是裸 ASCII 窄路径，不复用数串式。
  3643	      3. `987654<b>,</b>000个` / fallback `1<b>,</b>005` —— 千分位只认紧邻逗号。
  3644	      4. `987654&#46;0个` / `987654&#20010;` —— HTML 字符实体未规范化。
  3645	      5. `.5个` / `．五个` —— 小数式要求分隔符两侧都有数串。
  3646	      6. `九兆五个` —— `兆` 不在定界集 ⇒ 从尾片重锚（与 `廿五` 同机制）。
  3647	      7. `987654层关系` —— `层` 不在量词表 ⇒ 整句零校验。
  3648	
  3649	    **它证明什么**：句式判定取自**挖空之前**的行；区间端点走与普通计数**同一个**
  3650	    判值器（中文/混写端点不再免检）且两端都报；HTML 实体先解再核；小数左侧可缺；
  3651	    两张封闭表补入常用字符后对应形态被拦。
  3652	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 与 `_D2_QUANT` **仍是封闭表**——
  3653	    补的是"已知常用"，不是全集。`html.unescape` 也只覆盖标准实体。
  3654	    根本口径见验收单 §五之四：源码级归一化在对抗范式下不可清零。
  3655	    """
  3656	    vault = standard_vault(tmp_path)
  3657	    scan = collect_json(vault)
  3658	    pool = _load_recap_scan()._derived_number_pool(scan)
  3659	    assert 0 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3660	    report = write_report(vault, scan)
  3661	    base_text = report.read_text(encoding="utf-8")
  3662	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3663	
