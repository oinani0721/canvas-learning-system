  1885	def _verify_seed_ledger_counts(text: str, scan: dict, problems: list[str]) -> None:
  1886	    """台账『种子』行的批注数必须绑到 scan JSON 里**该节点的** tips_count。
  1887	
  1888	    ⛔ 维护卡 B · H-2 后半 (round-6 实证): 原实现只有整行**形状**白名单
  1889	    (``- <节点> — 批注 N 条``), 不绑值 —— 把真实的「批注 2 条」改成
  1890	    「批注 999 条」形状照样合法, 实测 exit 0。白名单管住了句式, 没管住数字的出处。
  1891	
  1892	    scan JSON 的 ``ledger`` 是**按角色分组的 dict** (seeds/derived/unknown) 而非扁平
  1893	    列表 —— 我第一版直接迭代它, 拿到的是键字符串, verifier 当场抛 NameError/AttributeError,
  1894	    stdout 全空 exit 1, 症状伪装成"报告不合规"。这里显式摊平并容两种形态。
  1895	    """
  1896	    mseed = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", text, re.M | re.S)
  1897	    if not mseed:
  1898	        return
  1899	    groups = scan.get("ledger")
  1900	    rows: list[dict] = []
  1901	    if isinstance(groups, dict):
  1902	        for grp in groups.values():
  1903	            if isinstance(grp, list):
  1904	                rows.extend(x for x in grp if isinstance(x, dict))
  1905	    elif isinstance(groups, list):
  1906	        rows = [x for x in groups if isinstance(x, dict)]
  1907	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  1908	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  1909	        return
