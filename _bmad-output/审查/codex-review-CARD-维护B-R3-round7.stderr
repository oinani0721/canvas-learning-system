  3877	def test_domain_r10_ordering_and_render_closure_cli(tmp_path):
  3878	    """R3 round-8：三处**顺序耦合** + 渲染闭包缺口 + 三张闭表的便宜面。
  3879	
  3880	    七条实测反例（修前全部 exit 0）：
  3881	      · `[[节点/A|987654]]个` —— D2 把 `[[目标` 挖空**跑在 `_visible_text` 之前**，
  3882	        只剩 `|987654]]个`，量词锚失效（顺序耦合）；
  3883	      · fallback `#### 派**生**子女 987654 个` —— 在**源码行**上判「含派生」与
  3884	        白名单匹配，`**` 隔开 `派`/`生` 整行不进检查面（顺序耦合）；
  3885	      · fallback `-5` —— 负数守卫原先**只在 D2 侧**（覆盖不全）；
  3886	      · `总[计](http://x)987654个` —— 标准 Markdown link 未取显示文本；
  3887	      · `98⁦⁩7654个` —— U+2066-2069 bidi isolate 不在不可见集；
  3888	      · `1'005个` / `987654笔` / `仨五个` —— 三张闭表的常见缺口。
  3889	
  3890	    **它证明什么**：归一必须跑在**筛选与豁免挖空之前**（三处顺序已改）；
  3891	    `_visible_text` 覆盖 Markdown link 与 bidi isolate；负数守卫两侧同口径。
  3892	    **它不证明什么**：`_visible_text` **仍不是完整 renderer**，三张表**仍是闭表**
  3893	    —— 见验收单 §五之五 的分类（四类都**没有**被证明有限）。
  3894	    """
  3895	    rs = _load_recap_scan()
  3896	    assert rs._visible_text("总[计](http://x)987654个") == "总计987654个"
  3897	    assert rs._visible_text("98⁦⁩7") == "987", "bidi isolate 不得切断数串"
  3898	    assert rs._normalize_number_seps("1'005") == "1005", "撇号千分位"
  3899	
  3900	    vault = standard_vault(tmp_path)
  3901	    scan = collect_json(vault)
  3902	    assert 987654 not in _load_recap_scan()._derived_number_pool(scan)
  3903	    report = write_report(vault, scan)
  3904	    base_text = report.read_text(encoding="utf-8")
  3905	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3906	
  3907	    def verify(anchor: str, injected: str):
  3908	        text = base_text.replace(anchor, injected, 1)
  3909	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3910	        report.write_text(text, encoding="utf-8")
  3911	        return run_verify(report)
  3912	
  3913	    def d2(line: str):
  3914	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3915	
  3916	    def fb_raw(raw: str):
  3917	        return verify("方向叙述：", f"\n{raw}\n\n方向叙述：")
  3918	
  3919	    for name, line, needles in (
  3920	        (
  3921	            "有别名 wikilink（顺序耦合）",
  3922	            "- 本板共有[[节点/A|987654]]个子节点。【实测】",
  3923	            ("找不到同值来源", "987654"),
  3924	        ),
  3925	        (
  3926	            "Markdown link 显示文本",
  3927	            "- 总[计](http://x)987654个子节点。【实测】",
  3928	            ("找不到同值来源", "987654"),
  3929	        ),
  3930	        ("bidi isolate", "- 本板共有98⁦⁩七654个子节点。【实测】", ("无法解析",)),
  3931	        ("撇号千分位", "- 本板共有1'005个子节点。【实测】", ("找不到同值来源", "1005")),
  3932	        (
  3933	            "量词表『笔』",
  3934	            "- 本板共有987654笔支出。【实测】",
  3935	            ("找不到同值来源", "987654"),
  3936	        ),
  3937	        ("数词表『仨』", "- 本板共有仨五个子节点。【实测】", ("无法解析", "仨五")),
  3938	    ):
  3939	        r = d2(line)
  3940	        assert r.returncode != 0, f"{name} 被放行:\n{r.stdout}"
  3941	        assert _one_problem_has(r.stdout, *needles), f"{name}: 诊断未绑定:\n{r.stdout}"
  3942	
  3943	    # fallback 侧：选行顺序 + 负数守卫
  3944	    r = fb_raw("#### 派**生**子女 987654 个 的说明")
  3945	    assert r.returncode != 0 and _one_problem_has(r.stdout, "无出处", "987654"), (
  3946	        f"fallback 在源码行上选行 ⇒ 整行不进检查面:\n{r.stdout}"
  3947	    )
  3948	    r = fb_raw("#### 派生子女 -5 个 的说明")
  3949	    assert r.returncode != 0 and _one_problem_has(r.stdout, "负数形态", "-5"), (
  3950	        f"fallback 负数未 fail-closed:\n{r.stdout}"
  3951	    )
  3952	
  3953	    # 放行面（同权重）——本轮的**回归探测面**
  3954	    for name, line in (
  3955	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3956	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
