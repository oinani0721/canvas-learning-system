  3551	def test_domain_r7_range_endpoints_and_fallback_seps_cli(tmp_path):
  3552	    """R3 round-4 行为门：区间两端都终核；fallback 也有小数/千分位防线。
  3553	
  3554	    三条实测反例（修前全部 exit 0）：
  3555	      · `本板共有987654-0个子节点` —— 某端无出处时区间不挖空，而后面的循环只取
  3556	        **紧邻量词**的右端 `0`；任一非空池都由 `abs(a-a)` 生成 0 ⇒ 放行。
  3557	        既有门只测了反方向 `1-987654`（大数在右）。
  3558	      · fallback `#### 派生子女 0.0 个` / `零点零` / `1,005` —— 千分位归一与小数
  3559	        防线原先**只在 D2 路径**，fallback 直接对原行 findall 逐片入池。
  3560	      · `本板共有987654<b>.</b>0个子节点` —— 渲染成 `987654.0`，但小数式原要求
  3561	        数串与 `.` 直接相邻，两道防线全不命中；`987654，000个` 的全角逗号同理。
  3562	
  3563	    **它证明什么**：区间两端都进池比对且**只在规模自陈句式内**报（非自陈句
  3564	    `建议覆盖 2~3 个节点` 不受伤——第一版把报错放在句式门之前，当场误伤）；
  3565	    千分位与小数防线在 D2 与 fallback **两侧都在**，且认全角逗号与被标签包住的
  3566	    小数点。
  3567	    **它不证明什么**：分隔符集合（`,`/`，`）与小数分隔符集合（`.`/`．`/`点`）
  3568	    仍是**封闭表**；其它千分位写法（空格已由连接集覆盖，撇号 `'` 等未覆盖）
  3569	    未验证。见验收单 §五之三。
  3570	    """
  3571	    vault = standard_vault(tmp_path)
  3572	    scan = collect_json(vault)
  3573	    pool = _load_recap_scan()._derived_number_pool(scan)
  3574	    assert 0 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3575	    report = write_report(vault, scan)
  3576	    base_text = report.read_text(encoding="utf-8")
  3577	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3578	
  3579	    def verify(anchor: str, injected: str):
  3580	        text = base_text.replace(anchor, injected, 1)
  3581	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3582	        report.write_text(text, encoding="utf-8")
  3583	        return run_verify(report)
  3584	
  3585	    def d2(line: str):
  3586	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3587	
  3588	    def fb(tok: str):
  3589	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3590	
  3591	    # 区间：大数在左（本轮新反例）与在右（既有方向）都必须被点名
  3592	    for name, line in (
  3593	        ("大数在左", "- 本板共有987654-0个子节点。【实测】"),
  3594	        ("大数在右", "- 本板共有0-987654个子节点。【实测】"),
  3595	        ("到字式", "- 本板共有987654到0个子节点。【实测】"),
  3596	    ):
  3597	        r = d2(line)
  3598	        assert r.returncode != 0, f"区间 {name} 被放行:\n{r.stdout}"
  3599	        assert _one_problem_has(r.stdout, "区间端点", "987654"), f"区间 {name}: 未点名无出处的那一端:\n{r.stdout}"
  3600	    # fallback 侧小数与千分位
  3601	    for name, tok, needles in (
  3602	        ("小数 ASCII", "0.0", ("小数形态", "0.0")),
  3603	        ("小数 CJK", "零点零", ("小数形态", "零点零")),
  3604	        ("千分位", "1,005", ("无出处", "1005")),
  3605	    ):
  3606	        r = fb(tok)
  3607	        assert r.returncode != 0, f"fallback {name} 被放行:\n{r.stdout}"
  3608	        assert _one_problem_has(r.stdout, *needles), f"fallback {name}: 诊断未绑定:\n{r.stdout}"
  3609	    # D2 侧：标签包住小数点 / 全角逗号
  3610	    r = d2("- 本板共有987654<b>.</b>0个子节点。【实测】")
  3611	    assert r.returncode != 0 and _one_problem_has(r.stdout, "小数形态", "987654.0"), (
  3612	        f"标签包住小数点未被识别为小数:\n{r.stdout}"
  3613	    )
  3614	    r = d2("- 本板共有987654，000个子节点。【实测】")
  3615	    assert r.returncode != 0 and _one_problem_has(r.stdout, "找不到同值来源", "987654000"), (
  3616	        f"全角逗号千分位未按完整量级查池:\n{r.stdout}"
  3617	    )
  3618	
  3619	    # 放行面（同权重）
  3620	    for name, line in (
  3621	        ("合法区间两端在池", "- 建议覆盖 2~3 个节点。【实测】"),
  3622	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3623	        ("`点` 的正当量词用法", "- 本板共有3点建议。【实测】"),
  3624	    ):
  3625	        r = d2(line)
  3626	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
  3627	    for name, tok in (("fallback 单字", "五"), ("fallback ASCII", "3")):
  3628	        r = fb(tok)
  3629	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
  3630	
