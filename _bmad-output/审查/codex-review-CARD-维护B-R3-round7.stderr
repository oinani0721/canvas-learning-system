  1496	_CJK_NUM = {
  1497	    "零": 0,
  1498	    "〇": 0,
  1499	    "一": 1,
  1500	    "二": 2,
  1501	    "两": 2,
  1502	    "三": 3,
  1503	    "四": 4,
  1504	    "五": 5,
  1505	    "六": 6,
  1506	    "七": 7,
  1507	    "八": 8,
  1508	    "九": 9,
  1509	}
  1510	_CJK_UNIT = {"十": 10, "百": 100, "千": 1000, "万": 10000, "亿": 100000000}
  1511	# ⛔ R3: 提取字符类**由两张表机械派生**, 不再手抄字面量。
  1512	# 判据 (`_cjk_single_to_int`) 只认 `_CJK_NUM` 单字; 提取面必须是
  1513	# `_CJK_NUM ∪ _CJK_UNIT` 的**超集方向** —— 抓得到才拒得掉:
  1514	# 提取面漏掉某个数词字, 该字组成的串会落到检查面**之外** = 漏拦 (不是
  1515	# fail-closed)。两处消费点 (D2 叙述段 / fallback 允许式) 共用本常量,
  1516	# 手抄两份字面量正是它们此前分叉的成因。
  1517	_CJK_NUM_CHARS = "".join(sorted(set(_CJK_NUM) | set(_CJK_UNIT)))
