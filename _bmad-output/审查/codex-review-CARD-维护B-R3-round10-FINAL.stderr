  4873	
  4874	    HIDE = "- 本板共有987654个子节点。【实测】"
  4875	    assert 987654 not in rs._derived_number_pool(scan), "前提：987654 必须在池外"
  4876	
  4877	    # ① 四空格不是围栏 ⇒ 藏在里面的可见计数必须受检
  4878	    r = in3(f"    ```\n{HIDE}\n    ```")
  4879	    assert r.returncode != 0, "四空格伪围栏让可见计数整段免检"
  4880	    assert _one_problem_has(r.stdout, "987654"), f"诊断未指向 987654:\n{r.stdout}"
