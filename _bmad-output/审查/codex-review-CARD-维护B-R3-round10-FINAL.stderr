  1888	def _count_token_value(token: str) -> int | None:
  1889	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1890	
  1891	    只两种情形给值:
  1892	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1893	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1894	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1895	    """
  1896	    if not token:
  1897	        return None
  1898	    if token.isascii() and token.isdigit():
  1899	        return int(token)
  1900	    return _cjk_single_to_int(token)
  1901	
