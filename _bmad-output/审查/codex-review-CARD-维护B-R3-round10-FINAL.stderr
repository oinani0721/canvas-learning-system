  5215	def test_domain_r27_seedish_h3_and_corrupt_seeds():
  5216	    """R3 round-32（冻结审查 v13 的第六形态）：不被口径认可的种子 H3 必须自己报。
  5217	
  5218	    ⛔ 只收集**认可的**小节，等于把「不合口径的种子 H3」整块**排除在审计面之外**：
  5219	      · `seeds=[]` + `### 种子 ###` + `- Ghost — 批注 9 条` ⇒ 零 section 且零种子，
  5220	        函数直接返回，Ghost 行**永不受审**；
  5221	      · 更强：先放一个**认可的空** `### 种子`，再放第二个**不认可**的 H3 + Ghost 行
  5222	        ⇒ 第二块永不审，**非零种子板同样可绕**。
  5223	
  5224	    同批：损坏的 `seeds=[None]` 会被过滤成空 rows，再因**原值仍是 list** 被当成
  5225	    合法零种子 ⇒ 损坏数据静默通过。现改为 fail-closed。
  5226	
  5227	    ⛔ round-37（Codex 冻结审查 HIGH「第八形态」）：`_h3_wellformed` 原先标题体
  5228	    收 `[^\n]*`（什么都认），于是 `###  种子`（两空格）/ `###\t种子`（制表符）/
  5229	    不带尾随井号的 `` ### `种子` `` 与 `### ==种子==` 全被判**合规** ⇒ 其下台账行
  5230	    既不进绑定面也不进漏网扫描。⚠️ 原有的 inline-code / highlight 两条之所以变红，
  5231	    靠的是它们**额外带了尾随 ` ###`**——即「闭合井号被判不合规」，
  5232	    **不是** inline-code/highlight 归一承重（审查方指出，实测属实）。
  5233	    本轮去掉尾随 closer 单独立条，才真正测到那条性质。
  5234	
  5235	    同批：台账 H2 之后、**第一个 H3 之前**的台账形状行原先 `_cur_bad` 初值 `False`
  5236	    ⇒ 是一段完全无人看管的区间，现改为默认「不在任何认可小节内」。
  5237	
  5238	    **它证明什么**：十五种形态各自正确（九报六放行），含围栏内形似标题不误报。
  5239	    **它不证明什么**：不覆盖 `ledger` 为扁平 list 的损坏形态；
  5240	    也不改变 `_SECTION_RE` 的接受集本身（放宽须改本体让两侧同动）。
  5241	    """
  5242	    rs = _load_recap_scan()
  5243	
  5244	    # ⛔ round-33：原先只断言「有报错」，于是 survivor-64 变异后靠**另一条**
  5245	    #    诊断（「不在 ledger」）就能让门保持绿 —— 实测未承重。
  5246	    #    ⇒ 每条都**绑定诊断关键词**，报错内容必须是这一条。
  5247	    for want, why, text, ledger in (
  5248	        (
  5249	            "不受任何认可小节覆盖",
  5250	            "第六形态 a：seeds=[] + 不认可 H3 + Ghost 行",
  5251	            "## 台账\n\n### 种子 ###\n\n- Ghost — 批注 9 条\n\n## 末\n",
  5252	            {"seeds": []},
  5253	        ),
  5254	        (
  5255	            "不受任何认可小节覆盖",
