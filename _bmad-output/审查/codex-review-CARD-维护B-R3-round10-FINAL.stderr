  5440	def test_domain_r30_obsidian_comment_hidden_break_cli(tmp_path):
  5441	    """R3 round-37（Codex 冻结审查 BLOCKER）：Obsidian 自己的注释 `%%…%%`。
  5442	
  5443	    ⛔ 正文早就禁写 **HTML** 注释（「渲染隐藏面 / 可见文本与校验文本分叉」），
  5444	    但 Obsidian 的原生注释语法 `%%…%%` **完全没管**。它是同一类隐藏面：
  5445	
  5446	      `- 本板共有987654%%x%%0个子节点。`
  5447	
  5448	    阅读视图隐藏注释后读者看到 `9876540`；校验器在 `%` 处**断开**，
  5449	    只取量词前的尾片 `0`，而 **0 因 `abs(a-a)` 恒在池内** ⇒ 整条放行。
  5450	    又一次「尾片重锚」，只是换了个隐藏载体。
  5451	
  5452	    **它证明什么**：`%%` 按与 HTML 注释**逐字同款**的口径处置 ——
  5453	    在**原始文本**上一次判死（不区分闭合与否、不管是否落在 code span 内），
  5454	    且校验前剥掉（防「注释里藏正确模板行、可见文本撒谎」）。
  5455	    **它不证明什么**：不覆盖别的渲染隐藏面（math `$…$`、脚注、折叠块等）——
  5456	    那是本卡反复登记的 renderer 开放集，逐个补不是闭包（见接手清单 A2）。
  5457	    """
  5458	    rs = _load_recap_scan()
  5459	    vault = standard_vault(tmp_path)
  5460	    scan = collect_json(vault)
  5461	    pool = rs._derived_number_pool(scan)
  5462	    assert 987654 not in pool, "前提：987654 必须在池外"
  5463	    assert 0 in pool, "前提：0 恒在池内 —— 这正是尾片重锚的危险来源"
  5464	
  5465	    report = write_report(vault, scan)
  5466	    base = report.read_text(encoding="utf-8")
  5467	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  5468	
  5469	    def inject(line: str):
  5470	        text = base.replace("## 三维审查", f"## 三维审查\n\n{line}", 1)
  5471	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  5472	        report.write_text(text, encoding="utf-8")
  5473	        return run_verify(report)
  5474	
  5475	    for line, why in (
  5476	        ("- 本板共有987654%%x%%0个子节点。【实测】", "注释制造隐藏硬断点 → 尾片 0 重锚"),
  5477	        ("- 本板共有%%注释%%5个子节点。【实测】", "注释在数字之前"),
  5478	        ("- 本板共有5%%注释%%个子节点。【实测】", "注释在量词之前"),
  5479	        ("- 正常一句话 %%只是个注释%%。【实测】", "无数字也判死（与 HTML 注释同口径）"),
  5480	        ("- 本板共有 `%%` 个子节点。【实测】", "code span 内同样判死（同 HTML 注释口径）"),
  5481	    ):
  5482	        r = inject(line)
  5483	        assert r.returncode != 0, f"{why}：%% 注释放行 —— {line!r}"
  5484	        out = (r.stdout or "") + (r.stderr or "")
  5485	        assert "Obsidian 注释标记" in out, f"{why}：报错了但不是这条报的 —— {out[-300:]!r}"
  5486	
  5487	    # 对照：单个 `%` 不受影响（百分数是正常写法）
  5488	    report.write_text(base, encoding="utf-8")
  5489	    r = inject("- 覆盖率 50% 已达标。【实测】")
  5490	    assert r.returncode == 0, f"单个 % 被误伤：{(r.stdout or '')[-300:]!r}"
  5491	
