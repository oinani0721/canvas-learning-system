  2570	        counts.get(k, -1)
  2571	        for k in ("members", "seeds", "derived", "stubs", "annotations")
  2572	    )
  2573	    if not scale_hits:
  2574	        problems.append("规模自陈行未按模板格式给出五元组 (成员/种子/派生/占位/批注)")
  2575	    elif len(scale_hits) > 1:
  2576	        problems.append(
  2577	            f"数字终核: 报告出现 {len(scale_hits)} 处规模自陈五元组 (只许一处, "
  2578	            "多处 = 诱饵/自相矛盾)"
  2579	        )
  2580	    for hit in scale_hits:
  2581	        got = tuple(int(x) for x in hit)
  2582	        if got != want:
  2583	            problems.append(f"数字终核: 规模自陈 {got} ≠ scan JSON {want}")
  2584	    # tips 两数只在「AI 侧对账」段绑定 — 台账里逐节点的 "tips 未闭环 n 条"
