  2770	def _verify_report(path: str) -> int:
  2771	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2772	
  2773	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2774	    """
  2775	    try:
  2776	        text_raw = Path(path).read_text(encoding="utf-8")
  2777	    except (OSError, UnicodeDecodeError) as e:
  2778	        print(f"✗ 报告不可读: {type(e).__name__}")
  2779	        return 1
  2780	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2781	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2782	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2783	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2784	    if not fm_m:
  2785	        print("✗ 报告缺 frontmatter 块")
  2786	        return 1
  2787	    fm = fm_m.group(1)
  2788	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2789	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2790	    if "<!--" in fm or "-->" in fm:
  2791	        print("✗ frontmatter 块内含 HTML 注释标记")
  2792	        return 1
  2793	    problems: list[str] = []
  2794	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2795	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  2796	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  2797	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  2798	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  2799	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  2800	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  2801	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  2802	    if "<!--" in text_raw or "-->" in text_raw:
  2803	        problems.append(
  2804	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2805	        )
  2806	    # ⛔ R3 round-37 (Codex 冻结审查 BLOCKER): Obsidian 自己的注释语法 `%%…%%`
  2807	    # 与 HTML 注释是**同一类渲染隐藏面**, 而上面那条只判了 HTML 一种。
  2808	    # 实测载体: `本板共有987654%%x%%0个子节点` —— 阅读视图隐藏注释后读者看到
  2809	    # `9876540`, 而校验器在 `%` 处**断开**、只取量词前的 `0`, 且 0 因 `abs(a-a)`
  2810	    # **恒在池内** ⇒ 整条放行。这正是本卡反复出现的「尾片重锚」, 换了个隐藏载体。
  2811	    # 按与 HTML 注释**逐字同款**的口径处置: 在原始文本上一次判死 + 校验前剥掉,
  2812	    # 不区分闭合与否、不管是否落在 code span 内。
  2813	    if "%%" in text_raw:
  2814	        problems.append(
  2815	            "正文含 Obsidian 注释标记 %% (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2816	        )
  2817	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  2818	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  2819	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
  2820	    text = re.sub(r"%%.*?%%", "", text, flags=re.S)
  2821	    # round-4: 零宽/双向控制字符 — 渲染不可见但能改变正则匹配与阅读顺序,
  2822	    # 是"看起来合规、实际另一回事"的通用载体。合法报告没有理由出现它们。
  2823	    # ⛔ R3 round-15 (冻结审查): 这里原先**手抄**了一份不可见字符集, 只到 U+2064,
  2824	    #    而 _INVISIBLE_ONE 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  2825	    #    又一处「同一原则两处定义」。改为共用 _INVISIBLE_ONE。
  2826	    if re.search(_INVISIBLE_ONE, text):
  2827	        problems.append("正文含零宽/双向控制字符 (不可见字符, 报告禁用)")
  2828	    _verify_numbers(fm, text, Path(path), problems)
  2829	    if not re.search(r"^type:\s*recap\s*$", fm, re.M):
  2830	        problems.append("frontmatter 缺 type: recap")
  2831	    if "规模自陈" not in text:
  2832	        problems.append("缺 规模自陈 callout")
  2833	    # 六轮防御③: 必需段落唯一 — 重复段(第一段合规第二段夹私货)不放行。
  2834	    # ⛔ round-6 BLOCKER 同源修复: 根因是**存在性检查与下游定位口径不一致**
  2835	    # —— 存在性用前缀匹配 (`^## AI 侧对账`), 下游 tips 绑定/动作段白名单却用
  2836	    # 整行正则定位, 于是 `## AI 侧对账（本轮）` 两头讨好: 算"段落在场"、
  2837	    # 却让下游整块校验静默跳过。模板里 `## 台账（种子/派生）` 这类**设计内的
  2838	    # 括号补充**又必须放行, 所以不能一刀切整行精确。
  2839	    # 统一口径 = `_SECTION_RE`: 段名之后只允许「行尾」或「全角括号补充」,
