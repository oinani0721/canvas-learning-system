  4844	def test_domain_r22_fence_indent_and_seed_scope_cli(tmp_path):
  4845	    """R3 round-26（冻结审查 v7）：四空格伪围栏 + 种子小节范围 + 尾巴同名字段。
  4846	
  4847	    三条实测：
  4848	      · **四空格缩进的 ``` 不是围栏**（CommonMark 里那是 indented code block）。
  4849	        原实现先用 `[>\\s]` 吃掉**任意**前导空白，`open_re` 的 ` {0,3}` 形同虚设
  4850	        ⇒ 顶层 `    ```` 被当成开栏，其后读者**看得见**的自陈句整段免检（实测放行）；
  4851	      · round-25 的「逐个处理全部种子小节」**范围超出意图** —— 搜全篇任意
  4852	        `### 种子`，未限定父级 `## 台账`、未排除围栏 ⇒ 附录里的同名小节被强制
  4853	        套台账模板（本轮误伤面，审查方指出）；
  4854	      · 尾巴里再写一个**同名字段**的计数（`批注 N 条`）与已绑定的首数矛盾。
  4855	
  4856	    **它证明什么**：容器前缀（引用/列表）仍被正确剥离，但无 marker 时不动缩进；
  4857	    种子小节只在「台账」H2 之下且不在围栏内才生效；同字段两处计数 fail-closed。
  4858	    **它不证明什么**：尾巴里**其它**字段（`理解度未闭环 N 条`/`已派生 N 点`）
  4859	    在 scan JSON 无逐节点对应字段，**不绑定**，如实登记。
  4860	    """
  4861	    rs = _load_recap_scan()
  4862	    vault = standard_vault(tmp_path)
  4863	    scan = collect_json(vault)
  4864	    report = write_report(vault, scan)
  4865	    base = report.read_text(encoding="utf-8")
  4866	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4867	
