  5347	def test_domain_r28_tips_binding_visible_space_cli(tmp_path):
  5348	    """R3 round-34（B1，冻结审查 v9~v14 **连续七轮**点名）：tips 两数的渲染空间绑定。
  5349	
  5350	    ⛔ 这是本卡**最老、最明确、修法最现成**的一条未闭合项 —— 每轮我都登记「未改」，
  5351	    而修法从 round-18 起就已存在（`_visible_block`，与种子小节 / 五元组 /
  5352	    ③段信号行**逐字同型**，那三处都已被审查判 ✅）。
  5353	    它一直排在队尾，不是被遗忘，是**优先级的结构性偏差**：新问题天然显得更紧急，
  5354	    而「已经登记过 N 轮」在心理上会被当成「已经处理过」。
  5355	
  5356	    实测三条（修前 exit 0）：保留正确行 + 追加**渲染等价但源码不命中**的冲突行
  5357	      · `- tips 批**注**共 999 条`
  5358	      · `- tips 批<b>注</b>共 999 条`
  5359	      · `- 其中理解度未**闭**环 999 条`
  5360	
  5361	    ⚠️ **复现方法本身有个坑**：第一版载荷把整行复制过去（含 `其中理解度未闭环 4 条`），
  5362	    结果被**相邻**那条模式的唯一性检查拦下 —— 典型的**纵深遮蔽**，差点让我误判
  5363	    「不可复现」。干净载荷必须只含被切断的那**一个**模式。
  5364	
  5365	    **它证明什么**：段抓取与两条模式的 in_sec/all_hits 都在渲染空间比对。
  5366	    **它不证明什么**：不改变 tips 绑定的**语义**（仍是「段内恰一条 + 全文逐条等值」）；
  5367	    也不覆盖中文数词 / 带圈数字等非 `Nd` 形态（见接手清单 B3）。
  5368	    """
  5369	    vault = standard_vault(tmp_path)
  5370	    scan = collect_json(vault)
  5371	    report = write_report(vault, scan)
  5372	    base = report.read_text(encoding="utf-8")
  5373	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  5374	
  5375	    tips = next((ln for ln in base.splitlines() if re.search(r"tips 批注共\s*\d+\s*条", ln)), None)
  5376	    assert tips, "前提：报告必须含 tips 标准计数行"
  5377	
  5378	    def with_conflict(conflict: str):
  5379	        text = base.replace(tips, tips + "\n" + conflict, 1)
  5380	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  5381	        report.write_text(text, encoding="utf-8")
  5382	        return run_verify(report)
  5383	
  5384	    for conflict, why in (
  5385	        ("- tips 批**注**共 999 条", "第一条模式被强调标记切开"),
  5386	        ("- tips 批<b>注</b>共 999 条", "第一条模式被 HTML 标签切开"),
  5387	        ("- 其中理解度未**闭**环 999 条", "第二条模式被强调标记切开"),
  5388	        ("- tips 批注共 999 条", "对照：裸冲突行"),
  5389	    ):
  5390	        r = with_conflict(conflict)
  5391	        assert r.returncode != 0, f"{why}：冲突行被放行 —— {conflict!r}"
  5392	        assert _one_problem_has(r.stdout, "999"), f"{why}：诊断未指向冲突值 999\n{r.stdout}"
  5393	
  5394	    # 不得误伤：把**正确行本身**写成渲染等价的强调形态，仍须通过
  5395	    report.write_text(
  5396	        base.replace(tips, tips.replace("tips 批注共", "tips 批**注**共", 1), 1),
  5397	        encoding="utf-8",
  5398	    )
  5399	    assert run_verify(report).returncode == 0, "渲染等价的合规 tips 行被误判"
  5400	
  5401	
  5402	def test_domain_r31_tail_fields_bound_to_scan():
  5403	    """R3 round-37（Codex 冻结审查 HIGH）：种子行尾巴的另两个字段必须绑出处。
  5404	
  5405	    ⛔ `_tail_conflict` 的 docstring 此前写着这两个字段「在 scan JSON 里**没有
  5406	    对应的逐节点字段可绑**」—— **假声明**。`tips_open` 与 `derived_children_count`
  5407	    一直都在，且 SKILL.md 明写「已派生 x 点」就是**抄** `derived_children_count`。
  5408	    也就是说：这两个数本就来自 scan，却从来没核对过，报告里改成任意值都能通过。
  5409	
  5410	    **它证明什么**：有字段就必须对得上（篡改必红），无字段不误报（能力边界）。
  5411	    **它不证明什么**：不覆盖尾巴里的其它自由文本；也不改变 D2 的碰撞判据性质。
  5412	    """
  5413	    rs = _load_recap_scan()
  5414	    row = {"node_id": "S", "tips_count": 2, "tips_open": 3, "derived_children_count": 4}
  5415	    bare = {"node_id": "S", "tips_count": 2}  # 旧 scan / fallback：两字段缺失
  5416	
  5417	    def run(line: str, seed: dict) -> list[str]:
  5418	        ps: list[str] = []
  5419	        rs._verify_seed_ledger_counts(
  5420	            f"## 台账\n\n### 种子\n\n{line}\n\n## 末\n",
  5421	            {"ledger": {"seeds": [seed]}},
  5422	            ps,
  5423	        )
  5424	        return ps
  5425	
  5426	    for line, seed, want, why in (
  5427	        ("- S — 批注 2 条（理解度未闭环 3 条）", row, None, "对照：两数都对"),
  5428	        ("- S — 批注 2 条（理解度未闭环 9 条）", row, "tips_open", "篡改未闭环数必红"),
  5429	        ("- S — 批注 2 条（理解度未闭环 3 条）· 已派生 4 点", row, None, "对照：派生数也对"),
  5430	        ("- S — 批注 2 条（理解度未闭环 3 条）· 已派生 9 点", row, "derived_children_count", "篡改派生数必红"),
  5431	        ("- S — 批注 2 条（理解度未闭环 9 条）· 已派生 9 点", bare, None, "能力边界：无字段不误报"),
  5432	    ):
  5433	        ps = run(line, seed)
  5434	        if want is None:
  5435	            assert ps == [], f"{why}：误伤 —— {ps!r}"
  5436	        else:
  5437	            assert any(want in x for x in ps), f"{why}：未报出目标诊断 {want!r} —— {ps!r}"
  5438	
