  1846	def _normalize_number_seps(line: str) -> str:
  1847	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1848	
  1849	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1850	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1851	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1852	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1853	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1854	    """
  1855	    # ⛔ R3 round-6: 解 HTML 实体已上移到 _visible_text() —— 两个消费点都在最前面
  1856	    # 跑它, 此处再解一次是**冗余**（且 `&amp;#46;` 会被双重解码成 `.`, 反而错）。
  1857	    # 一个性质只应有一个实现位置; 留在这里就是死代码。
  1858	    # ⛔ R3 round-5 (Codex round-4 HIGH-3): 逗号两侧也可能夹连接字符 ——
  1859	    # `987654<b>,</b>000个` 渲染成 `987654,000个`, 原式(要求逗号紧邻数字)不命中。
  1860	    # ⛔ R3 round-35（2026-09-03 内部多维复核 BLOCKER）：原式的
  1861	    #    `(?=[0-9]{3}(?![0-9]))`「恰好三位分组」前瞻制造了**第三态** ——
  1862	    #    分隔符既**不被删**（不满足前瞻）也**不算连接字符**（不在 _D2_JOIN_ONE 里），
  1863	    #    于是成为**硬断点**，`_NUM_RUN_PAT` 从它之后重锚到尾片：
  1864	    #      · `987654,0`  ⇒ 只看到 `0`，而 0 因 `abs(a-a)` **恒在池内** ⇒ 放行
  1865	    #      · `987654，0` / `987654'0`（全角逗号 / 本函数自己声明的 Swiss 撇号）同上
  1866	    #      · `1,05`      ⇒ 读者读 105，校验器读 5
  1867	    #      · `987654,000` ⇒ 拦下 ✓（**只差「分组是否恰好三位」**）
  1868	    #    与 round-2 的「九十八万**五** / 980 005」是**同一个尾片重锚病**，
  1869	    #    只是断点字符换成了本函数自己声明为「数串内部分隔符」的那几个。
  1870	    #    ⇒ 降级为**无条件**数串内噪声（一律删，不看位数），与 _D2_JOIN_ONE 同级。
  1871	    #    `int("105")` 本就按十进制解析，删分隔符不会改变量级；
  1872	    #    真正危险的是留下任何字符停在「不删也不断」的第三态。
  1873	    #    ⚠️ 仍要求两侧都是数字，`见 1,と` 这类非数字上下文不受影响。
  1874	    # ⛔ R3 round-37（Codex 冻结审查）：只归一**合法千分位分组**。
  1875	    # round-35 的无条件剥除把 `1, 2个`（两个可见数）合成 `12个` —— 若 12 在池里
  1876	    # 就是假放行。不合法/含糊的分隔符不再删除：它已进 `_NUM_RUN_CHARS` 定界集，
  1877	    # 会与两侧数字划进**同一个 token**，`_count_token_value` 判不出值 ⇒ fail-closed。
  1878	    # ⚠️ 代价如实声明：`本板共有 1, 2 个子节点` 这类**含糊写法**从此硬 FAIL
  1879	    # （与卡文对 `一两个/三五个` 的既定处置同向）；合法千分位 `1,005` 不受影响。
  1880	    return _GROUPED_NUM_RE.sub(
  1881	        lambda m: re.sub(
  1882	            rf"{_D2_JOIN_ONE}*[{_NUM_SEP_CHARS}]{_D2_JOIN_ONE}*", "", m.group(0)
  1883	        ),
  1884	        line,
  1885	    )
