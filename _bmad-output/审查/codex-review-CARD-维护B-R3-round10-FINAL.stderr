backend/tests/regression/test_recap_scan_signals.py:132:    r = subprocess.run(
backend/tests/regression/test_recap_scan_signals.py:133:        [sys.executable, str(SCRIPT), "--verify", str(report)],
backend/tests/regression/test_recap_scan_signals.py:134:        capture_output=True,
backend/tests/regression/test_recap_scan_signals.py:135:        text=True,
backend/tests/regression/test_recap_scan_signals.py:136:        timeout=60,
backend/tests/regression/test_recap_scan_signals.py:137:    )
