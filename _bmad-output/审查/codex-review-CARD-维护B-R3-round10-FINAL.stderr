backend/tests/regression/test_recap_scan_signals.py:276:    out: dict[str, tuple[str, int]] = {}
backend/tests/regression/test_recap_scan_signals.py:277:    for p in sorted(vault.rglob("*")):
backend/tests/regression/test_recap_scan_signals.py:278:        if p.is_file():
backend/tests/regression/test_recap_scan_signals.py:279:            st = p.stat()
backend/tests/regression/test_recap_scan_signals.py:280:            out[str(p.relative_to(vault))] = (
backend/tests/regression/test_recap_scan_signals.py:281:                hashlib.sha256(p.read_bytes()).hexdigest(),
backend/tests/regression/test_recap_scan_signals.py:282:                st.st_mtime_ns,
backend/tests/regression/test_recap_scan_signals.py:283:            )
backend/tests/regression/test_recap_scan_signals.py:284:    return out
