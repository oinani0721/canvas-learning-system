   906	def run_suite(targets: list[str], keyword: str | None = None) -> tuple[int, str, int, int, bool, set[str]]:
   907	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数, 是否崩溃)。
   908	
   909	    ⛔ round-36：`targets` 是**精确 nodeid 列表**（基线态传套件路径 + keyword）。
   910	    原先靠 `-k` 选门，12 条变体的 keyword 一选就是好几个用例，
   911	    「有失败」证明不了「**指定**门死了」——见 `DESIGNATED` 的说明。
   912	
   913	    ⛔ round-27（冻结审查 v8）：注解与 docstring 原写**四元组**，实际返回五元组
   914	    （`crash` 是 round-10 加的）—— 又一处「说的与做的不符」。
   915	
   916	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   917	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   918	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   919	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   920	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   921	    要求"确实收集到用例"且"确实有失败"才算变红。
   922	    """
   923	    r = subprocess.run(
   924	        [str(PYTEST), *targets, "-q", "-rf", "-p", "no:cacheprovider"] + (["-k", keyword] if keyword else []),
   925	        cwd=ROOT / "backend",
   926	        capture_output=True,
   927	        text=True,
   928	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   929	        timeout=600,
   930	    )
   931	    out = r.stdout
   932	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   933	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   934	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   935	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   936	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   937	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
