backend/tests/regression/test_recap_scan_signals.py:325:    def walk(obj, path=""):
backend/tests/regression/test_recap_scan_signals.py:326:        if isinstance(obj, dict):
backend/tests/regression/test_recap_scan_signals.py:327:            for k, v in obj.items():
backend/tests/regression/test_recap_scan_signals.py:328:                if k != "policy":  # policy 值声明 zero_threshold, 键名本身中性
backend/tests/regression/test_recap_scan_signals.py:329:                    assert not any(b in k.lower() for b in banned), f"判定类键: {path}.{k}"
backend/tests/regression/test_recap_scan_signals.py:330:                walk(v, f"{path}.{k}")
backend/tests/regression/test_recap_scan_signals.py:331:        elif isinstance(obj, list):
backend/tests/regression/test_recap_scan_signals.py:332:            for i, v in enumerate(obj):
backend/tests/regression/test_recap_scan_signals.py:333:                walk(v, f"{path}[{i}]")
