  2506	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  2507	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  2508	
  2509	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  2510	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  2511	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  2512	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  2513	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  2514	    """
  2515	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  2516	    if not mb:
  2517	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  2518	        return
  2519	    board_id = mb.group(1).strip()
  2520	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  2521	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  2522	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  2523	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
  2524	    if not mname:
  2525	        problems.append(f"报告文件名不符 `回顾-<板>-<日期>.md`: {report_path.name}")
  2526	    elif mname.group(1) != board_id:
  2527	        problems.append(
  2528	            f"数字终核: frontmatter board={board_id!r} 与文件名的板 "
  2529	            f"{mname.group(1)!r} 不一致 (不得绑定另一块板的 scan JSON)"
  2530	        )
  2531	    scan_path = report_path.parent / f".recap-scan-{board_id}.json"
  2532	    try:
  2533	        scan = json.loads(scan_path.read_text(encoding="utf-8"))
  2534	    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
  2535	        problems.append(
  2536	            f"数字终核 fail-closed: scan JSON 缺失或损坏 ({scan_path.name})"
  2537	        )
  2538	        return
  2539	    for key, pat in (
  2540	        ("board_sha256", r'^board_sha256:\s*"?([0-9a-f]{64})"?'),
  2541	        ("data_mode", r"^data_mode:\s*(\S+)"),
  2542	        ("recap_date", r"^recap_date:\s*(\S+)"),
  2543	    ):
  2544	        mm = re.search(pat, fm, re.M)
  2545	        want = (
  2546	            scan.get(key)
  2547	            if key != "board_sha256"
  2548	            else (scan.get("source_revision") or {}).get("board_sha256")
  2549	        )
  2550	        if not mm or str(mm.group(1)) != str(want):
  2551	            problems.append(f"数字终核: frontmatter {key} 与 scan JSON 不一致")
  2552	    counts = scan.get("counts") or {}
  2553	    # ⛔ round-6 HIGH (终裁复核实测): 原用 re.search 全文取**首个**五元组匹配,
  2554	    # 且无唯一性约束 —— 在报告更早处放一行携带真数字的诱饵 (散文行, 甚至
  2555	    # 代码围栏里), 可见的「规模自陈」callout 就能写任意假数字并 PASS
  2556	    # (实测 120 成员/350 批注 通过)。改为: 全文所有五元组形态的行**逐条**
  2557	    # 校验且必须恰好一条 —— 诱饵行自己也会被校验, 无处可藏。
  2558	    scale_pat = re.compile(
  2559	        r"(\d+)\s*成员（(\d+)\s*种子\s*\+\s*(\d+)\s*派生，(\d+)\s*占位）/\s*(\d+)\s*批注"
  2560	    )
  2561	    # ⛔ R3 round-20 (冻结审查 v2「三处不改」判断被推翻): 原先在 **raw 全文**
  2562	    #    上 findall ⇒ 保留一条正确五元组、再加一条**渲染等价但源码不命中**的
  2563	    #    冲突行 (`999 成**员**（…）` / `999 成<b>员</b>（…）`), 后者既不计入
  2564	    #    「恰好一处」的计数、也不被逐条校验 —— 两条实测 exit 0 放行。
  2565	    #    与 ③段信号行的双行逃逸**同型**; 我上一轮只测了「改坏那条唯一正确行」
  2566	    #    (形状一坏就 fail-closed), 没把「留一条好的 + 加一条冲突的」这个形态
  2567	    #    迁移过来, 于是误判为「实测不成立」。⇒ 逐行归一后再匹配。
  2568	    scale_hits = scale_pat.findall(_visible_block(text))
