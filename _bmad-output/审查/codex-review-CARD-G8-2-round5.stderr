   700	_TEXT_STATUS_RE = re.compile(r"^\[vault-lint\] (\S+) status=(\S+)", re.M)
   701	
   702	
   703	def test_json_and_text_are_same_source(tmp_path):
   704	    root = tmp_path / "v"
   705	    _node(root, "孤儿")
   706	    _projection(root, "2026-08-30T09:05:05+08:00")  # stale
   707	    proc = _run_cli(root, "--now", NOW_ARG)
   708	    assert proc.returncode == 2
   709	    text_rows = dict(_TEXT_STATUS_RE.findall(proc.stdout))
   710	    payload = json.loads(_run_cli(root, "--now", NOW_ARG, "--json").stdout)
   711	
   712	    json_rows = {c["name"]: c["status"] for c in payload["checks"]}
   713	    assert text_rows == json_rows, "文本与 JSON 的 per-check status 必须逐项相等 (同源)"
   714	    assert proc.returncode == payload["summary"]["exit_code"]
   715	    assert payload["summary"]["checks_skipped"] == []
   716	    # 同一输入跑两次, JSON 输出必须语义稳定 (排除随机序/时间依赖)
   717	    again = json.loads(_run_cli(root, "--now", NOW_ARG, "--json").stdout)
   718	    assert again == payload, "同输入两次运行 JSON 输出不一致 —— 存在隐藏的非确定性"
   719	
