   169	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   170	    skipped: list[str] = field(default_factory=list)
   171	
   172	
   173	def exit_code(report: LintReport) -> int:
   174	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   175	    statuses = {c.status for c in report.checks}
   176	    if FAIL in statuses:
   177	        return EXIT_FAIL
   178	    if WARN in statuses:
   179	        return EXIT_WARN
   180	    return EXIT_OK
   181	
   182	
   183	def report_to_json(report: LintReport) -> dict[str, Any]:
   184	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   185	    return {
   186	        "vault": report.vault,
   187	        "today": report.today,
   188	        "summary": {
   189	            "exit_code": exit_code(report),
   190	            "checks_run": [c.name for c in report.checks],
   191	            "checks_skipped": list(report.skipped),
   192	            "status_counts": {s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)},
   193	        },
   194	        "checks": [
   195	            {
   196	                "name": c.name,
   197	                "status": c.status,
   198	                "summary": c.summary,
   199	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   200	                "notes": list(c.notes),
   201	                "details": dict(c.details),
   202	            }
   203	            for c in report.checks
   204	        ],
   205	    }
   206	
   207	
   208	def render_text(report: LintReport, *, color: bool = True) -> str:
   209	    """文本视图 —— 只读 `report`, 与 `report_to_json` 同源。
   210	
   211	    每个检查恰一行机读状态行 `{TAG} <name> status=<status> ...`, 同源门据此解析比对。
   212	    """
   213	
   214	    def c(code: str, s: str) -> str:
   215	        return f"{code}{s}{RESET}" if color else s
   216	
   217	    hue = {OK: GREEN, WARN: YELLOW, FAIL: RED}
   218	    out: list[str] = [
   219	        f"{c(DIM, 'vault')} {report.vault}",
   220	        f"{c(DIM, 'today')} {report.today} ({_DISPLAY_TZ_NAME})",
   221	    ]
   222	    for chk in report.checks:
   223	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   224	        for note in chk.notes:
   225	            out.append(f"    {c(DIM, 'note  ' + note)}")
   226	        for fd in chk.findings:
   227	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   228	    for name in report.skipped:
   229	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   230	    rc = exit_code(report)
   231	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   232	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   233	    return "\n".join(out)
   234	
   235	
   236	# ---------------------------------------------------------------------------
   237	# 共用只读 helpers
   238	# ---------------------------------------------------------------------------
   239	def _scan_block_reason(vault: Path, path: Path) -> str | None:
   240	    """扫描读取的统一边界守卫: 返回拦截原因; None = 可以读。
   241	
   242	    覆盖 (Codex round-2 HIGH-1 的三条旁路, 复用 G8-1 的 G11 判据 `cvr.
   243	    _resolves_inside_vault` —— realpath 展开整条 symlink 链):
   244	      - 文件自身是 symlink (无论指内指外, 保守拒读);
   245	      - **祖先链上有 symlink** (目录 symlink 指向 vault 外时, 其后代文件自身
   246	        is_symlink()==False, 只有整链 realpath 才能识破);
   247	      - 解析后越出 vault (含 `..` 穿越、dangling 指外)。
   248	    dangling 指内的文件 resolve 在内但读不了 → 由 `_read_text` 的 OSError 分支记盲区。
   249	    """
   250	    if path.is_symlink():
   251	        return "symlink"
   252	    try:
   253	        rel = path.relative_to(vault).as_posix()
   254	    except ValueError:
   255	        return "outside-vault"
   256	    if not cvr._resolves_inside_vault(vault, rel):
   257	        return "resolves-outside-vault"
   258	    return None
   259	
   260	
   261	def _read_text(path: Path) -> str | None:
   262	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。
   263	
   264	    ⛔ symlink 一律拒绝读 (Codex round-1 HIGH-1): 文件 symlink 会被 is_file() 接纳并
   265	    跟随到 vault 外 —— 外部内容里的 wikilink 能藏住真孤儿。指 vault 内的 symlink
   266	    同样拒读 (保守, 方向 = 报盲区不假绿)。祖先链/越界由 `_scan_block_reason` 在
   267	    调用方先行拦截并记盲区 —— 本函数只是最后一道。
   268	    """
   269	    if path.is_symlink():
   270	        return None
   271	    try:
   272	        return path.read_text(encoding="utf-8")
   273	    except (OSError, UnicodeDecodeError, ValueError):
   274	        return None
   275	
   276	
   277	def _split_frontmatter(text: str) -> tuple[str, str]:
   278	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   279	    m = _FRONTMATTER.match(text)
   280	    return (m.group(1), m.group(2)) if m else ("", text)
   281	
   282	
   283	def _fm_scalar(fm: str, key: str) -> str | None:
   284	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   285	
   286	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   287	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   288	    ⛔ YAML null 语义 (Codex round-1 MEDIUM-1b + round-2 MEDIUM-1): 只认**裸** null 字面
   289	    (null/Null/NULL/~), 且必须在剥引号**之前**判 —— `source_board: "null"` 是字面
   290	    字符串 "null" (YAML 引号 = 强制字符串), 不是 null。不含 "none": PyYAML 把
   291	    `none` 解析为普通字符串, 吞掉它 = 比 YAML 更宽 = 会误豁免真的叫 "none" 的值。
   292	    """
   293	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   294	    if not matches:
   295	        return None
   296	    v = matches[-1].strip()
   297	    if v in ("null", "Null", "NULL", "~"):
   298	        return None  # 裸 null 字面 (先于剥引号 —— 引号包裹的是字符串, 不是 null)
   299	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   300	        v = re.sub(r"\s+#.*$", "", v)
   301	    v = v.strip().strip('"').strip("'")
   302	    return v or None
   303	
   304	
   305	def _norm_key(name: str) -> str:
   306	    """入链匹配键: NFC 归一 + casefold。
   307	
   308	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   309	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   310	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   311	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   312	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   313	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   314	    (假阴)。该权衡进验收单「不比什么」表。
   315	    """
   316	    return unicodedata.normalize("NFC", name).casefold().strip()
   317	
   318	
   319	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   320	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   321	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   322	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   323	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   324	
   325	
   326	def _strip_code_spans(text: str) -> str:
   327	    """按 CommonMark 语义剥除 code span (Codex round-4 HIGH-2)。
   328	
   329	    ⛔ 不能用单条正则 `(`+)[^`]*\\1`: 反向引用能匹配**更长** closing run 的前缀, 且
   330	       `(`+)` 可回溯成较短 opener —— `` ``[[A]] ` foo`` `` 会被错拆成「空 span +
   331	       一个包住 ` foo` 的单反引号 span」, [[A]] 逃出剥除面 (Codex round-4 实测
   332	       stripped 里残留 [[A]])。CommonMark 规则: delimiter run 是**极大**的 (不可只取
   333	       run 的一部分), opener 之后的第一个**长度 ≥ opener** 的 run 才是 closer, 两者
   334	       同时消费。本函数按该算法扫 maximal run 配对。
   335	    """
   336	    runs = [(m.start(), m.end(), len(m.group())) for m in re.finditer(r"`+", text)]
   337	    consumed: list[tuple[int, int]] = []
   338	    i = 0
   339	    while i < len(runs):
   340	        j = i + 1
   341	        while j < len(runs) and runs[j][2] < runs[i][2]:
   342	            j += 1
   343	        if j < len(runs):
   344	            consumed.append((runs[i][0], runs[j][1]))
   345	            i = j + 1
   346	        else:
   347	            i += 1
   348	    out: list[str] = []
   349	    prev = 0
   350	    for s, e in consumed:
   351	        out.append(text[prev:s])
   352	        prev = e
   353	    out.append(text[prev:])
   354	    return "".join(out)
   355	
   356	
   357	def _strip_nonsemantic(body: str) -> str:
   358	    """剥离正文里**非语义**的 wikilink 载体 (Codex round-1 HIGH-2/HIGH-4 +
   359	    round-2 HIGH-4 整改)。
   360	
   361	    两段式 (round-2 教训: 行级剥 span 会把跨行 span 的**另一半**留在别行,
   362	    拼回后已无反引号对可配 —— 剥不到):
   363	      1. 行级状态机只管**按行判定的**结构: AUTO-GENERATED 哨兵段 (BEGIN→END 整段)
   364	         与 fenced code (CommonMark: closing fence 同字符且长度 ≥ opener ——
   365	         四反引号栏内的三反引号不关闭围栏), 命中行整行丢弃;
   366	      2. 拼回后文件级剥 code span (`+...`+ 可跨行) 与 HTML 注释
   367	         (<!-- --> 跨行; **未闭合**按 CommonMark 剥到 EOF)。
   368	
   369	    live 复算 (Codex round-1): 14 个节点的入链全部同时来自 source_board 与自动
   370	    成员块, 去掉 AUTO 后 3 个节点没有其他入链 —— 陈旧自动块绝不能豁免孤儿。
   371	
   372	    ⛔ 如实登记的剩余缝隙 (Codex round-2 HIGH-4 末项, 不处理): AUTO 段与围栏**交叉**
   373	    的对抗构造 (手改哨兵块再夹围栏) —— 真实生成器不产出此形态, 哨兵块明写"⛔ 请勿
   374	    手改", 解析按 AUTO 段优先; 该构造性前提登记进验收单「不比什么」。
   375	    """
   376	    out_lines: list[str] = []
   377	    fence_re: re.Pattern[str] | None = None  # closing fence 全文匹配 (同字符 ≥ opener 长)
   378	    in_auto = False
   379	    for line in body.splitlines():
   380	        stripped = line.strip()
   381	        if in_auto:
   382	            if _AUTO_END_RE.match(stripped):
   383	                in_auto = False
   384	            continue  # 哨兵段内整行丢弃 (含 BEGIN/END 行本身)
   385	        if _AUTO_BEGIN_RE.match(stripped):
   386	            in_auto = True
   387	            continue
   388	        if fence_re is not None:
   389	            if fence_re.fullmatch(stripped):
   390	                fence_re = None

