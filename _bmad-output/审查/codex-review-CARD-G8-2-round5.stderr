   405	def _wikilink_targets(body: str) -> set[str]:
   406	    """正文里全部 wikilink 的 basename 集合 (已归一)。先经 `_strip_nonsemantic`。
   407	
   408	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   409	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   410	    (`resolve_node_id`) —— 三者本就同规则。
   411	
   412	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   413	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   414	       `__pycache__` —— 一个只读审计器绝不该改被审对象。
   415	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   416	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   417	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   418	
   419	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   420	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写,
   421	    Codex round-1 MEDIUM-1a)。**不**覆盖: 围栏/行内 code、HTML 注释 (含 AUTO 哨兵块)、
   422	    跨行 `[[..]]`、空 `[[]]` —— 全部判定为非入链。
   423	    """
   424	    out: set[str] = set()
   425	    for raw in _WIKILINK.findall(_strip_nonsemantic(body)):
   426	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   427	        inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   428	        if inner:
   429	            out.add(_norm_key(inner))
   430	    return out

