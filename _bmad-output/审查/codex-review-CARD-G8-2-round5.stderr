   787	#: 检查注册表 —— name → (说明, 是否需要 today)
   788	CHECKS: dict[str, str] = {
   789	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   790	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
