   386	def test_orphan_symlink_never_read(tmp_path):
   387	    """Codex round-1 HIGH-1 + round-2 HIGH-1 三旁路: 文件 symlink / 源目录本身是
   388	    symlink / dangling symlink 都不能豁免真孤儿, 且全部显式记盲区。
   389	    判别锚 = **blind 原因** (blind_detail): 各层防线各有专属原因, 拆任何一层
   390	    都会让对应段红 —— 纵深防御不再吞掉判别力 (round-2 变异 M8/M12a/M12b
   391	    首跑 SURVIVED 的教训: 每段 fixture 都有另一层兜底 = 无判别)。"""
   392	    outside = tmp_path / "outside.md"
   393	    outside.write_text("- [[被链]]\n", encoding="utf-8")
   394	    root = tmp_path / "v"
   395	    _node(root, "被链")
   396	
   397	    # 旁路甲: 普通文件 symlink → vault 外 —— is_symlink 层在前, 原因必为 "symlink"
   398	    # (M12a 拆该层后 falls through 到越界层, 原因变 resolves-outside-vault → 本断言红)
   399	    link = root / "原白板" / "external.md"
   400	    link.parent.mkdir(parents=True)
   401	    link.symlink_to(outside)
   402	    res = vl.check_orphan_nodes(root)
   403	    subjects = [f.subject for f in res.findings]
   404	    assert "节点/被链.md" in subjects, f"vault 外 symlink 内容豁免了真孤儿: {res.findings}"
   405	    assert res.details["blind_detail"]["原白板/external.md"] == "symlink"
   406	    assert res.status == vl.WARN
   407	
   408	    # 旁路乙: **原白板 本身**是 symlink 指外 —— 实测 py3.14 rglob 不递归子目录
   409	    # symlink, 但 root.is_dir() 跟随, 以外部目录为根枚举出的文件自身非 symlink:
   410	    # 越界层是唯一防线 (round-2 HIGH-1 的原始形态)
   411	    outside_dir = tmp_path / "outside-dir"
   412	    outside_dir.mkdir()
   413	    (outside_dir / "external2.md").write_text("- [[被链]]\n", encoding="utf-8")
   414	    root2 = tmp_path / "v2"
   415	    _node(root2, "被链")
   416	    (root2 / "原白板").symlink_to(outside_dir, target_is_directory=True)
   417	    res2 = vl.check_orphan_nodes(root2)
   418	    subjects2 = [f.subject for f in res2.findings]
   419	    assert "节点/被链.md" in subjects2, f"源目录 symlink 后代豁免了真孤儿: {res2.findings}"
   420	    assert res2.details["blind_detail"]["原白板/external2.md"] == "resolves-outside-vault"
   421	
   422	    # 旁路丙: dangling symlink —— is_file()==False 不得静默消失
   423	    # (round-3 后由 _walk_md 枚举层先记, 原因带 cvr 的「既非目录也非普通文件」字样)
   424	    root3 = tmp_path / "v3"
   425	    _node(root3, "被链")
   426	    (root3 / "原白板").mkdir()
   427	    (root3 / "原白板" / "lost.md").symlink_to(tmp_path / "no-such-target.md")
   428	    res3 = vl.check_orphan_nodes(root3)
   429	    assert "节点/被链.md" in [f.subject for f in res3.findings]
   430	    assert "原白板/lost.md" in res3.details["blind_detail"], f"dangling 必须显式可见: {res3.details['blind_detail']}"
