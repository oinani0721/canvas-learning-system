   795	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   796	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   797	    if not vault.is_dir():
   798	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   799	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   800	    checks: list[CheckResult] = []
   801	    for name in selected:
   802	        if name == "orphan_nodes":
   803	            checks.append(check_orphan_nodes(vault))
   804	        elif name == "raw_derived_confusion":
   805	            checks.append(check_raw_derived(vault))
   806	        elif name == "projection_freshness":
   807	            checks.append(check_projection_freshness(vault, today))
   808	    return LintReport(
   809	        vault=str(vault),
   810	        today=today.isoformat(),
   811	        checks=checks,
   812	        skipped=[n for n in CHECKS if n not in selected],
   813	    )
