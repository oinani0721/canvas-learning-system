   461	# ---------------------------------------------------------------------------
   462	# 检查 1 — orphan_nodes
   463	# ---------------------------------------------------------------------------
   464	def check_orphan_nodes(vault: Path) -> CheckResult:
   465	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   466	
   467	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   468	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   469	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   470	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   471	
   472	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   473	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   474	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   475	
   476	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   477	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   478	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   479	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   480	    """
   481	    node_root = vault / NODE_DIR
   482	    notes: list[str] = []
   483	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   484	
   485	    if not node_root.is_dir():
   486	        return CheckResult(
   487	            name="orphan_nodes",
   488	            status=FAIL,
   489	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   490	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   491	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   492	            details={"nodes_scanned": 0, "inbound_targets": 0},
   493	        )
   494	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   495	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   496	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   497	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   498	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   499	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   500	    inbound: dict[str, set[str]] = {}
   501	    nodes: list[Path] = []
   502	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   503	        srcs, src_blind = _walk_md(vault / src_dir)
   504	        for rel, why in src_blind.items():
   505	            blind[f"{src_dir}/{rel}"] = why
   506	        if src_dir == NODE_DIR:
   507	            nodes = srcs
   508	        for src in srcs:
   509	            blocked = _scan_block_reason(vault, src)
   510	            if blocked:
   511	                blind[src.relative_to(vault).as_posix()] = blocked
   512	                continue
   513	            text = _read_text(src)
   514	            if text is None:
   515	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   516	                continue
   517	            _fm, body = _split_frontmatter(text)
   518	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   519	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   520	            src_phys = os.path.realpath(src)
   521	            for target in _wikilink_targets(body):
   522	                inbound.setdefault(target, set()).add(src_phys)
   523	
   524	    findings: list[Finding] = []
   525	    for node in nodes:
   526	        own = node.relative_to(vault).as_posix()
   527	        blocked = _scan_block_reason(vault, node)
   528	        if blocked:
   529	            blind[own] = blocked
   530	            continue
   531	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   532	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   533	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   534	        #    realpath 归并, 不得绕过自身排除。
   535	        own_phys = os.path.realpath(node)
   536	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   537	        if sources:
   538	            continue
   539	        text = _read_text(node)
   540	        if text is None:
   541	            blind[own] = "unreadable"
   542	            continue
   543	        fm, _body = _split_frontmatter(text)
   544	        if _fm_scalar(fm, "source_board"):
   545	            continue
   546	        findings.append(
   547	            Finding(
   548	                own,
   549	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   550	                f"(自身出链不计), 且 frontmatter 无 source_board",
   551	            )
   552	        )
   553	
   554	    if blind:
   555	        notes.append(
   556	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   557	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   558	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   559	        )
   560	    notes.append(
   561	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   562	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   563	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   564	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   565	    )
   566	    status = WARN if (findings or blind) else OK
   567	    return CheckResult(
   568	        name="orphan_nodes",
   569	        status=status,
   570	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   571	        findings=findings,
   572	        notes=notes,
   573	        details={
   574	            "nodes_scanned": len(nodes),
   575	            "inbound_targets": len(inbound),
   576	            "blind_spots": len(blind),
   577	            "blind_detail": dict(sorted(blind.items())),
   578	        },
   579	    )
   580	
   581	
   582	# ---------------------------------------------------------------------------
   583	# 检查 2 — raw_derived_confusion
   584	# ---------------------------------------------------------------------------
   585	def check_raw_derived(vault: Path) -> CheckResult:
   586	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   587	
   588	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   589	
   590	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   591	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   592	      G2 未登记根级文件    同上, 根级面
   593	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   594	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   595	                          正是"raw-derived 混淆"的机械定义
   596	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   597	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   598	
   599	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   600	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   601	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   602	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   603	                 **本次未验证**, 报告逐次声明
   604	
   605	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   606	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。
   607	    """
   608	    try:
   609	        data = cvr.load_rules()
   610	    except cvr.ConfigError as exc:
   611	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   612	    try:
   613	        res = cvr.scan(data, vault, with_probe=False)
   614	    except cvr.ConfigError as exc:
   615	        raise LintConfigError(str(exc)) from exc
   616	
   617	    findings = [
   618	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   619	        for fd in res.findings
   620	        if fd.code in CONFUSION_CODES and fd.blocking
   621	    ]
   622	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   623	
   624	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   625	    recap_bad = 0
   626	    recap_blind: dict[str, str] = {}
   627	    for md in _iter_md(vault):
   628	        if not md.name.startswith(RECAP_PREFIX):
   629	            continue
   630	        # ⛔ 与 orphan 同一条边界守卫 (Codex round-2 HIGH-1 第三旁路):
   631	        #    指向 vault 外的 回顾-* symlink 会被 read_frontmatter_type 跟随读取 ——
   632	        #    先拦截记盲区, 不读不判 (越界细节由 G8-1 的 G10/G11 判红)。
   633	        blocked = _scan_block_reason(vault, md)
   634	        if blocked:
   635	            recap_blind[md.relative_to(vault).as_posix()] = blocked
   636	            continue
   637	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   638	        ftype = cvr.read_frontmatter_type(md, parser=None)
   639	        if ftype != "recap":
   640	            recap_bad += 1
   641	            findings.append(
   642	                Finding(
   643	                    md.relative_to(vault).as_posix(),
   644	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   645	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   646	                )
   647	            )
   648	    notes: list[str] = [
   649	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   650	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   651	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   652	    ]
   653	    if recap_blind:
   654	        notes.append(
   655	            "recap 扫描盲区 (未读未判): " + ", ".join(f"{rel}[{why}]" for rel, why in sorted(recap_blind.items())[:5])
   656	        )
   657	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   658	    if blind:
   659	        notes.append(
   660	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   661	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   662	        )
   663	    if exempted:
   664	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   665	    for msg in res.info:
   666	        notes.append(f"台账扫描 info: {msg}")
   667	
   668	    return CheckResult(
   669	        name="raw_derived_confusion",
   670	        # ⛔ 盲区 ≥ warn (Codex round-3 H1c + round-4 HIGH-1): 盲区 = recap 拒读对象
   671	        #    (recap_blind) **或** G8/G10/G11 扫描面问题 (blind) —— 两者任一在场,
   672	        #    "0 混淆" 都是 "没查全" 而非 "没问题"。r4 曾只修 recap 特例漏掉 blind。
   673	        status=WARN if (findings or recap_blind or blind) else OK,
   674	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   675	        findings=findings,
   676	        notes=notes,
   677	        details={
   678	            "files_seen": res.files_seen,
   679	            "dirs_seen": res.dirs_seen,
   680	            "codes_counted": list(CONFUSION_CODES),
   681	            "recap_missing_type": recap_bad,
   682	            "recap_blind": dict(sorted(recap_blind.items())),
   683	            "blind_spots": len(blind),
   684	            "probe_skipped": res.probe_skipped,
   685	        },
   686	    )
