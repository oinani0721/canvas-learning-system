   873	class _LintArgumentParser(argparse.ArgumentParser):
   874	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   875	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   876	
   877	    def error(self, message: str):  # type: ignore[override]
   878	        self.print_usage(sys.stderr)
   879	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   880	        raise SystemExit(EXIT_CONFIG)
   881	
   882	
   883	def main(argv: list[str] | None = None) -> int:
   884	    ap = _LintArgumentParser(
   885	        prog="vault_lint.py",
   886	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   887	        epilog=_EPILOG,
   888	        formatter_class=argparse.RawDescriptionHelpFormatter,
   889	    )
   890	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   891	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   892	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   893	    ap.add_argument(
