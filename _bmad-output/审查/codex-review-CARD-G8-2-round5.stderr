   721	def test_json_findings_match_text_findings(tmp_path):
   722	    root = tmp_path / "v"
   723	    _node(root, "孤儿甲")
   724	    _node(root, "孤儿乙")
   725	    _projection(root, "2026-08-31T09:05:05+08:00")
   726	    text = _run_cli(root, "--now", NOW_ARG).stdout
   727	    payload = json.loads(_run_cli(root, "--now", NOW_ARG, "--json").stdout)
   728	    orphans = next(c for c in payload["checks"] if c["name"] == "orphan_nodes")
   729	    assert {f["subject"] for f in orphans["findings"]} == {"节点/孤儿甲.md", "节点/孤儿乙.md"}
   730	    for f in orphans["findings"]:
   731	        assert f["subject"] in text, "JSON finding 必须也出现在文本渲染里"
