   737	def test_only_skips_explicitly(tmp_path):
   738	    root = _clean_vault(tmp_path / "v")
   739	    report = vl.run_checks(root, TODAY, only=["orphan_nodes"])
   740	    assert [c.name for c in report.checks] == ["orphan_nodes"]
   741	    assert report.skipped == ["raw_derived_confusion", "projection_freshness"]
   742	    assert vl.exit_code(report) == 0  # skipped 不参与聚合
   743	
   744	    r = _run_cli(root, "--now", NOW_ARG, "--only", "orphan_nodes", "--json")
   745	    payload = json.loads(r.stdout)
   746	    assert payload["summary"]["checks_run"] == ["orphan_nodes"]
   747	    assert payload["summary"]["checks_skipped"] == ["raw_derived_confusion", "projection_freshness"]
   748	
   749	    # --only 场景的同源门: 文本的 status=skipped 行 ↔ JSON checks_skipped 逐项相等
   750	    text = _run_cli(root, "--now", NOW_ARG, "--only", "orphan_nodes").stdout
   751	    text_rows = dict(_TEXT_STATUS_RE.findall(text))
   752	    assert set(text_rows) == set(payload["summary"]["checks_run"]) | set(payload["summary"]["checks_skipped"]), (
   753	        f"文本检查行集合与 JSON 不一致: text={sorted(text_rows)}"
   754	    )
   755	    for name in payload["summary"]["checks_skipped"]:
   756	        assert text_rows[name] == "skipped", f"{name} 在文本里必须是 skipped, 实为 {text_rows[name]}"
