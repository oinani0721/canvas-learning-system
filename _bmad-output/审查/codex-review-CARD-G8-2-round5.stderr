   689	# ---------------------------------------------------------------------------
   690	# 检查 3 — projection_freshness
   691	# ---------------------------------------------------------------------------
   692	def _is_stale(generated_at: Any, today: date) -> bool:
   693	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   694	
   695	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   696	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   697	    都按 stale 降级, 绝不逃逸成异常。
   698	    """
   699	    stale = True
   700	    try:
   701	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   702	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   703	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   704	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   705	        stale = True
   706	    return stale
   707	
   708	
   709	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   710	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   711	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。
   712	
   713	    ⛔ corrupt 面**比 oracle 窄**, 如实声明: oracle 在 stale 判定之前还要过
   714	       `_summarize()` 的严格 v3 形状门禁 (schema_version==3 / 五个容器形状 /
   715	       boards·buckets 对账 / 非有限数拒收…), 任何不符即 corrupt。本函数**不复制**
   716	       那几百行 (复制必漂, 且 W6 独占该文件), 只覆盖四类:
   717	       读不出 / 不是 JSON object / 缺 generated_at 键 / generated_at 非字符串
   718	       (最后这类的同语义是实测钉的: int 20260831 → oracle=corrupt, 不是 stale)。
   719	       故同源锁只在**合法 v3 投影**上成立; 其余形状垃圾面两侧可能分歧
   720	       (oracle=corrupt, 本函数可能=stale/ok) —— 验收单「不比什么」表登记。

