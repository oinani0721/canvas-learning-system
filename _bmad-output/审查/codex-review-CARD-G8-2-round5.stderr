   897	        default=None,
   898	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   899	    )
   900	    args = ap.parse_args(argv)
   901	
   902	    try:
   903	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   904	    except LintConfigError as exc:
   905	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   906	        return EXIT_CONFIG
   907	
   908	    if args.json:
   909	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   910	    else:
   911	        print(render_text(report, color=sys.stdout.isatty()))
   912	    return exit_code(report)
