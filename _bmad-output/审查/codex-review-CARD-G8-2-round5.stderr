   687	def test_today_resolution_is_shanghai_not_host_local():
   688	    # UTC 2026-08-31T23:00Z = 上海 2026-09-01 07:00 —— 上海日已翻篇
   689	    assert vl.resolve_today("2026-08-31T23:00:00Z") == date(2026, 9, 1)
   690	    # 无时区输入按上海解释 (不引入第二种默认)
   691	    assert vl.resolve_today("2026-08-31") == date(2026, 8, 31)
   692	    assert vl.resolve_today("2026-08-31T12:00:00+08:00") == date(2026, 8, 31)
   693	    with pytest.raises(vl.LintConfigError):
   694	        vl.resolve_today("garbage")
