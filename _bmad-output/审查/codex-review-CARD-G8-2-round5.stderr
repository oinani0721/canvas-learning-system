   816	def _utcnow() -> datetime:
   817	    """时钟缝 (Codex round-1 MEDIUM-2): 唯一的取当前时刻处, 测试 patch 它来锁
   818	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   819	    return datetime.now(timezone.utc)
