   751	def check_projection_freshness(vault: Path, today: date) -> CheckResult:
   752	    """`outputs/今日复习.json` 的 generated_at 是否是上海本地的今日。
   753	
   754	    状态分级 (**待用户裁决**):
   755	      ok            → ok
   756	      stale         → warn  (只是今天还没跑推送, 不是坏)
   757	      no_projection → warn  (该 vault 从没跑过推送 —— 新 vault 的正常初态)
   758	      corrupt       → fail  (投影文件坏了, 下游 Web UI / 推送会拿不到数据 = 真故障)
   759	    """
   760	    status, error, gen = _projection_status(vault, today)
   761	    mapped = {"ok": OK, "stale": WARN, "no_projection": WARN, "corrupt": FAIL}[status]
   762	    detail = {
   763	        "ok": f"generated_at={gen!r} 是 {today} 的投影",
   764	        "stale": f"generated_at={gen!r} 不是 {today} ({_DISPLAY_TZ_NAME}) 的投影",
   765	        "no_projection": f"{'/'.join(_PROJECTION_REL)} 不存在 —— 该 vault 尚未跑过推送",
   766	        "corrupt": f"投影不可用: {error}",
   767	    }[status]
   768	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   769	    return CheckResult(
   770	        name="projection_freshness",
   771	        status=mapped,
   772	        summary=f"projection_status={status}",
   773	        findings=findings,
   774	        notes=[
   775	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   776	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   777	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   778	            "只判 读不出/非 object/缺 generated_at",
   779	        ],
   780	        details={"projection_status": status, "generated_at": gen, "error": error},
   781	    )
