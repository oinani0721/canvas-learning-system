   138	# 报告数据结构 —— 文本与 JSON 的**唯一**真相源
   139	# ---------------------------------------------------------------------------
   140	@dataclass(frozen=True)
   141	class Finding:
   142	    subject: str  #: 出问题的 vault 相对路径 / 主体
   143	    detail: str
   144	
   145	
   146	@dataclass
   147	class CheckResult:
   148	    """单个检查的结论。
   149	
   150	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   151	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   152	    """
   153	
   154	    name: str
   155	    status: str  #: ok | warn | fail
   156	    summary: str
   157	    findings: list[Finding] = field(default_factory=list)
   158	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   159	    notes: list[str] = field(default_factory=list)
   160	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   161	    details: dict[str, Any] = field(default_factory=dict)
   162	
   163	
   164	@dataclass
   165	class LintReport:
