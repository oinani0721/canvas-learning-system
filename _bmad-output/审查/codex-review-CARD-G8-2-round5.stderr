   822	def resolve_today(now: str | None) -> date:
   823	    """`--now` → 上海本地日。
   824	
   825	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   826	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   827	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   828	    """
   829	    if now is None:
   830	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   831	    try:
   832	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   833	    except ValueError as exc:
   834	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   835	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   836	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   837	    try:
   838	        return dt.astimezone(_TZ_SHANGHAI).date()
   839	    except (OverflowError, OSError) as exc:
   840	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
