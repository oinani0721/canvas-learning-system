   433	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   434	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   435	
   436	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   437	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   438	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   439	    文件级检查), 再补两层本检查需要的:
   440	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   441	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   442	    """
   443	    if not root.is_dir():
   444	        return [], {}
   445	    blind: dict[str, str] = {}
   446	    dirs, files, cvr_blind = cvr._walk_vault(root)
   447	    for rel, why in cvr_blind:
   448	        blind[rel] = f"枚举盲区: {why}"
   449	    for d in dirs:
   450	        if d.is_symlink():
   451	            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
   452	    mds = sorted(f for f in files if f.suffix.lower() == ".md")
   453	    return mds, blind
   454	
   455	
   456	def _iter_md(root: Path) -> list[Path]:
   457	    """`_walk_md` 的只取文件面 (盲区面请用 `_walk_md`)。"""
   458	    return _walk_md(root)[0]
