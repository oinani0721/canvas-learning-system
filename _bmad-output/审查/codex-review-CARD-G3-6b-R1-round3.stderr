   179	def b4_factor_key_uniqueness(picker):
   180	    """(b)-4 因子唯一性：重复末级 board = 「sha 变而排序不变」。
   181	
   182	    判定要点：这是**误报方向**（指纹过度敏感），不是漏网方向。安全性质
   183	    「规则变⟹sha变」不受影响。故契约应写成单向保证；本探针实测该性质的
   184	    实际方向，供契约措辞取据。
   185	    """
   186	    nodes = [node("A板", "A", 0.9), node("B板", "B", 0.1)]
   187	    base_order = order_of(picker, nodes)
   188	    base_sha = sha_of(picker)
   189	    orig = picker.TIE_FACTOR_KEYS
   190	    try:
   191	        picker.TIE_FACTOR_KEYS = orig + ("board",)  # 追加重复末级
   192	        dup_order = order_of(picker, nodes)
   193	        dup_sha = sha_of(picker)
   194	    finally:
   195	        picker.TIE_FACTOR_KEYS = orig
   196	    check(
   197	        "(b)-4 重复键的实际方向 = sha 变而排序不变（误报方向，非漏网）",
   198	        dup_order == base_order and dup_sha != base_sha,
   199	        f"序 {base_order}→{dup_order}（不变={dup_order == base_order}） "
   200	        f"sha {base_sha[:12]}…→{dup_sha[:12]}…（变={dup_sha != base_sha}）",
   201	    )
   202	    keys = orig
   203	    check(
   204	        "(b)-4 现常量本身唯一且 board 恒末位",
   205	        len(set(keys)) == len(keys) and keys[-1] == "board",
   206	        f"TIE_FACTOR_KEYS={keys}",
   207	    )
   208	
