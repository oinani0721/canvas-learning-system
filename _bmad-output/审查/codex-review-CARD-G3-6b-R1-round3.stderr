   100	def sha(p: Path) -> str:
   101	    return hashlib.sha256(p.read_bytes()).hexdigest()
   102	
   103	
   104	def run_gate(testfile: str, gate: str) -> tuple[int, str]:
   105	    """跑**精确 nodeid**（不是 -k 子串），返回 (rc, stdout+stderr 尾部)。"""
   106	    nodeid = f"{testfile}::{gate}"
   107	    r = subprocess.run(
   108	        [".venv/bin/pytest", nodeid, "-q", "-p", "no:cacheprovider", "--no-header"],
   109	        cwd=LANE / "backend", capture_output=True, text=True,
   110	        env={"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "PYTHONDONTWRITEBYTECODE": "1",
   111	             "HOME": str(Path.home()), "LANG": "en_US.UTF-8"},
   112	    )
   113	    tail = ((r.stdout or "")[-400:] + " ||STDERR|| " + (r.stderr or "")[-300:])
   114	    return r.returncode, tail.strip().replace("\n", " | ")
   115	
   116	
   117	def _install_restore_handlers(originals: dict) -> None:
   118	    """SIGINT/SIGTERM 时也还原（finally 覆盖不到信号中断）。
   119	
   120	    如实声明：SIGKILL / 解释器硬崩仍会留下变异字节 —— 这不是 EXIT trap 的
   121	    等价物，最终判据始终是脚本末尾的逐字节比对。
   122	    """
   123	    def _restore(signum, _frame):
   124	        for path, raw in originals.items():
   125	            try:
   126	                path.write_bytes(raw)
   127	            except OSError:
   128	                pass
   129	        print(f"\n⚠ 收到信号 {signum}，已尝试还原全部目标文件", file=sys.stderr)
   130	        sys.exit(130)
   131	
   132	    for sig in (signal.SIGINT, signal.SIGTERM):
   133	        signal.signal(sig, _restore)
   134	
   135	
   136	def main() -> int:
   137	    _install_restore_handlers({PICK: PICK.read_bytes(), OVERVIEW: OVERVIEW.read_bytes()})
   138	    baseline = {PICK: sha(PICK), OVERVIEW: sha(OVERVIEW)}
   139	    print("变异前基线 sha256:")
   140	    for p, s in baseline.items():
   141	        print(f"  {p.name}: {s}")
   142	
   143	    # 先确认每道指定门在未变异状态下是绿的（否则"红"证明不了是变异造成的）
   144	    print("\n── 阶段 0：确认 8 道指定门在原样代码下全绿（红的来源必须可归因）──")
   145	    for tag, _desc, _f, _o, _n, tf, gate in MUTATIONS:
   146	        rc, tail = run_gate(tf, gate)
   147	        status = "绿" if rc == 0 else f"⛔ rc={rc}"
   148	        print(f"  {tag} {gate}: {status}")
   149	        if rc != 0:
   150	            print(f"      {tail}")
   151	            print("  ⛔ 前置不成立，中止（无法归因）")
   152	            return 2
   153	
   154	    results = []
   155	    print("\n── 阶段 1：8 条变异，严格串行 ──")
   156	    for tag, desc, target, old, new, tf, gate in MUTATIONS:
   157	        raw = target.read_bytes()
   158	        src = raw.decode("utf-8")
   159	        hits = src.count(old)
   160	        if hits != 1:
   161	            results.append((tag, "INVALID", f"锚点命中 {hits} 次（应为 1）— 死变异", ""))
   162	            print(f"[{tag}] INVALID 锚点命中 {hits} 次")
   163	            continue
   164	        try:
   165	            target.write_text(src.replace(old, new, 1), encoding="utf-8")
   166	            assert sha(target) != baseline[target], "变异未真正落盘"
   167	            rc, tail = run_gate(tf, gate)
   168	        finally:
   169	            target.write_bytes(raw)  # EXIT trap 等价物：无条件还原
   170	            restored = sha(target)
   171	            assert restored == baseline[target], f"{tag} 还原后字节不一致！{restored}"
   172	
   173	        if rc == 1:
   174	            # R1 round-2 收窄: rc=1 只证明「这个 nodeid 失败了」，**不能**单凭
   175	            # 退出码证明是哪条断言失败 —— 所以红时也把 failure tail 归档下来。
   176	            verdict, note = "✅ 红", "rc=1（该 nodeid 失败；具体断言见下方 tail）"
   177	        elif rc == 0:
   178	            verdict, note = "空转", "rc=0 指定门未变红 —— 门不承重"
   179	        else:
   180	            verdict, note = "INVALID", (
   181	                f"rc={rc} —— pytest 2=中断/3=内部错/4=用法错/5=未收集到，"
   182	                "都不是「门抓住了变异」")
   183	        results.append((tag, verdict, note, desc))
   184	        print(f"[{tag}] {verdict:6s} {gate}  ({note})")
   185	        print(f"        变异: {desc}")
   186	        # 红/非红都归档 pytest 尾部：红时用来确认失败的是**预期的那条断言**
   187	        print(f"        pytest: {tail[:360]}")
   188	
   189	    print("\n── 阶段 2：还原后逐字节校验 ──")
   190	    ok_bytes = True
   191	    for p, s in baseline.items():
   192	        now = sha(p)
   193	        same = now == s
   194	        ok_bytes &= same
   195	        print(f"  {p.name}: {'逐字节一致 ✅' if same else f'⛔ 漂移 {now}'}")
   196	
   197	    killed = sum(1 for _t, v, _n, _d in results if v == "✅ 红")
   198	    print(f"\n{'=' * 60}\n变异结果: {killed}/{len(MUTATIONS)} 条各杀其指定门；还原完整性: "
   199	          f"{'PASS' if ok_bytes else 'FAIL'}")
   200	    for tag, v, note, _d in results:
   201	        if v != "✅ 红":
   202	            print(f"  ⛔ {tag}: {v} — {note}")
   203	    return 0 if (killed == len(MUTATIONS) and ok_bytes) else 1
   204	
   205	
   206	if __name__ == "__main__":
   207	    sys.exit(main())
