   645	    翻转而 rank sha 恒为 503fd4b6…, 全程纯源码演进、无 .pyc 参与):
   646	
   647	    1. 摘的**只是本文件 (daily_review_pick.py) 的字节**, 加上
   648	       effective_rank_config 里**明列的那几项生效值** (因子序 / 取整精度 /
   649	       上限 / 分钟 / decay 六常量)。改本文件 (精度/绑定/方向/新因子, 乃至
   650	       一个注释) 必变 sha。粒度是「本文件实现 + 明列系数」, 不是「全部排序
   651	       相关实现」。
   652	    2. **排序还依赖本文件之外的实现, 那部分不在指纹内**: pick 值由 vault 内
   653	       decay_beta.py 的 effective() / pick_score() **函数体**算出 (调用点见
   654	       scan_nodes 内 `decay.effective` / `decay.pick_score`)。该文件的**六个
   655	       常量**在指纹内 (改常量必变 sha, 且 recorded 会打漂移告警), 但它的
   656	       **函数体不在** —— 改函数体可让排序变而本 sha 纹丝不动。decay_beta.py
   657	       本体归 CARD-G6-1b、本卡禁改, 故此处只**如实登记**这个缺口, 不扩指纹。
   658	    3. **单向保证**: 「本文件或明列系数变 ⟹ sha 变」。逆命题不成立, 且是刻意
   659	       放弃的 —— 摘全文件使指纹对注释也敏感; 追加重复因子键同样「sha 变而
   660	       排序不变」(Codex round-2 LOW 的实测方向)。不可拿 sha 变没变去推断
   661	       「改了什么」, 它只证明「本文件或明列系数变了」。
   662	    4. **不覆盖运行时字节码**: 绕过 .py 直接执行被改的 __pycache__/*.pyc
   663	       (伪造 mtime 使 Python 取旧 pyc) 可让排序变而本 sha 不变 —— round-3
   664	       已实测复现。该面**本卡未评估**, 按威胁模型排除; 本函数**不宣称运行时
   665	       完整性** (见验收单「本卡未证明什么」第 4 条)。
   666	    """
   667	    p = Path(path) if path is not None else Path(__file__).resolve()
   668	    return hashlib.sha256(p.read_bytes()).hexdigest()
   669	
   670	
   671	def effective_rank_config(decay, version, minutes: dict) -> dict:
   672	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   673	
   674	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   675	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   676	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   677	    该变), 上限与因子序/取整精度取代码常量, 分钟取 manifest 生效值,
   678	    implementation_sha256 摘本文件字节 (round-2 HIGH: 取值绑定无法全部
   679	    数据化, 由实现指纹兜住「改**源文件**规则而指纹不动」—— 其单向性与
   680	    不覆盖运行时 .pyc 的边界见 _implementation_sha 的四条声明)。
   681	    """
   682	    return {
   683	        "version": version,
   684	        "ranking_factors": list(TIE_FACTOR_KEYS),
   685	        "tie_pick_round_digits": int(TIE_PICK_ROUND_DIGITS),
   686	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   687	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   688	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   689	        "implementation_sha256": _implementation_sha(),
   690	    }
   691	
   692	
   693	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   694	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   695	    effective = effective_rank_config(decay, version, minutes)
   696	    _warn_recorded_drift(recorded, effective)
   697	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   698	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   699	
   700	
   701	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   702	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   703	
   704	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   705	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   706	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   707	    """
   708	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   709	    overdue_days = None
   710	    if scheduled:
   711	        earliest_sh = _sh_local(min(scheduled))
   712	        if earliest_sh is not None:
   713	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   714	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   715	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   716	
   717	    rec = board_last_recommended.get(board, "")
   718	    gap = None
   719	    if rec:
   720	        try:
   721	            # 不夹负值 (Codex round-1 MEDIUM): 记录晚于今天属异常状态, 如实
   722	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   723	            # 「今天刚推荐过」, 违反 S4 不虚构。
   724	            gap = (today_sh - date.fromisoformat(rec)).days
   725	        except (ValueError, TypeError):
   726	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   727	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   728	            gap = None
   729	    return {
   730	        "due_total": len(due),
   731	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   732	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   733	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   734	        "overdue_days": overdue_days,
   735	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   736	        "never_recommended": not rec,
   737	        "recommend_gap_days": gap,
   738	    }
   739	
   740	
   740	
   741	def why_this_board(f: dict) -> str:
   742	    """S4 模板: factors → 恒非空人话串。纯函数 — 同一 factors 恒得同一句。
   743	
   744	    契约测试把落盘的 factors 原样喂回本函数, 要求与落盘的 why_this_board
   745	    逐字相同 —— 解释与数字之间没有第二条通路 (没有 LLM, 没有渲染层再算)。
   746	    """
   747	    scale = f"{int(f['due_total'])} 个节点到期"
   748	    if f["due_new"]:
   749	        scale += f"（其中 {int(f['due_new'])} 张新卡）"
   750	    parts = [scale]
   751	    if f["due_scheduled"]:
   752	        od = f["overdue_days"]
   753	        if od is None:
   754	            parts.append("最早到期时刻超出可显示范围")
   755	        elif od > 0:
   756	            parts.append(f"最早的已逾期 {int(od)} 天")
   757	        else:
   758	            parts.append("最早的今天到期")
   759	    if f["due_malformed"]:
   760	        parts.append(f"含 {int(f['due_malformed'])} 个到期时间无法解析的节点")
   761	    parts.append("最该考的从未考察" if f["idle_days"] is None
   762	                 else f"最该考的已闲置 {int(f['idle_days'])} 天")
   763	    if f["never_recommended"]:
   764	        parts.append("这块板从未被推荐过")
   765	    elif f["recommend_gap_days"] is None:
   766	        parts.append("上次推荐日期无法解析")
   767	    elif f["recommend_gap_days"] < 0:
   768	        # 记录晚于今天 (时钟回拨/时区错乱/手滑改了 state) — 如实说异常,
   769	        # 不 clamp 成 0 伪装成"今天刚推荐过" (Codex round-1 MEDIUM)
   770	        parts.append("上次推荐日期晚于今天")
   771	    elif f["recommend_gap_days"] == 0:
   772	        parts.append("今天已推荐过")
   773	    else:
   774	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   775	    return " · ".join(parts)
   776	
   777	
   778	def estimated_minutes(f: dict, minutes: dict) -> int:
   779	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   780	
   781	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   782	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   783	    """
   784	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   785	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
   786	
   787	
   788	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   789	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   790	
   791	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   792	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   793	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   794	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   795	    """
   796	    minutes = minutes or DEFAULT_MINUTES
   797	    today_sh = _today_sh(now)
   798	    boards: dict[str, list] = {}
   799	    unassigned = []
   800	    for n in nodes:
   801	        if not n["board"]:
   802	            unassigned.append(n["node"])
   803	            continue
   804	        boards.setdefault(n["board"], []).append(n)
   805	
   806	    ranked, upcoming = [], []
   807	    for board, members in boards.items():
   808	        due = [n for n in members if n["due_now"]]
   809	        if not due:
   810	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   811	            nxt = min(members, key=lambda n: n["fsrs_due"])
   812	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   813	            continue
   814	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   815	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   816	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   817	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   818	        tie_parts = {
   819	            "priority_pick": round(top["pick"], TIE_PICK_ROUND_DIGITS),
   820	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   821	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   822	            "board": board,
   823	        }
   824	        ranked.append({
   825	            "board": board,
   826	            "top_node": top["node"],
   827	            "priority": round(top["pick"], 4),
   828	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   829	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   830	            "difficulty": top["difficulty"],
   831	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   832	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   833	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   834	            "why_this_board": why_this_board(factors),
   835	            "estimated_minutes": estimated_minutes(factors, minutes),
   836	            "factors": factors,
   837	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   838	        })
   839	    ranked.sort(key=lambda r: r["_tie"])
   840	    for r in ranked:
   841	        del r["_tie"]
   842	    upcoming.sort(key=lambda u: u["next_due"])
   843	    return ranked, upcoming, unassigned
   844	
   845	
   846	def _title(board: str) -> str:
   847	    prefix = "📚 今日复习 · "
   848	    room = TITLE_LIMIT - len(prefix)
   849	    return prefix + (board if len(board) <= room else board[: room - 1] + "…")
   850	
   851	
   852	def _body(top: dict) -> str:
   853	    idle = "从未考察" if top["idle_days"] is None else f"已闲置 {top['idle_days']} 天"
   854	    if top["pending"] >= 2:
   855	        return f"{top['top_node']} 等 {top['pending']} 节点待巩固 · {idle}"
   856	    return f"{top['top_node']} 待巩固 · {idle}"
   857	
   858	
   859	def build_payload(vault: Path, now: datetime, board_last_recommended: dict, decay,
   860	                  manifest_path=None):
   861	    """CARD-G3-6b: 新增可选 manifest_path (缺省 = 本脚本同目录的系数清单)。
   862	
   863	    runner 侧调用形态不变 (daily_review_run:159-160 传四个位置参数) —— 新
   864	    参数是加性关键字, 消费面零变化。
   865	    """
   866	    version, minutes, recorded = load_rank_manifest(manifest_path)
   867	    rank_manifest = build_rank_manifest(decay, version, minutes, recorded)
   868	    nodes, stats, ineligible, placeholder_boards = scan_nodes(vault, now, decay)
   869	    ranked, upcoming, unassigned = rank_boards(nodes, board_last_recommended, now, minutes)
   870	    stats["unassigned"] = len(unassigned)
   871	    # CARD-G3-6a S1: 级联判桶 + why_due 一次算好, due_nodes 行与 buckets 分组
   872	    # 同源引用同一对值 (禁两处各算一遍 → 禁口径分裂)。划分域 = 已归板。
   873	    for n in nodes:
   874	        if n["board"]:
   875	            n["bucket"], n["why_due"] = assign_bucket(n, now)
   876	    # v3 (CARD-A2): due_nodes 明细与 stats 数字同源派生 — 自洽靠构造保证,
   877	    # 本投影是全系统到期口径唯一裁判 (Dashboard 只消费不重算)
   878	    due_rows = [
   879	        {
   880	            "node": n["node"],
   881	            "board": n["board"],
   882	            "state": n["state"],
   883	            "pick": round(n["pick"], 4),
   884	            "fsrs_due": n["fsrs_due"],           # 空串 = 新卡即刻到期
   885	            # Codex-A2 M1: 消费方须能区分真新卡与 fail-open 的脏日期卡
   886	            "due_reason": ("malformed" if n["due_fail_open"]
   887	                           else ("scheduled" if n["fsrs_due"] else "new")),
   888	            "last_examined": n["last_examined"],
   889	            "difficulty": n["difficulty"],
   890	            # CARD-G3-6a 加性 (S2 加标签不搬移): 行仍在 due_nodes 内, 只多两
   891	            # 个字段 — 到期三桶之一 + 人话理由。旧字段一个不改。
   892	            "bucket": n["bucket"],
   893	            "why_due": n["why_due"],
   894	            # CARD-G3-6b 加性 (裁决②, 承 G3-6a 移交 #2): 结构化闲置天数 ——
   895	            # 与 why_due 的闲置片段同源同值 (都出自 scan_nodes 的 idle_days),
   896	            # 下游要按闲置排序时不必再从人话串里抠数字。None = 从未考察。
   897	            "idle_days": (None if n["idle_days"] is None else int(n["idle_days"])),
   898	        }
   899	        for n in nodes if n["board"] and n["due_now"]
   900	    ]
   901	    stats["due_nodes"] = len(due_rows)
   902	    stats["future_nodes"] = sum(1 for n in nodes if n["board"] and not n["due_now"])
   903	    # CARD-D1 P1 (BATCH-2026-08-27): 顶层加性 boards 全量 rollup — 补
   904	    # top_boards/upcoming 各截 [:3] 与 placeholder 板级无归属的结构性缺口。
   905	    # schema_version 保持 3; ineligible.placeholder 扁平列表 / notification /
   906	    # top_boards / upcoming 零改动 (A2 冻结)。due 计数与 due_rows 同源分组,
   907	    # 合计恒等 stats.due_nodes。
   908	    members_by_board: dict[str, list] = {}
   909	    for n in nodes:
   910	        if n["board"]:
   911	            members_by_board.setdefault(n["board"], []).append(n)
   912	    boards_rollup = []
   913	    for board in sorted(set(members_by_board) | set(placeholder_boards)):
   914	        members = members_by_board.get(board, [])
   915	        due = [n for n in members if n["due_now"]]
   916	        future = [n for n in members if not n["due_now"]]
   917	        boards_rollup.append({
   918	            "board": board,
   919	            "due": len(due),
   920	            # 三分语义与 due_rows.due_reason 同一判据: new=真新卡 /
   921	            # scheduled=已排期 / malformed=due-new-scheduled 隐含
   922	            "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   923	            "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   924	            "future": len(future),
   925	            "next_due": min((n["fsrs_due"] for n in future), default=""),
   926	            "placeholder": placeholder_boards.get(board, 0),
   927	            "earliest_overdue": min((n["fsrs_due"] for n in due if n["fsrs_due"]), default=""),
   928	        })
   929	    # CARD-G3-6a 加性: 顶层 buckets 五桶节点级分组 — 划分的权威表达。
   930	    # 五键恒在 (空 vault 亦为五个空数组, 与 ineligible 同风格, 消费方不做
   930	    # 五键恒在 (空 vault 亦为五个空数组, 与 ineligible 同风格, 消费方不做
   931	    # 存在性分支); 桶内按扫描序 (= due_nodes 行序) 稳定。行只带消费方渲染
   932	    # 队列必需的四字段: 到期三桶与 due_nodes 同源, due_today/future 是
   933	    # due_nodes 结构上装不下的那两桶 (它们不到期, 搬进去就违反 S2)。
   934	    buckets: dict[str, list] = {b: [] for b in BUCKET_ORDER}
   935	    for n in nodes:
   936	        if not n["board"]:
   937	            continue
   938	        buckets[n["bucket"]].append({
   939	            "node": n["node"],
   940	            "board": n["board"],
   941	            "why_due": n["why_due"],
   942	            "fsrs_due": n["fsrs_due"],
   943	        })
   944	    payload = {
   945	        "unassigned_nodes": unassigned,  # Code-Review M3: 点名而非只给数字
   946	        "schema_version": 3,             # v3: +due_nodes 明细 +ineligible 分桶
   947	        #                                  (纯加性; v2: FSRS WHEN 化 upcoming/due 语义)
   948	        # CARD-C1a: 顶层加性新增 — send 侧据此组合 per-vault 有效通知 id,
   949	        # C2 总览页据此标卡片; notification.id 值与其余字段零改动 (A2 冻结)
   950	        "vault_id": Path(vault).resolve().name,
   951	        "date": now.astimezone().date().isoformat(),
   952	        "generated_at": now.astimezone().isoformat(timespec="seconds"),
   953	        # CARD-G3-6b: 字面量 3 换成具名常量 —— 值恒等 (行为零变化), 但让
   954	        # truncated 的判据与截断本身同源, 不给"上限改了一处漏一处"留缝
   955	        "top_boards": ranked[:TOP_BOARDS_LIMIT],
   956	        "upcoming": upcoming[:UPCOMING_LIMIT],
   957	        "due_nodes": due_rows,
   958	        "boards": boards_rollup,  # CARD-D1 P1 加性: 板级全量 rollup
   959	        "buckets": buckets,       # CARD-G3-6a 加性: 五桶节点级分组 (S1 划分)
   960	        "ineligible": ineligible,
   961	        "stats": stats,
   962	        "notification": None,
