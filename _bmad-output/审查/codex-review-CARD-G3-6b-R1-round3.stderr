   317	def _fm_num(fm: str, key: str):
   318	    # 容负号 (Code-Review L5): mastery_a: -3 应进 corrupt 分支而非静默当无字段
   319	    m = re.search(rf'^{key}:\s*"?(-?[0-9]*\.?[0-9]+)"?\s*$', fm, re.M)
   320	    return float(m.group(1)) if m else None
