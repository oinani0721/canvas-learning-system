   109	def b2_authoritative_three_layers(picker, tmp: Path):
   110	    """(b)-2 authoritative 三层缺失/null/错型必须点名回落，不许静默。
   111	
   112	    round-2 MEDIUM 的原漏网：{"version":1} / {"version":1,"authoritative":{}} /
   113	    estimated_minutes:null 三种形状都静默返回默认且 stderr 为空。
   114	    """
   115	    import contextlib
   116	    import io
   117	
   118	    D = dict(picker.DEFAULT_MINUTES)
   119	    # (label, 文档, 期望的**精确**回落值, 告警里必须点名的关键词)
   120	    # R1 轮 Codex MEDIUM：原版只断言「stderr 非空」，把回落值和告警内容都放过了
   121	    # —— 实现即便回落成错误的数字、或打一条不点名的告警，探针照样 PASS。
   122	    cases = [
   123	        ("父节整个缺失", {"version": 1}, D, ["authoritative", "内置默认"]),
   124	        ("父节为空 object", {"version": 1, "authoritative": {}}, D,
   125	         ["estimated_minutes", "内置默认"]),
   126	        ("父节为 null", {"version": 1, "authoritative": None}, D,
   127	         ["authoritative", "内置默认"]),
   128	        ("子节为 null", {"version": 1, "authoritative": {"estimated_minutes": None}}, D,
   129	         ["estimated_minutes", "内置默认"]),
   130	        ("子节错型(list)", {"version": 1, "authoritative": {"estimated_minutes": []}}, D,
   131	         ["estimated_minutes", "内置默认"]),
   132	        ("半份叶键", {"version": 1, "authoritative": {"estimated_minutes": {"per_due_node": 7}}},
   133	         {"per_due_node": 7, "per_new_node": D["per_new_node"]}, ["per_new_node"]),
   134	    ]
   135	    for label, doc, want_minutes, want_words in cases:
   136	        f = tmp / f"m_{abs(hash(label))}.json"
   137	        f.write_text(json.dumps(doc), encoding="utf-8")
   138	        buf = io.StringIO()
   139	        with contextlib.redirect_stderr(buf):
   140	            version, minutes, _ = picker.load_rank_manifest(f)
   141	        err = buf.getvalue()
   142	        missing = [w for w in want_words if w not in err]
   143	        ok = (minutes == want_minutes) and (version == 1) and not missing
   144	        check(
   145	            f"(b)-2 {label} → 回落值精确 + 告警点名",
   146	            ok,
   147	            f"minutes={minutes}（期望 {want_minutes}）version={version!r} "
   148	            f"告警缺词={missing or '无'} stderr={err.strip()[:110]!r}",
   149	        )
   150	
