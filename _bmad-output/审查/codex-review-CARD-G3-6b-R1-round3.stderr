    78	
    79	    o8 = order_of(picker, nodes, blr)
    80	    s8 = sha_of(picker)
    81	    orig = picker.TIE_PICK_ROUND_DIGITS
    82	    try:
    83	        picker.TIE_PICK_ROUND_DIGITS = 7
    84	        o7 = order_of(picker, nodes, blr)
    85	        s7 = sha_of(picker)
    86	    finally:
    87	        picker.TIE_PICK_ROUND_DIGITS = orig
    88	
    89	    order_changed = o8 != o7
    90	    sha_changed = s8 != s7
    91	    check(
    92	        "(b)-1 精度收紧 → 排序变",
    93	        order_changed,
    94	        f"digits=8 序={o8} / digits=7 序={o7}（近邻 pick {lo} vs {hi}）",
    95	    )
    96	    check(
    97	        "(b)-1 精度收紧 → sha 同变（round-2 HIGH 的原漏网面）",
    98	        sha_changed,
    99	        f"sha8={s8[:16]}… sha7={s7[:16]}…",
   100	    )
   101	    check(
   102	        "(b)-1 精度常量已登记进被摘要对象",
   103	        picker.effective_rank_config(FAKE_DECAY, 1, dict(picker.DEFAULT_MINUTES))
   104	        .get("tie_pick_round_digits") == 8,
   105	        f"effective_rank_config.tie_pick_round_digits={picker.effective_rank_config(FAKE_DECAY, 1, dict(picker.DEFAULT_MINUTES)).get('tie_pick_round_digits')!r}",
   106	    )
