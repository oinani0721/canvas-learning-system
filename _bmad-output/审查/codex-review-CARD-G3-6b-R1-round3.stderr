   210	def b5_value_binding_swap_is_caught(picker, tmp: Path):
   211	    """(b)-附 取值绑定交换（无法数据化的字面代码）是否被 implementation_sha 兜住。
   212	
   213	    round-2 HIGH 的第二个攻击面：不动 TIE_FACTOR_KEYS 的顺序，改 tie_parts
   214	    里各键**对应的表达式**（交换 blr 与 min_last 的取值）→ 排序规则变了。
   215	    模拟正常源码演进：改副本字节 → 看排序与 sha 是否同变。
   216	    """
   217	    src = PICK.read_text(encoding="utf-8")
   218	    old = '"board_last_recommended": board_last_recommended.get(board, ""),'
   219	    new_pair_a = '"board_last_recommended": min(n["last_examined"] for n in due),'
   220	    old2 = '"min_last_examined": min(n["last_examined"] for n in due),'
   221	    new_pair_b = '"min_last_examined": board_last_recommended.get(board, ""),'
   222	    if old not in src or old2 not in src:
   223	        check("(b)-附 取值绑定交换", False, "锚点未命中，探针失效（源码已变）")
   224	        return
   225	    mutated = src.replace(old, new_pair_a, 1).replace(old2, new_pair_b, 1)
   226	
   227	    d = tmp / "swap"
   228	    d.mkdir()
   229	    p = d / "daily_review_pick.py"
   230	    p.write_text(mutated, encoding="utf-8")
   231	    swapped = load_from(p, "picker_swapped")
   232	
   233	    # 构造 pick 平局、blr 与 min_last 优劣相反的输入
   234	    nodes = [
   235	        node("A板", "A", 0.2, last="2026-07-20T01:00:00Z"),  # min_last 更老
   236	        node("B板", "B", 0.2, last="2026-07-28T01:00:00Z"),
   237	    ]
   238	    blr = {"A板": "2026-07-29"}  # A 有记录（排后），B 无记录（空串排前）
   239	    o_base = order_of(picker, nodes, blr)
   240	    o_swap = order_of(swapped, nodes, blr)
   241	    # R1 轮 Codex MEDIUM：原版只比裸 _implementation_sha()，没证明它真的接进了
   242	    # 最终对外的 rank_manifest.sha256 —— 实现即便把 impl_sha 算出来却不放进
   243	    # 摘要对象（或放进去后被覆盖成常量），原探针照样 PASS。
   244	    s_base_impl, s_swap_impl = picker._implementation_sha(), swapped._implementation_sha()
   245	    s_base_rank, s_swap_rank = sha_of(picker), sha_of(swapped)
   246	    cfg_base = picker.effective_rank_config(FAKE_DECAY, 1, dict(picker.DEFAULT_MINUTES))
   247	    check(
   248	        "(b)-附 交换取值绑定 → 排序规则确实改变",
   249	        o_base != o_swap,
   250	        f"原序={o_base} 交换后={o_swap}",
   251	    )
   252	    check(
   253	        "(b)-附 交换取值绑定 → 裸 implementation_sha256 同变",
   254	        s_base_impl != s_swap_impl,
   255	        f"impl_sha {s_base_impl[:16]}… → {s_swap_impl[:16]}…",
   256	    )
   257	    check(
   258	        "(b)-附 impl_sha 真的接入最终 rank_manifest.sha256（不只是算了不用）",
   259	        s_base_rank != s_swap_rank
   260	        and cfg_base.get("implementation_sha256") == s_base_impl,
   261	        f"rank sha {s_base_rank[:16]}… → {s_swap_rank[:16]}…；"
   262	        f"cfg.implementation_sha256 与裸值一致="
   263	        f"{cfg_base.get('implementation_sha256') == s_base_impl}",
   264	    )
   265	
