+    "recorded 反过来控制截断": (
+        '        "top_boards": ranked[:TOP_BOARDS_LIMIT],',
+        '        "top_boards": ranked[:(recorded.get("limits", {}).get("top_boards") or TOP_BOARDS_LIMIT)],',
+    ),
 }
 
