  1064	def atomic_write(path: Path, content: str):
  1065	    """同目录 tmp → os.replace 原子发布 (CARD-G6-1: tmp 名唯一化)。
  1066	
  1067	    旧实现用固定名 `<原名>.tmp`: 两个写者并发时共享同一个 tmp —— 各自按
  1068	    自己的 offset 落盘, 内容交错, 总长等于较长那份 (wc -c 看不出), 随后
  1069	    双方 os.replace 发布的是同一个拼接损坏物。宿主 launchd runner ×
  1070	    后端 refresh 端点恰好是这个形态; VirtioFS 上文件锁行为不可证, 底线
  1071	    只能押在「每个写者有独占的 tmp + 单次 rename 发布」上。
  1072	
  1073	    tmp 名仍以 `<原名>.` 开头 (今日复习.json.<pid>.<8hex>.tmp): 与 outputs/
  1074	    今日复习.* 同前缀, 不给「只写 今日复习.*」的写面审计新增可见面; 且
  1075	    `.tmp` 后缀让 outputs/*.md 一类的 glob 不会误吃它。异常路径清残渣 ——
  1076	    落盘失败时留一个半截 tmp 在 vault 里, 同样是写面污染。
  1077	    """
  1078	    tmp = path.with_name(f"{path.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp")
  1079	    # O_EXCL | O_NOFOLLOW (CARD-G6-1 round-3): pid+随机后缀已经让撞名几乎不可能,
  1080	    # 但"几乎"不是保证 —— O_EXCL 让撞名直接 FileExistsError 而不是两个写者
  1081	    # 又共享同一个 tmp; O_NOFOLLOW 让"tmp 名被抢先建成一条指向库外的软链"
  1082	    # 这条路失败而不是把内容写到库外 (普通 open 会跟随软链并 truncate)。
  1083	    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
  1084	    try:
  1085	        with os.fdopen(fd, "w", encoding="utf-8") as f:
  1086	            f.write(content)
  1087	        os.replace(tmp, path)
  1088	    except BaseException:
  1089	        try:
  1090	            tmp.unlink()
  1091	        except OSError:
  1092	            pass
  1093	        raise
  1094	
