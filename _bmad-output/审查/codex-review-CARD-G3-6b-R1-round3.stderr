   267	def mk_min_vault(tmp: Path, name: str, nodes: dict) -> Path:
   268	    """带 decay_beta 的最小 vault —— 与生产 scan_nodes 读的是同一种目录形态。"""
   269	    import shutil
   270	
   271	    vault = tmp / name
   272	    (vault / ".claude" / "scripts").mkdir(parents=True)
   273	    (vault / "节点").mkdir()
   274	    shutil.copy(LANE / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py",
   275	                vault / ".claude" / "scripts")
   276	    for stem, content in nodes.items():
   277	        (vault / "节点" / f"{stem}.md").write_text(content, encoding="utf-8")
   278	    return vault
   279	
   280	
   281	def md_node(board="普通板", extra="") -> str:
   282	    return f'---\ntype: concept\nsource_board: "[[原白板/{board}]]"\n{extra}---\n真实内容。\n'
   283	
   284	
   285	def b6_manifest_authoritative_takes_effect(picker, tmp: Path):
   286	    """(b)-附 authoritative「可改生效」/ recorded「只登记告警」——走生产入口。
   287	
   288	    R1 轮 Codex MEDIUM：原版两条都只验了中间层（loader 的返回值、告警文字），
   289	    没有走 build_payload —— 实现即便把 minutes 读出来却不往 payload 里传，
   290	    或者 recorded 打完告警就用登记值覆盖实际值，原探针照样 PASS。
   291	    """
   292	    import contextlib
   293	    import io
   294	
   295	    vault = mk_min_vault(tmp, "prod_entry", {
   296	        "甲": md_node(board="甲板"),                                   # 新卡
   297	        "乙": md_node(board="甲板", extra="fsrs_due: 2026-07-01T01:00:00Z\n"),  # 已排期到期
   298	    })
   299	    decay = picker.load_decay(vault)
   300	
   301	    mf = tmp / "auth_effective.json"
   302	    mf.write_text(json.dumps({
   303	        "version": 9,
   304	        "authoritative": {"estimated_minutes": {"per_due_node": 11, "per_new_node": 13}},
   305	    }), encoding="utf-8")
   306	
   307	    version, minutes, _ = picker.load_rank_manifest(mf)
   308	    check(
   309	        "(b)-附 loader 层：authoritative 分钟读出正确",
   310	        version == 9 and minutes == {"per_due_node": 11, "per_new_node": 13},
   311	        f"version={version} minutes={minutes}",
   312	    )
   313	
   314	    # ── 生产入口：build_payload 落盘的 estimated_minutes 必须按 manifest 算
   315	    payload, _ranked = picker.build_payload(vault, NOW, {}, decay, manifest_path=mf)
   316	    tb = payload["top_boards"][0]
   317	    f = tb["factors"]
   318	    want = f["due_new"] * 13 + (f["due_total"] - f["due_new"]) * 11
   319	    check(
   320	        "(b)-附 生产入口：build_payload 落盘的分钟真按 manifest 算（不是只读不用）",
   321	        tb["estimated_minutes"] == want and payload["rank_manifest"]["version"] == 9,
   322	        f"落盘 estimated_minutes={tb['estimated_minutes']}（期望 {want}；"
   323	        f"due_total={f['due_total']} due_new={f['due_new']} 用 11/13）"
   324	        f" rank_manifest.version={payload['rank_manifest']['version']}",
   325	    )
   326	
   327	    # R1 round-2 Codex MEDIUM：上一条只绑了「实际分钟」，没绑「摘要用的那组分钟」——
   328	    # 把 build_payload 里喂给 build_rank_manifest 的 minutes 换成 DEFAULT_MINUTES 而
   329	    # 实际分钟仍用 11/13，探针照样全绿：payload 说 24 分钟，指纹却是 3/5 那份的。
   330	    # 修法：独立复算「用 11/13 的 effective_rank_config」的 sha，要求它 (a) 等于
   331	    # payload 落盘的 rank sha，(b) 不等于用默认分钟算出来的 sha。
   332	    def _sha_of_cfg(mins: dict) -> str:
   333	        cfg = picker.effective_rank_config(decay, 9, mins)
   334	        blob = json.dumps(cfg, sort_keys=True, ensure_ascii=False, allow_nan=False)
   335	        return hashlib.sha256(blob.encode("utf-8")).hexdigest()
   336	
   337	    sha_actual = _sha_of_cfg({"per_due_node": 11, "per_new_node": 13})
   338	    sha_default = _sha_of_cfg(dict(picker.DEFAULT_MINUTES))
   339	    check(
   340	        "(b)-附 落盘的 rank sha 与**实际生效的那组分钟**同源（不是默认分钟的摘要）",
   341	        payload["rank_manifest"]["sha256"] == sha_actual != sha_default,
   342	        f"payload.rank sha={payload['rank_manifest']['sha256'][:16]}… "
   343	        f"用 11/13 复算={sha_actual[:16]}…（应相等）"
   344	        f" 用默认 3/5 复算={sha_default[:16]}…（应不等）",
   345	    )
   346	
   347	    # ── recorded 漂移：既要出声，更要**行为以实际为准**
   348	    mf2 = tmp / "recorded_drift.json"
   349	    mf2.write_text(json.dumps({
   350	        "version": 1,
   351	        "authoritative": {"estimated_minutes": {"per_due_node": 3, "per_new_node": 5}},
   352	        "recorded": {"limits": {"top_boards": 999, "upcoming": 999},
   353	                     "ranking_factors": {"order": ["board", "priority_pick"]}},
   354	    }), encoding="utf-8")
   355	    _, m2, rec2 = picker.load_rank_manifest(mf2)
   356	    buf = io.StringIO()
   357	    with contextlib.redirect_stderr(buf):
   358	        cfg = picker.effective_rank_config(decay, 1, m2)
   359	        picker.build_rank_manifest(decay, 1, m2, rec2)
   360	    err = buf.getvalue()
   361	    behaviour_wins = (
   362	        cfg["limits"] == {"top_boards": picker.TOP_BOARDS_LIMIT,
   363	                          "upcoming": picker.UPCOMING_LIMIT}
   364	        and cfg["ranking_factors"] == list(picker.TIE_FACTOR_KEYS)
   365	    )
   366	    check(
   367	        "(b)-附 recorded 漂移 → 出声告警",
   368	        "recorded.limits" in err and "999" in err,
   369	        f"stderr={err.strip()[:140]!r}",
   370	    )
   371	    check(
   372	        "(b)-附 recorded 漂移 → **行为**以实际为准（登记值没被拿去用）",
   373	        behaviour_wins,
   374	        f"生效 limits={cfg['limits']}（登记谎称 999）"
   375	        f" 生效 factors={cfg['ranking_factors']}（登记谎称 ['board','priority_pick']）",
   376	    )
   377	
   378	    # R1 round-2 Codex MEDIUM：上一条只看不接收 recorded 的中间对象。让
   379	    # recorded.limits.top_boards 真去控制截断后，探针照样全绿而四板入口输出
   380	    # top_boards=4（代码常量是 3）。修法：**仅 recorded 不同**的两份 manifest
   381	    # 各走一次四板生产入口，要求整份 payload 逐字相同、榜长精确为 3。
   382	    v4 = mk_min_vault(tmp, "four_boards", {
   383	        f"n{i}": md_node(board=f"{ch}板") for i, ch in enumerate("甲乙丙丁")
   384	    })
   385	    d4 = picker.load_decay(v4)
   386	    honest = tmp / "rec_honest.json"
   387	    honest.write_text(json.dumps({
   388	        "version": 1,
   389	        "authoritative": {"estimated_minutes": {"per_due_node": 3, "per_new_node": 5}},
   390	        "recorded": {"limits": {"top_boards": 3, "upcoming": 3}},
   391	    }), encoding="utf-8")
   392	    lying = tmp / "rec_lying.json"
   393	    lying.write_text(json.dumps({
   394	        "version": 1,
   395	        "authoritative": {"estimated_minutes": {"per_due_node": 3, "per_new_node": 5}},
   396	        "recorded": {"limits": {"top_boards": 99, "upcoming": 99},
   397	                     "ranking_factors": {"order": ["board"]}},
   398	    }), encoding="utf-8")
   399	    with contextlib.redirect_stderr(io.StringIO()):
   400	        pay_h, rk_h = picker.build_payload(v4, NOW, {}, d4, manifest_path=honest)
   401	        pay_l, rk_l = picker.build_payload(v4, NOW, {}, d4, manifest_path=lying)
   402	    check(
   403	        "(b)-附 生产入口：仅 recorded 不同 → 整份 payload 逐字相同、榜长恒为 3",
   404	        pay_h == pay_l
   405	        and len(pay_h["top_boards"]) == picker.TOP_BOARDS_LIMIT == 3
   406	        and len(rk_h) == len(rk_l) == 4,
   407	        f"payload 相同={pay_h == pay_l} 榜长={len(pay_h['top_boards'])}（谎称 99）"
   408	        f" ranked 总数={len(rk_h)}（四板全在，截断只作用于榜）"
   409	        f" 板序={[b['board'] for b in pay_h['top_boards']]}",
   410	    )
   411	
   412	
   413	def main() -> int:
   414	    sys.path.insert(0, str(LANE / "scripts"))
   415	    picker = load_from(PICK, "picker_under_test")
   416	    print(f"复核对象: {PICK}")
   417	    print(f"源码 sha256: {hashlib.sha256(PICK.read_bytes()).hexdigest()}")
   418	    print(f"manifest sha256: {hashlib.sha256(MANIFEST.read_bytes()).hexdigest()}\n")
   419	
   420	    with tempfile.TemporaryDirectory() as td:
   421	        tmp = Path(td)
   422	        b1_precision_is_versioned(picker)
   423	        b2_authoritative_three_layers(picker, tmp)
   424	        b3_golden_bears_weight(picker)
   425	        b4_factor_key_uniqueness(picker)
   426	        b5_value_binding_swap_is_caught(picker, tmp)
   427	        b6_manifest_authoritative_takes_effect(picker, tmp)
   428	
   429	    passed = sum(1 for _, ok, _ in RESULTS if ok)
   430	    total = len(RESULTS)
   431	    print(f"\n{'=' * 60}\n复核结果: {passed}/{total} PASS")
   432	    for name, ok, _ in RESULTS:
   433	        if not ok:
   434	            print(f"  ⛔ FAIL: {name}")
   435	    return 0 if passed == total else 1
   436	
   437	
   438	if __name__ == "__main__":
   439	    raise SystemExit(main())

