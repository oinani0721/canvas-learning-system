   152	def b3_golden_bears_weight(picker):
   153	    """(b)-3 金样锁承重：删掉首因子后板序必须翻转。
   154	
   155	    round-2 MEDIUM 的原缺陷：低 pick 恰在字典序更早的 A板 → 删 pick 因子后
   156	    序不变，门空转。修法是把低 pick 放到字典序更晚的板。
   157	    """
   158	    # 低 pick 在字典序更晚的 B板 → 默认 B 先；删首因子后按板名 A 先
   159	    nodes = [node("A板", "A", 0.9), node("B板", "B", 0.1)]
   160	    default = order_of(picker, nodes)
   161	    orig = picker.TIE_FACTOR_KEYS
   162	    try:
   163	        picker.TIE_FACTOR_KEYS = ("board_last_recommended", "min_last_examined", "board")
   164	        without = order_of(picker, nodes)
   165	    finally:
   166	        picker.TIE_FACTOR_KEYS = orig
   167	    check(
   168	        "(b)-3 pick 级承重：默认低 pick 先（B 板字典序更晚，排除板名碰巧决定）",
   169	        default == ["B板", "A板"],
   170	        f"默认序={default}",
   171	    )
   172	    check(
   173	        "(b)-3 pick 级承重：删首因子后按板名翻转（门不空转）",
   174	        without == ["A板", "B板"] and without != default,
   175	        f"删 priority_pick 后序={without}",
   176	    )
   177	
