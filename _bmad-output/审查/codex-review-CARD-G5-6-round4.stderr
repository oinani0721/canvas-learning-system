  1178	def test_url_without_host_is_not_primary_record(tmp_path):
  1179	    """⛔ H1 回归: `https://:443/x`、`https://user@/x` 没有 host —— 能过纯正则,
  1180	    但 `urlsplit(...).hostname` 为空, 不构成「一手来源」的机械证据。"""
  1181	    vault, out = base_vault(tmp_path)
  1182	    inbox = vault / "_待处理"
  1183	    mk(
  1184	        inbox / "空host端口.md",
  1185	        "---\nsource: https://:443/x\n---\n\n正文甲一。\n正文甲二。\n",
  1186	        age_days=4,
  1187	    )
  1188	    mk(
  1189	        inbox / "空host用户.md",
  1190	        "---\nsource: https://user@/x\n---\n\n正文乙一。\n正文乙二。\n",
  1191	        age_days=3,
  1192	    )
  1193	    # 正向对照: 带端口/查询/锚点的正常 URL 仍是一手来源
  1194	    mk(
  1195	        inbox / "带端口正常.md",
  1196	        "---\nsource: https://example.com:8443/a?b=c#d\n---\n\n正文丙一。\n正文丙二。\n",
  1197	        age_days=2,
  1198	    )
  1199	
  1200	    assert run_cli(vault, out).returncode == 0
  1201	    data = load_json(out)
  1202	    for name in ("空host端口.md", "空host用户.md"):
  1203	        it = item_by_name(data, name)
  1204	        assert it["criterion"] != "C1_source_url", name
  1205	        assert it["nomination_type"] != "primary-record", name
  1206	    pos = item_by_name(data, "带端口正常.md")
  1207	    assert pos["criterion"] == "C1_source_url"
  1208	    assert pos["nomination_type"] == "primary-record"
