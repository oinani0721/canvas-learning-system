   159	
   160	def run_gate(gate: str) -> subprocess.CompletedProcess:
   161	    return subprocess.run(
   162	        [
   163	            str(WT / "backend/.venv/bin/pytest"),
   164	            f"{TESTFILE}::{gate}",
   165	            "-q",
   166	            "-p",
   167	            "no:cacheprovider",
   168	        ],
   169	        cwd=WT / "backend",
   170	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   171	        capture_output=True,
   172	        text=True,
   173	    )
   174	
   175	
   176	def main() -> int:
   177	    pristine = SCRIPT.read_bytes()
   178	    BACKUP.write_bytes(pristine)
   179	    results = []
   180	    ok = True
   181	    for name, old, new, gate in MUTATIONS:
   182	        content = SCRIPT.read_text(encoding="utf-8")
   183	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   184	        mutated = content.replace(old, new, 1)
   185	        if name.startswith("M5"):
   186	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   187	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   188	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   189	            mutated = mutated.replace(looks_old, looks_rev, 1)
   190	        assert mutated != content, f"{name}: 替换后内容未变化"
   191	        SCRIPT.write_text(mutated, encoding="utf-8")
   192	        try:
   193	            r = run_gate(gate)
   194	            out = r.stdout + r.stderr
   195	            failed_marker = f"FAILED {TESTFILE}::{gate}"
   196	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   197	            results.append((name, gate, r.returncode, killed))
   198	            if not killed:
   199	                ok = False
   200	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   201	                print(out[-1500:])
   202	        finally:
   203	            SCRIPT.write_bytes(pristine)
   204	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   205	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   206	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   207	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
   208	    print()
   209	    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
   210	          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
   211	    return 0 if ok else 1
   212	
   213	
   214	if __name__ == "__main__":
   215	    sys.exit(main())

