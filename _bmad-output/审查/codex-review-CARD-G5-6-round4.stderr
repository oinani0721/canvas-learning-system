   693	# ───────────────────────────── 扫描 ─────────────────────────────
   694	
   695	
   696	def read_text_or_none(p: Path) -> str | None:
   697	    try:
   698	        return p.read_bytes().decode("utf-8")
   699	    except (OSError, UnicodeDecodeError):
   700	        return None
   820	                "C3_empty_or_skeleton",
   821	                V_DELETE,
   822	                None,
   823	                None,
   824	                "0 字节空文件",
   825	                True,
   826	                conflicts=conflicts,
   827	            )
   828	        return _fill(
   829	            item,
   830	            "C6_undecided",
   831	            V_UNSURE,
   832	            None,
   833	            None,
   834	            "非 UTF-8 文本，本引擎不解析其正文",
   835	            False,
   836	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
   837	            ask=UNDECIDED_ASK,
   838	            conflicts=conflicts,
   839	        )
   840	
   841	    fm_lines = split_frontmatter(text)[0]
   842	    fm = frontmatter_map(fm_lines)
   843	    typed_rows, unclosed_comment = _classify_lines_typed(text)
   844	    del typed_rows
   845	    substantive = has_substantive_content(text)
   846	    body = dup_body(text) if substantive else ""
   847	    rnd = round_of(name)
   848	    # C3 护栏信号（显式偏差 15）：frontmatter 里「看着像键但不被键正则认」的行。
   849	    unparsed_fm = [
   850	        ln.strip()
   851	        for ln in fm_lines
   852	        if ln.strip() and not ln.strip().startswith("#") and not _FM_KEY_RE.match(ln)
   853	    ]
   854	
   855	    # ── 后置证据（不参与次序，但必须全量呈现） ──
   856	    exact_all = sorted(dup_index.get(body, [])) if body else []
   857	    exact_of = exact_all[0] if exact_all else None
   858	    exact_others = exact_all[1:]
   859	    near = near_duplicates(body, corpus_bodies, scan)
   860	    within_batch = bool(body) and batch_body_counts.get(body, 0) > 1
   861	    if within_batch:
   862	        conflicts.append(
   863	            {
   864	                "kind": "duplicate_within_batch",
   865	                "detail": "本批内另有正文逐字相同的材料 —— 谁是正本在只读侧不可判，"
   866	                "故不产出建议删，请你指定保留哪一份",
   867	            }
   868	        )
   869	
   870	    def finish(criterion, verdict, ntype, target, basis, confident, **kw):
   871	        if exact_of and criterion != "C4_exact_duplicate":
   872	            conflicts.append(
   873	                {
   874	                    "kind": "exact_duplicate_under_other_verdict",
