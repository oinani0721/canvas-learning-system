  1496	    fm = mod.frontmatter_map(["created: 2026-01-01T00:00:00+08:00"])
  1497	    assert fm["created"] == "2026-01-01T00:00:00+08:00", "值里的冒号不得截断值"
  1498	    fm = mod.frontmatter_map(["title : x"])
