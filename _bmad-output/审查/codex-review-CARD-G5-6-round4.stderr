  1326	def test_frontmatter_span_requires_key_then_space_or_eol():
  1327	    """⛔ H3 回归(纯函数): YAML 映射键必须是 `key:` 后接空白或行尾;
  1328	    `https://example.com` 的 `https:` 不满足 → span 必须为 0。"""
  1329	    mod = load_module()
  1330	    bad = "---\nhttps://example.com\n---\n\n正文。\n".splitlines()
  1331	    assert mod.frontmatter_span(bad) == 0
  1332	    good = "---\ntags:\n---\n\n正文。\n".splitlines()
  1333	    assert mod.frontmatter_span(good) == 3
