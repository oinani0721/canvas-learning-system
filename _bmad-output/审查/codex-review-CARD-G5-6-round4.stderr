  1298	    assert "AI 生成" not in mod.AI_MARKERS
  1299	    assert "AI生成" not in mod.AI_MARKERS
  1300	    assert "本文由 AI" not in mod.AI_MARKERS
  1301	    assert "本报告由 AI" not in mod.AI_MARKERS
