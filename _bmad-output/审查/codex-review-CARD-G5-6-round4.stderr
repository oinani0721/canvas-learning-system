   688	
   689	
   690	def test_no_bytecode_cache_written_into_vault_skills(tmp_path):
   691	    """⛔ 零写侧的第一现场（Codex 审查实证）: importlib 加载兄弟模块默认会在
   692	    **board-split 目录**里写 `__pycache__/*.pyc` —— 既是往 vault 落文件, 也是
   693	    伸手进另一条车道的地盘。
   694	
   695	    (d) tmp 隔离重构 (CARD-G5-6b): 不再 rmtree checkout 里的 `__pycache__`
   696	    (裁判不该动被测 checkout 的任何目录项), 改为把两个脚本按**同一相对布局**
   697	    拷进 tmp (SCRIPT 的 `_SP_PATH` 由 `__file__` 推导, 布局一致副本才能定位
   698	    它自己的 split_preview 副本), 在副本上跑 CLI 与 importlib 加载, 断言副本树
   699	    下零 `__pycache__`。副本 sha256 必须等于 checkout 原件 —— 否则门测的是副本
   700	    不是被测物。CLI 子进程**显式剥掉 PYTHONDONTWRITEBYTECODE**: 裁判命令带着
   701	    它跑时, 子进程继承该变量会让 SCRIPT 内部的 dont_write_bytecode 保护永远
   702	    不被考验(门空转); 在副本树上剥掉它, 内部保护成为唯一防线, 删掉保护当场
   703	    在副本树留下缓存 → 门变红。
   704	    """
   705	    skills_copy = tmp_path / "skills"
   706	    for src in (SCRIPT, SPLIT_SCRIPT):
   707	        dst = skills_copy / src.relative_to(SKILLS)
   708	        dst.parent.mkdir(parents=True, exist_ok=True)
   709	        shutil.copy2(src, dst)
   710	        assert hashlib.sha256(dst.read_bytes()).hexdigest() == hashlib.sha256(src.read_bytes()).hexdigest(), (
   711	            f"副本与 checkout 原件不一致: {src}"
   712	        )
   713	    script_copy = skills_copy / SCRIPT.relative_to(SKILLS)
   714	
   715	    vault, out = base_vault(tmp_path)
   716	    env = {k: v for k, v in os.environ.items() if k != "PYTHONDONTWRITEBYTECODE"}
   717	    r = subprocess.run(
   718	        [
   719	            sys.executable,
   720	            str(script_copy),
   721	            "--vault",
   722	            str(vault),
   723	            "--out-dir",
   724	            str(out),
   725	            "--now",
   726	            NOW_ISO,
   727	        ],
   728	        capture_output=True,
   729	        text=True,
   730	        env=env,
   731	    )
   732	    assert r.returncode == 0, r.stderr[-300:]
   733	
   734	    spec = importlib.util.spec_from_file_location("inbox_preview_tmpcopy", script_copy)
   735	    mod = importlib.util.module_from_spec(spec)
   736	    _exec_no_bytecode(spec, mod)
   737	    assert mod._SP_PATH == skills_copy / SPLIT_SCRIPT.relative_to(SKILLS), (
   738	        "副本没有解析到副本树里的 split_preview —— 布局与 checkout 不一致"
   739	    )
   740	
   741	    caches = sorted(p.relative_to(skills_copy) for p in skills_copy.rglob("__pycache__"))
   742	    assert not caches, f"运行/导入在副本树落下了字节码缓存: {caches}"
   743	
