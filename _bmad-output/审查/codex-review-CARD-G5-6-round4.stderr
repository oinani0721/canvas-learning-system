   434	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   435	
   436	
   437	def frontmatter_span(lines: list[str]) -> int:
   438	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   439	
   440	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   441	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   442	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   443	    行号是给人核对用的，偏了就等于没有。
   444	    """
   445	    if not lines or lines[0].strip() != "---":
   446	        return 0
   447	    end = None
   448	    for i in range(1, len(lines)):
   449	        if lines[i].strip() in ("---", "..."):
   450	            end = i
   451	            break
   452	    if end is None:
   453	        return 0  # 缺闭合 → 视为无 frontmatter
   454	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   455	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   456	    # 空文件的删除提名，比不提名坏得多。
   457	    for ln in lines[1:end]:
   458	        t = ln.strip()
   459	        if not t or t.startswith("#"):
   460	            continue  # 空行与 YAML 注释不作数
   461	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   462	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   463	
   464	
   465	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   466	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   467	    lines = text.splitlines()
   468	    n = frontmatter_span(lines)
   469	    return (lines[1 : n - 1] if n else []), lines[n:]
   470	
   471	
   472	def frontmatter_map(fm_lines: list[str]) -> dict:
   473	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   474	    out: dict[str, str] = {}
   475	    for ln in fm_lines:
   476	        m = _FM_KEY_RE.match(ln)
   477	        if not m:
   478	            continue
   479	        val = (m.group(2) or "").strip()
   480	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   481	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   482	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   483	        val = re.sub(r"\s+#.*$", "", val).strip()
   484	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   485	            val = val[1:-1]
   486	        out.setdefault(m.group(1), val)
   487	    return out
   488	
   489	
   490	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   491	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   492	
   493	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   494	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   495	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   496	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   497	    分隔行由状态机精确标记，内容行一律是内容。
   498	
   499	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   500	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   501	
   502	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   503	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   504	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   505	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   506	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   507	    """
   508	    _, rest = split_frontmatter(text)
   509	    rows: list[tuple[str, str]] = []
   510	    in_fence = False
   511	    fence_char = ""
   512	    fence_len = 0
   513	    in_comment = False
   514	    for ln in rest:
   515	        m = _FENCE_RE.match(ln)
   516	        if m and not in_comment:
   517	            tok = m.group(1)
   518	            if not in_fence:
   519	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   520	                rows.append((ln, "fence"))
   521	                continue
   522	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   523	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   524	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   525	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   526	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   527	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   528	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   529	            # 在 CommonMark 里是围栏内容）。
   530	            if (
   531	                tok[0] == fence_char
   532	                and len(tok) >= fence_len
   533	                and all(c in " \t" for c in ln[m.end() :])
   534	            ):
   535	                in_fence, fence_char, fence_len = False, "", 0
   536	                rows.append((ln, "fence"))
   537	                continue
   538	        if in_fence:
   539	            rows.append((ln, "code"))
   540	            continue
   541	        kept, rem = "", ln
   542	        while rem:
   543	            if in_comment:
   544	                i = rem.find("-->")
   545	                if i < 0:
   546	                    break
   547	                rem, in_comment = rem[i + 3 :], False
   548	            else:
   549	                i = rem.find("<!--")
   550	                if i < 0:
   551	                    kept += rem
   552	                    break
   553	                kept += rem[:i]
   554	                rem, in_comment = rem[i + 4 :], True
   555	        rows.append((kept, "text"))
   556	    return rows, in_comment
   557	
   558	
   559	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   560	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   561	    三态细节见 `_classify_lines_typed`。"""
   562	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   563	
   564	
   565	def dup_body(text: str) -> str:
   566	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   567	
   568	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   569	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   570	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   571	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   572	    有后果的提名，依据必须逐字。
   573	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   574	    """
   575	    parts: list[str] = []
   576	    for ln, is_code in _classify_lines(text):
   577	        if not is_code and _HEADING_RE.match(ln):
   578	            continue
   579	        t = ln.rstrip()
   580	        if not t:
   581	            continue
   582	        parts.append(nfc(t))
   583	    return "\n".join(parts)
   584	
   585	
   586	def has_substantive_content(text: str) -> bool:
   587	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   588	
   589	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   590	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   591	    合用一个函数正是 Codex BLOCKER 的根因。
   592	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   593	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   594	    （round-3 自审 B3-3）。
   595	    """
   596	    for ln, kind in _classify_lines_typed(text)[0]:
   597	        if kind == "code":
   598	            if ln.strip():
   599	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   600	            continue
   601	        if kind == "fence":
   602	            continue
   603	        if _HEADING_RE.match(ln):
   604	            continue
   605	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   606	        if t and not _ONLY_STRUCT_RE.match(t):
   607	            return True
   608	    return False
   609	
   610	
   611	def skeleton_note(text: str, size: int) -> str:
   612	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   613	
   614	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   615	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   616	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   617	    """
   618	    if size == 0:
   619	        return "0 字节空文件"
   620	    rows = _classify_lines_typed(text)[0]
   621	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   622	    struct = sum(
   623	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   624	    )
   625	    fences = sum(1 for _, k in rows if k == "fence")
   626	    return (
   627	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   628	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   629	        f"代码围栏 {fences} 行、其余皆空行）"
   630	    )
   631	
   632	
   633	def head_window(text: str) -> list[tuple[int, str]]:
   634	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   635	    lines = text.splitlines()
   636	    n = frontmatter_span(lines)
   637	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   638	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   639	        win.append((n + j + 1, ln))
   640	    return win
   641	
   642	
   643	def _find_marker_pos(ln: str, marker: str) -> int:
   644	    """marker 在 ln 中第一个满足右边界规则的起点；无则 -1。
   645	
   646	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   647	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   648	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   649	    行内更靠后的真命中。
   650	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   651	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   652	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   653	    只认行尾或标点；漏判方向落 C6，安全。"""
   654	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   655	    start = 0
   656	    while (i := ln.find(marker, start)) >= 0:
   657	        j = i + len(marker)
   658	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   659	            return i
   660	        if not ascii_ending and ln[j].isspace():
   661	            return i
   662	        start = i + 1
   663	    return -1
   664	
   665	
   666	def find_ai_marker(text: str) -> tuple[int, str] | None:
   667	    """文头窗口内的字面量 AI 标记（右边界规则见 `_find_marker_pos`）。
   668	    同行多命中时取「最靠前、同位置取最长」——确定性。"""
   669	    for lineno, ln in head_window(text):
   670	        hits = [
   671	            (pos, -len(m), m)
   672	            for m in AI_MARKERS
   673	            if (pos := _find_marker_pos(ln, m)) >= 0
   674	        ]
   675	        if hits:
   676	            _, _, marker = min(hits)
   677	            return lineno, marker
   678	    return None
   679	
   680	
   681	def round_of(name: str) -> str | None:
   682	    m = _ROUND_RE.search(name)
   683	    return m.group(1) if m else None
   684	
   685	
   686	def round_type(name: str) -> str | None:
   687	    for pat, typ in ROUND_SUBPATTERNS:
   688	        if pat in name:
   689	            return typ
   690	    return None
   691	
