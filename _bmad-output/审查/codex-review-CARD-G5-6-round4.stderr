  1549	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  1550	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  1551	    for suffix in (".json", ".md"):
  1552	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  1553	        if n > MAX_FILENAME_BYTES:
  1554	            raise SystemExit(
  1555	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "

