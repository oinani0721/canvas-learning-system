+def test_bare_ai_markers_are_removed_from_table():
+    """⛔ H2 回归(表锁): 裸词「AI 生成」「AI生成」是「由 AI 生成」「由AI生成」的
+    严格子串; 截断形态「本文由 AI」「本报告由 AI」被「由 AI 生成」覆盖断言形态 ——
+    从表中删除不丢任何带断言锚的命中, 只丢话题提及类误命中。"""
+    mod = load_module()
+    assert "AI 生成" not in mod.AI_MARKERS

