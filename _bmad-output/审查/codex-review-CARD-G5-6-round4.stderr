  1541	def validate_label(label: str) -> None:
  1542	    if not label or _BAD_LABEL.search(label):
  1543	        raise SystemExit(
  1544	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
