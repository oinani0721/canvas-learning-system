   320	#: 人话时区：**固定 +08:00**，刻意不走 `ZoneInfo("Asia/Shanghai")`。
   321	#: ⛔ 理由是本卡有「二跑逐字节相等」硬门，而该门必须**跨宿主**成立：ZoneInfo 在装了
   322	#: tzdata 的机器上会给 1986-1991 年的日期套上夏令时（实测 1988-07-01 → +09:00），
   323	#: 没装 tzdata 的机器退化成 +08:00 —— 同一份输入在两台机器产出不同字节。
   324	#: 代价是那六年的历史时刻不带夏令时；收件箱材料不可能有 1980 年代的 mtime，
   325	#: 拿一个不可能发生的历史精度去换一个每次都要成立的确定性，是划算的。
   326	#: （与 `scripts/daily_review_pick.py` 优先 ZoneInfo 的口径有意分歧，理由如上。）
   327	_TZ_SHANGHAI = timezone(timedelta(hours=8))
   328	
   329	_HEADING_RE = re.compile(r"^\s{0,3}#{1,6}(?:\s|$)")
   330	_LIST_PREFIX_RE = re.compile(r"^\s*(?:[-*+]\s+|\d{1,3}[.)]\s+|>\s?)+")
   331	#: 纯结构行（分隔线 / 表格分隔 / 空列表符）。⛔ 不含 `~`：`~~~` 是代码围栏标记，
   332	#: 由 `_classify_lines` 的状态机处理；把它当"结构"曾让整段围栏代码凭空消失。
   333	_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
   334	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   335	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   336	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   337	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   338	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   339	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   340	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   341	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   342	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   343	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   344	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   345	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   346	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   347	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   348	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   349	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   350	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   351	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   352	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   353	#: 里仍保留作防御深度。
   354	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
   355	
   356	
   357	def _is_primary_source_url(src: str) -> bool:
   358	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   359	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   360	    if not _URL_RE.match(src):
   361	        return False
   362	    try:
   363	        parts = urlsplit(src)
   364	    except ValueError:
   365	        return False
   366	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   367	
   368	
   369	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
   370	
   371	
   372	# ───────────────────────────── 身份键 ─────────────────────────────
   373	
   374	
   375	def compute_inbox_stable_id(rel_path: str) -> str:
   376	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   377	
   378	    编码纪律复用 `split_preview.compute_stable_id`（长度前缀载荷，对任意字节单射），
   379	    命名空间经 heading-path 槽位注入，返回值改挂自有前缀 —— 见文件头「身份空间
   380	    不可互换」。**不**把 mtime/size/内容进键：那样一改正文就换身份，diff 无意义。
   381	    """
   382	    raw = _SP.compute_stable_id(rel_path, [INBOX_ID_NAMESPACE], 1, INBOX_ID_BASIS)
   383	    return INBOX_ID_PREFIX + raw[len(_SP.STABLE_ID_PREFIX) :]
   384	
