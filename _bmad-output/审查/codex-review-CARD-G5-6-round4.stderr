  1128	def test_fence_close_requires_same_char_min_length_and_bare_fence(tmp_path):
  1129	    """⛔ B3 回归: 关闭围栏 = 同字符 且 长度 ≥ 开启长度 且 围栏后仅空白
  1130	    (CommonMark 4.5)。
  1131	
  1132	    原实现只比字符: ```` 里的 ``` 被当关闭、``` 后带 info string 的行也被当关闭,
  1133	    围栏内容 `# keep` 落到围栏外被 `_HEADING_RE` 剥掉 → 整份文件被误判成
  1134	    空骨架 → 建议删。
  1135	    """
  1136	    vault, out = base_vault(tmp_path)
  1137	    inbox = vault / "_待处理"
  1138	    mk(inbox / "四反引号.md", "````\n```\n# keep\n````\n", age_days=9)
  1139	    mk(inbox / "四波浪线.md", "~~~~\n~~~\n# keep\n~~~~\n", age_days=8)
  1140	    # CommonMark: 关闭围栏不得带 info string → ```python 是围栏内容, 不是关闭
  1141	    mk(inbox / "关闭带infostring.md", "```\n```python\n# keep\n```\n", age_days=7)
  1142	    # 同字符子句: ``` 围栏里的 ~~~ 行是内容, 不是关闭 (删掉同字符判断即翻红)
  1143	    mk(inbox / "混合字符.md", "```\n~~~\n# keep\n```\n", age_days=6)
  1144	    # 制表符缩进不构成围栏 (CommonMark: ≥4 列是缩进代码块); \t``` 不得提前关闭 ——
  1145	    # ⛔ 语料不得带正文行: 有正文行时「提前关闭」也杀不死断言, 变异会存活
  1146	    mk(inbox / "tab关闭围栏.md", "```\n\t```\n# 标题\n", age_days=5)
  1147	    # 围栏内容行哪怕每行都长得像围栏标记, 也是实质正文 (Markdown 围栏语法速查)
  1148	    mk(
  1149	        inbox / "围栏速查.md",
  1150	        "# Markdown 围栏语法速查\n\n## 空围栏怎么写\n\n````\n```\n```\n~~~\n~~~\n````\n",
  1151	        age_days=4,
  1152	    )
  1153	    # 正向对照: 只有围栏无内容 → 仍是空骨架; 正常围栏包着注释 → 仍非空骨架
  1154	    mk(inbox / "只有围栏.md", "````\n````\n", age_days=2)
  1155	    mk(inbox / "正常围栏.md", "```\n# keep\n```\n", age_days=1)
