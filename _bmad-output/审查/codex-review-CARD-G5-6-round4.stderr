  1211	def test_ai_marker_needs_boundary_after_literal(tmp_path):
  1212	    """⛔ H2 回归: 标记右侧必须满足边界规则 —— 话题提及不是生成断言, 不得被归档。
  1213	    ⛔ round-3 自审 H2-1 扩: 汉字收尾标记后须为行尾/空白/标点; ASCII 字母收尾
  1214	    标记(`Generated by AI`)后空白**不算**边界 —— `Generated by AI Lab` 是机构名,
  1215	    `本文由 AI 领域…` 是话题, 放行空白就是把边界规则对这些标记变成空操作。"""
  1216	    vault, out = base_vault(tmp_path)
  1217	    inbox = vault / "_待处理"
  1218	    mk(
  1219	        inbox / "版权话题.md",
  1220	        "# AI 生成内容的版权问题\n\n话题正文一。\n话题正文二。\n",
  1221	        age_days=9,
  1222	    )
  1223	    mk(
  1224	        inbox / "由字版权话题.md",
  1225	        "# 由 AI 生成内容的版权问题\n\n话题正文三。\n话题正文四。\n",
  1226	        age_days=8,
  1227	    )
  1228	    mk(
  1229	        inbox / "评测话题.md",
  1230	        "# Deep Research 生成质量评测\n\n评测正文一。\n评测正文二。\n",
  1231	        age_days=7,
  1232	    )
  1233	    mk(
  1234	        inbox / "本文由话题.md",
  1235	        "# 访谈整理\n\n本文由 AI 领域的三位研究者共同撰写，记录分歧。\n访谈正文二。\n",
  1236	        age_days=6,
  1237	    )
  1238	    mk(
  1239	        inbox / "英文机构.md",
  1240	        "# Lab notes\n\nGenerated by AI Lab researchers in Beijing.\n笔记正文二。\n",
  1241	        age_days=5,
  1242	    )
  1243	    # 正向对照: 行尾/标点/加粗收尾仍命中, 依据带行号与逐字片段
  1244	    mk(
  1245	        inbox / "行尾自述.md",
  1246	        "# 报告甲\n\n> 本文由 AI 生成\n\n自述正文一。\n自述正文二。\n",
  1247	        age_days=4,
  1248	    )
  1249	    mk(
  1250	        inbox / "标点自述.md",
  1251	        "# 报告乙\n\n由 AI 生成，仅供参考\n\n自述正文三。\n自述正文四。\n",
  1252	        age_days=3,
  1253	    )
  1254	    mk(
  1255	        inbox / "英文句点自述.md",
  1256	        "# Report\n\nThis draft was generated by AI.\n报告正文二。\n",
  1257	        age_days=2,
  1258	    )
  1259	    mk(
  1260	        inbox / "加粗自述.md",
  1261	        "# 报告丙\n\n**由 AI 生成**\n\n自述正文五。\n自述正文六。\n",
  1262	        age_days=1,
  1263	    )
  1264	
  1265	    assert run_cli(vault, out).returncode == 0
  1266	    data = load_json(out)
  1267	    for name in (
  1268	        "版权话题.md",
  1269	        "由字版权话题.md",
  1270	        "评测话题.md",
  1271	        "本文由话题.md",
  1272	        "英文机构.md",
  1273	    ):
  1274	        it = item_by_name(data, name)
  1275	        assert it["criterion"] != "C2_ai_self_declared", name
  1276	        # ⛔ round-3 Codex MEDIUM: 只排除 C2 曾放过「整批被判 C3 建议删」的变异 ——
  1277	        # 负例必须同时钉住「没有被破坏性提名」
  1278	        assert it["verdict"] != "建议删", name
  1279	        assert it["confident"] is False, name
  1280	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1281	    tail = item_by_name(data, "行尾自述.md")
  1282	    assert tail["criterion"] == "C2_ai_self_declared"
  1283	    assert "第 3 行" in tail["basis"], f"依据必须带行号: {tail['basis']}"
  1284	    punct = item_by_name(data, "标点自述.md")
  1285	    assert punct["criterion"] == "C2_ai_self_declared"
  1286	    assert "由 AI 生成" in punct["basis"], f"依据必须带逐字片段: {punct['basis']}"
  1287	    en = item_by_name(data, "英文句点自述.md")
  1288	    assert en["criterion"] == "C2_ai_self_declared", "英文句点边界必须仍命中"
  1289	    bold = item_by_name(data, "加粗自述.md")
  1290	    assert bold["criterion"] == "C2_ai_self_declared", "Markdown 加粗收尾必须仍命中"
