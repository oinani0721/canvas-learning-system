  1464	def test_fence_close_trailing_whitespace_must_be_ascii(tmp_path):
  1465	    """⛔ round-3 Codex BLOCKER: 关闭围栏行尾只允许 ASCII 空白 (CommonMark 4.5)。
  1466	
  1467	    `str.strip()` 接受一切 Unicode 空白 —— 行尾一个 U+00A0 (NBSP, 从网页复制
  1468	    常见) 曾让该行被当成合法关闭围栏, 围栏提前闭合, `# keep` 被剥 →
  1469	    「空骨架 → 建议删 confident=true」。NBSP 行在 CommonMark 里是围栏**内容**。
  1470	    """
  1471	    vault, out = base_vault(tmp_path)
  1472	    mk(
  1473	        vault / "_待处理" / "nbsp关闭.md",
  1474	        "```\n```\xa0\n# keep\n```\n",
  1475	        age_days=5,
  1476	    )
  1477	    # 正向对照: 行尾 ASCII 空白/制表符仍是合法关闭 (不得修过头) ——
  1478	    # ⛔ 语料必须是「只包围栏无内容」: 带真实内容行时断言杀不死变异
  1479	    mk(vault / "_待处理" / "ascii尾随.md", "```\n``` \t\n", age_days=4)
  1480	
  1481	    assert run_cli(vault, out).returncode == 0
  1482	    data = load_json(out)
  1483	    it = item_by_name(data, "nbsp关闭.md")
  1484	    assert it["criterion"] != "C3_empty_or_skeleton", f"NBSP 提前关闭了围栏: {it['basis']}"
  1485	    assert it["verdict"] != "建议删", it["basis"]
  1486	    pos = item_by_name(data, "ascii尾随.md")
  1487	    assert pos["criterion"] == "C3_empty_or_skeleton", "只包围栏无内容 → 仍空骨架"
  1488	    assert pos["verdict"] == "建议删"
