def run_gate(gate: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        [
            str(WT / "backend/.venv/bin/pytest"),
            f"{TESTFILE}::{gate}",
            "-q",
            "-p",
            "no:cacheprovider",
        ],
        cwd=WT / "backend",
        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
        capture_output=True,
        text=True,
    )


def main() -> int:
    pristine = SCRIPT.read_bytes()
    BACKUP.write_bytes(pristine)
    results = []
    ok = True
    for name, old, new, gate in MUTATIONS:
        content = SCRIPT.read_text(encoding="utf-8")
        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
        mutated = content.replace(old, new, 1)
        if name.startswith("M5"):
            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
            assert looks_old in mutated, "M5: 第二条正则原串不在场"
            mutated = mutated.replace(looks_old, looks_rev, 1)
        assert mutated != content, f"{name}: 替换后内容未变化"
        SCRIPT.write_text(mutated, encoding="utf-8")
        try:
            r = run_gate(gate)
            out = r.stdout + r.stderr
            failed_marker = f"FAILED {TESTFILE}::{gate}"
            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
            results.append((name, gate, r.returncode, killed))
            if not killed:
                ok = False
                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
                print(out[-1500:])
        finally:
            SCRIPT.write_bytes(pristine)
        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
    print()
    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())

