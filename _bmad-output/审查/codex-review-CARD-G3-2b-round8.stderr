   117	def rows(vault: Path):
   118	    p = vault / "learning_events.jsonl"
   119	    return [json.loads(x) for x in p.read_text(encoding="utf-8").splitlines() if x.strip()] if p.exists() else []
   120	
   121	
   122	def write_rows(vault: Path, *recs, trailing_lf=True):
   123	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs)
   124	    (vault / "learning_events.jsonl").write_text(text if trailing_lf else text[:-1], encoding="utf-8")
   125	
