  1326	def _rating_from_grade_norm(grade_norm: float) -> int:
  1327	    """grade_norm → FSRS Rating, 与 fsrs_bridge.rating_from_grade 同口径
  1328	    ([Decision-FSRS-1]: 还原 grade = 1 + 3·gn 后就近落四档, 越界钳制)。"""
  1329	    grade = 1.0 + 3.0 * grade_norm
  1330	    rating = int(math.floor(grade + 0.5))
  1331	    return max(1, min(4, rating))
  1332	
