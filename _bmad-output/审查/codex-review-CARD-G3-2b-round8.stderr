   107	class _NonStandardJSON(ValueError):
   108	    """NaN/Infinity/-Infinity 或重复键 — 非 RFC 8259 严格 JSON。"""
   109	
   110	
   111	def _reject_constant(name: str) -> None:
   112	    raise _NonStandardJSON(f"非标准 JSON 常量 {name} (RFC 8259 禁止, 跨语言读方会炸)")
   113	
   114	
   115	def _reject_dup_keys(pairs: list[tuple[str, object]]) -> dict:
   116	    seen: set[str] = set()
   117	    for key, _ in pairs:
   118	        if key in seen:
   119	            raise _NonStandardJSON(f"对象内重复键 {key!r} (json.loads 静默取后者, 审计不容许歧义)")
   120	        seen.add(key)
   121	    return dict(pairs)
