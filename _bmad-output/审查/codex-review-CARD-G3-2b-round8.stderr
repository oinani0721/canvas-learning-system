   411	def _fm_has_event(fm_text, ev_id):
   412	    mcal = re.search(r'^calibration_log:[ \t]*$', fm_text, re.M)
   413	    if not mcal:
   414	        return False
   415	    for ln in fm_text[mcal.end():].split("\n")[1:]:
   416	        if ln and not ln[0].isspace():
   417	            break
   418	        mm = re.match(r'^\s*-\s*event_id:\s*(.+?)\s*$', ln)
   419	        if mm:
   420	            v = mm.group(1).strip()
   421	            if v.startswith('"') and v.endswith('"') and len(v) >= 2:
   422	                try:
   423	                    v = json.loads(v)  # 双引号 scalar 与写侧 json.dumps 同源反解 (含 \" \\)
   424	                except ValueError:
   425	                    pass
   426	            elif len(v) >= 2 and v[0] == v[-1] and v[0] == "'":
   427	                # YAML 单引号标量里 '' 表示一个字面单引号 —— 不还原就把
   428	                # 'O''Brien#q1' 读成 O''Brien#q1, F1 判定假阴性 ⇒ 同一次评分的
   429	                # mastery/校准被算第二遍 (Codex round-4 BLOCKER)。
   430	                v = v[1:-1].replace("''", "'")

