   131	def _write_ledger(vault: Path, *rows, trailing_lf=True):
   132	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
   133	    if not trailing_lf and text.endswith("\n"):
   134	        text = text[:-1]
   135	    (vault / "learning_events.jsonl").write_text(text, encoding="utf-8")
   136	
   137	
   138	def _payload(**kw):
   139	    base = {
   140	        "node": NODE_REL,
   141	        "grade_norm": 0.752,
   142	        "ts": TS1,
   143	        "event_id": EID,
   144	        "exam_board": "检验白板/测试检验-2026-08-01-1000.md",
   145	        "question_id": "q1",
   146	        "source_board": "[[原白板/CS 61B]]",
   147	        "self_confidence_raw": "半懂",
   148	        "self_confidence_norm": 0.5,
   149	        "abandoned": False,
   150	        "callout": "",
   151	    }
   152	    base.update(kw)
   153	    return base
