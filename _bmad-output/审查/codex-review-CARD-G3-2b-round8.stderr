import importlib.util, json, os, re
from pathlib import Path
src = Path(\"backend/scripts/g32b_r1r7_counterexamples.py\").resolve()
spec = importlib.util.spec_from_file_location(\"ce\", src)
ce = importlib.util.module_from_spec(spec); spec.loader.exec_module(ce)
ce.CE_ROOT = Path(os.environ[\"CE_AUDIT_ROOT\"])

def show(label, r, v):
    lp=v/\"learning_events.jsonl\"
    rows=[json.loads(x) for x in lp.read_text(encoding=\"utf-8\").splitlines() if x.strip()] if lp.exists() else []
    node=(v/ce.NODE_REL).read_text(encoding=\"utf-8\")
    wm=re.search(r\""'^fsrs_last_review:'"\\\\s*["'^'"\\\\n]+\", node, re.M)
    att=re.search(r\""'^attempt_count:'"\\\\s*["'^'"\\\\n]+\", node, re.M)
    print(json.dumps({\"case\":label,\"rc\":r.returncode,\"stdout\":r.stdout[-350:],\"stderr\":r.stderr[-500:],\"ledger_rows\":len(rows),\"durable_review_time\":rows[0][\"payload\"].get(\"review_time\") if rows else None,\"recorded_at\":rows[0].get(\"recorded_at\") if rows else None,\"W\":wm.group(0) if wm else None,\"attempt\":att.group(0) if att else None},ensure_ascii=False))

