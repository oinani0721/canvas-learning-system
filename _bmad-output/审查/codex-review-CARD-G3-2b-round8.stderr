  1140	def test_r7_corrupt_tail_line_with_lf_is_not_truncation(vault):
  1141	    """旧实现只看「最后一行解析失败」, 于是**带终止 LF** 的损坏末行也被当
  1142	    截断容忍 — 实测 writer 仍 rc=0、自称「截断尾行」、继续追加并推进节点。
  1143	    EOF 的 LF 状态是区分「被腰斩的半行」与「完整写入后损坏」的唯一机械证据。"""
  1144	    good = _review_row(event_id="quiz:旧板", **{"payload.review_time": "2026-07-01T10:00:00Z"})
  1145	    good["effective_at"] = "2026-07-01T10:00:00Z"
  1146	    good["node_id"] = "别的节点"  # 不进本节点适用集, 隔离本门的判定面
  1147	    bad = '{"event_id": "quiz:损坏行", "event_version": 1, "event_type": "answer_sc'
  1148	    ledger = vault / "learning_events.jsonl"
  1149	    # ①带终止 LF 的坏末行 → fail-closed 零写
  1150	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad + "\n", encoding="utf-8")
  1151	    sha = _sha(vault / NODE_REL)
  1152	    r = _run_writer(vault, _payload())
  1153	    assert r.returncode != 0, "带终止 LF 的坏末行必须 fail-closed (旧实现 rc=0 当截断容忍)"
  1154	    assert "完整写入的损坏行" in r.stderr, r.stderr
  1155	    assert _sha(vault / NODE_REL) == sha, "零写节点"
  1156	    assert len(ledger.read_text(encoding="utf-8").splitlines()) == 2, "零写账本"
  1157	    # ②同一坏行去掉终止 LF → 仍按截断自愈容忍 (对照, 防本门变成「坏行恒拒」)
  1158	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
  1159	    r2 = _run_writer(vault, _payload())
  1160	    assert r2.returncode == 0, "无 LF 的坏末行仍应按截断隔离: " + r2.stdout + r2.stderr
  1161	    assert "截断尾行" in r2.stdout
  1162	    lines = [ln for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
  1163	    assert len(lines) == 3 and json.loads(lines[2])["event_id"] == "quiz:" + EID
