  2766	
  2767	def test_round7_findings(vault):
  2768	    """round-7 的问题逐条锁住。其中 M① 是我 round-6「保留 W 兜底」引入的 ——
  2769	    「更安全的兜底」让 calibration 判据**没有真正生效**。
  2770	    """
  2771	    LED = vault / "learning_events.jsonl"
  2772	
  2773	    def _fresh():
  2774	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2775	        LED.unlink(missing_ok=True)
  2776	
  2777	    # ── B① 校准 token 必须反查所有来源；exact 命中也不得绕过歧义检查
  2778	    _fresh()
  2779	    assert _run_writer_settled(vault, _payload(event_id="quiz:K", ts=TS1)).returncode == 0
  2780	    node = (vault / NODE_REL).read_text(encoding="utf-8")
  2781	    assert '- event_id: "quiz:quiz:K"' in node, node[:300]
  2782	    hist = node.replace('- event_id: "quiz:quiz:K"', '- event_id: "quiz:K"')
  2783	    assert hist != node, "预置必须真的改成历史形态"
  2784	    (vault / NODE_REL).write_text(hist, encoding="utf-8")
  2785	    n_before = len(_ledger_lines(vault))
