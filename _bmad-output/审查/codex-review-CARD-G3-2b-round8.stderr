   478	def main() -> int:
   479	    resolved = CE_ROOT.resolve() if CE_ROOT.exists() else CE_ROOT
   480	    if not str(resolved).startswith(str(FIXTURE_ROOT)):
   481	        sys.exit(f"[g32b-ce] 目标目录越出约定前缀 ({resolved}) — 拒跑")
   482	    if FIXTURE_ROOT.exists() and not (FIXTURE_ROOT / MARKER).is_file():
   483	        sys.exit(f"[g32b-ce] {FIXTURE_ROOT} 缺标记文件 {MARKER} — 先跑 g32b_build_fixture.py")
   484	    if CE_ROOT.exists():
   485	        shutil.rmtree(CE_ROOT)
   486	    CE_ROOT.mkdir(parents=True)
   487	    print(f"反例 fixture 根: {CE_ROOT}")
   488	    for fn in (r1, r2, r3, r4, r5, r6, r7, n1_n5):
   489	        fn()
   490	    bad = [t for t, ok, _ in RESULTS if not ok]
   491	    print(f"\n{'=' * 70}\n判据 {len(RESULTS) - len(bad)}/{len(RESULTS)} PASS")
   492	    if bad:
   493	        print("FAIL:", bad)
   494	        return 1
   495	    print("R1-R7 + round-1 后续 N1-N5 全部 fail-closed / 幂等 — 裁判 2 PASS")
   496	    return 0
   497	
   498	
   499	if __name__ == "__main__":
   500	    sys.exit(main())

