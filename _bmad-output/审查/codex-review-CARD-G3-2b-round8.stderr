  2024	    assert len([ln for ln in r5.stdout.splitlines() if "A2 重放已应用" in ln]) == 2, "两条都要重放"
  2025	    assert "已按各自的账本载荷复放" in r5.stdout, "两条被恢复事件的评分链副作用都要复放"
  2026	    assert len(_ledger_lines(vault)) == 2, "第一阶段不得追加本次事件"
  2027	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-04T10:00:00Z", "恢复结果必须已落盘"
  2028	    # 第二阶段：pending 已空，本次评分在干净基线上写入
  2029	    r6 = _run_writer(vault, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z"))
  2030	    assert r6.returncode == 0, r6.stdout + r6.stderr
  2031	    assert [x["payload"]["attempt_count"] for x in _ledger_lines(vault)] == [1, 2, 3]
  2032	    assert _run_validator(vault).returncode == 0
  2033	
  2034	    # ⑥ 两阶段必须在 2 轮内收敛，且 payload 临时文件要留着让用户能重跑。
  2035	    # 「先恢复、再要求重跑」这个结构最大的风险是**不收敛**——每跑一次都说
  2036	    # 「恢复已落定请重跑」却永远跑不完。三种时刻关系都要验：被恢复事件的时刻
  2037	    # 晚于 / 等于 / 早于本次评分（晚于那档尤其要紧：第二轮里 A3 得把本次时刻
  2038	    # 推到 W+1s 才写得进去）。
  2039	    for i, (pending_rt, desc) in enumerate(
