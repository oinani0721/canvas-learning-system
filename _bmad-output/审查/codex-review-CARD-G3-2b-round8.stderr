   258	
   259	def _pending_row(**over):
   260	    row = {
   261	        "event_id": "quiz:板A#q1",
   262	        "event_version": 1,
   263	        "event_type": "answer_scored",
   264	        "node_id": "测试节点",
   265	        "recorded_at": TS1,
   266	        "effective_at": TS1,
   267	        "payload": {
   268	            "schema_ext": "review/1",
   269	            "vault_id": "canvas_vault_测试",
   270	            "concept_id": "测试节点",
   271	            "rating": 3,
   272	            "grade_norm": 0.75,
   273	            "review_time": TS1,
   274	            "fsrs_library_version": "degraded:historic-run",
   275	            "fsrs_params_hash": "degraded:historic-run",
   276	            "exam_board": "检验白板/板A.md",
   277	            "attempt_count": 1,
   278	        },
   279	    }
   280	    row["payload"].update(over)
   281	    return row
   282	
   283	
   284	def r5():
   285	    print("\n── R5 (HIGH) scored rating 与 grade_norm 不自洽 → apply 前必须拒绝 ──")
   286	    v = new_vault("r5")
   287	    s = sha(v / NODE_REL)
   288	    for bad in (4, 2):
   289	        write_rows(v, _pending_row(rating=bad))
   290	        r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   291	        check(
   292	            f"R5/rating={bad} vs grade_norm=0.75(契约3)",
   293	            r.returncode != 0 and "不自洽" in r.stderr and sha(v / NODE_REL) == s and len(rows(v)) == 1,
   294	            f"rc={r.returncode} 账本={len(rows(v))}行 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   295	        )
   296	    write_rows(v, _pending_row())
   297	    r = run_settled(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   298	    check("R5/验伪-契约值3 照常重放", r.returncode == 0 and len(rows(v)) == 2, f"rc={r.returncode}")
   299	
   300	
   301	def r6():
   302	    print("\n── R6 (MEDIUM) 身份键归属与 candidate 构造裁决必须回写冻结 schema §6.2 ──")
   303	    doc = SCHEMA_DOC.read_text(encoding="utf-8")
   304	    seg = doc[doc.index("duplicate 命中后的状态推进门") : doc.index("**A5 整秒精度")]
   305	    missing = [
   306	        n
   307	        for n in (
   308	            "fsrs_library_version",
   309	            "fsrs_params_hash",
   310	            "排除出 envelope 等价面",
   311	            "golden manifest 绑定门",
   312	            "candidate 必须独立字面构造",
   313	            "多一键、少一键或值不同",
   314	        )
   315	        if n not in seg
   316	    ]
   317	    check("R6/§6.2 duplicate 门段落", not missing, f"缺失条款={missing or '无'}")
   318	    a5 = doc[doc.index("**A5 整秒精度") : doc.index("**三态语义")]
   319	    check("R6/§6.2 A5 消费侧强制", "A2 消费侧同样机械强制" in a5 and "禁止消费时顺手归一化" in a5, "已回写")
   320	    check("R6/§6.2 A4.5 截断判据", "可容忍的截断 vs 完整损坏" in doc and "不以 LF 结尾" in doc, "已回写")
   321	
   322	
   323	def r7():
   324	    print("\n── R7 (MEDIUM) 坏末行: 带 LF = 完整损坏(拒) / 无 LF = 截断(容忍) ──")
   325	    v = new_vault("r7")
   326	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   327	    good["event_id"] = "quiz:旧板"
   328	    good["effective_at"] = "2026-07-01T10:00:00Z"
   329	    good["node_id"] = "别的节点"
   330	    bad = '{"event_id": "quiz:损坏行", "event_version": 1, "event_type": "answer_sc'
   331	    ledger = v / "learning_events.jsonl"
   332	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad + "\n", encoding="utf-8")
   333	    s = sha(v / NODE_REL)
   334	    r = run(v)
   335	    check(
   336	        "R7/坏末行带终止 LF → fail-closed",
   337	        r.returncode != 0 and "完整写入的损坏行" in r.stderr and sha(v / NODE_REL) == s,
   338	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   339	    )
   340	    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
   341	    rf = run(v)
   342	    lines = [x for x in ledger.read_text(encoding="utf-8").splitlines() if x.strip()]
   343	    check(
   344	        "R7/同一坏行去掉 LF → 仍按截断隔离",
   345	        rf.returncode == 0 and "截断尾行" in rf.stdout and len(lines) == 3,
   346	        f"rc={rf.returncode} 账本={len(lines)}行 (坏行隔离, 新事件独立成行)",
   347	    )
   348	
   349	
   350	def n1_n5():
   351	    """round-1 后续：Codex 正文被内容过滤器拦下，按 stderr 保留的推理标题线索
   352	    逐条实测出的五个残留面（4 条复现为真缺陷 + 1 条诊断不精确）。"""
   353	    print("\n── N1 (BLOCKER) 标 out_of_order 但 review_time > W：被伪装成乱序的真实后继 ──")
   354	    v = new_vault("n1")
   355	    late = _pending_row(out_of_order=True, review_time="2026-08-05T10:00:00Z")
   356	    late["effective_at"] = "2026-08-05T10:00:00Z"
   357	    write_rows(v, late)
   358	    s = sha(v / NODE_REL)
   359	    r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   360	    check(
   361	        "N1/伪装成乱序的后继",
   362	        r.returncode != 0 and "伪装成乱序的真实后继" in r.stderr and sha(v / NODE_REL) == s,
   363	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   364	    )
   365	    for bad in (False, "true", 1):
   366	        write_rows(v, _pending_row(out_of_order=bad))
   367	        rb = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   368	        # round-5 后完整校验前移到乱序分流之前 ⇒ 坏形态先被**校验器本体**拦
   369	        # (两侧同口径), 写点自己的形态门成了其后的第二道。两种拒因都算达标,
   370	        # 但必须点名是这两者之一 —— 不能退化成「随便什么理由拒了都行」。
   371	        _why_ok = ("形态非法" in rb.stderr) or ("out_of_order 唯一合法值" in rb.stderr)
   372	        check(f"N1/形态 {bad!r} 非法", rb.returncode != 0 and _why_ok, f"rc={rb.returncode} | {last_line(rb.stderr)}")
   373	    (v / "learning_events.jsonl").unlink()
   374	    assert run(v).returncode == 0
   375	    early = _pending_row(out_of_order=True, review_time="2026-07-01T10:00:00Z")
   376	    early["effective_at"] = "2026-07-01T10:00:00Z"
   377	    early["event_id"] = "quiz:补录旧事件"
   378	    write_rows(v, rows(v)[0], early)
   379	    ro = run(v, event_id="板C#q1", ts="2026-08-03T10:00:00Z")
   380	    check(
   381	        "N1/验伪-合法乱序 (review_time ≤ W) 放行且不推进 W",
   382	        ro.returncode == 0 and fsrs_fields(v).get("fsrs_last_review") == "2026-08-03T10:00:00Z",
   383	        f"rc={ro.returncode} W={fsrs_fields(v).get('fsrs_last_review')}",
   384	    )
   385	
   386	    print("\n── N2 (HIGH) EOF 的 LF 判据必须落在字节上（文本模式会把裸 \\r 读成 \\n）──")
   387	    v = new_vault("n2")
   388	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   389	    good["event_id"] = "quiz:旧板"
   390	    good["effective_at"] = "2026-07-01T10:00:00Z"
   391	    good["node_id"] = "别的节点"
   392	    torn = '{"event_id": "quiz:损坏行", "event_ty'
   393	    head = (json.dumps(good, ensure_ascii=False) + "\n").encode("utf-8") + torn.encode("utf-8")
   394	    (v / "learning_events.jsonl").write_bytes(head + b"\r")
   395	    r = run(v)
   396	    check(
   397	        "N2/裸 \\r 结尾按字节算截断",
   398	        r.returncode == 0 and "截断尾行" in r.stdout,
   399	        f"rc={r.returncode} | {last_line(r.stdout)[:90]}",
   400	    )
   401	    (v / "learning_events.jsonl").write_bytes(head + b"\r\n")
   402	    rb = run(v, event_id="板D#q1", ts="2026-08-04T10:00:00Z")
   403	    check(
   404	        "N2/对照-真带 LF 仍 fail-closed",
   405	        rb.returncode != 0 and "完整写入的损坏行" in rb.stderr,
   406	        f"rc={rb.returncode}",
   407	    )
   408	    # R7-blank（Codex round-2 线索 "R7 blank bug"，实测复现）：判据必须落在
   409	    # 「**最后一个非空行**有没有终止 LF」上，不是「文件末尾有没有 LF」——
   410	    # 坏行后跟一个纯空白行、文件不以 LF 收尾时，旧判据说「截断」，可那行明明
   411	    # 后面还跟着东西。
   412	    (v / "learning_events.jsonl").write_bytes(head + b"\n   ")
   413	    rc2 = run(v, event_id="板E#q1", ts="2026-08-06T10:00:00Z")
   414	    # ⚠️ round-6 口径变更: 空行现在与校验器同口径**拒收** (校验器 VALIDATOR:737/:1571
   415	    # 判「append-only JSONL 不应出现空行」, 写点此前静默忽略 ⇒ 写点 rc=0 而校验器
   416	    # rc=1)。本例的构造含纯空白行 ⇒ 空行门先拦。两种拒因都是 fail-closed, 但必须
   417	    # 点名是这两者之一 —— 不能退化成「随便什么理由拒了都行」。
   418	    _why2 = ("完整写入的损坏行" in rc2.stderr) or ("是空行" in rc2.stderr)
   419	    check(
   420	        "N2/R7-blank：坏行带 LF + 末尾空白行 → 仍 fail-closed（round-6 起空行门先拦）",
   421	        rc2.returncode != 0 and _why2,
   422	        f"rc={rc2.returncode} | {last_line(rc2.stderr)}",
   423	    )
   424	    (v / "learning_events.jsonl").write_bytes(head + b"   ")
   425	    rd = run(v, event_id="板F#q1", ts="2026-08-07T10:00:00Z")
   426	    check(
   427	        "N2/R7-blank 验伪：坏行无 LF 但有尾随空格 → 仍算截断",
   428	        rd.returncode == 0 and "截断尾行" in rd.stdout,
   429	        f"rc={rd.returncode}",
   430	    )
   431	
   432	    print("\n── N3 (MEDIUM) 账本行 JSON 重复键：loads 静默取最后一个 ──")
   433	    v = new_vault("n3")
   434	    row = _pending_row()
   435	    row["event_id"] = "quiz:" + EID
   436	    text = json.dumps(row, ensure_ascii=False)
   437	    dup = text.replace('"grade_norm": 0.75', '"grade_norm": 0.11, "grade_norm": 0.75', 1)
   438	    assert dup.count('"grade_norm"') == 2
   439	    (v / "learning_events.jsonl").write_text(dup + "\n", encoding="utf-8")
   440	    r = run(v)
   441	    check(
   442	        "N3/重复键歧义",
   443	        r.returncode != 0 and "重复键" in r.stderr and not fsrs_fields(v),
   444	        f"rc={r.returncode} | {last_line(r.stderr)}",
   445	    )
   446	
   447	    print("\n── N4 (MEDIUM) 非法 UTF-8 字节须 clean fail-closed，不是 traceback ──")
   448	    v = new_vault("n4")
   449	    (v / "learning_events.jsonl").write_bytes(b'{"event_id": "quiz:x"}\n\xff\xfe bad\n')
   450	    r = run(v)
   451	    check(
   452	        "N4/非 UTF-8 字节",
   453	        r.returncode != 0 and "非 UTF-8 字节" in r.stderr and "Traceback" not in r.stderr,
   454	        f"rc={r.returncode} clean={'Traceback' not in r.stderr} | {last_line(r.stderr)}",
   455	    )
   456	
   457	    print("\n── N5 (MEDIUM) 多 pending 并存 → attempt 序数不可从账本边界确证 ──")
   458	    v = new_vault("n5")
   459	    e1 = _pending_row(review_time="2026-08-03T10:00:00Z")
   460	    e1["event_id"] = "quiz:板A#q1"
   461	    e1["effective_at"] = "2026-08-03T10:00:00Z"
   462	    e2 = _pending_row(
   463	        review_time="2026-08-04T10:00:00Z",
   464	        attempt_count=2,
   465	        exam_board="检验白板/测试检验-2026-08-01-1000.md",
   466	    )
   467	    e2["event_id"] = "quiz:" + EID
   468	    e2["effective_at"] = "2026-08-04T10:00:00Z"
   469	    write_rows(v, e1, e2)
   470	    r = run(v)
   471	    check(
   472	        "N5/A2 不变量破坏时报真因",
   473	        r.returncode != 0 and "不变量已被破坏" in r.stderr and not fsrs_fields(v),
   474	        f"rc={r.returncode} | {last_line(r.stderr)}",
   475	    )
