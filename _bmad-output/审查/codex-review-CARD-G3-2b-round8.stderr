   639	def _normalize_inline_calibration(fm_text):
   640	    """`calibration_log: []` (inline 空列表) 必须先原子改写成 block 形态, 否则
   641	    后面直接在它下面插缩进条目会产出**非法 YAML** (`calibration_log: []` 后跟
   642	    缩进列表) —— 实测首次评分 rc=0 且 attempt/W/账本都已推进, 同事件重跑却报
   643	    「FSRS 已应用但缺校准记录」⇒ 两阶段流程**永久不收敛** (Codex round-6 HIGH)。
   644	    """
   645	    return re.sub(r"^calibration_log:[ \t]*\[[ \t]*\][ \t]*$", "calibration_log:", fm_text, count=1, flags=re.M)
   646	
