  1233	def _golden_manifest() -> Optional[dict]:
  1234	    """定位同仓 G3-4 golden manifest (库版本/参数 hash 真值源)。
  1235	
  1236	    只接受**含两个真值键的 dict**; 缺失/损坏/空对象/非 dict 一律 → None,
  1237	    调用方降级为形状校验 + WARN (round-4 MEDIUM: 非 dict 曾可 traceback)。
  1238	    """
  1239	    candidate = Path(__file__).resolve().parents[1] / "tests" / "regression" / "fsrs_golden_manifest.json"
  1240	    if not candidate.is_file():
  1241	        return None
  1242	    try:
  1243	        data = json.loads(candidate.read_text(encoding="utf-8"))
  1244	    except (OSError, ValueError, RecursionError):
  1245	        return None
  1246	    if not isinstance(data, dict):
  1247	        return None
  1248	    version, params_hash = data.get("library_version"), data.get("params_hash")
  1249	    # round-5 MEDIUM: 只查"是字符串"不够 — 空串或畸形值会让真值绑定形同虚设
  1250	    if not isinstance(version, str) or not _VERSION_RE.match(version):
  1251	        return None
  1252	    if not isinstance(params_hash, str) or not _HASH_RE.match(params_hash):
  1253	        return None
  1254	    return data
