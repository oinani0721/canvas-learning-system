  2018	    )
  2019	    b["effective_at"] = "2026-08-04T10:00:00Z"
  2020	    _write_ledger(vault, a, b)
  2021	    r5 = _run_writer(vault, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z"))
