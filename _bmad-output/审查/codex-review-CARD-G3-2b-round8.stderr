  1209	# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
  1210	# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
  1211	# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
  1212	# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
  1213	# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
  1214	
  1215	
  1216	def _strip_calibration(vault: Path) -> None:
  1217	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1218	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1219	    head, fm, body = text.split("---\n", 2)
  1220	    lines, out, skipping = fm.split("\n"), [], False
  1221	    for ln in lines:
  1222	        if ln.startswith("calibration_log:"):
  1223	            skipping = True
  1224	            continue
  1225	        if skipping and (ln.startswith("  ") or ln == ""):
  1226	            continue
  1227	        skipping = False
  1228	        out.append(ln)
  1229	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1230	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1231	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1232	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1233	
  1234	
  1235	def test_six_cell_state_machine_closed(vault):
  1236	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1237	    foreign = _review_row(event_id="quiz:板A#q1")
  1238	    _write_ledger(vault, foreign)
  1239	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z"))
  1240	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1241	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1242	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1243	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1244	
  1245	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1246	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1247	    sha_before = _sha(vault / NODE_REL)
  1248	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
  1249	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1250	    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
  1251	    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
  1252	
  1253	    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
  1254	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1255	    (vault / "learning_events.jsonl").unlink()
  1256	    assert _run_writer(vault, _payload()).returncode == 0
  1257	    sha_full = _sha(vault / NODE_REL)
  1258	    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
  1259	    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
  1260	    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
  1261	
  1262	    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
  1263	    _strip_calibration(vault)
  1264	    sha_stripped = _sha(vault / NODE_REL)
  1265	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1266	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1267	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1268	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1269	
  1270	    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
  1271	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1272	    (vault / "learning_events.jsonl").unlink()
  1273	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1274	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1275	    ema_before = {
  1276	        k: re.search(rf"^{k}:.*", _fm(vault), re.M).group(0)
  1277	        for k in ("mastery_score", "mastery_a", "mastery_b", "attempt_count")
  1278	    }
  1279	    r5 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
  1280	    assert r5.returncode == 0 and "degraded 遗留" in r5.stdout, r5.stdout + r5.stderr
  1281	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "格5: FSRS 必须补齐"
  1282	    for k, v in ema_before.items():
  1283	        assert re.search(rf"^{k}:.*", _fm(vault), re.M).group(0) == v, f"格5: {k} 不得二次吸收"
  1284	    assert len(_ledger_lines(vault)) == 1
  1285	
  1286	    # ── 格6 dup=有, f1=F, applied=F: 崩溃窗口① → 全套补齐且与直接应用字节相同
  1287	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1288	    (vault / "learning_events.jsonl").unlink()
  1289	    assert _run_writer(vault, _payload()).returncode == 0
  1290	    golden = (vault / NODE_REL).read_bytes()
  1291	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1292	    r6 = _run_writer(vault, _payload(ts="2026-09-01T10:00:00Z"))
  1293	    assert r6.returncode == 0 and "崩溃窗口" in r6.stdout, r6.stdout + r6.stderr
  1294	    assert (vault / NODE_REL).read_bytes() == golden, "格6: 恢复产物必须与直接应用逐字节相同"
  1295	    assert len(_ledger_lines(vault)) == 1
  1296	    assert _run_validator(vault).returncode == 0, "六格走完后账本仍须过校验器"
