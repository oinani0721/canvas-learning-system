  2846	    LED.unlink(missing_ok=True)
  2847	    rb = _run_writer(vault, _payload(node="节点/ .md", event_id="板A#q1", ts=TS1, review_time=TS1))
  2848	    assert rb.returncode != 0, "写出去的事件将永远路由不到任何节点"
  2849	    assert "派生出的 node_id 不可用" in rb.stderr, rb.stderr[:250]
  2850	    assert not LED.exists() or not _ledger_lines(vault), "不得先落账"
  2851	
  2852	    # H② E1(真值 1) → 历史 L2(无 count) → 历史 L3(3)
  2853	    def _chain(e1_count):
  2854	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2855	        LED.unlink(missing_ok=True)
  2856	        for eid, ts in (("E1#q1", TS1), ("L2#q1", "2026-08-01T11:00:00Z"), ("L3#q1", "2026-08-01T12:00:00Z")):
  2857	            assert _run_writer_settled(vault, _payload(event_id=eid, ts=ts, review_time=ts)).returncode == 0
  2858	        rows = list(_ledger_lines(vault))
  2859	        rows[0]["payload"]["attempt_count"] = e1_count
  2860	        rows[1]["payload"] = {"exam_board": "旧板", "note": "无 count"}
  2861	        rows[2]["payload"] = {"exam_board": "旧板", "note": "有 count", "attempt_count": 3}
  2862	        LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  2863	        assert _run_validator(vault).returncode == 0, "该账本本身合规"
  2864	        return _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1))
  2865	
  2866	    # 修复前是**反的**：错值 2 被接受、真值 1 被报冲突。
  2867	    assert _chain(1).returncode == 0, "真值必须放行"
  2868	    r_wrong = _chain(2)
