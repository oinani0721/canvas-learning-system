   648	def _append_calibration(fm_text, ts_str, ev=None):
   649	    fm_text = _normalize_inline_calibration(fm_text)
   650	    """calibration_log 条目 (正常 / 恢复 / A2 重放三路径共用)。ts_str = 业务生效
   651	    时刻 (review_time — 与 effective_at 同源, 保证恢复产物与直接应用逐字节对齐)。
   652	
   653	    ev=None ⇒ 记本次评分, 字段取本次 payload。
   654	    ev=某条 durable 行 ⇒ **复放**那次评分的校准条目, 字段取该行 payload;
   655	      question_id / self_confidence_* 不在事件载荷里, 记 null。
   656	      ⚠️ 但 event_id / ts / exam_board / grade_norm / abandoned 都在, 够让 F1
   657	      判定命中 —— 于是被恢复的那张检验白板重跑时能走「已完整应用, 幂等跳过」,
   658	      而不是撞上「FSRS 已应用但缺校准记录」的人工裁定 (审查实测: 缺了这一步,
   659	      那张白板**永久卡在** scored_pending_node_update)。
   660	    """
   661	    q_ = lambda v: json.dumps(v, ensure_ascii=False)
   662	    if ev is None:
   663	        # ⛔ 正常路径也必须存**完整**账本 event_id (Codex round-6 BLOCKER):
   664	        # round-5 我只把 foreign 分支改成存完整 id, 正常分支仍存裸 `eid` ——
   665	        # 两条路径写进 calibration_log 的键**不是同一个东西**。实测漏算链:
   666	        # 先提交 event_id="quiz:K" ⇒ 账本行是 `quiz:quiz:K` 而校准记的是 `quiz:K`;
   667	        # 再提交另一个事件 `K`(完整 id 也是 `quiz:K`) ⇒ F1 命中那条校准、判「已完整
   668	        # 应用」而幂等跳过, **那次评分静默不入账**(rc=0, attempt 停在 1)。
   669	        # 修一半比不修更危险: 它把不一致藏进了「已经修过」的地方。
   670	        _e_id, _e_pl = evid, p
   671	        _e_ab, _e_gn = bool(p.get("abandoned")), GN2
   672	        _e_qid = q_(p.get("question_id", "q1"))
   673	        _e_scr, scn_ = q_(p.get("self_confidence_raw") or "null"), p.get("self_confidence_norm")
   674	    else:
   675	        _e_pl = ev.get("payload") or {}
   676	        # ⛔ 存**完整**账本 event_id, 不剥 `quiz:` 前缀 (Codex round-5 BLOCKER):
   677	        # 剥完之后 `quiz:K` 与 `K` 变成同一个键, F1 判定无法区分 —— 实测账本 3 次
   678	        # 评分只记 2 条校准、attempt 停在 2, **一次复习静默消失且 rc=0 无提示**。
   679	        # (另两种 attempt 排列恰好被序数门兜住而 fail-closed —— 那是巧合不是设计,
   680	        #  「被别的门兜住」不等于缺陷不存在。)
   681	        _e_id = str(ev.get("event_id") or "")
   682	        _e_ab, _e_gn = ev.get("event_type") == "answer_abandoned", _e_pl.get("grade_norm")
   683	        _e_qid, _e_scr, scn_ = "null", "null", None
   684	    entry_ = (f'  - event_id: {q_(_e_id)}\n'
   685	              f'    ts: {q_(ts_str)}\n'
   686	              f'    exam_board: {q_(_e_pl.get("exam_board",""))}\n'
   687	              f'    question_id: {_e_qid}\n'
   688	              f'    self_confidence_raw: {_e_scr}\n'
   689	              f'    self_confidence_norm: {scn_ if scn_ is not None else "null"}\n'
   690	              f'    grade_norm: {_e_gn}\n'
   691	              f'    abandoned: {"true" if _e_ab else "false"}')
   692	    # F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   693	    # 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   694	    # Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   695	    # 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   696	    mcal_ = re.search(r'^calibration_log:', fm_text, re.M)
   697	    if mcal_:
   698	        lines_ = fm_text.split("\n")
   699	        li_ = next(i for i, ln in enumerate(lines_) if re.match(r'^calibration_log:', ln))
   700	        j_ = li_ + 1
   701	        while j_ < len(lines_) and lines_[j_].startswith("  "):
   702	            j_ += 1
   703	        lines_[j_:j_] = entry_.split("\n")
   704	        return "\n".join(lines_)
   705	    return fm_text.rstrip() + "\ncalibration_log:\n" + entry_
