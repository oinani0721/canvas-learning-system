   242	def r4():
   243	    print("\n── R4 (HIGH) 含 idle + A3 bump: 正常与恢复产物必须逐字节相同 ──")
   244	    v = new_vault("r4", NODE_IDLE_A3)
   245	    assert run(v).returncode == 0
   246	    golden = (v / NODE_REL).read_bytes()
   247	    rt = rows(v)[0]["payload"]["review_time"]
   248	    (v / NODE_REL).write_text(NODE_IDLE_A3, encoding="utf-8")  # 崩溃窗口①
   249	    r = run(v, ts="2026-09-15T09:30:00Z")
   250	    same = (v / NODE_REL).read_bytes() == golden
   251	    check(
   252	        "R4/字节对拍",
   253	        r.returncode == 0 and same and len(rows(v)) == 1,
   254	        f"review_time={rt} (payload ts={TS1}) rc={r.returncode} 字节相同={same} "
   255	        f"正常sha={hashlib.sha256(golden).hexdigest()[:12]} 恢复sha={sha(v / NODE_REL)[:12]}",
   256	    )
