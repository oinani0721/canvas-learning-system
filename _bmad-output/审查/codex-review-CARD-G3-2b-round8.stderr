  1169	def test_r6_schema_declares_identity_key_integrity_owner():
  1170	    """round-3 MEDIUM: 门㉕锁定的「两个身份键排除出 envelope 等价面」此前只
  1171	    活在实现与测试里, 契约 §6.2 原文仍只排除 recorded_at — 实现与契约两个
  1172	    口径。本门锁定回写: 归属方 (validator golden manifest 绑定门) 与 candidate
  1173	    独立构造的禁令都必须在冻结契约里可查。"""
  1174	    doc = (WT / "docs" / "learning-events-schema-v1.md").read_text(encoding="utf-8")
  1175	    seg = doc[doc.index("duplicate 命中后的状态推进门") : doc.index("**A5 整秒精度")]
  1176	    for needle in (
  1177	        "fsrs_library_version",
  1178	        "fsrs_params_hash",
  1179	        "排除出 envelope 等价面",
  1180	        "golden manifest 绑定门",
  1181	        "candidate 必须独立字面构造",
  1182	        "多一键、少一键或值不同",
  1183	    ):
  1184	        assert needle in seg, f"§6.2 duplicate 门段落缺「{needle}」— 契约未同步实现裁决"
  1185	    # A5 段必须写明 A2 消费侧的机械强制 (R2 的契约面)
  1186	    a5 = doc[doc.index("**A5 整秒精度") : doc.index("**三态语义")]
  1187	    assert "A2 消费侧同样机械强制" in a5 and "禁止消费时顺手归一化" in a5, a5[:400]
  1188	    # A4.5 短写段必须写明「截断 vs 完整损坏」的 LF 判据 (R7 的契约面)
  1189	    assert "可容忍的截断 vs 完整损坏" in doc and "不以 LF 结尾" in doc
  1190	    # round-4 HIGH 的契约面: A8 必须写明「先过校验器本体、再叠加更严的」,
  1191	    # 否则「比校验器严」那句会被读成「消费侧可以另起一套判据」——本卡正是
  1192	    # 这么读的, 于是手写的第二套判据在 4 个形态上比校验器**松**。
  1193	    a8 = doc[doc.index("**A8 消费侧准入") : doc.index("**A9 恢复先落定")]
  1194	    for needle in (
  1195	        "validate_record_full",
  1196	        "先过校验器本体",
  1197	        "顶层必须是 JSON object",
  1198	        "归属判断必须排在",
  1199	        "不得越权阻塞",
  1200	    ):
  1201	        assert needle in a8, f"§6.2 A8 段缺「{needle}」— round-4 裁决未回写契约"
  1202	    # 三态语义段必须写明 out_of_order 的**写点侧** fail-closed 口径 (N1 的契约面)
  1203	    # —— proof 侧是「报违规仍计入」, 在线写路径不能照搬, 两个口径必须分开写清楚。
  1204	    oo = doc[doc.index("**`out_of_order` 字段冻结") : doc.index("**迟到事件的入账通道**")]
  1205	    for needle in ("写点（在线 A2）侧同款语义门", "fail-closed", "被伪装成乱序的真实后继", "唯一合法值布尔 `true`"):
  1206	        assert needle in oo, f"§6.2 三态语义段缺「{needle}」— 写点侧口径未回写契约"
