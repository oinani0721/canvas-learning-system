   108	
   109	
   110	_ONE_MINUTE = timedelta(minutes=1)
   111	
   112	
   113	def _steps_to_minutes(steps) -> list[int]:
   114	    """timedelta 序列 → 整分钟列表。非整分钟步长直接抛错, 不静默截断。
   115	
   116	    用 timedelta 整除/取余 (内部纯整数微秒), 不走 total_seconds() 浮点 ——
   117	    json.dumps 把 1.0 写成 "1.0"、1 写成 "1", hash 会分叉。
   118	    """
   119	    minutes: list[int] = []
   120	    for td in steps:
   121	        if td % _ONE_MINUTE != timedelta(0):
   122	            raise ValueError(f"学习步长 {td!r} 非整分钟, 无法用 *_steps_minutes 表达")
   123	        minutes.append(td // _ONE_MINUTE)
   124	    return minutes
   125	
   126	
   127	def scheduler_identity(sched) -> tuple[str, str]:
   128	    """从活体 fsrs Scheduler 反推 (library_version, params_hash)。
   129	
   130	    params_hash 口径与 backend/scripts/generate_fsrs_golden_vectors.py::
   131	    params_hash() 逐字一致 (sha256 of canonical JSON, 六键形状), 零硬编码 ——
   132	    golden manifest 真值相等是被**复算证明**的, 不是被声明的。库/参数升级时
   133	    此处如实返回新身份, 与 manifest 的相等性检查由校验器负责。
   134	    """
   135	    from importlib.metadata import version as _pkg_version
   136	
   137	    config = {
   138	        "parameters": [float(p) for p in sched.parameters],
   139	        "desired_retention": float(sched.desired_retention),
   140	        "learning_steps_minutes": _steps_to_minutes(sched.learning_steps),
   141	        "relearning_steps_minutes": _steps_to_minutes(sched.relearning_steps),
   142	        "maximum_interval": int(sched.maximum_interval),
   143	        "enable_fuzzing": bool(sched.enable_fuzzing),
   144	    }
   145	    canonical = json.dumps(config, sort_keys=True, separators=(",", ":"))
   146	    return _pkg_version("fsrs"), hashlib.sha256(canonical.encode("utf-8")).hexdigest()
   147	
   148	
   149	def fields_from_frontmatter(fm: str) -> dict:
   150	    """从 frontmatter 文本抽 fsrs_* 字段 (纯 stdlib, 读侧同款正则)。"""
   151	    out = {}
   152	    for key in FIELD_ORDER:
   153	        m = re.search(rf'^{key}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   154	        if m:
   155	            out[key] = m.group(1).strip()
   156	    return out
   157	
   158	
   159	def _legacy_param(v):
   160	    """legacy state:0 伴生参数哨兵归一: 空/null/~/0/0.0/不可解析 → None。"""
   161	    if v in (None, ""):
   162	        return None
   163	    s = str(v).strip().lower()
   164	    if s in ("null", "none", "~"):
   165	        return None
   166	    try:
   167	        return None if float(s) == 0.0 else v
   168	    except ValueError:
   169	        return None
   170	
   171	
   172	#: A7 review 域上界 (schema v1 §6.2): review_time 与 W 同域同界且均须严格小于。
   173	#: 调度会在其上叠加 interval, A3 还要 +1s —— 逼近上界时新事件不可写, fail-closed。
   174	_REVIEW_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   175	
   176	
   177	def review(fields: dict, grade_norm: float, abandoned: bool, ts: str, rating: int | None = None) -> dict:
   178	    """一次评分 → 新 fsrs_* 字段 (需要 fsrs 可导入)。
   179	
   180	    G3-2 时刻语义 (schema v1 §6.2 A3/A5/A6):
   181	      - ts 归一 UTC 整秒后作为本次 review 时刻 (写出的 fsrs_last_review 与
   182	        返回的 review_time 逐字相同);
   183	      - 若当前 frontmatter 有 W (fsrs_last_review) 且本次时刻 ≤ W, 推进到
   184	        W+1s 再写 (A3 等时唯一口径: 推进不拒绝);
   185	      - rating 可显式指定 (A2 pending 重放按事件已断言的 rating 复算),
   186	        缺省按 grade_norm+abandoned 推导; abandoned 恒为 1 (弃答一票否决);
   187	        显式值必须与 rating_from_grade(grade_norm, abandoned) **相等** —— 不
   188	        自洽的 pending 行在 apply 前拒绝, 不靠事后 validator 兜 (R5)。
   189	    """
   190	    from fsrs import Card, Rating, Scheduler, State
   191	
   192	    now = _whole_second(_aware(ts))
   193	    if now >= _REVIEW_MAX:
   194	        raise ValueError(f"review 时刻 {ts!r} 越出 A7 review 域上界 (须严格小于 {_iso(_REVIEW_MAX)})")
   195	    if rating is not None:
   196	        # 严格 int (Codex round-1 MEDIUM): int(1.5)==1 会把非法 pending 行
   197	        # 静默应用; §6.1 冻结 rating 为真 int 1-4, bool 伪装同样拒绝。
   198	        if isinstance(rating, bool) or not isinstance(rating, int) or rating not in (1, 2, 3, 4):
   199	            raise ValueError(f"显式 rating 必须为 int 1-4, 实为 {rating!r}")
   200	        # 评分事实自洽 (Codex round-3 HIGH R5; 含 round-2 HIGH 的 abandoned 分项):
   201	        # 类型/范围合法 ≠ 与本行的评分事实自洽。`answer_scored + grade_norm=0.75
   202	        # + rating=4` 三项单看都合法, 但 [Decision-FSRS-1] 下 0.75 的契约值是 3
   203	        # —— 旧实现照单全收并推进 FSRS, 事后才由 validator 判 FAIL (损坏基线上
   204	        # 已叠加一次调度)。rating 是 grade_norm/abandoned 的**纯函数**, 故在
   205	        # apply 前机械复算并要求相等; abandoned=true 由 rating_from_grade 一票
   206	        # 否决为 1, 弃答给非 1 的 rating 同样落在本门内。
   207	        _expect = rating_from_grade(grade_norm, abandoned)
   208	        if rating != _expect:
   209	            raise ValueError(
   210	                f"显式 rating {rating} 与评分事实不自洽 "
   211	                f"(grade_norm={grade_norm!r}, abandoned={abandoned!r} ⇒ 契约值 {_expect})"
   212	            )
   213	    if abandoned:
   214	        used_rating = 1
   215	    elif rating is not None:
   216	        used_rating = rating
   217	    else:
   218	        used_rating = rating_from_grade(grade_norm, abandoned)
   219	
   220	    sched = Scheduler(enable_fuzzing=False)
   221	    if fields.get("fsrs_due"):
   222	        step = fields.get("fsrs_step")
   223	        stability = fields.get("fsrs_stability")
   224	        difficulty = fields.get("fsrs_difficulty")
   225	        raw_state = int(fields.get("fsrs_state", 1))
   226	        if raw_state == 0:
   227	            # legacy New 形状字段级迁移 (CARD-C3, roundtrip 显式例外):
   228	            # state 0→Learning(1) — py-fsrs 4+ 无 New 态, State(0) 抛
   229	            # ValueError; 伴生哨兵 0/0.0/null → None (0.0 会进 v6 稳定度
   230	            # 幂运算抛 ZeroDivisionError); step 兜底 0 (Learning 首步)。
   231	            raw_state = 1
   232	            stability = _legacy_param(stability)
   233	            difficulty = _legacy_param(difficulty)
   234	            step = _legacy_param(step) or 0
   235	        card = Card(
   236	            state=State(raw_state),
   237	            step=int(step) if step not in (None, "") else None,
   238	            stability=float(stability) if stability else None,
   239	            difficulty=float(difficulty) if difficulty else None,
   240	            due=_aware(fields["fsrs_due"]),
   241	            last_review=_aware(fields["fsrs_last_review"]) if fields.get("fsrs_last_review") else None,
   242	        )
   243	        # A3 等时消解: 时刻 ≤ W → 推进 W+1s (写侧唯一口径, 禁止拒绝丢评分)。
   244	        # W 与 review_time 同域同界, W+1s 越出 A7 上界 ⇒ 后继不可写, fail-closed。
   245	        if fields.get("fsrs_last_review"):
   246	            w = _whole_second(_aware(fields["fsrs_last_review"]))
   247	            if now <= w:
   248	                bumped = w + timedelta(seconds=1)
   249	                if bumped >= _REVIEW_MAX:
   250	                    raise ValueError(f"A3 推进 W+1s 越出 A7 上界 (W={_iso(w)}) — 后继事件不可写")
   251	                now = bumped
   252	    else:
   253	        card = Card(due=now)  # 无字段 = New 卡即刻到期 (零迁移)
   254	
   255	    card, _log = sched.review_card(
   256	        card, Rating(used_rating), review_datetime=now
   257	    )
   258	    lib_ver, p_hash = scheduler_identity(sched)
   259	    out = {
   260	        "fsrs_due": _iso(card.due),
   261	        "fsrs_state": int(card.state),
   262	        "fsrs_step": card.step if card.step is not None else "",
   263	        "fsrs_stability": round(card.stability, 4) if card.stability is not None else "",
   264	        "fsrs_difficulty": round(card.difficulty, 4) if card.difficulty is not None else "",
   265	        "fsrs_last_review": _iso(now),
   266	        # G3-2 加性输出: 调用方必须把 review_time 原样写进事件 payload
   267	        # (与 effective_at 同一瞬间), 不要自己另算一份。
   268	        "review_time": _iso(now),
   269	        "rating": used_rating,
   270	        "fsrs_library_version": lib_ver,
   271	        "fsrs_params_hash": p_hash,
   272	    }
   273	    out["fm_block"] = "\n".join(
   274	        f"{k}: {out[k]}" for k in FIELD_ORDER if out[k] != ""
   275	    )
   276	    return out
   277	
   278	
   279	def _ensure_fsrs() -> bool:
   280	    try:
   281	        import fsrs  # noqa: F401
   282	        return True
   283	    except ImportError:
   284	        venv_py = _venv_python()
   285	        if os.environ.get("FSRS_BRIDGE_REEXEC") != "1" and venv_py:
   286	            os.environ["FSRS_BRIDGE_REEXEC"] = "1"
   287	            os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
   288	        return False
   289	
   290	
   291	def main() -> int:
   292	    if not _ensure_fsrs():
   293	        print(json.dumps({"error": "fsrs_unavailable — backend/.venv 缺失或未装 fsrs"}))
   294	        return 3
   295	    p = json.load(sys.stdin)
   296	    try:
   297	        out = review(
   298	            fields_from_frontmatter(p.get("fm", "")),
   299	            float(p.get("grade_norm", 0.0)),
   300	            bool(p.get("abandoned")),
   301	            p["ts"],
   302	            rating=p.get("rating"),
   303	        )
   304	    except ValueError as e:
   305	        # G3-2: naive/越界/非法 rating 等输入缺陷 —— 拒绝并 stdout 明说,
   306	        # 不静默降级。exit 2 = 输入错误 (区别于 3 = fsrs 不可用)。
   307	        print(json.dumps({"error": f"invalid_input — {e}"}, ensure_ascii=False))
   308	        return 2
   309	    print(json.dumps(out, ensure_ascii=False))
   310	    return 0
   311	
   312	
   313	if __name__ == "__main__":
   314	    sys.exit(main())

