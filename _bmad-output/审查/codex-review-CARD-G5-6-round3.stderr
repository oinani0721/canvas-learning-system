   884	def test_symlinked_item_is_skipped_with_trace(tmp_path):
   885	    """收件箱内的 symlink 条目: 不跟随, 跳过并留痕 (不静默消失)。"""
   886	    vault, out = base_vault(tmp_path)
   887	    outside = tmp_path / "outside.md"
   888	    outside.write_text("外部内容。\n", encoding="utf-8")
   889	    (vault / "_待处理" / "链接.md").symlink_to(outside)
   890	    mk(vault / "_待处理" / "正常.md", "# t\n\n正文一。\n正文二。\n", age_days=2)
   891	
   892	    assert run_cli(vault, out).returncode == 0
   893	    data = load_json(out)
   894	    assert [i["name"] for i in data["items"]] == ["正常.md"]
   895	    skipped = {s["name"]: s["reason"] for s in data["inventory"]["skipped"]}
   896	    assert "链接.md" in skipped and "symlink" in skipped["链接.md"].lower()
   897	
   898	
   899	# ───────────────────────── F. 分批 / 台账 / 空仓 ─────────────────────────
   900	
   901	
   902	def test_batch_is_oldest_first_capped_at_ten(tmp_path):
   903	    vault, out = base_vault(tmp_path)
   904	    inbox = vault / "_待处理"
   905	    for i in range(1, 24):  # 23 件, 年龄 1..23 天
   906	        mk(inbox / f"件{i:02d}.md", f"# {i}\n\n正文一 {i}。\n正文二 {i}。\n", age_days=i)
   907	
   908	    assert run_cli(vault, out).returncode == 0
   909	    data = load_json(out)
   910	    inv = data["inventory"]
   911	    assert inv["total"] == 23
   912	    assert inv["over_budget"] is True
   913	    assert len(data["items"]) == 10
   914	    # 最旧优先: 23 天的排第一, 14 天的排第十
   915	    assert [i["name"] for i in data["items"]] == [f"件{n:02d}.md" for n in range(23, 13, -1)]
   916	    assert len(inv["deferred"]) == 13
   917	    assert inv["deferred"][0]["name"] == "件13.md"
   918	
   919	
   920	def test_batch_size_override_within_budget(tmp_path):
   921	    vault, out = base_vault(tmp_path)
   922	    for i in range(1, 6):
   923	        mk(vault / "_待处理" / f"f{i}.md", f"# {i}\n\n正文一。\n正文二。\n", age_days=i)
   924	    assert run_cli(vault, out, "--batch-size", "3").returncode == 0
   925	    data = load_json(out)
   926	    assert len(data["items"]) == 3
   927	    assert data["inventory"]["batch_size"] == 3
   928	
