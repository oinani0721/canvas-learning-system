   632	def test_engine_never_emits_human_only_verdicts(tmp_path):
   633	    """「归入白板」「新建节点」需要语义判断 —— 引擎恒不产出, 且必须显式声明该边界。"""
   634	    vault, out = base_vault(tmp_path)
   635	    inbox = vault / "_待处理"
   636	    mk(inbox / "a.md", "# A\n\n正文内容一。\n正文内容二。\n", age_days=3)
   637	    mk(inbox / "b.md", "---\nsource: https://x.test/p\n---\n\n正文。\n正文二。\n", age_days=2)
   638	
   639	    assert run_cli(vault, out).returncode == 0
   640	    data = load_json(out)
   641	    vocab = data["verdict_vocabulary"]
   642	    assert set(vocab["human_only"]) == {"归入白板", "新建节点"}
   643	    assert vocab["human_only_note"]
   644	    reachable = set(vocab["reachable_by_engine"])
   645	    for it in data["items"]:
   646	        assert it["verdict"] in reachable
   647	        assert it["verdict"] not in set(vocab["human_only"])
