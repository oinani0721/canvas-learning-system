  1371	def test_source_declared_clipping_is_never_suggested_for_deletion(tmp_path):
  1372	    """⛔ round-3 自审 H1-1/H3-1: C1 判据收窄后,「只有 frontmatter、没有正文」的
  1373	    剪藏不得从「留原地」翻成「空骨架 → 建议删」。
  1374	
  1375	    三道护栏 (显式偏差 15): frontmatter 有 source 声明 / 含解析不成键的行 /
  1376	    文件以未闭合 HTML 注释结尾 → 一律落 C6 拿不准, 永不判 C3。
  1377	    同时覆盖: 引号+行尾注释的 source 仍走 C1 (先剥注释再剥引号)、
  1378	    冒号前空格的键仍被解析、大写 scheme 仍是一手来源。
  1379	    """
  1380	    vault, out = base_vault(tmp_path)
  1381	    inbox = vault / "_待处理"
  1382	    # 护栏 A: source 声明了但不是合法 URL, 无正文 → 拿不准, 不建议删
  1383	    mk(inbox / "空host剪藏.md", "---\nsource: https://:443/x\n---\n", age_days=9)
  1384	    mk(inbox / "空host用户剪藏.md", "---\nsource: https://user@/x\n---\n", age_days=8)
  1385	    # 护栏 B: source 冒号后无空格排在合法键后面 → 该行被吞, 但解析不全不判空骨架
  1386	    mk(
  1387	        inbox / "书签无空格键.md",
  1388	        "---\ntitle: 论文摘录\nsource:https://arxiv.org/abs/2401.00001\n---\n",
  1389	        age_days=7,
  1390	    )
  1391	    # 正向对照: 合法 source + 无正文 → 仍 C1 留原地 (C1 在 C3 之前, 剪藏受保护)
  1392	    mk(inbox / "正常空剪藏.md", "---\nsource: https://ok.test/clip\n---\n", age_days=6)
  1393	    # 引号 + 行尾注释组合: 先剥注释再剥引号 → C1
  1394	    mk(
  1395	        inbox / "引号注释剪藏.md",
  1396	        '---\nsource: "https://quoted.test/x" # 官方来源\n---\n',
  1397	        age_days=5,
  1398	    )
  1399	    # 冒号前空格: `source : url` 也是合法 YAML 键 (pyyaml 同判) → C1
  1400	    mk(inbox / "冒号前空格剪藏.md", "---\nsource : https://spaced.test/x\n---\n", age_days=4)
  1401	    # 大写 scheme: RFC 3986 §3.1 大小写不敏感 → C1
  1402	    mk(
  1403	        inbox / "大写scheme.md",
  1404	        "---\nsource: HTTPS://Upper.Test/a\n---\n\n正文一。\n正文二。\n",
  1405	        age_days=3,
  1406	    )
  1407	    # 正向对照: 无 source 的纯空骨架 → 仍 C3 建议删 (护栏不得误伤存量判据)
  1408	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=2)
  1409	
  1410	    assert run_cli(vault, out).returncode == 0
  1411	    data = load_json(out)
  1412	    for name in ("空host剪藏.md", "空host用户剪藏.md", "书签无空格键.md"):
  1413	        it = item_by_name(data, name)
  1414	        assert it["verdict"] != "建议删", f"{name} 被护栏漏掉了: {it['basis']}"
  1415	        assert it["criterion"] == "C6_undecided", name
  1416	        assert it["confident"] is False, name
  1417	    for name in (
  1418	        "正常空剪藏.md",
  1419	        "引号注释剪藏.md",
  1420	        "冒号前空格剪藏.md",
  1421	        "大写scheme.md",
  1422	    ):
  1423	        it = item_by_name(data, name)
  1424	        assert it["criterion"] == "C1_source_url", f"{name}: {it['basis']}"
  1425	        assert it["verdict"] == "留原地", name
  1426	    quoted = item_by_name(data, "引号注释剪藏.md")
  1427	    assert "官方来源" not in quoted["basis"], quoted["basis"]
  1428	    skeleton = item_by_name(data, "纯空骨架.md")
  1429	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1430	    assert skeleton["verdict"] == "建议删"
