   930	def test_sleeping_ledger_and_30d_mark(tmp_path):
   931	    """Sleeping 台账: slept_at 优先于 mtime; ≥30 天打标; 不进本批提名。"""
   932	    vault, out = base_vault(tmp_path)
   933	    sleep = vault / "_待处理" / "Sleeping"
   934	    # slept_at 40 天前 (frontmatter 为准, 与 mtime 刻意不一致)
   935	    mk(sleep / "睡满的.md", "---\nslept_at: 2026-07-22\n---\n\n正文。\n", age_days=1)
   936	    # 无 slept_at → 退回 mtime 12 天
   937	    mk(sleep / "睡浅的.md", "# 无 frontmatter\n\n正文。\n", age_days=12)
   938	    mk(vault / "_待处理" / "在批的.md", "# t\n\n正文一。\n正文二。\n", age_days=3)
   939	
   940	    assert run_cli(vault, out).returncode == 0
   941	    data = load_json(out)
   942	    sl = data["sleeping"]
   943	    assert sl["exists"] is True
   944	    assert sl["count"] == 2
   945	    assert sl["over_30d_count"] == 1
   946	    assert sl["oldest_days"] == 40
   947	    by = {s["name"]: s for s in sl["items"]}
   948	    assert by["睡满的.md"]["slept_days"] == 40
   949	    assert by["睡满的.md"]["slept_at_source"] == "frontmatter"
   950	    assert by["睡满的.md"]["over_30d"] is True
   951	    assert by["睡浅的.md"]["slept_days"] == 12
   952	    assert by["睡浅的.md"]["slept_at_source"] == "mtime"
   953	    assert by["睡浅的.md"]["over_30d"] is False
   954	    # Sleeping 不进本批
   955	    assert [i["name"] for i in data["items"]] == ["在批的.md"]
   956	
   957	
   958	def test_sleeping_skips_are_traced_not_silent(tmp_path):
   959	    """Sleeping/ 下的 symlink 与子目录不计入台账, 但必须留痕 —— 与收件箱同一条纪律。"""
   960	    vault, out = base_vault(tmp_path)
   961	    sleep = vault / "_待处理" / "Sleeping"
   962	    mk(sleep / "正常.md", "---\nslept_at: 2026-08-01\n---\n\n正文。\n", age_days=5)
   963	    (sleep / "子目录").mkdir()
   964	    outside = tmp_path / "outside.md"
   965	    outside.write_text("外部。\n", encoding="utf-8")
   966	    (sleep / "链接.md").symlink_to(outside)
   967	
   968	    assert run_cli(vault, out).returncode == 0
   969	    sl = load_json(out)["sleeping"]
   970	    assert [x["name"] for x in sl["items"]] == ["正常.md"]
     1	#!/usr/bin/env python3
     2	"""CARD-G5-6b (c) 负验证: 对五处修复 + round-3 自审整改各做机械变异, 串行执行。
     3	
     4	判据: 「指定的那道门必须变红」—— 不是「某处有失败」。每轮:
     5	  备份 → assert 原串在场(str.replace 不命中不报错, 必须先证) → 变异写回 →
     6	  跑指定门(单 nodeid) → 断言 rc!=0 且输出含 `FAILED …::<gate>` 与 `1 failed`
     7	  (rc=5 零收集不算变红) → 还原 → `cmp` 退出 0 (还原后与备份逐字节相同)。
     8	串行铁律: 本脚本原地改被测文件, 绝不并发。
     9	"""
    10	
    11	import shutil
    12	import subprocess
    13	import sys
    14	from pathlib import Path
    15	
    16	WT = Path("/Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-v6-inbox")
    17	SCRIPT = WT / "canvas-vault/.claude/skills/clear-inbox/scripts/inbox_preview.py"
    18	BACKUP = Path(__file__).parent / "inbox_preview.py.pristine"
    19	TESTFILE = "tests/skills/test_g5_6_clear_inbox.py"
    20	
    21	GUARD = "test_source_declared_clipping_is_never_suggested_for_deletion"
    22	
    23	MUTATIONS = [
    24	    # ── round-2 五处定向修复的 6 条 ──
    25	    (
