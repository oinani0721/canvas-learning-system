   138	        '_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")',
   139	        '_FENCE_RE = re.compile(r"^\\s{0,3}(`{3,}|~{3,})")',
   140	        "test_fence_close_requires_same_char_min_length_and_bare_fence",
   141	    ),
   142	    (
