   676	def test_near_dup_scan_distinguishes_skipped_from_clean(tmp_path):
   677	    """「没比对」与「比对过没有」必须在产物里可区分 —— 否则跳过会伪装成无重复。"""
   678	    vault, out = base_vault(tmp_path)
   679	    mk(vault / "_待处理" / "x.md", "# X\n\n正文一。\n正文二。\n", age_days=2)
   680	    assert run_cli(vault, out).returncode == 0
   681	    scan = load_json(out)["near_dup_scan"]
   682	    for key in ("ratio_threshold", "body_char_cap", "compared_pairs", "skipped_oversize", "skipped_length_prefilter"):
   683	        assert key in scan, f"near_dup_scan 缺 {key}"
   684	    assert scan["ratio_threshold"] >= 0.9
