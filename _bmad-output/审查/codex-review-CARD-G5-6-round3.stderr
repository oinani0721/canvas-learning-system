   431	def test_code_indentation_is_not_normalized_away(tmp_path):
   432	    """⛔ BLOCKER 回归: 逐字比对**不得**抹掉代码缩进。
   433	
   434	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 是语义完全不同的两段代码;
   435	    原实现对每行 `.strip()` 后二者归一化结果相同 → 判「逐字相等」→ **建议删**。
   436	    有后果的提名, 依据必须逐字。
   437	    """
   438	    vault, out = base_vault(tmp_path)
   439	    mk(
   440	        vault / "节点" / "代码正本.md",
   441	        "# 正本\n\n```python\nif ok:\n    run()\n```\n",
   442	        age_days=40,
   443	    )
   444	    mk(
   445	        vault / "_待处理" / "代码副本.md",
   446	        "# 副本\n\n```python\nif ok:\nrun()\n```\n",
   447	        age_days=2,
   448	    )
   449	
   450	    assert run_cli(vault, out).returncode == 0
   451	    it = load_json(out)["items"][0]
   452	    assert it["verdict"] != "建议删", "缩进不同的两段代码被判成逐字重复"
   453	    assert it["exact_duplicate_of"] is None
   454	
