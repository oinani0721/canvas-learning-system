    27	        "tok[0] == fence_char\n                and len(tok) >= fence_len\n                and not ln[m.end() :].strip()",
    28	        "tok[0] == fence_char\n                and not ln[m.end() :].strip()",
    29	        "test_fence_close_requires_same_char_min_length_and_bare_fence",
    30	    ),
