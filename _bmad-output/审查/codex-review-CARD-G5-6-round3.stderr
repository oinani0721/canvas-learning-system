   252	+    整篇不得被吞成 frontmatter 后判成「空骨架 → 建议删」, 更不得给出
   253	+    「其余皆空行」这类假依据。"""
   254	+    vault, out = base_vault(tmp_path)
   255	+    mk(vault / "_待处理" / "裸URL行.md", "---\nhttp://example.com/path\n---\n", age_days=3)
   256	+    # 正向对照: 真正的 frontmatter source 键仍走 C1
   257	+    mk(
   258	+        vault / "_待处理" / "真source.md",
   259	+        "---\nsource: http://example.com/path\n---\n\n正文一。\n正文二。\n",
   260	+        age_days=2,
   261	+    )
   262	+    assert run_cli(vault, out).returncode == 0
   263	+    data = load_json(out)
   264	+    it = item_by_name(data, "裸URL行.md")
   265	+    assert it["criterion"] != "C3_empty_or_skeleton"
   266	+    assert it["verdict"] != "建议删"
   267	+    assert "其余皆空行" not in it["basis"], f"假依据: {it['basis']}"
   268	+    pos = item_by_name(data, "真source.md")
   269	+    assert pos["criterion"] == "C1_source_url"
