   602	    data = load_json(out)
   603	    ai = item_by_name(data, "AI副本.md")
   604	    assert ai["criterion"] == "C2_ai_self_declared", "C4 抢在了 C2 前面"
   605	    assert ai["exact_duplicate_of"] == "节点/AI正本.md"
   606	    rnd = item_by_name(data, "R77_副本.md")
   607	    assert rnd["criterion"] == "C4_exact_duplicate", "C5 抢在了 C4 前面"
