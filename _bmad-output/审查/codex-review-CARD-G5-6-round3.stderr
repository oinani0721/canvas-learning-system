  1526	
  1527	def validate_label(label: str) -> None:
  1528	    if not label or _BAD_LABEL.search(label):
  1529	        raise SystemExit(
  1530	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
  1531	        )
  1532	
  1533	
  1534	def validate_product_filename(label: str) -> None:
  1535	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  1536	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  1537	    for suffix in (".json", ".md"):
  1538	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  1539	        if n > MAX_FILENAME_BYTES:
  1540	            raise SystemExit(
  1541	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  1542	                f"inbox-preview-{label}{suffix}"
  1543	            )
  1544	
  1545	
  1540	            raise SystemExit(
  1541	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  1542	                f"inbox-preview-{label}{suffix}"
  1543	            )
  1544	
  1545	
  1546	def main() -> int:
  1547	    ap = argparse.ArgumentParser(
  1548	        description="待处理盘点提名 preview（只读, CARD-G5-6）"
  1549	    )
  1550	    ap.add_argument("--vault", required=True, help="vault 根目录")
  1551	    ap.add_argument(
  1552	        "--now", required=True, help="基准时刻 ISO-8601（裸时间按 Asia/Shanghai 解释）"
  1553	    )
  1554	    ap.add_argument(
  1555	        "--inbox-dir",
  1556	        default=None,
  1557	        help=f"收件箱目录（缺省 <vault>/{DEFAULT_INBOX_NAME}）。"
  1558	        "显式给定却不存在 = 拒绝；缺省路径不存在 = 空仓回执",
  1559	    )
  1560	    ap.add_argument(
  1561	        "--out-dir",
  1562	        default=None,
  1563	        help="产物目录（缺省 <vault>/outputs；父目录必须已存在）",
  1564	    )
  1565	    ap.add_argument(
  1566	        "--batch-size", type=int, default=BATCH_MAX, help=f"单批件数（1..{BATCH_MAX}）"
  1567	    )
  1568	    args = ap.parse_args()
  1569	
  1570	    # ⛔ 次序铁律：全部输入守卫跑完**再**碰 out-dir —— 拒绝路径必须零产物。
  1571	    if not (1 <= args.batch_size <= BATCH_MAX):
  1572	        raise SystemExit(
  1573	            f"✗ --batch-size 必须在 1..{BATCH_MAX}（D15 确认预算上限，不得突破）, 实得 {args.batch_size}"
  1574	        )
  1575	    now = parse_now(args.now)
  1576	
  1577	    vault = Path(args.vault)
  1578	    if vault.is_symlink():
  1579	        raise SystemExit(f"✗ vault 路径本身是 symlink, 拒绝越界读取: {vault}")
  1580	    if not vault.is_dir():
  1581	        raise SystemExit(f"✗ vault 不存在或不是目录: {vault}")
  1582	    vault = vault.resolve()
  1583	
  1584	    explicit = args.inbox_dir is not None
  1585	    inbox = Path(args.inbox_dir) if explicit else vault / DEFAULT_INBOX_NAME
  1586	    if inbox.is_symlink():
  1587	        raise SystemExit(f"✗ 收件箱目录本身是 symlink, 拒绝越界读取: {inbox}")
  1588	    inbox_exists = inbox.is_dir()
  1589	    if explicit and not inbox_exists:
  1590	        # 用户明确指了路径却找不到 = 写错了。绝不能报成「空仓」把 typo 掩盖掉。
  1591	        raise SystemExit(f"✗ --inbox-dir 指定的目录不存在: {inbox}")
  1592	
  1593	    validate_label(inbox.name)
  1594	    validate_product_filename(inbox.name)
  1595	
  1596	    out_dir_arg = Path(args.out_dir) if args.out_dir else vault / "outputs"
  1597	    inbox_real, out_real = os.path.realpath(inbox), os.path.realpath(out_dir_arg)
  1598	    if out_real == inbox_real or out_real.startswith(inbox_real + os.sep):
  1599	        # ⛔ 否则第一次跑落下的两份产物，第二次跑会被当成待处理材料盘点进来 ——
  1600	        # 「同输入二跑逐字节相等」当场不成立，而且是那种跑两次才看得见的不成立。
  1601	        raise SystemExit(
  1602	            f"✗ 产物目录不能位于收件箱内, 拒绝运行（二跑会把上一次的产物当成待处理材料）: {out_dir_arg}"
  1603	        )
  1604	    excluded = [inbox_real, out_real]
  1605	
  1606	    data = build_preview(vault, inbox, inbox_exists, now, args.batch_size, excluded)
  1607	    payload_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
  1608	    payload_md = render_md(data)
  1609	
  1610	    out_dir = _SP.prepare_out_dir(out_dir_arg)
  1611	    json_path = out_dir / f"inbox-preview-{inbox.name}.json"
  1612	    md_path = out_dir / f"inbox-preview-{inbox.name}.md"
  1613	    _SP.write_pair_atomically_checked(
  1614	        [(json_path, payload_json), (md_path, payload_md)]
  1615	    )
  1616	
  1617	    print(
  1618	        f"✓ preview 已生成（只读引擎, 未动 vault 任何既有文件）: {json_path} / {md_path}"
  1619	    )
  1620	    print(f"  {data['receipt']}")
  1621	    unsure = sum(1 for i in data["items"] if not i["confident"])
  1622	    print(
  1623	        f"  本批 {len(data['items'])} 件 · 拿不准 {unsure} 件 · "
  1624	        f"建议删 {sum(1 for i in data['items'] if i['verdict'] == V_DELETE)} 件"
  1625	    )
  1626	    return 0
  1627	
  1628	
  1629	if __name__ == "__main__":
  1630	    raise SystemExit(main())

