   350	
   351	def _is_primary_source_url(src: str) -> bool:
   352	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   353	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   354	    if not _URL_RE.match(src):
   355	        return False
   356	    try:
   357	        parts = urlsplit(src)
   358	    except ValueError:
   359	        return False
   360	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   361	
   362	
   363	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
