    33	        "if src and _is_primary_source_url(src):",
    34	        "if src and _URL_RE.match(src):",
    35	        "test_url_without_host_is_not_primary_record",
    36	    ),
    37	    (
    38	        "M3-H2a 把裸词「AI 生成」加回表",
    39	        '    "由 Claude 生成",',
    40	        '    "AI 生成",\n    "由 Claude 生成",',
    41	        "test_bare_ai_markers_are_removed_from_table",
    42	    ),
    43	    (
    44	        "M4-H2b 去掉右边界检查",
    45	        "if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:\n            return i\n        if not ascii_ending and ln[j].isspace():\n            return i",
    46	        "if j >= 0:\n            return i",
    47	        "test_ai_marker_needs_boundary_after_literal",
    48	    ),
    49	    (
    50	        "M5-H3 恢复旧键正则(两条一起)",
    51	        '_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\\s*:(?:\\s+(.*))?\\s*$")',
    52	        '_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):\\s*(.*)$")',
    53	        "test_bare_url_line_is_not_a_frontmatter_key",
    54	    ),
    55	    (
    56	        "M6-H4 恢复旧 §四 行(重新钦定正本)",
    57	        """                if it["exact_duplicate_others"]:
    58	                    # ⛔ basis 已声明「哪一份算正本不可判」—— 人读 MD 不得再钦定
    59	                    # 「正本 `字典序首项`」（round-2 H4：JSON 与 MD 自相矛盾）。
    60	                    # 路径**不加反引号**：路径本身含反引号时 code span 会错配吃掉
    61	                    # 字符，渲染出一个不存在的文件名（round-3 自审 H4-1）。
    62	                    all_dups = [
    63	                        it["exact_duplicate_of"],
    64	                        *it["exact_duplicate_others"],
    65	                    ]
    66	                    L.append(
    67	                        f"- **{it['name']}** · 与库内 {len(all_dups)} 份文件"
    68	                        "逐字相同：" + "、".join(all_dups) + " —— 哪一份是正本不可判"
    69	                        "（exact_duplicate_of 仅为字典序代表）"
    70	                    )
    71	                else:
    72	                    L.append(
    73	                        f"- **{it['name']}** · 逐字相同 → 正本 `{it['exact_duplicate_of']}`"
    74	                    )""",
    75	        """                extra = (
    76	                    f"；另有副本 {'、'.join(it['exact_duplicate_others'])}"
    77	                    if it["exact_duplicate_others"]
    78	                    else ""
    79	                )
    80	                L.append(
    81	                    f"- **{it['name']}** · 逐字相同 → 正本 `{it['exact_duplicate_of']}`{extra}"
    82	                )""",
    83	        "test_md_multi_canonical_declares_undecidable_not_crowned",
    84	    ),
    85	    # ── round-3 自审整改的 9 条 ──
    86	    (
