   146	        "test_fence_close_requires_same_char_min_length_and_bare_fence",
   147	    ),
   148	]
   149	
   150	
   151	def run_gate(gate: str) -> subprocess.CompletedProcess:
   152	    return subprocess.run(
   153	        [
   154	            str(WT / "backend/.venv/bin/pytest"),
   155	            f"{TESTFILE}::{gate}",
   156	            "-q",
   157	            "-p",
   158	            "no:cacheprovider",
   159	        ],
   160	        cwd=WT / "backend",
   161	        env={"PYTHONDONTWRITEBYTECODE": "1", "PATH": "/usr/bin:/bin"},
   162	        capture_output=True,
   163	        text=True,
   164	    )
   165	
   166	
   167	def main() -> int:
   168	    pristine = SCRIPT.read_bytes()
   169	    BACKUP.write_bytes(pristine)
   170	    results = []
   171	    ok = True
   172	    for name, old, new, gate in MUTATIONS:
   173	        content = SCRIPT.read_text(encoding="utf-8")
   174	        assert old in content, f"{name}: 原串不在被测文件里, 变异无从施加"
   175	        mutated = content.replace(old, new, 1)
   176	        if name.startswith("M5"):
   177	            looks_old = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:(?:\\s|$)")'
   178	            looks_rev = '_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\\s*:")'
   179	            assert looks_old in mutated, "M5: 第二条正则原串不在场"
   180	            mutated = mutated.replace(looks_old, looks_rev, 1)
   181	        assert mutated != content, f"{name}: 替换后内容未变化"
   182	        SCRIPT.write_text(mutated, encoding="utf-8")
   183	        try:
   184	            r = run_gate(gate)
   185	            out = r.stdout + r.stderr
   186	            failed_marker = f"FAILED {TESTFILE}::{gate}"
   187	            killed = r.returncode != 0 and failed_marker in out and "1 failed" in out
   188	            results.append((name, gate, r.returncode, killed))
   189	            if not killed:
   190	                ok = False
   191	                print(f"✗ {name}: 指定门 {gate} 未变红 (rc={r.returncode})")
   192	                print(out[-1500:])
   193	        finally:
   194	            SCRIPT.write_bytes(pristine)
   195	        cmp = subprocess.run(["/usr/bin/cmp", str(BACKUP), str(SCRIPT)])
   196	        assert cmp.returncode == 0, f"{name}: 还原后与备份不是逐字节相同"
   197	        print(f"{'✓' if results[-1][3] else '✗'} {name} → {gate.split('::')[-1]} "
   198	              f"{'KILLED (门变红)' if results[-1][3] else 'SURVIVED'} · 还原 cmp=0")
   199	    print()
   200	    print(f"{'全部变异均被指定门杀灭' if ok else '存在存活变异 — 门不承重'}: "
   201	          f"{sum(1 for r in results if r[3])}/{len(MUTATIONS)} killed")
   202	    return 0 if ok else 1
   203	
   204	
   205	if __name__ == "__main__":
   206	    sys.exit(main())
