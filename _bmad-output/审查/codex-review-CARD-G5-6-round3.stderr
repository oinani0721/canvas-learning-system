   341	def test_corpus_index_excludes_empty_bodies(tmp_path):
   342	    """索引层自己的门。⛔ 与上一条**不是重复**: 上一条走端到端(受 nominate 的
   343	    `if body` 兜底保护, 单删索引层杀不掉它); 本条直取 scan_corpus, 单删索引层即翻红。
   344	    每层各有一道门, 才不会出现「删掉一层没人发现」。"""
   345	    mod = load_module()
   346	    vault, _ = base_vault(tmp_path)
   347	    mk(vault / "节点" / "空壳甲.md", "---\ntitle: a\n---\n\n# 只有标题\n")
   348	    mk(vault / "节点" / "空壳乙.md", "# 另一个只有标题\n\n## 二级\n\n- \n")
   349	    mk(vault / "节点" / "有正文.md", "真正的正文一行。\n第二行。\n")
   350	
   351	    index, bodies, stats = mod.scan_corpus(vault, [])
   352	    assert "" not in index, "空正文进了重复索引 —— 两个空骨架会互为「正本」"
   353	    assert stats["skipped_empty_body"] == 2
   354	    assert stats["files_indexed"] == 1
   355	    assert all(b for _, b in bodies)
