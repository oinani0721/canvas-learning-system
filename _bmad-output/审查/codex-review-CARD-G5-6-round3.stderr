   960	                uncertain_reason=(
   961	                    f"frontmatter 声明了 source（{fm['source']!r}）但不是可机判的"
   962	                    "一手 URL，文件又没有实质正文 —— 是待补正文的剪藏还是空骨架拿不准"
   963	                ),
   964	                ask=UNDECIDED_ASK,
   965	            )
   966	        return finish(
   967	            "C3_empty_or_skeleton",
   968	            V_DELETE,
   969	            None,
   970	            None,
   971	            skeleton_note(text, item["size_bytes"]),
   972	            True,
   973	        )
   974	
   975	    # ── C4 精确重复（**逐字相等**才算；近似永不到这里） ──
   976	    # ⛔ 批内也有同稿时**不再**否决 C4（Codex MEDIUM 实证）：只要库内已经有一份
   977	    # 逐字相同的，收件箱这份就是多余的 —— 与批内还有几份同稿无关。
   978	    if exact_of:
   979	        if exact_others:
   980	            basis = (
   981	                f"库内已有 {len(exact_all)} 份正文逐字相同的文件："
   982	                + "、".join(exact_all)
   983	                + "。⛔ 哪一份算「正本」不可判（无机械依据），"
   984	                "但收件箱这份相对它们是多余的，故仍建议删"
   985	            )
   986	            conflicts.append(
   987	                {
   988	                    "kind": "multiple_canonical_candidates",
   989	                    "detail": f"库内有 {len(exact_all)} 份同正文文件，"
   990	                    f"`exact_duplicate_of` 取相对路径字典序最小者仅为**可预测的代表**，"
   991	                    "不主张它比其余几份更正本",
   992	                }
   993	            )
   994	        else:
   995	            basis = f"归一化正文与 {exact_of} 逐字相等（sha256 相同）"
   996	        return finish("C4_exact_duplicate", V_DELETE, None, None, basis, True)
   997	
   998	    # ── C5 R{n}_ 文件名 ──
   999	    if rnd:
  1000	        typ = round_type(name)
  1001	        return finish(
  1002	            "C5_round_filename",
  1003	            V_ARCHIVE,
  1004	            typ,
  1005	            f"R{rnd}/",
  1006	            f"文件名带 R{rnd}_ → 归轮次目录"
  1007	            + (
  1008	                f"；子模式命中 → 类型 {typ}"
  1009	                if typ
  1010	                else "；子模式未命中 → 类型留空（去向确定，类型拿不准，不硬填）"
  1011	            ),
  1012	            True,
  1013	            type_uncertain=typ is None,
  1014	        )
  1015	
  1016	    # ── C6 兜底：拿不准（不给去向、不给类型） ──
  1017	    if within_batch:
  1018	        reason = "本批内有正文逐字相同的另一件，谁是正本不可判 —— 不硬猜"
  1019	    elif near:
  1020	        reason = (
  1021	            "疑似与 "
  1022	            + "、".join(f"{n['path']}(ratio {n['ratio']})" for n in near)
  1023	            + " 高相似，但**未逐字相等** —— 近似不等于重复，不硬猜"
  1024	        )
  1025	    else:
  1026	        reason = (
  1027	            "六判据全不命中：无 source URL、文头无 AI 自述、有实质正文、"
  1028	            "与库内无逐字相同正本、文件名无 R{n}_ 轮次标记"
  1029	        )
  1030	    return finish(
  1031	        "C6_undecided",
  1032	        V_UNSURE,
  1033	        None,
  1034	        None,
  1035	        "无机械判据可施加",
  1036	        False,
  1037	        uncertain_reason=reason,
  1038	        ask=UNDECIDED_ASK,
  1039	    )
  1040	
  1041	
  1042	def _fill(
  1043	    item: dict,
  1044	    criterion: str,
  1045	    verdict: str,
  1046	    ntype: str | None,
  1047	    target: str | None,
  1048	    basis: str,
  1049	    confident: bool,
  1050	    *,
  1040	
  1041	
  1042	def _fill(
  1043	    item: dict,
  1044	    criterion: str,
  1045	    verdict: str,
  1046	    ntype: str | None,
  1047	    target: str | None,
  1048	    basis: str,
  1049	    confident: bool,
  1050	    *,
  1051	    uncertain_reason: str | None = None,
  1052	    ask: str | None = None,
  1053	    type_uncertain: bool = False,
  1054	    exact_of: str | None = None,
  1055	    exact_others: list[str] | None = None,
  1056	    near: list[dict] | None = None,
  1057	    conflicts: list[dict] | None = None,
  1058	) -> dict:
  1059	    out = dict(item)
  1060	    out.update(
  1061	        {
  1062	            "criterion": criterion,
  1063	            "verdict": verdict,
  1064	            "nomination_type": ntype,
  1065	            "target_hint": target,
  1066	            "basis": basis,
  1067	            "confident": confident,
  1068	            "type_uncertain": type_uncertain,
  1069	            "uncertain_reason": uncertain_reason,
  1070	            "ask": ask,
  1071	            "exact_duplicate_of": exact_of,
  1072	            "exact_duplicate_others": exact_others or [],
  1073	            "near_duplicates": near or [],
  1074	            "conflicts": conflicts or [],
  1075	        }
  1076	    )
  1077	    return out
