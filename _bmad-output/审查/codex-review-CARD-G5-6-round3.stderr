/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import hashlib, json, shutil, subprocess, tempfile
root=Path('/Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-v6-inbox')
src=root/'canvas-vault/.claude/skills/clear-inbox/scripts/inbox_preview.py'
split=root/'canvas-vault/.claude/skills/board-split/scripts/split_preview.py'
base=Path(tempfile.mkdtemp(prefix='card-g56b-review-',dir='/private/tmp'))
skills=base/'skills'; script=skills/'clear-inbox/scripts/inbox_preview.py'; splitcopy=skills/'board-split/scripts/split_preview.py'
script.parent.mkdir(parents=True); splitcopy.parent.mkdir(parents=True); shutil.copy2(src,script); shutil.copy2(split,splitcopy)
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
print('ROOT='+str(base)); print('SCRIPT_SHA_ORIG='+sha(src)); print('SCRIPT_SHA_COPY='+sha(script)); print('BYTE_IDENTICAL='+str(src.read_bytes()==script.read_bytes()))

def run(case, files, corpus=None):
 d=base/case; v=d/'vault'; inbox=v/'_待处理'; out=d/'out'; (v/'原白板').mkdir(parents=True); (v/'节点').mkdir(parents=True); inbox.mkdir()
 for rel,content in (corpus or {}).items(): p=v/rel; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(content,encoding='utf-8')
 for name,content in files.items(): (inbox/name).write_text(content,encoding='utf-8')
 cmd=['python3','-B',str(script),'--vault',str(v),'--now','2026-09-01T00:00:00+08:00','--out-dir',str(out)]; p=subprocess.run(cmd,text=True,capture_output=True)
