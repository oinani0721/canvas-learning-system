   156	+        assert it["criterion"] != "C1_source_url", name
   157	+        assert it["nomination_type"] != "primary-record", name
   158	+    pos = item_by_name(data, "带端口正常.md")
   159	+    assert pos["criterion"] == "C1_source_url"
   160	+    assert pos["nomination_type"] == "primary-record"
