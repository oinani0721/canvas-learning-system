  1355	# ───────────────────────── 人读 MD（纯自渲染，只消费 JSON dict） ─────────────────────────
  1356	
  1357	
  1358	def render_md(d: dict) -> str:
  1359	    L: list[str] = []
  1360	    L.append(f"# 待处理盘点 preview · {d['label']}")
  1361	    L.append("")
  1362	    L.append(f"> {d['not_executed_disclaimer']}")
  1363	    L.append(
  1364	        f"> 基准时刻 `--now`：{d['now_local']}（Asia/Shanghai）· schema v{d['schema_version']}"
  1365	    )
  1366	    L.append("")
  1367	    L.append("## 一、回执")
  1368	    L.append("")
  1369	    L.append(d["receipt"])
  1370	    L.append("")
  1371	    L.append(f"- 上次清仓：**不可得** —— {d['last_cleanup_note']}")
  1372	    c = d["corpus"]
  1373	    L.append(
  1374	        f"- 语料库：扫描 {c['files_scanned']} 份 .md，进重复索引 {c['files_indexed']} 份"
  1375	        f"（空正文 {c['skipped_empty_body']} 份不进索引 · symlink {c['skipped_symlink']} · "
  1376	        f"不可读 {c['skipped_unreadable']}）"
  1377	        + (
  1378	            "　⚠️ **已达扫描上限被截断**，「无重复」仅代表已扫部分"
  1379	            if c["truncated"]
  1380	            else ""
  1381	        )
  1382	    )
  1383	    L.append("")
  1384	
  1385	    L.append(f"## 二、本批提名（{len(d['items'])} 件，最旧优先）")
  1386	    L.append("")
  1387	    if not d["items"]:
  1388	        L.append("_（本批无材料）_")
  1389	    else:
  1390	        L.append("| # | 文件 | 年龄 | 建议去向 | 提名类型 | 判据 | 依据 | 冲突 |")
  1391	        L.append("|---|---|---|---|---|---|---|---|")
  1392	        for it in d["items"]:
  1393	            conflict = (
  1394	                "；".join(f"{x['kind']}" for x in it["conflicts"])
  1395	                if it["conflicts"]
  1396	                else "—"
  1397	            )
  1398	            target = f"（→ {it['target_hint']}）" if it["target_hint"] else ""
  1399	            L.append(
  1400	                "| {i} | {n} | {a} 天 | {v}{t} | {ty} | {c} | {b} | {cf} |".format(
  1401	                    i=it["index"],
  1402	                    n=md_cell(it["name"]),
  1403	                    a=it["age_days"],
  1404	                    v=md_cell(it["verdict"]),
  1405	                    t=md_cell(target),
  1406	                    ty=md_cell(it["nomination_type"] or "—"),
  1407	                    c=md_cell(it["criterion"]),
  1408	                    b=md_cell(it["basis"]),
  1409	                    cf=md_cell(conflict),
  1410	                )
  1411	            )
  1412	    L.append("")
  1413	
  1414	    unsure = [it for it in d["items"] if not it["confident"]]
  1415	    L.append(f"## 三、拿不准（{len(unsure)} 件 · 需你一句话）")
  1416	    L.append("")
  1417	    if not unsure:
  1418	        L.append("_（本批无拿不准条目）_")
  1419	    else:
  1420	        for it in unsure:
  1421	            L.append(f"- **{it['index']}. {it['name']}** —— {it['uncertain_reason']}")
  1422	            L.append(f"  - 请回一句：{it['ask']}")
  1423	    L.append("")
  1424	
  1425	    dups = [
  1426	        it for it in d["items"] if it["exact_duplicate_of"] or it["near_duplicates"]
  1427	    ]
  1428	    L.append("## 四、重复线索")
  1429	    L.append("")
  1430	    if not dups:
  1431	        L.append("_（本批未发现逐字重复或疑似高相似）_")
  1432	    else:
  1433	        for it in dups:
  1434	            if it["exact_duplicate_of"]:
  1435	                if it["exact_duplicate_others"]:
  1436	                    # ⛔ basis 已声明「哪一份算正本不可判」—— 人读 MD 不得再钦定
  1437	                    # 「正本 `字典序首项`」（round-2 H4：JSON 与 MD 自相矛盾）。
  1438	                    # 路径**不加反引号**：路径本身含反引号时 code span 会错配吃掉
  1439	                    # 字符，渲染出一个不存在的文件名（round-3 自审 H4-1）。
  1440	                    all_dups = [
  1441	                        it["exact_duplicate_of"],
  1442	                        *it["exact_duplicate_others"],
  1443	                    ]
  1444	                    L.append(
  1445	                        f"- **{it['name']}** · 与库内 {len(all_dups)} 份文件"
  1446	                        "逐字相同：" + "、".join(all_dups) + " —— 哪一份是正本不可判"
  1447	                        "（exact_duplicate_of 仅为字典序代表）"
  1448	                    )
  1449	                else:
  1450	                    L.append(
  1451	                        f"- **{it['name']}** · 逐字相同 → 正本 `{it['exact_duplicate_of']}`"
  1452	                    )
  1453	            for n in it["near_duplicates"]:
  1454	                L.append(
  1455	                    f"- **{it['name']}** · 疑似（ratio {n['ratio']}）→ `{n['path']}`"
  1456	                    "　— 疑似不等于重复，**不建议删**，需你确认"
  1457	                )
  1458	    s = d["near_dup_scan"]
  1459	    L.append("")
  1460	    L.append(
  1461	        f"> 近似比对：阈值 {s['ratio_threshold']}，实比 {s['compared_pairs']} 对；"
  1462	        f"因体积跳过 {s['skipped_oversize']} 对、因长度差跳过 {s['skipped_length_prefilter']} 对。"
  1463	        f"{s['note']}"
  1464	    )
  1465	    L.append("")
  1466	
  1467	    sl = d["sleeping"]
  1468	    L.append(f"## 五、Sleeping 台账（{sl['count']} 件）")
  1469	    L.append("")
  1470	    if not sl["items"]:
  1471	        L.append("_（Sleeping/ 未建立或为空）_")
  1472	    else:
  1473	        L.append("| 文件 | 睡了几天 | 起算依据 | 满 30 天 |")
  1474	        L.append("|---|---|---|---|")
  1475	        for x in sl["items"]:
  1476	            L.append(
  1477	                f"| {md_cell(x['name'])} | {x['slept_days']} | {md_cell(x['slept_at_source'])} "
  1478	                f"| {'⚠️ 是' if x['over_30d'] else '否'} |"
  1479	            )
  1480	    L.append("")
  1481	
  1482	    dfr = d["inventory"]["deferred"]
  1483	    L.append(f"## 六、本批之外（{len(dfr)} 件，本次不提名）")
  1484	    L.append("")
  1485	    if not dfr:
  1486	        L.append("_（无积压）_")
  1487	    else:
  1488	        for x in dfr:
  1489	            L.append(f"- {x['name']}（{x['age_days']} 天 · {x['mtime_local']}）")
  1490	    skp = d["inventory"]["skipped"]
  1491	    if skp:
  1492	        L.append("")
  1493	        L.append("**跳过留痕**（不静默消失）：")
  1494	        for x in skp:
  1495	            L.append(f"- {x['name']} —— {x['reason']}")
  1496	    L.append("")
  1497	
  1498	    L.append("## 七、引擎边界（如实声明）")
  1499	    L.append("")
  1500	    v = d["verdict_vocabulary"]
  1501	    L.append(f"- 引擎可达去向：{'、'.join(v['reachable_by_engine'])}")
  1502	    L.append(f"- **恒不产出**：{'、'.join(v['human_only'])} —— {v['human_only_note']}")
  1503	    L.append(
  1504	        "- 近似重复（difflib）**永不**产出建议删：只有归一化正文逐字相等才建议删；"
  1505	        "库内只有一份同正文时给正本路径，多份同正文时给出全部候选并声明"
  1506	        "「哪一份是正本不可判」。"
  1507	    )
  1508	    L.append(
  1509	        "- 空骨架建议删有三道护栏（如实声明）：frontmatter 有 source 声明、"
  1510	        "frontmatter 含引擎解析不了的行、或文件以未闭合的 HTML 注释结尾 —— "
  1511	        "这三种一律落「拿不准」，不会被建议删。"
  1512	    )
  1513	    L.append(
  1514	        "- AI 自述标记为字面量 + 右边界规则（汉字收尾标记后须为行尾/空白/标点，"
  1515	        "英文收尾标记后须为行尾/标点），仍不做语义否定检测：语义否定（「这不是"
  1516	        "由 AI 生成」）与满足边界的话题提及仍可能给出归档提名 —— 依据一律带行号"
  1517	        "与逐字片段，请逐条核对后再拍板；漏判方向落「拿不准」，安全。"
  1518	    )
  1519	    L.append(f"- 判据次序（先命中者定去向）：{' → '.join(d['criteria_order'])}")
  1520	    L.append("")
  1521	    return "\n".join(L) + "\n"
