   791	
   792	def nominate(
   793	    item: dict,
   794	    text: str | None,
   795	    dup_index: dict[str, list[str]],
   796	    corpus_bodies: list[tuple[str, str]],
   797	    scan: dict,
   798	    batch_body_counts: dict[str, int],
   799	) -> dict:
   800	    """对一件材料出提名。**次序即 CRITERIA_ORDER**，先命中者定 verdict；
   801	    后续判据的证据仍全量附上（conflicts / exact_duplicate_of / near_duplicates）。"""
   802	    name = item["name"]
   803	    conflicts: list[dict] = []
   804	
   805	    if text is None:
   806	        # 非 UTF-8（PDF/图片等）：除 0 字节外无任何可机械判读的信号 → 不猜。
   807	        if item["size_bytes"] == 0:
   808	            return _fill(
   809	                item,
   810	                "C3_empty_or_skeleton",
   811	                V_DELETE,
   812	                None,
   813	                None,
   814	                "0 字节空文件",
   815	                True,
   816	                conflicts=conflicts,
   817	            )
   818	        return _fill(
   819	            item,
   820	            "C6_undecided",
   821	            V_UNSURE,
   822	            None,
   823	            None,
   824	            "非 UTF-8 文本，本引擎不解析其正文",
   825	            False,
   826	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
   827	            ask=UNDECIDED_ASK,
   828	            conflicts=conflicts,
   829	        )
   830	
   831	    fm_lines = split_frontmatter(text)[0]
   832	    fm = frontmatter_map(fm_lines)
   833	    typed_rows, unclosed_comment = _classify_lines_typed(text)
   834	    del typed_rows
   835	    substantive = has_substantive_content(text)
   836	    body = dup_body(text) if substantive else ""
   837	    rnd = round_of(name)
   838	    # C3 护栏信号（显式偏差 15）：frontmatter 里「看着像键但不被键正则认」的行。
   839	    unparsed_fm = [
   840	        ln.strip()
   841	        for ln in fm_lines
   842	        if ln.strip() and not ln.strip().startswith("#") and not _FM_KEY_RE.match(ln)
   843	    ]
   844	
   845	    # ── 后置证据（不参与次序，但必须全量呈现） ──
   846	    exact_all = sorted(dup_index.get(body, [])) if body else []
   847	    exact_of = exact_all[0] if exact_all else None
   848	    exact_others = exact_all[1:]
   849	    near = near_duplicates(body, corpus_bodies, scan)
   850	    within_batch = bool(body) and batch_body_counts.get(body, 0) > 1
   851	    if within_batch:
   852	        conflicts.append(
   853	            {
   854	                "kind": "duplicate_within_batch",
   855	                "detail": "本批内另有正文逐字相同的材料 —— 谁是正本在只读侧不可判，"
   856	                "故不产出建议删，请你指定保留哪一份",
   857	            }
   858	        )
   859	
   860	    def finish(criterion, verdict, ntype, target, basis, confident, **kw):
   861	        if exact_of and criterion != "C4_exact_duplicate":
   862	            conflicts.append(
   863	                {
   864	                    "kind": "exact_duplicate_under_other_verdict",
   865	                    "detail": f"正文与 {exact_of} 逐字相同，但按判据次序本件归 {criterion}"
   866	                    "（次序不因重复而改变，证据在此留痕）",
   867	                }
   868	            )
   869	        if near and criterion != "C6_undecided":
   870	            conflicts.append(
   871	                {
   872	                    "kind": "near_duplicate_suspected",
   873	                    "detail": "疑似与 "
   874	                    + "、".join(f"{n['path']}(ratio {n['ratio']})" for n in near)
   875	                    + " 高相似 —— 疑似不改提名、更不建议删，需你一句话确认",
   876	                }
   877	            )
   878	        return _fill(
   879	            item,
   880	            criterion,
   881	            verdict,
   882	            ntype,
   883	            target,
   884	            basis,
   885	            confident,
   886	            exact_of=exact_of,
   887	            exact_others=exact_others,
   888	            near=near,
   889	            conflicts=conflicts,
   890	            **kw,
   891	        )
   892	
   893	    # ── C1 source URL ──
   894	    src = fm.get("source", "")
   895	    if src and _is_primary_source_url(src):
   896	        return finish(
   897	            "C1_source_url",
   898	            V_STAY,
   899	            "primary-record",
   900	            None,
   901	            f"frontmatter source 为一手 URL：{src}",
   902	            True,
