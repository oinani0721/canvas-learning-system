  1083	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1084	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1085	    items: list[dict] = []
  1086	    skipped: list[dict] = []
  1087	    with os.scandir(inbox) as it:
  1088	        entries = sorted(it, key=lambda e: e.name)
  1089	    for entry in entries:
  1090	        p = Path(entry.path)
  1091	        if entry.is_symlink():
  1092	            skipped.append(
  1093	                {
  1094	                    "name": entry.name,
  1095	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1096	                }
  1097	            )
  1098	            continue
  1099	        if entry.is_dir():
  1100	            if entry.name == SLEEPING_DIR_NAME:
  1320	        "generator": GENERATOR,
  1321	        "id_namespace": INBOX_ID_NAMESPACE,
  1322	        "id_stability": ID_STABILITY,
  1323	        "vault_fingerprint": "vf1-"
  1324	        + hashlib.sha256(os.path.realpath(vault).encode("utf-8")).hexdigest()[:16],
  1325	        "now": now.isoformat(),
  1326	        "now_utc": fmt_utc(now_s),
  1327	        "now_local": fmt_local(now_s),
  1328	        "inbox_dir": f"{inbox.name}/",
  1329	        "inbox_exists": inbox_exists,
  1330	        "label": inbox.name,
  1331	        "criteria_order": list(CRITERIA_ORDER),
  1332	        "verdict_vocabulary": VERDICT_VOCABULARY,
  1333	        "corpus": corpus_stats,
  1334	        "inventory": {
  1335	            "total": total,
  1336	            "batch_size": batch_size,
  1337	            "batch_max": BATCH_MAX,
  1338	            "batch_rule": "最旧优先（mtime 升序，同 mtime 按文件名升序），"
  1339	            f"单批上限 {BATCH_MAX} 件（D15 确认预算：一次性 >20 项完成率趋近 0）",
  1340	            "over_budget": total > batch_size,
  1341	            "deferred": deferred,
  1342	            "skipped": skipped,
  1343	        },
  1344	        "items": items,
  1345	        "sleeping": build_sleeping(inbox, now_s, inbox_exists),
  1346	        "near_dup_scan": scan,
  1347	        "last_cleanup": None,
  1348	        "last_cleanup_note": LAST_CLEANUP_NOTE,
  1349	        "not_executed_disclaimer": NOT_EXECUTED,
  1350	    }
  1351	    data["receipt"] = build_receipt(data)
  1352	    return data
