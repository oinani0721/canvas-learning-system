   745	def test_reject_out_dir_inside_inbox(tmp_path):
   746	    """产物落进收件箱 → 第二跑会把上一次的产物当成待处理材料, 二跑不再逐字节相等。
   747	    这种不成立要跑两次才看得见, 所以在入口直接拒绝。"""
   748	    vault, _ = base_vault(tmp_path)
   749	    inside = vault / "_待处理" / "outputs"
   750	    r = run_cli(vault, inside)
   751	    assert r.returncode != 0
   752	    assert no_products(inside)
   753	    assert not inside.exists(), "拒绝路径不得在收件箱里建目录"
