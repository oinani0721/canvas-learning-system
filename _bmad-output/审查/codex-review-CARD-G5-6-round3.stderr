   163	+def test_ai_marker_needs_boundary_after_literal(tmp_path):
   164	+    """⛔ H2 回归: 标记右侧必须满足边界规则 —— 话题提及不是生成断言, 不得被归档。
   165	+    ⛔ round-3 自审 H2-1 扩: 汉字收尾标记后须为行尾/空白/标点; ASCII 字母收尾
   166	+    标记(`Generated by AI`)后空白**不算**边界 —— `Generated by AI Lab` 是机构名,
   167	+    `本文由 AI 领域…` 是话题, 放行空白就是把边界规则对这些标记变成空操作。"""
   168	+    vault, out = base_vault(tmp_path)
   169	+    inbox = vault / "_待处理"
   170	+    mk(
   171	+        inbox / "版权话题.md",
