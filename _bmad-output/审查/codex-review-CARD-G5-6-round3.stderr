   975	def test_extreme_now_degrades_without_crashing(tmp_path):
   976	    """极值 --now 不崩、不伪造: 人话时刻落占位串, 但整轮照常出产物。
   977	
   978	    ⛔ 早先版本在 parse_now 装了一道「入口拒绝」守卫 —— 实测 aware datetime 的
   979	    `.timestamp()` 对日历极值并不抛，那道守卫永远不会触发。装一道不会触发的守卫
   980	    等于给自己发一张假的安全证书, 故删掉, 改钉真实可达的降级行为。
   981	    这里选 +00:00 而不是 +14:00: 后者换到 Asia/Shanghai 仍是 9999 年内, 不触发降级。
   982	    """
   983	    vault, out = base_vault(tmp_path)
   984	    r = run_cli(vault, out, now="9999-12-31T23:59:59+00:00")
   985	    assert r.returncode == 0, r.stderr[-300:]
   986	    data = load_json(out)
   987	    assert data["now_utc"] == "9999-12-31T23:59:59Z"
   988	    assert data["now_local"] == "unrepresentable", "+8h 溢出到 10000 年时必须落占位"
   989	
   990	
   991	def test_far_future_mtime_reports_what_filesystem_stores(tmp_path):
   992	    """⛔ 本条钉的是一个实证事实 + 一条诚实纪律。
   993	
   994	    事实: `os.utime` 把 mtime 设到 9999 年时, macOS APFS **静默钳位**到 int64 纳秒
   995	    上界(2262-04-11T23:47:16Z), `st_mtime` / `st_mtime_ns` 回读到的都是钳位值、不抛。
   996	    纪律: 引擎必须**照实报文件系统里存着的那个值**, 既不崩、也不自己造一个。
   997	    第一条断言把「钳位」这个前提本身钉住 —— 换个文件系统若不再钳位, 本条会失败提醒
   998	    而不是继续绿着(前提失效的测试恒绿 = 假证书)。
   999	    """
  1000	    vault, out = base_vault(tmp_path)
  1001	    p = mk(vault / "_待处理" / "远未来.md", "# t\n\n正文一。\n正文二。\n", age_days=1)
  1002	    far = 253402300799  # 9999-12-31T23:59:59Z
  1003	    os.utime(p, (far, far))
  1004	    stored = p.stat().st_mtime
  1005	    assert stored < far, "前提失效: 本平台 os.utime 未钳位远未来 mtime"
  1006	
  1007	    r = run_cli(vault, out)
  1008	    assert r.returncode == 0, r.stderr[-300:]
  1009	    it = load_json(out)["items"][0]
  1010	    expected = datetime.fromtimestamp(stored, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
  1011	    assert it["mtime_utc"] == expected, "引擎报的必须逐字等于文件系统存的, 不得自造"
  1012	    assert it["age_days"] < 0, "--now 远早于该 mtime, 负年龄如实呈现不夹逼"
  1013	
  1014	
