    80	+def test_fence_close_requires_same_char_min_length_and_bare_fence(tmp_path):
    81	+    """⛔ B3 回归: 关闭围栏 = 同字符 且 长度 ≥ 开启长度 且 围栏后仅空白
    82	+    (CommonMark 4.5)。
    83	+
    84	+    原实现只比字符: ```` 里的 ``` 被当关闭、``` 后带 info string 的行也被当关闭,
    85	+    围栏内容 `# keep` 落到围栏外被 `_HEADING_RE` 剥掉 → 整份文件被误判成
    86	+    空骨架 → 建议删。
    87	+    """
    88	+    vault, out = base_vault(tmp_path)
    89	+    inbox = vault / "_待处理"
    90	+    mk(inbox / "四反引号.md", "````\n```\n# keep\n````\n", age_days=9)
    91	+    mk(inbox / "四波浪线.md", "~~~~\n~~~\n# keep\n~~~~\n", age_days=8)
    92	+    # CommonMark: 关闭围栏不得带 info string → ```python 是围栏内容, 不是关闭
    93	+    mk(inbox / "关闭带infostring.md", "```\n```python\n# keep\n```\n", age_days=7)
    94	+    # 同字符子句: ``` 围栏里的 ~~~ 行是内容, 不是关闭 (删掉同字符判断即翻红)
    95	+    mk(inbox / "混合字符.md", "```\n~~~\n# keep\n```\n", age_days=6)
    96	+    # 制表符缩进不构成围栏 (CommonMark: ≥4 列是缩进代码块); \t``` 不得提前关闭 ——
    97	+    # ⛔ 语料不得带正文行: 有正文行时「提前关闭」也杀不死断言, 变异会存活
    98	+    mk(inbox / "tab关闭围栏.md", "```\n\t```\n# 标题\n", age_days=5)
    99	+    # 围栏内容行哪怕每行都长得像围栏标记, 也是实质正文 (Markdown 围栏语法速查)
   100	+    mk(
   101	+        inbox / "围栏速查.md",
   102	+        "# Markdown 围栏语法速查\n\n## 空围栏怎么写\n\n````\n```\n```\n~~~\n~~~\n````\n",
   103	+        age_days=4,
   104	+    )
