   127	        '_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):(?:\\s+(.*))?\\s*$")',
   128	        "test_frontmatter_map_value_fidelity",
   129	    ),
   130	    (
