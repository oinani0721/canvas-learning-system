   850	    # 240 字节（80 个三字节汉字）——单组件在 APFS/ext4 上都建得出来, 但产物名
   851	    # `inbox-preview-` + 240 + `.json` = 259 字节越界。⛔ 原先用 540 字节的目录名,
   852	    # 在 ext4 那种 255 **字节**上限的文件系统上 mkdir 自己就会失败, 测试根本走不到
   853	    # 被测守卫（Codex MEDIUM 的可移植性问题；本机 APFS 按字符计所以侥幸能跑）。
   854	    long_dir = vault / ("超" * 80)
   855	    long_dir.mkdir()
   856	    r = run_cli(vault, out, "--inbox-dir", str(long_dir))
   857	    assert r.returncode != 0
   858	    assert no_products(out)
   859	    assert not out.exists(), "拒绝路径不得留下空的 out-dir"
   860	
   861	
   862	def test_reject_symlinked_out_dir_parent(tmp_path):
   863	    vault, _ = base_vault(tmp_path)
   864	    real = tmp_path / "real"
   865	    real.mkdir()
   866	    link = tmp_path / "link"
   867	    link.symlink_to(real, target_is_directory=True)
   868	    r = run_cli(vault, link / "out")
   869	    assert r.returncode != 0
   870	    assert no_products(real / "out")
   871	
   872	
   873	def test_reject_symlinked_inbox_dir(tmp_path):
