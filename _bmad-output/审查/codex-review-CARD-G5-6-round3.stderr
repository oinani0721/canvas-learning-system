   368	
   369	def compute_inbox_stable_id(rel_path: str) -> str:
   370	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   430	
   431	def frontmatter_span(lines: list[str]) -> int:
   432	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   433	
   434	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   435	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   436	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   437	    行号是给人核对用的，偏了就等于没有。
   438	    """
   439	    if not lines or lines[0].strip() != "---":
   440	        return 0
   441	    end = None
   442	    for i in range(1, len(lines)):
   443	        if lines[i].strip() in ("---", "..."):
   444	            end = i
   445	            break
   446	    if end is None:
   447	        return 0  # 缺闭合 → 视为无 frontmatter
   448	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   449	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   450	    # 空文件的删除提名，比不提名坏得多。
   451	    for ln in lines[1:end]:
   452	        t = ln.strip()
   453	        if not t or t.startswith("#"):
   454	            continue  # 空行与 YAML 注释不作数
   455	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   456	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   457	
   458	
   459	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   460	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   461	    lines = text.splitlines()
   462	    n = frontmatter_span(lines)
   463	    return (lines[1 : n - 1] if n else []), lines[n:]
   464	
   465	
   466	def frontmatter_map(fm_lines: list[str]) -> dict:
   467	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   468	    out: dict[str, str] = {}
   469	    for ln in fm_lines:
   470	        m = _FM_KEY_RE.match(ln)
   471	        if not m:
   472	            continue
   473	        val = (m.group(2) or "").strip()
   474	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   475	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   476	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   477	        val = re.sub(r"\s+#.*$", "", val).strip()
   478	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   479	            val = val[1:-1]
   480	        out.setdefault(m.group(1), val)
   481	    return out
   482	
   483	
   484	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   485	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   486	
   487	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   488	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   489	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   490	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   491	    分隔行由状态机精确标记，内容行一律是内容。
   492	
   493	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   494	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   495	
   496	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   497	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   498	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   499	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   500	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   501	    """
   502	    _, rest = split_frontmatter(text)
   503	    rows: list[tuple[str, str]] = []
   504	    in_fence = False
   505	    fence_char = ""
   506	    fence_len = 0
   507	    in_comment = False
   508	    for ln in rest:
   509	        m = _FENCE_RE.match(ln)
   510	        if m and not in_comment:
   511	            tok = m.group(1)
   512	            if not in_fence:
   513	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   514	                rows.append((ln, "fence"))
   515	                continue
   516	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅空白**（CommonMark
   517	            # 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带 info string 的
   518	            # 行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，整份文件被误判成
   519	            # 空骨架 → 建议删（round-2 B3 实证）。
   520	            if (
   521	                tok[0] == fence_char
   522	                and len(tok) >= fence_len
   523	                and not ln[m.end() :].strip()
   524	            ):
   525	                in_fence, fence_char, fence_len = False, "", 0
   526	                rows.append((ln, "fence"))
   527	                continue
   528	        if in_fence:
   529	            rows.append((ln, "code"))
   530	            continue
   531	        kept, rem = "", ln
   532	        while rem:
   533	            if in_comment:
   534	                i = rem.find("-->")
   535	                if i < 0:
   536	                    break
   537	                rem, in_comment = rem[i + 3 :], False
   538	            else:
   539	                i = rem.find("<!--")
   540	                if i < 0:
   541	                    kept += rem
   542	                    break
   543	                kept += rem[:i]
   544	                rem, in_comment = rem[i + 4 :], True
   545	        rows.append((kept, "text"))
   546	    return rows, in_comment
   547	
   548	
   549	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   550	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   551	    三态细节见 `_classify_lines_typed`。"""
   552	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   553	
   554	
   555	def dup_body(text: str) -> str:
   556	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   557	
   558	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   559	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   560	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   561	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   562	    有后果的提名，依据必须逐字。
   563	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   564	    """
   565	    parts: list[str] = []
   566	    for ln, is_code in _classify_lines(text):
   567	        if not is_code and _HEADING_RE.match(ln):
   568	            continue
   569	        t = ln.rstrip()
   570	        if not t:
   571	            continue
   572	        parts.append(nfc(t))
   573	    return "\n".join(parts)
   574	
   575	
   576	def has_substantive_content(text: str) -> bool:
   577	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   578	
   579	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   580	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   581	    合用一个函数正是 Codex BLOCKER 的根因。
   582	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   583	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   584	    （round-3 自审 B3-3）。
   585	    """
   586	    for ln, kind in _classify_lines_typed(text)[0]:
   587	        if kind == "code":
   588	            if ln.strip():
   589	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   590	            continue
   591	        if kind == "fence":
   592	            continue
   593	        if _HEADING_RE.match(ln):
   594	            continue
   595	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   596	        if t and not _ONLY_STRUCT_RE.match(t):
   597	            return True
   598	    return False
   599	
   600	
   601	def skeleton_note(text: str, size: int) -> str:
   602	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   603	
   604	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   605	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   606	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   607	    """
   608	    if size == 0:
   609	        return "0 字节空文件"
   610	    rows = _classify_lines_typed(text)[0]
   611	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   612	    struct = sum(
   613	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   614	    )
   615	    fences = sum(1 for _, k in rows if k == "fence")
   616	    return (
   617	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   618	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   619	        f"代码围栏 {fences} 行、其余皆空行）"
   620	    )
   621	
   622	
   623	def head_window(text: str) -> list[tuple[int, str]]:
   624	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   625	    lines = text.splitlines()
   626	    n = frontmatter_span(lines)
   627	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   628	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   629	        win.append((n + j + 1, ln))
   630	    return win
   631	
   632	
   633	def _find_marker_pos(ln: str, marker: str) -> int:
   634	    """marker 在 ln 中第一个满足右边界规则的起点；无则 -1。
   635	
   636	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   637	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   638	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   639	    行内更靠后的真命中。
   640	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   641	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   642	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   643	    只认行尾或标点；漏判方向落 C6，安全。"""
   644	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   645	    start = 0
   646	    while (i := ln.find(marker, start)) >= 0:
   647	        j = i + len(marker)
   648	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   649	            return i
   650	        if not ascii_ending and ln[j].isspace():
   651	            return i
   652	        start = i + 1
   653	    return -1
   654	
   655	
   656	def find_ai_marker(text: str) -> tuple[int, str] | None:
   657	    """文头窗口内的字面量 AI 标记（右边界规则见 `_find_marker_pos`）。
   658	    同行多命中时取「最靠前、同位置取最长」——确定性。"""
   659	    for lineno, ln in head_window(text):
   660	        hits = [
   661	            (pos, -len(m), m)
   662	            for m in AI_MARKERS
   663	            if (pos := _find_marker_pos(ln, m)) >= 0
   664	        ]
   665	        if hits:
   666	            _, _, marker = min(hits)
   667	            return lineno, marker
   668	    return None
   669	
   670	
   671	def round_of(name: str) -> str | None:
   672	    m = _ROUND_RE.search(name)
   673	    return m.group(1) if m else None
   674	
   675	
   676	def round_type(name: str) -> str | None:
   677	    for pat, typ in ROUND_SUBPATTERNS:
   678	        if pat in name:
   679	            return typ
   680	    return None
   681	
