   393	def test_criteria_order_is_frozen_and_earlier_wins(tmp_path):
   394	    """次序铁律: C1 命中时即便存在逐字重复, verdict 仍归 C1 —— 但重复证据必须留痕。"""
   395	    vault, out = base_vault(tmp_path)
   396	    body = "同一段被剪藏过两次的正文。\n第二行。\n"
   397	    mk(vault / "节点" / "已有正本.md", body, age_days=40)
   398	    mk(
   399	        vault / "_待处理" / "剪藏且重复.md",
   400	        "---\nsource: https://example.com/a\n---\n\n" + body,
   401	        age_days=2,
   402	    )
   403	    assert run_cli(vault, out).returncode == 0
   404	    data = load_json(out)
   405	    assert tuple(data["criteria_order"]) == CRITERIA
   406	
   407	    it = data["items"][0]
   408	    assert it["criterion"] == "C1_source_url"
   409	    assert it["verdict"] == "留原地"
   410	    assert it["exact_duplicate_of"] == "节点/已有正本.md", "信息零丢失: 次序不改变, 证据仍在"
   411	    assert any(c["kind"] == "exact_duplicate_under_other_verdict" for c in it["conflicts"])
