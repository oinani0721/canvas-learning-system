   456	def test_fenced_code_only_file_is_not_a_skeleton(tmp_path):
   457	    """⛔ BLOCKER 回归: 只有一段围栏代码的文件不得被判成空骨架。
   458	
   459	    `~~~` 曾被当成「纯结构行」删掉, 围栏内的 `# comment` 又被当成 Markdown 标题删掉,
   460	    于是整份文件"没有正文"→ 建议删。而文件头明明声明着「代码块内容留在正文里」——
   461	    声明与实现对不上, 就是掩饰。
   462	    """
   463	    vault, out = base_vault(tmp_path)
   464	    mk(
   465	        vault / "_待处理" / "脚本片段.md",
   466	        # ⛔ 围栏内**只有一行 `#` 注释**——这正是 Codex 的原始 repro。
   467	        # 早先版本这里多写了一行 `rsync -a src/ dst/`: 那行不是标题也不是结构行,
   468	        # 于是即便围栏状态机被拆掉它也能救活断言, 变异照样存活 = 门是虚的。
   469	        "~~~\n# keep this shell comment\n~~~\n",
   470	        age_days=3,
   471	    )
   472	    assert run_cli(vault, out).returncode == 0
   473	    it = load_json(out)["items"][0]
   474	    assert it["criterion"] != "C3_empty_or_skeleton"
   475	    assert it["verdict"] != "建议删"
   476	
