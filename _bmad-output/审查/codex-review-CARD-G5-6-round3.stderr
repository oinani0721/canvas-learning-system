   130	+def test_url_without_host_is_not_primary_record(tmp_path):
   131	+    """⛔ H1 回归: `https://:443/x`、`https://user@/x` 没有 host —— 能过纯正则,
   132	+    但 `urlsplit(...).hostname` 为空, 不构成「一手来源」的机械证据。"""
   133	+    vault, out = base_vault(tmp_path)
   134	+    inbox = vault / "_待处理"
   135	+    mk(
   136	+        inbox / "空host端口.md",
   137	+        "---\nsource: https://:443/x\n---\n\n正文甲一。\n正文甲二。\n",
   138	+        age_days=4,
   139	+    )
   140	+    mk(
   141	+        inbox / "空host用户.md",
   142	+        "---\nsource: https://user@/x\n---\n\n正文乙一。\n正文乙二。\n",
   143	+        age_days=3,
   144	+    )
   145	+    # 正向对照: 带端口/查询/锚点的正常 URL 仍是一手来源
   146	+    mk(
   147	+        inbox / "带端口正常.md",
   148	+        "---\nsource: https://example.com:8443/a?b=c#d\n---\n\n正文丙一。\n正文丙二。\n",
   149	+        age_days=2,
   150	+    )
   151	+
   152	+    assert run_cli(vault, out).returncode == 0
