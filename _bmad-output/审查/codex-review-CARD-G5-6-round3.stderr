   106	        '_URL_RE = re.compile(r"^https?://[^\\s/?#]+\\S*$", re.IGNORECASE)',
   107	        '_URL_RE = re.compile(r"^https?://[^\\s/?#]+\\S*$")',
   108	        GUARD,
   109	    ),
   110	    (
   111	        "M11-H1-6 恢复剥引号/剥注释互斥(先引号后注释)",
   112	        """        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   113	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   114	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   115	        val = re.sub(r"\\s+#.*$", "", val).strip()
   116	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\\"'":
   117	            val = val[1:-1]""",
   118	        """        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\\"'":
   119	            val = val[1:-1]
   120	        else:
   121	            val = re.sub(r"\\s+#.*$", "", val).strip()""",
   122	        GUARD,
   123	    ),
   124	    (
   125	        "M12-H3-3 _FM_KEY_RE 去掉冒号前空白(口径再分裂)",
