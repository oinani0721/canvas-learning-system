   282	+def test_key_without_space_after_colon_falls_to_c6(tmp_path):
   283	+    """D2 连带钉住: `source:https://x`(冒号后无空格) 此后不再识别为键 → 该行成为
   284	+    正文、材料落 C6 拿不准 —— 方向安全(不误判一手), 且此偏差已写进文件头声明。"""
   285	+    vault, out = base_vault(tmp_path)
   286	+    mk(
   287	+        vault / "_待处理" / "无空格键.md",
   288	+        "---\nsource:https://example.com/x\n---\n\n正文一。\n正文二。\n",
   289	+        age_days=3,
   290	+    )
   291	+    assert run_cli(vault, out).returncode == 0
   292	+    it = load_json(out)["items"][0]
   293	+    assert it["criterion"] == "C6_undecided"
   294	+    assert it["verdict"] == "拿不准"
