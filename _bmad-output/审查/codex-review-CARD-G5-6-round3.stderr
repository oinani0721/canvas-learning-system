   151	#: 兄弟 skill 的只读 preview 引擎 —— 写侧物理防御与身份键编码的单一真相源。
   152	_SP_PATH = (
   153	    Path(__file__).resolve().parents[2] / "board-split" / "scripts" / "split_preview.py"
   154	)
