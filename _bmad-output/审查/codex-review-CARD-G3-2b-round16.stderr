  4450	# ── 门(83) round-15 自查: 数值语义 vs JSON 书写
  4451	
  4452	
  4453	def test_round15_numeric_semantics_not_json_spelling(vault):
  4454	    """`1` 与 `1.0` 是同一数值的两种合法 JSON 书写，不得判成两次不同的评分；
  4455	    但 `1` 与 `true` 必须仍然区分。
  4456	
  4457	    ⛔ 这个洞落在 round-14 两条修复的**交界处**，两边都没覆盖：
  4458	    - B③ 的 canonical 比较要**类型敏感**（为了 `1 != True`），顺带把 `1 != 1.0` 也判不等；
  4459	    - H② 的版本化身份规则只在 `_dgn != GN2` 时生效，而 `1 == 1.0` 在 Python 里成立，
  4460	      条件不触发。
  4461	    两条各自正确，交界处出洞 —— 这类洞不属于任何一条审查意见，只有把两条修复
  4462	    放在一起推演才会出现。⚠️ 是我自查发现的，不是审查报的。
  4463	
  4464	    ⚠️ envelope 走整体 `json.dumps`、逐字段走 `_canon_fact`，是**两种比较机制**，
  4465	    所以「抽成一份实现」不适用 —— 共用的是**规则**（`_num_norm`），不是实现。
  4466	    """
  4467	    LED = vault / "learning_events.jsonl"
  4468	
  4469	    # ① int 形态的 durable（外部写入，validator 合规）＋ 用户以 float 重跑 ⇒ 不得误拒
  4470	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4471	    LED.unlink(missing_ok=True)
  4472	    assert (
  4473	        _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, grade_norm=1.0)).returncode == 0
  4474	    )
  4475	    raw = LED.read_text(encoding="utf-8")
  4476	    raw2 = raw.replace('"grade_norm": 1.0', '"grade_norm": 1')
  4477	    assert raw2 != raw, "预置必须真的改成 int 形态"
  4478	    LED.write_text(raw2, encoding="utf-8")
  4479	    nd = (vault / NODE_REL).read_text(encoding="utf-8")
  4480	    (vault / NODE_REL).write_text(
  4481	        re.sub(r"^    grade_norm: .*$", "    grade_norm: 1", nd, count=1, flags=re.M), encoding="utf-8"
  4482	    )
  4483	    assert _run_validator(vault).returncode == 0, "int 形态的分数本身合规"
  4484	    r = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, grade_norm=1.0))
  4485	    assert r.returncode == 0, f"⛔ `1` 与 `1.0` 是同一数值，不得误拒: {r.stderr[:300]}"
  4486	
  4487	    # ② 验伪：`1` 与 `true` 仍必须区分（round-14 BLOCKER③ 不得被这次放宽冲掉）
  4488	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4489	    LED.unlink(missing_ok=True)
  4490	    assert (
  4491	        _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, exam_board={"k": 1})).returncode
  4492	        == 0
  4493	    )
