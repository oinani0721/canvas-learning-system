   824	def _fm_has_event(fm_text, ev_id):
   825	    """F1 判定: calibration_log 里有没有这个 event_id。
   826	
   827	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   828	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   829	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   830	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   831	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   832	
   833	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   834	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   835	    是「有总比没有强」的降级, 出现即告警。
   836	    """
   837	    try:
   838	        import yaml  # F1 判定
   839	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   840	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   841	        if isinstance(_doc, dict):
   842	            _cal = _doc.get("calibration_log")
   843	            if isinstance(_cal, list):
   844	                return any(
   845	                    isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id
   846	                    for _e in _cal
   847	                )
   848	            return False        # null / 标量 / 缺失 ⇒ 没有任何条目
   849	    except ImportError:
   850	        print("[quiz-answer] ⚠️ PyYAML 不可用 — F1 判定退回正则扫描, 只认 block list + `- event_id:` 开头的条目; 尾注释/inline/键顺序变体会假阴性")

