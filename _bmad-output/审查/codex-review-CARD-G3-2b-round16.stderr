  4504	def test_round15_scored_at_in_ext_detection(vault):
  4505	    """`scored_at` 是**新写点独有键**，带它的行不得被当成 §6.3 历史行跳过。
  4506	
  4507	    ⛔ 伪装链（审查实测）：从合法 pending 删掉 schema_ext/vault_id/concept_id/
  4508	    rating/review_time/fsrs_* 六个键、保留 scored_at/grade_norm/exam_board/
  4509	    attempt_count ⇒ validator rc=0，旧实现把它当历史行跳过，**那次复习永久漏算**。
  4510	    ⚠️ validator 侧把 `scored_at` 列入 REVIEW_EXT_KEYS 撞卡文禁改面，已登记移交；
  4511	    这里按 §6.2 A8「先过校验器本体，再同口径加严」在消费侧堵住。
  4512	    """
  4513	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4514	    (vault / "learning_events.jsonl").unlink(missing_ok=True)
  4515	    row = _review_row(event_id="quiz:E1#q1")
  4516	    for k in (
  4517	        "schema_ext",
  4518	        "vault_id",
  4519	        "concept_id",
  4520	        "rating",
  4521	        "review_time",
  4522	        "fsrs_library_version",
  4523	        "fsrs_params_hash",
  4524	    ):
  4525	        row["payload"].pop(k, None)
  4526	    assert set(row["payload"]) == {"scored_at", "grade_norm", "exam_board", "attempt_count"}, row["payload"]
  4527	    _write_ledger(vault, row)
  4528	    assert _run_validator(vault).returncode == 0, "伪装行本身合规（正是它难抓的原因）"
  4529	    face = _write_face(vault)
  4530	    r = _run_writer_settled(
  4531	        vault, _payload(event_id="E2#q1", ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z")
  4532	    )
  4533	    assert r.returncode != 0, "带 scored_at 的行不得被当历史行跳过"
  4534	    assert _write_face(vault) == face, "零写"
