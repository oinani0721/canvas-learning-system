   150	def _payload(**kw):
   151	    """⚠️ `review_time`（稳定业务时刻）**默认与 ts 相等**，但那正是 round-8
   152	    MEDIUM 指出的盲区：AST 统计 181 次调用只有 11 次显式传它，且所有首写都令
   153	    `review_time == ts` —— 于是「首写用了哪个时刻」这个区别**在测试里根本不
   154	    存在**，3 条 BLOCKER 全绿。门㊼ 专门覆盖 `review_time != ts` 的组合。
   155	    """
   156	    base = {
   157	        "node": NODE_REL,
   158	        "grade_norm": 0.752,
   159	        "ts": TS1,
   160	        "review_time": TS1,
   161	        "event_id": EID,
   162	        "exam_board": "检验白板/测试检验-2026-08-01-1000.md",
   163	        "question_id": "q1",
   164	        "source_board": "[[原白板/CS 61B]]",
   165	        "self_confidence_raw": "半懂",
   166	        "self_confidence_norm": 0.5,
   167	        "abandoned": False,
   168	        "callout": "",
   169	    }
   170	    # ⚠️ `review_time` 的默认值取决于**这是不是同一次评分**：
   171	    #   · 只改 `ts`、`event_id` 不变 ⇒ 「同一次评分在另一时刻**续跑**」
   172	    #     ⇒ review_time 保持不变（`ts` = 日志行何时写的，`review_time` = 评分
   173	    #       何时发生的）。让它跟着 ts 走，门就从「测续跑」变成「测换业务时刻」，
   174	    #       会被 envelope 正确拒绝 —— 那是门的语义被改了，不是实现坏了。
   175	    #   · 换了 `event_id` ⇒ 另一次评分 ⇒ review_time 跟随 ts。
   176	    # 要测「同 ID 换业务时刻」必须**显式**传不同的 review_time（门㊼ 就这么做）。
   177	    if "ts" in kw and "review_time" not in kw and "event_id" in kw:
   178	        # 同时给了 event_id 与 ts ⇒ 这是**另一次**评分 ⇒ 业务时刻跟随 ts。
   179	        # 只给 ts（event_id 用默认）⇒ 同一次评分的**续跑** ⇒ 业务时刻不变。
   180	        base["review_time"] = kw["ts"]
   181	    base.update(kw)
   182	    return base
   183	
