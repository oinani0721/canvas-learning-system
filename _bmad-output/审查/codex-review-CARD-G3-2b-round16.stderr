import importlib.util, json, os, re, tempfile
from pathlib import Path

src = Path(\"backend/scripts/g32b_r1r7_counterexamples.py\").resolve()
spec = importlib.util.spec_from_file_location(\"g32ce\", src)
g = importlib.util.module_from_spec(spec)
spec.loader.exec_module(g)
root = Path(tempfile.mkdtemp(prefix=\"manual-\", dir=\"/tmp/codex-g32-review-0ab79fbb\"))
g.CE_ROOT = root
out = {\"root\": str(root)}

def last(s):
    xs=(s or \"\").strip().splitlines()
    return xs[-1] if xs else \"\"

def attempt(v):
    m=re.search(r\""'^attempt_count:'"\\s*(\\d+)\", (v/g.NODE_REL).read_text(encoding=\"utf-8\"), re.M)
    return int(m.group(1)) if m else None

# 1: user-string collision with Decimal sentinel
v=g.new_vault(\"decimal-tag\")
a=g.run_settled(v,event_id=\"K\",exam_board={\"k\":1},ts=g.TS1,review_time=g.TS1)
(v/\"learning_events.jsonl\").write_text(\"\",encoding=\"utf-8\")
node_sha=g.sha(v/g.NODE_REL)
b=g.run(v,event_id=\"K\",exam_board={\"k\":\"§dec:1\"},ts=g.TS1,review_time=g.TS1)
out[\"decimal_tag\"]={\"first_rc\":a.returncode,\"retry_rc\":b.returncode,\"node_same\":g.sha(v/g.NODE_REL)==node_sha,\"ledger_bytes\":(v/\"learning_events.jsonl\").stat().st_size,\"attempt\":attempt(v),\"stdout\":last(b.stdout),\"stderr\":last(b.stderr)}

# 2: Decimal.normalize default precision collision
v=g.new_vault(\"decimal-prec\")
a=g.run_settled(v,event_id=\"K\",exam_board=10**30,ts=g.TS1,review_time=g.TS1)
(v/\"learning_events.jsonl\").write_text(\"\",encoding=\"utf-8\")
node_sha=g.sha(v/g.NODE_REL)
b=g.run(v,event_id=\"K\",exam_board=10**30+1,ts=g.TS1,review_time=g.TS1)
out[\"decimal_prec\"]={\"first_rc\":a.returncode,\"retry_rc\":b.returncode,\"node_same\":g.sha(v/g.NODE_REL)==node_sha,\"ledger_bytes\":(v/\"learning_events.jsonl\").stat().st_size,\"attempt\":attempt(v),\"stdout\":last(b.stdout),\"stderr\":last(b.stderr)}

# 3: JSON-in-YAML exponent is not type preserving
v=g.new_vault(\"yaml-exp\")
a=g.run_settled(v,event_id=\"K\",exam_board=1e300,ts=g.TS1,review_time=g.TS1)
b=g.run(v,event_id=\"K\",exam_board=1e300,ts=g.TS1,review_time=g.TS1)
node=(v/g.NODE_REL).read_text(encoding=\"utf-8\")
out[\"yaml_exp\"]={\"first_rc\":a.returncode,\"retry_rc\":b.returncode,\"receipt_line\":next(x for x in node.splitlines() if \"exam_board:\" in x),\"stderr\":last(b.stderr)}

# 4: B2 log deletion/restoration silently loses degraded E1 FSRS contribution
v=g.new_vault(\"fsrs-false-loss\")
os.environ[\"FSRS_BRIDGE_REEXEC\"]=\"1\"
r1=g.run_settled(v,event_id=\"E1\",ts=g.TS1,review_time=g.TS1)
os.environ.pop(\"FSRS_BRIDGE_REEXEC\",None)
e1=g.rows(v)[0]
(v/\"learning_events.jsonl\").write_text(\"\",encoding=\"utf-8\")
r2=g.run_settled(v,event_id=\"E2\",ts=\"2026-08-01T11:00:00Z\",review_time=\"2026-08-01T11:00:00Z\")
e2=g.rows(v)[0]
g.write_rows(v,e1,e2)
r3=g.run(v,event_id=\"E1\",ts=g.TS1,review_time=g.TS1)
broken=g.fsrs_fields(v)
receipt_false=\"fsrs_applied: false\" in (v/g.NODE_REL).read_text(encoding=\"utf-8\")
c=g.new_vault(\"fsrs-normal-control\")
c1=g.run_settled(c,event_id=\"E1\",ts=g.TS1,review_time=g.TS1)
c2=g.run_settled(c,event_id=\"E2\",ts=\"2026-08-01T11:00:00Z\",review_time=\"2026-08-01T11:00:00Z\")
control=g.fsrs_fields(c)
out[\"fsrs_false_loss\"]={\"degraded_rc\":r1.returncode,\"e2_rc\":r2.returncode,\"retry_e1_rc\":r3.returncode,\"retry_stdout\":last(r3.stdout),\"receipt_false\":receipt_false,\"broken\":broken,\"control\":control}

# 5: successful degraded recovery leaves false, then F1-only rejects
