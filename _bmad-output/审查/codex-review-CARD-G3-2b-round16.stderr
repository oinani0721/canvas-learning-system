   652	        "attempt_count": (_att, _ok_att),
   653	        "grade_norm": (_norm_gn(_gn), _ok_gn),
   654	        "abandoned": (bool(_ab), _ok_bool),
   655	        "exam_board": (_norm_board(_board), _ok_board),
