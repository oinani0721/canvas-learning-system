  1316	        for k in ("mastery_score", "mastery_a", "mastery_b", "attempt_count")
  1317	    }
  1318	    r5 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
  1319	    assert r5.returncode == 0 and "degraded 遗留" in r5.stdout, r5.stdout + r5.stderr
  1320	    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "格5: FSRS 必须补齐"
  1321	    for k, v in ema_before.items():
  1322	        assert re.search(rf"^{k}:.*", _fm(vault), re.M).group(0) == v, f"格5: {k} 不得二次吸收"
  1323	    assert len(_ledger_lines(vault)) == 1
  1324	
  1325	    # ── 格6 dup=有, f1=F, applied=F: 崩溃窗口① → 全套补齐且与直接应用字节相同
  1326	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1327	    (vault / "learning_events.jsonl").unlink()
  1328	    assert _run_writer(vault, _payload()).returncode == 0
  1329	    golden = (vault / NODE_REL).read_bytes()
  1330	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
