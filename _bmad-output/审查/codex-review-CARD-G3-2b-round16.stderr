   305	def _adopted_from(_sa, _w_inst):
   306	    """由**原始时刻**与**当时的水位线**复算唯一的 A3 采用时刻（纯函数）。
   307	
   308	    ⛔ 这是 A3 的定义本身, 不是启发式: 先 UTC 化、截整秒(bridge 侧同款), 若结果
   309	    不晚于水位线则取 `W+1s`。round-13 之前这里比的是**字面相等**, 于是带小数秒的
   310	    合法输入(`10:00:00.731Z`)被判成「采用时刻被改过」—— 采用值是算出来的, 不是抄的。
   311	    """
   312	    try:
   313	        _i = _aware(_sa)
   314	    except Exception:
   315	        return None
   316	    _i = _i.astimezone(timezone.utc).replace(microsecond=0)
   317	    if _w_inst is not None and _i <= _w_inst:
   318	        _i = _w_inst + timedelta(seconds=1)
   319	    return _i
