  4641	def test_round15_replay_a3_advance_is_auditable(vault):
  4642	    """复放时 A3 若把采用时刻推进过，必须**留下审计痕迹**并告警。
  4643	
  4644	    ⛔ 审查指出的不一致（W 与 durable/receipt 采用时刻分叉）真实存在。三个处置
  4645	    实测比较过：
  4646	      ① 收紧「只认 A3 推后值」⇒ 拒掉**外部写入的同瞬间两行**（validator 允许），
  4647	         全门实测红 2 道 —— 是误拒；
  4648	      ② 回头改写 durable 让它一致 ⇒ 违反 schema §一「append-only，只追加不改写」；
  4649	      ③ **如实暴露**：不拒不改，把实际水位线记进 `adopted_actual` 并告警。
  4650	    取③ —— 账本是**共享事件流**（validator 不校验 A3），A3 是本写点的规则而不是
  4651	    账本的不变量；但分叉必须**可见可审计**，不能静默。
  4652	
  4653	    ⚠️ `ts` **必须与 durable 的采用时刻同源**（三方同瞬间的定义），实际水位线只能
  4654	    记进另一个字段 —— 把 `ts` 改成实际值会让下一轮续跑**永远不收敛**（实测）。
  4655	    """
  4656	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4657	    (vault / "learning_events.jsonl").unlink(missing_ok=True)
  4658	    a = _review_row(event_id="quiz:板A#q1")
  4659	    b = _review_row(event_id="quiz:板B#q1", **{"payload.attempt_count": 2})
  4660	    _write_ledger(vault, a, b)
  4661	    assert _run_validator(vault).returncode == 0, "两条同瞬间的行本身合规"
  4662	    r = _run_writer_settled(
  4663	        vault, _payload(event_id="板Z#q1", ts="2026-08-05T10:00:00Z", review_time="2026-08-05T10:00:00Z")
  4664	    )
  4665	    assert r.returncode == 0, f"外部写入的同瞬间两行不得被拒: {r.stderr[:300]}"
  4666	    nd = (vault / NODE_REL).read_text(encoding="utf-8")
  4667	    actual = re.findall(r'adopted_actual: "([^"]+)"', nd)
  4668	    assert actual == ["2026-08-01T10:00:01Z"], (
  4669	        f"⛔ A3 把第二条推到 W+1s，必须留下审计痕迹（基线取 durable 值就不会推进）: {actual}"
  4670	    )
  4671	    assert "实际写下的水位线" in r.stdout, "分叉必须告警而不是静默"
  4672	    # ⛔ `ts` 仍须与 durable 同源，否则续跑不收敛
  4673	    assert re.findall(r'^    ts: "([^"]+)"', nd, re.M)[:2] == [TS1, TS1], "receipt 的 ts 必须与 durable 同源"
  4674	    # 验伪：没有 A3 推进时不得凭空出现审计字段
  4675	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4676	    (vault / "learning_events.jsonl").unlink(missing_ok=True)
  4677	    _write_ledger(vault, _review_row(event_id="quiz:板A#q1"))
  4678	    r2 = _run_writer_settled(
  4679	        vault, _payload(event_id="板Z#q1", ts="2026-08-05T10:00:00Z", review_time="2026-08-05T10:00:00Z")
  4680	    )
  4681	    assert r2.returncode == 0, r2.stderr[:250]
  4682	    assert "adopted_actual" not in (vault / NODE_REL).read_text(encoding="utf-8"), (
  4683	        "单条 pending 没有 A3 推进，不得凭空写审计字段"
  4684	    )

