   109	def run_settled(vault: Path, **over):
   110	    """跑写点；若因「A2 恢复先落定」被要求重跑，就再跑一次并返回合并结果。
   111	
   112	    存在 foreign pending 时写点会先把恢复结果原子发布、再以非零码退出要求重跑
   113	    （Codex round-3 BLOCKER 的修法：恢复与新写不在同一次运行里混做）。
   114	    """
   115	    r = run(vault, **over)
   116	    if r.returncode != 0 and "恢复已落定" in r.stderr:
   117	        r2 = run(vault, **over)
   118	        return subprocess.CompletedProcess(r2.args, r2.returncode, r.stdout + r2.stdout, r.stderr + r2.stderr)
   119	    return r
   120	
