  4537	def test_round15_event_level_fsrs_applied(vault):
  4538	    """`W >= receipt.ts` 不能证明**特定事件**进过 FSRS —— 后继事件会制造假覆盖。
  4539	
  4540	    ⛔ 实测漏算链：E1 走 degraded（写了校准与 attempt 却没推进 W）后删掉其日志行；
  4541	    E2 正常落账把 W 推过 E1 的 ts；重跑 E1 得 rc=0「已完整应用」且 FSRS 字段完全不变
  4542	    —— E1 的调度贡献**永久漏了一次**。凭据必须是**事件级**、与 frontmatter 同一次原子写。
  4543	    """
  4544	    LED = vault / "learning_events.jsonl"
  4545	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4546	    LED.unlink(missing_ok=True)
  4547	    assert (
  4548	        _run_writer_settled(
  4549	            vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1), env_extra={"FSRS_BRIDGE_REEXEC": "1"}
  4550	        ).returncode
  4551	        == 0
  4552	    )
  4553	    assert "fsrs_applied: false" in (vault / NODE_REL).read_text(encoding="utf-8"), "降级路径必须记 false"
  4554	    LED.write_text("", encoding="utf-8")
  4555	    assert (
  4556	        _run_writer_settled(
  4557	            vault, _payload(event_id="E2#q1", ts="2026-08-01T11:00:00Z", review_time="2026-08-01T11:00:00Z")
  4558	        ).returncode
  4559	        == 0
  4560	    )
  4561	    face = _write_face(vault)
  4562	    r = _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1))
  4563	    assert r.returncode != 0, "后继事件推过的 W 不算这次的调度凭据"
  4564	    assert "fsrs_applied" in r.stderr, r.stderr[:250]
  4565	    assert _write_face(vault) == face, "零写"
  4566	    # 验伪：正常路径写下 true，同输入重跑必须仍幂等
  4567	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4568	    LED.unlink(missing_ok=True)
  4569	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  4570	    assert "fsrs_applied: true" in (vault / NODE_REL).read_text(encoding="utf-8"), "正常路径必须记 true"
  4571	    LED.write_text("", encoding="utf-8")
  4572	    r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  4573	    assert r2.returncode == 0, f"正常路径的续跑必须仍能恢复: {r2.stderr[:250]}"
