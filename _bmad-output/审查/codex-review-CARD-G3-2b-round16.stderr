    77	def run(vault: Path, **over):
    78	    payload = {
    79	        "node": NODE_REL,
    80	        "grade_norm": 0.752,
    81	        "ts": TS1,
    82	        # 稳定业务时刻（检验白板 Step 3 的 scored_at）。默认与 ts 同值；
    83	        # 只改 ts 表示「同一次评分的续跑」，同时给 event_id 表示「另一次评分」。
    84	        "review_time": TS1,
    85	        "event_id": EID,
    86	        "exam_board": "检验白板/测试检验-2026-08-01-1000.md",
    87	        "question_id": "q1",
    88	        "source_board": "[[原白板/CS 61B]]",
    89	        "self_confidence_raw": "半懂",
    90	        "self_confidence_norm": 0.5,
    91	        "abandoned": False,
    92	        "callout": "",
    93	    }
    94	    if "ts" in over and "review_time" not in over and "event_id" in over:
    95	        payload["review_time"] = over["ts"]
    96	    payload.update(over)
    97	    pfile = vault.parent / "payload.json"
    98	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    99	    return subprocess.run(
   100	        [sys.executable, "-c", CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))],
   101	        capture_output=True,
   102	        text=True,
   103	        timeout=180,
   104	        cwd=str(vault),
   105	        env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"),
   106	    )
