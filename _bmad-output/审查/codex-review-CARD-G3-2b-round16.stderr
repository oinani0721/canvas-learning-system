  1047	    # gn=None ⇒ 用本次评分的 GN2; A2 重放别人的事件时传那行 durable 的 grade_norm。
  1048	    a_, b_ = update_after_idle(a_, b_, GN2 if gn is None else float(gn), days_idle)
  1049	    return old, a_, b_, round(mu(a_, b_), 2)
