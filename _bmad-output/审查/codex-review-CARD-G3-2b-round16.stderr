   216	def _writer_code(vault: Path, payload: dict) -> str:
   217	    pfile = vault.parent / "payload.json"
   218	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   219	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   220	
   221	
   222	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   223	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   224	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   225	    return subprocess.run(
   226	        [sys.executable, "-c", _writer_code(vault, payload)],
   227	        capture_output=True,
   228	        text=True,
   229	        timeout=180,
   230	        cwd=str(vault),
   231	        env=env,
   232	    )
   233	
   234	
   235	def _sha(p: Path) -> str:
   236	    import hashlib
   237	
   238	    return hashlib.sha256(p.read_bytes()).hexdigest()
