   402	def _no_dup_keys(pairs):
   403	    _seen = set()
   404	    for _k, _ in pairs:
   405	        if _k in _seen:
   406	            raise _DupKey(repr(_k))
   407	        _seen.add(_k)
   408	    return dict(pairs)
