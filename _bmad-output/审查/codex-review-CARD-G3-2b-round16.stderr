  2142	            mo_att = re.search(_ATT_RE, fm, re.M)
  2143	            n_att = (int(mo_att.group(1)) if mo_att else 0) + 1
  2144	        fm = re.sub(r'^(mastery_score|mastery|mastery_level|mastery_a|mastery_b|attempt_count|last_examined):.*\r?\n?', '', fm, flags=re.M)
