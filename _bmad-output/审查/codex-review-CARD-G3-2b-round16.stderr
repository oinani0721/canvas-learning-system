  1271	def test_six_cell_state_machine_closed(vault):
  1272	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1273	    foreign = _review_row(event_id="quiz:板A#q1")
  1274	    _write_ledger(vault, foreign)
  1275	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z"))
  1276	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1277	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1278	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1279	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1280	
  1281	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1282	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1283	    sha_before = _sha(vault / NODE_REL)
  1284	    # 同一次评分的**续跑**（同 event_id 的旧写序孤儿）：ts 变而稳定业务时刻不变。
  1285	    # round-9 后 F1-only 会拿 receipt 与本次逐项比对 —— 若这里让 review_time
  1286	    # 跟着 ts 走，那就成了「同 ID 承载另一次评分」，会被正确拒绝。
  1287	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z", review_time="2026-08-02T10:00:00Z"))
  1288	    assert r2.returncode == 0, r2.stdout + r2.stderr
  1289	    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
  1290	    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
  1291	
  1292	    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
  1293	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1294	    (vault / "learning_events.jsonl").unlink()
  1295	    assert _run_writer(vault, _payload()).returncode == 0
  1296	    sha_full = _sha(vault / NODE_REL)
  1297	    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
  1298	    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
  1299	    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
  1300	
  1301	    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
  1302	    _strip_calibration(vault)
  1303	    sha_stripped = _sha(vault / NODE_REL)
  1304	    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
  1305	    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
  1306	    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
  1307	    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
  1308	
  1309	    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
  1310	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1311	    (vault / "learning_events.jsonl").unlink()
  1312	    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
  1313	    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"
  1314	    ema_before = {
