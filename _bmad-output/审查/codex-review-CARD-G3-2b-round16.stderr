   322	def _adopted_ok(_sa, _w_inst, _got):
   323	    """采用时刻 `_got` 是否**可解释**。
   324	
   325	    ⛔ 可证的不变量不是「等于 A3 推后的值」—— **外部写入方未必实施 A3**（validator
   326	    也不要求）。可解释的只有两个值: ①`scored_at` 截整秒后的原值（没推过）;
   327	    ②A3 从它推后的值。两者都合法, 别的都无法解释(那正是篡改的样子)。
   328	    ⚠️ round-14 我第一版只认②, 于是把「两条 pending 同一瞬间」这类**外部写入的
   329	    合法行**误拒了 —— 收紧到比审查要求更严, 又一次「加严不等于更安全」。
   330	    """
   331	    if _got is None:
   332	        return False
   333	    _pushed = _adopted_from(_sa, _w_inst)
   334	    _plain = _adopted_from(_sa, None)
   335	    return _got == _pushed or _got == _plain
