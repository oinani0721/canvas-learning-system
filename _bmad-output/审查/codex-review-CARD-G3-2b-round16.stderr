  1334	def _validate_review_ext(
  1335	    payload: dict, record: dict, manifest: Optional[dict], vault_id: Optional[str] = None
  1336	) -> tuple[list[str], list[str]]:
  1337	    """§六 复习域扩展行 (payload.schema_ext == 'review/1') 的完整语义校验。
  1338	
  1339	    → (violations, warnings)
  1340	
  1341	    绑定面 (round-2 HIGH + round-3 HIGH):
  1342	      - 挂载点: 只许 answer_scored / answer_abandoned (曾可挂 session_archived);
  1343	      - 身份: concept_id == 顶层 node_id;
  1344	      - 时刻: review_time 与 effective_at 同一瞬间 (Z/+00:00 语义比较),
  1345	        且**必须整秒** — W (fsrs_last_review) 只有整秒精度, 小数秒会让
  1346	        同一事件恒满足 `> W` 而二次推进 (round-3 BLOCKER, §6.2 A5);
  1347	      - 评分自洽: grade_norm ∈ [0,1] 必填; answer_scored 的 rating 必须等于
  1348	        rating_from_grade(grade_norm); answer_abandoned 的 rating 恒为 1
  1349	        ([Decision-FSRS-1] 弃答一票否决 Again);
  1350	      - 库指纹: 非降级时须与 G3-4 golden manifest 的 library_version/
  1351	        params_hash **真值相等** (manifest 不可达时降级为形状校验 + WARN);
  1352	        degraded 哨兵成对且原因非空。
  1353	    """
  1354	    problems: list[str] = []
  1355	    warnings: list[str] = []
  1356	
  1357	    event_type = record.get("event_type")
  1358	    if event_type not in REVIEW_EVENT_TYPES:
  1359	        problems.append(
  1360	            f"schema_ext='{REVIEW_EXT_MARKER}' 只许挂在 {sorted(REVIEW_EVENT_TYPES)} 上, 实为 {event_type!r}"
  1361	        )
  1362	
  1363	    rating = payload.get("rating")
  1364	    rating_ok = not isinstance(rating, bool) and isinstance(rating, int) and rating in (1, 2, 3, 4)
  1365	    if not rating_ok:
  1366	        problems.append("扩展键 rating 必须为 int 1-4 (FSRS Rating)")
  1367	
  1368	    marker_value = payload.get("out_of_order", None)
  1369	    if "out_of_order" in payload and marker_value is not True:
  1370	        problems.append(
  1371	            f"payload.out_of_order 唯一合法值为布尔 true, 实为 {marker_value!r} — "
  1372	            "未标乱序时不得写该键 (§6.2 字段冻结: false/字符串/对象均会让 pending 排除条件产生歧义)"
  1373	        )
  1374	
  1375	    review_time = payload.get("review_time")
  1376	    ok, why = _parse_ts(review_time, upper_bound=REVIEW_INPUT_MAX)
  1377	    if not ok:
  1378	        problems.append(f"扩展键 review_time {why}")
  1379	    else:
  1380	        if _SUBSECOND_RE.match(review_time):
  1381	            problems.append(
  1382	                f"扩展键 review_time 必须为整秒 {review_time!r} — frontmatter 水位线 "
  1383	                "fsrs_last_review 只有整秒精度 (§6.2 A5), 小数秒会导致同一事件二次推进"
  1384	            )
  1385	        elif not _WHOLE_SECOND_RE.match(review_time):
  1386	            problems.append(
  1387	                f"扩展键 review_time 必须为完整整秒形态 YYYY-MM-DDTHH:MM:SS(Z|±HH:MM), "
  1388	                f"实为 {review_time!r} — 省略秒段与 W 的整秒口径对不齐 (§6.2 A5)"
  1389	            )
  1390	        left, right = _instant(review_time), _instant(record.get("effective_at"))
  1391	        if left is None or right is None or left != right:
  1392	            problems.append(
  1393	                f"扩展键 review_time {review_time!r} 与顶层 effective_at "
  1394	                f"{record.get('effective_at')!r} 不是同一瞬间 (§6.1)"
  1395	            )
  1396	
  1397	    for key in ("vault_id", "concept_id"):
  1398	        value = payload.get(key)
  1399	        if not isinstance(value, str) or not value:
  1400	            problems.append(f"扩展键 {key} 必须为非空字符串")
  1401	    declared_vault = payload.get("vault_id")
  1402	    if isinstance(declared_vault, str) and declared_vault:
  1403	        if vault_id is None:
  1404	            warnings.append("vault_id 未绑定 — 账本同目录无 .canvas-config.yaml 或其中无 vault_id 键")
  1405	        elif declared_vault != vault_id:
  1406	            problems.append(
  1407	                f"扩展键 vault_id {declared_vault!r} != 账本所在 vault 声明的 {vault_id!r} "
  1408	                "(.canvas-config.yaml) — 事件写错 vault 或账本被搬运"
  1409	            )
  1410	    concept_id = payload.get("concept_id")
  1411	    node_id = record.get("node_id")
  1412	    if isinstance(concept_id, str) and concept_id and concept_id != node_id:
  1413	        problems.append(
  1414	            f"扩展键 concept_id {concept_id!r} != 顶层 node_id {node_id!r} (§6.1 映射关系: node_id 承载 concept_id)"
  1415	        )
  1416	
  1417	    grade_norm = payload.get("grade_norm")
  1418	    grade_ok = (
  1419	        not isinstance(grade_norm, bool) and isinstance(grade_norm, (int, float)) and 0.0 <= float(grade_norm) <= 1.0
  1420	    )
  1421	    if not grade_ok:
  1422	        problems.append("扩展键 grade_norm 必须为 [0,1] 区间数值")
  1423	    if event_type == "answer_abandoned":
  1424	        if rating_ok and rating != 1:
  1425	            problems.append(
  1426	                f"answer_abandoned 的 rating 必须为 1 (弃答一票否决 Again, [Decision-FSRS-1]), 实为 {rating}"
  1427	            )
  1428	    elif event_type == "answer_scored" and rating_ok and grade_ok:
  1429	        expected = _rating_from_grade_norm(float(grade_norm))
  1430	        if rating != expected:
  1431	            problems.append(
  1432	                f"rating {rating} 与 grade_norm {grade_norm} 不自洽 (rating_from_grade 口径应为 {expected})"
  1433	            )
  1434	
  1435	    # 防御: _golden_manifest 已保证 dict|None, 此处对任意坏值也不炸
  1436	    # (round-4 MEDIUM: 非 dict manifest 曾可触发 AttributeError)
  1437	    manifest = manifest if isinstance(manifest, dict) else None
  1438	    truth_version = manifest.get("library_version") if manifest else None
  1439	    truth_hash = manifest.get("params_hash") if manifest else None
  1440	    degraded_flags = []
  1441	    for key, shape_re, shape_desc, truth in (
  1442	        ("fsrs_library_version", _VERSION_RE, "数字点版 (如 6.3.1)", truth_version),
  1443	        ("fsrs_params_hash", _HASH_RE, "64 位小写 hex (sha256)", truth_hash),
  1444	    ):
  1445	        value = payload.get(key)
  1446	        if not isinstance(value, str) or not value:
  1447	            problems.append(f"扩展键 {key} 必须为非空字符串 (降级时用 'degraded:<原因>')")
  1448	            degraded_flags.append(None)
  1449	            continue
  1450	        if value.startswith(DEGRADED_PREFIX):
  1451	            degraded_flags.append(True)
  1452	            if not value[len(DEGRADED_PREFIX) :].strip():
  1453	                problems.append(f"扩展键 {key} 的 degraded 哨兵必须带非空原因")
  1454	            continue
  1455	        degraded_flags.append(False)
  1456	        if not shape_re.match(value):
  1457	            problems.append(f"扩展键 {key} 形状非法 (须为{shape_desc}或 degraded 哨兵): {value!r}")
  1458	        elif truth is None:
  1459	            warnings.append(f"{key} 只做形状校验 — 未找到同仓 fsrs_golden_manifest.json, 无法绑定真值")
  1460	        elif value != truth:
  1461	            problems.append(
  1462	                f"扩展键 {key} {value!r} != G3-4 golden manifest 真值 {truth!r} (§6.1 库指纹必须与冻结基线同源)"
  1463	            )
  1464	    if len(set(f for f in degraded_flags if f is not None)) > 1:
  1465	        problems.append(
  1466	            "fsrs_library_version 与 fsrs_params_hash 的 degraded 状态必须成对 "
  1467	            "(§6.1: 降级时两键同为哨兵, 正常时两键同为真实值)"
  1468	        )
  1469	    return problems, warnings
