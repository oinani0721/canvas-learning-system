  4576	def test_round15_board_no_self_produced_rejection(vault):
  4577	    """writer 自己能产出的 `exam_board` 形态（null / true），重跑不得被自己拒。"""
  4578	    LED = vault / "learning_events.jsonl"
  4579	    for label, board in (("null", None), ("true", True)):
  4580	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4581	        LED.unlink(missing_ok=True)
  4582	        r1 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, exam_board=board))
  4583	        assert r1.returncode == 0, f"[{label}] 首写应放行: {r1.stderr[:200]}"
  4584	        assert _run_validator(vault).returncode == 0, f"[{label}] 产物必须合规"
  4585	        LED.write_text("", encoding="utf-8")
  4586	        r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, exam_board=board))
