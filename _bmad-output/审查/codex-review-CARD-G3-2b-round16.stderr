   798	    # 上一版第一行就是 `if _fm_has_event(fm_text, ev_id): return True` ——
   799	    # 实测漏账链: 首次提交 event_id='quiz:K' ⇒ 账本行 `quiz:quiz:K`; 把校准改成
   800	    # 历史形态 `quiz:K`; 再提交**新** id `K`(完整 id 也是 `quiz:K`) ⇒ exact 命中
   801	    # 那条历史条目、判「已完整应用」而幂等跳过, **账本/attempt/校准都没增加**。
   802	    #
   803	    # 正确做法: 一个校准 token 可能来自两种来源 —— 某个账本 id 的**完整**形态,
   804	    # 或某个带 `quiz:` 前缀的账本 id 的**历史裸**形态。先把命中的 token 反查回
   805	    # **所有可能的来源 id**, 再要求那个集合**恰为**当前这一个 id。
   806	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   807	    if not _cands:
   808	        return False
   809	    # ⚠️ 与 `_resolve_receipt` 的**有意差异**(不是分叉遗漏, 见 `_cands_and_sources`):
   810	    # 这里空来源集合**放行**。因为本函数只回答「校准里有没有这条」, 而
   811	    # 「账本行本就丢失」正是 F1-only 分支的前提 —— 在那里强制来源非空, 等于要求
   812	    # 证明一个前提上不存在的东西。来源为空时的**证明责任**由 F1-only 分支的
   813	    # `_resolve_receipt(..., require_source=False, facts=...)` 用六项事实承担。
   814	    if _sources and _sources != {ev_id}:
