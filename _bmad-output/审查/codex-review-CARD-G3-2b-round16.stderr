   632	        "scored_at": (str(_pl.get("scored_at") or _pl.get("review_time") or ""), _ok_str),
   633	        "attempt_count": (_pl.get("attempt_count"), _ok_att),
   634	        # ⛔ round-13 HIGH: **消费侧不得单方面改值**。此前这里 `round(..., 2)` 而
   635	        # receipt 存的是原值 ⇒ 合法的 `grade_norm=0.752`(validator rc=0) 与 receipt
   636	        # 的 0.752 比出 `0.752 != 期望 0.75`, **两阶段永久不收敛**。
   637	        # 要强制两位小数就得同时改 schema + validator + 所有生产者, 不能只在比较侧 round。
   638	        "grade_norm": (_norm_gn(_pl.get("grade_norm")), _ok_gn),
   639	        "abandoned": (_o.get("event_type") == "answer_abandoned", _ok_bool),
   640	        # ⛔ 同上: `str()` 强转 + string-only 校验会拒掉 writer **自己产出**的
   641	        # validator-valid 状态(实测 `exam_board=123` 首跑 rc=0、账本与 receipt 都存
   642	        # 整数 123, 紧接着同输入重跑 rc=1「类型非法」)。按原始 JSON 值比较;
   643	        # 默认值与 receipt 写侧逐字同款(`.get("exam_board", "")`), 否则缺字段时两边错位。
   644	        "exam_board": (_norm_board(_pl.get("exam_board", "")), _ok_board),
   645	    }
