  1017	def _apply_mastery(fm_text, biz_ts, gn=None):
  1018	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
  1019	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
  1020	    old = None
  1021	    for key in ("mastery_score", "mastery", "mastery_level"):
  1022	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
  1023	        if mo:
  1024	            old = float(mo.group(1)); break
  1025	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
  1026	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
  1027	    if ma and mb:
  1028	        a_, b_ = float(ma.group(1)), float(mb.group(1))
  1029	    elif old is not None:
  1030	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
  1031	    else:
