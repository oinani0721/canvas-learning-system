   143	def _write_ledger(vault: Path, *rows, trailing_lf=True):
   144	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
   145	    if not trailing_lf and text.endswith("\n"):
   146	        text = text[:-1]
   147	    (vault / "learning_events.jsonl").write_text(text, encoding="utf-8")
   148	
