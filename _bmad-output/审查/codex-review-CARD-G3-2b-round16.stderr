  4418	def test_round14_legacy_precision_identity(vault):
  4419	    """本写点产不出的**多位小数** durable 值：要求用户这次给的原始输入精确匹配。
  4420	
  4421	    ⛔ 旧实现拿 `GN2`（两位）比原精度 durable 值 ⇒ 那行能被 foreign replay 恢复，
  4422	    却**永远无法由原白板重跑落定**（rc=1 canonical envelope 冲突、零写）。
  4423	    """
  4424	    LED = vault / "learning_events.jsonl"
  4425	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4426	    LED.unlink(missing_ok=True)
  4427	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  4428	    rows = list(_ledger_lines(vault))
  4429	    rows[0]["payload"]["grade_norm"] = 0.752
  4430	    LED.write_text(json.dumps(rows[0], ensure_ascii=False) + "\n", encoding="utf-8")
  4431	    nd = (vault / NODE_REL).read_text(encoding="utf-8")
  4432	    (vault / NODE_REL).write_text(
  4433	        re.sub(r"^    grade_norm: .*$", "    grade_norm: 0.752", nd, count=1, flags=re.M), encoding="utf-8"
  4434	    )
  4435	    assert _run_validator(vault).returncode == 0
  4436	    r = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, grade_norm=0.752))
  4437	    assert r.returncode == 0, f"⛔ 给出原值时必须能落定: {r.stderr[:300]}"
  4438	    # 验伪：真正不同的分数仍必须拒
  4439	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4440	    LED.unlink(missing_ok=True)
  4441	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  4442	    rows2 = list(_ledger_lines(vault))
  4443	    rows2[0]["payload"]["grade_norm"] = 0.752
  4444	    LED.write_text(json.dumps(rows2[0], ensure_ascii=False) + "\n", encoding="utf-8")
  4445	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4446	    r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, grade_norm=0.31))
  4447	    assert r2.returncode != 0, "真正不同的分数仍必须拒"
