  1093	def _normalize_inline_calibration(fm_text):
  1094	    """`calibration_log: []` (inline 空列表) 必须先原子改写成 block 形态, 否则
  1095	    后面直接在它下面插缩进条目会产出**非法 YAML** (`calibration_log: []` 后跟
  1096	    缩进列表) —— 实测首次评分 rc=0 且 attempt/W/账本都已推进, 同事件重跑却报
  1097	    「FSRS 已应用但缺校准记录」⇒ 两阶段流程**永久不收敛** (Codex round-6 HIGH)。
  1098	    """
  1099	    # 同样容尾注释: `calibration_log: [] # comment` 若不规范化会被写成非法 YAML。
  1100	    # ⛔ `null` / `~` 也必须规范化 (Codex round-9 HIGH): 它们同样是**合法 YAML**,
  1101	    # 直接在其下插缩进条目会产出 `mapping values are not allowed here` 的非法
  1102	    # 文档 —— 首跑 rc=0 但节点从此不可解析, 后续所有评分连锁失败。
  1103	    return re.sub(
  1104	        r"^calibration_log:[ \t]*(?:\[[ \t]*\]|null|Null|NULL|~)?[ \t]*(#[^\n]*)?$",
  1105	        lambda m: "calibration_log:" + (" " + m.group(1) if m.group(1) else ""),
  1106	        fm_text, count=1, flags=re.M,
  1107	    )
