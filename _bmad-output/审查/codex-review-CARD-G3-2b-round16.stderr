  2148	        if cal and cal not in body:
  2149	            body = body.rstrip() + "\n\n" + cal + "\n"
  2150	        print(f"[quiz-answer] A2 恢复(崩溃窗口①): mastery {old}->{new}; FSRS+EMA+校准全套补齐 @ {review_time}")
  2151	    # ── A4.4 原子发布 (恢复路径)
  2152	    _f = open(NODE + ".quiz-tmp", "w", encoding="utf-8")
  2153	    _f.write(f"---\n{fm}\n---\n{body}")
  2154	    _f.flush()
  2155	    os.fsync(_f.fileno())
  2156	    _f.close()
