  1332	    assert r6.returncode == 0 and "崩溃窗口" in r6.stdout, r6.stdout + r6.stderr
  1333	    assert (vault / NODE_REL).read_bytes() == golden, "格6: 恢复产物必须与直接应用逐字节相同"
  1334	    assert len(_ledger_lines(vault)) == 1
  1335	    assert _run_validator(vault).returncode == 0, "六格走完后账本仍须过校验器"
  1336	
