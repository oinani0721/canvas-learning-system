  1252	def _strip_calibration(vault: Path) -> None:
  1253	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1254	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1255	    head, fm, body = text.split("---\n", 2)
  1256	    lines, out, skipping = fm.split("\n"), [], False
  1257	    for ln in lines:
  1258	        if ln.startswith("calibration_log:"):
  1259	            skipping = True
  1260	            continue
  1261	        if skipping and (ln.startswith("  ") or ln == ""):
  1262	            continue
  1263	        skipping = False
  1264	        out.append(ln)
  1265	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1266	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1267	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1268	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
