   552	def _num_norm(v):
   553	    """递归地把数值统一成 float（**bool 除外**），供 envelope 与逐字段比较共用。
   554	
   555	    ⛔ round-15 自查: `1` 与 `1.0` 是同一数值的两种合法 JSON 书写（外部写入方可能
   556	    用 int，validator rc=0），而写侧 `round(float(x),2)` 恒产出 float ⇒ 用户以
   557	    `1.0` 重跑被 envelope 冲突**误拒**（实测可达）。
   558	    ⚠️ `True/False` 必须与 1/0 区分（round-14 BLOCKER③），所以 bool 先判、原样保留。
   559	    ⚠️ envelope 走整体 `json.dumps`、逐字段走 `_canon_fact`，是**两种比较机制**，
   560	    「抽成一份实现」在这里不适用 —— 共用的是**规则**（这个函数），不是实现。
   561	    """
   562	    if isinstance(v, bool):
   563	        return v
   564	    if isinstance(v, (int, float)):
   565	        # ⛔ round-15 审查独立指出: 不能递归 `float()` —— 它会把
   566	        # 9007199254740992 与 ...93 塌成同一个值（超出 float 尾数精度）。
   567	        # `Decimal` 同时满足四条: 大整数不塌缩 / `1 == 1.0` / `0.75 == 0.750` / `-0.0 == 0`。
   568	        # ⚠️ 这个精度 bug 是我上一小时自己引入的 —— 自查发现了缺陷方向，
   569	        # 却在修法里带进了新的丢精度面。**修复本身同样需要被审查。**
   570	        try:
   571	            _d = decimal.Decimal(v if isinstance(v, int) else repr(v))
   572	            if not _d.is_finite():
   573	                return f"nf:{v!r}"
   574	            _d = _d.normalize()
   575	            # ⚠️ `-0.0` 与 `0` 是同一个数值, 但 Decimal 保留符号 ⇒ normalize 后
   576	            # 字符串仍是 `-0`。显式归零(逐条构造反例才发现, 只测顶层标量会漏)。
   577	            return decimal.Decimal(0) if _d == 0 else _d
   578	        except (ArithmeticError, ValueError, TypeError):
   579	            return f"nf:{v!r}"
   580	    if isinstance(v, dict):
   581	        return {k: _num_norm(x) for k, x in v.items()}
   582	    if isinstance(v, list):
   583	        return [_num_norm(x) for x in v]
   584	    return v
   585	
