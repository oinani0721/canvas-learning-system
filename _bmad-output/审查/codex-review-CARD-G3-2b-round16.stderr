  4381	def test_round14_every_pending_proves_adopted_time(vault):
  4382	    """**每条** pending 都要在调 bridge 前证明采用时刻，且基线随复放滚动。
  4383	
  4384	    ⛔ round-13 的证明只覆盖当前 dup，foreign pending 可携带任意采用时刻被重放
  4385	    （实测 W 被推进到 2026-12-01，此后所有早于 12 月的真实复习都被当成已过线）。
  4386	    """
  4387	    LED = vault / "learning_events.jsonl"
  4388	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4389	    LED.unlink(missing_ok=True)
  4390	    row = _review_row(event_id="quiz:板A#q1")
  4391	    row["payload"]["scored_at"] = TS1
  4392	    row["payload"]["review_time"] = "2026-12-01T10:00:00Z"
  4393	    row["effective_at"] = "2026-12-01T10:00:00Z"
  4394	    _write_ledger(vault, row)
  4395	    assert _run_validator(vault).returncode == 0, "被篡改的行本身仍合规"
  4396	    r = _run_writer_settled(
  4397	        vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z")
  4398	    )
  4399	    assert r.returncode != 0, "foreign pending 的采用时刻同样要证"
  4400	    assert not (_fm_fields(vault).get("fsrs_last_review") or "").startswith("2026-12"), "W 不得被推到篡改值"
  4401	    # 验伪：**未实施 A3 的外部合法行**不得被误拒。
  4402	    # ⚠️ 场景必须让「A3 推后值」与「截整秒原值」**真的不同** —— 单条 pending 时
  4403	    # 两者恒等（W 为空或行晚于 W），验伪落空（M131 此前正是这样活下来的）。
  4404	    # 两条同瞬间的 pending 才行：复放第一条后基线滚到 TS1，第二条的推后值是 TS1+1s，
  4405	    # 而它记的是 TS1（外部写入方没实施 A3）—— 只有「两个可解释值」的口径才放行。
  4406	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4407	    LED.unlink(missing_ok=True)
  4408	    a = _review_row(event_id="quiz:板A#q1")
  4409	    b = _review_row(event_id="quiz:板B#q1", **{"payload.attempt_count": 2})
  4410	    _write_ledger(vault, a, b)
  4411	    assert _run_validator(vault).returncode == 0, "两条同瞬间的行本身合规"
  4412	    r2 = _run_writer_settled(
  4413	        vault, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z", review_time="2026-08-05T10:00:00Z")
  4414	    )
  4415	    assert r2.returncode == 0, f"⛔ 外部写入方未必实施 A3，两个可解释值都合法: {r2.stderr[:300]}"
  4416	
