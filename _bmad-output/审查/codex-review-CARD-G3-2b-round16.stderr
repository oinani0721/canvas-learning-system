  1455	        degraded_flags.append(False)
  1456	        if not shape_re.match(value):
  1457	            problems.append(f"扩展键 {key} 形状非法 (须为{shape_desc}或 degraded 哨兵): {value!r}")
  1458	        elif truth is None:
  1459	            warnings.append(f"{key} 只做形状校验 — 未找到同仓 fsrs_golden_manifest.json, 无法绑定真值")
  1460	        elif value != truth:
  1461	            problems.append(
  1462	                f"扩展键 {key} {value!r} != G3-4 golden manifest 真值 {truth!r} (§6.1 库指纹必须与冻结基线同源)"
  1463	            )
  1464	    if len(set(f for f in degraded_flags if f is not None)) > 1:
  1465	        problems.append(
  1466	            "fsrs_library_version 与 fsrs_params_hash 的 degraded 状态必须成对 "
  1467	            "(§6.1: 降级时两键同为哨兵, 正常时两键同为真实值)"
  1468	        )
  1469	    return problems, warnings
  1470	
  1471	
  1472	def validate_record(record: object, manifest: Optional[dict] = None, vault_id: Optional[str] = None) -> list[str]:
  1473	    """单条 v1 记录的违规清单 (空 = 合规); 便捷入口, 丢弃 warnings。"""
  1474	    return validate_record_full(record, manifest, vault_id)[0]
  1475	
  1476	
  1477	def validate_record_full(
  1478	    record: object, manifest: Optional[dict] = None, vault_id: Optional[str] = None
  1479	) -> tuple[list[str], list[str]]:
  1480	    """单条 v1 记录 → (violations, warnings)。
  1481	
  1482	    调用方须先按 §一 前向兼容规则分流: event_version 为 int 且 != 1 的行
  1483	    不应进入本函数 (validate_file 已处理)。
  1484	    """
  1485	    problems: list[str] = []
  1486	    warnings: list[str] = []
  1487	    if not isinstance(record, dict):
  1488	        return ["顶层必须是 JSON object"], warnings
  1489	
  1490	    keys = set(record.keys())
  1491	    missing = sorted(TOP_LEVEL_KEYS - keys)
  1492	    extra = sorted(keys - TOP_LEVEL_KEYS)
  1493	    if missing:
  1494	        problems.append(f"缺字段: {', '.join(missing)}")
  1495	    if extra:
  1496	        problems.append(f"未知顶层字段 (v1 冻结恰好 7 键): {', '.join(extra)}")
  1497	
  1498	    event_id = record.get("event_id")
  1499	    if "event_id" in keys and (not isinstance(event_id, str) or not event_id):
  1500	        problems.append("event_id 必须为非空字符串 (幂等键)")
  1501	
  1502	    version = record.get("event_version")
  1503	    if "event_version" in keys and (isinstance(version, bool) or not isinstance(version, int)):
  1504	        problems.append("event_version 必须为整数")
  1505	
  1506	    event_type = record.get("event_type")
  1507	    if "event_type" in keys:
  1508	        if not isinstance(event_type, str):
  1509	            problems.append("event_type 必须为字符串")
  1510	        elif event_type not in EVENT_TYPES:
  1511	            problems.append(f"event_type {event_type!r} 不在 9 类白名单")
  1512	
  1513	    if "node_id" in keys and not isinstance(record.get("node_id"), str):
  1514	        problems.append("node_id 必须为字符串 (可为空串)")
  1515	
  1516	    for field in ("recorded_at", "effective_at"):
  1517	        if field in keys:
  1518	            ok, why = _parse_ts(record.get(field))
  1519	            if not ok:
  1520	                problems.append(f"{field} {why}")
  1521	
  1522	    payload = record.get("payload")
  1523	    if "payload" in keys and not isinstance(payload, dict):
  1524	        problems.append("payload 必须为 JSON object")
  1525	    elif isinstance(payload, dict):
  1526	        marker = payload.get("schema_ext")
  1527	        if marker == REVIEW_EXT_MARKER:
  1528	            ext_problems, ext_warnings = _validate_review_ext(payload, record, manifest, vault_id)
  1529	            problems.extend(ext_problems)
  1530	            warnings.extend(ext_warnings)
  1531	        elif "schema_ext" in payload:
  1532	            # marker 降级绕过 (round-3 HIGH): 'review/01' / 非字符串等
  1533	            # 曾让扩展门整体静默跳过, 坏行伪装成历史行 exit 0
  1534	            problems.append(
  1535	                f"payload.schema_ext 值非法 {marker!r} — v1 仅定义 '{REVIEW_EXT_MARKER}'; "
  1536	                "禁止以未知 marker 绕过扩展校验"
  1537	            )
  1538	        elif event_type in REVIEW_EVENT_TYPES and _looks_like_review_ext(payload):
  1539	            # 带扩展键但无 marker: 同样按扩展行校验, 防"去掉 marker 即免检"
  1540	            problems.append(
  1541	                "复习事件 payload 含扩展键但缺 schema_ext 标记 — 新写入必须显式标 "
  1542	                f"'{REVIEW_EXT_MARKER}' (§6.1 机械标记), 历史行不得追加扩展键"
  1543	            )
  1544	
  1545	    return problems, warnings
  1546	
  1547	
  1548	def validate_file(path: Path) -> tuple[list[str], list[str]]:
  1549	    """整文件校验 → (violations, warnings), 均按行号升序。
  1550	
  1560	    with open(path, "rb") as f:
  1561	        for lineno, raw in enumerate(f, 1):
  1562	            try:
  1563	                decoded = raw.decode("utf-8")
  1564	            except UnicodeDecodeError as e:
  1565	                violations.append(f"LINE {lineno}: 非法 UTF-8 字节序列 (offset {e.start}) — 疑似损坏行")
  1566	                continue
  1567	            # 只剥行尾 CR/LF: str.strip() 会连 RFC 8259 禁止的控制字符
  1568	            # (U+001C-1F 等) 一并洗掉, 让敌对行伪装成合法 JSON (Codex round-2 HIGH)
  1569	            line = decoded.rstrip("\r\n")
  1570	            if not line.strip():
  1571	                violations.append(f"LINE {lineno}: 空行 (append-only JSONL 不应出现)")
  1572	                continue
  1573	            try:
  1574	                record = _strict_loads(line)
  1575	            except json.JSONDecodeError as e:
  1576	                violations.append(f"LINE {lineno}: JSON 解析失败 ({e.msg}) — 疑似截断/损坏行")
  1577	                continue
  1578	            except _NonStandardJSON as e:
  1579	                violations.append(f"LINE {lineno}: {e}")
  1580	                continue
  1581	            except ValueError as e:
  1582	                # 超长整数字面量 (int_max_str_digits) 等 stdlib 限额 —
  1583	                # 该行判违规, 不炸整个校验 (Codex round-2 MEDIUM)
  1584	                violations.append(f"LINE {lineno}: JSON 值超出解析限额 ({e})")
  1585	                continue
  1586	            except RecursionError:
  1587	                # 深层嵌套 (round-3 MEDIUM: ~50 万层曾栈溢出并静默中断后续行)
  1588	                violations.append(f"LINE {lineno}: JSON 嵌套过深, 超出解析器递归上限 — 疑似构造行")
  1589	                continue
  1590	
  1591	            # 前向兼容分流 (§一): 未知 int 版本 → 只 WARN, 完全跳过 v1 形状校验
  1592	            # (仍登记 event_id 唯一性 — 幂等键跨版本恒定, append_event 不看版本查重)
  1593	            if isinstance(record, dict):
  1594	                version = record.get("event_version")
  1595	                unknown_version = (
  1596	                    isinstance(version, int) and not isinstance(version, bool) and version != EVENT_VERSION
  1597	                )
  1598	            else:
  1599	                unknown_version = False
  1600	
  1601	            if unknown_version:
  1602	                warnings.append(
  1603	                    f"LINE {lineno}: event_version={version} != {EVENT_VERSION} — "
  1604	                    "前向兼容跳过形状校验 (读方须容忍未知版本)"
  1605	                )
  1606	                # round-21 Codex MEDIUM: §一 路由信封是**跨版本义务**, 优先于
  1607	                # "v2 可删除/改名任一顶层字段"。此前 schema 写了"必须保留", 主体
  1608	                # 却对未知版本整行跳过、只发 WARN —— 规范说必须却没有门, 于是
  1609	                # 「proof scanner 拒绝、主体裁判接受」并存。前向兼容跳过的是
  1610	                # **形状校验**, 不包括信封本身。
  1611	                for key, ok in (
  1612	                    ("event_id", isinstance(record.get("event_id"), str) and bool(record["event_id"])),
  1613	                    ("node_id", isinstance(record.get("node_id"), str)),
  1614	                ):
  1615	                    if not ok:
  1616	                        violations.append(
  1617	                            f"LINE {lineno}: 未知版本记录缺少路由信封键 {key} "
  1618	                            f"(§一: event_id/event_version/node_id 任何版本都必须保留, "
  1619	                            f"否则读方无法判定归属)"
  1620	                        )
  1621	            else:
  1622	                line_problems, line_warnings = validate_record_full(record, manifest, vault_id)
  1623	                for problem in line_problems:
  1624	                    violations.append(f"LINE {lineno}: {problem}")
  1625	                for warning in line_warnings:
  1626	                    warnings.append(f"LINE {lineno}: {warning}")
  1627	
  1628	            if isinstance(record, dict):
  1629	                event_id = record.get("event_id")
  1630	                if isinstance(event_id, str) and event_id:
  1631	                    if event_id in seen_ids:
  1632	                        violations.append(
  1633	                            f"LINE {lineno}: event_id {event_id!r} 重复 "
  1634	                            f"(首见 LINE {seen_ids[event_id]}) — 幂等键必须全文件唯一"
  1635	                        )
  1636	                    else:
  1637	                        seen_ids[event_id] = lineno
  1638	
  1639	    return violations, warnings
  1640	
