  4613	def test_round15_bare_collision_has_own_judge(vault):
  4614	    """账本侧「裸形态相同的两个 id」必须有**自己的判据**，不依附于别的逻辑。
  4615	
  4616	    ⛔ 这个性质原本是由「裸候选也参与反查」**顺带**实现的；round-14 排除带标记的
  4617	    裸候选后它只剩间接路径，round-15 改反查规则时彻底断掉 —— 两道门同时变红。
  4618	    **顺带实现的性质迟早会断；要守的性质就该有自己的代码。**
  4619	    """
  4620	    src = SKILL.read_text(encoding="utf-8")
  4621	    assert "_bare_of = lambda x:" in src, "裸形态碰撞必须有独立判据"
  4622	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4623	    (vault / "learning_events.jsonl").unlink(missing_ok=True)
  4624	    # ⚠️ 直接构造两行再一次写入 —— 原写法在循环里引用上一轮的 `_prev`，
  4625	    # 运行时因迭代顺序恰好不触发（89 道门全绿），但 ruff 的 F821 抓住了它：
  4626	    # 换个循环顺序或加一句 early-continue 就会炸。**测试跑不出来的脆弱写法，
  4627	    # lint 门更早更准。**
  4628	    rows = []
  4629	    for eid, ts, n in (("quiz:K", TS1, 1), ("K", "2026-08-01T10:00:01Z", 2)):
  4630	        row = _review_row(event_id=eid, **{"payload.review_time": ts, "payload.attempt_count": n})
  4631	        row["effective_at"] = ts
  4632	        rows.append(row)
  4633	    _write_ledger(vault, *rows)
  4634	    r = _run_writer_settled(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  4635	    assert r.returncode != 0, "裸形态相同的两个 event_id 并存时必须 fail-closed"
