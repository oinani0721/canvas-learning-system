   172	#: A7 review 域上界 (schema v1 §6.2): review_time 与 W 同域同界且均须严格小于。
   173	#: 调度会在其上叠加 interval, A3 还要 +1s —— 逼近上界时新事件不可写, fail-closed。
   174	_REVIEW_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   175	
   176	
   177	def review(fields: dict, grade_norm: float, abandoned: bool, ts: str, rating: int | None = None) -> dict:
   178	    """一次评分 → 新 fsrs_* 字段 (需要 fsrs 可导入)。
   179	
   180	    G3-2 时刻语义 (schema v1 §6.2 A3/A5/A6):
   181	      - ts 归一 UTC 整秒后作为本次 review 时刻 (写出的 fsrs_last_review 与
   182	        返回的 review_time 逐字相同);
   183	      - 若当前 frontmatter 有 W (fsrs_last_review) 且本次时刻 ≤ W, 推进到
   184	        W+1s 再写 (A3 等时唯一口径: 推进不拒绝);
   185	      - rating 可显式指定 (A2 pending 重放按事件已断言的 rating 复算),
   186	        缺省按 grade_norm+abandoned 推导; abandoned 恒为 1 (弃答一票否决);
   187	        显式值必须与 rating_from_grade(grade_norm, abandoned) **相等** —— 不
   188	        自洽的 pending 行在 apply 前拒绝, 不靠事后 validator 兜 (R5)。
   189	    """
   190	    from fsrs import Card, Rating, Scheduler, State
   191	
   192	    now = _whole_second(_aware(ts))
   193	    if now >= _REVIEW_MAX:
   194	        raise ValueError(f"review 时刻 {ts!r} 越出 A7 review 域上界 (须严格小于 {_iso(_REVIEW_MAX)})")
   195	    if rating is not None:
   196	        # 严格 int (Codex round-1 MEDIUM): int(1.5)==1 会把非法 pending 行
   197	        # 静默应用; §6.1 冻结 rating 为真 int 1-4, bool 伪装同样拒绝。
   198	        if isinstance(rating, bool) or not isinstance(rating, int) or rating not in (1, 2, 3, 4):
   199	            raise ValueError(f"显式 rating 必须为 int 1-4, 实为 {rating!r}")
   200	        # 评分事实自洽 (Codex round-3 HIGH R5; 含 round-2 HIGH 的 abandoned 分项):
   201	        # 类型/范围合法 ≠ 与本行的评分事实自洽。`answer_scored + grade_norm=0.75
   202	        # + rating=4` 三项单看都合法, 但 [Decision-FSRS-1] 下 0.75 的契约值是 3
   203	        # —— 旧实现照单全收并推进 FSRS, 事后才由 validator 判 FAIL (损坏基线上
   204	        # 已叠加一次调度)。rating 是 grade_norm/abandoned 的**纯函数**, 故在
   205	        # apply 前机械复算并要求相等; abandoned=true 由 rating_from_grade 一票
   206	        # 否决为 1, 弃答给非 1 的 rating 同样落在本门内。
   207	        _expect = rating_from_grade(grade_norm, abandoned)
   208	        if rating != _expect:
   209	            raise ValueError(
   210	                f"显式 rating {rating} 与评分事实不自洽 "
   211	                f"(grade_norm={grade_norm!r}, abandoned={abandoned!r} ⇒ 契约值 {_expect})"
   212	            )
   213	    if abandoned:
   214	        used_rating = 1
   215	    elif rating is not None:
   216	        used_rating = rating
   217	    else:
   218	        used_rating = rating_from_grade(grade_norm, abandoned)
   219	
   220	    sched = Scheduler(enable_fuzzing=False)
   221	    if fields.get("fsrs_due"):
   222	        step = fields.get("fsrs_step")
   223	        stability = fields.get("fsrs_stability")
   224	        difficulty = fields.get("fsrs_difficulty")
   225	        raw_state = int(fields.get("fsrs_state", 1))
   226	        if raw_state == 0:
   227	            # legacy New 形状字段级迁移 (CARD-C3, roundtrip 显式例外):
   228	            # state 0→Learning(1) — py-fsrs 4+ 无 New 态, State(0) 抛
   229	            # ValueError; 伴生哨兵 0/0.0/null → None (0.0 会进 v6 稳定度
   230	            # 幂运算抛 ZeroDivisionError); step 兜底 0 (Learning 首步)。
   231	            raw_state = 1
   232	            stability = _legacy_param(stability)
   233	            difficulty = _legacy_param(difficulty)
   234	            step = _legacy_param(step) or 0
   235	        card = Card(
   236	            state=State(raw_state),
   237	            step=int(step) if step not in (None, "") else None,
   238	            stability=float(stability) if stability else None,
   239	            difficulty=float(difficulty) if difficulty else None,
   240	            due=_aware(fields["fsrs_due"]),
   241	            last_review=_aware(fields["fsrs_last_review"]) if fields.get("fsrs_last_review") else None,
   242	        )
   243	        # A3 等时消解: 时刻 ≤ W → 推进 W+1s (写侧唯一口径, 禁止拒绝丢评分)。
   244	        # W 与 review_time 同域同界, W+1s 越出 A7 上界 ⇒ 后继不可写, fail-closed。
   245	        if fields.get("fsrs_last_review"):
   246	            w = _whole_second(_aware(fields["fsrs_last_review"]))
   247	            if now <= w:
   248	                bumped = w + timedelta(seconds=1)
   249	                if bumped >= _REVIEW_MAX:
   250	                    raise ValueError(f"A3 推进 W+1s 越出 A7 上界 (W={_iso(w)}) — 后继事件不可写")
