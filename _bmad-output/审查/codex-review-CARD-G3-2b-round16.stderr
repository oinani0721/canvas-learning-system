   591	def _canon_fact(v):
   592	    """事实的 canonical 形式：**类型敏感**的 JSON 文本。
   593	
   594	    ⛔ 直接用 `==` 会让 `1 == True`、`0 == False` 成立, 于是两次事实不同的评分
   595	    被判成同一次(round-14 BLOCKER③ 实测)。不可 JSON 化的值退回带类型名的表示,
   596	    仍然类型敏感。
   597	    """
   598	    # ⛔ 数值按**数值语义**比, 不按 JSON 书写比 (round-15 自查发现的交界洞):
   599	    # `1` 与 `1.0` 是同一个数值的两种合法 JSON 书写(外部写入方可能用 int,
   600	    # validator rc=0), 而写侧 `round(float(x),2)` 恒产出 float ⇒ 用户以 1.0 重跑
   601	    # 被 envelope 冲突误拒。实测可达。
   602	    # ⚠️ 但 `True/False` **必须**与 1/0 区分 —— 那是不同类型的语义(布尔 vs 数值),
   603	    # 正是 round-14 BLOCKER③ 要拦的。所以 bool 先于数值判, 走 canonical 那支。
   604	    # ⛔ 这个洞落在两条修复的**交界处**: B③ 要类型敏感(顺带把 1/1.0 判不等),
   605	    # H② 的版本化身份规则只在 `_dgn != GN2` 时生效(而 1 == 1.0 在 Python 里成立,
   606	    # 条件不触发)。两条各自正确, 交界处出洞 —— 单条审查意见指不出这类洞。
   607	    v = _num_norm(v)
   608	    if isinstance(v, decimal.Decimal):
   609	        return f"n:{v}"                       # 数值语义: 1 == 1.0 == 1.00
   610	    # ⛔ **容器里的**数值同样归一成 Decimal, `json.dumps` 不认识它 —— 只在顶层判
   611	    # Decimal 是「修一半」: `[1, 2.0]` 与 `[1.0, 2]` 会走到 except 分支比 repr 而判不等。
   612	    # 实测由「嵌套数值」那条反例当场抓出（只测顶层标量会漏）。
   613	    try:
   614	        return "j:" + json.dumps(v, sort_keys=True, ensure_ascii=False,
   615	                                 separators=(",", ":"), allow_nan=False,
   616	                                 default=lambda o: f"§dec:{o}" if isinstance(o, decimal.Decimal) else _raise_te(o))
   617	    except (TypeError, ValueError):
   618	        return f"r:{type(v).__name__}:{v!r}"
