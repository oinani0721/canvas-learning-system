   107	
   108	
   109	def write_rows(vault: Path, *recs, trailing_lf=True):
   110	    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs)
   111	    (vault / "learning_events.jsonl").write_text(text if trailing_lf else text[:-1], encoding="utf-8")
   112	
   113	
   114	def sha(p: Path) -> str:
   115	    return hashlib.sha256(p.read_bytes()).hexdigest()
   116	
   117	
   118	def fsrs_fields(vault: Path) -> dict:
   119	    fm = (vault / NODE_REL).read_text(encoding="utf-8").split("---\n")[1]
   120	    out = {}
   121	    for k in ("fsrs_due", "fsrs_state", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   122	        m = re.search(rf'^{k}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   123	        if m:
   124	            out[k] = m.group(1)
   125	    return out
   126	
   127	
   128	def last_line(text: str) -> str:
   129	    lines = text.strip().splitlines()
   130	    return lines[-1][:110] if lines else ""
