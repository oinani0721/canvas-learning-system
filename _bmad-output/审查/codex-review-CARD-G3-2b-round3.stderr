   656	    _out, _err = _bridge(fm, float(_pl.get("grade_norm", 0.0)),
   657	                         _o.get("event_type") == "answer_abandoned",
   658	                         _pl["review_time"], rating=_pl.get("rating"))
   659	    if _out is None:
   660	        # Codex round-1 BLOCKER: 存在 pending 且重放失败 → 一律 fail-closed
   661	        # 零写 (既不 degraded 落账、也不发布), A2 "追加前重放至空" 无例外;
   662	        # 待 fsrs 恢复后重跑即可恢复。
   663	        raise SystemExit(f"[quiz-answer] A2 pending 重放失败 (fsrs 不可用且存在未恢复事件), fail-closed 零写 — 待恢复后重跑: 账本第 {_ln} 行({_o.get('event_id')}): {_err}")
   664	    fm = _apply_fsrs_block(fm, "\n" + _out["fm_block"])
   665	    # attempt_count 同步 (内部对抗审查 BLOCKER): 旧实现的 A2 重放**只补 FSRS**,
   666	    # 于是「每条适用行对应 frontmatter attempt 一次 +1」这个不变量被写点自己
   667	    # 破坏 —— E1 崩溃后先答 E2, 重放 E1 不推进 attempt, E2 便以同一个基数写出
   668	    # attempt=1, durable 变成 [1,1]; 此后原样重跑 E1, ordinal 回推算出 0 而
   669	    # durable 是 1 ⇒ 合法历史重放被误报 envelope 冲突 (实测复现)。
   670	    # ⚠️ attempt_count 与 mastery 不同: 它**有事件载荷**(在 durable payload 里),
   671	    # 所以能复放。权威值恒取 durable 行, 不再 +1 —— 「恢复」的定义就是复现
   672	    # 首次成功时写下的那个值。顺带修好一个用户可见的错: 崩溃恢复后「已考 N 次」
   673	    # 旧实现会少算一次。
   674	    _n_ = _pl.get("attempt_count")
   675	    if isinstance(_n_, int) and not isinstance(_n_, bool) and _n_ >= 0:
   676	        if re.search(r'^attempt_count:', fm, re.M):
   677	            fm = re.sub(r'^attempt_count:.*$', f"attempt_count: {_n_}", fm, count=1, flags=re.M)
   678	        else:
   679	            fm = re.sub(r'^(type:.*)$', lambda x: x.group(1) + f"\nattempt_count: {_n_}", fm, count=1, flags=re.M)
   680	    print(f"[quiz-answer] A2 重放已应用: {_o.get('event_id')} @ {_pl['review_time']}")
   681	
   682	# ── G3-2 恢复路径 / 正常路径分叉 (A2 重放已完成: dup 与全部 pending 的 FSRS
   683	# 都已按序应用到内存 fm, 重放失败已在上方 fail-closed 退出)。
   684	if dup is not None:
   685	    # ── 恢复路径。review_time 采纳 durable 行 (业务事实时刻), 全部副作用
   686	    # (mastery/calibration/last_examined) 以它为基准 — 保证恢复产物与直接
   687	    # 应用逐字节对齐 (卡文门②; round-2 HIGH)。
   688	    review_time = _dpl["review_time"]
   689	    fsrs_ok = True
   690	    if not re.search(r'^type:', fm, re.M):
   691	        fm = "type: concept\n" + fm.lstrip("\n")
   692	    if p.get("source_board") and not re.search(r'^source_board:', fm, re.M):
   693	        fm = fm.rstrip() + '\nsource_board: ' + json.dumps(p["source_board"], ensure_ascii=False)
   694	    if f1:
   695	        # degraded 遗留 (f1=T): mastery/calibration 已应用 — 只补 FSRS。
   696	        # 再算一次 EMA 会双吃成绩 (round-2 场景②: 首评 degraded 后重试)。
   697	        print(f"[quiz-answer] A2 恢复(degraded 遗留): 仅补 FSRS @ {review_time}, EMA/校准不重复应用")
   698	    else:
   699	        # 崩溃窗口① (f1=F): 评分链其余副作用全部未应用 → 全套补齐
   700	        old, A, B, new = _apply_mastery(fm, review_time)
   701	        # attempt 权威值取 durable 行本身 (dup 自己刚被 A2 重放写进 fm, 再 +1
   702	        # 会双加)。恢复 = 复现首次成功时写下的那个值, 不是「再记一次」。
   703	        _dup_att = _dpl.get("attempt_count")
   704	        if isinstance(_dup_att, int) and not isinstance(_dup_att, bool) and _dup_att >= 0:
   705	            n_att = _dup_att
   706	        else:
   707	            mo_att = re.search(r'^attempt_count:\s*"?(\d+)"?\s*$', fm, re.M)
   708	            n_att = (int(mo_att.group(1)) if mo_att else 0) + 1
   709	        fm = re.sub(r'^(mastery_score|mastery|mastery_level|mastery_a|mastery_b|attempt_count|last_examined):.*\r?\n?', '', fm, flags=re.M)
   710	        fm = re.sub(r'^(type:.*)$', lambda x: x.group(1) + f"\nmastery_score: {new}\nmastery_a: {round(A, 4)}\nmastery_b: {round(B, 4)}\nattempt_count: {n_att}\nlast_examined: " + json.dumps(review_time, ensure_ascii=False), fm, count=1, flags=re.M)

