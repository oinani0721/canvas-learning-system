   388	def _apply_mastery(fm_text, biz_ts):
   389	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   390	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   391	    old = None
