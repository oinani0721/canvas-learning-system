  1538	    )
  1539	    assert _run_validator(vault).returncode == 0, (
  1540	        "如实锁定：校验器当前不强制迟到事件标 out_of_order —— 本断言若某天变红，"
  1541	        "说明校验器收紧了该面，届时应同步更新本注释与移交台账，而不是简单改断言"
  1542	    )
  1543	
  1544	    # ③ 分层成立（非缺陷，锁住）：rating 自洽门不会误拒任何**旧版合法写入**的行。
  1545	    # grade_norm 落盘的是 round(GN,2)，分档边界要 gn = 1/6、1/2、5/6，只有 1/2 是精确
  1546	    # 两位小数，而 1.0+3.0*0.5 == 2.5 走 `g < 2.5` 为 False ⇒ 稳定落在 3。
  1547	    sys.path.insert(0, str(VAULT_SCRIPTS))
  1548	    try:
  1549	        import fsrs_bridge as fb
  1550	
  1551	        for cents in range(0, 101):
  1552	            gn = cents / 100.0
  1553	            direct = fb.rating_from_grade(gn, False)
  1554	            roundtrip = fb.rating_from_grade(float(json.loads(json.dumps(gn))), False)
  1555	            assert direct == roundtrip, f"grade_norm {gn} 经 JSON 往返后分档改变 {direct}->{roundtrip}"
  1556	        assert fb.rating_from_grade(0.5, False) == 3, "边界 gn=0.5 必须稳定落 3"
  1557	    finally:
  1558	        sys.path.remove(str(VAULT_SCRIPTS))
  1559	        sys.modules.pop("fsrs_bridge", None)
  1560	
  1561	    # ④ 分层成立（非缺陷，锁住）：fixture 脚本的写入面守卫不被 symlink 劫持。
  1562	    guard_src = (WT / "backend" / "scripts" / "g32b_build_fixture.py").read_text(encoding="utf-8")
  1563	    assert "resolve()" in guard_src and "MARKER" in guard_src, "守卫必须同时有 resolve 比对与 marker 检查"
  1564	    probe = Path("/private/tmp/g32b-gate-toctou-probe")
  1565	    victim = Path("/private/tmp/g32b-gate-toctou-victim")
  1566	    for p in (probe, victim):
  1567	        if p.is_symlink():
  1568	            p.unlink()
  1569	        elif p.exists():
  1570	            subprocess.run(["rm", "-rf", str(p)], check=True)
  1625	    )
  1626	    assert re.search(r'^attempt_count:\s*"?(\d+)"?\s*$', _fm(vault), re.M).group(1) == "2"
  1627	
  1628	    # ③ BLOCKER：账本按**字节**切行再逐行 decode。
  1629	    # BOM 首行（别的编辑器存过）整文件 decode 时会让一条**完整合法**的事件行解析
  1630	    # 失败、被当截断跳过、那次评分静默丢失；而腰斩一个多字节字符恰恰是最典型的
  1631	    # 崩溃产物——整文件 decode 一失败就全盘拒，自愈路径反而对它不可达。
  1632	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1633	    row = _review_row(event_id="quiz:板A#q1")
  1634	    RJ = json.dumps(row, ensure_ascii=False).encode("utf-8")
  1635	    good = _review_row(event_id="quiz:旧板", **{"payload.review_time": "2026-07-01T10:00:00Z"})
  1636	    good["effective_at"] = "2026-07-01T10:00:00Z"
  1637	    good["node_id"] = "别的节点"
  1638	    G = json.dumps(good, ensure_ascii=False).encode("utf-8") + b"\n"
  1639	    half_cjk = '{"event_id": "quiz:损'.encode("utf-8")[:-1]  # 腰斩「损」字
  1640	    for content, expect, desc in (
  1641	        (b"\xef\xbb\xbf" + RJ, "replay", "BOM + 完整合法行（无 LF）"),
  1642	        (b"\xef\xbb\xbf" + RJ + b"\n", "replay", "BOM + 完整合法行（带 LF）"),
  1643	        (G + half_cjk, "tolerate", "腰斩 CJK 的末行（无 LF）= 真截断"),
  1644	        (G + half_cjk + b"\n", "reject", "腰斩 CJK 的末行（带 LF）= 完整损坏"),
  1645	        (b"\xff\xfe bad\n" + RJ, "reject", "首行非 UTF-8 且不是末行"),
  1646	    ):
  1647	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1648	        (vault / "learning_events.jsonl").write_bytes(content)
  1649	        r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
