221:+    )
222:+    assert rec["payload"]["review_time"] != TS1, "fixture 前提: review_time 必须 != payload ts"
223:+    # 崩溃窗口①: 回滚 frontmatter 到评分前 (账本保留该事件) → 恢复路径
