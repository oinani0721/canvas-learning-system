   649	# 重放只复算 FSRS (mastery/callout 无事件载荷可复放, 见验收单「未证明什么」)。
   650	# pending = 适用集里尚未被 W 吸收的行 (_applicable 已按 (时刻, 行序) 升序且
   651	# 已逐行强制 UTC 整秒 — 与 envelope 门的 ordinal 复算同源同集合)。
   652	pending = [t for t in _applicable if W_inst is None or t[0] > W_inst]
   653	replay_failed = None
