254:+# ── 门㉛ R7 (MEDIUM): 带终止 LF 的坏末行 = 完整损坏, 不是截断 ──
257:+def test_r7_corrupt_tail_line_with_lf_is_not_truncation(vault):
258:+    """旧实现只看「最后一行解析失败」, 于是**带终止 LF** 的损坏末行也被当
259:+    截断容忍 — 实测 writer 仍 rc=0、自称「截断尾行」、继续追加并推进节点。
260:+    EOF 的 LF 状态是区分「被腰斩的半行」与「完整写入后损坏」的唯一机械证据。"""
261:+    good = _review_row(event_id="quiz:旧板", **{"payload.review_time": "2026-07-01T10:00:00Z"})
262:+    good["effective_at"] = "2026-07-01T10:00:00Z"
263:+    good["node_id"] = "别的节点"  # 不进本节点适用集, 隔离本门的判定面
264:+    bad = '{"event_id": "quiz:损坏行", "event_version": 1, "event_type": "answer_sc'
265:+    ledger = vault / "learning_events.jsonl"
266:+    # ①带终止 LF 的坏末行 → fail-closed 零写
267:+    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad + "\n", encoding="utf-8")
268:+    sha = _sha(vault / NODE_REL)
269:+    r = _run_writer(vault, _payload())
270:+    assert r.returncode != 0, "带终止 LF 的坏末行必须 fail-closed (旧实现 rc=0 当截断容忍)"
271:+    assert "完整写入的损坏行" in r.stderr, r.stderr
272:+    assert _sha(vault / NODE_REL) == sha, "零写节点"
273:+    assert len(ledger.read_text(encoding="utf-8").splitlines()) == 2, "零写账本"
274:+    # ②同一坏行去掉终止 LF → 仍按截断自愈容忍 (对照, 防本门变成「坏行恒拒」)
275:+    ledger.write_text(json.dumps(good, ensure_ascii=False) + "\n" + bad, encoding="utf-8")
276:+    r2 = _run_writer(vault, _payload())
277:+    assert r2.returncode == 0, "无 LF 的坏末行仍应按截断隔离: " + r2.stdout + r2.stderr
278:+    assert "截断尾行" in r2.stdout
279:+    lines = [ln for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
280:+    assert len(lines) == 3 and json.loads(lines[2])["event_id"] == "quiz:" + EID
283:+# ── 门㉜ R6 (MEDIUM): 身份键归属与 candidate 构造裁决必须回写冻结 schema ──
286:+def test_r6_schema_declares_identity_key_integrity_owner():
287:+    """round-3 MEDIUM: 门㉕锁定的「两个身份键排除出 envelope 等价面」此前只
288:+    活在实现与测试里, 契约 §6.2 原文仍只排除 recorded_at — 实现与契约两个
289:+    口径。本门锁定回写: 归属方 (validator golden manifest 绑定门) 与 candidate
290:+    独立构造的禁令都必须在冻结契约里可查。"""
291:+    doc = (WT / "docs" / "learning-events-schema-v1.md").read_text(encoding="utf-8")
292:+    seg = doc[doc.index("duplicate 命中后的状态推进门") : doc.index("**A5 整秒精度")]
293:+    for needle in (
294:+        "fsrs_library_version",
295:+        "fsrs_params_hash",
296:+        "排除出 envelope 等价面",
297:+        "golden manifest 绑定门",
298:+        "candidate 必须独立字面构造",
299:+        "多一键、少一键或值不同",
300:+    ):
301:+        assert needle in seg, f"§6.2 duplicate 门段落缺「{needle}」— 契约未同步实现裁决"
302:+    # A5 段必须写明 A2 消费侧的机械强制 (R2 的契约面)
303:+    a5 = doc[doc.index("**A5 整秒精度") : doc.index("**三态语义")]
304:+    assert "A2 消费侧同样机械强制" in a5 and "禁止消费时顺手归一化" in a5, a5[:400]
305:+    # A4.5 短写段必须写明「截断 vs 完整损坏」的 LF 判据 (R7 的契约面)
306:+    assert "可容忍的截断 vs 完整损坏" in doc and "不以 LF 结尾" in doc
307:+    # 三态语义段必须写明 out_of_order 的**写点侧** fail-closed 口径 (N1 的契约面)
308:+    # —— proof 侧是「报违规仍计入」, 在线写路径不能照搬, 两个口径必须分开写清楚。
309:+    oo = doc[doc.index("**`out_of_order` 字段冻结") : doc.index("**迟到事件的入账通道**")]
310:+    for needle in ("写点（在线 A2）侧同款语义门", "fail-closed", "被伪装成乱序的真实后继", "唯一合法值布尔 `true`"):
311:+        assert needle in oo, f"§6.2 三态语义段缺「{needle}」— 写点侧口径未回写契约"
314:+# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
315:+# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
316:+# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
317:+# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
318:+# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
321:+def _strip_calibration(vault: Path) -> None:
322:+    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
323:+    text = (vault / NODE_REL).read_text(encoding="utf-8")
324:+    head, fm, body = text.split("---\n", 2)
325:+    lines, out, skipping = fm.split("\n"), [], False
326:+    for ln in lines:
327:+        if ln.startswith("calibration_log:"):
328:+            skipping = True
329:+            continue
330:+        if skipping and (ln.startswith("  ") or ln == ""):
331:+            continue
332:+        skipping = False
333:+        out.append(ln)
334:+    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
335:+    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
336:+    new_fm = "\n".join(out).rstrip("\n") + "\n"
337:+    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
340:+def test_six_cell_state_machine_closed(vault):
341:+    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
342:+    foreign = _review_row(event_id="quiz:板A#q1")
343:+    _write_ledger(vault, foreign)
344:+    r1 = _run_writer(vault, _payload(ts="2026-08-02T10:00:00Z"))
345:+    assert r1.returncode == 0, r1.stdout + r1.stderr
346:+    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
347:+    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
349:+    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
350:+    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
351:+    sha_before = _sha(vault / NODE_REL)
352:+    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
353:+    assert r2.returncode == 0, r2.stdout + r2.stderr
354:+    assert "旧写序" in r2.stdout and "不补录" in r2.stdout, r2.stdout
355:+    assert _sha(vault / NODE_REL) == sha_before and len(_ledger_lines(vault)) == 1, "格2: 必须零改动"
357:+    # ── 格3 dup=有, f1=T, applied=T: 完整成功后重放 → envelope 通过 + no-op
358:+    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
359:+    (vault / "learning_events.jsonl").unlink()
360:+    assert _run_writer(vault, _payload()).returncode == 0
361:+    sha_full = _sha(vault / NODE_REL)
362:+    r3 = _run_writer(vault, _payload(ts="2026-09-01T08:30:00Z"))
363:+    assert r3.returncode == 0 and "幂等跳过" in r3.stdout, r3.stdout + r3.stderr
364:+    assert _sha(vault / NODE_REL) == sha_full and len(_ledger_lines(vault)) == 1
366:+    # ── 格4 dup=有, f1=F, applied=T: FSRS 已被吸收但校准缺失 → 停下人工裁定
367:+    _strip_calibration(vault)
368:+    sha_stripped = _sha(vault / NODE_REL)
369:+    r4 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
370:+    assert r4.returncode != 0, "格4: 顺序错乱无机械判据, 必须 fail-closed"
371:+    assert "缺校准记录" in r4.stderr and "人工核对" in r4.stderr, r4.stderr
372:+    assert _sha(vault / NODE_REL) == sha_stripped and len(_ledger_lines(vault)) == 1, "格4: 零写"
374:+    # ── 格5 dup=有, f1=T, applied=F: degraded 遗留 → 只补 FSRS, 不再吃 EMA
375:+    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
376:+    (vault / "learning_events.jsonl").unlink()
377:+    assert _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"}).returncode == 0
378:+    assert not _fm_fields(vault), "格5 前置: degraded 后 W 未推进"

