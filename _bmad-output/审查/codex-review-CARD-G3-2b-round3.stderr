82:+# ── 门㉖ R1 (BLOCKER): durable payload 的未知额外键必须冲突, 不得被自抄放行 ──
85:+def test_r1_unknown_durable_payload_key_conflicts(vault):
86:+    """旧实现的 candidate 以 durable payload 为底 spread (`{**_dpl, ...}`),
87:+    未知额外键被原样抄进 candidate ⇒ 比较退化成「自己比自己」。
88:+    实测穿透链: 给崩溃窗口①的 durable 行加 payload.out_of_order=true →
89:+    envelope 放行, 而 A2 适用集按定义排除该行 ⇒ FSRS 永不应用, writer 仍
90:+    rc=0 写下 calibration/mastery, 节点 fsrs_* 全空、账本仍一行。
91:+    正确行为: 键集本身是等价面的一部分 — 多一键/少一键一律冲突。"""
92:+    r = _run_writer(vault, _payload())
93:+    assert r.returncode == 0, r.stdout + r.stderr
94:+    base = _ledger_lines(vault)[0]
95:+    # ⚠️ round-1 后续: `out_of_order` 现被更早的语义门接管 (见门㉞ N1) —— 只有
96:+    # **合法乱序形态**(review_time ≤ W) 的该键才会走到 envelope 门。这里保 W
97:+    # 不回滚地测它, 保证 R1 的原始穿透链仍被本门覆盖: 本次评分事实里没有这个
98:+    # 键, 键集不等即冲突。
99:+    base_oo = json.loads(json.dumps(base))
100:+    base_oo["payload"]["out_of_order"] = True  # review_time == W ⇒ 合法乱序
101:+    _write_ledger(vault, base_oo)
102:+    r_oo = _run_writer(vault, _payload(ts="2026-09-01T07:00:00Z"))
103:+    assert r_oo.returncode != 0, "合法乱序形态的 out_of_order 键仍须 envelope 冲突"
104:+    assert "envelope 冲突" in r_oo.stderr, r_oo.stderr
105:+    assert len(_ledger_lines(vault)) == 1
106:+    for tweak, desc in (
107:+        ({"note": "外部工具注入的备注"}, "任意未知额外键"),
108:+        ({"vault_id": "canvas_vault_测试", "extra_nested": {"a": 1}}, "未知嵌套键"),
109:+    ):
110:+        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 回到崩溃窗口①前置态
111:+        tampered = json.loads(json.dumps(base))
112:+        tampered["payload"].update(tweak)
113:+        _write_ledger(vault, tampered)
114:+        rt = _run_writer(vault, _payload())
115:+        assert rt.returncode != 0, f"{desc}: 必须 envelope 冲突 (旧实现 rc=0 且 fsrs_* 全空)"
116:+        assert "envelope 冲突" in rt.stderr, rt.stderr
117:+        assert not _fm_fields(vault), f"{desc}: 冲突拒绝不得推进 frontmatter"
118:+        assert len(_ledger_lines(vault)) == 1, f"{desc}: 冲突拒绝不得追加"
119:+    # 反向: durable 行**缺**一个固定生产键 — 旧实现会被 candidate 的覆盖补回,
120:+    # 同样穿透。少键必须与多键同等冲突。
