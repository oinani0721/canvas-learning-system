  1414	    # ⑥ 整秒门放行的宽松字面量必须都归一到**同一个** UTC 整秒瞬间
  1415	    # （小写 t / 空格分隔 / -00:00 都是合法 ISO 写法，语义等价，放行无害）
  1416	    sys.path.insert(0, str(WT / "backend" / "scripts"))
  1417	    try:
  1418	        from validate_learning_events import _WHOLE_SECOND_RE
  1419	    finally:
  1420	        sys.path.remove(str(WT / "backend" / "scripts"))
  1421	    from datetime import datetime, timedelta, timezone
  1422	
  1423	    target = datetime(2026, 8, 1, 10, 0, 0, tzinfo=timezone.utc)
  1424	    for lit in (
  1425	        "2026-08-01T10:00:00Z",
  1426	        "2026-08-01T10:00:00+00:00",
  1427	        "2026-08-01T10:00:00-00:00",
  1428	        "2026-08-01t10:00:00Z",
  1429	        "2026-08-01 10:00:00Z",
  1430	    ):
  1431	        assert _WHOLE_SECOND_RE.match(lit.strip()), f"{lit!r} 应过字面门"
  1432	        d = datetime.fromisoformat(lit.strip().replace("Z", "+00:00"))
  1433	        assert d.utcoffset() == timedelta(0) and d.astimezone(timezone.utc) == target, (
  1434	            f"{lit!r} 被放行但不是目标瞬间 —— 宽松字面量必须语义等价才无害"
  1435	        )
  1440	# ── 门㊱ round-2 线索复核（Codex round-2 正文同样被内容过滤器拦，按 stderr 保留的
  1441	# 推理标题逐条实测）。1 条真缺陷（R7-blank）+ 3 条「分层成立」需锁住。
  1442	
  1443	
  1444	def test_round2_lead_followups(vault):
  1445	    import subprocess
  1446	
  1447	    # ① R7-blank（真缺陷，本卡修）：截断的判据是「**最后一个非空行**有没有终止 LF」，
  1448	    # 不是「文件末尾有没有 LF」。反例：`坏行\n   `（坏行后跟一个纯空白行、文件不以
  1449	    # LF 收尾）——旧判据看文件末尾说「无 LF ⇒ 截断」，可那个坏行后面明明还跟着东西。
  1450	    good = _review_row(event_id="quiz:旧板", **{"payload.review_time": "2026-07-01T10:00:00Z"})
  1451	    good["effective_at"] = "2026-07-01T10:00:00Z"
  1452	    good["node_id"] = "别的节点"
  1453	    G = (json.dumps(good, ensure_ascii=False) + "\n").encode("utf-8")
  1454	    BAD = b'{"event_id": "quiz:x", "event_ty'
  1455	    ledger = vault / "learning_events.jsonl"
  1456	    CASES = [
  1457	        (G + BAD, True, "坏行无 LF = 真截断"),
  1458	        (G + BAD + b"\n", False, "坏行带 LF = 完整损坏"),
  1459	        (G + BAD + b"\n   ", False, "坏行带 LF + 末尾空白行(无 LF) —— 旧判据在此失真"),
  1460	        (G + BAD + b"\n   \n", False, "坏行带 LF + 末尾空白行(带 LF)"),
  1461	        (G + BAD + b"\r\n", False, "坏行带 CRLF"),
  1462	        (G + BAD + b"   ", True, "坏行无 LF 但有尾随空格 = 仍是截断"),
  1463	        (BAD, True, "坏行是唯一行且无 LF"),
  1464	        (BAD + b"\n", False, "坏行是唯一行但带 LF"),
  1465	        (G + b"\n   \n" + BAD, True, "坏行无 LF，但它**前面**有空白行（不得误判）"),
  1466	    ]
  1467	    for i, (content, tolerate, desc) in enumerate(CASES):
  1468	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1469	        ledger.write_bytes(content)
  1470	        r = _run_writer(vault, _payload(event_id=f"blank{i}#q1", ts=f"2026-08-0{i + 1}T10:00:00Z"))
  1471	        if tolerate:
  1472	            assert r.returncode == 0, f"[{desc}] 应按截断隔离: {r.stdout}{r.stderr}"
  1473	            assert "截断尾行" in r.stdout, f"[{desc}] 应留痕: {r.stdout}"
  1474	        else:
  1475	            assert r.returncode != 0, f"[{desc}] 应 fail-closed（该行是完整落盘后损坏）"
  1476	            assert "完整写入的损坏行" in r.stderr, f"[{desc}] {r.stderr}"
  1477	
  1478	    # ② 分层成立（非缺陷，锁住）：写点只重放 node_id 匹配的行，故 node_id 缺失/拼错、
  1479	    # schema_ext 非法的 review 行**不会被任何节点重放**。写点放行它们是对的（不越权），
  1480	    # 但校验器必须全部拦下——否则这些行就成了无人认领的静默丢失面。
  1481	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1482	    ORPHANS = [
  1483	        (lambda r: r.pop("node_id"), "node_id 缺失"),
  1484	        (lambda r: r.__setitem__("node_id", None), "node_id 为 null"),
  1485	        (lambda r: r.__setitem__("node_id", "不存在的节点"), "node_id 拼错"),
  1486	        (lambda r: r["payload"].__setitem__("schema_ext", "review/2"), "schema_ext=review/2"),
  1487	        (lambda r: r["payload"].__setitem__("schema_ext", "reviews/1"), "schema_ext=reviews/1"),
  1488	    ]
  1489	    for mut, desc in ORPHANS:
  1490	        row = _review_row(event_id="quiz:孤儿", **{"payload.review_time": "2026-08-05T10:00:00Z"})
  1491	        row["effective_at"] = "2026-08-05T10:00:00Z"
  1492	        mut(row)
  1493	        _write_ledger(vault, row)
  1494	        rw = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  1495	        assert rw.returncode == 0, f"[{desc}] 写点不该越权拒别的节点的行: {rw.stderr}"
  1496	        v = _run_validator(vault)
  1497	        assert v.returncode != 0, f"[{desc}] 必须被校验器拦下 —— 否则是无人认领的静默丢失面"
  1498	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1499	
  1500	    # ②b 分层成立：envelope 只比 5 个顶层键，多出来的顶层键不进比较 —— 写点放行，
  1501	    # 校验器按「v1 冻结恰好 7 键」拦下。而 recorded_at 变化被 envelope **显式排除**
  1502	    # （重试时自然变化，§6.2:183），两侧都放行，那是设计不是漏网。
  1503	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1504	    (vault / "learning_events.jsonl").unlink()
  1505	    assert _run_writer(vault, _payload()).returncode == 0
  1506	    base_top = _ledger_lines(vault)[0]
  1507	    for key, value, validator_must_reject in (
  1508	        ("extra_top", "外部注入", True),
  1509	        ("recorded_at", "2099-01-01T00:00:00Z", False),
  1510	    ):
  1511	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1512	        row = json.loads(json.dumps(base_top))
  1513	        row[key] = value
  1514	        _write_ledger(vault, row)
  1515	        rw = _run_writer(vault, _payload())
  1516	        assert rw.returncode == 0, f"顶层 {key}: envelope 只比 5 键，写点应放行: {rw.stderr}"
  1517	        v = _run_validator(vault)
  1518	        if validator_must_reject:
  1519	            assert v.returncode != 0 and key in v.stdout, f"顶层 {key} 必须被校验器拦: {v.stdout[:200]}"
  1520	        else:
  1521	            assert v.returncode == 0, f"{key} 变化是设计内的（envelope 显式排除），不得误拦: {v.stdout[:200]}"
  1522	
  1523	    # ②c 契约行为（非缺陷）：未标 out_of_order 的「迟到」事件（review_time ≤ W）
  1524	    # 一律不推进 current state —— §6.2 三态语义明写「无论它是已应用还是迟到的乱序
  1525	    # 事件，对 current state 的动作完全相同」。
  1526	    # ⚠️ 同时如实锁住一个**校验器宽松面**：契约说迟到事件应走补录通道并标
  1527	    # out_of_order，但校验器当前**不强制**。validator 本卡禁改，登记为移交事项。
  1528	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1529	    (vault / "learning_events.jsonl").unlink()
  1530	    assert _run_writer(vault, _payload()).returncode == 0
  1531	    late = _review_row(event_id="quiz:迟到事件", **{"payload.review_time": "2026-07-01T10:00:00Z"})
  1532	    late["effective_at"] = "2026-07-01T10:00:00Z"
