   186	
   187	def _writer_code(vault: Path, payload: dict) -> str:
   188	    pfile = vault.parent / "payload.json"
   189	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   190	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   191	
   192	
   193	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   194	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   195	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   196	    return subprocess.run(
   197	        [sys.executable, "-c", _writer_code(vault, payload)],
   198	        capture_output=True,
   199	        text=True,
   200	        timeout=180,
   201	        cwd=str(vault),
   202	        env=env,
   203	    )
   204	
   205	
   206	def _ledger_lines(vault: Path) -> list[dict]:
   207	    ledger = vault / "learning_events.jsonl"
   208	    if not ledger.exists():
   209	        return []
   210	    return [json.loads(ln) for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   211	
   212	
   213	def _fm(vault: Path) -> str:
   214	    import yaml
   215	
   216	    text = (vault / NODE_REL).read_text(encoding="utf-8")
   217	    return text.split("---\n")[1]
   218	
   219	
   220	def _fm_fields(vault: Path) -> dict:
   221	    """按 bridge 同款正则抽 fsrs_* 行 (值+冒号后文本)。"""
   222	    fm = _fm(vault)
   223	    out = {}
   224	    for key in ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   225	        m = re.search(rf"^{key}:\s*\"?([^\"\n]+?)\"?\s*$", fm, re.M)
   226	        if m:
   227	            out[key] = m.group(1)
   228	    return out
   229	
   230	
   231	def _run_validator(vault: Path):
   232	    return subprocess.run(
   233	        [sys.executable, str(VALIDATOR), str(vault / "learning_events.jsonl")],
   234	        capture_output=True,
   235	        text=True,
   236	        timeout=60,
   237	    )
   238	
   239	
   240	def _sha(p: Path) -> str:
   241	    import hashlib
   242	
   243	    return hashlib.sha256(p.read_bytes()).hexdigest()
   244	
   245	
