196:+    assert r3.returncode == 0, "历史事件原样重跑必须 no-op, 不得报冲突: " + r3.stdout + r3.stderr
197:+    assert "幂等跳过" in r3.stdout, r3.stdout
198:+    assert _sha(vault / NODE_REL) == sha, "no-op 不得改动节点"
199:+    assert len(_ledger_lines(vault)) == 2, "no-op 不得追加"
200:+    # 验伪: 同一历史事件**换事实**重跑仍必须冲突 (本门不是「恒放行」的假门)
201:+    r4 = _run_writer(vault, _payload(ts="2026-09-01T12:00:00Z", abandoned=True))
202:+    assert r4.returncode != 0 and "envelope 冲突" in r4.stderr, r4.stderr
205:+# ── 门㉙ R4 (HIGH): 含 idle 状态且触发 A3 时, 正常与恢复产物逐字节相同 ──
208:+def test_r4_recovery_byte_identical_with_idle_and_a3_bump(vault):
209:+    """卡文 (d)。旧实现正常路径的 mastery 闲置折旧基准用 payload ts, 恢复路径
210:+    用 durable review_time — 门②的新卡无 last_examined, days_idle 恒 0, 测不
211:+    出差异。本门的节点 W=2026-12-01 远晚于评分时刻 2026-08-01 ⇒ A3 把
212:+    review_time 推到 W+1s, 两个基准相差约 4 个月, mastery_a/b 与整节点 SHA
213:+    必然分叉 (round-3 实测两次 SHA 不同)。"""
214:+    (vault / NODE_REL).write_text(NODE_IDLE_A3, encoding="utf-8")
215:+    r = _run_writer(vault, _payload())
216:+    assert r.returncode == 0, r.stdout + r.stderr
217:+    golden = (vault / NODE_REL).read_bytes()
218:+    rec = _ledger_lines(vault)[0]
219:+    assert rec["payload"]["review_time"] == "2026-12-01T10:00:01Z", (
