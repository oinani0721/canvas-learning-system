   393	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   394	        if mo:
   395	            old = float(mo.group(1)); break
   396	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   397	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   398	    if ma and mb:
   399	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   400	    elif old is not None:
   401	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   402	    else:
   403	        a_, b_ = PRIOR_A, PRIOR_B
   404	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
   405	    # 旧证据再吸收本次成绩 — 否则闲置期抬高的 σ 会被旧 n 一次评分瞬间抹平。
   406	    days_idle = 0.0
   407	    mle = re.search(r'^last_examined:\s*"?([^"\n]+)"?\s*$', fm_text, re.M)
   408	    if mle:
   409	        try:
