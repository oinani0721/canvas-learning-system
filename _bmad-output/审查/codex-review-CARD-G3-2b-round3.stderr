  1141	# ── 门㉝ write-ahead 六格状态机逐格闭合 (卡文标题判据) ──
  1142	# 分诊的自由度是 (dup 有无) × (f1) × (fsrs_applied); fsrs_applied 只在 dup=有
  1143	# 时有定义 ⇒ 2 + 4 = 6 格 (Codex round-3 §六格状态机)。round-3 判定 3 格 FAIL
  1144	# (历史 attempt 误拒 / 小数秒重复推进 / 额外键跳过 A2 且字节不等) + 1 格
  1145	# PARTIAL (foreign pending 输入门不完整)。本门逐格构造并断言终态。
  1146	
  1147	
  1148	def _strip_calibration(vault: Path) -> None:
  1149	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1150	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1151	    head, fm, body = text.split("---\n", 2)
  1152	    lines, out, skipping = fm.split("\n"), [], False
  1153	    for ln in lines:
  1154	        if ln.startswith("calibration_log:"):
  1155	            skipping = True
  1156	            continue
  1157	        if skipping and (ln.startswith("  ") or ln == ""):
  1158	            continue
  1159	        skipping = False
  1160	        out.append(ln)
  1161	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1162	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1163	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1164	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1165	
