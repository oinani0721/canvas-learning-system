   487	# ── G3-2 rating 同源: 显式算好传给 bridge (bridge 优先用显式 rating),
   488	# payload 存同一个值 — 事件内 rating/grade_norm 自洽是构造性保证。
   489	rating = rating_from_grade(GN2, bool(p.get("abandoned")))
   490	abandoned = bool(p.get("abandoned"))
   491	
   492	# ── G3-2 适用事件集 (本节点 / schema_ext=review/1 / 未标 out_of_order),
   493	# 按 (业务时刻, 行序) 升序。A2 的 pending 与 envelope 门的 attempt ordinal
   494	# 复算**共用同一集合** — 两处若各扫一遍, 「进 pending 的行」与「参与 ordinal
   495	# 计数的行」会分叉。R2 (round-3 BLOCKER): 该集合每一行都参与 W 比较,
   496	# 故逐行机械强制 UTC 整秒 (小数秒行会让同一事件反复判 pending 二次推进)。
   497	_applicable = []
   498	for _ln, _o in _rows:
   499	    _pl = _o.get("payload") if isinstance(_o, dict) else None
   500	    if not isinstance(_pl, dict) or _pl.get("schema_ext") != "review/1":
   501	        continue
   502	    if _o.get("node_id") != node_id:
   503	        continue
   504	    _ctx = f"账本第 {_ln} 行({_o.get('event_id')})"
   505	    if "out_of_order" in _pl:
   506	        # 形态门 (§6.2 三态语义 round-4 HIGH#3 冻结): 唯一合法值是布尔 true;
   507	        # 写 false/"true"/其它形态既非「已标」也非「未标」, 排除条件产生歧义。
   508	        if _pl["out_of_order"] is not True:
   509	            raise SystemExit(f"[quiz-answer] {_ctx} 的 payload.out_of_order 形态非法 ({_pl['out_of_order']!r}; §6.2 冻结唯一合法值为布尔 true, 未标则不写该键), fail-closed 拒写")
   510	        # 语义门 (§6.2 三态语义 round-17 冻结, 本卡补进写点侧): 标记本身是把
   511	        # 事件移出适用集的手段 —— 若某行标了该键、其 review_time 却**晚于**水位线
   512	        # W, 它就是**被伪装成乱序的真实后继**, 排除它 = 该事件的 FSRS 永久丢失
   513	        # 且 writer 照常 rc=0 (实测)。乱序的定义就是 review_time ≤ W。
   514	        _oo_inst = _durable_instant(_pl.get("review_time"), _ctx)
   515	        if W_inst is None or _oo_inst > W_inst:
   516	            raise SystemExit(f"[quiz-answer] {_ctx} 标了 out_of_order 但 review_time={_pl.get('review_time')!r} 晚于水位线 W={W or '(无, 新卡)'} — 乱序的定义是 review_time ≤ W, 该行是被伪装成乱序的真实后继, fail-closed 拒写")
   517	        continue
   518	    _applicable.append((_durable_instant(_pl.get("review_time"), _ctx), _ln, _o))
   519	_applicable.sort(key=lambda t: (t[0], t[1]))
   520	

