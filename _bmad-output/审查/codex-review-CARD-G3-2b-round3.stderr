129:+    _write_ledger(vault, base)
130:+    rok = _run_writer(vault, _payload())
131:+    assert rok.returncode == 0, rok.stdout + rok.stderr
132:+    assert _fm_fields(vault)["fsrs_last_review"] == TS1, "未被篡改的 durable 行必须正常恢复"
135:+# ── 门㉗ R2 (BLOCKER): 小数秒 / 非 UTC durable review_time 不得被消费 ──
138:+def test_r2_non_whole_second_durable_review_time_fail_closed(vault):
139:+    """bridge 入口 _whole_second 会把 10:00:00.500Z 截成 10:00:00Z 写进 W,
140:+    而账本那行仍是 .500Z ⇒ 「.500 > .000」恒真, 同一行**每次重跑都判 pending
141:+    并再推进一次 FSRS** (实测: 账本始终一行, W 逐次 +1s = §6.2 A5 禁止的二次
142:+    apply)。修复方向必须是 apply 前只验不改 — 消费时归一化会把损坏行洗成
143:+    合法行, 把缺陷从写入面挪进不可见面。"""
144:+    # 判据必须落在**字面**上, 不是解析后的值 (自查补): '.000000Z' 的
145:+    # microsecond 恰为 0, 只看值会放行它, 而校验器的 _WHOLE_SECOND_RE 按字面
146:+    # 判 FAIL ⇒ 写点放行、validator 拒, 实现与契约又成两个口径。
147:+    for rt_bad, why in (
148:+        ("2026-08-01T10:00:00.500Z", "小数秒"),
149:+        ("2026-08-01T10:00:00.000000Z", "小数秒"),  # 零值小数秒字面: 值合规、字面不合规
150:+        ("2026-08-01T10:00:00.0Z", "小数秒"),
151:+        ("2026-08-01T10:00:00+00:00:00", "小数秒"),  # 非 canonical 偏移字面
152:+        ("2026-08-01T10:00+00:00", "小数秒"),  # 省略秒段 (§6.2 round-4 HIGH#1)
153:+        ("2026-08-01T18:00:00+08:00", "非 UTC"),  # 字面合规但偏移非零
154:+    ):
155:+        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
156:+        _write_ledger(vault, _review_row(**{"payload.review_time": rt_bad, "effective_at": rt_bad}))
157:+        sha = _sha(vault / NODE_REL)
158:+        # ①该行即本次事件 (dup 路径)
159:+        r = _run_writer(vault, _payload(event_id="板A#q1"))
160:+        assert r.returncode != 0, f"{why} durable 行 (dup 路径) 必须 fail-closed"
161:+        assert why in r.stderr, r.stderr
162:+        assert _sha(vault / NODE_REL) == sha and len(_ledger_lines(vault)) == 1, "零写"
163:+        # ②该行是别的事件 (foreign pending 路径) — 同样在重放前拒
164:+        r2 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
165:+        assert r2.returncode != 0, f"{why} durable 行 (foreign pending 路径) 必须 fail-closed"
166:+        assert why in r2.stderr, r2.stderr
167:+        assert _sha(vault / NODE_REL) == sha and len(_ledger_lines(vault)) == 1, "零写"
168:+    # 对照 (验伪): 整秒 UTC 的两种 canonical 字面都必须照常重放 —— 本门不是
169:+    # 「凡带偏移就拒」的假门, Z 与 +00:00 是同一瞬间的两种合法写法。
170:+    for rt_ok in ("2026-08-01T10:00:00Z", "2026-08-01T10:00:00+00:00"):
171:+        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
172:+        _write_ledger(vault, _review_row(**{"payload.review_time": rt_ok, "effective_at": rt_ok}))
173:+        rok = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
174:+        assert rok.returncode == 0, f"{rt_ok} 必须照常重放: " + rok.stdout + rok.stderr
175:+        assert "A2 重放已应用" in rok.stdout
178:+# ── 门㉘ R3 (HIGH): 历史事件重跑 (E1→E2→重跑 E1) 必须 no-op, 不得误报冲突 ──
181:+def test_r3_historical_event_replay_is_noop_not_conflict(vault):
182:+    """§6.2:187 要求同 canonical envelope 必须 no-op。旧实现的 attempt 复算
183:+    在已应用态直接取 frontmatter 当前值 (tip), 于是重跑 E1 时把 E2 的计数当
184:+    成 E1 的 ⇒ 合法历史重放被误报 envelope 冲突 (用户翻旧检验白板重跑旧评分
185:+    即触发)。正确口径: 沿账本回推 ordinal。"""
186:+    r1 = _run_writer(vault, _payload())  # E1 @ 10:00
187:+    assert r1.returncode == 0, r1.stdout + r1.stderr
188:+    r2 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", exam_board="检验白板/板B.md"))
189:+    assert r2.returncode == 0, r2.stdout + r2.stderr
190:+    recs = _ledger_lines(vault)
