31:+def _review_row(**over):
32:+    """一条 canonical review/1 durable 行 (与生产写点键集逐字同形)。"""
33:+    row = {
34:+        "event_id": "quiz:板A#q1",
35:+        "event_version": 1,
36:+        "event_type": "answer_scored",
37:+        "node_id": "测试节点",
38:+        "recorded_at": TS1,
39:+        "effective_at": TS1,
40:+        "payload": {
41:+            "schema_ext": "review/1",
42:+            "vault_id": "canvas_vault_测试",
43:+            "concept_id": "测试节点",
44:+            "rating": 3,
45:+            "grade_norm": 0.75,
46:+            "review_time": TS1,
47:+            "fsrs_library_version": "degraded:historic-run",
48:+            "fsrs_params_hash": "degraded:historic-run",
49:+            "exam_board": "检验白板/板A.md",
50:+            "attempt_count": 1,
51:+        },
52:+    }
53:+    for k, v in over.items():
54:+        if k.startswith("payload."):
55:+            row["payload"][k.split(".", 1)[1]] = v
56:+        else:
57:+            row[k] = v
58:+    return row
61:+def _write_ledger(vault: Path, *rows, trailing_lf=True):
62:+    text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
63:+    if not trailing_lf and text.endswith("\n"):
64:+        text = text[:-1]
65:+    (vault / "learning_events.jsonl").write_text(text, encoding="utf-8")
71:@@ -840,3 +899,636 @@ def test_identity_tampering_caught_by_validator_not_envelope(vault):
77:+# ══ CARD-G3-2b: Codex round-3 残留 R1-R7 的生产入口反例门 (㉖-㉜) ══
78:+# 全部用**逐字提取的生产 PYEOF 块**驱动 (CODE), 反例态由账本/节点预置构造 —
