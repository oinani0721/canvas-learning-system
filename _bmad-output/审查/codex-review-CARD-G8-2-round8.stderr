    22	# MCP Protocol (Story 3.2: MCP Tool Exposure)
     1	# Canvas Learning System - FastAPI Backend
     2	# Story 1.1: Docker environment setup
     3	# Python 3.11-slim for minimal image size
     4	
     5	FROM python:3.11-slim
     6	
     7	WORKDIR /app
     8	
     9	# Install system dependencies (curl for healthcheck, build tools for some pip packages)
    10	RUN apt-get update && \
    11	    apt-get install -y --no-install-recommends curl build-essential zlib1g-dev && \
    12	    rm -rf /var/lib/apt/lists/*
    13	
    14	# Copy requirements first for Docker layer caching
    15	COPY requirements.txt .
    16	RUN pip install --no-cache-dir -r requirements.txt
    17	
    18	# Copy application code
    19	COPY . .
    20	
    21	# Add src/ to Python path for agentic_rag module
    22	ENV PYTHONPATH="/app:/app/src:${PYTHONPATH}"
    23	
    24	# Expose FastAPI port
    25	EXPOSE 8001
    26	
    27	# Start uvicorn
    28	CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
