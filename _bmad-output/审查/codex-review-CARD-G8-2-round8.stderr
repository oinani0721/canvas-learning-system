   769	    r = _run_cli(_clean_vault(tmp_path / "v"), "--only", "no_such_check")
   770	    assert r.returncode == 3, f"--only 非法值必须 rc=3, 实为 {r.returncode}"
   771	    assert "no_such_check" in r.stderr
