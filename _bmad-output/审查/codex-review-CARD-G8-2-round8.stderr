   163	#  拆单路测试仍绿 —— 结构冗余已消除, 本变异现对唯一路径承重)
   164	mutate_and_test "M18-枚举盲区丢弃" \
   165	  '        for rel, why in src_blind.items():\n            blind[f"{src_dir}/{rel}"] = why|||        pass  # MUTANT' \
   166	  "test_orphan_unreadable_subtree_is_blind"
   167	
   168	# ── round-4 整改新增的防线 ──
   169	# M19 raw_derived 状态判定去掉 G8/G10/G11 盲区 → 扫描面问题假绿 ok
   170	mutate_and_test "M19-盲区不计状态" \
   171	  '        status=WARN if (findings or recap_blind or blind) else OK,|||        status=WARN if (findings or recap_blind) else OK,  # MUTANT' \
   172	  "test_raw_derived_g8_blind_forces_warn"
   173	
   174	# M20 AUTO 段跳过拆除 → 陈旧自动成员块重新豁免孤儿 (round-1 live 复算回归)
   175	mutate_and_test "M20-AUTO段不跳过" \
   176	  '        if is_auto:\n            continue|||        if False:\n            continue' \
   177	  "test_orphan_ignores_nonsemantic_wikilinks"
   178	
   179	# (M16/M21/M22 已删除: round-7 token 流重构后, closer 等长 / 转义反引号 / 跨段落
