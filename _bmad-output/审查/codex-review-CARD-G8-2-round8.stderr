   759	def test_argparse_usage_errors_exit_3_not_2(tmp_path):
   760	    """Codex round-1 HIGH-6: argparse 默认 exit(2) 与「有 warn」的 2 撞码 ——
   761	    用法错误归 3 (配置/环境错误族 = lint 没跑成)。"""
