   340	def _auto_segments(body: str) -> list[tuple[str, bool]]:
   341	    """按 AUTO-GENERATED 哨兵段切分正文 → [(分段文本, 是否 AUTO 段)]。
   342	
   343	    AUTO 段是**项目自定义**结构 (sync_board_concepts.py 写入, BEGIN 行无 -->
   344	    / NOTE 行以 --> 结尾 / 成员行夹在中间 / END 行收口), CommonMark 解析器不认识
   345	    它的段级语义 —— 必须先于 Markdown 解析自行切分; AUTO 段整段盲 (Codex round-1
   346	    live 复算: 去掉 AUTO 后 3 个节点没有其他入链, 陈旧自动块绝不能豁免孤儿)。
   347	    """
   348	    segments: list[tuple[str, bool]] = []
   349	    buf: list[str] = []
   350	    in_auto = False
   351	    for line in body.splitlines(keepends=True):
   352	        stripped = line.strip()
   353	        if in_auto:
   354	            buf.append(line)
   355	            if _AUTO_END_RE.match(stripped):
   356	                segments.append(("".join(buf), True))
   357	                buf = []
   358	                in_auto = False
   359	            continue
   360	        if _AUTO_BEGIN_RE.match(stripped):
   361	            if buf:
   362	                segments.append(("".join(buf), False))
   363	                buf = []
   364	            in_auto = True
   365	            buf.append(line)
   366	            continue
   367	        buf.append(line)
   368	    if buf:
   369	        segments.append(("".join(buf), False))
   370	    return segments
   371	
   372	
   373	def _wikilink_targets(body: str) -> set[str]:
   374	    """正文里全部 wikilink 的 basename 集合 (已归一) —— **token 流法**。
   375	
   376	    ⛔ round-7 终局重构: rounds 2-7 手写的 Markdown 剥除/区间解析 (正则反向引用 →
   377	       maximal run 配对 → 字符偏移区间) 每轮修复都开新洞 (fence 容器嵌套 / 转义
   378	       run 粒度 / 跨区间源串扰 / AUTO-fence 互斥状态机), Codex round-7 一轮报出
   379	       5 个 HIGH。重演 G8-1 的核心教训「不重新实现解析」: Markdown 语义全部交给
   380	       **markdown-it-py** (venv 既有依赖 4.0.0, 也是各轮审查的对照裁判):
   381	       - block 级: fence / code_block / html_block 整块不扫 (含 blockquote/list
   382	         容器内的 —— mdit 递归解析, 本函数只看 token 序列不递归容器);
   383	       - inline 级: 只扫 `text` token; code_inline / html_inline 等一律不扫;
   384	       - 转义反引号 / maximal run / 跨段落: 库内正确处理, 本函数零自定义。
   385	       AUTO 段仍由 `_auto_segments` 自管 (项目自定义结构)。
   386	
   387	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   388	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   389	    (`resolve_node_id`) —— 三者本就同规则。
   390	
   391	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   392	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   393	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   394	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   395	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   396	
   397	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   398	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写)。**不**覆盖: AUTO 哨兵段、
   399	    fenced/indented code、行内 code、HTML 注释/块、blockquote/list 容器内的 code、
   400	    转义反引号旁的伪 run、跨行 `[[..]]`、空 `[[]]`。
   401	    """
   402	    out: set[str] = set()
   403	    for segment, is_auto in _auto_segments(body):
   404	        if is_auto:
   405	            continue  # AUTO 哨兵段整段盲 (含成员列表)
   406	        for token in _md_parser().parse(segment):
   407	            if token.type != "inline" or not token.children:
   408	                continue  # fence/code_block/html_block 等 block 级: 整块不扫
   409	            for child in token.children:
   410	                if child.type != "text":
   411	                    continue  # code_inline/html_inline/softbreak 等: 不扫
   412	                for m in _WIKILINK.finditer(child.content):
   413	                    inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   414	                    inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   415	                    if inner:
   416	                        out.add(_norm_key(inner))
   417	    return out
   418	
   419	
   420	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   421	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   422	
   423	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   424	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   425	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   426	    文件级检查), 再补两层本检查需要的:
   427	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   428	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   429	    """
   430	    if not root.is_dir():
   431	        return [], {}
   432	    blind: dict[str, str] = {}
   433	    dirs, files, cvr_blind = cvr._walk_vault(root)
   434	    for rel, why in cvr_blind:
   435	        blind[rel] = f"枚举盲区: {why}"
   436	    for d in dirs:
   437	        if d.is_symlink():
   438	            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
   439	    mds = sorted(f for f in files if f.suffix.lower() == ".md")
   440	    return mds, blind
   441	
   442	
   443	def _iter_md(root: Path) -> list[Path]:
   444	    """`_walk_md` 的只取文件面 (盲区面请用 `_walk_md`)。"""
   445	    return _walk_md(root)[0]
   446	
   447	
   448	# ---------------------------------------------------------------------------
   449	# 检查 1 — orphan_nodes
   450	# ---------------------------------------------------------------------------
   451	def check_orphan_nodes(vault: Path) -> CheckResult:
   452	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   453	
   454	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   455	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   450	# ---------------------------------------------------------------------------
   451	def check_orphan_nodes(vault: Path) -> CheckResult:
   452	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   453	
   454	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   455	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   456	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   457	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   458	
   459	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   460	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   461	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   462	
   463	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   464	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   465	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   466	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   467	    """
   468	    node_root = vault / NODE_DIR
   469	    notes: list[str] = []
   470	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   471	
   472	    if not node_root.is_dir():
   473	        return CheckResult(
   474	            name="orphan_nodes",
   475	            status=FAIL,
   476	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   477	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   478	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   479	            details={"nodes_scanned": 0, "inbound_targets": 0},
   480	        )
   481	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   482	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   483	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   484	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   485	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   486	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   487	    inbound: dict[str, set[str]] = {}
   488	    nodes: list[Path] = []
   489	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   490	        srcs, src_blind = _walk_md(vault / src_dir)
   491	        for rel, why in src_blind.items():
   492	            blind[f"{src_dir}/{rel}"] = why
   493	        if src_dir == NODE_DIR:
   494	            nodes = srcs
   495	        for src in srcs:
   496	            blocked = _scan_block_reason(vault, src)
   497	            if blocked:
   498	                blind[src.relative_to(vault).as_posix()] = blocked
   499	                continue
   500	            text = _read_text(src)
   501	            if text is None:
   502	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   503	                continue
   504	            _fm, body = _split_frontmatter(text)
   505	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   506	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   507	            src_phys = os.path.realpath(src)
   508	            for target in _wikilink_targets(body):
   509	                inbound.setdefault(target, set()).add(src_phys)
   510	
   511	    findings: list[Finding] = []
   512	    for node in nodes:
   513	        own = node.relative_to(vault).as_posix()
   514	        blocked = _scan_block_reason(vault, node)
   515	        if blocked:
   516	            blind[own] = blocked
   517	            continue
   518	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   519	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   520	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   521	        #    realpath 归并, 不得绕过自身排除。
   522	        own_phys = os.path.realpath(node)
   523	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   524	        if sources:
   525	            continue
   526	        text = _read_text(node)
   527	        if text is None:
   528	            blind[own] = "unreadable"
   529	            continue
   530	        fm, _body = _split_frontmatter(text)
   531	        if _fm_scalar(fm, "source_board"):
   532	            continue
   533	        findings.append(
   534	            Finding(
   535	                own,
   536	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   537	                f"(自身出链不计), 且 frontmatter 无 source_board",
   538	            )
   539	        )
   540	
   541	    if blind:
   542	        notes.append(
   543	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   544	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   545	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   546	        )
   547	    notes.append(
   548	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   549	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   550	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   551	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   552	    )
   553	    status = WARN if (findings or blind) else OK
   554	    return CheckResult(
   555	        name="orphan_nodes",
   556	        status=status,
   557	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   558	        findings=findings,
   559	        notes=notes,
   560	        details={
   561	            "nodes_scanned": len(nodes),
   562	            "inbound_targets": len(inbound),
   563	            "blind_spots": len(blind),
   564	            "blind_detail": dict(sorted(blind.items())),
   565	        },
   566	    )
   567	
   568	
   569	# ---------------------------------------------------------------------------
   570	# 检查 2 — raw_derived_confusion
   571	# ---------------------------------------------------------------------------
   572	def check_raw_derived(vault: Path) -> CheckResult:
   573	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   574	
   575	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   576	
   577	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   578	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   579	      G2 未登记根级文件    同上, 根级面
   580	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   780	
   781	
   782	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   783	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   784	    if not vault.is_dir():
   785	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   786	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   787	    checks: list[CheckResult] = []
   788	    for name in selected:
   789	        if name == "orphan_nodes":
   790	            checks.append(check_orphan_nodes(vault))
   791	        elif name == "raw_derived_confusion":
   792	            checks.append(check_raw_derived(vault))
   793	        elif name == "projection_freshness":
   794	            checks.append(check_projection_freshness(vault, today))
   795	    return LintReport(
   796	        vault=str(vault),
   797	        today=today.isoformat(),
   798	        checks=checks,
   799	        skipped=[n for n in CHECKS if n not in selected],
   800	    )
   801	
   802	
   803	def _utcnow() -> datetime:
   804	    """时钟缝 (Codex round-1 MEDIUM-2): 唯一的取当前时刻处, 测试 patch 它来锁
   805	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   806	    return datetime.now(timezone.utc)
   807	
   808	
   809	def resolve_today(now: str | None) -> date:
   810	    """`--now` → 上海本地日。
   811	
   812	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   813	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   814	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   815	    """
   816	    if now is None:
   817	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   818	    try:
   819	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   820	    except ValueError as exc:
   821	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   822	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   823	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   824	    try:
   825	        return dt.astimezone(_TZ_SHANGHAI).date()
   826	    except (OverflowError, OSError) as exc:
   827	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   828	
   829	
   830	_EPILOG = f"""
   831	检查项与状态分级 (ok/warn/fail 的判定规则, Codex round-1 MEDIUM-4 要求写进 --help):
   832	  orphan_nodes            {CHECKS["orphan_nodes"]}
   833	                            warn = 有孤儿或有扫描盲区 (symlink/不可读, 盲区里的文件未参与判定);
   834	                            fail = `节点/` 目录不存在 (检查没查成, 不是零孤儿)
   835	  raw_derived_confusion   {CHECKS["raw_derived_confusion"]}
   836	                            warn = 有混淆 finding (G1/G2/G3/G4/G9 或 回顾-* 缺 type: recap),
   837	                            或存在扫描盲区 (G8/G10/G11 / recap 越界拒读 —— "没查全" ≠ "没问题");
   838	                            本检查无 fail 态
   839	  projection_freshness    {CHECKS["projection_freshness"]}
   840	                            warn = stale (今天还没跑推送) 或 no_projection;
   841	                            fail = corrupt (投影文件坏, 下游拿不到数据)
   842	
   843	退出码:
   844	  0  全部检查 ok
   845	  2  有 warn、无 fail
   846	  1  有 fail
   847	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法 /
   848	      参数用法错误)
   849	
   850	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   851	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   852	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   853	   "vault 有问题" 与 "lint 没跑成"。参数用法错误也归 3 (Codex round-1 HIGH-6:
   854	   argparse 默认 exit(2) 会与"有 warn"撞码)。
   855	
   856	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   857	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   858	"""
   859	
   860	
   861	class _LintArgumentParser(argparse.ArgumentParser):
   862	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   863	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   864	
   865	    def error(self, message: str):  # type: ignore[override]
   866	        self.print_usage(sys.stderr)
   867	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   868	        raise SystemExit(EXIT_CONFIG)
   869	
   870	
   871	def main(argv: list[str] | None = None) -> int:
   872	    ap = _LintArgumentParser(
   873	        prog="vault_lint.py",
   874	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   875	        epilog=_EPILOG,
   876	        formatter_class=argparse.RawDescriptionHelpFormatter,
   877	    )
   878	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   879	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   880	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   881	    ap.add_argument(
   882	        "--only",
   883	        action="append",
   884	        choices=sorted(CHECKS),
   885	        default=None,
   886	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   887	    )
   888	    args = ap.parse_args(argv)
   889	
   890	    try:
   891	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   892	    except LintConfigError as exc:
   893	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   894	        return EXIT_CONFIG
   895	
   896	    if args.json:
   897	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   898	    else:
   899	        print(render_text(report, color=sys.stdout.isatty()))
   900	    return exit_code(report)
   901	
   902	
   903	if __name__ == "__main__":
   904	    sys.exit(main())

