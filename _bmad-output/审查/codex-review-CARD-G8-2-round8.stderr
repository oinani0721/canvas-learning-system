   628	# ---------------------------------------------------------------------------
   629	#: probe-B 2026-09-01 对真实 _vault_entry 的实测矩阵 (today=2026-08-31)。
   630	#: 机制列来自逐条归因: DATE_COMPARE / REGEX_REJECT / ASTIMEZONE_RAISE(OverflowError) /
   631	#: SUMMARIZE_TYPE_REJECT —— stale 一档盖 3 种机制, 只锁 status 对机制层变异是盲的,
   632	#: 故 h2/h3 (唯二触达 OverflowError 兜底的用例) 必须在场。
   633	FRESHNESS_MATRIX = [
   634	    # (generated_at, 期望 oracle status, 机制)
   635	    ("2026-08-31T09:05:05+08:00", "ok", "DATE_COMPARE"),
   636	    ("2026-08-30T09:05:05+08:00", "stale", "DATE_COMPARE 昨日"),
   637	    ("2026-08-31T01:05:05Z", "ok", "DATE_COMPARE Z 后缀"),
   638	    ("2026-08-30T23:00:00Z", "ok", "DATE_COMPARE 跨午夜: UTC 昨日 23:00 = 上海今日"),
   639	    ("2026-08-31T00:30:00+08:00", "ok", "DATE_COMPARE 上海今日凌晨"),
   640	    ("2026-08-31T17:05:05Z", "stale", "DATE_COMPARE 上海日翻篇: UTC 17:05 = 上海次日"),
   641	    ("2026-09-01T00:30:00+08:00", "stale", "DATE_COMPARE 次日"),
   642	    ("2026-08-31", "stale", "REGEX_REJECT 纯日期"),
   643	    ("2026-08-31T09:05:05", "stale", "REGEX_REJECT 无时区"),
   644	    ("", "stale", "REGEX_REJECT 空串"),
   645	    ("20260831", "stale", "REGEX_REJECT 数字串"),
   646	    ("+9999-08-31T09:05:05+08:00", "stale", "REGEX_REJECT 年份越界"),
   647	    ("2026-08-31T09:05:05+08:60", "stale", "REGEX_REJECT 非法分钟"),
   648	    ("2026-08-31T09:05:05+15:00", "stale", "REGEX_REJECT 越界时区偏移"),
   649	    ("9999-12-31T23:59:59+00:00", "stale", "ASTIMEZONE_RAISE OverflowError"),
   650	    ("0001-01-01T00:00:00+14:00", "stale", "ASTIMEZONE_RAISE OverflowError"),
   651	    (20260831, "corrupt", "SUMMARIZE_TYPE_REJECT 非字符串"),
   652	]
