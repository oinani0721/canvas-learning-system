  1021	def test_projection_outside_guard_precedes_read(tmp_path, monkeypatch):
  1022	    """Codex round-4 M17: 越界守卫必须在**读取之前** —— 用注入「读取即炸」的
  1023	    _read_text 锁顺序 (只断言结果时, 「先读再返回 corrupt」的精准变异不被抓)。"""
  1024	    outside = tmp_path / "outside-outputs"
  1025	    (outside / "outputs").mkdir(parents=True)
