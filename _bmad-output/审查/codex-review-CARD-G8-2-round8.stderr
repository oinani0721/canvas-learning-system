   655	@pytest.mark.parametrize("generated_at,expected,mechanism", FRESHNESS_MATRIX, ids=[m for _, _, m in FRESHNESS_MATRIX])
   656	def test_freshness_lock_with_live_oracle(tmp_path, generated_at, expected, mechanism):
