   319	def _norm_key(name: str) -> str:
   320	    """入链匹配键: NFC 归一 + casefold。
   321	
   322	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   323	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   324	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   325	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   326	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   327	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   328	    (假阴)。该权衡进验收单「不比什么」表。
   329	    """
   330	    return unicodedata.normalize("NFC", name).casefold().strip()
