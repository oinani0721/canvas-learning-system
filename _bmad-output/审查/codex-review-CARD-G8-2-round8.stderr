  1009	def test_code_span_commonmark_maximal_run(tmp_path):
  1010	    """Codex round-4 HIGH-2 (MarkdownIt 对照): `` ``[[A]] ` foo`` `` 整体是一个
  1011	    双反引号 span —— (\\`+)[^\\`]*\\1 会回溯成空 span + 单反引号 span, [[A]] 逃出。
  1012	    maximal run 配对算法下 [[A]] 必须被剥, A 报孤儿。"""
  1013	    root = tmp_path / "v"
