   663	        f"机制={mechanism}: vault_lint={status} oracle={entry['status']} 期望={expected} "
   664	        f"oracle_error={entry.get('error')!r}"
   665	    )
   666	    if entry["status"] == "ok":
   667	        assert entry["projection"]["generated_at"] is not None
