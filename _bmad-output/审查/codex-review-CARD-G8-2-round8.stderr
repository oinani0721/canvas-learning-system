   988	def test_raw_derived_g8_blind_forces_warn(tmp_path):
   989	    """Codex round-4 HIGH-1: G8/G10/G11 扫描面盲区 (不只 recap_blind) 必须让
   990	    raw_derived ≥ warn —— `节点/sub -> vault 外` 时 G8 在场, 不得假绿 ok。
   991	    CLI JSON 契约一并锁 (Codex round-4 M18-2: 只查内部 CheckResult 不够)。"""
   992	    outside = tmp_path / "outside"
   993	    outside.mkdir()
   994	    (outside / "A.md").write_text(NODE_FM + "正文\n", encoding="utf-8")
   995	    root = tmp_path / "v"
   996	    (root / "节点").mkdir(parents=True)
   997	    (root / "节点" / "sub").symlink_to(outside, target_is_directory=True)
   998	    res = vl.check_raw_derived(root)
   999	    assert res.status == vl.WARN, f"G8 盲区在场必须 warn, 实为 {res.status}"
  1000	    assert res.details["blind_spots"] >= 1
  1001	    # CLI JSON 契约: warn/blind_spots 必须透传到 --json 输出
  1002	    r = _run_cli(root, "--only", "raw_derived_confusion", "--now", NOW_ARG, "--json")
  1003	    payload = json.loads(r.stdout)
  1004	    chk = payload["checks"][0]
  1005	    assert chk["status"] == "warn" and chk["details"]["blind_spots"] >= 1, chk
  1006	    assert r.returncode == 2
