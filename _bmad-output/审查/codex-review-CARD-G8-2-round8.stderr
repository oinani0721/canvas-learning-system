   373	def _wikilink_targets(body: str) -> set[str]:
   374	    """正文里全部 wikilink 的 basename 集合 (已归一) —— **token 流法**。
   375	
   376	    ⛔ round-7 终局重构: rounds 2-7 手写的 Markdown 剥除/区间解析 (正则反向引用 →
   377	       maximal run 配对 → 字符偏移区间) 每轮修复都开新洞 (fence 容器嵌套 / 转义
   378	       run 粒度 / 跨区间源串扰 / AUTO-fence 互斥状态机), Codex round-7 一轮报出
   379	       5 个 HIGH。重演 G8-1 的核心教训「不重新实现解析」: Markdown 语义全部交给
   380	       **markdown-it-py** (venv 既有依赖 4.0.0, 也是各轮审查的对照裁判):
   381	       - block 级: fence / code_block / html_block 整块不扫 (含 blockquote/list
   382	         容器内的 —— mdit 递归解析, 本函数只看 token 序列不递归容器);
   383	       - inline 级: 只扫 `text` token; code_inline / html_inline 等一律不扫;
   384	       - 转义反引号 / maximal run / 跨段落: 库内正确处理, 本函数零自定义。
   385	       AUTO 段仍由 `_auto_segments` 自管 (项目自定义结构)。
   386	
   387	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   388	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   389	    (`resolve_node_id`) —— 三者本就同规则。
   390	
   391	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   392	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   393	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   394	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   395	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   396	
   397	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   398	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写)。**不**覆盖: AUTO 哨兵段、
   399	    fenced/indented code、行内 code、HTML 注释/块、blockquote/list 容器内的 code、
   400	    转义反引号旁的伪 run、跨行 `[[..]]`、空 `[[]]`。
   401	    """
   402	    out: set[str] = set()
   403	    for segment, is_auto in _auto_segments(body):
   404	        if is_auto:
   405	            continue  # AUTO 哨兵段整段盲 (含成员列表)
   406	        for token in _md_parser().parse(segment):
   407	            if token.type != "inline" or not token.children:
   408	                continue  # fence/code_block/html_block 等 block 级: 整块不扫
   409	            for child in token.children:
   410	                if child.type != "text":
   411	                    continue  # code_inline/html_inline/softbreak 等: 不扫
   412	                for m in _WIKILINK.finditer(child.content):
   413	                    inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   414	                    inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   415	                    if inner:
   416	                        out.add(_norm_key(inner))
   417	    return out
