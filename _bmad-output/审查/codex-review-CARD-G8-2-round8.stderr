  1027	    root = tmp_path / "v"
  1028	    root.mkdir()
  1029	    (root / "outputs").symlink_to(outside / "outputs", target_is_directory=True)
  1030	
  1031	    def boom(_path: Path) -> None:
  1032	        raise AssertionError("越界投影不得被读取 —— 守卫必须在 _read_text 之前")
  1033	
  1034	    monkeypatch.setattr(vl, "_read_text", boom)
  1035	    status, _error, _gen = vl._projection_status(root, TODAY)
  1036	    assert status == "corrupt"
