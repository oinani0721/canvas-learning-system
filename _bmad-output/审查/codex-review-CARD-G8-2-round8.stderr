   764	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   765	    bad = subprocess.run([sys.executable, str(SCRIPT)], capture_output=True, text=True, env=env, timeout=60)
   766	    assert bad.returncode == 3, f"缺 --vault 必须 rc=3 (用法错误), 实为 {bad.returncode}"
   767	    assert "--vault" in bad.stderr
