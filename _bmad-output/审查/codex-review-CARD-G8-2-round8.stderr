   153	# ---------------------------------------------------------------------------
   154	@dataclass(frozen=True)
   155	class Finding:
   156	    subject: str  #: 出问题的 vault 相对路径 / 主体
   157	    detail: str
   158	
   159	
   160	@dataclass
   161	class CheckResult:
   162	    """单个检查的结论。
   163	
   164	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   165	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   166	    """
   167	
   168	    name: str
   169	    status: str  #: ok | warn | fail
   170	    summary: str
   171	    findings: list[Finding] = field(default_factory=list)
   172	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   173	    notes: list[str] = field(default_factory=list)
   174	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   175	    details: dict[str, Any] = field(default_factory=dict)
   176	
   177	
   178	@dataclass
   179	class LintReport:
   180	    vault: str
   181	    today: str
   182	    checks: list[CheckResult]
   183	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   184	    skipped: list[str] = field(default_factory=list)
   185	
   186	
   187	def exit_code(report: LintReport) -> int:
   188	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   189	    statuses = {c.status for c in report.checks}
   190	    if FAIL in statuses:
   191	        return EXIT_FAIL
   192	    if WARN in statuses:
   193	        return EXIT_WARN
   194	    return EXIT_OK
