   825	def test_help_lists_checks_and_exit_semantics():
   826	    env = dict(os.environ)
   827	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   828	    proc = subprocess.run([sys.executable, str(SCRIPT), "--help"], capture_output=True, text=True, env=env, timeout=60)
   829	    assert proc.returncode == 0
   830	    out = proc.stdout
   831	    for name in vl.CHECKS:
   832	        assert name in out, f"--help 缺检查名 {name}"
   833	    for token in ("0", "2", "1", "3"):
   834	        assert token in out
   835	    assert "warn" in out and "fail" in out and "配置/环境错误" in out
   836	    # Codex round-1 MEDIUM-4: 分级规则必须出现在 --help, 不能只活在源码里
   837	    assert "节点/" in out and "不存在" in out, "--help 缺 orphan 的 fail 分级规则"
   838	    assert "corrupt" in out and "stale" in out, "--help 缺 freshness 的分级规则"
   839	    assert "scan 盲区" in out or "盲区" in out, "--help 缺 orphan 盲区降 warn 的规则"
   840	    # Codex round-5 M3: raw_derived 的盲区触发 warn 须专属可见 (只查任意"盲区"会把
   841	    # orphan 的盲区句当替身 —— round-6 LOW 判别力修正)
   842	    assert re.search(r"raw_derived_confusion.*?G8/G10/G11", out, re.S), (
   843	        "--help 缺 raw_derived 专属的 G8/G10/G11 盲区 warn 规则"
   844	    )
   845	    assert "dont_write_bytecode" in out.lower(), "--help 缺零写兜底声明"
