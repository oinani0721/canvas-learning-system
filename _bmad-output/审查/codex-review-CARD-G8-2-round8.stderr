  1015	    _board(root, "板", "``[[A]] ` foo``\n")
  1016	    res = vl.check_orphan_nodes(root)
  1017	    subjects = [f.subject for f in res.findings]
  1018	    assert subjects == ["节点/A.md"], f"maximal-run 语义缺失, [[A]] 逃出 span: {subjects}"
