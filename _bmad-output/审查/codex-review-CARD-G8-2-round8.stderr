   196	
   197	def report_to_json(report: LintReport) -> dict[str, Any]:
   198	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   199	    return {
   200	        "vault": report.vault,
   201	        "today": report.today,
   202	        "summary": {
