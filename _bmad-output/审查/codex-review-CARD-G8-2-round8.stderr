   253	def _scan_block_reason(vault: Path, path: Path) -> str | None:
   254	    """扫描读取的统一边界守卫: 返回拦截原因; None = 可以读。
   255	
   256	    覆盖 (Codex round-2 HIGH-1 的三条旁路, 复用 G8-1 的 G11 判据 `cvr.
   257	    _resolves_inside_vault` —— realpath 展开整条 symlink 链):
   258	      - 文件自身是 symlink (无论指内指外, 保守拒读);
   259	      - **祖先链上有 symlink** (目录 symlink 指向 vault 外时, 其后代文件自身
   260	        is_symlink()==False, 只有整链 realpath 才能识破);
   261	      - 解析后越出 vault (含 `..` 穿越、dangling 指外)。
   262	    dangling 指内的文件 resolve 在内但读不了 → 由 `_read_text` 的 OSError 分支记盲区。
   263	    """
   264	    if path.is_symlink():
   265	        return "symlink"
   266	    try:
   267	        rel = path.relative_to(vault).as_posix()
   268	    except ValueError:
   269	        return "outside-vault"
   270	    if not cvr._resolves_inside_vault(vault, rel):
   271	        return "resolves-outside-vault"
   272	    return None
   273	
   274	
   275	def _read_text(path: Path) -> str | None:
   276	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。
   277	
   278	    ⛔ symlink 一律拒绝读 (Codex round-1 HIGH-1): 文件 symlink 会被 is_file() 接纳并
   279	    跟随到 vault 外 —— 外部内容里的 wikilink 能藏住真孤儿。指 vault 内的 symlink
   280	    同样拒读 (保守, 方向 = 报盲区不假绿)。祖先链/越界由 `_scan_block_reason` 在
   281	    调用方先行拦截并记盲区 —— 本函数只是最后一道。
   282	    """
   283	    if path.is_symlink():
   284	        return None
   285	    try:
   286	        return path.read_text(encoding="utf-8")
   287	    except (OSError, UnicodeDecodeError, ValueError):
   288	        return None
