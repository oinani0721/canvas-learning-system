   235	    ]
   236	    for chk in report.checks:
   237	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   238	        for note in chk.notes:
   239	            out.append(f"    {c(DIM, 'note  ' + note)}")
   240	        for fd in chk.findings:
   241	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   242	    for name in report.skipped:
   243	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   244	    rc = exit_code(report)
   245	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   246	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   247	    return "\n".join(out)
