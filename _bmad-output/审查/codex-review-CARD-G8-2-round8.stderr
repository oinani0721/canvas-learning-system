   356	def test_orphan_ignores_nonsemantic_wikilinks(tmp_path):
   357	    """Codex round-1 HIGH-2/HIGH-4 + round-2 HIGH-4: 各类非语义 wikilink 载体都
   358	    不算入链 —— 每种形态单独一组 fixture, 节点必须仍报孤儿。
   359	    变异对照: 删掉 _strip_nonsemantic 后本组必红。"""
   360	    variants = {
   361	        "fenced": "```dataviewjs\n- [[被链]]\n```\n",
   362	        "inline_code": "命令 `- [[被链]] -` 示例\n",
   363	        "html_comment": "<!-- 说明: [[被链]] 已迁移 -->\n",
   364	        "auto_sentinel": (
   365	            "<!-- AUTO-GENERATED by .claude/scripts/sync_board_concepts.py · 真相源 = 节点 frontmatter source_board\n"
   366	            "     ⛔ 请勿手改：手改会在下次同步时被覆盖。 -->\n"
   367	            "- [[被链]]\n"
   368	            "<!-- /AUTO-GENERATED -->\n"
   369	        ),
   370	        "multiline": "[[\n被链\n]]\n",
   371	        # round-2 HIGH-4 四组合法 Markdown 变体
   372	        "fence4_with_fence3": "````text\n```\n- [[被链]]\n````\n",  # 四反引号栏内三反引号不关栏
   373	        "double_tick_span": "见 `` [[被链]] `` 说明\n",  # 双反引号 code span
   374	        "multiline_span": "前文 ``\n[[被链]]\n`` 后文\n",  # 跨行 code span
   375	        "unclosed_comment": "<!-- 未闭合注释\n[[被链]]\n",  # 未闭合 comment 剥到 EOF
   376	    }
   377	    for name, board_body in variants.items():
   378	        root = tmp_path / name
   379	        _node(root, "被链")
   380	        _board(root, "板", board_body)
   381	        res = vl.check_orphan_nodes(root)
   382	        subjects = [f.subject for f in res.findings]
   383	        assert subjects == ["节点/被链.md"], f"{name} 形态的伪链豁免了真孤儿: findings={subjects}"
