   835	  raw_derived_confusion   {CHECKS["raw_derived_confusion"]}
   836	                            warn = 有混淆 finding (G1/G2/G3/G4/G9 或 回顾-* 缺 type: recap),
   837	                            或存在扫描盲区 (G8/G10/G11 / recap 越界拒读 —— "没查全" ≠ "没问题");
   838	                            本检查无 fail 态
   839	  projection_freshness    {CHECKS["projection_freshness"]}
   840	                            warn = stale (今天还没跑推送) 或 no_projection;
   841	                            fail = corrupt (投影文件坏, 下游拿不到数据)
   842	
   843	退出码:
   844	  0  全部检查 ok
   845	  2  有 warn、无 fail
   846	  1  有 fail
   847	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法 /
   848	      参数用法错误)
   849	
   850	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   851	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   852	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   853	   "vault 有问题" 与 "lint 没跑成"。参数用法错误也归 3 (Codex round-1 HIGH-6:
   854	   argparse 默认 exit(2) 会与"有 warn"撞码)。
   855	
   856	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   857	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   858	"""
   859	
   860	
   861	class _LintArgumentParser(argparse.ArgumentParser):
   862	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   863	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   864	
   865	    def error(self, message: str):  # type: ignore[override]
   866	        self.print_usage(sys.stderr)
   867	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   868	        raise SystemExit(EXIT_CONFIG)
   869	
   870	
   871	def main(argv: list[str] | None = None) -> int:
   872	    ap = _LintArgumentParser(
   873	        prog="vault_lint.py",
   874	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   875	        epilog=_EPILOG,
   876	        formatter_class=argparse.RawDescriptionHelpFormatter,
   877	    )
   878	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   879	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   880	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   881	    ap.add_argument(
   882	        "--only",
   883	        action="append",
   884	        choices=sorted(CHECKS),
   885	        default=None,
   886	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   887	    )
   888	    args = ap.parse_args(argv)
   889	
   890	    try:
   891	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   892	    except LintConfigError as exc:
   893	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   894	        return EXIT_CONFIG
   895	
   896	    if args.json:
   897	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   898	    else:
   899	        print(render_text(report, color=sys.stdout.isatty()))
   900	    return exit_code(report)
   901	
   902	
   903	if __name__ == "__main__":
   904	    sys.exit(main())
