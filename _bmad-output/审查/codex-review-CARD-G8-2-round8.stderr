   204	            "checks_run": [c.name for c in report.checks],
   205	            "checks_skipped": list(report.skipped),
   206	            "status_counts": {s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)},
   207	        },
   208	        "checks": [
