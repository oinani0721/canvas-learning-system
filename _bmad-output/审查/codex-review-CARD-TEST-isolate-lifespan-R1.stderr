   678	def is_exempt(item, tests_dir) -> tuple[bool, str]:
   679	    """该用例是否豁免（只记不拦）。返回 (豁免, 依据)。
   680	
   681	    ``tests_dir`` = backend/tests 的绝对路径（由 conftest 传入 ``Path(__file__).parent``）。
   682	    路径判定用 **相对化后的首段目录**，不做整条路径的 substring——
   683	    ``/tmp/tests/integration/...`` 之类的绝对路径不得误判（Codex round-1 MEDIUM）。
   684	
   685	    ``W4_GUARD_NO_EXEMPT=1``（负控）时**一律不豁免**。
   686	    """
   687	    if exempt_disabled():
   688	        return False, "no-exempt-mode"
   689	    for marker in EXEMPT_MARKERS:
   690	        if item.get_closest_marker(marker) is not None:
   691	            return True, f"marker:{marker}"
   692	    try:
   693	        rel = item.path.resolve().relative_to(tests_dir.resolve())
   694	    except Exception:  # noqa: BLE001 —— 相对化失败（如 rootdir 外）一律不豁免，fail-closed
   695	        return False, ""
   696	    first = rel.parts[0] if rel.parts else ""
   697	    if first in EXEMPT_PATH_PREFIXES:
   698	        return True, f"path:{first}/"
   699	    return False, ""
   700	
