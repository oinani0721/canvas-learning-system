   872	def _base_cmd() -> list[str]:
   873	    """pytest 子进程命令前缀。
   874	
   875	    用 ``sys.executable -m pytest`` 而不是 ``BACKEND_DIR/.venv/bin/pytest``
   876	    （第八批 Codex MEDIUM/卡文裁判 2）：负控必须跑在**调用者指定的那个解释器**上，
   877	    否则「我用 A 解释器验证的门」和「你用 B 解释器跑的测试」不是同一件事。
   878	    """
   879	    return [
   880	        sys.executable,
   881	        "-m",
   882	        "pytest",
   883	        "-p",
   884	        "tests.support.guard_plugin",  # 显式点名装门（不受 rootdir/confcutdir 影响）
   885	        "-p",
   886	        "no:cacheprovider",
   887	        "--override-ini=addopts=",
   888	    ]
