   339	
   340	def _audit_hook(event: str, args) -> None:
   341	    """承重层：CPython ``socket.connect`` 审计事件（连接**发起前**触发）。
   342	
   343	    对 ``socket.socket`` / ``_socket.socket`` / ``socket.SocketType`` /
   344	    ``connect_ex`` 四条路径一律触发；hook 抛出的异常会原样传给调用方，
   345	    因此「抛 = 连接没发生」。
   346	    """
   347	    if event == "socket.connect":
   348	        address = args[1] if len(args) > 1 else None
   349	        if extract_port(address) in BLOCKED_PORTS:
   350	            if STATE.record(address):
   351	                raise RuntimeError(_block_message(address))
   352	    elif event == _SELFTEST_EVENT:
   353	        _SELFTEST_INBOX.append(args[0])
   354	
   355	
   356	#: audit hook 只能装一次（CPython 无 removeaudithook）；重复装会导致双计。
   357	_AUDIT_INSTALLED = False
   358	
   359	#: 进程级单例锚点。本模块若被以**两个不同的模块名**导入（``tests.support.
   360	#: live_port_guard`` 与 ``support.live_port_guard``，取决于 sys.path 怎么摆），
   361	#: 会出现两份 ``STATE`` 与两个 audit hook —— 连接尝试被记进其中一份账，另一份
   362	#: 汇报「零尝试」，而汇总行只打印其中一份。这是**账本分裂型假绿**，必须让它当场
   363	#: 炸掉而不是安静地少算。
   364	_SINGLETON_ATTR = "_w4_live_port_guard_module"
   365	
   366	
   367	def _install_audit_hook() -> None:
   368	    global _AUDIT_INSTALLED
   369	    if _AUDIT_INSTALLED:
   370	        return
   371	    me = sys.modules[__name__]
   372	    existing = getattr(sys, _SINGLETON_ATTR, None)
   373	    if existing is not None and existing is not me:
   374	        raise RuntimeError(
   375	            f"live_port_guard 已以另一个模块名装过门（{getattr(existing, '__name__', '?')} "
   376	            f"vs {__name__}）：会出现两份账本与两个 audit hook，汇总数字必然少算。"
   377	            "请统一导入路径（根 conftest 与 guard_plugin 都用 tests.support.live_port_guard）。"
   378	        )
   379	    setattr(sys, _SINGLETON_ATTR, me)
   380	    sys.addaudithook(_audit_hook)
   381	    _AUDIT_INSTALLED = True
   382	
   383	
   384	# ── 高层路径的身份锚点（belt，不承重、不记账）──────────────────────────────
   385	
   386	
   387	def _guarded_connect(sock_self, address):
   388	    """``socket.socket.connect`` 的身份锚点。**不拦截、不记账**，只委托。
   389	
   390	    拦截与记账全部由 :func:`_audit_hook` 完成（原函数内部触发审计事件）。
   391	    本包装存在的唯一理由：给 :func:`assert_guard_live` 一个**可比对身份**的对象，
   392	    从而发现「有人把 ``socket.socket.connect`` 换掉了」这类漂移。
   393	    """
   394	    return STATE._orig_connect(sock_self, address)
   395	
   396	
   397	def _guarded_connect_ex(sock_self, address):
   398	    """``socket.socket.connect_ex`` 的身份锚点。语义同 :func:`_guarded_connect`。"""
   399	    return STATE._orig_connect_ex(sock_self, address)
   400	
   401	
   402	def poison_uvloop() -> None:
   403	    """把 ``import uvloop`` 在本进程内变成 ``ImportError``。
   404	
   405	    uvloop 的 connect 走 libuv，不触发 CPython 的 ``socket.connect`` 审计事件 ——
   406	    与其事后检查「有没有人用了 uvloop」（时序上拦不住先装门后导入），不如直接
   407	    关死这扇门。本 venv 的 uvloop 全仓零引用，误伤面为零；若未来确需 uvloop，
   408	    必须连本门一起重新设计（下沉到 uvloop/OS 层）。
   409	    """
   410	    if "uvloop" not in sys.modules:
   411	        sys.modules["uvloop"] = None  # type: ignore[assignment] — import 时即 ImportError
   412	        for mod_name in [m for m in sys.modules if m.startswith("uvloop.")]:
   413	            sys.modules[mod_name] = None  # type: ignore[assignment]
   414	
   415	
   416	def install() -> None:
   417	    """装门（audit hook 承重 + belt 身份锚点 + uvloop 毒化 + 最终总账）。
   418	
   419	    幂等，且**每次调用都复核身份**：第八批 Codex HIGH 实测「装门 → 把
   420	    ``connect`` 恢复成原函数 → 再 ``install()``」得到 ``installed=True`` 而
   421	    ``connect_guarded=False``——只信布尔值的 install 会把已被拆掉的门当成在位。
   422	    这里改成：已装过就走 :func:`assert_guard_live`，漂移即抛 :class:`GuardDrift`。
   423	
   424	    ⚠️ 装=不卸：本门**只装不卸**。audit hook 本身就不可摘（CPython 无
   425	    ``sys.removeaudithook``）；belt 的 :func:`uninstall` 仅为 API 完整保留，
   426	    生产代码路径不调用。CLI 测试进程的迟到线程在 ``pytest_unconfigure`` 之后
   427	    仍可能发起连接，先恢复 socket 会留下无账窗口——门随进程存活到退出。
   428	    """
   429	    uvloop_mod = sys.modules.get("uvloop")
   430	    if uvloop_mod is not None:
   431	        # install 前就被人 import 了：collection/import 窗口已经不受保护，
   432	        # 宁可立刻 fail 也不装一道已知失效的门（Codex round-2 HIGH）。
   433	        raise RuntimeError(
   434	            "uvloop 在 install() 之前已被导入 —— 本门会静默失效，拒绝装门。"
   435	            "请在任何业务 import 之前先装门（根 conftest 已保证），并排查是谁提前导入了 uvloop。"
   436	        )
   437	    poison_uvloop()
