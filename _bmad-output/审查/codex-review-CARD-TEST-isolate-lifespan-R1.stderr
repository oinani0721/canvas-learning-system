   174	class _GuardState:
   175	    """门的运行时账。计数跨线程累加；归属走 ContextVar。"""
   176	
   177	    def __init__(self) -> None:
   178	        self._lock = threading.Lock()
   179	        self.installed = False
   180	        self.total = 0
   181	        self.blocked = 0
   182	        self.advisory = 0
   183	        #: 已被哨兵结账（转成用例失败）的 blocked 数。
   184	        self.billed = 0
   185	        self.records: list[dict] = []
   186	        # owner -> 该用例名下尚未结账的拦截记录
   187	        self.pending: dict[str, list[dict]] = {}
   188	        self._orig_connect = None
   189	        self._orig_connect_ex = None
   190	        #: 当前有效归属代次（end_item 即换代，旧 context 副本的票作废）。
   191	        self.current_gen = 0
   192	        self._next_gen = 1
   193	        #: ``pytest_cmdline_main`` 收口时报回来的退出码；None = pytest 没跑过。
   194	        self.reported_status: int | None = None
