   629	def write_ledger(path: str) -> None:
   630	    """把账本写到 ``path``（父进程独立复核用）。写失败不静默——直接抛。"""
   631	    ledger = STATE.ledger()
   632	    with open(path, "w", encoding="utf-8") as fh:
   633	        json.dump(ledger, fh, ensure_ascii=False, indent=2)
   634	
   635	
   636	def _final_accounting() -> None:
   637	    """最后一道结账：任何未结账的拦截都必须让进程以非零 rc 结束。
   638	
   639	    第八批 Codex HIGH：``pytest_cmdline_main`` 返回之后还有 pytest 自身的清理、
   640	    其它 ``atexit`` 处理器和迟到线程 —— 那段窗口里被拦下的连接会被记账，进程
   641	    却仍然 ``exit 0``，于是「任何未结账尝试都令测试失败」这句承诺不成立。
   642	    """
   643	    ledger = STATE.ledger()
   644	    path = os.environ.get(ENV_LEDGER)
   645	    if path:
   646	        try:
   647	            write_ledger(path)
   648	        except Exception as exc:  # noqa: BLE001 —— 落盘失败要说话，但不能盖掉结账
   649	            print(f"*** W4 guard: 账本落盘失败 {path}: {exc!r} ***", file=sys.stderr)
   650	    unaccounted = ledger["unaccounted"]
   651	    blocked = ledger["blocked"]
   652	    status = ledger["reported_status"]
   653	    # status is None ⇒ 不是 pytest 跑的（脚本/探针直接 import 本模块）：按 0 处理，
   654	    # 也就是「有非豁免拦截却打算正常退出」同样算失败。
   655	    effective_status = 0 if status is None else status
   656	    if unaccounted > 0 or (blocked > 0 and effective_status == 0):
   657	        print(
   658	            f"\n*** {BLOCK_REASON} —— 最终总账：blocked={blocked} "
   659	            f"unaccounted={unaccounted} reported_status={status}；"
   660	            f"进程被强制以退出码 {FINAL_EXIT_CODE} 结束（迟到连接不得以 0 收场）***",
   661	            file=sys.stderr,
   662	        )
   663	        for rec in ledger["unaccounted_records"]:
   664	            print(f"    - {rec['address']} on thread {rec['thread']} (owner={rec['owner']})", file=sys.stderr)
   665	        try:
   666	            sys.stdout.flush()
   667	            sys.stderr.flush()
   668	        except Exception:  # noqa: BLE001
   669	            pass
   670	        os._exit(FINAL_EXIT_CODE)
