   520	def analyze_source(source: str, rel: str) -> list[str]:
   521	    """对一份源码跑 AST 门，返回违规明细（空 = 合规）。"""
   522	    violations: list[str] = []
   523	    try:
   524	        tree = ast.parse(source)
   525	    except SyntaxError as e:
   526	        return [f"{rel}: SyntaxError {e}"]
   527	    index = _ModuleIndex(tree)
   528	
   529	    for node in ast.walk(tree):
   530	        if not isinstance(node, (ast.With, ast.AsyncWith)):
   531	            continue
   532	        scope = index.scope_for(node)
   533	        for pos_i, item in enumerate(node.items):
   534	            ctx = item.context_expr
   535	            if not isinstance(ctx, ast.Call):
   536	                continue
   537	            syn = _syntactic_call_name(ctx)
   538	            callee_origin = index._callable_origin(ctx.func, node, scope)
   539	            # 判为 TestClient 调用的两条路：词法叫 TestClient（哪怕被遮蔽），
   540	            # 或者解析到真正 import 来的 TestClient 类（覆盖 `as TC` 别名）。
   541	            if syn != "TestClient" and callee_origin != O_TESTCLIENT_CLASS:
   542	                continue
   543	            if syn == "TestClient" and callee_origin != O_TESTCLIENT_CLASS:
   544	                violations.append(
   545	                    f"{rel}:{node.lineno}: with TestClient(...) —— TestClient 这个名字"
   546	                    f"解析不到 {sorted(TESTCLIENT_MODULES)} 的真实 import（当前来源"
   547	                    f"={callee_origin}），无法证明它是被隔离约束覆盖的那个 TestClient"
   548	                )
   549	                continue
   550	            if not ctx.args:
   551	                violations.append(f"{rel}:{node.lineno}: TestClient() 无参 —— 人工复核")
   552	                continue
   553	            arg = ctx.args[0]
   554	            origin = index.resolve_arg(arg, node, scope)
   555	            if origin == O_LOCAL_APP:
   556	                continue  # 局部 FastAPI() 正例（且 FastAPI 类来源可证）
   557	            arg_desc = arg.id if isinstance(arg, ast.Name) else "<expr>"
   558	            if origin != O_MAIN_APP:
   559	                # unknown：来源无法静态证明 —— 按违规处理（fail-closed）。
   560	                violations.append(
   561	                    f"{rel}:{node.lineno}: with TestClient({arg_desc}) —— app 来源"
   562	                    f"无法静态证明（解析结果={origin}，按违规处理，人工复核）"
   563	                )
   564	                continue
   565	            # app 来自 app.main：必须有**排在前面的**隔离兄弟项、操作同一个 app、
   566	            # 且该 helper 名在**该使用点**确实解析为 tests.support.lifespan 的 import
   567	            # （重绑定 / 本地同名 no-op 一律失效）。
   568	            ok = False
   569	            for hpos, hitem in enumerate(node.items):
   570	                if hpos >= pos_i:
   571	                    break
   572	                hctx = hitem.context_expr
   573	                if not isinstance(hctx, ast.Call):
   574	                    continue
   575	                if index._callable_origin(hctx.func, node, scope) != O_HELPER:
   576	                    continue
   577	                hargs = hctx.args
   578	                if hargs and isinstance(arg, ast.Name) and isinstance(hargs[0], ast.Name) and hargs[0].id == arg.id:
   579	                    ok = True
   580	                    break
   581	            if not ok:
   582	                violations.append(
   583	                    f"{rel}:{node.lineno}: with TestClient({arg_desc}) —— app 来自"
   584	                    " app.main 且缺少**在前**的 no_lifespan/lifespan_lite 兄弟项"
   585	                    "（顺序不符、参数不同名，或 helper 名在该点已被重绑定/并非"
   586	                    " import 自 tests.support.lifespan，同样算违规）"
   587	                )
   588	    return violations
   826	def _child_env(vault_tmp: Path, lance_tmp: Path, ledger: Path | None) -> dict[str, str]:
   827	    """构造子进程环境：清 Neo4j 面 → 钉死受拦目标 → 关豁免 → 隔离写路径。"""
   828	    env = os.environ.copy()
   829	    # 1) 清掉调用者带进来的**全部** Neo4j 相关变量（含 NEO4J_URI/USER/PASSWORD/
   830	    #    TEST_URI/AUTH/DATABASE… 无论叫什么，只要以 NEO4J 开头）。
   831	    for key in [k for k in env if k.upper().startswith("NEO4J")]:
   832	        env.pop(key, None)
   833	    # 2) 钉死：目标端口必在门的射程内；凭据是假的。
   834	    env["NEO4J_URI"] = PINNED_NEO4J_URI
   835	    env["NEO4J_TEST_URI"] = PINNED_TEST_URI
   836	    env["NEO4J_USER"] = PINNED_NEO4J_USER
   837	    env["NEO4J_PASSWORD"] = PINNED_NEO4J_PASSWORD
   838	    # 3) 门自身的 fail-closed 开关：目标不在射程内就拒绝装门（子进程起不来）。
   839	    env["W4_GUARD_REQUIRE_BLOCKED_TARGET"] = "1"
   840	    # 4) 负控运行里不允许出现 advisory —— 豁免彻底关掉。
   841	    env["W4_GUARD_NO_EXEMPT"] = "1"
   842	    # 5) 写路径隔离到 tmp（live vault / 现网 LanceDB 只读）。
   843	    #    ⚠️ canonical 与 legacy 两个 LanceDB 变量必须**同值**：
   844	    #    `lib/agentic_rag/config.py::_resolve_lancedb_db_path` 在两者不同时抛
   845	    #    RuntimeError，而 `app/main.py:103` 是**无守护直调**——于是 lifespan 会在
   846	    #    LanceDB 这一步就 abort，**根本走不到 Neo4j 预热**，负门拿到 blocked=0
   847	    #    却以为是「哨兵没接住」。只 pin canonical 而让 legacy 从 .env（本车道
   848	    #    .env:94 就有 LANCEDB_PATH）漏进来，负门就变成了在测另一件事。
   849	    #    2026-09-03 于本车道实测：只 pin canonical ⇒ 3 条全部 setup ERROR
   850	    #    "Conflicting LanceDB paths"、attempts=0；两者同值 ⇒ 连接尝试正常发生。
   851	    env["CANVAS_BASE_PATH"] = str(vault_tmp)
   852	    env["LANCEDB_DATA_PATH"] = str(lance_tmp)
   853	    env["LANCEDB_PATH"] = str(lance_tmp)
   854	    # 6) 防注入：addopts 能塞 --rootdir/--confcutdir 绕开根 conftest；
   855	    #    PYTEST_PLUGINS 能在门装上之前 import 任意插件。
   856	    env.pop("PYTEST_ADDOPTS", None)
   857	    env.pop("PYTEST_PLUGINS", None)
   858	    # ⚠️ 不设 PYTEST_DISABLE_PLUGIN_AUTOLOAD：根 conftest 与目标文件依赖
   859	    #    hypothesis / pytest-asyncio / pytest-bdd 的注册，关掉 autoload 会让
   860	    #    collection 直接坏掉——那是「门没被验证」而不是「门更严」。门前窗口改由
   861	    #    guard_plugin 的 **import 期装门** 收敛（见该模块 docstring）。
   862	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   863	    # -p 插件加载早于 pytest 把 rootdir 塞进 sys.path —— 必须显式给 PYTHONPATH。
   864	    env["PYTHONPATH"] = str(BACKEND_DIR) + os.pathsep + env.get("PYTHONPATH", "")
   865	    if ledger is not None:
   866	        env["W4_GUARD_LEDGER"] = str(ledger)
   867	    else:
   868	        env.pop("W4_GUARD_LEDGER", None)
   869	    return env
