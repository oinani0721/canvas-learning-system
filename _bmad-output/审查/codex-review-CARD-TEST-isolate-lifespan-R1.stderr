   175	@pytest.hookimpl(wrapper=True)
   176	def pytest_cmdline_main(config):
   177	    """session 总账收口（Codex round-2 HIGH 两道）：
   178	
   179	    - 有无人买单的拦截（迟到线程 / collection 期 / 未知线程）→ 退出码 3；
   180	    - 兜底 belt：只要发生过非豁免拦截（blocked>0）而 pytest 却要返回 0
   181	      （例如哨兵翻红被 xfail 机制吃掉的任何残余形态），同样改 3 —— 非豁免
   182	      连接尝试绝不允许以「全绿」收场。豁免用例的 advisory 不在此列。
   183	
   184	    ⚠️ 本层**不是最后一道**：pytest 在本 hook 返回之后还有自身清理、其它
   185	    ``atexit`` 处理器与迟到线程（第八批 Codex HIGH 实测：那段窗口里的拦截被
   186	    记账、进程却仍 exit 0）。最终收口在 ``live_port_guard._final_accounting``
   187	    （``atexit`` LIFO 最后执行，必要时 ``os._exit(3)``）。这里把最终裁定用的
   188	    退出码回填给它。
   189	    """
   190	    status = yield
   191	    state = live_port_guard.STATE
   192	    if state.unaccounted_blocked():
   193	        status = 3
   194	    elif state.blocked > 0 and status == 0:
   195	        status = 3
   196	    state.reported_status = status
   197	    return status
