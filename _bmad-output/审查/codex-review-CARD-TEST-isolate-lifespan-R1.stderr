   471	        return self.scope_of.get(id(node), self.module_scope)
   472	
   473	    def resolve_name(self, name: str, pos: tuple[int, int], scope: _Scope) -> str:
   474	        """在 ``scope`` 处、位置 ``pos`` 上，名字 ``name`` 的来源。
   475	
   476	        * **本作用域**：取 ``pos`` **之前**最后一次绑定；只在 ``pos`` 之后才绑定
   477	          ⇒ unknown（Python 语义下那是 UnboundLocalError，静态上也不可证）。
   478	        * **外层作用域**：函数调用时刻不确定，因此要求该名字在外层的**全部**绑定
   479	          来源一致；有分歧 ⇒ unknown（fail-closed）。
   480	        * 类作用域对内层函数不可见（Python 语义），查找链跳过它。
   481	        """
   482	        cur: _Scope | None = scope
   483	        first = True
   484	        while cur is not None:
   485	            skip = (not first) and cur.kind == "class"
   486	            if not skip and name in cur.bindings:
   487	                bindings = cur.sorted_bindings(name)
   488	                if first:
   489	                    before = [o for p, o in bindings if p < pos]
   490	                    if before:
   491	                        return before[-1]
   492	                    return O_UNKNOWN
   493	                origins = {o for _, o in bindings}
   494	                return origins.pop() if len(origins) == 1 else O_UNKNOWN
   495	            cur = cur.parent
   496	            first = False
   497	        return O_UNKNOWN
   498	
   499	    def resolve_arg(self, arg: ast.expr, node: ast.AST, scope: _Scope) -> str:
   500	        if isinstance(arg, ast.Name):
   501	            return self.resolve_name(arg.id, _pos(node), scope)
   502	        if isinstance(arg, ast.Attribute):
   503	            return self._attribute_origin(arg, node, scope)
   504	        if isinstance(arg, ast.Call):
   505	            return self._value_origin(arg, node if isinstance(node, ast.stmt) else arg, scope)
   506	        return O_UNKNOWN
   507	
   508	
   509	def _syntactic_call_name(node: ast.expr) -> str | None:
   510	    """Call(...) 的**词法**函数名：``f()`` → f；``m.f()`` → f。"""
   511	    if not isinstance(node, ast.Call):
   512	        return None
   513	    if isinstance(node.func, ast.Name):
   514	        return node.func.id
   515	    if isinstance(node.func, ast.Attribute):
   516	        return node.func.attr
   517	    return None
   518	
   519	
   520	def analyze_source(source: str, rel: str) -> list[str]:
   521	    """对一份源码跑 AST 门，返回违规明细（空 = 合规）。"""
   522	    violations: list[str] = []
   523	    try:
   524	        tree = ast.parse(source)
   525	    except SyntaxError as e:
   526	        return [f"{rel}: SyntaxError {e}"]
   527	    index = _ModuleIndex(tree)
   528	
   529	    for node in ast.walk(tree):
   530	        if not isinstance(node, (ast.With, ast.AsyncWith)):
   531	            continue
   532	        scope = index.scope_for(node)
   533	        for pos_i, item in enumerate(node.items):
   534	            ctx = item.context_expr
   535	            if not isinstance(ctx, ast.Call):
   536	                continue
   537	            syn = _syntactic_call_name(ctx)
   538	            callee_origin = index._callable_origin(ctx.func, node, scope)
   539	            # 判为 TestClient 调用的两条路：词法叫 TestClient（哪怕被遮蔽），
   540	            # 或者解析到真正 import 来的 TestClient 类（覆盖 `as TC` 别名）。
   541	            if syn != "TestClient" and callee_origin != O_TESTCLIENT_CLASS:
   542	                continue
   543	            if syn == "TestClient" and callee_origin != O_TESTCLIENT_CLASS:
   544	                violations.append(
   545	                    f"{rel}:{node.lineno}: with TestClient(...) —— TestClient 这个名字"

