   891	def _parse_summary(stdout: str) -> tuple[int, int, int, int] | str:
   892	    """整行唯一解析门的汇总行。返回 (total, blocked, advisory, unaccounted) 或错误串。"""
   893	    hits = [m for line in stdout.splitlines() if (m := SUMMARY_RE.match(line.strip()))]
   894	    if len(hits) != 1:
   895	        return f"门汇总行匹配 {len(hits)} 次（期望恰好 1 次）"
   896	    return tuple(int(g) for g in hits[0].groups())  # type: ignore[return-value]
