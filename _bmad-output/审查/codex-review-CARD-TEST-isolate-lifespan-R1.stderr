   301	
   302	
   303	def extract_port(address) -> int | None:
   304	    """从 socket 地址里取端口。
   305	
   306	    IPv4 是 2 元组 ``('127.0.0.1', 7691)``；IPv6 是 4 元组
   307	    ``('::1', 7691, 0, 0)`` —— 2026-09-01 实测 neo4j 驱动走的正是 IPv6 四元组，
   308	    只按 ``len(address) == 2`` 判会**整条漏掉**。
   309	    AF_UNIX（str/bytes 地址）与其它协议族返回 None（不在本门射程）。
   310	
   311	    端口用 :func:`operator.index` 规范化而不是 ``isinstance(port, int)``：
   312	    CPython 的 socket 接受任何实现 ``__index__`` 的对象当端口（2026-09-03 实测
   313	    ``sock.connect(("127.0.0.1", IndexPort(p)))`` 连接成功），只认 ``int`` 会把
   314	    这类地址整条漏掉（第八批 Codex MEDIUM）。
   315	    """
   316	    if isinstance(address, tuple) and len(address) >= 2:
   317	        try:
   318	            return operator.index(address[1])
   319	        except TypeError:
   320	            return None
   321	    return None
   322	
   323	
   324	def _block_message(address) -> str:
   325	    return (
   326	        f"{BLOCK_REASON}: {address!r}. "
   327	        f"受拦端口 {sorted(BLOCKED_PORTS)} 是现网 Neo4j；测试进程不得连接。"
   328	        f"若这是端点测试，请用 backend/tests/support/lifespan.py::no_lifespan "
   329	        f"关掉 app.main 的 lifespan；若确需真库，用测试容器 "
   330	        f"NEO4J_TEST_URI(7692) 并打 integration/real_neo4j marker。"
   331	    )
   332	
   333	
   334	#: :func:`assert_guard_live` 与 audit hook 之间的一次性 token 信箱。
   335	_SELFTEST_INBOX: list[object] = []
   336	_selftest_counter = 0
   337	_selftest_lock = threading.Lock()
