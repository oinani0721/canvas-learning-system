   787	def run_ast_negative_control() -> int:
   788	    """四类绕过必须被抓；四条正例必须不被抓（验伪锚，防「恒判违规」的假门）。"""
   789	    print("=== AST GATE NEGATIVE CONTROL ===")
   790	    failures: list[str] = []
   791	    for label, src in _AST_MUST_FLAG:
   792	        vs = analyze_source(src, f"<negctl:{label}>")
   793	        status = "CAUGHT" if vs else "*** MISSED ***"
   794	        print(f"  [must-flag] {status}: {label}")
   795	        if not vs:
   796	            failures.append(f"绕过未被抓: {label}")
   797	        else:
   798	            print(f"              → {vs[0]}")
   799	    for label, src in _AST_MUST_PASS:
   800	        vs = analyze_source(src, f"<negctl:{label}>")
   801	        status = "CLEAN" if not vs else "*** FALSE POSITIVE ***"
   802	        print(f"  [must-pass] {status}: {label}")
   803	        if vs:
   804	            failures.append(f"正例误判: {label} → {vs}")
   805	    if failures:
   806	        print("AST-NEGATIVE-CONTROL: FAIL")
   807	        for f in failures:
   808	            print(f"  - {f}")
   809	        return 1
   810	    print(f"AST-NEGATIVE-CONTROL: PASS ({len(_AST_MUST_FLAG)} 绕过全抓 / {len(_AST_MUST_PASS)} 正例全净)")
   811	    return 0
   812	
