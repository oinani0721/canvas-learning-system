    57	set -uo pipefail
    58	
    59	# ── 地基清理：顺序不能换 ────────────────────────────────────────────────
    60	# BASH_ENV 指定的文件在本行之前就已经被 source 了；清掉它只防后续 bash 子进程，
    61	# 真正拔掉其副作用靠下面的「unset 全部函数」。
    62	unset BASH_ENV ENV CDPATH
    63	# 枚举并清掉**全部** shell 函数（含 BASH_FUNC_* 导出进来的）。compgen 是 builtin。
    64	for __fn in $(builtin compgen -A function 2>/dev/null); do
    65	  builtin unset -f "$__fn" 2>/dev/null || true
    66	done
    67	unset __fn
    68	# 恢复可能被 `enable -n` 关掉的 builtin —— 否则 printf/echo 会落到 PATH 上。
    69	builtin enable printf echo test [ read 2>/dev/null || true
    70	# 门自身的工具解析锁死在系统目录；被包裹命令另行恢复调用者 PATH（见下）。
    71	CALLER_PATH="${PATH:-}"
    72	PATH=/usr/bin:/bin:/usr/sbin:/sbin
    73	export PATH
    74	
    75	# ── 外部命令：绝对路径 + 存在性校验（不用 dirname/awk/grep）──────────────
    76	SHA_CANDIDATES=(/usr/bin/shasum /usr/bin/sha256sum /bin/sha256sum)
    77	SHA_BIN=""
    78	SHA_ARGS=()
    79	for __c in "${SHA_CANDIDATES[@]}"; do
    80	  if [ -x "$__c" ]; then
    81	    SHA_BIN="$__c"
    82	    case "$__c" in
    83	      */shasum) SHA_ARGS=(-a 256) ;;
    84	      *) SHA_ARGS=() ;;
    85	    esac
    86	    break
    87	  fi
    88	done
    89	unset __c
    90	if [ -z "$SHA_BIN" ]; then
    91	  builtin printf 'RUNTIME-FILES: GATE-BROKEN — 找不到可执行的 sha256 工具 (%s)\n' "${SHA_CANDIDATES[*]}" >&2
    92	  exit 1
    93	fi
    94	DATE_BIN=/bin/date
    95	DIFF_BIN=/usr/bin/diff
    96	
    97	# ── 门自证：常量串的 sha256 必须等于钉死值 ──────────────────────────────
    98	# 这一步同时验证 SHA_BIN、builtin printf、builtin read 三者都没被掉包。
    99	SELFTEST_INPUT='w4-runtime-sha-gate-selftest-v1'
   100	SELFTEST_EXPECTED='82e87819dac824b894684638a188059759c99d793641765853e5c5cae20baa1c'
   101	
   102	hash_stdin() {
   103	  # 从 stdin 读内容，回显 64 位十六进制摘要；失败回显空串。
   104	  local out digest rest
   105	  out="$("$SHA_BIN" "${SHA_ARGS[@]}")" || return 1
   106	  builtin read -r digest rest <<<"$out"
   107	  builtin printf '%s' "$digest"
   108	}
   109	
   110	SELFTEST_ACTUAL="$(builtin printf '%s' "$SELFTEST_INPUT" | hash_stdin)"
   111	if [ "$SELFTEST_ACTUAL" != "$SELFTEST_EXPECTED" ]; then
   112	  builtin printf 'RUNTIME-FILES: GATE-BROKEN — 门自证失败：sha256(%s) 期望 %s，实得 %s。\n' \
   113	    "$SELFTEST_INPUT" "$SELFTEST_EXPECTED" "${SELFTEST_ACTUAL:-<空>}" >&2
   114	  builtin printf '  哈希管道被劫持（假 shasum / 假 printf / 假 read / PATH 注入），本门的结论不可信。\n' >&2
   115	  exit 1
   116	fi
   152	# 自检: 监视清单不能悄悄变空/变短 —— 空清单会让本门「零比较、恒绿」。
   153	if [ "${#WATCHED[@]}" -ne "${EXPECTED_WATCH_COUNT}" ]; then
   154	  builtin printf 'RUNTIME-FILES: GATE-BROKEN — 监视清单有 %s 项, 期望 %s 项\n' \
   155	    "${#WATCHED[@]}" "${EXPECTED_WATCH_COUNT}" >&2
   156	  exit 1
   157	fi
   158	
   159	if [ "${1:-}" != "--" ]; then
   160	  builtin printf '用法: bash %s -- <command...>\n' "$0" >&2
   161	  builtin printf "  ('--' 之后的一切原样作为命令执行)\n" >&2
   162	  exit 2
   163	fi
   164	shift
   165	if [ "$#" -eq 0 ]; then
   166	  builtin printf "RUNTIME-FILES: GATE-BROKEN — '--' 之后没有命令; 拒绝空跑（空跑必然 unchanged, 是假绿）\n" >&2
   167	  exit 2
   168	fi
   215	if ! AFTER="$(snapshot)"; then
   216	  builtin printf 'RUNTIME-FILES: GATE-BROKEN — after snapshot 失败\n' >&2
   217	  exit 1
   218	fi
   219	builtin printf '=== RUNTIME-FILES after (%s) ===\n' "$("$DATE_BIN" '+%Y-%m-%d %H:%M:%S %z')"
   220	builtin printf '%s\n' "${AFTER}"
   221	builtin printf 'WRAPPED-COMMAND-EXIT: %s\n' "${CMD_RC}"
   222	
   223	if [ "${BEFORE}" != "${AFTER}" ]; then
   224	  builtin printf 'RUNTIME-FILES: CHANGED\n'
   225	  builtin printf -- '--- diff (before vs after) ---\n'
   226	  if [ -x "$DIFF_BIN" ]; then
   227	    "$DIFF_BIN" <(builtin printf '%s\n' "${BEFORE}") <(builtin printf '%s\n' "${AFTER}") || true
   228	  fi
   229	  exit 1
   230	fi
   231	
   232	builtin printf 'RUNTIME-FILES: unchanged\n'
   233	exit "${CMD_RC}"
   340	def _audit_hook(event: str, args) -> None:
   341	    """承重层：CPython ``socket.connect`` 审计事件（连接**发起前**触发）。
   342	
   343	    对 ``socket.socket`` / ``_socket.socket`` / ``socket.SocketType`` /
   344	    ``connect_ex`` 四条路径一律触发；hook 抛出的异常会原样传给调用方，
   345	    因此「抛 = 连接没发生」。
   346	    """
   347	    if event == "socket.connect":
   348	        address = args[1] if len(args) > 1 else None
   349	        if extract_port(address) in BLOCKED_PORTS:
   350	            if STATE.record(address):
   351	                raise RuntimeError(_block_message(address))
   352	    elif event == _SELFTEST_EVENT:
   353	        _SELFTEST_INBOX.append(args[0])
   402	def poison_uvloop() -> None:
   403	    """把 ``import uvloop`` 在本进程内变成 ``ImportError``。
   404	
   405	    uvloop 的 connect 走 libuv，不触发 CPython 的 ``socket.connect`` 审计事件 ——
   406	    与其事后检查「有没有人用了 uvloop」（时序上拦不住先装门后导入），不如直接
   407	    关死这扇门。本 venv 的 uvloop 全仓零引用，误伤面为零；若未来确需 uvloop，
   408	    必须连本门一起重新设计（下沉到 uvloop/OS 层）。
   409	    """
   410	    if "uvloop" not in sys.modules:
   411	        sys.modules["uvloop"] = None  # type: ignore[assignment] — import 时即 ImportError
   412	        for mod_name in [m for m in sys.modules if m.startswith("uvloop.")]:
   413	            sys.modules[mod_name] = None  # type: ignore[assignment]
   472	def audit_hook_alive() -> bool:
   473	    """行为级验证：把一枚一次性 token 送进 audit 子系统，看它是否回到本模块。
   474	
   475	    这不是读布尔值——token 没回来就说明 :func:`_audit_hook` 已不在 hook 链上
   476	    （或被替换成了别的对象）。CPython 不提供枚举 audit hook 的 API，
   477	    round-trip 是唯一能**证明**而不是**声明**在位的方式。
   478	    """
   479	    global _selftest_counter
   480	    with _selftest_lock:
   481	        _selftest_counter += 1
   482	        token = f"w4-selftest-{os.getpid()}-{_selftest_counter}"
   483	    _SELFTEST_INBOX.clear()
   484	    sys.audit(_SELFTEST_EVENT, token)
   485	    seen = token in _SELFTEST_INBOX
   486	    _SELFTEST_INBOX.clear()
   487	    return seen
   488	
   489	
   490	def assert_guard_live(context: str = "") -> None:
   491	    """门在位自证：audit 承重层 + belt 身份 + uvloop 毒化。漂移即 fail-closed。
   492	
   493	    调用点：:func:`install`（每次）、根 conftest 的 session fixture、以及**每个
   494	    用例边界**（``pytest_runtest_protocol`` 的进入与退出）。
   495	    """
   496	    where = f"（{context}）" if context else ""
   497	    if not _AUDIT_INSTALLED:
   498	        raise GuardDrift(f"承重 audit hook 从未安装{where}")
   499	    if not audit_hook_alive():
   500	        raise GuardDrift(
   501	            f"承重 audit hook 已不在链上{where}：selftest token 未回到本模块。"
   502	            "CPython 无 removeaudithook，出现本错误说明 sys.audit 被替换或本模块被重载。"
   503	        )
   504	    if not REQUIRED_BLOCKED_PORTS <= set(BLOCKED_PORTS):
   505	        raise GuardDrift(
   506	            f"受拦端口集被缩小{where}：当前 {sorted(BLOCKED_PORTS)}，"
   507	            f"必须覆盖 {sorted(REQUIRED_BLOCKED_PORTS)}。把现网端口从集合里摘掉 = 拆门。"
   508	        )
   509	    if not STATE.installed:
   510	        raise GuardDrift(f"belt 未安装{where}（install() 未跑？）")
   511	    base = _socket_mod.socket
   512	    if base.connect is not _guarded_connect:
   513	        raise GuardDrift(
   514	            f"socket.socket.connect 身份漂移{where}：当前是 {base.connect!r}，"
   515	            f"期望 {_guarded_connect!r}。有人把高层 connect 换掉了。"
   516	        )
   517	    if base.connect_ex is not _guarded_connect_ex:
   518	        raise GuardDrift(
   519	            f"socket.socket.connect_ex 身份漂移{where}：当前是 {base.connect_ex!r}，期望 {_guarded_connect_ex!r}。"
   520	        )
   521	    # 只查毒化这条**承重**证据：本函数会在每个用例边界跑，不适合每次都去动
   522	    # warnings 的全局过滤器（``assert_not_uvloop`` 里的 policy 复核会）。完整的
   523	    # policy 复核由 session fixture 单独调 :func:`assert_not_uvloop` 承担。
   524	    if sys.modules.get("uvloop") is not None:
   525	        raise GuardDrift(f"uvloop 毒化被绕过{where}：uvloop 走 libuv，不触发 socket.connect 审计事件。")
   526	
   527	
   528	def assert_not_uvloop() -> None:
   529	    """session 级复核：uvloop 已被 :func:`poison_uvloop` 关死。
   530	
   531	    import 失败毒化 + policy 复核双保险；policy 拿不到时不算证据失败
   532	    （3.14 起 get_event_loop_policy 已 deprecated），毒化才是承重防线。
   533	    """
   534	    if sys.modules.get("uvloop") is not None:
   535	        raise RuntimeError(
   536	            "uvloop 已在本进程被导入：uvloop 走 libuv，不触发 CPython 的 "
   537	            "socket.connect 审计事件，门会静默失效。install() 应当已把 uvloop "
   538	            "毒化——出现本错误说明毒化被人绕过（例如 install 前已被 import）。"
   539	        )
   540	    try:
   541	        with warnings.catch_warnings():
   542	            warnings.simplefilter("ignore", DeprecationWarning)
   543	            policy_module = type(asyncio.get_event_loop_policy()).__module__ or ""
   544	    except Exception:  # noqa: BLE001 —— 拿不到 policy 不算证据，靠 sys.modules 那条
   545	        return
   546	    if "uvloop" in policy_module:
   547	        raise RuntimeError(f"event loop policy 来自 uvloop（{policy_module}）：本门会静默失效。")
   550	def assert_test_uri_not_blocked() -> None:
   551	    """NEO4J_TEST_URI 指向受拦端口 = 配置事故，直接 fail 而不是悄悄放行。
   552	
   553	    刻意**不**做「把 NEO4J_TEST_URI 的端口从受拦集合里摘掉」——那会给出一条
   554	    「改个环境变量就能把门打开」的静默旁路。
   555	    """
   556	    uri = os.environ.get("NEO4J_TEST_URI") or ""
   557	    for port in BLOCKED_PORTS:
   558	        if f":{port}" in uri:
   559	            raise RuntimeError(f"NEO4J_TEST_URI={uri!r} 指向受拦端口 {port}（现网库）。测试容器应当是 7692。")
   618	def register_final_accounting() -> None:
   619	    """注册最终总账。``atexit`` 是 LIFO —— 本函数在 :func:`install` 里最早调用，
   620	    所以本处理器**最后**执行，位于 pytest 的全部清理与其它 ``atexit`` 之后。
   621	    """
   622	    global _FINAL_REGISTERED
   623	    if _FINAL_REGISTERED:
   624	        return
   625	    atexit.register(_final_accounting)
   626	    _FINAL_REGISTERED = True
   627	
