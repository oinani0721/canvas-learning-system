   441	    register_final_accounting()
   442	    if STATE.installed:
   443	        assert_guard_live("install(已装过，复核身份)")
   444	        return
   445	    base = _socket_mod.socket
   446	    STATE._orig_connect = base.connect
   447	    STATE._orig_connect_ex = base.connect_ex
   448	    base.connect = _guarded_connect  # type: ignore[method-assign]
   449	    base.connect_ex = _guarded_connect_ex  # type: ignore[method-assign]
   450	    STATE.installed = True
   451	    assert_guard_live("install(首次)")
   452	
   453	
   454	def uninstall() -> None:
   455	    """仅恢复 belt 的形状；**承重的 audit hook 摘不掉**（CPython 无 removeaudithook）。
   456	
   457	    CLI 测试进程刻意不调用（见 :func:`install` 的 ⚠️ 说明）。
   458	    """
   459	    if not STATE.installed:
   460	        return
   461	    base = _socket_mod.socket
   462	    base.connect = STATE._orig_connect  # type: ignore[method-assign]
   463	    base.connect_ex = STATE._orig_connect_ex  # type: ignore[method-assign]
   464	    STATE.installed = False
   465	
