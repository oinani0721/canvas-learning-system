   546	                    f"解析不到 {sorted(TESTCLIENT_MODULES)} 的真实 import（当前来源"
   547	                    f"={callee_origin}），无法证明它是被隔离约束覆盖的那个 TestClient"
   548	                )
   549	                continue
   550	            if not ctx.args:
   551	                violations.append(f"{rel}:{node.lineno}: TestClient() 无参 —— 人工复核")
