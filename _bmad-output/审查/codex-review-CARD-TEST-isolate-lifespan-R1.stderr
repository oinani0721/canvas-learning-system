   255	                child.bind(arg.arg, (0, 0), O_UNKNOWN)  # 形参：来源不可证
   256	            self._build_scope(stmt.body, child)
   257	            return
   258	        if isinstance(stmt, ast.ClassDef):
   259	            scope.bind(stmt.name, _pos(stmt), O_UNKNOWN)
   260	            child = _Scope(stmt, scope, "class")
   261	            self._build_scope(stmt.body, child)
   262	            return
   263	
   264	        self._record_bindings(stmt, scope)
   265	
   266	        # 非作用域语句：递归其子块，绑定仍归当前 scope
   267	        for field in ("body", "orelse", "finalbody", "handlers", "cases"):
   268	            block = getattr(stmt, field, None)
   269	            if not block:
   270	                continue
   271	            for sub in block:
   272	                if isinstance(sub, ast.stmt):
   273	                    self._walk_stmt(sub, scope)
   274	                else:  # ExceptHandler / match_case 容器
   275	                    self.scope_of[id(sub)] = scope
   276	                    name = getattr(sub, "name", None)
   277	                    if isinstance(name, str):
   278	                        scope.bind(name, _pos(sub), O_UNKNOWN)
   279	                    for inner in getattr(sub, "body", []) or []:
   280	                        self._walk_stmt(inner, scope)
   281	
   282	    @staticmethod
   283	    def _all_args(a: ast.arguments):
   284	        return [
   285	            *a.posonlyargs,
   286	            *a.args,
   287	            *a.kwonlyargs,
   288	            *([a.vararg] if a.vararg else []),
   289	            *([a.kwarg] if a.kwarg else []),
   290	        ]
   291	
   292	    def _record_bindings(self, stmt: ast.stmt, scope: _Scope) -> None:
   293	        pos = _pos(stmt)
   294	        if isinstance(stmt, ast.ImportFrom):
   295	            mod = stmt.module or ""
   296	            for alias in stmt.names:
   297	                bound = alias.asname or alias.name
   298	                origin = O_UNKNOWN
   299	                if mod == "app.main" and alias.name == "app":
   300	                    origin = O_MAIN_APP
   301	                elif mod in TESTCLIENT_MODULES and alias.name == "TestClient":
   302	                    origin = O_TESTCLIENT_CLASS
   303	                elif mod in FASTAPI_MODULES and alias.name == "FastAPI":
   304	                    origin = O_FASTAPI_CLASS
   305	                elif mod == "fastapi" and alias.name == "testclient":
   306	                    origin = O_TESTCLIENT_MODULE
   307	                elif mod == "tests.support.lifespan" and alias.name in ISOLATION_HELPER_NAMES:
   308	                    origin = O_HELPER
   309	                elif mod == "app" and alias.name == "main":
   310	                    origin = O_MAIN_MODULE
   311	                scope.bind(bound, pos, origin)
   312	            return
   313	        if isinstance(stmt, ast.Import):
   314	            for alias in stmt.names:
   315	                # `import a.b` 绑定的是**顶层包** `a`；`import a.b as x` 绑定 `x` = a.b
   316	                bound = alias.asname or alias.name.split(".")[0]
   317	                origin = O_UNKNOWN
   318	                if alias.asname:
   319	                    if alias.name == "app.main":
   320	                        origin = O_MAIN_MODULE
   321	                    elif alias.name in TESTCLIENT_MODULES:
   322	                        origin = O_TESTCLIENT_MODULE
   323	                    elif alias.name == "fastapi":
   324	                        origin = O_FASTAPI_MODULE
   325	                elif alias.name == "fastapi":
   326	                    origin = O_FASTAPI_MODULE
   327	                # `import app.main`（无 asname）绑定的是包 `app` —— 保持 unknown；
   328	                # `app.main.app` 这种链式属性由 _attribute_origin 的专门分支解析。
   329	                scope.bind(bound, pos, origin)
   330	            return
   331	        if isinstance(stmt, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
   332	            value = getattr(stmt, "value", None)
   333	            if isinstance(stmt, ast.Assign):
   334	                targets = stmt.targets
   335	            elif isinstance(stmt, ast.AnnAssign):
   336	                targets = [stmt.target]
   337	            else:
   338	                targets = [stmt.target]
   339	            if value is None:
   340	                for t in targets:
   341	                    self._bind_target(t, pos, O_UNKNOWN, scope)
   342	                return
   343	            origin = self._value_origin(value, stmt, scope)
   344	            for t in targets:
   345	                self._bind_target(t, pos, origin, scope)
   346	            return
   347	        if isinstance(stmt, (ast.With, ast.AsyncWith)):
   348	            for item in stmt.items:
   349	                var = item.optional_vars
   350	                if var is not None:
   351	                    self._bind_target(var, pos, O_UNKNOWN, scope)
   352	            return
   353	        if isinstance(stmt, (ast.For, ast.AsyncFor)):
   354	            self._bind_target(stmt.target, pos, O_UNKNOWN, scope)
   355	            return
   356	        if isinstance(stmt, (ast.Global, ast.Nonlocal)):
   357	            for name in stmt.names:
   358	                scope.bind(name, pos, O_UNKNOWN)
   359	            return
   360	
   361	    def _bind_target(self, target: ast.expr, pos, origin: str, scope: _Scope) -> None:
   362	        if isinstance(target, ast.Name):
   363	            scope.bind(target.id, pos, origin)
   364	        elif isinstance(target, (ast.Tuple, ast.List)):
   365	            for elt in target.elts:
   366	                # 解包：单个元素的来源不可逐一证明，只有整体来源可证时才传递
   367	                self._bind_target(elt, pos, origin, scope)
   368	
   369	    def _value_origin(self, value: ast.expr, stmt: ast.stmt, scope: _Scope) -> str:
   370	        """赋值右侧的来源。只有**可证**的形态才给非 unknown。"""
   371	        if isinstance(value, ast.Call):
   372	            callee = self._callable_origin(value.func, stmt, scope)
   373	            if callee == O_FASTAPI_CLASS:
   374	                return O_LOCAL_APP
   375	            if self._is_local_app_factory_call(value.func, stmt, scope):
   376	                return O_LOCAL_APP
   377	            return O_UNKNOWN
   378	        if isinstance(value, ast.Name):
   379	            return self.resolve_name(value.id, _pos(stmt), scope)
   380	        if isinstance(value, ast.Attribute):
   381	            return self._attribute_origin(value, stmt, scope)
   382	        return O_UNKNOWN
   383	
   384	    def _is_local_app_factory_call(self, func: ast.expr, node: ast.AST, scope: _Scope) -> bool:
   385	        """本模块内「返回局部 FastAPI() 的工厂」调用形态。
   386	
   387	        两种、且只有两种：
   388	          * ``make()`` —— 裸名字，必须是本模块 def 出来的那个名字；
   389	          * ``self.make()`` / ``cls.make()`` —— 同类方法（``test_rag_four_state_api``
   390	            的 ``self._real_service_client()`` 就是这一形态）。
   391	
   392	        **刻意不接受** ``other.make()``：``other`` 的类型无法静态证明，任何对象
   393	        只要有个同名方法就能冒充局部工厂 —— 那是把 fail-closed 拆掉。
   394	        """
   395	        if isinstance(func, ast.Name):
   396	            if func.id not in self.fastapi_returning_funcs:
   397	                return False
   398	            # 名字此刻必须仍绑定到本模块那个 def（重绑定后不再算数）
   399	            return self.resolve_name(func.id, _pos(node), scope) == f"{O_LOCAL_FUNC_PREFIX}{func.id}"
   400	        if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
   401	            return func.value.id in ("self", "cls") and func.attr in self.fastapi_returning_funcs
   402	        return False
   403	
   404	    def _callable_origin(self, func: ast.expr, node: ast.AST, scope: _Scope) -> str:
   405	        if isinstance(func, ast.Name):
   406	            return self.resolve_name(func.id, _pos(node), scope)
   407	        if isinstance(func, ast.Attribute):
   408	            return self._attribute_origin(func, node, scope)
   409	        return O_UNKNOWN
   410	
   411	    def _attribute_origin(self, attr: ast.Attribute, node: ast.AST, scope: _Scope) -> str:
   412	        base = attr.value
   413	        # app.main.app（`import app.main` 之后）
   414	        if (
   415	            isinstance(base, ast.Attribute)
   416	            and isinstance(base.value, ast.Name)
   417	            and base.value.id == "app"
   418	            and base.attr == "main"
   419	            and attr.attr == "app"
   420	        ):
   421	            return O_MAIN_APP
   422	        if isinstance(base, ast.Name):
   423	            base_origin = self.resolve_name(base.id, _pos(node), scope)
   424	            if base_origin == O_MAIN_MODULE and attr.attr == "app":
   425	                return O_MAIN_APP
   426	            if base_origin == O_TESTCLIENT_MODULE and attr.attr == "TestClient":
   427	                return O_TESTCLIENT_CLASS
   428	            if base_origin == O_FASTAPI_MODULE and attr.attr == "FastAPI":
   429	                return O_FASTAPI_CLASS
   430	            if base_origin == O_FASTAPI_MODULE and attr.attr == "testclient":
   431	                return O_TESTCLIENT_MODULE
   432	        return O_UNKNOWN
   433	
   434	    # ── FastAPI-returning helper 识别 ───────────────────────────────────
   435	    def _mark_all_fastapi_returning(self, tree: ast.Module) -> None:
   436	        """两轮：先按「可证 FastAPI 类」标一轮，再让 helper 调 helper 收敛一次。"""
   437	        for _ in range(2):
   438	            for node in ast.walk(tree):
   439	                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
   440	                    self._mark_fastapi_returning(node)
   441	
   442	    def _mark_fastapi_returning(self, fd) -> None:
   443	        own = self.scope_of.get(id(fd.body[0])) if fd.body else None
   444	        if own is None:
   445	            return
   446	        # 只看**本函数自己作用域**里的语句：嵌套函数的 return 归它自己，
   447	        # 不能算到外层函数头上（否则 `def outer(): def inner(): return FastAPI()`
   448	        # 会把 outer 误标成返回局部 app）。
   449	        own_stmts = [s for s in ast.walk(fd) if self.scope_of.get(id(s)) is own]
   450	        local_app_names: set[str] = set()
   451	        for stmt in own_stmts:
   452	            if isinstance(stmt, (ast.Assign, ast.AnnAssign)) and getattr(stmt, "value", None) is not None:
   453	                if self._value_origin(stmt.value, stmt, own) == O_LOCAL_APP:
   454	                    targets = stmt.targets if isinstance(stmt, ast.Assign) else [stmt.target]
   455	                    for t in targets:
   456	                        if isinstance(t, ast.Name):
   457	                            local_app_names.add(t.id)
   458	        for stmt in own_stmts:
   459	            if isinstance(stmt, ast.Return) and stmt.value is not None:
   460	                candidates = stmt.value.elts if isinstance(stmt.value, ast.Tuple) else [stmt.value]
   461	                for c in candidates:
   462	                    if isinstance(c, ast.Name) and c.id in local_app_names:
   463	                        self.fastapi_returning_funcs.add(fd.name)
   464	                        return
   465	                    if isinstance(c, ast.Call) and self._callable_origin(c.func, stmt, own) == O_FASTAPI_CLASS:
   466	                        self.fastapi_returning_funcs.add(fd.name)
   467	                        return
   468	
   469	    # ── 解析 ────────────────────────────────────────────────────────────
   470	    def scope_for(self, node: ast.AST) -> _Scope:
   471	        return self.scope_of.get(id(node), self.module_scope)
   472	
   473	    def resolve_name(self, name: str, pos: tuple[int, int], scope: _Scope) -> str:
   474	        """在 ``scope`` 处、位置 ``pos`` 上，名字 ``name`` 的来源。
   475	
   476	        * **本作用域**：取 ``pos`` **之前**最后一次绑定；只在 ``pos`` 之后才绑定
   477	          ⇒ unknown（Python 语义下那是 UnboundLocalError，静态上也不可证）。
   478	        * **外层作用域**：函数调用时刻不确定，因此要求该名字在外层的**全部**绑定
   479	          来源一致；有分歧 ⇒ unknown（fail-closed）。
   480	        * 类作用域对内层函数不可见（Python 语义），查找链跳过它。
   481	        """
   482	        cur: _Scope | None = scope
   483	        first = True
   484	        while cur is not None:
   485	            skip = (not first) and cur.kind == "class"
   486	            if not skip and name in cur.bindings:
   487	                bindings = cur.sorted_bindings(name)
   488	                if first:
   489	                    before = [o for p, o in bindings if p < pos]
   490	                    if before:
   491	                        return before[-1]
   492	                    return O_UNKNOWN
   493	                origins = {o for _, o in bindings}
   494	                return origins.pop() if len(origins) == 1 else O_UNKNOWN
   495	            cur = cur.parent
   496	            first = False
   497	        return O_UNKNOWN
   498	
   499	    def resolve_arg(self, arg: ast.expr, node: ast.AST, scope: _Scope) -> str:
   500	        if isinstance(arg, ast.Name):
   501	            return self.resolve_name(arg.id, _pos(node), scope)
   502	        if isinstance(arg, ast.Attribute):
   503	            return self._attribute_origin(arg, node, scope)
   504	        if isinstance(arg, ast.Call):
   505	            return self._value_origin(arg, node if isinstance(node, ast.stmt) else arg, scope)
   506	        return O_UNKNOWN
   507	
   508	
   509	def _syntactic_call_name(node: ast.expr) -> str | None:
   510	    """Call(...) 的**词法**函数名：``f()`` → f；``m.f()`` → f。"""
   511	    if not isinstance(node, ast.Call):
   512	        return None
   513	    if isinstance(node.func, ast.Name):
   514	        return node.func.id
   515	    if isinstance(node.func, ast.Attribute):
   516	        return node.func.attr
   517	    return None
