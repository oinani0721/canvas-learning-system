   141	@pytest.hookimpl(wrapper=True)
   142	def pytest_runtest_makereport(item, call):
   143	    """结账哨兵：把被 app/main.py 的 try/except 吞掉的拦截转成用例失败。
   144	
   145	    没有这一层，门拦住了连接却无人知晓——TestClient 照常进入、用例照常绿，
   146	    等于一门否定断言恒真的假门（2026-09-01 E3 机制实验实证）。
   147	    """
   148	    report = yield
   149	    if report.when in ("call", "teardown"):
   150	        records = live_port_guard.STATE.take(item.nodeid)
   151	        if records:
   152	            report.outcome = "failed"
   153	            # xfail 用例的 report 带 wasxfail：只改 outcome 时 pytest 不把它
   154	            # 计入失败，rc 仍为 0 —— 拦截记录就此从总账消失（Codex round-2
   155	            # HIGH 实测）。强制失败必须摘掉 wasxfail 标记。
   156	            if getattr(report, "wasxfail", None) is not None:
   157	                del report.wasxfail
   158	            detail = live_port_guard.format_sentinel(item.nodeid, records)
   159	            report.longrepr = f"{report.longrepr}\n\n{detail}" if report.longrepr else detail
   160	    return report
