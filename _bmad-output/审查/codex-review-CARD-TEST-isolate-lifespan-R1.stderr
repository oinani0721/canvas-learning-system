   590	
   591	def _port_of_uri(uri: str) -> int | None:
   592	    """从 ``bolt://[user:pass@]host:port[/path]`` 取端口。
   593	
   594	    解析不出来返回 None —— 调用方 :func:`assert_neo4j_target_blocked` 对 None
   595	    一律 fail-closed（拒绝装门），所以「解析器看不懂的 URI」不会变成放行。
   596	    """
   597	    tail = uri.split("://", 1)[1] if "://" in uri else uri
   598	    tail = tail.split("/", 1)[0]  # 去掉 path/query
   599	    tail = tail.rpartition("@")[2] or tail  # 去掉 userinfo（其中可能含 ':'）
   600	    if tail.startswith("["):  # IPv6 字面量 [::1]:7691
   601	        tail = tail.partition("]")[2]
   602	    if ":" not in tail:
   603	        return None
   604	    port_str = tail.rsplit(":", 1)[1]
   605	    try:
   606	        return int(port_str)
   607	    except ValueError:
   608	        return None
