   120	@pytest.hookimpl(wrapper=True)
   121	def pytest_runtest_protocol(item, nextitem):
   122	    """把连接尝试归属到用例；豁免用例（integration/e2e 路径与 marker）只记不拦。
   123	
   124	    归属写在 ContextVar 上（portal 线程带副本可见，裸线程默认 <unknown> 且永不
   125	    豁免 = fail-closed），见 tests/support/live_port_guard.py 的模块 docstring。
   126	
   127	    **每个用例边界都复核门的真实身份**（第八批 Codex HIGH：只信 ``STATE.installed``
   128	    会把被拆掉的门当成在位）。进入前与退出后各一次——退出侧的检查跑在 teardown
   129	    之后，所以用 monkeypatch 临时替换 socket 的用例不会误报，而**没还原**的会。
   130	    """
   131	    live_port_guard.assert_guard_live(f"用例进入前 {item.nodeid}")
   132	    exempt, _why = live_port_guard.is_exempt(item, Path(__file__).parent)
   133	    live_port_guard.begin_item(item.nodeid, exempt)
   134	    try:
   135	        return (yield)
   136	    finally:
   137	        live_port_guard.end_item()
   138	        live_port_guard.assert_guard_live(f"用例退出后 {item.nodeid}")
   139	
