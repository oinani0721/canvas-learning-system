     1	#!/usr/bin/env python
     2	"""底层旁路探针 —— 逐条证明第八批那批绕过现在都 fail-closed。
     3	
     4	[BATCH-2026-09-01-第九批 / CARD-TEST-isolate-lifespan-R1]
     5	
     6	卡文 §5「必须另跑」的那一组：``_socket.socket``/``SocketType`` 真实 loopback、
     7	``connect_ex``、``__index__`` 端口、拆 guard 后 reinstall、atexit 晚连接、
     8	dirname/printf/BASH_ENV 劫持。每条都在**独立子进程**里跑，父进程同时核对
     9	**退出码**与**唯一裁定行**（``PROBE-RESULT: PASS|FAIL <name> [:: reason]``）——
    10	只看 rc 会把「因为别的原因崩了」当成通过。
    11	
    12	## 为什么每条都配一个负控
    13	
    14	只证明「加了防线之后拦住了」不够：还要证明**是这条防线拦住的**。所以关键探针
    15	成对出现——把该层拆掉（``atexit.unregister``、不装门、改期望摘要）后，同一场景
    16	必须变成另一个结果。判据是「**指定的那一条**必须翻转」，不是「某处失败了」。
    17	
    18	## 连接目标怎么选（不碰现网库）
    19	
    20	* 机制类探针（底层 socket / connect_ex / ``__index__``）连的是**本进程起的
    21	  loopback 监听**，并把 ``BLOCKED_PORTS`` 临时指到那个端口。测的是「这条路径
    22	  会不会经过门」，与具体端口号无关。
    23	* 另有一条用**真实受拦端口 7691** 的探针，目标地址是 ``192.0.2.1``
    24	  （RFC 5737 TEST-NET-1，保证不可路由到任何真库）。门若失效，结果是超时/
    25	  unreachable 而不是连上现网 Neo4j —— 两种结局可区分，且都不产生实害。
    26	"""
    27	
    28	from __future__ import annotations
    29	
    30	import json
    31	import os
    32	import shutil
    33	import subprocess
    34	import sys
    35	import tempfile
    36	import textwrap
    37	from pathlib import Path
    38	
    39	BACKEND_DIR = Path(__file__).resolve().parent.parent
    40	PY = sys.executable
    41	
    42	VERDICT_PREFIX = "PROBE-RESULT:"
    43	
    44	_PREAMBLE = textwrap.dedent(
    45	    """
    46	    import os, sys, socket, _socket, threading, atexit
    47	    sys.path.insert(0, %r)
    48	    def verdict(ok, name, reason=""):
    49	        line = "PROBE-RESULT: %%s %%s" %% ("PASS" if ok else "FAIL", name)
    50	        if reason:
    51	            line += " :: " + reason
    52	        print(line, flush=True)
    53	    def listener():
    54	        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    55	        srv.bind(("127.0.0.1", 0)); srv.listen(5)
    56	        return srv, srv.getsockname()[1]
    57	    """
    58	) % str(BACKEND_DIR)
    59	
    60	
    61	def _run(name: str, body: str, *, expect_rc: int, env_extra: dict | None = None) -> dict:
    62	    env = os.environ.copy()
    63	    env["PYTHONDONTWRITEBYTECODE"] = "1"
    64	    env["PYTHONPATH"] = str(BACKEND_DIR) + os.pathsep + env.get("PYTHONPATH", "")
    65	    # 探针自身不需要 Neo4j；清干净避免任何驱动侧副作用。
    66	    for key in [k for k in env if k.upper().startswith("NEO4J")]:
    67	        env.pop(key, None)
    68	    if env_extra:
    69	        env.update(env_extra)
    70	    proc = subprocess.run(
    71	        [PY, "-c", _PREAMBLE + textwrap.dedent(body)],
    72	        cwd=BACKEND_DIR,
    73	        env=env,
    74	        capture_output=True,
    75	        text=True,
    76	        timeout=180,
    77	    )
    78	    verdicts = [ln.strip() for ln in proc.stdout.splitlines() if ln.strip().startswith(VERDICT_PREFIX)]
    79	    ok_rc = proc.returncode == expect_rc
    80	    ok_verdict = len(verdicts) == 1 and verdicts[0].split()[1] == "PASS"
    81	    reason = ""
    82	    if not ok_rc:
    83	        reason = f"rc={proc.returncode} 期望 {expect_rc}"
    84	    elif len(verdicts) != 1:
    85	        reason = f"裁定行 {len(verdicts)} 条（期望恰好 1 条）"
    86	    elif not ok_verdict:
    87	        reason = verdicts[0]
    88	    return {
    89	        "name": name,
    90	        "ok": ok_rc and ok_verdict,
    91	        "rc": proc.returncode,
    92	        "expect_rc": expect_rc,
    93	        "verdict": verdicts[0] if len(verdicts) == 1 else verdicts,
    94	        "reason": reason,
    95	        "stderr_tail": proc.stderr[-400:],
    96	    }
    97	
    98	
    99	# ═══════════════════════════════════════════════════════════════════════════
   100	# 承重层：底层 socket 路径
   101	# ═══════════════════════════════════════════════════════════════════════════
   102	
   103	_LOWLEVEL_BODY = """
   104	    from tests.support import live_port_guard as g
   105	    srv, port = listener()
   106	    g.BLOCKED_PORTS = frozenset(g.BLOCKED_PORTS | {port})  # 只加不减（门的不变量）：加一个本地探针端口，不碰现网
   107	    g.install()
   108	    kind = %r
   109	    if kind == "raw":
   110	        s = _socket.socket(socket.AF_INET, socket.SOCK_STREAM)
   111	    elif kind == "sockettype":
   112	        s = socket.SocketType(socket.AF_INET, socket.SOCK_STREAM)
   113	    else:
   114	        s = socket.socket()
   115	    try:
   116	        if kind == "connect_ex":
   117	            s.connect_ex(("127.0.0.1", port))
   118	        elif kind == "index":
   119	            class P:
   120	                def __index__(self): return port
   121	            s.connect(("127.0.0.1", P()))
   122	        else:
   123	            s.connect(("127.0.0.1", port))
   124	        verdict(False, %r, "连接未被拦下 —— 该路径绕过了承重层")
   125	    except RuntimeError as e:
   126	        if g.BLOCK_REASON in str(e):
   127	            verdict(True, %r)
   128	        else:
   129	            verdict(False, %r, "抛了但不是本门的原因: " + repr(e)[:120])
   130	    finally:
   131	        s.close(); srv.close()
   132	    """
   133	
   134	
   135	def probe_lowlevel(kind: str, name: str) -> dict:
   136	    body = _LOWLEVEL_BODY % (kind, name, name, name)
   137	    # 拦下一次非豁免连接 ⇒ blocked>0 且 reported_status is None ⇒ 最终总账强制 rc=3
   138	    return _run(name, body, expect_rc=3)
