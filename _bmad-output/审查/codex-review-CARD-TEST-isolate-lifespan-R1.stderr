   165	    if unaccounted:
   166	        print(
   167	            f"\n*** {live_port_guard.BLOCK_REASON} —— {len(unaccounted)} 次拦截"
   168	            "无人结账（迟到线程 / collection 期 / 未知线程），进程将以退出码 3 失败 ***",
   169	            file=sys.stderr,
   170	        )
   171	        for rec in unaccounted:
