   904	def sha_of(path: Path) -> str:
   905	    if not path.exists():
   906	        return "absent"
   907	    return hashlib.sha256(path.read_bytes()).hexdigest()
   908	
   909	
   910	def runtime_snapshot() -> str:
   911	    return "\n".join(f"{sha_of(p)}  {p}" for p in RUNTIME_FILES)
   912	
   913	
   914	def restore_absent_runtime_files(before: dict[Path, str]) -> tuple[list[str], list[str]]:
   915	    """把变异运行创建出来的运行时文件删掉，恢复到跑之前的状态。
   916	
   917	    只处理「跑之前 absent、跑之后存在」这一种情况 —— 那是**本脚本引起的**新增，
   918	    删掉即回到原状。对「跑之前就有、内容变了」的文件**刻意不覆盖**：那可能混进了
   919	    并发进程追加的真实数据，盲写回去会静默吞掉别人的记录（与变异体的 CAS 同口径）。
   920	    这种情况返回到 ``unresolved``，由调用方判失败并交人工。
   921	
   922	    Returns:
   923	        (removed, unresolved) 两个路径描述列表。
   924	    """
   925	    removed: list[str] = []
   926	    unresolved: list[str] = []
   927	    for path in RUNTIME_FILES:
   928	        was = before.get(path, "absent")
   929	        now = sha_of(path)
   930	        if was == now:
   931	            continue
   932	        if was == "absent" and path.exists():
   933	            path.unlink()
   934	            removed.append(str(path))
   935	        else:
   936	            unresolved.append(f"{path}: {was} → {now}")
   937	    return removed, unresolved
   938	
