   603	def run_ast_gate() -> tuple[int, list[str], int]:
   604	    """返回 (违规数, 违规明细, 扫描的文件数)。"""
   605	    files = ast_scope_files()
   606	    # 射程不能悄悄缩水成空集/极小集 —— 空集扫描必然 0 违规，是最典型的假绿。
   607	    if len(files) < 200:
   608	        return (
   609	            1,
   610	            [f"AST 射程只剩 {len(files)} 个文件（期望 ≥200）—— 射程缩水会让本门恒绿，判门损坏"],
   611	            len(files),
   612	        )
   613	
   614	    violations: list[str] = []
   615	    for path in files:
   616	        rel = str(path.relative_to(BACKEND_DIR))
   617	        violations.extend(analyze_source(path.read_text(encoding="utf-8"), rel))
   618	    return len(violations), violations, len(files)
