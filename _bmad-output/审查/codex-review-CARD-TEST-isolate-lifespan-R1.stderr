   820	PINNED_TEST_URI = "bolt://127.0.0.1:7692"
   821	#: 假凭据 —— 即使某条路径绕过了门，也拿不到任何真实库的会话。
   822	PINNED_NEO4J_USER = "w4-negctl-invalid-user"
   823	PINNED_NEO4J_PASSWORD = "w4-negctl-invalid-password"
