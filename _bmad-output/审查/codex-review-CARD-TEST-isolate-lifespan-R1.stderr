   210	                "thread": threading.current_thread().name,
   211	                "owner": owner,
   212	                "exempt": exempt,
   213	            }
   214	            self.total += 1
   215	            self.records.append(rec)
   216	            if exempt:
   217	                self.advisory += 1
   218	                return False
   219	            self.blocked += 1
   220	            self.pending.setdefault(owner, []).append(rec)
