   561	
   562	def assert_neo4j_target_blocked() -> None:
   563	    """要求 ``NEO4J_URI`` 指向**受拦端口**，否则拒绝装门（负控专用，默认关闭）。
   564	
   565	    第八批 Codex BLOCKER 的结构性收口：本门只按端口判定，射程之外的库它拦不住。
   566	    负控要做的事是「摘掉隔离，看门拦不拦」——如果此时 ``NEO4J_URI`` 指向的是
   567	    7691/7687 之外的某个真库，那么「摘掉隔离」会**真的连上去**，脚本只会事后
   568	    因 ``blocked=0`` 报失败，而实害已经发生。
   569	
   570	    所以负控用 ``W4_GUARD_REQUIRE_BLOCKED_TARGET=1`` 打开本检查：目标不在射程内
   571	    就在**任何测试跑起来之前**拒绝装门。检查读的是 **环境变量**（负控显式钉死的
   572	    那一份），不是 ``Settings``——本模块刻意不 import ``app.*``，装门必须早于任何
   573	    业务 import。负控另有一道 ``Settings`` 侧的前置自检（见负控脚本 step 0c），
   574	    两边口径一致才放行。
   575	    """
   576	    uri = os.environ.get("NEO4J_URI")
   577	    if not uri:
   578	        raise RuntimeError(
   579	            f"{ENV_REQUIRE_BLOCKED_TARGET}=1 但 NEO4J_URI 未设置：无法证明连接目标在门的射程内，拒绝装门。"
   580	        )
   581	    port = _port_of_uri(uri)
   582	    if port is None:
   583	        raise RuntimeError(f"{ENV_REQUIRE_BLOCKED_TARGET}=1 但 NEO4J_URI={uri!r} 解析不出端口，拒绝装门。")
   584	    if port not in BLOCKED_PORTS:
   585	        raise RuntimeError(
   586	            f"{ENV_REQUIRE_BLOCKED_TARGET}=1 但 NEO4J_URI={uri!r} 指向端口 {port}，"
   587	            f"不在受拦集合 {sorted(BLOCKED_PORTS)} 内 —— 摘掉隔离后会真实连接该库，拒绝装门。"
   588	        )
