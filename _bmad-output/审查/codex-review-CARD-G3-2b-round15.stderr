  4284	    LED.write_text("", encoding="utf-8")
  4285	    r2 = _run_writer(vault, _payload(event_id="E1#q1", ts=TS1, review_time=TS1))
  4286	    assert r2.returncode != 0, "真正的序数不符仍必须拒"
