   978	# ── G3-2 vault_id 绑定 (与校验器同函数同链路; 绑不出 = 配置断裂, fail-closed)
   979	_vid = _vault_id_of(Path(EV))
   980	if not _vid:
   981	    raise SystemExit("[quiz-answer] vault 归属无法绑定 (.canvas-config.yaml 缺失/损坏或 backend 不可达), fail-closed 拒写事件")
