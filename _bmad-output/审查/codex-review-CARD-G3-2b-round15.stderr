  4292	def test_round14_facts_compare_is_type_sensitive(vault):
  4293	    """事实比较必须**类型敏感**：`{"k":1}` 与 `{"k":true}` 不是同一次评分。
  4294	
  4295	    ⛔ Python 的 `==` 让 `1 == True` 成立 —— 这是我 round-13 把 `_ok_board` 放宽后
  4296	    留下的洞（值域变宽而比较语义没跟上）。修法不是再收紧类型（那会重新误拒），
  4297	    是换掉**比较语义**：canonical JSON 逐字比，严/松不再是一个可调旋钮。
  4298	    """
  4299	    LED = vault / "learning_events.jsonl"
  4300	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4301	    LED.unlink(missing_ok=True)
  4302	    assert (
  4303	        _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, exam_board={"k": 1})).returncode
  4304	        == 0
  4305	    )
  4306	    LED.write_text("", encoding="utf-8")
  4307	    face = _write_face(vault)
  4308	    r = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1, exam_board={"k": True}))
  4309	    assert r.returncode != 0, "1 与 true 是不同的 JSON 事实，不得判成同一次评分"
  4310	    assert "exam_board" in r.stderr, r.stderr[:250]
  4311	    assert _write_face(vault) == face, "零写"
