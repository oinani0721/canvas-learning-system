  4314	def test_round14_id_form_checked_at_candidate_stage(vault):
  4315	    """形态标记必须在**候选解释阶段**生效——来源集合非空时也不能被当作别人的裸形态。
  4316	
  4317	    ⛔ round-13 只在空来源分支判标记，于是来源非空的这条链漏网：正常写本地 `K`
  4318	    ⇒ receipt `quiz:K, id_form:"full"`；外部只把账本 id 改成 `quiz:quiz:K`
  4319	    （validator rc=0）；再提交本地 `quiz:K` ⇒ 裸回落命中那条 full 条目，
  4320	    旧实现 rc=0「已完整应用，幂等跳过」，**新评分零次入账**。
  4321	    """
  4322	    LED = vault / "learning_events.jsonl"
  4323	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4324	    LED.unlink(missing_ok=True)
  4325	    assert _run_writer_settled(vault, _payload(event_id="K", ts=TS1, review_time=TS1)).returncode == 0
  4326	    rows = list(_ledger_lines(vault))
  4327	    rows[0]["event_id"] = "quiz:quiz:K"  # 来源集合非空
  4328	    LED.write_text(json.dumps(rows[0], ensure_ascii=False) + "\n", encoding="utf-8")
  4329	    assert _run_validator(vault).returncode == 0
  4330	    n0, face = len(_ledger_lines(vault)), _write_face(vault)
  4331	    # ⚠️ 必须用**与原行相同的时刻/分数**提交：换了时刻会先撞 envelope 冲突,
  4332	    # 变异前后都拒 ⇒ 场景不判别（M128 此前正是这样活下来的）。
  4333	    # 同时刻时唯一起作用的就是「候选阶段是否查形态标记」。
  4334	    r = _run_writer(vault, _payload(event_id="quiz:K", ts=TS1, review_time=TS1))
  4335	    # ⛔ 原缺陷是 rc=0「已完整应用，幂等跳过」+ 账本/attempt 全不动（静默丢一次评分）。
  4336	    # 修好后 receipt 不再被当作本次的历史裸形态 ⇒ F1 为假 ⇒ 撞上「FSRS 已应用但缺
  4337	    # 校准记录」的人工裁定。判据点名「不得静默跳过」这件事本身。
  4338	    assert not (r.returncode == 0 and len(_ledger_lines(vault)) == n0 and _write_face(vault) == face), (
  4339	        f"⛔ 不得静默跳过（原缺陷：rc=0 而账本与 attempt 全不动）: rc={r.returncode}"
  4340	    )
  4341	    assert r.returncode != 0, f"该状态不可证，应 fail-closed: {r.stdout[:200]}"
  4342	    assert "缺校准记录" in r.stderr, r.stderr[:250]
