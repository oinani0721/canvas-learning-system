   968	# ── G3-2 三态判别 (复用校验器 classify_card_state, schema §6.2)。
   969	# degraded(残缺卡) → fail-closed: 报错、零写节点、检验白板停在
   970	# scored_pending_node_update 续跑态 (裁决③)。
   971	_fields = fields_from_frontmatter(fm)
   972	_state, _reason = classify_card_state(_fields)
   973	if _state == "degraded":
   974	    raise SystemExit(f"[quiz-answer] 节点调度状态残缺 (classify_card_state: {_reason}), fail-closed 拒写 — 请人工修复 {NODE} 后重跑")
   975	W = _fields.get("fsrs_last_review")
   976	W_inst = _aware(W) if W else None
