   676	            _a = _instant_only(_rp.get("review_time"), f"{ev_id} 的 payload.review_time")
   677	            _b = _instant_only(row.get("effective_at"), f"{ev_id} 的 effective_at")
   678	            _c = _instant_only(_rts, f"{ev_id} 的 receipt ts")
   679	        except SystemExit:
   680	            raise SystemExit(f"[quiz-answer] {ev_id} 的三个采用时刻里有不可解析的值 (review_time={_rp.get('review_time')!r} / effective_at={row.get('effective_at')!r} / receipt ts={_rts!r}), fail-closed 拒写")
   681	        if not (_a == _b == _c):
   682	            raise SystemExit(f"[quiz-answer] {ev_id} 的账本采用时刻 (effective_at={row.get('effective_at')!r} / review_time={_rp.get('review_time')!r}) 与 receipt 的 ts={_rts!r} 不是同一瞬间 — 同一次评分的调度时刻被改过, 放行会二次推进 FSRS, fail-closed 拒写 — 请人工核对账本与 {os.path.basename(NODE)}")
