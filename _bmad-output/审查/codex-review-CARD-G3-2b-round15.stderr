   460	        # ⛔ round-14 BLOCKER①: 形态标记必须在**候选解释阶段**生效, 不能等到后面
   461	        # 才补判。一条标了 `id_form: full` 的条目, 其 event_id **就是某个完整 id**;
   462	        # 拿它当「本次完整 id 的历史裸形态」是自相矛盾的解释。
   463	        # 实测别名链(来源集合**非空**, 所以 round-13 那道空来源判据够不着):
   464	        # 正常写本地 `K` ⇒ receipt `quiz:K, id_form:full`; 外部只把账本 id 改成
   465	        # `quiz:quiz:K`(validator rc=0); 再提交新的本地 id `quiz:K` ⇒ 裸回落命中
   466	        # 那条 full 条目, writer rc=0「已完整应用, 幂等跳过」, **新评分零次入账**。
   467	        # 只有**无标记的 legacy 条目**才允许裸回落 —— 它才可能是历史裸形态。
   468	        _bare_e = _receipt_of(fm_text, _bare)
   469	        if not (isinstance(_bare_e, dict) and _bare_e.get("id_form") == "full"):
   470	            _cands.append(_bare)
   471	    # 反查: 每个账本 id 贡献「完整」token; 带 `quiz:` 前缀的再贡献「历史裸」token。
   472	    _sources = set()
   473	    for _tok in _cands:
   474	        for _lid in all_ledger_ids:
   475	            if _lid == _tok or (_lid.startswith("quiz:") and _lid[5:] == _tok):
   476	                _sources.add(_lid)
   477	    _sources.discard("")
   478	    return (_cands, _sources)
   479	
   480	
   481	# ⛔ 事实清单**冻结** (Codex round-12 BLOCKER×3 + HIGH① 的共同根因):
   482	# round-11 抽出了统一的 resolver, 但**没有统一各调用点的事实清单** —— 四个判断
   483	# 「这次评分是否已应用」的站点各传各的:
   484	#   ≤W 全账扫描  0 项(只查 ID 在不在)  ⇒ validator-valid 的事实污染永久漏算一行
   485	#   F1-only      5 项(漏 exam_board)   ⇒ 同 ID 换白板的另一次评分被静默吞掉
   486	#   dup          0 项(只做三方绑定)
   487	#   foreign      3 项(漏 event_id/attempt/board)
   488	# 「抽了函数却让调用方随意传缺项」是「修一半」的又一变体。
   489	# 解法: 键集冻结 + 由**构造器**产出, 调用方不能传部分清单 —— 让「缺项」不可能。
   490	# ⚠️ `event_id` **不在**清单里(round-12 实测): 它的身份已由 `_cands_and_sources`
   491	# 的候选匹配 + 来源唯一性证明过; 在这里再做一次**原始相等**比较, 口径比契约更严 ——
   492	# 历史裸形态 receipt(`老键`)对完整 id(`quiz:老键`)是**合法**的兼容回落, 相等比较
   493	# 会把它判成「两次不同的评分」而误拒(实测: 旧笔记从此每次都被拒)。
   494	# ⛔ 「加严」不等于「更安全」—— 加在已被证明过的维度上, 只会制造误拒。
   495	_FACT_KEYS = ("scored_at", "attempt_count", "grade_norm", "abandoned", "exam_board")
   496	_ok_str = lambda v: isinstance(v, str) and bool(v) and v == v.strip()
   497	_ok_gn = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
   498	_ok_att = lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 1
   499	_ok_bool = lambda v: isinstance(v, bool)
   500	# ⛔ round-13: 不做 string-only 收窄 —— schema 未冻结该字段类型, writer 自己
   501	# 就会产出整数板名。校验只保证「不是 None/bool」, 相等比较承担实际鉴别。
   502	_ok_board = lambda v: v is not None and not isinstance(v, bool)
   503	
   504	
   505	# ⛔ 两个构造器共用的**归一化规则**（round-13 抽出）: 只要 `_facts_of_row` 与
   506	# `_facts_of_current` 各写各的取值方式, 就还有「半」可修 —— 实测: round-13 修
   507	# 「消费侧不得改值」时我只改了 row 那份, current 那份的 `str()` 强转还在,
   508	# 于是整数板名仍比出 `123 != '123'`。**并列实现是「修一半」的温床**;
   509	# 把「值怎么取、默认是什么」抽到这里, 两个构造器只负责「从哪儿取」。
   510	_FACT_MISSING = object()          # 区分「键缺失」与「显式 null」
   511	
   512	
   513	def _canon_fact(v):
   514	    """事实的 canonical 形式：**类型敏感**的 JSON 文本。
   515	
   516	    ⛔ 直接用 `==` 会让 `1 == True`、`0 == False` 成立, 于是两次事实不同的评分
   517	    被判成同一次(round-14 BLOCKER③ 实测)。不可 JSON 化的值退回带类型名的表示,
   518	    仍然类型敏感。
   519	    """
   520	    # ⛔ 数值按**数值语义**比, 不按 JSON 书写比 (round-15 自查发现的交界洞):
   521	    # `1` 与 `1.0` 是同一个数值的两种合法 JSON 书写(外部写入方可能用 int,
   522	    # validator rc=0), 而写侧 `round(float(x),2)` 恒产出 float ⇒ 用户以 1.0 重跑
   523	    # 被 envelope 冲突误拒。实测可达。
   524	    # ⚠️ 但 `True/False` **必须**与 1/0 区分 —— 那是不同类型的语义(布尔 vs 数值),
   525	    # 正是 round-14 BLOCKER③ 要拦的。所以 bool 先于数值判, 走 canonical 那支。
   526	    # ⛔ 这个洞落在两条修复的**交界处**: B③ 要类型敏感(顺带把 1/1.0 判不等),
   527	    # H② 的版本化身份规则只在 `_dgn != GN2` 时生效(而 1 == 1.0 在 Python 里成立,
   528	    # 条件不触发)。两条各自正确, 交界处出洞 —— 单条审查意见指不出这类洞。
   529	    if isinstance(v, (int, float)) and not isinstance(v, bool):
   530	        try:
   531	            return f"n:{float(v)!r}"          # NaN/Inf 也走这里, repr 稳定且互不相等
   532	        except (TypeError, ValueError, OverflowError):
   533	            pass
   534	    try:
   535	        return "j:" + json.dumps(v, sort_keys=True, ensure_ascii=False,
   536	                                 separators=(",", ":"), allow_nan=False)
   537	    except (TypeError, ValueError):
   538	        return f"r:{type(v).__name__}:{v!r}"
   539	
   540	
   541	_norm_board = lambda v: v if v is not None else ""       # 不强转类型: 按原始 JSON 值比
   542	_norm_gn = lambda v: v                                    # 不舍入: receipt 存的是原值
   543	
   544	
   545	def _facts_of_row(_o):
   546	    """从**账本行**构造完整六项事实（dup 之外的所有站点共用）。"""
   547	    _pl = _o.get("payload") or {}
   548	    return {
   549	        "scored_at": (str(_pl.get("scored_at") or _pl.get("review_time") or ""), _ok_str),
   550	        "attempt_count": (_pl.get("attempt_count"), _ok_att),
   551	        # ⛔ round-13 HIGH: **消费侧不得单方面改值**。此前这里 `round(..., 2)` 而
   552	        # receipt 存的是原值 ⇒ 合法的 `grade_norm=0.752`(validator rc=0) 与 receipt
   553	        # 的 0.752 比出 `0.752 != 期望 0.75`, **两阶段永久不收敛**。
   554	        # 要强制两位小数就得同时改 schema + validator + 所有生产者, 不能只在比较侧 round。
   555	        "grade_norm": (_norm_gn(_pl.get("grade_norm")), _ok_gn),
   556	        "abandoned": (_o.get("event_type") == "answer_abandoned", _ok_bool),
   557	        # ⛔ 同上: `str()` 强转 + string-only 校验会拒掉 writer **自己产出**的
   558	        # validator-valid 状态(实测 `exam_board=123` 首跑 rc=0、账本与 receipt 都存
   559	        # 整数 123, 紧接着同输入重跑 rc=1「类型非法」)。按原始 JSON 值比较;
   560	        # 默认值与 receipt 写侧逐字同款(`.get("exam_board", "")`), 否则缺字段时两边错位。
   561	        "exam_board": (_norm_board(_pl.get("exam_board", "")), _ok_board),
   562	    }
   563	
   564	
   565	def _facts_of_current(_sa, _att, _gn, _ab, _board):
   566	    """从**本次候选**构造完整六项事实（F1-only / dup 用）。"""
   567	    return {
   568	        "scored_at": (_sa, _ok_str),
   569	        "attempt_count": (_att, _ok_att),
   570	        "grade_norm": (_norm_gn(_gn), _ok_gn),
   571	        "abandoned": (bool(_ab), _ok_bool),
   572	        "exam_board": (_norm_board(_board), _ok_board),
   573	    }
   574	
   575	
   576	def _resolve_receipt(fm_text, ev_id, all_ledger_ids=(), row=None, facts=None, require_source=True):
   577	    """**唯一**的 receipt 解析 + 事实校验入口 (Codex round-11 BLOCKER/HIGH)。
   578	
   579	    ⛔ 为什么必须统一: 此前 receipt 验证散落在**六处**、严格度各不相同 ——
   580	    dup 路径比六项、F1-only 比两项、foreign replay 只看「ID 在不在」(布尔)。
   581	    于是同一份 receipt 在不同分支得到不同结论: 实测把 durable 的采用时刻改掉
   582	    (保留 scored_at 与 receipt), foreign replay 照常「恢复」E1 ⇒ **state 1→2、
   583	    stability 2.31→7.32、同一次评分被算了两遍**; 把 receipt 的 attempt 改成 999
   584	    也照样称「事实一致」。
   585	    这正是 round-10「修一半」那条教训的下一层: **抽出统一函数, 让分歧不可能存在**。
   586	
   587	    返回 (receipt, 唯一来源 id)。任何不可证的情形一律 raise SystemExit。
   588	
   589	    facts: 要逐项核对的事实字典; None 表示只解析不校验事实(仍做来源唯一性证明)。
   590	    row:   对应的账本行; 给出时额外强制「三方同瞬间」(ledger effective_at /
   591	           payload.review_time / receipt ts)。
   592	    """
   593	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   594	    if not _cands:
   595	        return (None, None)          # 没有 receipt —— 由调用方决定这是否可接受
   596	    # ⛔ 成功条件是 `_sources == {ev_id}` —— **空集同样不可证** (round-11 BLOCKER):
   597	    # 账本缺失时来源集合为空, 上一版把它当「唯一」放行 ⇒ 实测另一个完整 id 的评分
   598	    # 被静默吞掉 (rc=0、账本 0 字节、attempt 不变)。
   599	    # ⚠️ `require_source=False` 用于**账本行本就丢失**的分支 (F1-only): 那里
   600	    # 来源集合必然为空, 强制它等于 {ev_id} 就是「要求证明一个前提上不存在的
   601	    # 东西」。⛔ 统一函数不等于所有调用点参数相同 —— 共用逻辑的同时, 每个
   602	    # 调用点要声明它能提供什么证据。
   603	    # ⛔ round-12 BLOCKER①: 账本来源丢失(集合为空)时, 历史裸形态与完整形态的 receipt
   604	    # **字节上不可区分**。此时唯一可证的凭据是条目自带的 `id_form: full` 标记 ——
   605	    # 没有它就无从证明这条 receipt 存的是完整 id, 猜一个就会让另一次评分静默消失。
   606	    if not _sources:
   607	        _probe, _hit_tok = None, None
   608	        for _tok in _cands:
   609	            _probe = _receipt_of(fm_text, _tok)
   610	            if _probe is not None:
   611	                _hit_tok = _tok
   612	                break
   613	        # ⛔ round-13 BLOCKER①: `id_form: full` 只证明「这条 receipt 存的是**某个**完整
   614	        # id」, **不证明它就是本次的完整 id**。裸形态回落命中时, 那个标记恰恰是
   615	        # **另一个事件**留下的 —— 实测别名链: 本地 id `K` 写出 receipt
   616	        # `quiz:K, id_form:full`; 清空账本后提交本地 id `quiz:K`(完整 id 是
   617	        # `quiz:quiz:K`) ⇒ 裸形态回落命中那条, 标记满足, 判「已应用」幂等跳过,
   618	        # **第二次评分零次入账**(rc=0、账本 0 字节、attempt 停在 1)。
   619	        # 正确口径: 标记只对 **exact 命中**(token == ev_id)有效; 裸形态回落在来源
   620	        # 不可证时一律停 —— 那正是「两个世界字节相同」的场景。
   621	        _exact_hit = _hit_tok == ev_id
   622	        _marked = isinstance(_probe, dict) and _probe.get("id_form") == "full"
   623	        if not (_exact_hit and _marked):
   624	            raise SystemExit(
   625	                f"[quiz-answer] 账本里找不到 {ev_id!r} 的来源行, 而校准记录里命中的是 "
   626	                f"{_hit_tok!r} — "
   627	                + (
   628	                    f"它是**历史裸形态回落**命中(不是 {ev_id!r} 本身), 此时条目上的 "
   629	                    f"`id_form` 标记只能证明它存的是**某个**完整 id, 不能证明就是本次这个; "
   630	                    f"猜一个就会让另一次评分静默消失"
   631	                    if _hit_tok is not None and not _exact_hit else
   632	                    f"该条目没有 `id_form: full` 标记, 无法区分它存的是**完整 id** 还是"
   633	                    f"**历史裸形态**(两种情形下这条记录字节完全相同, 评分事实也相同)"
   634	                )
   635	                + f", fail-closed 拒写 — 请人工统一这些 id 或给该条目补上 `id_form: full`"
   636	            )
   637	    if require_source and _sources != {ev_id}:
   638	        raise SystemExit(
   639	            f"[quiz-answer] 校准记录里命中 {ev_id!r} 的条目, 但它的来源集合是 "
   640	            f"{sorted(_sources)!r} 而非恰好 {{{ev_id!r}}} — "
   641	            f"{'账本缺失, 历史裸形态的来源无从证明' if not _sources else '完整形态与历史裸形态无法区分'}; "
   642	            f"猜一个就会让另一次评分静默不入账, fail-closed 拒写 — 请人工统一这些 id"
   643	        )
   644	    _rcpt = None
   645	    for _tok in _cands:
   646	        _rcpt = _receipt_of(fm_text, _tok)
   647	        if _rcpt is not None:
   648	            break
   649	    if not isinstance(_rcpt, dict):
   650	        raise SystemExit(f"[quiz-answer] {ev_id} 在 calibration_log 里命中却读不出条目 — receipt 不可解析, fail-closed 拒写 — 请人工核对 {NODE}")
   651	
   652	    if facts:
   653	        # ⛔ 键集冻结 (round-12): 调用方**不能**传部分清单。传了就是编程错误 ——
   654	        # 四个站点曾各传 0/5/0/3 项, 于是同一份 receipt 在不同分支得到不同结论。
   655	        if set(facts) != set(_FACT_KEYS):
   656	            raise SystemExit(
   657	                f"[quiz-answer] 内部错误: receipt 事实清单不完整 "
   658	                f"(给了 {sorted(facts)}, 冻结键集是 {sorted(_FACT_KEYS)}) — "
   659	                f"缺项比较等于放行, fail-closed 拒写"
   660	            )
   661	        # ⛔ round-14 BLOCKER③: 事实比较必须**类型敏感**且区分「键缺失」与「显式 null」。
   662	        # Python 的 `==` 把 `1 == True`、`0 == False` 判为相等 ⇒ 实测
   663	        # `exam_board={"k":1}` 与 `{"k":true}` 被当成同一次评分(rc=0 幂等 no-op、
   664	        # 账本 0 字节、attempt 停在 1), 另一次评分静默消失。
   665	        # 而 `.get(_k)` 把「没这个键」和「值是 null」混成同一个 None。
   666	        # ⚠️ 这是我 round-13 修误拒时**放松**出来的洞: 把 `_ok_board` 从 string-only
   667	        # 放宽后, 值域变宽而比较语义没跟上。修法不是再收紧类型(那会重新误拒),
   668	        # 是换掉**比较语义** —— canonical JSON 逐字比, 严/松不再是一个可调旋钮。
   669	        _mis = []
   670	        for _k, (_want, _ok) in facts.items():
   671	            _got = _rcpt.get(_k, _FACT_MISSING)
   672	            if _got is _FACT_MISSING:
   673	                _mis.append(f"receipt 缺 {_k}")
   674	            elif not _ok(_got):
   675	                _mis.append(f"receipt 的 {_k} 类型非法 ({_got!r})")
   676	            elif _canon_fact(_got) != _canon_fact(_want):
   677	                _mis.append(f"{_k} {_got!r} != 期望 {_want!r}")
   678	        if _mis:
   679	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 与评分事实不一致 ({'; '.join(_mis)}) — 同一个 event_id 承载了两次不同的评分, fail-closed 拒写 — 请人工核对后修正 event_id 或账本")
   680	
   681	    if row is not None:
   682	        # ⛔ 三方同瞬间 (round-11 BLOCKER): ledger 的 effective_at / payload
   683	        # 的 review_time / receipt 的 ts 记的是同一个「调度采用时刻」。
   684	        # 只比 scored_at 时, 改掉采用时刻就能让同一次评分二次推进 FSRS。
   685	        _rts = _rcpt.get("ts")
   686	        if not isinstance(_rts, str) or not _rts or _rts != _rts.strip():
   687	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 缺可用的 ts (采用时刻) 或首尾含空白 ({_rts!r}) — 无法绑定账本的调度时刻; ⛔ 不做 strip(那会把两个不同的字面撞成一个), fail-closed 拒写")
   688	        _rp = row.get("payload") or {}
   689	        try:
   690	            _a = _instant_only(_rp.get("review_time"), f"{ev_id} 的 payload.review_time")
   691	            _b = _instant_only(row.get("effective_at"), f"{ev_id} 的 effective_at")
   692	            _c = _instant_only(_rts, f"{ev_id} 的 receipt ts")
   693	        except SystemExit:
   694	            raise SystemExit(f"[quiz-answer] {ev_id} 的三个采用时刻里有不可解析的值 (review_time={_rp.get('review_time')!r} / effective_at={row.get('effective_at')!r} / receipt ts={_rts!r}), fail-closed 拒写")
   695	        if not (_a == _b == _c):
   696	            raise SystemExit(f"[quiz-answer] {ev_id} 的账本采用时刻 (effective_at={row.get('effective_at')!r} / review_time={_rp.get('review_time')!r}) 与 receipt 的 ts={_rts!r} 不是同一瞬间 — 同一次评分的调度时刻被改过, 放行会二次推进 FSRS, fail-closed 拒写 — 请人工核对账本与 {os.path.basename(NODE)}")
   697	    return (_rcpt, ev_id)
   698	
   699	
   700	def _fm_has_event_compat(fm_text, ev_id, all_ledger_ids=()):
   701	    """F1 判定: 按**完整** event_id 查; 裸键回落**仅在映射可证唯一时**才做。
   702	
   703	    回落只为**历史兼容** —— 本卡之前写入的校准记录存的是剥前缀形态。新写入一律
   704	    存完整形态, 所以新数据不会再走回落分支。
   705	
   706	    ⛔ 但回落本身会**制造新的别名** (Codex round-5 BLOCKER, 实测): 账本里同时
   707	    存在裸键 `K` 与带前缀的 `quiz:K` 时, 后者回落查 `K` 会命中前者写下的校准
   708	    条目 —— 两个**不同的完整 event_id** 别名成一个, 那次评分静默不入账
   709	    (实测 rc=0、账本 attempts=[1,2]、第三次评分没有校准条目)。
