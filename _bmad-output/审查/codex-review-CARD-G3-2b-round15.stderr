  1343	def test_round1_followups_n1_to_n5(vault):
  1344	    # ── N1 (BLOCKER) 被伪装成乱序的真实后继：标 out_of_order 但 review_time > W
  1345	    # 旧实现无条件排除标记行 ⇒ 该事件的 FSRS 永久丢失且 writer 照常 rc=0
  2035	        row = _review_row(event_id="quiz:板A#q1")
  2036	        row["payload"] = bad_pl
  2037	        _write_ledger(vault, row)
  2038	        r4 = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z"))
  2039	        assert r4.returncode != 0, f"payload={bad_pl!r} 必须拒"
  2040	        # round-5 后 payload 类型门移到**归属判断之后**（此前排在前面，会误拒
  2041	        # 合法的别节点 v2 记录 —— v2 允许 payload 是别的类型）。本节点的行走
  2042	        # 「缺 payload 或类型不对」这一支，拒因串因此不同、语义一致。
  2043	        assert ("payload 不是 object" in r4.stderr) or ("缺 payload 或其类型不是 object" in r4.stderr), r4.stderr
  2044	        assert "Traceback" not in r4.stderr, "必须是 clean fail-closed"
  2045	
  2046	    # ⑤ BLOCKER：恢复与新写必须分成两次原子发布。
  2047	    # 旧实现在同一次运行里既重放 foreign pending 又追加本次事件，两个后果：
  2048	    # 被重放事件的 mastery/校准无载荷可复放而永久丢失（rc=0 无信号）；
  2049	    # 「连续两次发布前崩溃」在**单进程**下就能攒出 2 条 pending，此时 attempt
  2050	    # 序数与 mastery 基线都不可证。
  2051	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2052	    a = _review_row(event_id="quiz:板A#q1", **{"payload.review_time": "2026-08-03T10:00:00Z"})
  2053	    a["effective_at"] = "2026-08-03T10:00:00Z"
  2054	    b = _review_row(
  2055	        event_id="quiz:板B#q1",
  2056	        **{"payload.review_time": "2026-08-04T10:00:00Z", "payload.attempt_count": 2},
  2057	    )
  2058	    b["effective_at"] = "2026-08-04T10:00:00Z"
  2059	    _write_ledger(vault, a, b)
  2060	    r5 = _run_writer(vault, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z"))
  2061	    assert r5.returncode != 0, "两条 pending 时不得在同一次运行里既恢复又追加"
  2062	    assert "恢复已落定" in r5.stderr, r5.stderr
  2063	    assert len([ln for ln in r5.stdout.splitlines() if "A2 重放已应用" in ln]) == 2, "两条都要重放"
  2064	    assert "已按各自的账本载荷复放" in r5.stdout, "两条被恢复事件的评分链副作用都要复放"
  2065	    assert len(_ledger_lines(vault)) == 2, "第一阶段不得追加本次事件"
  2066	    assert _fm_fields(vault)["fsrs_last_review"] == "2026-08-04T10:00:00Z", "恢复结果必须已落盘"
  2067	    # 第二阶段：pending 已空，本次评分在干净基线上写入
  2068	    r6 = _run_writer(vault, _payload(event_id="板C#q1", ts="2026-08-05T10:00:00Z"))
  2069	    assert r6.returncode == 0, r6.stdout + r6.stderr
  2070	    assert [x["payload"]["attempt_count"] for x in _ledger_lines(vault)] == [1, 2, 3]
  2071	    assert _run_validator(vault).returncode == 0
  2072	
  2073	    # ⑥ 两阶段必须在 2 轮内收敛，且 payload 临时文件要留着让用户能重跑。
  2074	    # 「先恢复、再要求重跑」这个结构最大的风险是**不收敛**——每跑一次都说
  2075	    # 「恢复已落定请重跑」却永远跑不完。三种时刻关系都要验：被恢复事件的时刻
  2076	    # 晚于 / 等于 / 早于本次评分（晚于那档尤其要紧：第二轮里 A3 得把本次时刻
  2077	    # 推到 W+1s 才写得进去）。
  2078	    for i, (pending_rt, desc) in enumerate(
  2079	        (
  2080	            ("2026-08-10T10:00:00Z", "被恢复事件晚于本次评分"),
  2081	            ("2026-08-02T10:00:00Z", "被恢复事件与本次评分同刻"),
  2082	            ("2026-08-01T10:00:00Z", "被恢复事件早于本次评分"),
  2083	        )
  2084	    ):
  2085	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2086	        row = _review_row(event_id="quiz:板A#q1", **{"payload.review_time": pending_rt})
  2087	        row["effective_at"] = pending_rt
  2088	        _write_ledger(vault, row)
  2089	        rounds, last = 0, None
  2090	        for _ in range(5):
  2091	            rounds += 1
  2092	            last = _run_writer(vault, _payload(event_id=f"收敛{i}#q1", ts="2026-08-02T10:00:00Z"))
  2093	            if not (last.returncode != 0 and "恢复已落定" in last.stderr):
  2094	                break
  2095	        assert rounds == 2, f"[{desc}] 必须恰好 2 轮收敛，实为 {rounds}: {last.stderr}"
  2096	        assert last.returncode == 0, f"[{desc}] 第二轮必须写成: {last.stdout}{last.stderr}"
  2097	        assert len(_ledger_lines(vault)) == 2, f"[{desc}] 最终账本 2 行"
  2098	    # payload 临时文件必须在第一阶段退出时保留 —— 删了用户就无法重跑，两阶段
  2099	    # 结构会把人卡死在中间态。
  2100	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  2101	    _write_ledger(vault, _review_row(event_id="quiz:板A#q1"))
  2102	    rp = _run_writer(vault, _payload(event_id="板P#q1", ts="2026-08-02T10:00:00Z"))
  2103	    assert rp.returncode != 0 and "恢复已落定" in rp.stderr
  2104	    assert (vault.parent / "payload.json").exists(), "第一阶段退出必须保留 payload，否则无法重跑"
  2105	
  2106	    # ⑦ 复放后必须追平基准（「载荷都在 payload 里」的正面证据）。
  2107	    # 我曾反复声明「被恢复事件的 mastery/校准没有事件载荷可复放」并据此不修 ——
  2108	    # 那是错的：grade_norm 与 review_time 都在 payload 里，_apply_mastery 要的
  2109	    # 正是这两个。实测掌握度：没崩溃连答三次 = 0.59；崩溃后先答下一题，复放前
  2110	    # 0.65、复放后 0.59。本门锁住「两条路径的最终掌握度一致」。
  3938	        assert needle in r.stderr, f"[{bad!r}] 拒因须点名 {needle!r}: {r.stderr[:250]}"
  3939	        assert _write_face(vault) == face, f"[{bad!r}] 零写 —— 不得先落账再发现认不出"
  3940	    # 验伪：非空 id 首跑→重跑必须收敛（这正是原缺陷的反面）
  3941	    r1 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3942	    assert r1.returncode == 0, r1.stderr[:250]
  3943	    n1 = len(_ledger_lines(vault))
  3944	    r2 = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3945	    assert r2.returncode == 0, f"同输入重跑必须收敛而不是报缺校准记录: {r2.stderr[:250]}"
  3946	    assert len(_ledger_lines(vault)) == n1, "重跑不得新增账本行"
