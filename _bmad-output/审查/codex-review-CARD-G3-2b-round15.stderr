   504	
   505	# ⛔ 两个构造器共用的**归一化规则**（round-13 抽出）: 只要 `_facts_of_row` 与
   506	# `_facts_of_current` 各写各的取值方式, 就还有「半」可修 —— 实测: round-13 修
   507	# 「消费侧不得改值」时我只改了 row 那份, current 那份的 `str()` 强转还在,
   508	# 于是整数板名仍比出 `123 != '123'`。**并列实现是「修一半」的温床**;
   509	# 把「值怎么取、默认是什么」抽到这里, 两个构造器只负责「从哪儿取」。
   510	_FACT_MISSING = object()          # 区分「键缺失」与「显式 null」
   511	
   512	
   513	def _canon_fact(v):
   514	    """事实的 canonical 形式：**类型敏感**的 JSON 文本。
   515	
   516	    ⛔ 直接用 `==` 会让 `1 == True`、`0 == False` 成立, 于是两次事实不同的评分
   517	    被判成同一次(round-14 BLOCKER③ 实测)。不可 JSON 化的值退回带类型名的表示,
   518	    仍然类型敏感。
   519	    """
   520	    try:
   521	        return "j:" + json.dumps(v, sort_keys=True, ensure_ascii=False,
   522	                                 separators=(",", ":"), allow_nan=False)
   523	    except (TypeError, ValueError):
   524	        return f"r:{type(v).__name__}:{v!r}"
   525	
   526	
   527	_norm_board = lambda v: v if v is not None else ""       # 不强转类型: 按原始 JSON 值比
   528	_norm_gn = lambda v: v                                    # 不舍入: receipt 存的是原值
   529	
   530	
   531	def _facts_of_row(_o):
   532	    """从**账本行**构造完整六项事实（dup 之外的所有站点共用）。"""
   533	    _pl = _o.get("payload") or {}
   534	    return {
   535	        "scored_at": (str(_pl.get("scored_at") or _pl.get("review_time") or ""), _ok_str),
   536	        "attempt_count": (_pl.get("attempt_count"), _ok_att),
   537	        # ⛔ round-13 HIGH: **消费侧不得单方面改值**。此前这里 `round(..., 2)` 而
   538	        # receipt 存的是原值 ⇒ 合法的 `grade_norm=0.752`(validator rc=0) 与 receipt
   539	        # 的 0.752 比出 `0.752 != 期望 0.75`, **两阶段永久不收敛**。
   540	        # 要强制两位小数就得同时改 schema + validator + 所有生产者, 不能只在比较侧 round。
   541	        "grade_norm": (_norm_gn(_pl.get("grade_norm")), _ok_gn),
   542	        "abandoned": (_o.get("event_type") == "answer_abandoned", _ok_bool),
   543	        # ⛔ 同上: `str()` 强转 + string-only 校验会拒掉 writer **自己产出**的
   544	        # validator-valid 状态(实测 `exam_board=123` 首跑 rc=0、账本与 receipt 都存
   545	        # 整数 123, 紧接着同输入重跑 rc=1「类型非法」)。按原始 JSON 值比较;
   546	        # 默认值与 receipt 写侧逐字同款(`.get("exam_board", "")`), 否则缺字段时两边错位。
   547	        "exam_board": (_norm_board(_pl.get("exam_board", "")), _ok_board),
   548	    }
