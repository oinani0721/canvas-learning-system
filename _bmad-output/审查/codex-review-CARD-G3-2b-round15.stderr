  3975	def test_round12_high2_adopted_time_in_crash_window(vault):
  3976	    """HIGH②：append 后崩溃、frontmatter 尚无 receipt 时，采用时刻仍必须可证。
  3977	
  3978	    ⛔ 实测漏算链：把 durable 的 `effective_at` 与 `payload.review_time` **同步**改到
  3979	    12-01（`scored_at` 保持 08-01）⇒ 旧实现 writer rc=0、validator 全程 rc=0，
  3980	    而水位线被恢复成 12-01 —— 此后所有早于 12 月的真实复习都被当成「已过水位线」而漏算。
  4185	    LED.unlink(missing_ok=True)
  4186	    SUB = "2026-08-01T10:00:00.731Z"
  4187	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=SUB, review_time=SUB)).returncode == 0
  4188	    row = list(_ledger_lines(vault))[0]["payload"]
  4189	    assert row["review_time"] != row["scored_at"], "本例必须真的产生「两者不等」的合法行"
  4190	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 崩溃窗
  4191	    r = _run_writer_settled(vault, _payload(event_id="板A#q1", ts=SUB, review_time=SUB))
  4192	    assert r.returncode == 0, f"⛔ 字面比较会把合法的小数秒输入永久拒掉: {r.stderr[:300]}"
  4193	
  4194	    # ② W 非空的崩溃窗内篡改必须被拒
  4195	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4196	    LED.unlink(missing_ok=True)
  4197	    assert _run_writer_settled(vault, _payload(event_id="E0#q1", ts=TS1, review_time=TS1)).returncode == 0
  4198	    node_after_e0 = (vault / NODE_REL).read_text(encoding="utf-8")
  4199	    assert (
  4200	        _run_writer_settled(
  4201	            vault, _payload(event_id="E1#q1", ts="2026-08-01T11:00:00Z", review_time="2026-08-01T11:00:00Z")
  4202	        ).returncode
  4203	        == 0
  4204	    )
  4205	    rows = list(_ledger_lines(vault))
  4206	    rows[-1]["effective_at"] = "2026-12-01T10:00:00Z"
  4207	    rows[-1]["payload"]["review_time"] = "2026-12-01T10:00:00Z"
  4208	    LED.write_text("\n".join(json.dumps(x, ensure_ascii=False) for x in rows) + "\n", encoding="utf-8")
  4209	    (vault / NODE_REL).write_text(node_after_e0, encoding="utf-8")  # 回到只应用了 E0
  4210	    assert _run_validator(vault).returncode == 0, "被篡改的行本身仍合规"
  4211	    r2 = _run_writer_settled(
  4212	        vault, _payload(event_id="E1#q1", ts="2026-08-01T11:00:00Z", review_time="2026-08-01T11:00:00Z")
  4213	    )
  4214	    assert r2.returncode != 0, "W 非空的崩溃窗同样不得放行篡改"
  4215	    assert not (_fm_fields(vault).get("fsrs_last_review") or "").startswith("2026-12"), "水位线不得被恢复成篡改值"
