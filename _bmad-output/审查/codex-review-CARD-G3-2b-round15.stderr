  4414	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4415	    LED.unlink(missing_ok=True)
  4416	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
