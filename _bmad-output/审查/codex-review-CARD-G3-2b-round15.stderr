   983	# ── G3-2 bridge 调用封装。exit 2 = 输入缺陷 (naive/越界) → fail-closed;
   984	# 其余失败 (exit 3 / 坏输出) = fsrs 环境不可用 → 调用方走 degraded 裁决②。
   985	def _bridge(fm_text, gn, ab, ts, rating=None):
   986	    payload_in = {"fm": fm_text, "grade_norm": gn, "abandoned": ab, "ts": ts}
   987	    if rating is not None:
   988	        payload_in["rating"] = rating
   989	    try:
   990	        _r = subprocess.run(
   991	            ["python3", os.path.join(VAULT, ".claude", "scripts", "fsrs_bridge.py")],
   992	            input=json.dumps(payload_in), capture_output=True, text=True, timeout=30)
   993	    except Exception as _e:
   994	        return None, str(_e)
   995	    try:
   996	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   997	    except ValueError:
   998	        _out = {}
   999	    if _r.returncode == 2:
  1000	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
  1001	    if _r.returncode == 0 and _out.get("fm_block"):
  1002	        return _out, None
  1003	    _err = _out.get("error") or _r.stdout[:120] or _r.stderr[:120] or "fsrs-bridge-empty-output"
  1004	    return None, _err
