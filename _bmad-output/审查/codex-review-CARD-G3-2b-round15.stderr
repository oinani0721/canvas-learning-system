  4345	def test_round14_missing_scored_at_is_fail_closed(vault):
  4346	    """消费 `review/1` 行缺 `scored_at` 一律 fail-closed。
  4347	
  4348	    ⛔ 这**反转了早先轮次的决定**（原门断言「存量行必须豁免，否则旧账本全不可用」）。
  4349	    反转依据是实测别名链：E0@10:00 应用后，E1 原始也是 10:00 但 A3 采用 10:00:01；
  4350	    删掉 E1 的 scored_at 并回滚节点（validator rc=0），再以同 ID、原始时刻
  4351	    **10:00:01** 重跑 ⇒ 旧实现 rc=0、账本仍 2 行、attempt=2，**新评分事实静默不入账**。
  4352	    ⚠️ 代价如实记：pre-round-8 的旧账本必须先人工补 `scored_at`。
  4353	    静默丢一次评分 vs 一次性迁移，取后者 —— 这是产品取舍，已登记为裁决点。
  4354	    """
  4355	    LED = vault / "learning_events.jsonl"
  4356	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4357	    LED.unlink(missing_ok=True)
  4358	    row = _review_row()
  4359	    row["payload"].pop("scored_at", None)
  4360	    _write_ledger(vault, row)
  4361	    assert _run_validator(vault).returncode == 0, "存量行本身合规（正是它难抓的原因）"
  4362	    face = _write_face(vault)
  4363	    r = _run_writer(vault, _payload(event_id="板B#q1", ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z"))
  4364	    assert r.returncode != 0, "缺 scored_at 必须停"
  4365	    assert "缺 payload.scored_at" in r.stderr, r.stderr[:250]
  4366	    assert '"scored_at"' in r.stderr, "必须给出可执行的补法"
  4367	    assert _write_face(vault) == face, "零写"
