   264	def _pending_row(**over):
   265	    row = {
   266	        "event_id": "quiz:板A#q1",
   267	        "event_version": 1,
   268	        "event_type": "answer_scored",
   269	        "node_id": "测试节点",
   270	        "recorded_at": TS1,
   271	        "effective_at": TS1,
   272	        "payload": {
   273	            "schema_ext": "review/1",
   274	            "vault_id": "canvas_vault_测试",
   275	            "concept_id": "测试节点",
   276	            "rating": 3,
   277	            "grade_norm": 0.75,
   278	            "review_time": TS1,
   279	            # ⚠️ round-14: 消费侧对 `review/1` 行缺 `scored_at` 已改 fail-closed
   280	            # （BLOCKER②：回落 review_time 会把两个不同原始时刻的评分别名成同一次）。
   281	            # 写点自己产出的行一直都带；构造**存量行**的反例自己 pop 掉它。
   282	            "scored_at": TS1,
   283	            "fsrs_library_version": "degraded:historic-run",
   284	            "fsrs_params_hash": "degraded:historic-run",
   285	            "exam_board": "检验白板/板A.md",
   286	            "attempt_count": 1,
   287	        },
   288	    }
   289	    row["payload"].update(over)
   290	    return row
