    99	)
   100	
   101	#: 复习域扩展标记 (schema 文档 §六): 含此标记的行强制扩展键
   102	REVIEW_EXT_MARKER = "review/1"
   103	#: 降级写点的合法哨兵前缀 (fsrs 库不可用时的诚实口径, §六)
   104	DEGRADED_PREFIX = "degraded:"
   105	
   106	
   107	class _NonStandardJSON(ValueError):
   108	    """NaN/Infinity/-Infinity 或重复键 — 非 RFC 8259 严格 JSON。"""
   109	
   110	
   111	def _reject_constant(name: str) -> None:
   112	    raise _NonStandardJSON(f"非标准 JSON 常量 {name} (RFC 8259 禁止, 跨语言读方会炸)")
   113	
   114	
   115	def _reject_dup_keys(pairs: list[tuple[str, object]]) -> dict:
   116	    seen: set[str] = set()
   117	    for key, _ in pairs:
   118	        if key in seen:
   119	            raise _NonStandardJSON(f"对象内重复键 {key!r} (json.loads 静默取后者, 审计不容许歧义)")
   120	        seen.add(key)
   121	    return dict(pairs)
   122	
   123	
   124	def _strict_loads(line: str) -> object:
   125	    """严格 JSON 解析: 拒 NaN/Infinity 与重复键 (真实写点 json.dumps(dict)
   126	    不可能产出两者, 合法数据零误报)。"""
   127	    return json.loads(line, parse_constant=_reject_constant, object_pairs_hook=_reject_dup_keys)
   128	
   129	
   130	#: §三 冻结受理语法的正词法 (round-2: fromisoformat 另收 week-date / 省略分钟 /
   131	#: '+00' / 逗号小数 / offset 秒; round-3: offset 分钟须 00-59, 原 \d{2} 收了 +00:60)
   132	_TS_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}(:\d{2}(\.\d+)?)?(Z|[+-]\d{2}:[0-5]\d)$")
   133	#: 小数秒段 — review/1 事件禁用 (round-3 BLOCKER: W 只有整秒精度, 见 §6.2 A5)
   134	_SUBSECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}\.\d+")
   135	#: review/1 的 review_time 完整形态: 必须含秒段且无小数秒 (round-4 HIGH#1 —
   136	#: 省略秒的 '10:00+00:00' 不是任何写点会产出的形态, 与 W 的整秒口径对不齐)
   137	_WHOLE_SECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}(Z|[+-]\d{2}:[0-5]\d)$")
   138	
   139	
   140	def _parse_ts(value: object, upper_bound: Optional[datetime] = None) -> tuple[bool, str]:
   141	    """扩展格式 ISO-8601 datetime 且 timezone-aware → (True, ''); 否则 (False, 原因)。
   142	
   143	    受理语法 (§三, 白名单正则): YYYY-MM-DD[Tt ]HH:MM[:SS[.f+]](Z|±HH:[0-5]M)。
   144	    先过正则再 fromisoformat 验语义 (月/日/时分秒取值合法)。
   145	    """
   146	    if not isinstance(value, str) or not value:
   147	        return False, "必须为非空字符串"
   148	    if not _TS_RE.match(value):
   149	        return False, f"不符 §三 受理语法 YYYY-MM-DD[T ]HH:MM[:SS[.f]](Z|±HH:MM): {value!r}"
   150	    text = value[:-1] + "+00:00" if value.endswith("Z") else value
   151	    try:
   152	        parsed = datetime.fromisoformat(text)
   153	    except ValueError:
   154	        return False, f"非法日期时间取值: {value!r}"
   155	    if parsed.tzinfo is None:
   156	        return False, f"缺 timezone (必须 aware): {value!r}"
   157	    try:
   158	        # round-5 MEDIUM: UTC 归一化会越界的极端日期 (如 0001-01-01+08:00)
   159	        # 在 bridge 的 astimezone(UTC) 处会抛 OverflowError — 提前拦
   160	        normalized = parsed.astimezone(timezone.utc)
   161	    except (OverflowError, OSError, ValueError):
   162	        return False, f"UTC 归一化越界 (下游 astimezone 会溢出): {value!r}"
   163	    # round-11 MEDIUM: 原用 `is` 判身份, 传值相等但新建的 datetime 会错误接受端点
   164	    bound_exclusive = upper_bound is not None and upper_bound == REVIEW_INPUT_MAX
   165	    if (normalized >= REVIEW_INPUT_MAX) if bound_exclusive else (normalized > (upper_bound or TIMESTAMP_MAX)):
   166	        # A7 (round-6 MEDIUM, round-7 分档): review 输入用更保守的
   167	        # REVIEW_INPUT_MAX (调度还要叠加 interval + A3 的 +1s);
   168	        # 一般时间戳只拦 UTC 归一化本身会溢出的极端值
   169	        bound = upper_bound or TIMESTAMP_MAX
   170	        relation = "须严格小于" if bound_exclusive else "不得超过"
   171	        return False, f"A7 时间域: {relation} {bound.date()} : {value!r}"
   172	    return True, ""
   173	
   174	
   175	#: A7 上界分两档 (round-7 MEDIUM: 原实现把一个上界通用到所有时间字段,
   176	#: 导致合法 review_time=9000 产出的 due=9000-01-09 反被判 degraded)
   177	#: ① review 域上界 — 调度会在其上叠加 interval, A3 还要 +1s。
   178	#: ⚠️ round-9 闭包修正: `review_time` 与 `fsrs_last_review`(W) **同域同界且
   179	#: 均须严格小于**该值 —— 否则合法的 review_time=9000 写出 W=9000 后,
   180	#: 分类器立刻判 degraded (合法事件确定性制造残缺卡)。
   181	REVIEW_INPUT_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   182	#: ② 一般时间戳上界 (recorded_at/effective_at/fsrs_due 等) — 只拦 UTC
   183	#: 归一化本身会溢出的极端值, 不施加 review 输入的保守上界
   184	TIMESTAMP_MAX = datetime(9500, 1, 1, tzinfo=timezone.utc)
   185	#: 可调度数值域 (§6.2 三态)。
   186	#: ⚠️ round-7: stability **无 36500 上界** — FSRS 封顶的是 interval 不是
   187	#: stability (实测连续 7 次 Easy 后 S=68949 > 36500, 原规则会误报合法卡)。
   188	#: ⚠️ round-8: 但"任意有限正数"又过宽 — S=1.797e308 判 normal 而真实
   189	#: bridge 抛 OverflowError(float infinity to integer)。
   190	#: 取 1e9 天(约 274 万年)作**语义合理性上界**, 方向 fail-closed:
   191	#:   - 技术可执行边界更高(实测 1e100 仍可执行, 1.797e308 才溢出);
   192	#:   - 但真实语义远低于此(Easy 链实测 7 万量级, maximum_interval 封顶
   193	#:     36500 天), 超过 1e9 天必是数据损坏;
   194	#:   - 因此 1e9~1e100 区间**虽技术可执行仍判 degraded** — 有意的保守偏差
   195	#:     (停下来要人工确认), 不是误判。
   196	STABILITY_MAX = 1e9
   197	DIFFICULTY_RANGE = (1.0, 10.0)
   198	#: 纯整数词法 (round-7: float() 判整数会让 "1.0" 通过, 而 bridge 的
   199	#: int("1.0") 实测抛 ValueError)
   200	_INT_LEXEME_RE = re.compile(r"^[+-]?\d+$")
   201	
   202	
   203	def _finite_number(value: object) -> Optional[float]:
   204	    """有限实数 (排除 bool / NaN / ±Inf / 不可解析) → float; 否则 None。"""
   205	    if isinstance(value, bool) or value is None:
   206	        return None
   207	    try:
   208	        if isinstance(value, (int, float)):
   209	            # round-9 MEDIUM: float(10**309) 抛 OverflowError — 须 fail-closed
   210	            number = float(value)
   211	        elif isinstance(value, str) and value.strip():
   212	            number = float(value)
   213	        else:
   214	            return None
   215	    except (ValueError, OverflowError):
   216	        return None
   217	    return number if math.isfinite(number) else None
   218	
   219	
   220	def _int_lexeme(value: object) -> Optional[int]:
   221	    """纯整数 (int 本身, 或 ^[+-]?\\d+$ 的字符串) → int; 否则 None。
   222	
   223	    round-7: 用 float() 判整数会让 `fsrs_state: 1.0` 通过, 而真实 bridge
   224	    的 `int(fields.get("fsrs_state", 1))` 对 "1.0" 抛 ValueError。
   225	    """
   226	    if isinstance(value, bool):
   227	        return None
   228	    if isinstance(value, int):
   229	        return value
   230	    if isinstance(value, str) and _INT_LEXEME_RE.match(value.strip()):
   231	        try:
   232	            return int(value.strip())
   233	        except ValueError:
   234	            # round-8 MEDIUM: 5000 位纯整数触发 stdlib int_max_str_digits 限额
   235	            return None
   236	    return None
   237	
   238	
   239	def classify_card_state(fields: dict) -> tuple[str, str]:
   240	    """节点 frontmatter 的 fsrs_* 字段 → ("new"|"normal"|"degraded", reason)。
   241	
   242	    §6.2 水位线三态的**可执行实现** (round-6 HIGH#1): G3-2/G3-3 直接复用本
   243	    函数, 避免"文档一套实现一套"。按 state 校验 canonical 形状与可调度域 —
   244	    round-6 四反例 (state=3 缺 step / state=2 带 step / state=1 且 S=D=0 /
   245	    S=D=1e308) 在真实 review() 上分别抛 AssertionError、写回非 canonical
   246	    tuple、ZeroDivisionError、产生 NaN 路径。
   247	    """
   248	    present = {k: v for k, v in fields.items() if k.startswith("fsrs_")}
   249	    if not present:
   250	        return "new", "无任何 fsrs_* 字段 = 真新卡 (W = -inf, 全部事件 pending)"
   251	
   252	    # W(fsrs_last_review) 是"上一次 review 的时刻", 与 review_time 同域:
   253	    # 必须**严格小于** review 输入上界, 否则无任何合法后继事件可写
   254	    # (round-8 HIGH#2: W=9400 曾判 normal, 但后继须 > W 且 <= 9000 ⇒ 空集;
   255	    #  W 恰为上界时 A3 的 W+1s 也立即越界)。fsrs_due 是调度产物, 用更宽的一般上界。
   256	    for key, bound in (("fsrs_last_review", REVIEW_INPUT_MAX), ("fsrs_due", TIMESTAMP_MAX)):
   257	        value = present.get(key)
   258	        if not isinstance(value, str) or not value.strip():
   259	            return "degraded", f"缺 {key} 或非字符串 — 无法证明 state 与水位线同源"
   260	        ok, why = _parse_ts(value.strip(), upper_bound=bound)
   261	        if not ok:
   262	            return "degraded", f"{key} 不可解析: {why}"
   263	        if key == "fsrs_last_review":
   264	            # round-9 MEDIUM: W 与 review_time 同为 canonical 秒精度
   265	            if _SUBSECOND_RE.match(value.strip()):
   266	                return "degraded", (f"fsrs_last_review {value!r} 含小数秒 — 与 §6.2 A5 的整秒口径不一致")
   267	
   268	    raw_state = present.get("fsrs_state")
   269	    state = _int_lexeme(raw_state)
   270	    if state is None or state not in (1, 2, 3):
   271	        return "degraded", (
   272	            f"fsrs_state 须为整数 1/2/3 (纯整数词法), 实为 {raw_state!r} "
   273	            "— '1.0' 这类写法 bridge 的 int() 会抛 ValueError; 0 属 legacy 迁移分支"
   274	        )
   275	
   276	    step = present.get("fsrs_step")
   277	    stability = _finite_number(present.get("fsrs_stability"))
   278	    difficulty = _finite_number(present.get("fsrs_difficulty"))
   279	    step_number = _int_lexeme(step)
   280	    has_step = step is not None and str(step).strip() != ""
   281	    step_ok = step_number is not None and step_number >= 0
   282	
   283	    def _domain_ok() -> Optional[str]:
   284	        if stability is None or difficulty is None:
   285	            return "stability/difficulty 缺失或非有限数"
   286	        if stability <= 0:
   287	            return f"stability {stability} 须为正数 (0 会让调度器 ZeroDivisionError)"
   288	        if stability > STABILITY_MAX:
   289	            return (
   290	                f"stability {stability} 超出语义合理性上界 {STABILITY_MAX:g} 天 "
   291	                "(fail-closed: 该量级必是数据损坏, 停下来要人工确认; "
   292	                "技术可执行边界更高但不作判据)"
   293	            )
   294	        if not DIFFICULTY_RANGE[0] <= difficulty <= DIFFICULTY_RANGE[1]:
   295	            return f"difficulty {difficulty} 越出 FSRS 定义域 {DIFFICULTY_RANGE}"
   296	        return None
   297	
   298	    if state == 1:  # Learning: step 必需; S/D 要么同缺要么同在域内
   299	        if not has_step or not step_ok:
   300	            return "degraded", "state=1(Learning) 须带非负整数 fsrs_step"
   301	        both_absent = present.get("fsrs_stability") in (None, "") and present.get("fsrs_difficulty") in (None, "")
   302	        if both_absent:
   303	            return "normal", "Learning 首步 (stability/difficulty 未初始化)"
   304	        problem = _domain_ok()
   305	        if problem:
   306	            return "degraded", f"state=1 的 {problem} (S=D=0 会让调度器 ZeroDivisionError)"
   307	        return "normal", "Learning 且 S/D 在可调度域内"
   308	
   309	    if state == 2:  # Review: 禁 step (非 canonical); S/D 必需且在域内
   310	        if has_step:
   311	            return "degraded", f"state=2(Review) 不得带 fsrs_step, 实为 {step!r} (非 canonical tuple)"
   312	        problem = _domain_ok()
   313	        if problem:
   314	            return "degraded", f"state=2 的 {problem}"
   315	        return "normal", "Review 且 S/D 在可调度域内"
   316	
   317	    # state == 3 Relearning: step 与 S/D 都必需
   318	    if not has_step or not step_ok:
   319	        return "degraded", "state=3(Relearning) 须带非负整数 fsrs_step (缺失时真实 review() 抛 AssertionError)"
   320	    problem = _domain_ok()
   321	    if problem:
   322	        return "degraded", f"state=3 的 {problem}"
   323	    return "normal", "Relearning 且 step 与 S/D 齐备"
   324	
