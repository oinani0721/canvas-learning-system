   934	def _apply_mastery(fm_text, biz_ts, gn=None):
   935	    """衰减 Beta 后验 (批次2' A1, MEM-FLYWHEEL-2026-07-22): Beta(a,b)+γ=0.9
   936	    打折 + 闲置折旧 (终审 A2)。返回 (old, A, B, new)。"""
   937	    old = None
   938	    for key in ("mastery_score", "mastery", "mastery_level"):
   939	        mo = re.search(rf'^{key}:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   940	        if mo:
   941	            old = float(mo.group(1)); break
   942	    ma = re.search(r'^mastery_a:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   943	    mb = re.search(r'^mastery_b:\s*"?([0-9]*\.?[0-9]+)"?\s*$', fm_text, re.M)
   944	    if ma and mb:
   945	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   946	    elif old is not None:
   947	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   948	    else:
