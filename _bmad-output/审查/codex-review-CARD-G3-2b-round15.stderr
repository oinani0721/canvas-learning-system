   105	
   106	
   107	class _NonStandardJSON(ValueError):
   108	    """NaN/Infinity/-Infinity 或重复键 — 非 RFC 8259 严格 JSON。"""
   109	
   110	
   111	def _reject_constant(name: str) -> None:
   112	    raise _NonStandardJSON(f"非标准 JSON 常量 {name} (RFC 8259 禁止, 跨语言读方会炸)")
   113	
   114	
   115	def _reject_dup_keys(pairs: list[tuple[str, object]]) -> dict:
   116	    seen: set[str] = set()
   117	    for key, _ in pairs:
   118	        if key in seen:
   119	            raise _NonStandardJSON(f"对象内重复键 {key!r} (json.loads 静默取后者, 审计不容许歧义)")
   120	        seen.add(key)
   121	    return dict(pairs)
   122	
   123	
   124	def _strict_loads(line: str) -> object:
   125	    """严格 JSON 解析: 拒 NaN/Infinity 与重复键 (真实写点 json.dumps(dict)
   126	    不可能产出两者, 合法数据零误报)。"""
   127	    return json.loads(line, parse_constant=_reject_constant, object_pairs_hook=_reject_dup_keys)
   128	
   129	
   130	#: §三 冻结受理语法的正词法 (round-2: fromisoformat 另收 week-date / 省略分钟 /
   131	#: '+00' / 逗号小数 / offset 秒; round-3: offset 分钟须 00-59, 原 \d{2} 收了 +00:60)
   132	_TS_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}(:\d{2}(\.\d+)?)?(Z|[+-]\d{2}:[0-5]\d)$")
   133	#: 小数秒段 — review/1 事件禁用 (round-3 BLOCKER: W 只有整秒精度, 见 §6.2 A5)
   134	_SUBSECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}\.\d+")
   135	#: review/1 的 review_time 完整形态: 必须含秒段且无小数秒 (round-4 HIGH#1 —
   136	#: 省略秒的 '10:00+00:00' 不是任何写点会产出的形态, 与 W 的整秒口径对不齐)
   137	_WHOLE_SECOND_RE = re.compile(r"^\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}(Z|[+-]\d{2}:[0-5]\d)$")
   138	
   139	
   140	def _parse_ts(value: object, upper_bound: Optional[datetime] = None) -> tuple[bool, str]:
   141	    """扩展格式 ISO-8601 datetime 且 timezone-aware → (True, ''); 否则 (False, 原因)。
   142	
   143	    受理语法 (§三, 白名单正则): YYYY-MM-DD[Tt ]HH:MM[:SS[.f+]](Z|±HH:[0-5]M)。
   144	    先过正则再 fromisoformat 验语义 (月/日/时分秒取值合法)。
   145	    """
  1205	    try:
  1206	        return datetime.fromisoformat(text)
  1207	    except ValueError:
  1208	        return None
  1209	
  1210	
  1211	#: 正常 (非降级) 形状: 版本 = PEP 440 数字点版; hash = 64 hex (sha256)
  1212	_VERSION_RE = re.compile(r"^\d+(\.\d+)*$")
  1213	_HASH_RE = re.compile(r"^[0-9a-f]{64}$")
  1214	
  1215	#: review/1 扩展只许挂在这两类复习事件上 (round-3 HIGH: 曾可挂 session_archived)
  1216	REVIEW_EVENT_TYPES = frozenset({"answer_scored", "answer_abandoned"})
  1217	
  1218	#: §6.1 扩展必填键 — 出现其中任一即视为"意图写扩展行", 缺 marker 判违规
