   420	# ⛔ F1 单独不能证明 FSRS 已推进 (degraded 落账写过 calibration 但没写 W —
   421	# Codex round-2 BLOCKER): 「已应用」的机械判据是 W >= durable.review_time,
   422	# 分诊在下方主流程里做, 这里只放解析函数。
   423	# ⚠️ 定义位置: 本函数必须排在**所有**调用点之前 —— 写点是扁平脚本, `≤W` 全账
   424	# 扫描(round-12 起也走 resolver)在文件中段就执行, 而 `_receipt_of` 原先定义在
   425	# 它后面 ⇒ NameError。移到 resolver 全家之前。
   426	def _receipt_of(fm_text, ev_id):
   427	    """从 calibration_log 取出该 event_id 的条目 (结构化读, 与 F1 同源)。"""
   428	    try:
   429	        import yaml  # receipt 读取
   430	        _m = re.match(r"^---\n(.*?)\n---", fm_text, re.S)
   431	        _doc = yaml.safe_load(_m.group(1) if _m else fm_text)
   432	        if isinstance(_doc, dict) and isinstance(_doc.get("calibration_log"), list):
   433	            for _e in _doc["calibration_log"]:
   434	                if isinstance(_e, dict) and str(_e.get("event_id", "")) == ev_id:
   435	                    return _e
   436	    except Exception:
   437	        pass
   438	    return None
