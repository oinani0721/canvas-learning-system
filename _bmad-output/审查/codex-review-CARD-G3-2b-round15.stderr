   638	    if facts:
   639	        # ⛔ 键集冻结 (round-12): 调用方**不能**传部分清单。传了就是编程错误 ——
   640	        # 四个站点曾各传 0/5/0/3 项, 于是同一份 receipt 在不同分支得到不同结论。
   641	        if set(facts) != set(_FACT_KEYS):
   642	            raise SystemExit(
   643	                f"[quiz-answer] 内部错误: receipt 事实清单不完整 "
   644	                f"(给了 {sorted(facts)}, 冻结键集是 {sorted(_FACT_KEYS)}) — "
   645	                f"缺项比较等于放行, fail-closed 拒写"
   646	            )
   647	        # ⛔ round-14 BLOCKER③: 事实比较必须**类型敏感**且区分「键缺失」与「显式 null」。
   648	        # Python 的 `==` 把 `1 == True`、`0 == False` 判为相等 ⇒ 实测
   649	        # `exam_board={"k":1}` 与 `{"k":true}` 被当成同一次评分(rc=0 幂等 no-op、
   650	        # 账本 0 字节、attempt 停在 1), 另一次评分静默消失。
   651	        # 而 `.get(_k)` 把「没这个键」和「值是 null」混成同一个 None。
   652	        # ⚠️ 这是我 round-13 修误拒时**放松**出来的洞: 把 `_ok_board` 从 string-only
   653	        # 放宽后, 值域变宽而比较语义没跟上。修法不是再收紧类型(那会重新误拒),
   654	        # 是换掉**比较语义** —— canonical JSON 逐字比, 严/松不再是一个可调旋钮。
   655	        _mis = []
   656	        for _k, (_want, _ok) in facts.items():
   657	            _got = _rcpt.get(_k, _FACT_MISSING)
   658	            if _got is _FACT_MISSING:
   659	                _mis.append(f"receipt 缺 {_k}")
   660	            elif not _ok(_got):
   661	                _mis.append(f"receipt 的 {_k} 类型非法 ({_got!r})")
   662	            elif _canon_fact(_got) != _canon_fact(_want):
   663	                _mis.append(f"{_k} {_got!r} != 期望 {_want!r}")
   664	        if _mis:
   665	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 与评分事实不一致 ({'; '.join(_mis)}) — 同一个 event_id 承载了两次不同的评分, fail-closed 拒写 — 请人工核对后修正 event_id 或账本")
   666	
   667	    if row is not None:
   668	        # ⛔ 三方同瞬间 (round-11 BLOCKER): ledger 的 effective_at / payload
   669	        # 的 review_time / receipt 的 ts 记的是同一个「调度采用时刻」。
   670	        # 只比 scored_at 时, 改掉采用时刻就能让同一次评分二次推进 FSRS。
   671	        _rts = _rcpt.get("ts")
   672	        if not isinstance(_rts, str) or not _rts or _rts != _rts.strip():
   673	            raise SystemExit(f"[quiz-answer] {ev_id} 的 receipt 缺可用的 ts (采用时刻) 或首尾含空白 ({_rts!r}) — 无法绑定账本的调度时刻; ⛔ 不做 strip(那会把两个不同的字面撞成一个), fail-closed 拒写")
