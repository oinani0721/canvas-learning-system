import json, os, re, subprocess, sys
from pathlib import Path
import yaml
sys.path.insert(0, str(Path('backend/scripts').resolve()))
import g32b_r1r7_counterexamples as ce
ce.CE_ROOT = Path('/tmp/codex-g32-r13.lvZ5Ww/cases')

def val(v):
    return subprocess.run([sys.executable, str(ce.VALIDATOR), str(v/'learning_events.jsonl')], cwd=str(ce.WT), capture_output=True, text=True)
def receipts(v):
    txt=(v/ce.NODE_REL).read_text(encoding='utf-8')
    fm=txt.split('---\\n',2)[1]
    d=yaml.safe_load(fm)
    return d.get('calibration_log',[]) if isinstance(d,dict) else []
def brief(r):
    return {'rc':r.returncode,'out':(r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ''),'err':(r.stderr.strip().splitlines()[-1] if r.stderr.strip() else '')}
def emit(name,obj):
    print(name+'='+json.dumps(obj,ensure_ascii=False,sort_keys=True,default=str))

# C1: marker stripped but scored_at remains.
v=ce.new_vault('marker_scored_at')
row=ce._pending_row()
row['event_id']='quiz:E1#q1'
for k in ('schema_ext','vault_id','concept_id','rating','review_time','fsrs_library_version','fsrs_params_hash'):
    row['payload'].pop(k,None)
ce.write_rows(v,row)
vr=val(v)
r=ce.run_settled(v,event_id='E2#q1',ts='2026-08-02T10:00:00Z',review_time='2026-08-02T10:00:00Z',exam_board='检验白板/E2.md')
emit('marker_scored_at',{'validator_rc':vr.returncode,'writer':brief(r),'attempts':[x['payload'].get('attempt_count') for x in ce.rows(v)],'W':ce.fsrs_fields(v).get('fsrs_last_review'),'receipts':[x.get('event_id') for x in receipts(v)]})

# C2: degraded E1 ledger lost, E2 raises W, rerun E1 falsely no-ops.
v=ce.new_vault('f1_false_coverage')
os.environ['FSRS_BRIDGE_REEXEC']='1'
r1=ce.run(v,event_id='E1#q1',grade_norm=.752,ts=ce.TS1,review_time=ce.TS1,exam_board='检验白板/E1.md')
os.environ.pop('FSRS_BRIDGE_REEXEC',None)
(v/'learning_events.jsonl').write_text('',encoding='utf-8')
r2=ce.run_settled(v,event_id='E2#q1',grade_norm=.75,ts='2026-08-02T10:00:00Z',review_time='2026-08-02T10:00:00Z',exam_board='检验白板/E2.md')
before=ce.fsrs_fields(v).copy()
r3=ce.run(v,event_id='E1#q1',grade_norm=.752,ts=ce.TS1,review_time=ce.TS1,exam_board='检验白板/E1.md')
after=ce.fsrs_fields(v).copy()
vc=ce.new_vault('f1_control')
ce.run_settled(vc,event_id='E1#q1',grade_norm=.752,ts=ce.TS1,review_time=ce.TS1,exam_board='检验白板/E1.md')
ce.run_settled(vc,event_id='E2#q1',grade_norm=.75,ts='2026-08-02T10:00:00Z',review_time='2026-08-02T10:00:00Z',exam_board='检验白板/E2.md')
emit('f1_false_coverage',{'degraded':brief(r1),'E2':brief(r2),'E1_retry':brief(r3),'unchanged':before==after,'corrupt_state':after,'control_state':ce.fsrs_fields(vc),'attempts':[x['payload'].get('attempt_count') for x in ce.rows(v)],'receipts':[x.get('event_id') for x in receipts(v)]})

# C3: int 1 versus float 1.0 are validator-equivalent numeric forms.
v=ce.new_vault('num_1')
ce.run_settled(v,event_id='N#q1',grade_norm=1.0,exam_board='检验白板/N.md')
rs=ce.rows(v); rs[0]['payload']['grade_norm']=1; ce.write_rows(v,*rs)
np=(v/ce.NODE_REL); nt=np.read_text(encoding='utf-8'); nt2=re.sub(r'"'^    grade_norm: 1(?:'"\\.0)?"'$'"', '    grade_norm: 1', nt, count=1, flags=re.M); np.write_text(nt2,encoding='utf-8')
vr=val(v); face=ce.sha(np); r=ce.run(v,event_id='N#q1',grade_norm=1.0,exam_board='检验白板/N.md')
emit('numeric_1_vs_1_0',{'validator_rc':vr.returncode,'writer':brief(r),'node_unchanged':ce.sha(np)==face,'ledger_grade':ce.rows(v)[0]['payload']['grade_norm'],'receipt_grade':receipts(v)[0].get('grade_norm')})

# C4: writer accepts board null/bool, then rejects identical retry.
for idx,board in enumerate((None,True)):
    v=ce.new_vault('board_'+str(idx))
    r1=ce.run_settled(v,event_id='B#q1',exam_board=board)
    vr=val(v); face=ce.sha(v/ce.NODE_REL); r2=ce.run(v,event_id='B#q1',exam_board=board)
    emit('board_'+repr(board),{'first':brief(r1),'validator_rc':vr.returncode,'retry':brief(r2),'node_unchanged':ce.sha(v/ce.NODE_REL)==face,'ledger_board':ce.rows(v)[0]['payload'].get('exam_board'),'receipt_board':receipts(v)[0].get('exam_board')})

# C5: external .752 current dup crash-recovery writes receipt .75 then blocks.
v=ce.new_vault('prec_752')
row=ce._pending_row(grade_norm=.752,rating=3); row['event_id']='quiz:'+ce.EID; row['payload']['exam_board']='检验白板/测试检验-2026-08-01-1000.md'; ce.write_rows(v,row)
vr=val(v); r1=ce.run(v,grade_norm=.752); rcpts=receipts(v); r2=ce.run(v,grade_norm=.752)
emit('precision_752_current_dup',{'validator_rc':vr.returncode,'first':brief(r1),'retry':brief(r2),'ledger_grade':ce.rows(v)[0]['payload']['grade_norm'],'receipt_grade':rcpts[0].get('grade_norm') if rcpts else None,'W':ce.fsrs_fields(v).get('fsrs_last_review')})

# C6: raw .499 crosses rating boundary after writer rounding.
v=ce.new_vault('prec_499')
row=ce._pending_row(grade_norm=.499,rating=2); row['event_id']='quiz:'+ce.EID; row['payload']['exam_board']='检验白板/测试检验-2026-08-01-1000.md'; ce.write_rows(v,row)
vr=val(v); face=ce.sha(v/ce.NODE_REL); r=ce.run(v,grade_norm=.499)
emit('precision_499_rating',{'validator_rc':vr.returncode,'writer':brief(r),'node_unchanged':ce.sha(v/ce.NODE_REL)==face,'durable_rating':ce.rows(v)[0]['payload']['rating'],'durable_grade':ce.rows(v)[0]['payload']['grade_norm']})

# C7: two same-time foreign pending rows: actual W diverges from durable/receipt adopted time.
v=ce.new_vault('two_pending')
a=ce._pending_row(); a['event_id']='quiz:A#q1'
b=ce._pending_row(attempt_count=2); b['event_id']='quiz:B#q1'; b['payload']['exam_board']='检验白板/B.md'
ce.write_rows(v,a,b); vr=val(v)
r=ce.run(v,event_id='C#q1',ts='2026-08-05T10:00:00Z',review_time='2026-08-05T10:00:00Z',exam_board='检验白板/C.md')
emit('two_pending_adopted',{'validator_rc':vr.returncode,'writer':brief(r),'ledger_times':[x['payload'].get('review_time') for x in ce.rows(v)],'W':ce.fsrs_fields(v).get('fsrs_last_review'),'receipt_times':[x.get('ts') for x in receipts(v)],'attempt':yaml.safe_load((v/ce.NODE_REL).read_text(encoding='utf-8').split('---\\n',2)[1]).get('attempt_count')})
