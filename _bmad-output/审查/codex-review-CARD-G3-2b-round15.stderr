   727	def _fm_has_event(fm_text, ev_id):
   728	    """F1 判定: calibration_log 里有没有这个 event_id。
   729	
   730	    ⛔ **用真正的 YAML 解析器** (Codex round-9 HIGH): 手写正则永远追不上 YAML 的
   731	    合法形态 —— 本卡已被三种合法写法各打穿一次: 尾注释 (`calibration_log: # keep`)、
   732	    inline 空列表 (`[]`)、**mapping 键顺序**(`- ts:` 在 `event_id:` 之前)。
   733	    每次都是「F1 假阴性 ⇒ 同 ID 重跑报『缺校准记录』⇒ 两阶段续跑永久停住」。
   734	    正则解析这条路已经证明走不通, 换 PyYAML 一次解决整类问题。
   735	
   736	    ⚠️ 回落分支如实声明: PyYAML 不可达时退回正则扫描 —— 它**只认** block list +
   737	    `- event_id:` 开头的条目, 上面那三种形态会重新假阴性。这不是等价实现,
   738	    是「有总比没有强」的降级, 出现即告警。
   739	    """
   740	    try:
   800	    #    永久卡死, 同一种崩溃两种命运。逐行 decode 让自愈路径对两者都可达;
   801	    # ③ 首行可能带 BOM (别的编辑器存过)。BOM 是编码标记不是内容, 整文件 decode
   802	    #    会把它留在首行里让 json.loads 失败, 于是一条**完整合法**的事件行被当
   803	    #    截断跳过、那次评分静默丢失。utf-8-sig 只剥文件开头的 BOM。
   804	    _raw_bytes = open(EV, "rb").read()
   805	    _byte_lines = _raw_bytes.split(b"\n")
   806	    # 判据是「**最后一个非空行**有没有终止 LF」, 不是「文件末尾有没有 LF」。
   807	    # 反例 (Codex round-2 线索 "R7 blank bug", 实测复现): 账本以 `坏行\n   ` 结尾
   808	    # (坏行后跟一个纯空白行、文件不以 LF 收尾) 时, 按文件末尾判会得出「无 LF ⇒
   809	    # 截断」, 可那个坏行明明**后面还跟着东西**, 它是完整落盘后损坏的。
   810	    # split 后: 该行索引 < len-1 ⟺ 它后面还有片段 ⟺ 它有终止 LF。
   811	    # ⛔ 空行与校验器同口径拒收 (Codex round-6 MEDIUM): 校验器
   812	    # (VALIDATOR:737/:1571) 判「append-only JSONL 不应出现空行」, 写点此前静默
   813	    # 忽略并保留 ⇒ 写点 rc=0 而校验器 rc=1。末尾那个由 LF 产生的空片段不算。
   814	    _blank_at = [i + 1 for i, x in enumerate(_byte_lines[:-1] if _byte_lines and not _byte_lines[-1] else _byte_lines)
   815	                 if not x.strip()]
   816	    if _blank_at:
   817	        raise SystemExit(f"[quiz-answer] 账本第 {_blank_at[:3]} 行是空行 — append-only JSONL 不应出现 (与校验器同口径), fail-closed 拒写 — 请人工删除这些空行")
   818	    # ⛔ BOM 同理: 校验器对 BOM 无特例 (即拒), 写点此前用 utf-8-sig 剥掉首行 BOM
   819	    # 静默放行 ⇒ 又一处分叉。写点恒不产出 BOM, 出现即外部写入。
   820	    if _raw_bytes.startswith(b"\xef\xbb\xbf"):
   821	        raise SystemExit("[quiz-answer] 账本以 UTF-8 BOM 开头 — 校验器对 BOM 无特例 (判整个文件不合规), 本写点恒不产出 BOM, 出现即外部写入; fail-closed 拒写 — 请人工去掉 BOM")
   822	    _last_idx = max((i for i, x in enumerate(_byte_lines) if x.strip()), default=-1)
   823	    _ends_with_lf = _last_idx >= 0 and _last_idx < len(_byte_lines) - 1
   824	    _n_lines = len([x for x in _byte_lines if x.strip()])
   825	    for _ln, _bline in enumerate((x for x in _byte_lines if x.strip()), 1):
   826	        try:
   827	            _line = _bline.decode("utf-8-sig" if _ln == 1 else "utf-8")
   828	        except UnicodeDecodeError as _ue:
   829	            if _ln == _n_lines and not _ends_with_lf:
   830	                print(f"[quiz-answer] 账本第 {_ln} 行为截断尾行 (崩溃产物: 半个多字节字符且无终止 LF) — 追加时 LF 守卫隔离, 不阻塞本次评分")
   831	                continue
   832	            raise SystemExit(f"[quiz-answer] 账本第 {_ln} 行含非 UTF-8 字节 ({_ue}), fail-closed 拒写 — 请人工修复 learning_events.jsonl")
   833	        try:
   834	            # ⛔ 不得 .strip() —— 又一次「洗值」分叉 (Codex round-5 线索):
