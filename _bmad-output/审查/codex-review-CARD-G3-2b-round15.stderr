  4218	def test_round13_id_form_only_proves_exact_hit(vault):
  4219	    """`id_form: full` 只证明 **exact 命中**；裸形态回落时它证明不了什么。
  4220	
  4221	    ⛔ 实测别名链：本地 id `K` 写出 receipt `quiz:K, id_form:full`；清空账本后提交
  4222	    本地 id `quiz:K`（完整 id 是 `quiz:quiz:K`）⇒ 裸形态回落命中那条、标记满足，
  4223	    旧实现判「已应用」幂等跳过，**第二次评分零次入账**。
  4224	    """
  4225	    LED = vault / "learning_events.jsonl"
