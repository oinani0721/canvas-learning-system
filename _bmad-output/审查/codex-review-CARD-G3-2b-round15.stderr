  3949	def test_round12_seventh_state_ledger_missing_f1_w_uncovered(vault):
  3950	    """第七个可达状态：账本行丢失（L=0）+ 校准里有它（F1=1）+ **水位线未覆盖**。
  3951	
  3952	    ⛔ 审查指出六格主体的前置都真实，但缺这一格。它可达：降级路径写了校准与
  3953	    attempt 却没推进 W，之后账本行又丢了 —— 此时「有 receipt」不能证明「已应用」。
  3954	    """
  3955	    LED = vault / "learning_events.jsonl"
  3956	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3957	    LED.unlink(missing_ok=True)
  3958	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
  3959	    node = (vault / NODE_REL).read_text(encoding="utf-8")
  3960	    assert 'id_form: "full"' in node
  3961	    # 把 W（fsrs_last_review）退回到早于本次业务时刻 ⇒ 水位线不覆盖 receipt 的 ts
  3962	    node2 = re.sub(r"^fsrs_last_review:.*$", 'fsrs_last_review: "2026-07-01T10:00:00Z"', node, count=1, flags=re.M)
  3963	    assert node2 != node, "预置必须真的把水位线退回"
  3964	    (vault / NODE_REL).write_text(node2, encoding="utf-8")
  3965	    LED.write_text("", encoding="utf-8")  # 账本行丢失
  3966	    face = _write_face(vault)
  3967	    r = _run_writer(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1))
  3968	    assert r.returncode != 0, "有 receipt 但水位线未覆盖它 ⇒ 不能judged「已完整应用」"
  3969	    assert _write_face(vault) == face, "零写"
  3970	
