  3975	def test_round12_high2_adopted_time_in_crash_window(vault):
  3976	    """HIGH②：append 后崩溃、frontmatter 尚无 receipt 时，采用时刻仍必须可证。
  3977	
  3978	    ⛔ 实测漏算链：把 durable 的 `effective_at` 与 `payload.review_time` **同步**改到
  3979	    12-01（`scored_at` 保持 08-01）⇒ 旧实现 writer rc=0、validator 全程 rc=0，
  3980	    而水位线被恢复成 12-01 —— 此后所有早于 12 月的真实复习都被当成「已过水位线」而漏算。
  3981	    三方绑定在这里帮不上忙：receipt 不存在，没有第三个瞬间可比。
  3982	
  3983	    可判别的约束来自 **A3 语义本身**：A3 只在水位线**非空**时才把采用时刻推到 W+1s，
  3984	    所以「水位线为空」⇒ 该行的 `review_time` 必等于 `scored_at`。
  3985	    """
  4280	    nd = (vault / NODE_REL).read_text(encoding="utf-8")
  4281	    nd2 = re.sub(r'(- event_id: "quiz:E1#q1"\n(?:    [^\n]*\n)*?    attempt_count: )\d+', r"\g<1>9", nd, count=1)
  4282	    assert nd2 != nd, "预置必须真的改了 receipt 序数"
