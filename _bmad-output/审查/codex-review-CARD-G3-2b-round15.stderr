   576	def _resolve_receipt(fm_text, ev_id, all_ledger_ids=(), row=None, facts=None, require_source=True):
   577	    """**唯一**的 receipt 解析 + 事实校验入口 (Codex round-11 BLOCKER/HIGH)。
   578	
   579	    ⛔ 为什么必须统一: 此前 receipt 验证散落在**六处**、严格度各不相同 ——
   580	    dup 路径比六项、F1-only 比两项、foreign replay 只看「ID 在不在」(布尔)。
   581	    于是同一份 receipt 在不同分支得到不同结论: 实测把 durable 的采用时刻改掉
   582	    (保留 scored_at 与 receipt), foreign replay 照常「恢复」E1 ⇒ **state 1→2、
   583	    stability 2.31→7.32、同一次评分被算了两遍**; 把 receipt 的 attempt 改成 999
   584	    也照样称「事实一致」。
   585	    这正是 round-10「修一半」那条教训的下一层: **抽出统一函数, 让分歧不可能存在**。
   586	
   587	    返回 (receipt, 唯一来源 id)。任何不可证的情形一律 raise SystemExit。
   588	
   589	    facts: 要逐项核对的事实字典; None 表示只解析不校验事实(仍做来源唯一性证明)。
   590	    row:   对应的账本行; 给出时额外强制「三方同瞬间」(ledger effective_at /
   591	           payload.review_time / receipt ts)。
   592	    """
   593	    _cands, _sources = _cands_and_sources(fm_text, ev_id, all_ledger_ids)
   594	    if not _cands:
   595	        return (None, None)          # 没有 receipt —— 由调用方决定这是否可接受
   596	    # ⛔ 成功条件是 `_sources == {ev_id}` —— **空集同样不可证** (round-11 BLOCKER):
   597	    # 账本缺失时来源集合为空, 上一版把它当「唯一」放行 ⇒ 实测另一个完整 id 的评分
   598	    # 被静默吞掉 (rc=0、账本 0 字节、attempt 不变)。
   599	    # ⚠️ `require_source=False` 用于**账本行本就丢失**的分支 (F1-only): 那里
   600	    # 来源集合必然为空, 强制它等于 {ev_id} 就是「要求证明一个前提上不存在的
   601	    # 东西」。⛔ 统一函数不等于所有调用点参数相同 —— 共用逻辑的同时, 每个
   602	    # 调用点要声明它能提供什么证据。
   603	    # ⛔ round-12 BLOCKER①: 账本来源丢失(集合为空)时, 历史裸形态与完整形态的 receipt
   604	    # **字节上不可区分**。此时唯一可证的凭据是条目自带的 `id_form: full` 标记 ——
   605	    # 没有它就无从证明这条 receipt 存的是完整 id, 猜一个就会让另一次评分静默消失。
   606	    if not _sources:
   607	        _probe, _hit_tok = None, None
   608	        for _tok in _cands:
   609	            _probe = _receipt_of(fm_text, _tok)
   610	            if _probe is not None:
   611	                _hit_tok = _tok
   612	                break
   613	        # ⛔ round-13 BLOCKER①: `id_form: full` 只证明「这条 receipt 存的是**某个**完整
   614	        # id」, **不证明它就是本次的完整 id**。裸形态回落命中时, 那个标记恰恰是
   615	        # **另一个事件**留下的 —— 实测别名链: 本地 id `K` 写出 receipt
   616	        # `quiz:K, id_form:full`; 清空账本后提交本地 id `quiz:K`(完整 id 是
   617	        # `quiz:quiz:K`) ⇒ 裸形态回落命中那条, 标记满足, 判「已应用」幂等跳过,
   618	        # **第二次评分零次入账**(rc=0、账本 0 字节、attempt 停在 1)。
   619	        # 正确口径: 标记只对 **exact 命中**(token == ev_id)有效; 裸形态回落在来源
   620	        # 不可证时一律停 —— 那正是「两个世界字节相同」的场景。
   621	        _exact_hit = _hit_tok == ev_id
   622	        _marked = isinstance(_probe, dict) and _probe.get("id_form") == "full"
   623	        if not (_exact_hit and _marked):
   624	            raise SystemExit(
   625	                f"[quiz-answer] 账本里找不到 {ev_id!r} 的来源行, 而校准记录里命中的是 "
   626	                f"{_hit_tok!r} — "
   627	                + (
   628	                    f"它是**历史裸形态回落**命中(不是 {ev_id!r} 本身), 此时条目上的 "
   629	                    f"`id_form` 标记只能证明它存的是**某个**完整 id, 不能证明就是本次这个; "
   630	                    f"猜一个就会让另一次评分静默消失"
   631	                    if _hit_tok is not None and not _exact_hit else
   632	                    f"该条目没有 `id_form: full` 标记, 无法区分它存的是**完整 id** 还是"
   633	                    f"**历史裸形态**(两种情形下这条记录字节完全相同, 评分事实也相同)"
   634	                )
   635	                + f", fail-closed 拒写 — 请人工统一这些 id 或给该条目补上 `id_form: full`"
   636	            )
   637	    if require_source and _sources != {ev_id}:
   638	        raise SystemExit(
   639	            f"[quiz-answer] 校准记录里命中 {ev_id!r} 的条目, 但它的来源集合是 "
   640	            f"{sorted(_sources)!r} 而非恰好 {{{ev_id!r}}} — "
   641	            f"{'账本缺失, 历史裸形态的来源无从证明' if not _sources else '完整形态与历史裸形态无法区分'}; "
   642	            f"猜一个就会让另一次评分静默不入账, fail-closed 拒写 — 请人工统一这些 id"
   643	        )
   644	    _rcpt = None
   645	    for _tok in _cands:
   646	        _rcpt = _receipt_of(fm_text, _tok)
   647	        if _rcpt is not None:
   648	            break
   649	    if not isinstance(_rcpt, dict):
   650	        raise SystemExit(f"[quiz-answer] {ev_id} 在 calibration_log 里命中却读不出条目 — receipt 不可解析, fail-closed 拒写 — 请人工核对 {NODE}")

