   954	    if mle:
   955	        try:
   956	            days_idle = max(0.0, (_aware(biz_ts) - _aware(mle.group(1))).total_seconds() / 86400.0)
   957	        except ValueError:
   958	            days_idle = 0.0  # 时间戳损坏: 不折旧, 保守按连续考察处理
   959	    a_, b_ = max(a_, 1e-4), max(b_, 1e-4)  # 手工编辑容错: a/b 被改成 0 时 effective 会拒 (Code-Review L7)
   960	    # 用 GN2 而非 GN (内部对抗审查 MEDIUM): durable payload 锁的是 round(GN,2),
