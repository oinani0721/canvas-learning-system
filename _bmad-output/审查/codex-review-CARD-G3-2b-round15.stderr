   558	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   559	    events: list[tuple] = []
   560	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   561	
   562	    def spy_fsync(fd):
   563	        try:
   564	            st = os.fstat(fd)
   565	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   566	            events.append(("fsync", kind, st.st_ino))
   567	        except OSError:
   568	            events.append(("fsync", "unknown", -1))
   569	        return real_fsync(fd)
