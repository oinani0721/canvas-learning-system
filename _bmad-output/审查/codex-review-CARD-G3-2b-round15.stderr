  4426	    assert r.returncode == 0, f"⛔ 给出原值时必须能落定: {r.stderr[:300]}"
  4427	    # 验伪：真正不同的分数仍必须拒
  4428	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  4429	    LED.unlink(missing_ok=True)
  4430	    assert _run_writer_settled(vault, _payload(event_id="板A#q1", ts=TS1, review_time=TS1)).returncode == 0
