   297	def _adopted_from(_sa, _w_inst):
   298	    """由**原始时刻**与**当时的水位线**复算唯一的 A3 采用时刻（纯函数）。
   299	
   300	    ⛔ 这是 A3 的定义本身, 不是启发式: 先 UTC 化、截整秒(bridge 侧同款), 若结果
   301	    不晚于水位线则取 `W+1s`。round-13 之前这里比的是**字面相等**, 于是带小数秒的
   302	    合法输入(`10:00:00.731Z`)被判成「采用时刻被改过」—— 采用值是算出来的, 不是抄的。
   303	    """
   304	    try:
   305	        _i = _aware(_sa)
   306	    except Exception:
   307	        return None
   308	    _i = _i.astimezone(timezone.utc).replace(microsecond=0)
   309	    if _w_inst is not None and _i <= _w_inst:
   310	        _i = _w_inst + timedelta(seconds=1)
   311	    return _i
   312	
   313	
   314	def _adopted_ok(_sa, _w_inst, _got):
   315	    """采用时刻 `_got` 是否**可解释**。
   316	
   317	    ⛔ 可证的不变量不是「等于 A3 推后的值」—— **外部写入方未必实施 A3**（validator
   318	    也不要求）。可解释的只有两个值: ①`scored_at` 截整秒后的原值（没推过）;
   319	    ②A3 从它推后的值。两者都合法, 别的都无法解释(那正是篡改的样子)。
   320	    ⚠️ round-14 我第一版只认②, 于是把「两条 pending 同一瞬间」这类**外部写入的
   321	    合法行**误拒了 —— 收紧到比审查要求更严, 又一次「加严不等于更安全」。
   322	    """
   323	    if _got is None:
   324	        return False
   325	    _pushed = _adopted_from(_sa, _w_inst)
   326	    _plain = _adopted_from(_sa, None)
   327	    return _got == _pushed or _got == _plain
