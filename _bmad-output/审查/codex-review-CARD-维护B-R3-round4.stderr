  3400	    synth = {"data_mode": "fallback_local", "counts": {"members": 1, "seeds": 1}}
  3401	    assert rs._derived_number_pool(synth) == {0, 1, 2}, "合成池漂移，判别前提失效"
  3402	
  3403	    def probs(tok: str) -> list[str]:
  3404	        out: list[str] = []
  3405	        rs._verify_prose_counts(f"## 三维审查\n\n- 本板共有{tok}个子节点。【实测】\n", synth, out)
