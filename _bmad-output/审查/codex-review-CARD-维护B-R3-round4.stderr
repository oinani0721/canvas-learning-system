  2089	def _verdicts_on_all_boards(tmp_path: Path, prose: str) -> dict:
  2090	    """同一句话追加到四份 live 真报告，返回各自的 exit code。"""
  2091	    out = {}
  2092	    for i, name in enumerate(sorted(p.name for p in LIVE_FIXTURES.glob("*.md"))):
  2093	        work = tmp_path / f"b{i}" / "outputs"
  2094	        work.mkdir(parents=True)
  2095	        for src in LIVE_FIXTURES.iterdir():
  2096	            shutil.copy2(src, work / src.name)
  2097	        rp = work / name
  2098	        rp.write_text(rp.read_text(encoding="utf-8") + f"\n- {prose}【实测】\n", encoding="utf-8")
  2099	        out[name[:12]] = run_verify(rp).returncode
  2100	    return out
