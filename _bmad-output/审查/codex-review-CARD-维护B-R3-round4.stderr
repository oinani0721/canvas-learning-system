  3350	        assert _one_problem_has(r.stdout, "无法解析", "九十八万五"), (
  3351	            f"CJK {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3352	        )
  3353	    for name, line, whole in (
  3354	        ("空格千分位", "- 本板共有980 005个子节点。【实测】", "980005"),
  3355	        ("粗体", "- 本板共有98765**4**个子节点。【实测】", "987654"),
  3356	        # ⛔ 与「前导零归一化」的交互：行级剥零会把 `1 000`(渲染=1000, SI 千分位)
  3357	        # 先剥成 `1 0` 再拼成 `10` 落进池内 ⇒ 放行。归一化必须作用在拼接后的
  3358	        # token 上（车道实测，本卡修复时自己踩出来的洞）。
  3359	        ("SI千分位+前导零", "- 本板共有1 000个子节点。【实测】", "1000"),
