  1562	def _count_token_value(token: str) -> int | None:
  1563	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1564	
  1565	    只两种情形给值:
  1566	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1567	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1568	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1569	    """
  1570	    if not token:
  1571	        return None
  1572	    if token.isascii() and token.isdigit():
  1573	        return int(token)
  1574	    return _cjk_single_to_int(token)
