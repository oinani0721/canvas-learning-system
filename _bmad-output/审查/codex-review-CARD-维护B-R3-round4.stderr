  1577	def _cjk_single_to_int(s: str) -> int | None:
  1578	    """中文数词 → int; **只认单字数词**, 其余一律 None (不猜)。
  1579	
  1580	    ⛔ 对抗审查 BLOCKER: D2 的数字原为 `[0-9]+`, 于是「本板共有九十八万个子节点」
  1581	    这类**完全虚构**的规模自陈整域免检。scan 的计数都是 ASCII 整数, 报告换个写法
  1582	    不该换来免检 —— 归一后照常比对。
  1583	
  1584	    ⛔ round-5 (Codex 定向复核 HIGH) + R3 收口: 原实现是**多位文法解析器**
  1585	    `_cjk_to_int`, 两条毛病一体:
  1586	      1. 提取正则 `[零〇一二两三四五六七八九十百千万亿]+` 与 `_CJK_NUM`/`_CJK_UNIT`
  1587	         **完全同集** ⇒ 任何非空匹配必返回某个整数, 所谓「解析失败 fail-closed」
  1588	         分支**静态不可达** (死代码冒充防线);
  1589	      2. 连续数字字不校验文法, 只反复覆盖 `digit` ⇒ 「五四」得 4、「一零」得 0,
  1590	         按**局部值**查池。而 0 恒在池内 (`abs(a-a)`), 于是
  1591	         `本板共有一零个子节点。` 这句**纯虚构**自陈实测 exit 0 放行
  1592	         (红证据 `_bmad-output/审查/evidence-maintb-r3/b-prefix-red-repro.txt`)。
  1593	
  1594	    终态口径 (R3 冻结, 不得再引入多位解析器): 值 = 单字映射, **绝对确定**才认;
  1595	    多字 / 单字量词 (十百千万亿, 不在 `_CJK_NUM`) / 集合外字符一律 None,
  1596	    由调用方按「无法验证 / 无法解析」fail-closed 处理, 不静默放行。
  1597	    代价如实记: 合法的多字中文数词计数也会被拒 —— 诊断已提示「请改用阿拉伯
  1598	    数字」, 且报告为机器渲染 (模板与合成语料无多字合法用例, 实测零误伤)。
  1599	    """
  1600	    return _CJK_NUM.get(s) if len(s) == 1 else None
