  3437	def test_domain_r6_cross_class_and_offtable_numeral_cli(tmp_path):
  3438	    """R3 round-3 行为门：跨类 / 表外数词字 / CJK 小数都不得按尾片查池。
  3439	
  3440	    四条实测反例（修前全部 exit 0）：
  3441	      · `本板共有九十八万5个子节点` —— CJK run 停在 `万`，ASCII 只取 `5`
  3442	      · `本板共有廿五个子节点` —— `廿` 表外，从 `五` 重锚按 5 查池（读者读 25）
  3443	      · `本板共有壹佰个子节点` —— 两字全表外，一个 token 都抽不出
  3444	      · `本板共有五点五个 / 5点5个` —— `点` 在量词表里，被拆成两个 5 分别碰池
  3445	      · fallback `#### 派生子女 1 000 个` —— `\\d+` 拆成碎片逐片碰池
  3446	
  3447	    **它证明什么**：D2 与 fallback、CJK 与 ASCII 走**同一条**取数规则；
  3448	    诊断类别与还原后的完整 token 出现在**同一条** problem 里；
  3449	    合法形态（含 `3点建议` 里 `点` 的正当量词用法）不被反噬。
  3450	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 仍是**封闭表**（廿卅卌 + 大写金融
  3451	    数字 + 异体），表外的其它数词写法仍可能重锚；量词表同样封闭。见 §五之三。
  3452	    """
  3453	    vault = standard_vault(tmp_path)
  3454	    scan = collect_json(vault)
  3455	    pool = _load_recap_scan()._derived_number_pool(scan)
  3456	    assert {5, 3, 16, 22} <= pool, f"放行面前提失效: {sorted(pool)}"
  3457	    report = write_report(vault, scan)
  3458	    base_text = report.read_text(encoding="utf-8")
  3459	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3460	
  3461	    def verify(anchor: str, injected: str):
  3462	        text = base_text.replace(anchor, injected, 1)
  3463	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3464	        report.write_text(text, encoding="utf-8")
  3465	        return run_verify(report)
  3466	
  3467	    def d2(line: str):
  3468	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3469	
  3470	    def fb(tok: str):
  3471	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3472	
  3473	    # 拦截面：诊断必须同时点名「无法解析」与**还原后的完整 token**
  3474	    for name, line, token in (
  3475	        ("跨类混写", "- 本板共有九十八万5个子节点。【实测】", "九十八万5"),
