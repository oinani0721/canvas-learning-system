  2171	def test_audit_number_form_bypasses_are_closed(tmp_path, prose, ids):
  2172	    """⛔ 数字/量词识别面的九条绕过，四板一致地拦下。
  2173	
  2174	    - **全角与中文数字**（BLOCKER）：原来 D2 的数字是 `[0-9]+`，于是
  2175	      「本板共有九十八万个子节点」这种**完全虚构**的规模自陈整域免检。
  2176	      scan 的计数都是 ASCII 整数，报告换个写法不该换来免检 ⇒ 归一后照常比对。
  2177	    - **表外量词**：11 字封闭表被 21 个常用量词（名/位/台/件/组…）绕过 ⇒ 扩表。
  2178	      ⚠️ 仍是封闭表——如实登记的边界，不宣称"位置承担了一切"。
  2179	    - **修饰字**（多/余/来/几/约/近/超）：插一个字就断开数字与量词的紧邻关系。
  2180	    - **E7 洗钱通道**：范围豁免原为**无条件**整段挖空 ⇒ 写个 `1-` 前缀，
  2181	      任意量级都不受检。现在只有**两端都有出处**才算合法区间。
  2182	    - **量词包进 code span**：挖空量词会让前面的数字失去锚点 ⇒ 纯量词跨度不再豁免。
  2183	    """
  2184	    v = _verdicts_on_all_boards(tmp_path, prose)
  2185	    assert len(set(v.values())) == 1, f"{ids}: 四板判决不一致: {v}"
  2186	    assert all(v.values()), f"{ids}: 未被拦下: {v}"
