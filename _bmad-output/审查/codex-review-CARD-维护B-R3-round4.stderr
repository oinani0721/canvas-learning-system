   260	            ),
   261	            (
   262	                'return re.sub(r"(?<=[0-9])[,，](?=[0-9]{3}(?![0-9]))", "", line)',
   263	                'return re.sub(r"(?<=[0-9]),(?=[0-9]{3}(?![0-9]))", "", line)',
   264	            ),
   265	        ],
   266	        "r7_range",
   267	    ),
   268	]
   269	
   270	
   271	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   272	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   273	
   274	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   275	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   276	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   277	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   278	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   279	    要求"确实收集到用例"且"确实有失败"才算变红。
   280	    """
   281	    r = subprocess.run(
   282	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   283	        cwd=ROOT / "backend",
   284	        capture_output=True,
   285	        text=True,
   286	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   287	        timeout=600,
   288	    )
   289	    out = r.stdout
   290	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   291	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   292	    return r.returncode, out[-400:], passed + failed, failed
   293	
   294	
   295	def main() -> int:
   296	    try:
   297	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   298	    except FileExistsError:
   299	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   300	        return 2
   301	    try:
   302	        original = TARGET.read_bytes()
   303	        backup_sha = hashlib.sha256(original).hexdigest()
   304	
   305	        rc0, out0, n0, f0 = run_suite("domain_")
   306	        if rc0 != 0 or f0 or n0 == 0:
   307	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   308	            return 2
   309	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   310	
   311	        failures = 0
   312	        for name, subs, keyword in MUTANTS:
   313	            text = original.decode("utf-8")
   314	            for old, new in subs:
   315	                if old not in text:
   316	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   317	                    failures += 1
   318	                    text = None
   319	                    break
   320	                text = text.replace(old, new, 1)
   321	            if text is None:
   322	                continue
   323	            TARGET.write_text(text, encoding="utf-8")
   324	            try:
   325	                rc, out, n, f = run_suite(keyword)
   326	            finally:
   327	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   328	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   329	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   330	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   331	            if n == 0:
   332	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   333	                failures += 1
   334	            elif f == 0:
   335	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   336	                failures += 1
   337	            else:
   338	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   339	
   340	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   341	        return 1 if failures else 0
   342	    finally:
   343	        LOCK.rmdir()
   344	
   345	
   346	if __name__ == "__main__":
   347	    sys.exit(main())

