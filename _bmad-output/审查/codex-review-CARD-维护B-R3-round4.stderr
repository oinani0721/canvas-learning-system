  2196	        ("说明十分清楚。", "cjk_shi_in_prose"),
  2197	    ],
  2198	    ids=lambda v: v if isinstance(v, str) and "。" not in v else None,
  2199	)
  2200	def test_audit_number_form_fixes_do_not_overreach(tmp_path, prose, ids):
  2201	    """放行门（同权重）：数字形态收紧不得反噬合法语料。
  2202	
  2203	    ⚠️ 特别是最后两条——`统计口径尚未一致` / `说明十分清楚` 含「一」「十」，
  2204	    正是 round-5 那次翻车的原始误伤输入。中文数字解析器上线后必须重新验一遍：
  2205	    中文数字只有**紧跟量词**时才算计数，散落在正常中文里的数字字不算。
  2206	    """
  2207	    v = _verdicts_on_all_boards(tmp_path, prose)
  2208	    assert len(set(v.values())) == 1, f"{ids}: 四板判决不一致: {v}"

