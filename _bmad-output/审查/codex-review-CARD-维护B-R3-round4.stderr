  1550	def _normalize_number_seps(line: str) -> str:
  1551	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1552	
  1553	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1554	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1555	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1556	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1557	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1558	    """
  1559	    return re.sub(r"(?<=[0-9])[,，](?=[0-9]{3}(?![0-9]))", "", line)
