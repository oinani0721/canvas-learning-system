  3301	def test_domain_r5_noise_split_number_run_cli(tmp_path):
  3302	    """R3 round-2 行为门：排版噪声/不可见字符**不得**成为数串的断点。
  3303	
  3304	    `- 本板共有九十八万**五**个子节点。【实测】` 在 Obsidian 里渲染成
  3305	    「本板共有九十八万五个子节点」（粗体的五），而验证器原先只抓到尾片 `五`，
  3306	    `_cjk_single_to_int('五')==5` 且 5 在池内 ⇒ 纯虚构的 980005 **exit 0 放行**。
  3307	    ASCII 侧同形：`980 005个`（空格千分位）只查到 `005`。
  3308	
  3309	    **它证明什么**：数串跨连接字符（排版标记 / `&nbsp;` / 空白 / 短 HTML 标签与
  3310	    注释 / 零宽与双向控制）整体抓取并剥噪声后再判 —— D2 侧覆盖 CJK 与 ASCII，
  3311	    fallback 侧本门只覆盖 CJK；合法的单字/池内数值不受影响。
  3312	    ⚠️ 措辞收窄（Codex round-2 属实指出）：本门原写「CJK 与 ASCII × D2 与
  3313	    fallback 全覆盖」，但矩阵里 fallback 只喂了 CJK——而当时 fallback 的 ASCII
  3314	    侧**确实还是** ``re.findall(r"\\d+")`` 的碎片取数。该缺口由
  3315	    `test_domain_r6_cross_class_and_offtable_numeral_cli` 闭合并配门。
  3316	    **它不证明什么**：连接集是**封闭表**（与量词表同口径）。表外字符仍能切断数串
  3317	    （`九十八万x五个` / `九十八万、五个` / `[[x|]]` 的残留 `|]]`）——那些断点
  3318	    **渲染后可见**，读者不会读成一个连续的数；表外的**不可见**载体（如超长 HTML
  3319	    注释）是真残余，登记在验收单 §五之三，本门不宣称覆盖。
  3320	    """
  3321	    vault = standard_vault(tmp_path)
  3322	    scan = collect_json(vault)
  3323	    pool = _load_recap_scan()._derived_number_pool(scan)
  3324	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3325	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3326	    report = write_report(vault, scan)
  3327	    base_text = report.read_text(encoding="utf-8")
  3328	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3329	
  3330	    def verify(anchor: str, injected: str):
  3331	        text = base_text.replace(anchor, injected, 1)
  3332	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3333	        report.write_text(text, encoding="utf-8")
  3334	        return run_verify(report)
  3335	
  3336	    def d2(line: str):
  3337	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3338	
  3339	    # ── 拦截面：渲染后连续、源码被切断 ──
  3340	    for name, line in (
  3341	        ("粗体", "- 本板共有九十八万**五**个子节点。【实测】"),
  3342	        ("空白", "- 本板共有九十八万 五个子节点。【实测】"),
  3343	        ("nbsp", "- 本板共有九十八万&nbsp;五个子节点。【实测】"),
  3344	        ("空标签", "- 本板共有九十八万<span></span>五个子节点。【实测】"),
  3345	        ("修饰字余", "- 本板共有九十八万余五个子节点。【实测】"),
  3346	        ("行内代码", "- 本板共有九十八万`x`五个子节点。【实测】"),
  3347	    ):
  3348	        r = d2(name and line)
