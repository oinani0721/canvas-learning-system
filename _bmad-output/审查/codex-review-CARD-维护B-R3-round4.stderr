  3366	    # fallback 允许式侧同根（碎片逐片查池全部命中 ⇒ 整体虚构值放行）
  3367	    for tok, joined in (("九**五**", "九五"), ("九十八万**五**", "九十八万五")):
  3368	        r = verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
