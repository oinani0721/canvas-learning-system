   351	async def self_assess(
   352	    concept_id: str,
   353	    req: SelfAssessRequest,
   354	    vault_id: Optional[str] = Query(
   355	        default=None,
   356	        min_length=1,
   357	        description="Multi-vault P0-2 — 推荐必填.",
   358	    ),
   359	    subject_id: Optional[str] = Query(default=None),
   360	    group_id: Optional[str] = Query(
   361	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   362	    ),
   363	):
   364	    """
   365	    Record implicit self-assessment from Canvas color change (weight=0.5).
   366	
   367	    Color mapping:
   368	      "1" (Red)    -> 0.20 (student thinks they don't know)
   369	      "2" (Orange) -> 0.85 (student thinks they know)
   370	      "3" (Yellow) -> 0.55 (student thinks partial)
   371	      "4" (Green)  -> 0.85 (student thinks they know)
   372	      "5" (Cyan)   -> 0.90 (student thinks mastered)
   373	      "6" (Purple) -> 0.40 (student thinks weak)
   374	    """
   375	    resolved_group_id = _resolve_vault_group_id(
   376	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   377	    )
   378	    engine = _get_engine()
   379	    store = _get_store()
