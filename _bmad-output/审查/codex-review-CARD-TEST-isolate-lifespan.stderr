   111	
   112	@mastery_router.get("/mastery/batch")
   113	async def get_batch_mastery(
   114	    vault_id: Optional[str] = Query(
   115	        default=None,
   116	        min_length=1,
   117	        description=(
   118	            "Multi-vault P0-2 (Wave-5 Stage B) — 推荐必填. 注入 ContextVar 防 5 vault 串库. "
   119	            "Plugin 端 inferVaultId(app.vault.getName()). 空则 fallback 到 deprecated group_id."
   120	        ),
   121	    ),
   122	    subject_id: Optional[str] = Query(
   123	        default=None,
   124	        description="可选 vault 内学科二级 namespace.",
   125	    ),
   126	    group_id: Optional[str] = Query(
   127	        default=None,
   128	        deprecated=True,
   129	        description="Deprecated — 改用 vault_id. 留兼容 plugin 尚未升级调用.",
   130	    ),
   131	):
   132	    """
   133	    Get all concepts' current mastery state (includes volatile computations).
   134	
   135	    Returns concepts array with effective_proficiency, mastery_level, etc.
   136	    Also returns topic_summary with aggregated proficiency per topic.
   137	    """
   138	    resolved_group_id = _resolve_vault_group_id(
   139	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   140	    )
   141	    engine = _get_engine()
   142	    store = _get_store()
   143	
   144	    concepts = await store.get_all_concepts(resolved_group_id)
   145	
   146	    # Build response with volatile fields computed on the fly
   147	    concept_responses = [engine.concept_to_response(c) for c in concepts]
   148	
   149	    # Compute topic summary
   150	    topic_map: dict[str, list[dict]] = {}
   151	    for resp in concept_responses:
   152	        topic = resp["topic"]
   153	        if topic not in topic_map:
   154	            topic_map[topic] = []
   155	        topic_map[topic].append(resp)
   156	
   157	    # Load exam weights from config
   158	    exam_weights: dict = {}
   159	    try:
   160	        import json
   161	        from pathlib import Path
   162	
   163	        config_path = (
   164	            Path(__file__).parent.parent.parent.parent.parent / "mastery_config.json"
   165	        )
   166	        if config_path.exists():
   167	            with open(config_path, "r", encoding="utf-8") as f:
   168	                exam_weights = json.load(f).get("topic_exam_weights", {})
   169	    except Exception:
   170	        pass
   171	
   172	    topic_summary = {}
   173	    for topic, items in topic_map.items():
   174	        profs = [it["effective_proficiency"] for it in items]
   175	        avg = sum(profs) / len(profs) if profs else 0.0
   176	        topic_summary[topic] = {
   177	            "avg_proficiency": round(avg, 3),
   178	            "concept_count": len(items),
   179	            "exam_weight": exam_weights.get(topic, 0),
   180	        }
   750	        elif signal_type == "problem_trap":
   751	            # Softer penalty — trap is about application, not understanding
   752	            concept.p_mastery = max(0.05, concept.p_mastery - severity * 0.5)
   753	        elif signal_type == "guided_thinking_correct":
   754	            # Small boost — correct response in guided thinking
   755	            concept.p_mastery = min(0.99, concept.p_mastery + severity)
   756	        else:
   757	            logger.warning(f"Unknown signal type: {signal_type}")
   758	
   759	        return concept
   760	
   761	
   762	# ═══════════════════════════════════════════════════════════════════════════════
   763	# Service-level singleton accessor
   764	# ═══════════════════════════════════════════════════════════════════════════════
   765	
   766	_engine_instance: MasteryEngine | None = None
   767	
   768	
   769	def set_mastery_engine(engine: MasteryEngine) -> None:
   770	    """Set the global singleton MasteryEngine (called from main.py after fusion setup).
   771	
   772	    This ensures all callers of get_mastery_engine() receive the same instance
   773	    with fusion engine and signal adapters already attached.
   774	    """
   775	    global _engine_instance
   776	    _engine_instance = engine
   777	    logger.info("MasteryEngine singleton set (fusion-enabled)")
   778	
   779	
   780	def get_mastery_engine() -> MasteryEngine:
   781	    """Get or create the singleton MasteryEngine instance.
   782	
   783	    After main.py startup, returns the fusion-enabled engine set via set_mastery_engine().
   784	    Before startup (or if set_mastery_engine was never called), creates a plain engine.
   785	    """
   786	    global _engine_instance
   787	    if _engine_instance is None:
   788	        _engine_instance = MasteryEngine(load_mastery_config())
   789	    return _engine_instance

