    83	class ResourceMonitor:
    84	    """
    85	    System resource monitor with Prometheus metrics integration.
    86	
    87	    Provides methods for collecting CPU, memory, and disk metrics
    88	    with configurable thresholds and alert levels.
    89	
    90	    [Source: docs/architecture/performance-monitoring-architecture.md:281-320]
    91	
    92	    Attributes:
    93	        thresholds: Dictionary of warning/critical thresholds
    94	        disk_paths: List of disk mount points to monitor
    95	
    96	    Example:
    97	        >>> monitor = ResourceMonitor()
    98	        >>> metrics = monitor.collect_metrics()
    99	        >>> print(metrics["cpu"]["percent"])
   100	        45.2
   101	    """
   102	
   103	    def __init__(
   104	        self,
   105	        thresholds: dict[str, float] | None = None,
   106	        disk_paths: list[str] | None = None,
   107	    ):
   108	        """
   109	        Initialize the resource monitor.
   110	
   111	        Args:
   112	            thresholds: Custom thresholds (optional, uses defaults if not provided)
   113	            disk_paths: Disk mount points to monitor (defaults to ["/"])
   114	        """
   115	        self.thresholds = {**DEFAULT_THRESHOLDS, **(thresholds or {})}
   116	        # Cross-platform default disk path: "/" on Unix, "C:\\" on Windows
   117	        default_disk = "C:\\" if sys.platform == "win32" else "/"
   118	        self.disk_paths = disk_paths or [default_disk]
   119	        self._running = False
   120	        self._task: asyncio.Task | None = None
   121	
   122	        logger.info(
   123	            "resource_monitor.initialized",
   124	            thresholds=self.thresholds,
   125	            disk_paths=self.disk_paths,
   126	        )
   127	
   128	    def get_cpu_metrics(self) -> dict[str, Any]:
   129	        """
   130	        Get current CPU metrics.
   131	
   132	        Returns:
   133	            Dictionary with CPU metrics including percent usage and status
   134	
   135	        ✅ Verified from Context7:/giampaolo/psutil (topic: cpu_percent)
   136	        """
   137	        # ✅ Verified from Context7:/giampaolo/psutil
   138	        # cpu_percent(interval=None) returns immediately with last measurement
   139	        percent = psutil.cpu_percent(interval=None)
   140	
   141	        # Determine status based on thresholds
   142	        if percent >= self.thresholds["cpu_critical"]:
   143	            status = "critical"
   144	        elif percent >= self.thresholds["cpu_warning"]:
   145	            status = "warning"
