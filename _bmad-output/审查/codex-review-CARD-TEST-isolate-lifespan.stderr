   266	async def record_grade(
   267	    concept_id: str,
   268	    req: GradeRequest,
   269	    vault_id: Optional[str] = Query(
   270	        default=None,
   271	        min_length=1,
   272	        description="Multi-vault P0-2 — 推荐必填. 注入 ContextVar 防跨 vault 泄漏.",
   273	    ),
   274	    subject_id: Optional[str] = Query(default=None),
   275	    group_id: Optional[str] = Query(
   276	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   277	    ),
   278	):
   279	    """
   280	    Record a student interaction grade (1-4) and update BKT + FSRS.
   281	
   282	    Grade mapping:
   283	      1 = Forgot (completely wrong)
   284	      2 = Struggled (needed hints)
   285	      3 = Correct (answered and explained)
   286	      4 = Fluent (fluent explanation with connections)
   287	    """
   288	    resolved_group_id = _resolve_vault_group_id(
   289	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   290	    )
   291	    engine = _get_engine()
   292	    store = _get_store()
   293	
   294	    concept = await store.get_or_create_concept(
   295	        concept_id,
   296	        topic=req.topic,
   297	        name=req.name,
   298	        group_id=resolved_group_id,
   299	    )
   300	
   301	    concept = engine.update_on_interaction(concept, req.grade)
   302	    await store.save_concept(concept, resolved_group_id)
   303	    await store.record_interaction_event(concept_id, req.grade, resolved_group_id)
   304	
   305	    return engine.concept_to_response(concept)
