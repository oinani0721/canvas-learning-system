    82	class _GuardState:
    83	    """门的运行时账。跨线程累加（连接常发生在 TestClient 的 anyio portal 线程）。"""
    84	
    85	    def __init__(self) -> None:
    86	        self._lock = threading.Lock()
    87	        self.installed = False
    88	        self.total = 0
    89	        self.blocked = 0
    90	        self.advisory = 0
    91	        self.records: list[dict] = []
    92	        # nodeid -> 该用例名下尚未结账的拦截记录
    93	        self.pending: dict[str, list[dict]] = {}
    94	        self._current_owner = _SESSION_OWNER
    95	        self._current_exempt = False
    96	        self._orig_connect = None
    97	        self._orig_connect_ex = None
    98	
    99	    # ── 用例边界 ────────────────────────────────────────────────────────
   100	    def begin_item(self, owner: str, exempt: bool) -> None:
   101	        with self._lock:
   102	            self._current_owner = owner
   103	            self._current_exempt = exempt
   104	
   105	    def end_item(self) -> None:
   106	        with self._lock:
   107	            self._current_owner = _SESSION_OWNER
   108	            self._current_exempt = False
   109	
   110	    def take(self, owner: str) -> list[dict]:
   111	        with self._lock:
   112	            return self.pending.pop(owner, [])
   113	
   114	    # ── 记账 ────────────────────────────────────────────────────────────
   115	    def record(self, address) -> bool:
   116	        """记一次到受拦端口的连接尝试。返回 True 表示应当拦（非豁免）。"""
   117	        with self._lock:
   118	            owner = self._current_owner
   119	            exempt = self._current_exempt
   120	            rec = {
   121	                "address": repr(address),
   122	                "thread": threading.current_thread().name,
   123	                "owner": owner,
   124	                "exempt": exempt,
   125	            }
   126	            self.total += 1
   127	            self.records.append(rec)
   128	            if exempt:
   129	                self.advisory += 1
   130	                return False
   131	            self.blocked += 1
   132	            self.pending.setdefault(owner, []).append(rec)
   133	            return True
   134	
   135	    def summary_line(self) -> str:
   136	        with self._lock:
   137	            return f"{_SUMMARY_PREFIX}={self.total} (blocked={self.blocked}, advisory={self.advisory})"
   138	
   139	
   140	STATE = _GuardState()
   141	
   142	
   143	# ═══════════════════════════════════════════════════════════════════════════
   144	# 端口提取 + 包装
   145	# ═══════════════════════════════════════════════════════════════════════════
   146	
   147	
   148	def extract_port(address) -> int | None:
   149	    """从 socket 地址里取端口。
   150	
   151	    IPv4 是 2 元组 ``('127.0.0.1', 7691)``；IPv6 是 4 元组
   152	    ``('::1', 7691, 0, 0)`` —— 2026-09-01 实测 neo4j 驱动走的正是 IPv6 四元组，
   153	    只按 ``len(address) == 2`` 判会**整条漏掉**。
   154	    AF_UNIX（str/bytes 地址）与其它协议族返回 None（不在本门射程）。
   155	    """
   156	    if isinstance(address, tuple) and len(address) >= 2:
   157	        port = address[1]
   158	        if isinstance(port, int):
   159	            return port
   160	    return None
   161	
   162	
   163	def _block_message(address) -> str:
   164	    return (
   165	        f"{BLOCK_REASON}: {address!r}. "
   166	        f"受拦端口 {sorted(BLOCKED_PORTS)} 是现网 Neo4j；测试进程不得连接。"
   167	        f"若这是端点测试，请用 backend/tests/support/lifespan.py::no_lifespan "
   168	        f"关掉 app.main 的 lifespan；若确需真库，用测试容器 "
   169	        f"NEO4J_TEST_URI(7692) 并打 integration/real_neo4j marker。"
   170	    )
   171	
   172	
   173	def _guarded_connect(sock_self, address):
   174	    if extract_port(address) in BLOCKED_PORTS:
   175	        if STATE.record(address):
   176	            raise RuntimeError(_block_message(address))
   177	    return STATE._orig_connect(sock_self, address)
   178	
   179	
   180	def _guarded_connect_ex(sock_self, address):
   181	    """``connect_ex`` 正常返回 errno 而不抛；这里**故意抛**。
   182	
   183	    fail-closed 优先于 API 形状：一个用 connect_ex 探活现网库的调用方，
   184	    拿到 errno 会静默走降级分支，那正是本卡要消灭的「静默连库」。
   185	    """
   186	    if extract_port(address) in BLOCKED_PORTS:
   187	        if STATE.record(address):
   188	            raise RuntimeError(_block_message(address))
   189	    return STATE._orig_connect_ex(sock_self, address)
   190	
   191	
   192	def install() -> None:
   193	    """装门。幂等——重复调用不会把包装函数当成原函数存起来。"""
   194	    if STATE.installed:
   195	        return
   196	    STATE._orig_connect = _socket_mod.socket.connect
   197	    STATE._orig_connect_ex = _socket_mod.socket.connect_ex
   198	    _socket_mod.socket.connect = _guarded_connect
   199	    _socket_mod.socket.connect_ex = _guarded_connect_ex
   200	    STATE.installed = True
   201	
   202	
   203	def uninstall() -> None:
   204	    if not STATE.installed:
   205	        return
   206	    _socket_mod.socket.connect = STATE._orig_connect
   207	    _socket_mod.socket.connect_ex = STATE._orig_connect_ex
   208	    STATE.installed = False
   209	
   210	
   211	# ═══════════════════════════════════════════════════════════════════════════
   212	# 自证
   213	# ═══════════════════════════════════════════════════════════════════════════
   214	
   215	
   216	def assert_not_uvloop() -> None:
   217	    """自证当前进程没在用 uvloop —— 否则本门静默失效。
   218	
   219	    uvloop 的 ``sock_connect`` 走 libuv，不经过 ``socket.socket.connect``。
   220	    本车道 venv 装了 uvloop 0.22.1 但全仓零引用；一旦有人引入，宁可门直接 fail，
   221	    也不要让它变成一道「什么都拦不到所以永远 0」的假门。
   222	    """
   223	    if "uvloop" in sys.modules:
   224	        raise RuntimeError(
   225	            "uvloop 已被导入：本门包装的是 socket.socket.connect，uvloop 走 libuv "
   226	            "绕过它，门会静默失效。请改用 asyncio 默认 loop，或把门改到 uvloop 层。"
   227	        )
   228	    policy_module = ""
   229	    try:  # pragma: no cover - 3.14 起 get_event_loop_policy 已 deprecated
   230	        with warnings.catch_warnings():
   231	            warnings.simplefilter("ignore", DeprecationWarning)
   232	            policy_module = type(asyncio.get_event_loop_policy()).__module__ or ""
   233	    except Exception:  # noqa: BLE001 —— 拿不到 policy 不算证据，靠 sys.modules 那条
   234	        policy_module = ""
   235	    if "uvloop" in policy_module:
   236	        raise RuntimeError(f"event loop policy 来自 uvloop（{policy_module}）：本门会静默失效。")
   237	
   238	
   239	def assert_test_uri_not_blocked() -> None:
   240	    """NEO4J_TEST_URI 指向受拦端口 = 配置事故，直接 fail 而不是悄悄放行。
   241	
   242	    刻意**不**做「把 NEO4J_TEST_URI 的端口从受拦集合里摘掉」——那会给出一条
   243	    「改个环境变量就能把门打开」的静默旁路。
   244	    """
   245	    uri = os.environ.get("NEO4J_TEST_URI") or ""
   246	    for port in BLOCKED_PORTS:
   247	        if f":{port}" in uri:
   248	            raise RuntimeError(f"NEO4J_TEST_URI={uri!r} 指向受拦端口 {port}（现网库）。测试容器应当是 7692。")
   249	
   250	
   251	# ═══════════════════════════════════════════════════════════════════════════
   252	# pytest 接线（由根 conftest 调用）
   253	# ═══════════════════════════════════════════════════════════════════════════
   254	
   255	
   256	def is_exempt(item) -> tuple[bool, str]:
   257	    """该用例是否豁免（只记不拦）。返回 (豁免, 依据)。"""
   258	    for marker in EXEMPT_MARKERS:
   259	        if item.get_closest_marker(marker) is not None:
   260	            return True, f"marker:{marker}"
   261	    nodeid = item.nodeid.replace(os.sep, "/")
   262	    for prefix in EXEMPT_PATH_PREFIXES:
   263	        if nodeid.startswith(prefix):
   264	            return True, f"path:{prefix}"
   265	    try:  # nodeid 的相对性取决于 rootdir，绝对路径兜一层
   266	        abspath = str(item.path).replace(os.sep, "/")
   267	    except Exception:  # noqa: BLE001
   268	        abspath = ""
   269	    for prefix in EXEMPT_PATH_PREFIXES:
   270	        if f"/{prefix}" in abspath:
   271	            return True, f"abspath:{prefix}"
   272	    return False, ""
   273	
   274	
   275	def format_sentinel(owner: str, records: list[dict]) -> str:
   276	    lines = [
   277	        f"{BLOCK_REASON} —— 本用例期间有 {len(records)} 次到现网 Neo4j 的连接尝试被拦下。",
   278	        "（连接处抛出的异常被 app/main.py 的 lifespan try/except 吞掉了，",
   279	        "  所以由本哨兵把它转成用例失败——否则这道门什么都证明不了。）",
   280	    ]
   281	    for rec in records:
   282	        lines.append(f"  - {rec['address']} on thread {rec['thread']} (owner={owner})")
   283	    return "\n".join(lines)
