   172	    def test_check_duplicate_request_returns_cache_key(self):
   173	        """check_duplicate_request should return cache key when enabled."""
   174	        from app.api.v1.endpoints.agents import check_duplicate_request
   175	
   176	        with patch("app.api.v1.endpoints.agents.settings") as mock_settings:
   177	            mock_settings.ENABLE_REQUEST_DEDUP = True
   178	
   179	            # Clear cache and test
   180	            request_cache.clear()

