    29	class BugRecord(BaseModel):
    30	    """
    31	    Bug record model for storing error information.
    32	
    33	    [Source: specs/data/error-response.schema.json]
    34	    [Source: docs/stories/21.5.3.story.md - AC-2]
    35	
    36	    Attributes:
    37	        bug_id: Unique identifier (format: BUG-{uuid8})
    38	        timestamp: When the error occurred
    39	        endpoint: API endpoint path where error occurred
    40	        error_type: Exception class name
    41	        error_message: Error message string
    42	        request_params: Request parameters (query params, body)
    43	        stack_trace: Full stack trace (optional)
    44	        user_action: Description of user action (optional)
    45	    """
    46	
    47	    bug_id: str = Field(..., description="Unique bug identifier (BUG-{uuid8})")
    48	    timestamp: datetime = Field(..., description="Error occurrence timestamp")
    49	    endpoint: str = Field(..., description="API endpoint path")
    50	    error_type: str = Field(..., description="Exception class name")
    51	    error_message: str = Field(..., description="Error message")
    52	    request_params: dict = Field(default_factory=dict, description="Request parameters")
    53	    stack_trace: Optional[str] = Field(None, description="Full stack trace")
    54	    user_action: Optional[str] = Field(None, description="User action description")
    55	    request_id: Optional[str] = Field(
    56	        None, description="Correlation request ID from middleware"
    57	    )
    58	    story_id: Optional[str] = Field(
    59	        None, description="BMAD Story ID for traceability (e.g., '30.23')"
    60	    )
    61	
