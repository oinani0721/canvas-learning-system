+@pytest.hookimpl(wrapper=True)
+def pytest_runtest_protocol(item, nextitem):
+    """把连接尝试归属到用例；豁免用例（integration/e2e 路径与 marker）只记不拦。"""
+    exempt, _why = live_port_guard.is_exempt(item)
+    live_port_guard.STATE.begin_item(item.nodeid, exempt)
+    try:
+        return (yield)
+    finally:
+        live_port_guard.STATE.end_item()
+
+
+@pytest.hookimpl(wrapper=True)
