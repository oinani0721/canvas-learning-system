    82	def pytest_unconfigure(config):
    83	    live_port_guard.uninstall()
    84	
    85	
    86	@pytest.fixture(scope="session", autouse=True)
    87	def _neo4j_live_port_guard(tmp_path_factory):
    88	    """session 级自证 + bug_tracker 运行时文件重定向。
    89	
    90	    - uvloop 自证：uvloop 的 connect 走 libuv 绕过 socket 门，门宁可让整个
    91	      session fail 也不静默失效；
    92	    - NEO4J_TEST_URI 指向受拦端口 = 配置事故，直接 fail（拒绝静默改门）；
    93	    - middleware 的 bug_tracker 单例 log_path 重定向到 session tmp：预存失败
    94	      用例的请求期 500 会经 CORSExceptionMiddleware 真写 backend/data/bug_log.jsonl
    95	      （路径相对 cwd，不受 CANVAS_BASE_PATH 影响），不重定向则 runtime sha 门
    96	      被基线既有失败打破（验收单「门不比什么」#4 有如实声明）。
    97	    """
    98	    live_port_guard.assert_not_uvloop()
    99	    live_port_guard.assert_test_uri_not_blocked()
   100	    assert live_port_guard.STATE.installed, "socket 门未安装（pytest_configure 未跑？）"
   101	
   102	    from app.core import bug_tracker as bug_tracker_module
   103	
   104	    session_bug_dir = tmp_path_factory.mktemp("bug_log")
   105	    saved_log_path = bug_tracker_module.bug_tracker.log_path
   106	    bug_tracker_module.bug_tracker.log_path = session_bug_dir / "bug_log.jsonl"
   107	
   108	    yield
   109	
   110	    bug_tracker_module.bug_tracker.log_path = saved_log_path
