   393	@mastery_router.delete("/mastery/{concept_id}/override")
   394	async def reset_override(
   395	    concept_id: str,
   396	    vault_id: Optional[str] = Query(
   397	        default=None,
   398	        min_length=1,
   399	        description="Multi-vault P0-2 — 推荐必填.",
   400	    ),
   401	    subject_id: Optional[str] = Query(default=None),
   402	    group_id: Optional[str] = Query(
   403	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   404	    ),
   405	):
   406	    """Reset override to model-computed value."""
   407	    resolved_group_id = _resolve_vault_group_id(
   408	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   409	    )
   410	    engine = _get_engine()
   411	    store = _get_store()
   412	
   413	    concept = await store.get_concept(concept_id, resolved_group_id)
   414	    if not concept:
   415	        raise HTTPException(404, f"Concept '{concept_id}' not found")
   416	
   417	    concept = engine.clear_override(concept)
   418	    await store.save_concept(concept, resolved_group_id)
   419	
   420	    return engine.concept_to_response(concept)
