   494	# Story 5.5: Calibration API Endpoints
   495	# ═══════════════════════════════════════════════════════════════════════════════
   496	
   497	
   498	@mastery_router.post("/mastery/{concept_id}/calibration")
   499	async def record_calibration_endpoint(
   500	    concept_id: str,
   501	    req: CalibrationRequest,
   502	    vault_id: Optional[str] = Query(
   503	        default=None,
   504	        min_length=1,
   505	        description="Multi-vault P0-2 — 推荐必填.",
   506	    ),
   507	    subject_id: Optional[str] = Query(default=None),
   508	    group_id: Optional[str] = Query(
   509	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   510	    ),
   511	):
   512	    """Record a calibration data point (self_confidence + actual_performance).
   513	
   514	    Creates a CalibrationRecord with auto-classified Area9 quadrant.
   515	    Persists to Neo4j for progressive calibration assessment.
   516	
   517	    Quadrants:
   518	      - Mastered: confident + correct
   519	      - Misconception: confident + wrong (DANGEROUS)
   520	      - Lucky: unsure + correct
   521	      - Unlearned: unsure + wrong
   522	    """
   523	    resolved_group_id = _resolve_vault_group_id(
   524	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   525	    )
   526	    store = _get_store()
   527	
   528	    cal_record = record_calibration(
   529	        node_id=concept_id,
   530	        self_confidence=req.self_confidence,
   531	        actual_performance=req.actual_performance,
   532	        session_id=req.session_id,
   533	    )
   534	
   535	    await store.save_calibration_record(cal_record, resolved_group_id)
   536	
   537	    return {
   538	        "node_id": concept_id,
   539	        "quadrant": cal_record.quadrant.value,
   540	        "is_dangerous": cal_record.is_dangerous,
   541	        "self_confidence": cal_record.self_confidence,
   542	        "actual_performance": cal_record.actual_performance,
   543	        "timestamp": cal_record.timestamp.isoformat(),
   544	    }
   545	
   546	
   547	@mastery_router.get("/mastery/{concept_id}/calibration/summary")
   548	async def get_calibration_summary_endpoint(
   549	    concept_id: str,
   550	    vault_id: Optional[str] = Query(
   551	        default=None,
   552	        min_length=1,
   553	        description="Multi-vault P0-2 — 推荐必填.",
   554	    ),
   555	    subject_id: Optional[str] = Query(default=None),
   556	    group_id: Optional[str] = Query(
   557	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   558	    ),
   559	):
   560	    """Get calibration summary for a concept node.
   561	
   562	    Three-stage progressive assessment:
   563	      Stage 1 (< 10 records): Data collection, no assessment
   564	      Stage 2 (10-20 records): Preliminary trends + signed_bias
   565	      Stage 3 (20+ records): Full report + absolute_bias + rating
   566	    """
   567	    resolved_group_id = _resolve_vault_group_id(
   568	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   569	    )
   570	    store = _get_store()
   571	
   572	    records = await store.get_calibration_records(concept_id, resolved_group_id)
   573	    summary = get_calibration_summary(records)
   574	
   575	    return summary.model_dump()
