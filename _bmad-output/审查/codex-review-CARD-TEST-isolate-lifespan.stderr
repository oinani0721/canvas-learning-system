    63	class BugTracker:
    64	    """
    65	    Bug tracking service for automatic error logging.
    66	
    67	    Logs all 500 errors to a JSONL file for debugging and issue tracking.
    68	    Provides methods to log new errors and retrieve recent bug records.
    69	
    70	    [Source: docs/prd/EPIC-21.5-AGENT-RELIABILITY-FIX.md#story-21-5-3]
    71	    [Source: docs/stories/21.5.3.story.md - AC 1-5]
    72	
    73	    Example:
    74	        ```python
    75	        from app.core.bug_tracker import bug_tracker
    76	
    77	        # Log an error
    78	        bug_id = bug_tracker.log_error(
    79	            endpoint="/api/v1/agents/scoring",
    80	            error=ValueError("Invalid input"),
    81	            request_params={"canvas_path": "test.canvas"}
    82	        )
    83	
    84	        # Get recent bugs
    85	        bugs = bug_tracker.get_recent_bugs(limit=10)
    86	        ```
    87	    """
    88	
    89	    def __init__(self, log_path: str = "data/bug_log.jsonl"):
    90	        """
    91	        Initialize BugTracker with specified log file path.
    92	
    93	        Args:
    94	            log_path: Path to the JSONL log file (relative to backend directory)
    95	        """
    96	        self.log_path = Path(log_path)
    97	        # Ensure parent directory exists
    98	        self.log_path.parent.mkdir(parents=True, exist_ok=True)
    99	
   100	    def log_error(
   101	        self,
   102	        endpoint: str,
   103	        error: Exception,
   104	        request_params: dict,
   105	        user_action: Optional[str] = None,
   106	        request_id: Optional[str] = None,
   107	        story_id: Optional[str] = None,
   108	    ) -> str:
   109	        """
   110	        Log an error to the bug log file.
   111	
   112	        [Source: docs/stories/21.5.3.story.md - AC-1, AC-2, AC-5]
   113	
   114	        Args:
   115	            endpoint: API endpoint path where error occurred
   116	            error: The caught exception object
   117	            request_params: Request parameters dictionary
   118	            user_action: Optional description of user action
   119	            request_id: Optional correlation request ID from middleware
   120	
   121	        Returns:
   122	            str: Generated bug_id (format: BUG-{uuid8})
   123	
   124	        Example:
   125	            ```python
   126	            bug_id = bug_tracker.log_error(
   127	                endpoint="/api/v1/agents/scoring",
   128	                error=ValueError("Test error"),
   129	                request_params={"key": "value"}
   130	            )
   131	            # Returns: "BUG-A1B2C3D4"
   132	            ```
   133	        """
   134	        # Generate unique bug_id
   135	        # ✅ Verified from Python docs: uuid.uuid4().hex returns 32 hex chars
   136	        bug_id = f"BUG-{uuid.uuid4().hex[:8].upper()}"
   137	
   138	        # Create bug record
   139	        record = BugRecord(
   140	            bug_id=bug_id,
   141	            timestamp=datetime.now(timezone.utc),
   142	            endpoint=endpoint,
   143	            error_type=type(error).__name__,
   144	            error_message=str(error),
   145	            request_params=request_params,
   146	            stack_trace=traceback.format_exc(),
   147	            user_action=user_action,
   148	            request_id=request_id,
   149	            story_id=story_id,
   150	        )
   151	
   152	        # Append to JSONL file
   153	        # ✅ Verified from Context7:/websites/pydantic_dev (topic: model_dump_json)
   154	        try:
   155	            with open(self.log_path, "a", encoding="utf-8") as f:
   156	                f.write(record.model_dump_json() + "\n")
   157	
   158	            logger.info(
   159	                "bug_logged",
   160	                bug_id=bug_id,
   161	                endpoint=endpoint,
   162	                error_type=type(error).__name__,
   163	            )
   164	        except OSError as write_error:
   165	            # Don't fail the request if bug logging fails
   166	            logger.error(
   167	                "bug_log_write_failed", bug_id=bug_id, write_error=str(write_error)
   168	            )
   169	
   170	        return bug_id
   171	
   172	    def get_recent_bugs(self, limit: int = 50) -> List[BugRecord]:
   173	        """
   174	        Get recent bug records from the log file.
   175	
   176	        [Source: docs/stories/21.5.3.story.md - AC-3, AC-4]
   177	
   178	        Args:
   179	            limit: Maximum number of records to return (default: 50)
   180	
   181	        Returns:
   182	            List[BugRecord]: Bug records, newest first
   183	
   184	        Example:
   185	            ```python
   186	            bugs = bug_tracker.get_recent_bugs(limit=10)
   187	            for bug in bugs:
   188	                print(f"{bug.bug_id}: {bug.error_message}")
   189	            ```
   190	        """
   191	        if not self.log_path.exists():
   192	            return []
   193	
   194	        bugs: List[BugRecord] = []
   195	
   196	        try:
   197	            # ✅ Verified from Context7:/websites/pydantic_dev (topic: model_validate_json)
   198	            with open(self.log_path, "r", encoding="utf-8") as f:
   199	                for line in f:
   200	                    line = line.strip()
   201	                    if line:
   202	                        try:
   203	                            bugs.append(BugRecord.model_validate_json(line))
   204	                        except (ValueError, KeyError) as parse_error:
   205	                            # Skip malformed lines
   206	                            logger.warning(
   207	                                "bug_log_parse_error",
   208	                                line_preview=line[:100],
   209	                                error=str(parse_error),
   210	                            )
   211	        except OSError as read_error:
   212	            logger.error("bug_log_read_failed", error=str(read_error))
   213	            return []
   214	
   215	        # Return last N records in reverse order (newest first)
   216	        return bugs[-limit:][::-1]
   217	
   218	    def get_bug_by_id(self, bug_id: str) -> Optional[BugRecord]:
   219	        """Look up a single bug by its BUG-XXXXXXXX ID."""
   220	        if not self.log_path.exists():
   221	            return None
   222	        try:
   223	            with open(self.log_path, "r", encoding="utf-8") as f:
   224	                for line in f:
   225	                    line = line.strip()
   226	                    if not line:
   227	                        continue
   228	                    if bug_id in line:
   229	                        try:
   230	                            record = BugRecord.model_validate_json(line)
   231	                            if record.bug_id == bug_id:
   232	                                return record
   233	                        except (ValueError, KeyError):
   234	                            continue
   235	        except OSError:
   236	            pass
   237	        return None
   238	
   239	    def clear_log(self) -> bool:
   240	        """
   241	        Clear the bug log file (for testing/maintenance).
   242	
   243	        Returns:
   244	            bool: True if successful, False otherwise
   245	        """
   246	        try:
   247	            if self.log_path.exists():
   248	                self.log_path.unlink()
   249	            return True
   250	        except OSError as e:
   251	            logger.error("bug_log_clear_failed", error=str(e))
   252	            return False
   253	
   254	
   255	# Global singleton instance
   256	# [Source: docs/stories/21.5.3.story.md - "全局单例"]
   257	bug_tracker = BugTracker()
