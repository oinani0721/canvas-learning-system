   149	
   150	async def wait_for_mock_call(
   151	    mock_method,
   152	    *,
   153	    timeout: float = 2.0,
   154	    interval: float = 0.05,
   155	    expected_count: int = 1,
   156	):
   157	    """Poll until mock is called expected number of times or timeout.
   158	
   159	    Use instead of asyncio.sleep() to wait for fire-and-forget background tasks.
   160	
   161	    Args:
   162	        mock_method: The mock to check call_count on.
   163	        timeout: Maximum wait time in seconds.
   164	        interval: Polling interval in seconds.
   165	        expected_count: Minimum call_count to wait for.
   166	
   167	    Raises:
   168	        TimeoutError: If mock not called within timeout.
   169	    """
   170	    loop = asyncio.get_running_loop()
   171	    start = loop.time()
   172	    while (loop.time() - start) < timeout:
   173	        if mock_method.call_count >= expected_count:
   174	            return
   175	        await asyncio.sleep(interval)
   176	    raise TimeoutError(
   177	        f"{mock_method} not called {expected_count} time(s) within {timeout}s (actual: {mock_method.call_count})"
   178	    )
   179	
