   360	
   361	    为什么必须有这个类: 上面所有用例的 ``_state()`` 都固定给
   362	    ``quality_grade="high"``, 而 rag_service 的三个 fallback 出口
   363	    (:216 / :481 / :500) 实际写的是 ``"quality_grade": None``。端点原先用
   364	    ``result.get("quality_grade", "low")`` —— 默认值只在**键缺失**时生效,
   365	    键存在且为 None 时原样返回 None → 撞 ``quality_grade: str`` 响应模型 → 500。
   366	
   367	    也就是说: 「unavailable 仍 200」在合成 state 上成立, 在**真实生产形状**上
   368	    是 500。合成 fixture 与生产形状的这条缝, 正是假绿的藏身处。
   369	    """
   370	
   371	    def _real_service_client(self) -> tuple:
   372	        from app.services.rag_service import RAGService, get_rag_service
   373	
   374	        svc = RAGService()
   375	        svc._initialized = True  # 跳过初始化, 直接测 query 的 fallback 分支
   376	
   377	        app = FastAPI()
   378	        app.include_router(rag_router, prefix="/api/v1/rag")
   379	
   380	        async def _override():
   381	            return svc
   382	
   383	        app.dependency_overrides[get_rag_service] = _override
   384	        return app, svc
   385	
   386	    def test_real_ainvoke_none_fallback_returns_200_unavailable(self):
   387	        app, _ = self._real_service_client()
   388	
   389	        with patch("app.services.rag_service.canvas_agentic_rag") as graph:
   390	            graph.ainvoke = AsyncMock(return_value=None)
   391	            with TestClient(app, raise_server_exceptions=False) as c:
   392	                response = c.post("/api/v1/rag/query", json={"query": "什么是逆否命题？"})
   393	            assert graph.ainvoke.await_count == 1, "没走到真实图执行, 这个门就没测到东西"
   394	
   395	        assert response.status_code == 200, "真实 fallback 出口返回了非 200 —— 「unavailable 仍 200」在生产形状上不成立"
   396	        body = response.json()
   397	        assert body["retrieval_status"] == "unavailable"
   398	        assert "ainvoke_returned_none" in body["retrieval_status_reason"]
   399	        # quality_grade 是 None 被端点兜成 "low", 不是被丢弃
   400	        assert body["quality_grade"] == "low"
   401	        assert body["results"] == []
   402	
   403	    def test_query_with_fallback_exception_exit_reports_unavailable(self):
   404	        """锁住服务层另外两个 fallback 出口的**形状**, 而不是端点行为。
   405	
   406	        端点的 ``or "low"`` 兜底是否还有必要, 取决于服务层是否仍会发出
   407	        ``quality_grade=None``。这条门就是那个前提的哨兵: 若服务层哪天改成
   408	        发 ``"low"``, 本门变红, 提醒重新评估端点兜底 (而不是让它悄悄变成
   409	        一段没人知道还需不需要的死代码)。
   410	        """
   530	        assert body["retrieval_status"] == "degraded"
   531	
   532	    def test_out_of_domain_status_fails_loud_not_silently_passed_through(self, mock_memory_service):
   533	        """越界脏值不被静默透出 —— 值域由 schema 强制, 代价是响应校验失败。
   534	
   535	        **如实登记的行为变更**: 服务层若给出四态以外的值, 响应校验失败 (5xx),
   536	        而不是把第五种状态原样送给客户端。这正是"用枚举而非裸 str"的意义:
   537	        词汇分裂当场暴露。生产路径不受影响 —— 服务层三处出口实测只发
   538	        ServiceStatus 的四个 value (见验收单 §三)。
   539	        """
   540	        payload = _history_payload(status="ok", reason=None, items=[])
   541	        payload["retrieval_status"] = "sort-of-ok"  # 第五种词汇
   542	        mock_memory_service.get_learning_history.return_value = payload
   543	
   544	        app = FastAPI()
   545	        app.include_router(memory_router, prefix="/api/v1/memory")
   546	
   547	        async def _override_service():
   548	            yield mock_memory_service
   549	
   550	        app.dependency_overrides[get_memory_service] = _override_service
   551	        app.dependency_overrides[require_internal_api_key] = lambda: None
   552	        # raise_server_exceptions=False → 让服务端异常表现为 HTTP 5xx 而非
   553	        # 直接把异常抛进测试, 这样断言的是**客户端实际看到什么**。
   554	        with TestClient(app, raise_server_exceptions=False) as c:
   555	            response = c.get("/api/v1/memory/episodes?user_id=user-001")
   556	
   557	        assert response.status_code >= 500
