    83	class ResourceMonitor:
    84	    """
    85	    System resource monitor with Prometheus metrics integration.
    86	
    87	    Provides methods for collecting CPU, memory, and disk metrics
    88	    with configurable thresholds and alert levels.
    89	
    90	    [Source: docs/architecture/performance-monitoring-architecture.md:281-320]
   365	    Convenience function for getting resource metrics without
   366	    instantiating a ResourceMonitor.
   367	
   368	    [Source: specs/api/canvas-api.openapi.yml:661-700]
   369	
   370	    Returns:
   371	        Dictionary with cpu, memory, and disk metrics
   372	
   373	    Example:
   374	        >>> snapshot = get_resource_metrics_snapshot()
   375	        >>> print(snapshot["cpu"]["percent"])
   376	    """
   377	    monitor = ResourceMonitor()
   378	    return monitor.collect_metrics()
