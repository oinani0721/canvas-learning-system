    45	def _resolve_lancedb_db_path() -> str:
    46	    """
    47	    RAG-S0-2026-08-02 (阶段 0 止血): resolve the LanceDB data directory.
    48	
    49	    Canonical env var is LANCEDB_DATA_PATH (what docker-compose sets).
    50	    LANCEDB_PATH is kept as a legacy fallback only — the old code read ONLY
    51	    LANCEDB_PATH, which compose never set, so the pipeline silently connected
    52	    to an empty directory for 3 months (P0-B root cause).
    53	
    54	    Fail fast when both are set to different values: a silent winner would
    55	    reintroduce the empty-directory failure mode.
    56	    """
    57	    canonical = os.environ.get("LANCEDB_DATA_PATH")
    58	    legacy = os.environ.get("LANCEDB_PATH")
    59	    if canonical and legacy and canonical != legacy:
    60	        raise RuntimeError(
    61	            f"Conflicting LanceDB paths: LANCEDB_DATA_PATH={canonical!r} vs "
    62	            f"LANCEDB_PATH={legacy!r}. LANCEDB_DATA_PATH is canonical — unset "
    63	            "the deprecated LANCEDB_PATH or make both values identical."
    64	        )
    65	    return canonical or legacy or "data/lancedb"
    66	
