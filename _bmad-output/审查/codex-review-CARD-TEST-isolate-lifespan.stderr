   101	                assert response.status_code == 409
   102	
   103	    @pytest.mark.asyncio
   104	    async def test_409_response_detail_format(self):
   105	        """AC2: 409 response should have correct detail format."""
   106	        cache_key = request_cache.get_key("test.canvas", "node123", "explain_oral")
   107	        request_cache.mark_in_progress(cache_key)
   108	
   109	        async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
   110	            with patch("app.api.v1.endpoints.agents.check_duplicate_request") as mock_check:
   111	                from fastapi import HTTPException
   112	
   113	                mock_check.side_effect = HTTPException(
   114	                    status_code=409,
   115	                    detail={
   116	                        "error": "Duplicate request",
   117	                        "message": "相同请求正在处理中，请稍候",
   118	                        "canvas_name": "test.canvas",
   119	                        "node_id": "node123",
   120	                        "agent_type": "explain_oral",
   121	                        "is_retryable": False,
   122	                    },
   123	                )
   124	
   125	                response = await ac.post(
   126	                    "/api/v1/agents/explain/oral",
   127	                    json={"canvas_name": "test.canvas", "node_id": "node123"},
   128	                )
   129	
   130	                assert response.status_code == 409
   131	                detail = response.json()["detail"]
   132	                assert detail["error"] == "Duplicate request"
   133	                assert detail["is_retryable"] is False
   134	                assert "canvas_name" in detail
   135	                assert "node_id" in detail
   136	                assert "agent_type" in detail
   137	
   138	
   139	class TestDedupConfigToggle:
   140	    """Tests for config-based dedup enable/disable (AC6)."""
   141	
   142	    def test_dedup_disabled_allows_duplicate(self):
   143	        """AC6: When ENABLE_REQUEST_DEDUP=false, duplicates should be allowed."""
   144	        from app.api.v1.endpoints.agents import check_duplicate_request
   145	        from app.config import settings
   146	
   147	        # Save original value
   148	        original_value = settings.ENABLE_REQUEST_DEDUP
   149	
   150	        try:
   151	            # Temporarily disable dedup
   152	            object.__setattr__(settings, "ENABLE_REQUEST_DEDUP", False)
   153	
   154	            request_cache.clear()
   155	            # Should return empty string (dedup disabled)
   156	            result = check_duplicate_request("test.canvas", "node123", "oral")
   157	            assert result == ""
   158	        finally:
   159	            # Restore original value
   160	            object.__setattr__(settings, "ENABLE_REQUEST_DEDUP", original_value)
   161	
   162	    def test_dedup_enabled_by_default(self):
   163	        """Dedup should be enabled by default."""
   164	        from app.config import settings
   165	
   166	        assert settings.ENABLE_REQUEST_DEDUP is True
   167	
   168	
   169	class TestDedupHelperFunctions:
   170	    """Tests for dedup helper functions in agents.py."""
