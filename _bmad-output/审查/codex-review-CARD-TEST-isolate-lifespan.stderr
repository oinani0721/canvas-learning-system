   422	
   423	@mastery_router.post("/mastery/graphiti-sync")
   424	async def knowledge_graph_sync(
   425	    req: GraphitiSyncRequest,
   426	    vault_id: Optional[str] = Query(
   427	        default=None,
   428	        min_length=1,
   429	        description="Multi-vault P0-2 — 推荐必填.",
   430	    ),
   431	    subject_id: Optional[str] = Query(default=None),
   432	    group_id: Optional[str] = Query(
   433	        default=None, deprecated=True, description="Deprecated — 改用 vault_id."
   434	    ),
   435	):
   436	    """
   437	    Bridge: Graphiti misconception/ProblemTrap → mastery penalty.
   438	
   439	    Called by Claude Code (via CLAUDE.md instruction) after recording a
   440	    Misconception or ProblemTrap to the knowledge graph. Looks up the
   441	    concept by name and applies a mastery adjustment.
   442	
   443	    Signal types:
   444	      - misconception: p_mastery -= severity (direct penalty)
   445	      - problem_trap: p_mastery -= severity * 0.5 (softer penalty)
   446	      - guided_thinking_correct: p_mastery += severity (small boost)
   447	    """
   448	    if req.signal not in ("misconception", "problem_trap", "guided_thinking_correct"):
   449	        raise HTTPException(
   450	            400,
   451	            f"Invalid signal type: {req.signal}. Must be: misconception, problem_trap, guided_thinking_correct",
   452	        )
   453	
   454	    resolved_group_id = _resolve_vault_group_id(
   455	        vault_id, subject_id=subject_id, legacy_group_id=group_id
   456	    )
   457	    engine = _get_engine()
   458	    store = _get_store()
   459	
   460	    # Try to find existing concept by name (fuzzy match)
   461	    concept = await store.find_concept_by_name(req.concept_name, resolved_group_id)
   462	
   463	    if not concept:
   464	        # Create new concept with low initial mastery
   465	        concept = await store.get_or_create_concept(
   466	            concept_id=f"graphiti_{req.concept_name[:40]}",
   467	            topic=req.topic or "Unknown",
   468	            name=req.concept_name,
   469	            group_id=resolved_group_id,
   470	        )
   471	
   472	    old_mastery = concept.p_mastery
   473	    concept = engine.apply_external_signal(concept, req.signal, req.severity)
   474	    await store.save_concept(concept, resolved_group_id)
   475	
   476	    logger.info(
   477	        f"Graphiti sync: {req.concept_name} ({req.signal}, severity={req.severity}) "
   478	        f"p_mastery {old_mastery:.3f} -> {concept.p_mastery:.3f}"
   479	    )
   480	
   481	    return {
   482	        "matched": True,
   483	        "concept": engine.concept_to_response(concept),
   484	        "adjustment": {
   485	            "signal": req.signal,
   486	            "severity": req.severity,
   487	            "old_p_mastery": round(old_mastery, 3),
   488	            "new_p_mastery": round(concept.p_mastery, 3),
   489	        },
   490	    }
   491	
   492	
