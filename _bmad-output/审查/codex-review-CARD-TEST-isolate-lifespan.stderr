   149	
   150	async def wait_for_mock_call(
   151	    mock_method,
   152	    *,
   153	    timeout: float = 2.0,
   154	    interval: float = 0.05,
   155	    expected_count: int = 1,
   156	):
   157	    """Poll until mock is called expected number of times or timeout.
   158	
   159	    Use instead of asyncio.sleep() to wait for fire-and-forget background tasks.
   160	
   161	    Args:
   162	        mock_method: The mock to check call_count on.
   163	        timeout: Maximum wait time in seconds.
   164	        interval: Polling interval in seconds.
   165	        expected_count: Minimum call_count to wait for.
   166	
   167	    Raises:
   168	        TimeoutError: If mock not called within timeout.
   169	    """
   170	    loop = asyncio.get_running_loop()
   171	    start = loop.time()
   172	    while (loop.time() - start) < timeout:
   173	        if mock_method.call_count >= expected_count:
   174	            return
   175	        await asyncio.sleep(interval)
   176	    raise TimeoutError(
   177	        f"{mock_method} not called {expected_count} time(s) within {timeout}s (actual: {mock_method.call_count})"
   178	    )
   179	
   180	
   181	async def wait_for_condition(
   182	    condition_fn,
   183	    *,
   184	    timeout: float = 2.0,
   185	    interval: float = 0.05,
   186	    description: str = "condition",
   187	):
   188	    """Poll until condition_fn returns truthy or timeout.
   189	
   190	    Use for integration tests where there is no mock to wait on
   191	    (e.g., waiting for a file to be written by a real service).
   192	
   193	    Args:
   194	        condition_fn: Callable returning truthy when done. May be sync or async.
   195	        timeout: Maximum wait time in seconds.
   196	        interval: Polling interval in seconds.
   197	        description: Human-readable label for error messages.
   198	
   199	    Raises:
   200	        TimeoutError: If condition not met within timeout.
   201	    """
   202	    loop = asyncio.get_running_loop()
   203	    start = loop.time()
   204	    last_error = None
   205	    while (loop.time() - start) < timeout:
   206	        try:
   207	            result = condition_fn()
   208	            if asyncio.iscoroutine(result):
   209	                result = await result
   210	            if result:
   211	                return result
   212	        except (AssertionError, Exception) as e:
   213	            last_error = e
   214	        await asyncio.sleep(interval)
   215	    msg = f"{description} not met within {timeout}s"
   216	    if last_error:
   217	        msg += f" (last error: {last_error})"
   218	    raise TimeoutError(msg)
   219	
   220	
   221	async def yield_to_event_loop(iterations: int = 5):
   222	    """Yield control to the event loop for pending tasks.
   223	
   224	    Use instead of asyncio.sleep(0.1) when you just need to let
   225	    fire-and-forget tasks run but have nothing specific to wait for
   226	    (e.g., assert_not_called scenarios).
   227	    """
   228	    for _ in range(iterations):
   229	        await asyncio.sleep(0)
   230	
   231	
   232	async def simulate_async_delay(seconds: float):
   233	    """Simulate an async operation taking *seconds* to complete.
   234	
   235	    Use inside mock ``side_effect`` callables to represent slow I/O
   236	    (network, disk, LLM calls) without sprinkling raw ``asyncio.sleep``
   237	    throughout test files.  Keeps the *grep-zero* invariant while
   238	    preserving intentional delay semantics for timeout / concurrency tests.
   239	    """
   240	    await asyncio.sleep(seconds)
   241	
