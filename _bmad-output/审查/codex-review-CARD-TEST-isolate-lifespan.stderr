   263	@chat_router.post(
   264	    "/enrich-context",
   265	    response_model=EnrichContextResponse,
   266	    status_code=status.HTTP_200_OK,
   267	    summary="Story 2.1 — 节点对话上下文组装",
   268	    description=(
   269	        "调用 wikilink graph 服务获取 N-hop 邻居，"
   270	        "按优先级填充 token 预算（公式 / 代码块保护），返回 LLM-ready 上下文字符串。"
   271	        "AC #5: 图服务降级时返回 degraded=True + 仅当前笔记内容。"
   272	    ),
   273	)
   274	async def enrich_context(req: EnrichContextRequest) -> EnrichContextResponse:
   275	    if not req.node_path.strip():
   276	        raise HTTPException(
   277	            status_code=status.HTTP_400_BAD_REQUEST,
   278	            detail="node_path 不能为空",
   279	        )
   280	
   281	    # Multi-vault P0-1 (2026-05-10) — 注入 ContextVar 防 5 vault 串库。
   282	    # Plugin 传 raw vault name (inferVaultId(app.vault.getName()))。
   283	    # CARD-G2-2 (2026-08-28) Codex round-1 BLOCKER-1 整改: 本端点原为
   284	    # sanitize/build/set 的第 9 份克隆, 完全绕过 409 —— 请求可携异 vault
   285	    # 名读取该 vault 的记忆。它**不是** hook-cwd 例外 (vault_id 是显式
   286	    # 请求字段), 改走唯一解析点, 不一致即 409。
   287	    from app.core.vault_scope import resolve_vault_scope
   288	
   289	    _scope = resolve_vault_scope(
   290	        req.vault_id,
   291	        subject_id=req.subject_id,
   292	        canvas_path=req.node_path,
   293	    )
   294	    derived_group_id = _scope.group_id
   295	    # 归一后的 vault 段 (原 sanitized_vault_id): 409 门保证它等于 active vault
   296	    sanitized_vault_id = _scope.vault_id
   297	
   298	    enrichment = await enrich_from_wikilink_graph(
   299	        node_path=req.node_path,
   300	        max_hops=req.max_hops,
   301	        timeout_ms=req.timeout_ms,
   302	    )
   303	
   304	    # Story 2.3 (2026-05-13) — Historical error reminders (Task 3 + Task 4).
   305	    # 检索当前节点的历史误解记录, 3s 超时, Graphiti/Neo4j 不可用静默降级.
   306	    # AC #3 性能门槛: search_memories < 3s; AC #4: 降级时对话照常进行, 不感知.
   307	    # 双路径熔断: TimeoutError = 检索超时; (ConnectionError/RuntimeError/OSError)
   308	    # = 后端服务不可用; reason 字段区分根因便于 ops 诊断.
   309	    historical_errors: list[dict[str, Any]] = []
   310	    _hist_node_slug = Path(req.node_path).stem
   311	    _hist_start_ms = asyncio.get_event_loop().time()
   312	    try:
   313	        _mem_svc = await get_memory_service()
   314	        historical_errors = await asyncio.wait_for(
   315	            _mem_svc.search_error_memories(
   316	                node_id=_hist_node_slug,
   317	                group_id=derived_group_id,
   318	                limit=5,
   319	            ),
   320	            timeout=3.0,
   321	        )
   322	        _hist_elapsed_ms = int((asyncio.get_event_loop().time() - _hist_start_ms) * 1000)
   323	        logger.info(
   324	            "story_2_3_error_memories_loaded",
   325	            node_id=_hist_node_slug,
   326	            group_id=derived_group_id,
   327	            count=len(historical_errors),
   328	            memory_search_latency_ms=_hist_elapsed_ms,
   329	        )
   330	    except asyncio.TimeoutError:
   331	        # AC #3 超时降级: 3s 内 search_memories 未返回 → 空 list, 对话继续
   332	        _hist_elapsed_ms = int((asyncio.get_event_loop().time() - _hist_start_ms) * 1000)
   333	        logger.warning(
   334	            "story_2_3_error_memories_timeout",
   335	            node_id=_hist_node_slug,
   336	            group_id=derived_group_id,
   337	            timeout_seconds=3.0,
   338	            memory_search_latency_ms=_hist_elapsed_ms,
   339	            reason="search_timeout",
   340	        )
   341	        historical_errors = []
   342	    except (ConnectionError, RuntimeError, OSError) as exc:
   343	        # AC #4 服务不可用降级: Graphiti/Neo4j 连接失败 → 空 list, 对话继续
   344	        # 包含 neo4j.exceptions.ServiceUnavailable (RuntimeError 子类).
   345	        _hist_elapsed_ms = int((asyncio.get_event_loop().time() - _hist_start_ms) * 1000)
   346	        logger.warning(
   347	            "story_2_3_error_memories_degraded",
   348	            node_id=_hist_node_slug,
   349	            group_id=derived_group_id,
   350	            memory_search_latency_ms=_hist_elapsed_ms,
   351	            reason="service_unavailable",
   352	            error=str(exc),
   353	        )
   354	        historical_errors = []
   355	
   356	    assembler = ChatContextAssembler(token_budget=req.token_budget)
   357	    current_note = CurrentNoteContext(
   358	        path=req.node_path,
   359	        content=req.current_note_content,
   360	        frontmatter=req.current_note_frontmatter,
   361	    )
   362	    # Wave-5 Stage A (2026-05-12) — manifest 顶行加 `Vault: <vault_id>`,
   363	    # 让 Claude 在读 prompt 时立刻看到 vault 归属,多 vault 并存避免交叉引用
   364	    # ("数据冲突和数据混乱" — 用户原话).透传 sanitized_vault_id (已 NFKC + casefold).
   365	    assembled = assembler.assemble_context(
   366	        current_note=current_note,
   367	        neighbors=enrichment.neighbors,
   368	        token_budget=req.token_budget,
   369	        trace=enrichment.trace,
   370	        vault_id=sanitized_vault_id,
   371	        historical_errors=historical_errors,
   372	    )
   373	
   374	    final_text = assembled.text
   375	    if enrichment.degraded:
   376	        final_text += f"\n\n---\n邻居上下文暂时不可用（{enrichment.degraded_reason}），仅基于当前笔记回答。"
   377	
