   386	    concept = engine.set_self_assess(concept, req.color)
   387	    await store.save_concept(concept, resolved_group_id)
   388	    await store.record_self_assess_event(concept_id, req.color, resolved_group_id)
   389	
   390	    return engine.concept_to_response(concept)
