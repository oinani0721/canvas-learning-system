    58	#: 原文件里的隔离形态（必须恰好出现一次，否则说明文件已被动过，先停下来）。
    59	ANCHOR = "with no_lifespan(app), TestClient(app) as c:"
    60	MUTATED = "with TestClient(app) as c:"
    61	
    62	#: 与 tests/support/live_port_guard.py 的 BLOCK_REASON 保持一致。
    63	EXPECTED_REASON = "live Neo4j port connect attempted"
    64	
    65	#: 与 backend/scripts/lifespan_isolation_runtime_sha.sh 的监视清单保持一致。
    66	RUNTIME_FILES = [
    67	    BACKEND_DIR / "data/bug_log.jsonl",
    68	    BACKEND_DIR / "app/data/vault_index_pending.jsonl",
    69	    BACKEND_DIR / "data/outbox/events.jsonl",
    70	]
    71	
    72	PYTEST_TIMEOUT_S = 900
    73	
    74	# ═══════════════════════════════════════════════════════════════════════════
    75	# 裁判 6 的 AST 门 —— 静态扫描「裸 with TestClient(app.main 的 app)」
    76	# ═══════════════════════════════════════════════════════════════════════════
    77	
    78	#: 扫描范围（与卡文裁判 6 一致）。tests/integration、tests/e2e、regression
    79	#: 及其它根级文件**不在射程**：前者按路径豁免（advisory），后者吃根 conftest
    80	#: 的 lifespan-free client fixture，不自带 with TestClient。
    81	AST_SCOPE_DIRS = ["tests/api", "tests/unit"]
    82	AST_SCOPE_FILES = [
    83	    "tests/test_debug.py",
    84	    "tests/test_deep_monitoring.py",
    85	    "tests/conftest.py",
    86	]
    87	
    88	#: 同一 with 语句里出现这些名字的兄弟 context manager 即视为已隔离。
    89	ISOLATION_HELPER_NAMES = {"no_lifespan", "lifespan_lite"}
    90	
    91	
    92	def _call_name(node: ast.expr) -> str | None:
    93	    """Call(...) 的函数名（仅 Name 形式），否则 None。"""
    94	    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
    95	        return node.func.id
    96	    return None
    97	
    98	
    99	class _ScopeResolver:
   100	    """把 with TestClient(x) 里的名字 x 解析到来源。
   101	
   102	    识别三种来源：
   103	      * ``app.main`` —— ``from app.main import app``（模块级或函数内）；
   104	      * ``FastAPI()`` —— 局部应用（test_rag_four_state_api 等正例）；
   105	      * 其它/解析失败 —— 保守按违规处理（人工复核）。
   106	
   107	    ⚠️ 识别范围与局限：只跟踪 Name 绑定（import / 赋值 / with..as），
   108	    只认「同一 with 语句内的 no_lifespan/lifespan_lite 兄弟项」为隔离
   109	    形态；嵌套两层 with（外层 no_lifespan、内层 TestClient）不在识别
   110	    范围内 —— 当前代码库无此形态，若出现会被保守报违规，人工复核。
   111	    """
   112	
   113	    def __init__(self, tree: ast.Module) -> None:
   114	        self.module_imports_app_main = False
   115	        self.module_fastapi_names: set[str] = set()
   116	        for node in tree.body:
   117	            if isinstance(node, ast.ImportFrom) and node.module == "app.main":
   118	                for alias in node.names:
   119	                    if alias.name == "app":
   120	                        self.module_imports_app_main = True
   121	            elif isinstance(node, ast.Assign):
   122	                if _call_name(node.value) == "FastAPI":
   123	                    for t in node.targets:
   124	                        if isinstance(t, ast.Name):
   125	                            self.module_fastapi_names.add(t.id)
   126	
   127	    def resolve(self, name: str, func_stack: list[ast.AST]) -> str:
   128	        for scope in reversed(func_stack):
   129	            if isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef)):
   130	                for node in ast.walk(scope):
   131	                    if isinstance(node, ast.ImportFrom) and node.module == "app.main":
   132	                        if any(a.name == "app" for a in node.names):
   133	                            return "app.main"
   134	                for stmt in scope.body:
   135	                    for node in ast.walk(stmt):
   136	                        if (
   137	                            isinstance(node, ast.Assign)
   138	                            and _call_name(node.value) == "FastAPI"
   139	                        ):
   140	                            for t in node.targets:
   141	                                if isinstance(t, ast.Name) and t.id == name:
   142	                                    return "FastAPI()"
   143	        if name in self.module_fastapi_names:
   144	            return "FastAPI()"
   145	        if self.module_imports_app_main:
   146	            return "app.main"
   147	        return "unknown"
   148	
   149	
   150	def run_ast_gate() -> tuple[int, list[str], int]:
   151	    """返回 (违规数, 违规明细, 扫描的文件数)。"""
   152	    files: list[Path] = []
   153	    for d in AST_SCOPE_DIRS:
   154	        files.extend(sorted((BACKEND_DIR / d).rglob("test_*.py")))
   155	    for f in AST_SCOPE_FILES:
   156	        p = BACKEND_DIR / f
   157	        if p.exists():
   158	            files.append(p)
   159	
   160	    violations: list[str] = []
   161	    for path in files:
   162	        try:
   163	            tree = ast.parse(path.read_text(encoding="utf-8"))
   164	        except SyntaxError as e:
   165	            violations.append(f"{path}: SyntaxError {e}")
   166	            continue
   167	        resolver = _ScopeResolver(tree)
   168	        rel = path.relative_to(BACKEND_DIR)
   169	        for node in ast.walk(tree):
   170	            if not isinstance(node, (ast.With, ast.AsyncWith)):
   171	                continue
   172	            helper_names = {
   173	                n
   174	                for item in node.items
   175	                if (n := _call_name(item.context_expr)) in ISOLATION_HELPER_NAMES
   176	            }
   177	            if helper_names:
   178	                continue
   179	            for item in node.items:
   180	                if _call_name(item.context_expr) != "TestClient":
   181	                    continue
   182	                args = item.context_expr.args  # type: ignore[union-attr]
   183	                if not args:
   184	                    violations.append(f"{rel}: TestClient() 无参 —— 人工复核")
   185	                    continue
   186	                arg = args[0]
   187	                if isinstance(arg, ast.Name):
   188	                    origin = resolver.resolve(arg.id, [tree])
   189	                elif _call_name(arg) == "FastAPI":
   190	                    origin = "FastAPI()"
   191	                else:
   192	                    origin = "unknown"
   193	                if origin != "app.main":
   194	                    continue
   195	                arg_desc = arg.id if isinstance(arg, ast.Name) else "<expr>"
   196	                violations.append(
   197	                    f"{rel}:{node.lineno}: with TestClient({arg_desc})"
   198	                    " —— app 来自 app.main 且无 no_lifespan 隔离"
   199	                )
   200	    return len(violations), violations, len(files)
   201	
   202	
   203	def sha_of(path: Path) -> str:
   204	    if not path.exists():
   205	        return "absent"
   206	    return hashlib.sha256(path.read_bytes()).hexdigest()
   207	
   208	
   209	def runtime_snapshot() -> str:
   210	    return "\n".join(f"{sha_of(p)}  {p}" for p in RUNTIME_FILES)
   211	
   212	
   213	def main() -> int:
   214	    print("=== lifespan isolation NEGATIVE CONTROL ===")
   215	
   216	    # -- 0-保险. 门必须已装进根 conftest，否则变异态会真连现网 7691 ---------
   217	    # 本脚本摘掉 no_lifespan 后，子进程会跑真实 lifespan。若 socket 门
   218	    # （根 conftest 的 live_port_guard 安装）不在位，这就是一次真实的现网
   219	    # 连接（预热 + 幂等 DDL）——2026-09-01 预演实证过这个漏洞。宁可拒跑。
   220	    conftest_text = (BACKEND_DIR / "tests/conftest.py").read_text(encoding="utf-8")
   221	    if "live_port_guard" not in conftest_text:
   222	        print(
   223	            "NEGATIVE-CONTROL: REFUSED — 根 tests/conftest.py 尚未安装 "
   224	            "live_port_guard socket 门；此时变异会令子进程真实连接现网 7691。"
   225	            "先落地门，再跑负控。"
   226	        )
   227	        return 2
   228	
   229	    # -- 0a. AST 门（裁判 6）-------------------------------------------------
   230	    n_violations, violation_lines, n_files = run_ast_gate()
   231	    print(f"[0] AST gate: {n_violations} violations across {n_files} files")
   232	    for v in violation_lines:
   233	        print(f"    VIOLATION: {v}")
   234	    if "--ast-only" in sys.argv:
   235	        if n_violations:
   236	            print("AST-GATE: FAIL")
   237	            return 1
   238	        print(f"AST-GATE: PASS (0 violations in {n_files} files)")
   239	        return 0
   240	
   241	    # -- 0. 前置校验 ---------------------------------------------------------
   242	    if not TARGET.exists():
   243	        print(f"NEGATIVE-CONTROL: FAIL — 目标文件不存在: {TARGET}")
   244	        return 1
   245	    original = TARGET.read_bytes()
   246	    original_text = original.decode("utf-8")
   247	    count = original_text.count(ANCHOR)
   248	    if count != 1:
   249	        print(
   250	            f"NEGATIVE-CONTROL: FAIL — 隔离锚点出现 {count} 次（期望恰好 1 次），"
   251	            f"文件形态与本脚本假设不符，拒绝盲改: {TARGET}"
   252	        )
   253	        return 1
   254	
   255	    tmp_root = Path(tempfile.mkdtemp(prefix="lifespan-negctl-"))
   256	    junit_xml = tmp_root / "negctl-junit.xml"
   257	    vault_tmp = tmp_root / "vault"
   258	    lance_tmp = tmp_root / "lancedb"
   259	    vault_tmp.mkdir()
   260	    lance_tmp.mkdir()
   261	
   262	    before_runtime = runtime_snapshot()
   263	    mutated_ok = False
   264	    pytest_rc: int | None = None
   265	    try:
   266	        # -- 1. 原地摘掉 no_lifespan ----------------------------------------
   267	        mutated_text = original_text.replace(ANCHOR, MUTATED)
   268	        TARGET.write_bytes(mutated_text.encode("utf-8"))
   269	        mutated_ok = True
   270	        print(f"[1] 已摘掉 no_lifespan: {TARGET_REL}")
   271	
   272	        # -- 2. 跑该文件（走根 conftest 的门 + 哨兵）------------------------
   273	        env = os.environ.copy()
   274	        env["CANVAS_BASE_PATH"] = str(vault_tmp)
   275	        env["LANCEDB_DATA_PATH"] = str(lance_tmp)
   276	        env["PYTHONDONTWRITEBYTECODE"] = "1"
   277	        cmd = [
   278	            str(BACKEND_DIR / ".venv/bin/pytest"),
   279	            TARGET_REL,
   280	            "-q",
   281	            "--tb=no",
   282	            "-p",
   283	            "no:cacheprovider",
   284	            f"--junitxml={junit_xml}",
   285	            "--override-ini=addopts=",
   286	        ]
   287	        print("[2] pytest 子进程（串行）:", " ".join(cmd))
   288	        proc = subprocess.run(
   289	            cmd,
   290	            cwd=BACKEND_DIR,
   291	            env=env,
   292	            capture_output=True,
   293	            text=True,
   294	            timeout=PYTEST_TIMEOUT_S,
   295	        )
   296	        pytest_rc = proc.returncode
   297	        print(f"    pytest exit={pytest_rc}")
   298	
   299	        # -- 3. 解析 junitxml，逐用例核对红因 --------------------------------
   300	        if not junit_xml.exists():
   301	            print("NEGATIVE-CONTROL: FAIL — junitxml 未生成，pytest 未跑到收集阶段")
   302	            print("--- stdout tail ---")
   303	            print(proc.stdout[-2000:])
   304	            return 1
   305	        root = ET.parse(junit_xml).getroot()
   306	        cases = root.iter("testcase")
   307	        total = 0
   308	        red_for_right_reason = 0
   309	        green: list[str] = []
   310	        red_for_wrong_reason: list[str] = []
   311	        for case in cases:
   312	            classname = case.get("classname", "")
   313	            name = case.get("name", "")
   314	            nodeid = f"{classname.replace('.', '/')}.py::{name}" if classname else name
   315	            total += 1
   316	            failure = case.find("failure")
   317	            if failure is None:
   318	                green.append(nodeid)
   319	                continue
   320	            text = " ".join(
   321	                filter(None, [(failure.get("message") or ""), (failure.text or "")])
   322	            )
   323	            if EXPECTED_REASON in text:
   324	                red_for_right_reason += 1
   325	            else:
   326	                red_for_wrong_reason.append(f"{nodeid} :: {text[:160]}")
   327	
   328	        print(
   329	            f"[3] junitxml: total={total} red-right-reason={red_for_right_reason} "
   330	            f"green={len(green)} red-wrong-reason={len(red_for_wrong_reason)}"
   331	        )
   332	        for g in green:
   333	            print(f"    GREEN (不应绿): {g}")
   334	        for w in red_for_wrong_reason:
   335	            print(f"    RED-WRONG-REASON: {w}")
   336	    finally:
   337	        # -- 4. 逐字节还原（无论上面死在哪一步）------------------------------
   338	        if mutated_ok:
   339	            TARGET.write_bytes(original)
   340	        restored_identical = sha_of(TARGET) == hashlib.sha256(original).hexdigest()
   341	        after_runtime = runtime_snapshot()
   342	        runtime_unchanged = before_runtime == after_runtime
   343	
   344	    print(f"[4] 还原完成; byte-identical={restored_identical}; runtime sha unchanged={runtime_unchanged}")
   345	    if not restored_identical:
   346	        print("NEGATIVE-CONTROL: FAIL — 源文件未能逐字节还原（这是事故，请人工检查 git diff）")
   347	        return 1
   348	    shutil.rmtree(tmp_root, ignore_errors=True)
   349	
   350	    # -- 5. 裁定 --------------------------------------------------------------
   351	    problems: list[str] = []
   352	    if pytest_rc is None:
   353	        problems.append("pytest 未运行")
   354	    if total == 0:
   355	        problems.append("junitxml 里 0 个用例 — 收集失败")
   356	    if green:
   357	        problems.append(f"{len(green)} 个用例在 no_lifespan 摘除后仍然绿（哨兵没接住）")
   358	    if red_for_wrong_reason:
   359	        problems.append(f"{len(red_for_wrong_reason)} 个用例红了但原因不对（不是 live port connect）")
   360	    if not runtime_unchanged:
   361	        problems.append("运行时文件 sha 变化 — 门没能在 connect 前拦住（或写路径被触发）")
   362	    if n_violations:
   363	        problems.append(f"AST 门 {n_violations} 处违规（见上方 VIOLATION 清单）")
   364	
   365	    if problems:
   366	        print("NEGATIVE-CONTROL: FAIL")
   367	        for p in problems:
   368	            print(f"  - {p}")
   369	        return 1
   370	
   371	    print(
   372	        f"NEGATIVE-CONTROL: PASS ({red_for_right_reason} nodeids red for expected "
   373	        f"reason; runtime files unchanged; restored byte-identical; AST-GATE: "
   374	        f"PASS 0/{n_files} files)"
   375	    )
   376	    return 0
   377	
   378	
   379	if __name__ == "__main__":
   380	    sys.exit(main())
     1	#!/usr/bin/env bash
     2	# 运行时文件门 —— 证明「跑测试没动生产运行时数据」。
     3	#
     4	# [BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     5	#
     6	# 用法:
     7	#   bash backend/scripts/lifespan_isolation_runtime_sha.sh -- <要跑的命令...>
     8	#
     9	# 例:
    10	#   bash scripts/lifespan_isolation_runtime_sha.sh -- .venv/bin/pytest tests/api -q
    11	#
    12	# 判据: 三个受监视文件在命令前后 **逐字节相同**（sha256 相等，或前后都不存在）。
    13	#       任一不同 → 打印 `RUNTIME-FILES: CHANGED` 并 exit 1。
    14	#
    15	# ## 这道门不比什么（诚实边界）
    16	#
    17	# * 只看这三个**具名**文件。lifespan 若写了别的路径（新增的日志/缓存/临时文件），
    18	#   本门看不到 —— 它证明的是「这三个已知受害者没被动」，不是「全盘零写入」。
    19	# * 只比首尾两个时刻。命令中途写进去、结束前又改回原内容，本门判 unchanged。
    20	# * 不看 live vault、不看 Neo4j。数据库里被 DDL 改了 schema，本门照样绿
    21	#   —— 那是 socket 门（backend/tests/support/live_port_guard.py）的职责。
    22	# * `absent → absent` 与 `present 且 sha 不变` 同样算 unchanged；两者语义不同，
    23	#   脚本会逐条打印实际状态，不要只看最后一行结论。
    24	#
    25	# 退出码:
    26	#   1  = 文件被改（门的裁定）
    27	#   其它 = 被包裹命令自己的退出码（测试红了照样透出来，不被门吞掉）
    28	
    29	set -uo pipefail
    30	
    31	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    32	BACKEND_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    33	
    34	# 受监视文件 —— 均 git-ignored 的运行时产物，均由 app/main.py 的 lifespan 链写。
    35	#   bug_log.jsonl            <- app/services/bug_tracker.py
    36	#   vault_index_pending.jsonl<- app/services/vault_index_orchestrator.py
    37	#   outbox/events.jsonl      <- app/services/event_bus.py
    38	WATCHED=(
    39	  "${BACKEND_DIR}/data/bug_log.jsonl"
    40	  "${BACKEND_DIR}/app/data/vault_index_pending.jsonl"
    41	  "${BACKEND_DIR}/data/outbox/events.jsonl"
    42	)
    43	EXPECTED_WATCH_COUNT=3
    44	
    45	# 自检: 监视清单不能悄悄变空/变短 —— 空清单会让本门「零比较、恒绿」。
    46	if [ "${#WATCHED[@]}" -ne "${EXPECTED_WATCH_COUNT}" ]; then
    47	  echo "RUNTIME-FILES: GATE-BROKEN — 监视清单有 ${#WATCHED[@]} 项, 期望 ${EXPECTED_WATCH_COUNT} 项" >&2
    48	  exit 1
    49	fi
    50	
    51	if [ "${1:-}" != "--" ]; then
    52	  echo "用法: bash $0 -- <command...>" >&2
    53	  echo "  ('--' 之后的一切原样作为命令执行)" >&2
    54	  exit 2
    55	fi
    56	shift
    57	if [ "$#" -eq 0 ]; then
    58	  echo "RUNTIME-FILES: GATE-BROKEN — '--' 之后没有命令; 拒绝空跑（空跑必然 unchanged, 是假绿）" >&2
    59	  exit 2
    60	fi
    61	
    62	snapshot() {
    63	  # 逐行输出 "<sha256|absent>  <path>"；顺序与 WATCHED 一致。
    64	  local f
    65	  for f in "${WATCHED[@]}"; do
    66	    if [ -f "$f" ]; then
    67	      printf '%s  %s\n' "$(shasum -a 256 "$f" | awk '{print $1}')" "$f"
    68	    else
    69	      printf 'absent  %s\n' "$f"
    70	    fi
    71	  done
    72	}
    73	
    74	BEFORE="$(snapshot)"
    75	echo "=== RUNTIME-FILES before ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    76	echo "${BEFORE}"
    77	echo "=== 执行被包裹命令 ==="
    78	echo "\$ $*"
    79	
    80	set +e
    81	"$@"
    82	CMD_RC=$?
    83	set -e
    84	
    85	AFTER="$(snapshot)"
    86	echo "=== RUNTIME-FILES after ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    87	echo "${AFTER}"
    88	echo "WRAPPED-COMMAND-EXIT: ${CMD_RC}"
    89	
    90	if [ "${BEFORE}" != "${AFTER}" ]; then
    91	  echo "RUNTIME-FILES: CHANGED"
    92	  echo "--- diff (before vs after) ---"
    93	  diff <(echo "${BEFORE}") <(echo "${AFTER}") || true
    94	  exit 1
    95	fi
    96	
    97	echo "RUNTIME-FILES: unchanged"
    98	exit "${CMD_RC}"

