   257	def test_metrics_endpoint_handles_concurrent_requests(client):
   258	    """Test that metrics endpoints handle concurrent requests."""
   259	    import threading
   260	
   261	    results = []
   262	
   263	    def make_request():
   264	        response = client.get("/api/v1/health/metrics/summary")
   265	        results.append(response.status_code)
   266	
   267	    threads = [threading.Thread(target=make_request) for _ in range(5)]
   268	    for t in threads:
   269	        t.start()
   270	    for t in threads:
   271	        t.join()
   272	
   273	    # All requests should succeed
   274	    assert all(status == 200 for status in results)
