     1	#!/usr/bin/env bash
     2	# 运行时文件门 —— 证明「跑测试没动生产运行时数据」。
     3	#
     4	# [BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     5	#
     6	# 用法:
     7	#   bash backend/scripts/lifespan_isolation_runtime_sha.sh -- <要跑的命令...>
     8	#
     9	# 例:
    10	#   bash scripts/lifespan_isolation_runtime_sha.sh -- .venv/bin/pytest tests/api -q
    11	#
    12	# 判据: 三个受监视文件在命令前后 **逐字节相同**（sha256 相等，或前后都不存在）。
    13	#       任一不同 → 打印 `RUNTIME-FILES: CHANGED` 并 exit 1。
    14	#
    15	# ## 这道门不比什么（诚实边界）
    16	#
    17	# * 只看这三个**具名**文件。lifespan 若写了别的路径（新增的日志/缓存/临时文件），
    18	#   本门看不到 —— 它证明的是「这三个已知受害者没被动」，不是「全盘零写入」。
    19	# * 只比首尾两个时刻。命令中途写进去、结束前又改回原内容，本门判 unchanged。
    20	# * 不看 live vault、不看 Neo4j。数据库里被 DDL 改了 schema，本门照样绿
    21	#   —— 那是 socket 门（backend/tests/support/live_port_guard.py）的职责。
    22	# * `absent → absent` 与 `present 且 sha 不变` 同样算 unchanged；两者语义不同，
    23	#   脚本会逐条打印实际状态，不要只看最后一行结论。
    24	#
    25	# 退出码:
    26	#   1  = 文件被改（门的裁定）
    27	#   其它 = 被包裹命令自己的退出码（测试红了照样透出来，不被门吞掉）
    28	
    29	set -uo pipefail
    30	
    31	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    32	BACKEND_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    33	
    34	# 受监视文件 —— 均 git-ignored 的运行时产物，均由 app/main.py 的 lifespan 链写。
    35	#   bug_log.jsonl            <- app/services/bug_tracker.py
    36	#   vault_index_pending.jsonl<- app/services/vault_index_orchestrator.py
    37	#   outbox/events.jsonl      <- app/services/event_bus.py
    38	WATCHED=(
    39	  "${BACKEND_DIR}/data/bug_log.jsonl"
    40	  "${BACKEND_DIR}/app/data/vault_index_pending.jsonl"
    41	  "${BACKEND_DIR}/data/outbox/events.jsonl"
    42	)
    43	EXPECTED_WATCH_COUNT=3
    44	
    45	# 自检: 监视清单不能悄悄变空/变短 —— 空清单会让本门「零比较、恒绿」。
    46	if [ "${#WATCHED[@]}" -ne "${EXPECTED_WATCH_COUNT}" ]; then
    47	  echo "RUNTIME-FILES: GATE-BROKEN — 监视清单有 ${#WATCHED[@]} 项, 期望 ${EXPECTED_WATCH_COUNT} 项" >&2
    48	  exit 1
    49	fi
    50	
    51	if [ "${1:-}" != "--" ]; then
    52	  echo "用法: bash $0 -- <command...>" >&2
    53	  echo "  ('--' 之后的一切原样作为命令执行)" >&2
    54	  exit 2
    55	fi
    56	shift
    57	if [ "$#" -eq 0 ]; then
    58	  echo "RUNTIME-FILES: GATE-BROKEN — '--' 之后没有命令; 拒绝空跑（空跑必然 unchanged, 是假绿）" >&2
    59	  exit 2
    60	fi
    61	
    62	snapshot() {
    63	  # 逐行输出 "<sha256|absent>  <path>"；顺序与 WATCHED 一致。
    64	  local f
    65	  for f in "${WATCHED[@]}"; do
    66	    if [ -f "$f" ]; then
    67	      printf '%s  %s\n' "$(shasum -a 256 "$f" | awk '{print $1}')" "$f"
    68	    else
    69	      printf 'absent  %s\n' "$f"
    70	    fi
    71	  done
    72	}
    73	
    74	BEFORE="$(snapshot)"
    75	echo "=== RUNTIME-FILES before ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    76	echo "${BEFORE}"
    77	echo "=== 执行被包裹命令 ==="
    78	echo "\$ $*"
    79	
    80	set +e
    81	"$@"
    82	CMD_RC=$?
    83	set -e
    84	
    85	AFTER="$(snapshot)"
    86	echo "=== RUNTIME-FILES after ($(date '+%Y-%m-%d %H:%M:%S %z')) ==="
    87	echo "${AFTER}"
    88	echo "WRAPPED-COMMAND-EXIT: ${CMD_RC}"
    89	
    90	if [ "${BEFORE}" != "${AFTER}" ]; then
    91	  echo "RUNTIME-FILES: CHANGED"
    92	  echo "--- diff (before vs after) ---"
    93	  diff <(echo "${BEFORE}") <(echo "${AFTER}") || true
    94	  exit 1
    95	fi
    96	
    97	echo "RUNTIME-FILES: unchanged"
    98	exit "${CMD_RC}"
     1	#!/usr/bin/env python
     2	"""负门 —— 证明「lifespan 隔离 + socket 门 + 结账哨兵」这套防线真的在承重。
     3	
     4	[BATCH-2026-09-01-第八批 / CARD-TEST-isolate-lifespan]
     5	
     6	方法：把 ``tests/api/v1/endpoints/test_metadata_subject_mapping.py`` 里的
     7	``no_lifespan`` **原地摘掉**，跑该文件。此时该文件的 client fixture 会重新触发
     8	``app.main`` 的真实 lifespan，向 ``backend/.env`` 指向的现网 Neo4j（7691）发起
     9	连接。防线的行为应当是：
    10	
    11	1. ``tests/support/live_port_guard.py`` 在 connect 前拦下（进程**永不真连** 7691）；
    12	2. 连接处抛出的 ``RuntimeError`` 会被 ``app/main.py`` 的 try/except 吞掉 ——
    13	   所以根 conftest 的结账哨兵把每次被吞掉的拦截转成该用例 ``FAILED``。
    14	
    15	期望：该文件**每一个**用例都 FAIL，且失败原因含
    16	``live Neo4j port connect attempted``；三个运行时文件 sha 前后不变（证明拦在
    17	connect 之前，没有任何写路径被触发）；源文件逐字节还原。
    18	
    19	任何一条不成立 → 本脚本 exit 1（= 防线有假门）。
    20	
    21	## 这道负门不比什么
    22	
    23	* 只对**一个**代表文件做原地变异。它证明的是「防线 + lifespan 摘除」的组合
    24	  在该文件上红得符合预期；不证明其它 12 个改造文件的个体变异也会红（它们的
    25	  fixture 形态相同，但本脚本没有逐一变异）。
    26	* 只跑 pytest 主进程。防线不拦子进程（见 live_port_guard 模块 docstring），
    27	  本脚本也不构造子进程连接场景。
    28	* junitxml 的 ``<failure>`` 文本匹配按子串；若未来哨兵文案改了（
    29	  ``BLOCK_REASON``），同步改 ``EXPECTED_REASON``。
    30	
    31	## 纪律（MEMORY reference_mutation_script_serial_only / reference_temp_file_swap_needs_exit_trap）
    32	
    33	* 串行：本脚本原地改被测文件，**禁止**与其它 pytest/变异脚本并发运行。
    34	* 还原走 ``try/finally``：中途任何一步失败（包括 Ctrl-C 触发的
    35	  ``KeyboardInterrupt``）都会先还原再退出；还原后逐字节比对，不等价即报错。
    36	* 负控子进程里 ``CANVAS_BASE_PATH``/``LANCEDB_DATA_PATH`` 指向本脚本的临时
    37	  目录 —— 摘掉 no_lifespan 后 lifespan 会扫描 canvas_base_path，绝不能让它碰
    38	  live vault。``NEO4J_URI`` 刻意**不**覆盖：负门要证的正是「打到 .env 的 7691
    39	  也会被拦」。
    40	"""
    41	
    42	from __future__ import annotations
    43	
    44	import ast
    45	import hashlib
    46	import os
    47	import shutil
    48	import subprocess
    49	import sys
    50	import tempfile
    51	import xml.etree.ElementTree as ET
    52	from pathlib import Path
    53	
    54	BACKEND_DIR = Path(__file__).resolve().parent.parent
    55	TARGET_REL = "tests/api/v1/endpoints/test_metadata_subject_mapping.py"
    56	TARGET = BACKEND_DIR / TARGET_REL
    57	
    58	#: 原文件里的隔离形态（必须恰好出现一次，否则说明文件已被动过，先停下来）。
    59	ANCHOR = "with no_lifespan(app), TestClient(app) as c:"
    60	MUTATED = "with TestClient(app) as c:"
    61	
