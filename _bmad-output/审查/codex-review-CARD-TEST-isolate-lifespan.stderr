    45	@pytest.fixture(scope="session", autouse=True)
    46	def _configure_logging_for_tests():
    47	    """Install the unified structlog↔stdlib bridge once per test session.
    48	
    49	    Without this, structlog logs bypass stdlib's logging module and pytest's
    50	    `caplog` fixture cannot capture them. We also force `propagate=True` on
    51	    the root logger so child loggers fan records up to caplog's handler.
    52	    """
