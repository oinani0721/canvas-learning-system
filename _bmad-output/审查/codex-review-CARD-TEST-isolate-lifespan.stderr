    70	# ============================================================================
    71	# CARD-TEST-isolate-lifespan — 「测试进程运行时零连现网 Neo4j」硬门
    72	# ============================================================================
    73	
    74	
    75	def pytest_configure(config):
    76	    # 尽早装门（先于收集期 import）：任何到 7691/7687 的 TCP connect 都在
    77	    # 建立前被拦（fail-closed，调用方拿到 RuntimeError）。包装的是类属性
    78	    # socket.socket.connect/connect_ex，全进程（含 portal 线程）可见。
    79	    live_port_guard.install()
    80	
