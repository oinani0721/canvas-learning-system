   113	@pytest.hookimpl(wrapper=True)
   114	def pytest_runtest_protocol(item, nextitem):
   115	    """把连接尝试归属到用例；豁免用例（integration/e2e 路径与 marker）只记不拦。"""
   116	    exempt, _why = live_port_guard.is_exempt(item)
   117	    live_port_guard.STATE.begin_item(item.nodeid, exempt)
   118	    try:
   119	        return (yield)
   120	    finally:
   121	        live_port_guard.STATE.end_item()
   122	
   123	
   124	@pytest.hookimpl(wrapper=True)
   125	def pytest_runtest_makereport(item, call):
   126	    """结账哨兵：把被 app/main.py 的 try/except 吞掉的拦截转成用例失败。
   127	
   128	    没有这一层，门拦住了连接却无人知晓——TestClient 照常进入、用例照常绿，
   129	    等于一门否定断言恒真的假门（2026-09-01 E3 机制实验实证）。
   130	    """
   131	    report = yield
   132	    if report.when in ("call", "teardown"):
   133	        records = live_port_guard.STATE.take(item.nodeid)
   134	        if records:
   135	            report.outcome = "failed"
   136	            detail = live_port_guard.format_sentinel(item.nodeid, records)
   137	            report.longrepr = f"{report.longrepr}\n\n{detail}" if report.longrepr else detail
   138	    return report
   139	
   140	
   141	def pytest_terminal_summary(terminalreporter, exitstatus, config):
   142	    terminalreporter.write_line(live_port_guard.STATE.summary_line())
