     1	"""
     2	Mastery API Routes
     3	
     4	REST endpoints for the BKT + FSRS hybrid mastery proficiency system.
     5	
     6	Endpoints:
     7	  GET  /mastery/batch           - Get all concepts' mastery state
     8	  GET  /mastery/board/{board_id} - Get mastery data for all nodes on a board (Story 5.2)
     9	  POST /mastery/{id}/grade      - Record an interaction grade (1-4)
    10	  POST /mastery/{id}/override   - Set explicit override (Sidebar)
    11	  POST /mastery/{id}/self-assess - Set implicit self-assessment (Canvas color)
    12	  DELETE /mastery/{id}/override - Reset override to model value
    13	  POST /mastery/{id}/calibration         - Record calibration data point (Story 5.5)
    14	  GET  /mastery/{id}/calibration/summary - Get calibration summary (Story 5.5)
    15	  GET  /mastery/calibration/dangerous    - List misconception nodes (Story 5.5)
    16	"""
    17	
    18	import logging
    19	from typing import Optional
    20	
    21	from fastapi import APIRouter, HTTPException, Query
    22	from pydantic import BaseModel, Field
    23	
    24	from app.models.mastery_models import (
    25	    CalibrationRequest,
    26	)
    27	from app.services.calibration_tracker import (
    28	    get_calibration_summary,
    29	    record_calibration,
    30	)
    31	from app.services.mastery_engine import get_mastery_engine
    32	from app.services.mastery_store import get_mastery_store
    33	
    34	logger = logging.getLogger(__name__)
    35	
    36	mastery_router = APIRouter()
    37	
    38	
    39	def _get_engine():
    40	    """Delegate to the service-level singleton."""
    41	    return get_mastery_engine()
    42	
    43	
    44	def _get_store():
    45	    """Delegate to the service-level singleton."""
    46	    return get_mastery_store()
