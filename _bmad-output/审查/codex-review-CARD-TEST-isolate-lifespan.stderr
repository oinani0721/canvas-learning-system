   636	# ═══════════════════════════════════════════════════════════════════════════════
   637	# L5-#2 Regression: Neo4j Mode-Aware Probe (Plan v25 Option C)
   638	# Pattern source: app/services/memory_service.py:969-987 (Story 30.3 fix)
   639	# ═══════════════════════════════════════════════════════════════════════════════
   640	
   641	
   642	class TestHealthCheckNeo4jFallback:
   643	    """
   644	    L5-#2 regression: components.neo4j must distinguish 4 states:
   645	    NEO4J + ping ok / NEO4J + ping fail / JSON_FALLBACK / not_initialized.
   646	
   647	    Pattern source: app/services/memory_service.py:969-987
   648	
   649	    Bug history: previously the health endpoint only checked stats["initialized"],
   650	    so JSON_FALLBACK mode (initialized=True, mode=JSON_FALLBACK) would dispatch
   651	    RETURN 1 AS ping to _run_query_json_fallback, which silently no-ops instead
   652	    of raising. That produced a false-positive components.neo4j == "ok" even
   653	    though Neo4j was unreachable.
   654	    """
   655	
   656	    def _patch_neo4j_client(self, monkeypatch, stats: dict, run_query=None):
   657	        """Inject a fake Neo4jClient into the get_neo4j_client factory."""
   658	        from app.clients import neo4j_client as nc_module
   659	
   660	        class _FakeClient:
   661	            def __init__(self) -> None:
   662	                self.stats = stats
   663	
   664	            async def run_query(self, q):
   665	                if run_query is None:
   666	                    return [{"ping": 1}]
   667	                return await run_query(q)
   668	
   669	        monkeypatch.setattr(nc_module, "get_neo4j_client", lambda: _FakeClient())
   670	
   671	    def test_neo4j_real_ok(self, client: TestClient, monkeypatch):
   672	        """Real NEO4J mode + healthy + ping success → 'ok'."""
   673	        self._patch_neo4j_client(
   674	            monkeypatch,
   675	            stats={"initialized": True, "mode": "NEO4J", "health_status": True},
   676	        )
   677	        resp = client.get("/api/v1/health")
   678	        assert resp.status_code == 200
   679	        assert resp.json()["components"]["neo4j"] == "ok"
   680	
   681	    def test_neo4j_real_ping_fail_degraded(self, client: TestClient, monkeypatch):
   682	        """Real NEO4J mode + healthy stats + ping raises → 'degraded'."""
   683	
   684	        async def _boom(_q):
   685	            raise RuntimeError("connection refused")
   686	
   687	        self._patch_neo4j_client(
   688	            monkeypatch,
   689	            stats={"initialized": True, "mode": "NEO4J", "health_status": True},
   690	            run_query=_boom,
   691	        )
   692	        resp = client.get("/api/v1/health")
   693	        assert resp.status_code == 200
   694	        assert resp.json()["components"]["neo4j"] == "degraded"
   695	
   696	    def test_neo4j_json_fallback(self, client: TestClient, monkeypatch):
   697	        """JSON_FALLBACK mode → 'json_fallback' (not 'ok' false-positive)."""
   698	        self._patch_neo4j_client(
   699	            monkeypatch,
   700	            stats={
   701	                "initialized": True,
   702	                "mode": "JSON_FALLBACK",
   703	                "health_status": False,
   704	            },
   705	        )
   706	        resp = client.get("/api/v1/health")
   707	        assert resp.status_code == 200
   708	        assert resp.json()["components"]["neo4j"] == "json_fallback"
   709	
   710	    def test_neo4j_not_initialized(self, client: TestClient, monkeypatch):
   711	        """Uninitialized client → 'not_initialized'."""
   712	        self._patch_neo4j_client(
   713	            monkeypatch,
   714	            stats={"initialized": False, "mode": "NEO4J", "health_status": False},
   715	        )
   716	        resp = client.get("/api/v1/health")
   717	        assert resp.status_code == 200
   718	        assert resp.json()["components"]["neo4j"] == "not_initialized"
