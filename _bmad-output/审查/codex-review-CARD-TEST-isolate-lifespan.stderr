   271	
   272	
   273	def clear_prometheus_metrics():
   274	    """Clear accumulated state from all Canvas Prometheus metrics.
   275	
   276	    Prometheus Counters/Histograms/Gauges are module-level singletons.
   277	    Without clearing, values accumulate across tests, causing
   278	    non-deterministic snapshot assertions and parallel-test races.
   279	
   280	    Uses internal ``_metrics`` dict (labeled metrics) and ``_value``
   281	    (unlabeled Gauge). This is the accepted pattern for testing with
   282	    prometheus_client — there is no public reset API.
   283	    """
   284	    from app.middleware.agent_metrics import (
   285	        AGENT_ERRORS,
   286	        AGENT_EXECUTION_TIME,
   287	        AGENT_INVOCATIONS,
   288	    )
   289	    from app.middleware.memory_metrics import (
   290	        MEMORY_ERRORS,
   291	        MEMORY_QUERIES,
   292	        MEMORY_QUERY_LATENCY,
   293	    )
   294	    from app.middleware.metrics import (
   295	        CONCURRENT_REQUESTS,
   296	        REQUEST_COUNT,
   297	        REQUEST_LATENCY,
   298	    )
   299	
   300	    labeled_metrics = [
   301	        AGENT_EXECUTION_TIME,
   302	        AGENT_ERRORS,
   303	        AGENT_INVOCATIONS,
   304	        MEMORY_QUERY_LATENCY,
   305	        MEMORY_ERRORS,
   306	        MEMORY_QUERIES,
   307	        REQUEST_COUNT,
   308	        REQUEST_LATENCY,
   309	    ]
   310	    for metric in labeled_metrics:
   311	        if hasattr(metric, "_metrics"):
   312	            metric._metrics.clear()
   313	
   314	    # Unlabeled Gauge — reset value to 0
   315	    if hasattr(CONCURRENT_REQUESTS, "_value"):
   316	        CONCURRENT_REQUESTS._value.set(0)
   317	
   318	
   319	@pytest.fixture
   320	def reset_prometheus():
   321	    """Fixture that clears Prometheus metrics before and after the test.
   322	
   323	    Not autouse — apply explicitly or as autouse in metrics test files:
   324	
   325	        pytestmark = pytest.mark.usefixtures("reset_prometheus")
   326	    """
   327	    clear_prometheus_metrics()
   328	    yield
   329	    clear_prometheus_metrics()
