    70	async def health_check(
    71	    settings: Settings = Depends(get_settings),  # noqa: B008
    72	) -> HealthCheckResponse:
    73	    """
    74	    Check application health status.
    75	
    76	    Returns application name, version, and current timestamp to indicate
    77	    the service is running and responsive.
    78	
    79	    ✅ Verified from Context7:/websites/fastapi_tiangolo (topic: Depends lru_cache settings)
    80	    Pattern: Inject settings using Depends(get_settings)
    81	
    82	    [Source: specs/api/fastapi-backend-api.openapi.yml#/paths/~1api~1v1~1health]
    83	
    84	    Args:
    85	        settings: Application settings injected via dependency.
    86	
    87	    Returns:
    88	        HealthCheckResponse: Health status with app info and timestamp.
    89	
    90	    Example Response:
    91	        {
    92	            "status": "healthy",
    93	            "app_name": "Canvas Learning System API",
    94	            "version": "1.0.0",
    95	            "timestamp": "2025-11-24T10:30:00Z"
    96	        }
    97	    """
    98	    logger.debug("Health check requested")
    99	
   100	    # Story 38.3 AC-3: Include FSRS status in health check
   101	    # Code Review M2 Fix: Use FSRS_RUNTIME_OK (runtime init status) when available,
   102	    # fall back to FSRS_AVAILABLE (import-time) if ReviewService hasn't been instantiated yet.
   103	    components = {}
   104	    try:
   105	        from app.services.review_service import FSRS_AVAILABLE, FSRS_RUNTIME_OK
   106	
   107	        if FSRS_RUNTIME_OK is not None:
   108	            components["fsrs"] = "ok" if FSRS_RUNTIME_OK else "degraded"
   109	        else:
   110	            components["fsrs"] = "ok" if FSRS_AVAILABLE else "degraded"
   111	    except Exception:
   112	        components["fsrs"] = "degraded"
   113	
   114	    # NFR Quick Win #2: Include batch_orchestrator initialization status
   115	    try:
   116	        from app.api.v1.endpoints.intelligent_parallel import _deps_initialized
   117	
   118	        components["batch_orchestrator"] = (
   119	            "ok" if _deps_initialized else "not_initialized"
   120	        )
   121	    except Exception:
   122	        components["batch_orchestrator"] = "unavailable"
   123	
   124	    # EPIC-33 NFR: Include batch session statistics
   125	    try:
   126	        from app.dependencies import get_session_manager
   127	
   128	        sm = get_session_manager()
   129	        stats = await sm.get_stats()
   130	        components["batch_sessions"] = stats
   131	    except Exception:
   132	        components["batch_sessions"] = "unavailable"
   133	
   134	    # Neo4j connectivity check — mode-aware probe (Story 30.3 pattern parity).
   135	    # ✅ Pattern source: app/services/memory_service.py:969-987 (Story 30.3 fix)
   136	    # Bug history: previously this block only checked stats["initialized"], so
   137	    # JSON_FALLBACK mode (initialized=True, mode=JSON_FALLBACK) would dispatch
   138	    # `RETURN 1 AS ping` to _run_query_json_fallback, which silently no-ops
   139	    # instead of raising. That produced a false-positive components.neo4j == "ok"
   140	    # even though Neo4j was unreachable. The fix mirrors memory_service.py's
   141	    # 4-way classification: NEO4J ok / NEO4J degraded / JSON_FALLBACK / unavailable.
   142	    try:
   143	        from app.clients.neo4j_client import get_neo4j_client
   144	
   145	        neo4j = get_neo4j_client()
   146	        neo4j_stats = neo4j.stats if hasattr(neo4j, "stats") else {}
   147	
   148	        is_real_neo4j = (
   149	            neo4j_stats.get("initialized", False)
   150	            and neo4j_stats.get("mode") == "NEO4J"
   151	            and neo4j_stats.get("health_status", False)
   152	        )
   153	
   154	        if is_real_neo4j:
   155	            # Real Neo4j path — verify with a lightweight ping
   156	            try:
   157	                await asyncio.wait_for(
   158	                    neo4j.run_query("RETURN 1 AS ping"),
   159	                    timeout=3.0,
   160	                )
   161	                components["neo4j"] = "ok"
   162	            except Exception as neo4j_err:
   163	                logger.warning(f"Neo4j connectivity test failed: {neo4j_err}")
   164	                components["neo4j"] = "degraded"
   165	        elif neo4j_stats.get("mode") == "JSON_FALLBACK":
   166	            # Tauri sidecar / desktop app fallback — operational, not an error
   167	            components["neo4j"] = "json_fallback"
   168	        elif neo4j_stats.get("initialized", False):
   169	            # Initialized but neither healthy NEO4J nor JSON_FALLBACK
   170	            components["neo4j"] = "degraded"
   171	        else:
   172	            components["neo4j"] = "not_initialized"
   173	    except Exception as e:
   174	        logger.warning(f"Neo4j health probe unavailable: {e}")
   175	        components["neo4j"] = "unavailable"
   176	
   177	    return HealthCheckResponse(
   178	        status="healthy",
   179	        app_name=settings.PROJECT_NAME,
   180	        version=settings.VERSION,
   181	        timestamp=datetime.now(timezone.utc),
   182	        components=components,
   183	    )
