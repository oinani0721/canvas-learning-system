uvloop 重点已被实证击穿：session 自检先通过，随后导入 uvloop；同一关闭回环端口下，默认 asyncio 的 `create_connection` 被门拦成 `RuntimeError`、计数 1，而 uvloop 的 `create_connection` 返回 `ConnectionRefusedError`、门计数仍为 0。也就是说“会话中后段才引入 uvloop”是可复现的静默旁路，不只是理论担忧。
exec
/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -c '
import asyncio, concurrent.futures, socket, threading
from tests.support import live_port_guard as g
g.install(); g.assert_not_uvloop()
probe = socket.socket(); probe.bind((\"127.0.0.1\", 0)); port = probe.getsockname()[1]; probe.close(); g.BLOCKED_PORTS = frozenset({port})
results = []
def attempt(label):
    sock = socket.socket()
    try: sock.connect((\"127.0.0.1\", port))
    except BaseException as exc: results.append((label, type(exc).__name__))
    finally: sock.close()
try: socket.create_connection((\"127.0.0.1\", port), timeout=0.2)
except BaseException as exc: results.append((\"create_connection\", type(exc).__name__))
t = threading.Thread(target=attempt, args=(\"thread\",)); t.start(); t.join()
with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool: pool.submit(attempt, \"pool\").result()
async def run_async():
    try: await asyncio.open_connection(\"127.0.0.1\", port)
    except BaseException as exc: results.append((\"asyncio_open\", type(exc).__name__))
asyncio.run(run_async())
print(sorted(results)); print(\"guard_total=\", g.STATE.total, \"blocked=\", g.STATE.blocked)
g.uninstall()
