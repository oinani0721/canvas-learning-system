   274	
   275	def format_sentinel(owner: str, records: list[dict]) -> str:
   276	    lines = [
   277	        f"{BLOCK_REASON} —— 本用例期间有 {len(records)} 次到现网 Neo4j 的连接尝试被拦下。",
   278	        "（连接处抛出的异常被 app/main.py 的 lifespan try/except 吞掉了，",
   279	        "  所以由本哨兵把它转成用例失败——否则这道门什么都证明不了。）",
   280	    ]
   281	    for rec in records:
   282	        lines.append(f"  - {rec['address']} on thread {rec['thread']} (owner={owner})")
   283	    return "\n".join(lines)
