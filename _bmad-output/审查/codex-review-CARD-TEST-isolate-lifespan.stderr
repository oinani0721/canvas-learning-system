   388	
   389	def get_default_monitor() -> ResourceMonitor:
   390	    """
   391	    Get or create the default ResourceMonitor instance.
   392	
   393	    Returns:
   394	        The default ResourceMonitor singleton instance
   395	    """
   396	    global _default_monitor
   397	    if _default_monitor is None:
   398	        _default_monitor = ResourceMonitor()
   399	    return _default_monitor
