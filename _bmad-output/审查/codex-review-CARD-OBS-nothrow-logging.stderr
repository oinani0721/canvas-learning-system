   227	
   228	def _parse(path: Path):
   229	    try:
   230	        text = path.read_text(encoding="utf-8")
   231	    except (OSError, UnicodeDecodeError):
   232	        return None, []
   233	    try:
   234	        return ast.parse(text), text.splitlines()
   235	    except SyntaxError:
   236	        return None, text.splitlines()
   237	
   238	
   239	# ─────────────────────────────────────────────────────────────────────────────
   240	# 篡改自检 —— 防止"判定恒返回未包装"的坏门冒充工作
   241	# ─────────────────────────────────────────────────────────────────────────────
   242	
   243	
   244	def _self_check() -> None:
   245	    cases = [
   246	        ("logger = nothrow(logging.getLogger(__name__))", True),
   247	        ("logger = logging.getLogger(__name__)", False),
   248	        ("from app.core.nothrow_logging import nothrow as _nt\nlogger = _nt(logging.getLogger(__name__))", True),
   249	        ("import structlog\nlogger = structlog.get_logger(__name__)", False),
   250	    ]
   251	    for src, expect_wrapped in cases:
   252	        tree = ast.parse(src)
   253	        aliases = _alias_table(tree)
   254	        bs = _bindings(tree, src.splitlines(), aliases)
   255	        got = bool(bs) and bs[0].wrapped
   256	        if got is not expect_wrapped:
   257	            print(
   258	                f"⛔ 自检失败: 判定函数对合成语料的结论与预期相反\n  语料: {src!r}\n  期望 wrapped={expect_wrapped}, 实得 {got}",
   259	                file=sys.stderr,
   260	            )
   261	            raise SystemExit(2)
   262	    print("[self-check] 篡改自检 4/4 通过 — 判定函数不是恒 False 的坏门")
   263	
   264	
   265	def _structural_anchors(backend: Path, reports: Dict[str, dict]) -> None:
   266	    """结构验伪锚: 检不出已知存在的形态 = 判定函数有漏, 拒绝出报告。"""
   267	    bad = []
   268	    rb = reports.get("rollback.py")
   269	    if not rb or rb["inline_calls"] < 1:
   270	        bad.append("rollback.py 的匿名内联 getLogger 调用没被识别 (已知存在 1 处 :41)")
   271	    hp = reports.get("health.py")
   272	    if not hp or hp["external"] < 1:
   273	        bad.append("health.py 的 EXTERNAL logger (memory_logger) 没被识别")
   274	    if bad:
   275	        for b in bad:
   276	            print(f"⛔ 结构锚失败: {b}", file=sys.stderr)
   277	        raise SystemExit(2)
   278	    print("[self-check] 结构验伪锚 2/2 通过 — 内联/EXTERNAL 两类都能看见")
   279	
   280	
   281	# ─────────────────────────────────────────────────────────────────────────────
   282	# 扫描
   283	# ─────────────────────────────────────────────────────────────────────────────
   284	
   285	
   286	def scan_endpoints(backend: Path) -> Dict[str, dict]:
   287	    ep_dir = backend / "app" / "api" / "v1" / "endpoints"
   288	    result: Dict[str, dict] = {}
   289	    for path in sorted(ep_dir.glob("*.py")):
   290	        tree, lines = _parse(path)
   291	        if tree is None:
   292	            result[path.name] = {"error": "parse failed"}
   293	            continue
   294	        aliases = _alias_table(tree)
   295	        bindings = _bindings(tree, lines, aliases)
   296	        bound_names = {b.name for b in bindings}
   297	        spans = _spans(tree)
   298	        imported = _imported_logger_names(tree)
   299	        external_names = {n for n, _ in imported}
   300	        calls = _calls(tree, bound_names, lines, spans, external_names)
   301	        inline = [c for c in calls if c.receiver == "<inline-getLogger>"]
   302	        ext_calls = [c for c in calls if c.receiver and c.receiver.startswith("<external:")]
   303	        stdlib_bs = [b for b in bindings if b.kind == "stdlib"]
   304	        structlog_bs = [b for b in bindings if b.kind == "structlog"]
   305	        module_calls = [c for c in calls if c.receiver in bound_names]
   306	        result[path.name] = {
   307	            "bindings": bindings,
   308	            "stdlib_bindings": stdlib_bs,
   309	            "structlog_bindings": structlog_bs,
   310	            "calls": module_calls,
   311	            "inline_calls": len(inline),
   312	            "external": len(imported),
   313	            "external_detail": imported,
   314	            "external_calls": ext_calls,
   315	            "fstring_calls": [c for c in module_calls if c.fstring],
   316	        }
   317	    return result
   318	
   319	
   320	def scan_handoff(backend: Path) -> List[dict]:
   321	    out = []
   322	    by_file: Dict[str, List[Tuple[str, str]]] = {}
   323	    for rel, fn, note in HANDOFF_ANCHORS:
   324	        by_file.setdefault(rel, []).append((fn, note))
   325	    for rel, anchors in by_file.items():
   326	        path = backend / rel
   327	        tree, lines = _parse(path)
   328	        if tree is None:
   329	            out.append({"file": rel, "func": "*", "error": "parse failed / missing"})
   330	            continue
   331	        aliases = _alias_table(tree)
   332	        bindings = _bindings(tree, lines, aliases)
   333	        names = {b.name for b in bindings}
   334	        spans = _spans(tree)
   335	        calls = _calls(tree, names, lines, spans)
   336	        module_wrapped = bool(bindings) and all(b.wrapped for b in bindings)
   337	        for fn, note in anchors:
   338	            hits = [c for c in calls if c.func == fn]
   339	            out.append(
   340	                {
   341	                    "file": rel,
   342	                    "func": fn,
   343	                    "note": note,
   344	                    "found": bool(hits),
   345	                    "module_wrapped": module_wrapped,
   346	                    "calls": hits,
   347	                }
   348	            )
   349	    return out
   350	
   351	
   352	# ─────────────────────────────────────────────────────────────────────────────
   353	# 报告
   354	# ─────────────────────────────────────────────────────────────────────────────
   355	
   356	
   357	def main() -> int:
   358	    parser = argparse.ArgumentParser(description=__doc__)
   359	    parser.add_argument("--backend", default=str(Path(__file__).resolve().parent.parent))
   360	    args = parser.parse_args()
   361	    backend = Path(args.backend).resolve()
   362	
   363	    _self_check()
   364	    eps = scan_endpoints(backend)
   365	    _structural_anchors(backend, eps)
   366	
   367	    print("=" * 78)
   368	    print("表一 · 端点层 logger 包装状态  (backend/app/api/v1/endpoints/*.py)")
   369	    print("=" * 78)
   370	    wrapped, unwrapped, notwrappable, dead, nolog, external_only, nobinding = [], [], [], [], [], [], []
   371	    total_calls = 0
   372	    total_fstring = 0
   373	    total_inline = 0
   374	    for name, info in eps.items():
   375	        if info.get("error"):
   376	            print(f"  !! {name}: {info['error']}")
   377	            continue
   378	        total_calls += len(info["calls"]) + info["inline_calls"] + len(info["external_calls"])
   379	        total_fstring += len(info["fstring_calls"]) + sum(1 for c in info["external_calls"] if c.fstring)
   380	        total_inline += info["inline_calls"]
   381	        has_calls = bool(info["calls"]) or info["inline_calls"] > 0
   382	        if info["external"] and not info["bindings"]:
   383	            external_only.append(name)
   384	            continue
   385	        if not info["bindings"]:
   386	            if has_calls:
   387	                nobinding.append(name)  # 无绑定但有调用 (如 rollback.py 的内联 getLogger)
   388	            else:
   389	                nolog.append(name)
   390	            continue
   391	        stdlib = info["stdlib_bindings"]
   392	        slog = info["structlog_bindings"]
   393	        if stdlib and all(b.wrapped for b in stdlib) and not slog:
   394	            wrapped.append(name)
   395	        elif slog and not stdlib:
   396	            notwrappable.append(name)
   397	        elif not has_calls:
   398	            dead.append(name)
   399	        else:
   400	            unwrapped.append(name)
   401	
   402	    print(f"\n【已包装】{len(wrapped)} 个 —— 本卡承诺覆盖面")
   403	    for name in wrapped:
   404	        info = eps[name]
   405	        b = info["stdlib_bindings"][0]
   406	        print(f"  ✓ {name:28} :{b.lineno:<5} {b.source}")
   407	        print(f"      日志调用 {len(info['calls']):>3} 处 | f-string 首参 {len(info['fstring_calls'])} 处 (必须为 0)")
   408	        for c in info["fstring_calls"]:
   409	            print(f"        ⚠ :{c.lineno} logger.{c.method}(f...)  in {c.func}()")
   410	
   411	    print(f"\n【未包装】{len(unwrapped)} 个 —— 本卡**不覆盖**, 如实登记")
   412	    for name in unwrapped:
