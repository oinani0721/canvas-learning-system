/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 backend/.venv/bin/python -c 'exec(\"\"\"import ast,subprocess
commit=\"78c9e6e7\"
neg=subprocess.check_output([\"git\",\"show\",f\"{commit}:backend/scripts/nothrow_logging_negative_control.py\"],text=True)
core=subprocess.check_output([\"git\",\"show\",f\"{commit}:backend/app/core/nothrow_logging.py\"],text=True)
tree=ast.parse(neg)
vals={}
for n in tree.body:
    if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in {\"_M3_OLD\",\"_M3_NEW\"}:
        vals[n.targets[0].id]=ast.literal_eval(n.value)
