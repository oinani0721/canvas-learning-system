    71	
    72	class NoThrowLogger:
    73	    """包裹一个 stdlib ``Logger``, 让被包装的日志调用永不向调用方传播异常。
    74	
    75	    两级降级 (与 ``decision_tracker`` 同构):
    76	
    77	    1. 被包装方法抛错 → 用 ``_FALLBACK_LOGGER.warning`` 登记一条 (惰性参数;
    78	       **刻意不重放原始消息** —— 原始消息本身可能正是失败源);
    79	    2. 二级 ``warning`` 也抛错 → 静默。观测彻底失效仍不得波及业务响应, 这是
    80	       本类唯一硬承诺。
    81	
    82	    ``.inner`` 暴露原始 Logger, 供确需原生 API 的调用方使用 —— 这是**逃生舱,
    83	    不是保护**: 经 ``.inner`` 发出的调用不受本类保护。
    84	
    85	    刻意**不**实现 ``__getattr__`` 全量委托: 未包装的成员 (``handlers`` /
    86	    ``setLevel`` / ``isEnabledFor`` …) 直接 ``AttributeError``, 比"静默返回一个
    87	    不受保护的绑定方法"诚实 —— 后者会让人以为自己仍在保护之内。
    88	
    89	    刻意**不**用 ``__slots__``: ``unittest.mock.patch("...rag.logger.info")``
    90	    需要往**实例**上 setattr (写进实例 ``__dict__``), ``__slots__`` 会让它当场
    91	    ``AttributeError`` —— 既有门 ``test_rag_four_state_api.py`` 的注入测试正是
    92	    这种写法。每模块只有一个实例, 实例 ``__dict__`` 的内存代价无关紧要。
    93	    """
    94	
    95	    def __init__(self, inner: logging.Logger) -> None:
    96	        self.inner = inner
    97	
    98	    # ── 内部 ────────────────────────────────────────────────────────────
    99	    def _guarded(self, method: str, *args: Any, **kwargs: Any) -> None:
   100	        """转调 ``inner.<method>``, 吞掉它抛出的一切并降级登记。
   101	
   102	        ``method`` 只来自本模块的 ``_LEVEL_METHODS`` 字面量, 不接受外部输入 ——
   103	        ``getattr`` 本身不会失败, 除非 ``inner`` 根本不是 Logger (那属于调用方
   104	        用错了本类, 会走进同一个 fallback 并留下 ``AttributeError`` 的 repr)。
   105	        """
   106	        kwargs["stacklevel"] = kwargs.get("stacklevel", 1) + _STACKLEVEL_OFFSET
   107	        try:
   108	            getattr(self.inner, method)(*args, **kwargs)
   109	        except Exception as exc:  # noqa: BLE001 — 观测面刻意兜底, 见模块 docstring
   110	            try:
   111	                _FALLBACK_LOGGER.warning(
   112	                    "nothrow: logger %r method %r raised during logging: %r",
   113	                    getattr(self.inner, "name", "<unknown>"),
   114	                    method,
   115	                    exc,
   116	                )
   117	            except Exception:  # noqa: BLE001 — 兜底的兜底: 日志后端整体坏死
   118	                pass
   119	
   120	    # ── stdlib Logger 的日志方法 ────────────────────────────────────────
   121	    def debug(self, *args: Any, **kwargs: Any) -> None:
   122	        self._guarded("debug", *args, **kwargs)
   123	
   124	    def info(self, *args: Any, **kwargs: Any) -> None:
   125	        self._guarded("info", *args, **kwargs)
   126	
   127	    def warning(self, *args: Any, **kwargs: Any) -> None:
   128	        self._guarded("warning", *args, **kwargs)
   129	
   130	    def error(self, *args: Any, **kwargs: Any) -> None:
   131	        self._guarded("error", *args, **kwargs)
   132	
   133	    def exception(self, *args: Any, **kwargs: Any) -> None:
   134	        self._guarded("exception", *args, **kwargs)
   135	
   136	    def critical(self, *args: Any, **kwargs: Any) -> None:
   137	        self._guarded("critical", *args, **kwargs)
   138	
   139	    def log(self, level: int, *args: Any, **kwargs: Any) -> None:
   140	        self._guarded("log", level, *args, **kwargs)
   141	
   142	
   143	def nothrow(logger: Union[logging.Logger, NoThrowLogger]) -> NoThrowLogger:
   144	    """把 stdlib ``Logger`` 包成 ``NoThrowLogger``; 已包装的原样返回 (幂等)。
   145	
   146	    幂等是有意的: 重复包装会多一层帧, 让 ``_STACKLEVEL_OFFSET`` 失准。
   147	    """
   148	    if isinstance(logger, NoThrowLogger):
   149	        return logger
   150	    return NoThrowLogger(logger)

