    66	def _alias_table(tree: ast.Module) -> Set[str]:
    67	    """本文件里指向 nothrow 的本地别名 (from x import nothrow / nothrow as nt)。"""
    68	    names = {"nothrow"}
    69	    for node in ast.walk(tree):
    70	        if isinstance(node, ast.ImportFrom):
    71	            for alias in node.names:
    72	                if alias.name == "nothrow":
    73	                    names.add(alias.asname or alias.name)
    74	    return names
    75	
    76	
    77	def _is_call_named(node: ast.AST, names: Set[str], attr: Optional[str] = None) -> bool:
    78	    """nothrow(...) / obs.nothrow(...) / getLogger(...) 形态判定。
    79	
    80	    ``attr`` 给定时只认 ``.attr`` 尾名 (Attribute 形态) 或裸名 (Name 形态)。
    81	    """
    82	    if not isinstance(node, ast.Call):
    83	        return False
    84	    func = node.func
    85	    if isinstance(func, ast.Name):
    86	        return func.id in names and (attr is None or func.id == attr)
    87	    if isinstance(func, ast.Attribute):
    88	        return func.attr in names and (attr is None or func.attr == attr)
    89	    return False
    90	
    91	
    92	def _is_nothrow_call(node: ast.AST, aliases: Set[str]) -> bool:
    93	    return _is_call_named(node, aliases)
    94	
    95	
    96	def _is_getlogger_call(node: ast.AST) -> bool:
    97	    return _is_call_named(node, {"getLogger", "get_logger"})
    98	
    99	
   100	def _is_structlog_call(node: ast.AST) -> bool:
   101	    """structlog.get_logger(...) / structlog.stdlib.get_logger(...)。"""
   102	    if not isinstance(node, ast.Call):
   103	        return False
   104	    func = node.func
   105	    return isinstance(func, ast.Attribute) and func.attr == "get_logger"
   106	
   107	
   108	def _module_stmts(tree: ast.Module) -> List[ast.stmt]:
   109	    """模块级语句, 下探一层 Try/If 的 body (rollback.py 有 try-import 先例),
   110	    但不进 FunctionDef/ClassDef。"""
   111	    out: List[ast.stmt] = []
   112	    stack = list(tree.body)
   113	    while stack:
   114	        node = stack.pop(0)
   115	        out.append(node)
   116	        if isinstance(node, ast.Try):
   117	            stack.extend(node.body + node.orelse + [n for h in node.handlers for n in h.body])
   118	        elif isinstance(node, ast.If):
   119	            stack.extend(node.body + node.orelse)
   120	    return out
   121	
   122	
   123	class Binding:
   124	    def __init__(self, name, lineno, source, kind, wrapped):
   125	        self.name = name
   126	        self.lineno = lineno
   127	        self.source = source
   128	        self.kind = kind  # stdlib | structlog
   129	        self.wrapped = wrapped
   130	
   131	
   132	def _bindings(tree: ast.Module, lines: List[str], aliases: Set[str]) -> List[Binding]:
   133	    out = []
   134	    for node in _module_stmts(tree):
   135	        value = None
   136	        targets = []
   137	        if isinstance(node, ast.Assign):
   138	            value, targets = node.value, node.targets
   139	        elif isinstance(node, ast.AnnAssign) and node.value is not None:
   140	            value, targets = node.value, [node.target]
   141	        if value is None:
   142	            continue
   143	        nothrow_call = _is_nothrow_call(value, aliases)
   144	        getlogger = _is_getlogger_call(value)
   145	        structlog = _is_structlog_call(value)
   146	        if not (nothrow_call or getlogger or structlog):
   147	            continue
   148	        kind = "structlog" if structlog else "stdlib"
   149	        for target in targets:
   150	            if isinstance(target, ast.Name):
   151	                src = lines[node.lineno - 1].strip() if node.lineno <= len(lines) else ""
   152	                out.append(Binding(target.id, node.lineno, src, kind, nothrow_call))
   153	    return out
   154	
   155	
   156	def _imported_logger_names(tree: ast.Module) -> List[Tuple[str, int]]:
   157	    """函数体内 import 进来的 logger (包装状态在别的文件 → EXTERNAL)。"""
   158	    out = []
   159	    for node in ast.walk(tree):
   160	        if isinstance(node, ast.ImportFrom):
   161	            for alias in node.names:
   162	                if "logger" in alias.name.lower():
   163	                    out.append((alias.asname or alias.name, node.lineno))
   164	    return out
   165	
   166	
   167	class Call:
   168	    def __init__(self, lineno, method, fstring, func, snippet, receiver):
   169	        self.lineno = lineno
   170	        self.method = method
   171	        self.fstring = fstring
   172	        self.func = func
   173	        self.snippet = snippet
   174	        self.receiver = receiver
   175	
   176	
   177	def _spans(tree: ast.Module) -> List[Tuple[int, int, str]]:
   178	    return [
   179	        (n.lineno, getattr(n, "end_lineno", n.lineno), n.name)
   180	        for n in ast.walk(tree)
   181	        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
   182	    ]
   183	
   184	
   185	def _enclosing(spans, lineno):
   186	    best = None
   187	    for s, e, name in spans:
   188	        if s <= lineno <= e and (best is None or s > best[0]):
   189	            best = (s, e, name)
   190	    return best[2] if best else "<module>"
   191	
   192	
   193	def _calls(
   194	    tree: ast.Module,
   195	    bound_names: Set[str],
   196	    lines: List[str],
   197	    spans,
   198	    external_names: Optional[Set[str]] = None,
   199	) -> List[Call]:
   200	    external_names = external_names or set()
   201	    out = []
   202	    for node in ast.walk(tree):
   203	        if not isinstance(node, ast.Call):
   204	            continue
   205	        func = node.func
   206	        if not isinstance(func, ast.Attribute) or func.attr not in LOG_METHODS:
   207	            continue
   208	        base = func.value
   209	        receiver = None
   210	        if isinstance(base, ast.Name) and base.id in bound_names:
   211	            receiver = base.id
   212	        elif isinstance(base, ast.Name) and base.id in external_names:
   213	            receiver = f"<external:{base.id}>"
   214	        elif isinstance(base, ast.Call) and _is_getlogger_call(base):
   215	            receiver = "<inline-getLogger>"
   216	        if receiver is None:
   217	            continue
   218	        first = None
   219	        if node.args:
   220	            idx = 1 if (func.attr == "log" and len(node.args) > 1) else 0
   221	            first = node.args[idx]
   222	        is_f = isinstance(first, ast.JoinedStr)
   223	        snippet = lines[node.lineno - 1].strip() if node.lineno <= len(lines) else ""
   224	        out.append(Call(node.lineno, func.attr, is_f, _enclosing(spans, node.lineno), snippet, receiver))
   225	    return out
   226	
   227	
   228	def _parse(path: Path):
   229	    try:
   230	        text = path.read_text(encoding="utf-8")
   231	    except (OSError, UnicodeDecodeError):
   232	        return None, []
   233	    try:
   234	        return ast.parse(text), text.splitlines()
   235	    except SyntaxError:
   236	        return None, text.splitlines()
   237	
   238	
   239	# ─────────────────────────────────────────────────────────────────────────────
   240	# 篡改自检 —— 防止"判定恒返回未包装"的坏门冒充工作
   241	# ─────────────────────────────────────────────────────────────────────────────
   242	
   243	
   244	def _self_check() -> None:
   245	    cases = [
   246	        ("logger = nothrow(logging.getLogger(__name__))", True),
   247	        ("logger = logging.getLogger(__name__)", False),
   248	        ("from app.core.nothrow_logging import nothrow as _nt\nlogger = _nt(logging.getLogger(__name__))", True),
   249	        ("import structlog\nlogger = structlog.get_logger(__name__)", False),
   250	    ]
   251	    for src, expect_wrapped in cases:
   252	        tree = ast.parse(src)
   253	        aliases = _alias_table(tree)
   254	        bs = _bindings(tree, src.splitlines(), aliases)
   255	        got = bool(bs) and bs[0].wrapped
   256	        if got is not expect_wrapped:
   257	            print(
   258	                f"⛔ 自检失败: 判定函数对合成语料的结论与预期相反\n  语料: {src!r}\n  期望 wrapped={expect_wrapped}, 实得 {got}",
   259	                file=sys.stderr,
   260	            )
   261	            raise SystemExit(2)
   262	    print("[self-check] 篡改自检 4/4 通过 — 判定函数不是恒 False 的坏门")
   263	
   264	
   265	def _structural_anchors(backend: Path, reports: Dict[str, dict]) -> None:
   266	    """结构验伪锚: 检不出已知存在的形态 = 判定函数有漏, 拒绝出报告。"""
   267	    bad = []
   268	    rb = reports.get("rollback.py")
   269	    if not rb or rb["inline_calls"] < 1:
   270	        bad.append("rollback.py 的匿名内联 getLogger 调用没被识别 (已知存在 1 处 :41)")
   271	    hp = reports.get("health.py")
   272	    if not hp or hp["external"] < 1:
   273	        bad.append("health.py 的 EXTERNAL logger (memory_logger) 没被识别")
   274	    if bad:
   275	        for b in bad:
   276	            print(f"⛔ 结构锚失败: {b}", file=sys.stderr)
   277	        raise SystemExit(2)
   278	    print("[self-check] 结构验伪锚 2/2 通过 — 内联/EXTERNAL 两类都能看见")
   279	
   280	
   281	# ─────────────────────────────────────────────────────────────────────────────
   282	# 扫描
   283	# ─────────────────────────────────────────────────────────────────────────────
   284	
   285	
   286	def scan_endpoints(backend: Path) -> Dict[str, dict]:
   287	    ep_dir = backend / "app" / "api" / "v1" / "endpoints"
   288	    result: Dict[str, dict] = {}
   289	    for path in sorted(ep_dir.glob("*.py")):
   290	        tree, lines = _parse(path)
   291	        if tree is None:
   292	            result[path.name] = {"error": "parse failed"}
   293	            continue
   294	        aliases = _alias_table(tree)
   295	        bindings = _bindings(tree, lines, aliases)
   296	        bound_names = {b.name for b in bindings}
   297	        spans = _spans(tree)
   298	        imported = _imported_logger_names(tree)
   299	        external_names = {n for n, _ in imported}
   300	        calls = _calls(tree, bound_names, lines, spans, external_names)
   301	        inline = [c for c in calls if c.receiver == "<inline-getLogger>"]
   302	        ext_calls = [c for c in calls if c.receiver and c.receiver.startswith("<external:")]
   303	        stdlib_bs = [b for b in bindings if b.kind == "stdlib"]
   304	        structlog_bs = [b for b in bindings if b.kind == "structlog"]
   305	        module_calls = [c for c in calls if c.receiver in bound_names]
   306	        result[path.name] = {
   307	            "bindings": bindings,
   308	            "stdlib_bindings": stdlib_bs,
   309	            "structlog_bindings": structlog_bs,
   310	            "calls": module_calls,
   311	            "inline_calls": len(inline),
   312	            "external": len(imported),
   313	            "external_detail": imported,
   314	            "external_calls": ext_calls,
   315	            "fstring_calls": [c for c in module_calls if c.fstring],
   316	        }
   317	    return result
   318	
   319	
   320	def scan_handoff(backend: Path) -> List[dict]:
   321	    out = []
   322	    by_file: Dict[str, List[Tuple[str, str]]] = {}
   323	    for rel, fn, note in HANDOFF_ANCHORS:
   324	        by_file.setdefault(rel, []).append((fn, note))
   325	    for rel, anchors in by_file.items():
   326	        path = backend / rel
   327	        tree, lines = _parse(path)
   328	        if tree is None:
   329	            out.append({"file": rel, "func": "*", "error": "parse failed / missing"})
   330	            continue
   331	        aliases = _alias_table(tree)
   332	        bindings = _bindings(tree, lines, aliases)
   333	        names = {b.name for b in bindings}
   334	        spans = _spans(tree)
   335	        calls = _calls(tree, names, lines, spans)
   336	        module_wrapped = bool(bindings) and all(b.wrapped for b in bindings)
   337	        for fn, note in anchors:
   338	            hits = [c for c in calls if c.func == fn]
   339	            out.append(
   340	                {
   341	                    "file": rel,
   342	                    "func": fn,
   343	                    "note": note,
   344	                    "found": bool(hits),
   345	                    "module_wrapped": module_wrapped,
   346	                    "calls": hits,
   347	                }
   348	            )
   349	    return out
   350	
   351	
   352	# ─────────────────────────────────────────────────────────────────────────────
   353	# 报告
   354	# ─────────────────────────────────────────────────────────────────────────────
   355	
   356	
   357	def main() -> int:
   358	    parser = argparse.ArgumentParser(description=__doc__)
   359	    parser.add_argument("--backend", default=str(Path(__file__).resolve().parent.parent))
   360	    args = parser.parse_args()
   361	    backend = Path(args.backend).resolve()
   362	
   363	    _self_check()
   364	    eps = scan_endpoints(backend)
   365	    _structural_anchors(backend, eps)
   366	
   367	    print("=" * 78)
   368	    print("表一 · 端点层 logger 包装状态  (backend/app/api/v1/endpoints/*.py)")
   369	    print("=" * 78)
   370	    wrapped, unwrapped, notwrappable, dead, nolog, external_only, nobinding = [], [], [], [], [], [], []
   371	    total_calls = 0
   372	    total_fstring = 0
   373	    total_inline = 0
   374	    for name, info in eps.items():
   375	        if info.get("error"):
   376	            print(f"  !! {name}: {info['error']}")
   377	            continue
   378	        total_calls += len(info["calls"]) + info["inline_calls"] + len(info["external_calls"])
   379	        total_fstring += len(info["fstring_calls"]) + sum(1 for c in info["external_calls"] if c.fstring)
   380	        total_inline += info["inline_calls"]
   381	        has_calls = bool(info["calls"]) or info["inline_calls"] > 0
   382	        if info["external"] and not info["bindings"]:
   383	            external_only.append(name)
   384	            continue
   385	        if not info["bindings"]:
   386	            if has_calls:
   387	                nobinding.append(name)  # 无绑定但有调用 (如 rollback.py 的内联 getLogger)
   388	            else:
   389	                nolog.append(name)
   390	            continue
   391	        stdlib = info["stdlib_bindings"]
   392	        slog = info["structlog_bindings"]
   393	        if stdlib and all(b.wrapped for b in stdlib) and not slog:
   394	            wrapped.append(name)
   395	        elif slog and not stdlib:
   396	            notwrappable.append(name)
   397	        elif not has_calls:
   398	            dead.append(name)
   399	        else:
   400	            unwrapped.append(name)
   401	
   402	    print(f"\n【已包装】{len(wrapped)} 个 —— 本卡承诺覆盖面")
   403	    for name in wrapped:
   404	        info = eps[name]
   405	        b = info["stdlib_bindings"][0]
   406	        print(f"  ✓ {name:28} :{b.lineno:<5} {b.source}")
   407	        print(f"      日志调用 {len(info['calls']):>3} 处 | f-string 首参 {len(info['fstring_calls'])} 处 (必须为 0)")
   408	        for c in info["fstring_calls"]:
   409	            print(f"        ⚠ :{c.lineno} logger.{c.method}(f...)  in {c.func}()")
   410	
   411	    print(f"\n【未包装】{len(unwrapped)} 个 —— 本卡**不覆盖**, 如实登记")
   412	    for name in unwrapped:
   413	        info = eps[name]
   414	        b = info["bindings"][0]
   415	        note = " (绑定后 0 调用但有内联调用)" if not info["calls"] and info["inline_calls"] else ""
   416	        ext_note = ""
   417	        if info["external_calls"]:
   418	            rcv = info["external_calls"][0].receiver
   419	            ext_note = (
   420	                f" + EXTERNAL {rcv[1:-1].split(':')[1]} {len(info['external_calls'])} 处 (包装状态在别文件, 本表不判)"
   421	            )
   422	        print(
   423	            f"  ✗ {name:28} :{b.lineno:<5} {b.kind:9} 日志调用 {len(info['calls']):>3} 处 (f-string {len(info['fstring_calls'])} 处, 内联 {info['inline_calls']}){note}{ext_note}"
   424	        )
   425	
   426	    print(f"\n【NOT-WRAPPABLE·structlog】{len(notwrappable)} 个 —— 本适配器技术不可包 (stacklevel 会泄进 JSON)")
   427	    for name in notwrappable:
   428	        info = eps[name]
   429	        b = info["structlog_bindings"][0]
   430	        print(
   431	            f"  S {name:28} :{b.lineno:<5} 日志调用 {len(info['calls']):>3} 处 (f-string {len(info['fstring_calls'])} 处)"
   432	        )
   433	
   434	    print(f"\n【EXTERNAL·他文件 logger】{len(external_only)} 个")
   435	    for name in external_only:
   436	        info = eps[name]
   437	        for lname, ln in info["external_detail"]:
   438	            print(f"  E {name:28} :{ln:<5} imports {lname} → 包装状态看 app/core/memory_system_logger.py")
   439	
   440	    print(f"\n【死绑定·绑了不用】{len(dead)} 个 —— 技术正确但零风险面, 不进待改队列")
   441	    for name in dead:
   442	        b = eps[name]["bindings"][0]
   443	        print(f"  · {name:28} :{b.lineno:<5} {b.kind}")
   444	
   445	    print(f"\n【无绑定但有调用】{len(nobinding)} 个 —— 模块级包装罩不住 (内联 getLogger)")
   446	    for name in nobinding:
   447	        info = eps[name]
   448	        print(f"  ? {name:28} 内联 {info['inline_calls']} 处 / 经绑定调用 {len(info['calls'])} 处")
   449	
   450	    print(f"\n【无模块级 logger】{len(nolog)} 个: {', '.join(nolog) if nolog else '(无)'}")
   451	
   452	    print()
   453	    print("=" * 78)
   454	    print("表二 · 匿名内联日志调用 (无变量可寻址, 模块级包装永远罩不住)")
   455	    print("=" * 78)
   456	    for name, info in eps.items():
   457	        if info.get("error") or not info["inline_calls"]:
   458	            continue
   459	        print(f"  ✗ {name}: {info['inline_calls']} 处")
   460	    if total_inline == 0:
   461	        print("  (0 处)")
   462	
   463	    print()
   464	    print("=" * 78)
   465	    print("表四 · 服务层观测旁路移交登记  (CARD-G4-3 验收单 :1046 点名; 本卡只登记不改)")
   466	    print("=" * 78)
   467	    handoff = scan_handoff(backend)
   468	    handoff_calls = 0
   469	    for row in handoff:
   470	        if row.get("error"):
   471	            print(f"  !! {row['file']}::{row['func']} — {row['error']}")
   472	            continue
   473	        mark = "已包装" if row["module_wrapped"] else "未包装"
   474	        print(f"\n  {row['file']}::{row['func']}()   [{mark}]  ({row['note']})")
   475	        if not row["found"]:
   476	            print("      (该函数内未找到模块 logger 的调用 —— 函数可能已改名/重构, 需人工重锚)")
   477	            continue
   478	        for c in row["calls"]:
   479	            handoff_calls += 1
   480	            flag = " ⚠f-string" if c.fstring else ""
   481	            print(f"      :{c.lineno:<6} {c.receiver}.{c.method}{flag}")
   482	            print(f"              {c.snippet[:88]}")
   483	
   484	    print()
   485	    print("-" * 78)
   486	    print(
   487	        f"登记合计: 已包装 {len(wrapped)} / 未包装 {len(unwrapped)} / structlog {len(notwrappable)}"
   488	        f" / EXTERNAL {len(external_only)} / 死绑定 {len(dead)} / 无绑定有调用 {len(nobinding)}"
   489	        f" / 无 logger {len(nolog)}"
   490	    )
   491	    print(f"          端点层调用点 {total_calls} 处 (其中 f-string {total_fstring} 处, 匿名内联 {total_inline} 处)")
   492	    print(f"          服务层移交站点 {handoff_calls} 处日志调用 (跨 {len(HANDOFF_ANCHORS)} 个锚定函数)")
   493	    print("-" * 78)
   494	    print("本表不证明什么: 只看模块级绑定 + 经它发出的调用 + 匿名内联。函数内局部")
   495	    print("绑定的 logger、经 .inner 绕过包装的调用、handler/装饰器级保护, 本表看不见。")
   496	    print("f-string 列与包装正交: f-string 在实参求值阶段抛错, 包装拦不住, 唯一修法")
   497	    print("是转 %-惰性参数。")
   498	    return 0
   499	
   500	
   501	if __name__ == "__main__":
   502	    raise SystemExit(main())

