def src(rev,p):
    return subprocess.check_output(["git","show",f"{rev}:{p}"],text=True)
def facts(text):
    t=ast.parse(text)
    routes=[]
    http=[]
    models=[]
    for n in ast.walk(t):
        if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)):
            dec=[ast.dump(d,include_attributes=False) for d in n.decorator_list if isinstance(d,ast.Call) and isinstance(d.func,ast.Attribute)]
            if dec: routes.append((n.name,dec,ast.dump(n.returns,include_attributes=False) if n.returns else None))
        if isinstance(n,ast.Call) and ((isinstance(n.func,ast.Name) and n.func.id=="HTTPException") or (isinstance(n.func,ast.Attribute) and n.func.attr=="HTTPException")):
            http.append(ast.dump(n,include_attributes=False))
        if isinstance(n,ast.ClassDef):
            models.append(ast.dump(n,include_attributes=False))
    return routes,http,models
