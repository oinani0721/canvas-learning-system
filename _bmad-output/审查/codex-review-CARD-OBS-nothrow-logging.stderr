     8	
     9	import logging
    10	from datetime import datetime
    11	from logging.handlers import RotatingFileHandler
    12	from pathlib import Path
    13	
    14	
    15	def setup_memory_system_logger() -> logging.Logger:
    16	    """
    17	    配置记忆系统专用日志
    18	
    19	    Features:
    20	    - 按日期命名的日志文件
    21	    - 按大小轮转 (最大 10MB)
    22	    - 保留最近 14 个文件
    23	    - UTF-8 编码支持中文
    24	    """
    25	    logger = logging.getLogger("memory_system")
    26	
    27	    # 避免重复添加 handler
    28	    if logger.handlers:
    29	        return logger
    30	
    31	    logger.setLevel(logging.DEBUG)
    32	
    33	    # 创建日志目录
    34	    log_dir = Path(__file__).parent.parent.parent / "logs"
    35	    log_dir.mkdir(exist_ok=True)
    36	
    37	    # 日志文件 (按日期命名)
    38	    log_file = log_dir / f"memory-system-{datetime.now().strftime('%Y-%m-%d')}.log"
    39	
    40	    # 文件处理器 (按大小轮转, 最大 10MB, 保留 14 个文件)
    41	    file_handler = RotatingFileHandler(
    42	        log_file,
    43	        maxBytes=10 * 1024 * 1024,  # 10MB
    44	        backupCount=14,
    45	        encoding="utf-8",
    46	    )
    47	    file_handler.setLevel(logging.DEBUG)
    48	
    49	    # 日志格式
    50	    formatter = logging.Formatter(
    51	        "[%(asctime)s] | %(levelname)-8s | %(name)s:%(funcName)s:%(lineno)d | %(message)s",
    52	        datefmt="%Y-%m-%d %H:%M:%S",
    53	    )
    54	    file_handler.setFormatter(formatter)
    55	
    56	    logger.addHandler(file_handler)
    57	
    58	    # 同时输出到控制台 (INFO 级别以上)
    59	    console_handler = logging.StreamHandler()
    60	    console_handler.setLevel(logging.INFO)
    61	    console_handler.setFormatter(formatter)
    62	    logger.addHandler(console_handler)
    63	
    64	    return logger
    65	
    66	
    67	# 全局日志实例
    68	memory_logger = setup_memory_system_logger()
