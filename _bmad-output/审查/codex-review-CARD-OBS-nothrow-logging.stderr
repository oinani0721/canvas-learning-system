    29	  "判定正确"和"判定恒返回未包装"。**一道恒 0 的门与一道恒 0 的坏门同形。**
    30	- 结构验伪锚: rollback.py 的匿名内联调用、health.py 的 EXTERNAL logger
    31	  —— 检不出来 = 判定函数漏了这两类, 拒绝出报告。
    32	
    33	本表不证明什么 (打印在报告尾部): 只看模块级绑定 + 经它发出的调用 + 匿名内联。
    34	函数内局部绑定的 logger、经 ``.inner`` 绕过包装的调用、handler/装饰器级的
    35	保护方案, 本表看不见。
    36	"""
    37	
    38	import argparse
    39	import ast
    40	import sys
    41	from pathlib import Path
    42	from typing import Dict, List, Optional, Set, Tuple
    43	
    44	sys.dont_write_bytecode = True
    45	
    46	LOG_METHODS = {"debug", "info", "warning", "warn", "error", "exception", "critical", "log", "fatal"}
    47	
    48	HANDOFF_ANCHORS: List[Tuple[str, str, str]] = [
    49	    ("app/services/rag_service.py", "initialize", "G4-3 记 :194"),
    50	    ("app/services/rag_service.py", "_get_fallback_result", "G4-3 记 :209"),
    51	    ("app/services/rag_service.py", "query", "G4-3 记 :274-287/:289-290/:326-333"),
    52	    ("app/core/vault_scope.py", "active_vault_aliases", "G4-3 记 :133"),
    53	    ("app/core/vault_scope.py", "resolve_vault_scope", "G4-3 记 :184-198"),
    54	    ("app/services/memory_service.py", "get_learning_history", "G4-3 记 :665-682/:748/:843-850"),
    55	    ("app/services/memory_service.py", "get_concept_score_history", "G4-3 记 :1080-1089"),
    56	    ("app/clients/neo4j_client.py", "_handle_merge_learning", "G4-3 记 :746"),
    57	    ("lib/agentic_rag/nodes.py", "multi_query_rewrite_node", "G4-3 记 :1873"),
    58	]
    59	
    60	
    61	# ─────────────────────────────────────────────────────────────────────────────
    62	# AST 判定原语
    63	# ─────────────────────────────────────────────────────────────────────────────
    64	
    65	
    66	def _alias_table(tree: ast.Module) -> Set[str]:
    67	    """本文件里指向 nothrow 的本地别名 (from x import nothrow / nothrow as nt)。"""
    68	    names = {"nothrow"}
    69	    for node in ast.walk(tree):
    70	        if isinstance(node, ast.ImportFrom):
    71	            for alias in node.names:
    72	                if alias.name == "nothrow":
    73	                    names.add(alias.asname or alias.name)
    74	    return names
    75	
    76	
    77	def _is_call_named(node: ast.AST, names: Set[str], attr: Optional[str] = None) -> bool:
    78	    """nothrow(...) / obs.nothrow(...) / getLogger(...) 形态判定。
    79	
    80	    ``attr`` 给定时只认 ``.attr`` 尾名 (Attribute 形态) 或裸名 (Name 形态)。
    81	    """
    82	    if not isinstance(node, ast.Call):
    83	        return False
    84	    func = node.func
    85	    if isinstance(func, ast.Name):
    86	        return func.id in names and (attr is None or func.id == attr)
    87	    if isinstance(func, ast.Attribute):
    88	        return func.attr in names and (attr is None or func.attr == attr)
    89	    return False
    90	
    91	
    92	def _is_nothrow_call(node: ast.AST, aliases: Set[str]) -> bool:
    93	    return _is_call_named(node, aliases)
    94	
    95	
    96	def _is_getlogger_call(node: ast.AST) -> bool:
    97	    return _is_call_named(node, {"getLogger", "get_logger"})
    98	
    99	
   100	def _is_structlog_call(node: ast.AST) -> bool:
   101	    """structlog.get_logger(...) / structlog.stdlib.get_logger(...)。"""
   102	    if not isinstance(node, ast.Call):
   103	        return False
   104	    func = node.func
   105	    return isinstance(func, ast.Attribute) and func.attr == "get_logger"
   106	
   107	
   108	def _module_stmts(tree: ast.Module) -> List[ast.stmt]:
   109	    """模块级语句, 下探一层 Try/If 的 body (rollback.py 有 try-import 先例),
   110	    但不进 FunctionDef/ClassDef。"""
   111	    out: List[ast.stmt] = []
   112	    stack = list(tree.body)
   113	    while stack:
   114	        node = stack.pop(0)
   115	        out.append(node)
   116	        if isinstance(node, ast.Try):
   117	            stack.extend(node.body + node.orelse + [n for h in node.handlers for n in h.body])
   118	        elif isinstance(node, ast.If):
   119	            stack.extend(node.body + node.orelse)
   120	    return out
   121	
   122	
   123	class Binding:
   124	    def __init__(self, name, lineno, source, kind, wrapped):
   125	        self.name = name
   126	        self.lineno = lineno
   127	        self.source = source
   128	        self.kind = kind  # stdlib | structlog
   129	        self.wrapped = wrapped
   130	
   131	
   132	def _bindings(tree: ast.Module, lines: List[str], aliases: Set[str]) -> List[Binding]:
   133	    out = []
   134	    for node in _module_stmts(tree):
   135	        value = None
   136	        targets = []
   137	        if isinstance(node, ast.Assign):
   138	            value, targets = node.value, node.targets
   139	        elif isinstance(node, ast.AnnAssign) and node.value is not None:
   140	            value, targets = node.value, [node.target]
   141	        if value is None:
   142	            continue
   143	        nothrow_call = _is_nothrow_call(value, aliases)
   144	        getlogger = _is_getlogger_call(value)
   145	        structlog = _is_structlog_call(value)
   146	        if not (nothrow_call or getlogger or structlog):
   147	            continue
   148	        kind = "structlog" if structlog else "stdlib"
   149	        for target in targets:
   150	            if isinstance(target, ast.Name):
   151	                src = lines[node.lineno - 1].strip() if node.lineno <= len(lines) else ""
   152	                out.append(Binding(target.id, node.lineno, src, kind, nothrow_call))
   153	    return out
   154	
   155	
   156	def _imported_logger_names(tree: ast.Module) -> List[Tuple[str, int]]:
   157	    """函数体内 import 进来的 logger (包装状态在别的文件 → EXTERNAL)。"""
   158	    out = []
   159	    for node in ast.walk(tree):
   160	        if isinstance(node, ast.ImportFrom):
   161	            for alias in node.names:
   162	                if "logger" in alias.name.lower():
   163	                    out.append((alias.asname or alias.name, node.lineno))
   164	    return out
   165	
   166	
   167	class Call:
   168	    def __init__(self, lineno, method, fstring, func, snippet, receiver):
   169	        self.lineno = lineno
   170	        self.method = method
   171	        self.fstring = fstring
   172	        self.func = func
   173	        self.snippet = snippet
   174	        self.receiver = receiver
   175	
   176	
   177	def _spans(tree: ast.Module) -> List[Tuple[int, int, str]]:
   178	    return [
   179	        (n.lineno, getattr(n, "end_lineno", n.lineno), n.name)
   180	        for n in ast.walk(tree)
   181	        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
   182	    ]
   183	
   184	
   185	def _enclosing(spans, lineno):
   186	    best = None
   187	    for s, e, name in spans:
   188	        if s <= lineno <= e and (best is None or s > best[0]):
   189	            best = (s, e, name)
   190	    return best[2] if best else "<module>"
   191	
   192	
   193	def _calls(
   194	    tree: ast.Module,
   195	    bound_names: Set[str],
   196	    lines: List[str],
   197	    spans,
   198	    external_names: Optional[Set[str]] = None,
   199	) -> List[Call]:
   200	    external_names = external_names or set()
   201	    out = []
   202	    for node in ast.walk(tree):
   203	        if not isinstance(node, ast.Call):
   204	            continue
   205	        func = node.func
   206	        if not isinstance(func, ast.Attribute) or func.attr not in LOG_METHODS:
   207	            continue
   208	        base = func.value
   209	        receiver = None
   210	        if isinstance(base, ast.Name) and base.id in bound_names:
   211	            receiver = base.id
   212	        elif isinstance(base, ast.Name) and base.id in external_names:
   213	            receiver = f"<external:{base.id}>"
   214	        elif isinstance(base, ast.Call) and _is_getlogger_call(base):
   215	            receiver = "<inline-getLogger>"
   216	        if receiver is None:
   217	            continue
   218	        first = None
   219	        if node.args:
   220	            idx = 1 if (func.attr == "log" and len(node.args) > 1) else 0

