  1680	def _verify_seed_ledger_counts(text: str, scan: dict, problems: list[str]) -> None:
  1681	    """台账『种子』行的批注数必须绑到 scan JSON 里**该节点的** tips_count。
  1682	
  1683	    ⛔ 维护卡 B · H-2 后半 (round-6 实证): 原实现只有整行**形状**白名单
  1684	    (``- <节点> — 批注 N 条``), 不绑值 —— 把真实的「批注 2 条」改成
  1685	    「批注 999 条」形状照样合法, 实测 exit 0。白名单管住了句式, 没管住数字的出处。
  1686	
  1687	    scan JSON 的 ``ledger`` 是**按角色分组的 dict** (seeds/derived/unknown) 而非扁平
  1688	    列表 —— 我第一版直接迭代它, 拿到的是键字符串, verifier 当场抛 NameError/AttributeError,
  1689	    stdout 全空 exit 1, 症状伪装成"报告不合规"。这里显式摊平并容两种形态。
  1690	    """
  1691	    mseed = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", text, re.M | re.S)
  1692	    if not mseed:
  1693	        return
  1694	    groups = scan.get("ledger")
  1695	    rows: list[dict] = []
  1696	    if isinstance(groups, dict):
  1697	        for grp in groups.values():
  1698	            if isinstance(grp, list):
  1699	                rows.extend(x for x in grp if isinstance(x, dict))
  1700	    elif isinstance(groups, list):
  1701	        rows = [x for x in groups if isinstance(x, dict)]
  1702	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  1703	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  1704	        return
  1705	    tips_by_node = {str(r.get("node_id")): r.get("tips_count") for r in rows}

