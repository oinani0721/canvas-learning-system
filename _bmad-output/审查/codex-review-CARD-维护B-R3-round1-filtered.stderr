  3288	def test_domain_r5_noise_split_number_run_cli(tmp_path):
  3289	    """R3 round-2 行为门：排版噪声/不可见字符**不得**成为数串的断点。
  3290	
  3291	    `- 本板共有九十八万**五**个子节点。【实测】` 在 Obsidian 里渲染成
  3292	    「本板共有九十八万五个子节点」（粗体的五），而验证器原先只抓到尾片 `五`，
  3293	    `_cjk_single_to_int('五')==5` 且 5 在池内 ⇒ 纯虚构的 980005 **exit 0 放行**。
  3294	    ASCII 侧同形：`980 005个`（空格千分位）只查到 `005`。
  3295	
  3296	    **它证明什么**：CJK 与 ASCII 两侧、D2 与 fallback 两个消费面，数串都跨连接
  3297	    字符（排版标记 / `&nbsp;` / 空白 / 短 HTML 标签与注释 / 零宽与双向控制）整体
  3298	    抓取并剥噪声后再判；合法的单字/池内数值不受影响。
  3299	    **它不证明什么**：连接集是**封闭表**（与量词表同口径）。表外字符仍能切断数串
  3300	    （`九十八万x五个` / `九十八万、五个` / `[[x|]]` 的残留 `|]]`）——那些断点
  3301	    **渲染后可见**，读者不会读成一个连续的数；表外的**不可见**载体（如超长 HTML
  3302	    注释）是真残余，登记在验收单 §五之三，本门不宣称覆盖。
  3303	    """
  3304	    vault = standard_vault(tmp_path)
  3305	    scan = collect_json(vault)
  3306	    pool = _load_recap_scan()._derived_number_pool(scan)
  3307	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3308	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3309	    report = write_report(vault, scan)
  3310	    base_text = report.read_text(encoding="utf-8")
  3311	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3312	
  3313	    def verify(anchor: str, injected: str):
  3314	        text = base_text.replace(anchor, injected, 1)
  3315	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3316	        report.write_text(text, encoding="utf-8")
  3317	        return run_verify(report)
  3318	
  3319	    def d2(line: str):
  3320	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3321	
  3322	    # ── 拦截面：渲染后连续、源码被切断 ──
  3323	    for name, line in (
  3324	        ("粗体", "- 本板共有九十八万**五**个子节点。【实测】"),
  3325	        ("空白", "- 本板共有九十八万 五个子节点。【实测】"),
  3326	        ("nbsp", "- 本板共有九十八万&nbsp;五个子节点。【实测】"),
  3327	        ("空标签", "- 本板共有九十八万<span></span>五个子节点。【实测】"),
  3328	        ("修饰字余", "- 本板共有九十八万余五个子节点。【实测】"),
  3329	        ("行内代码", "- 本板共有九十八万`x`五个子节点。【实测】"),
  3330	    ):
  3331	        r = d2(name and line)
  3332	        assert r.returncode != 0, f"CJK {name}切断被放行:\n{r.stdout}"
  3333	        assert "九十八万五" in r.stdout, f"CJK {name}: 诊断未还原成完整数串:\n{r.stdout}"
  3334	    for name, line, whole in (
  3335	        ("空格千分位", "- 本板共有980 005个子节点。【实测】", "980005"),
  3336	        ("粗体", "- 本板共有98765**4**个子节点。【实测】", "987654"),
  3337	        # ⛔ 与「前导零归一化」的交互：行级剥零会把 `1 000`(渲染=1000, SI 千分位)
  3338	        # 先剥成 `1 0` 再拼成 `10` 落进池内 ⇒ 放行。归一化必须作用在拼接后的
  3339	        # token 上（车道实测，本卡修复时自己踩出来的洞）。
  3340	        ("SI千分位+前导零", "- 本板共有1 000个子节点。【实测】", "1000"),
  3341	    ):
