  3050	def test_domain_r4_leading_space_blockquote_list_fence(tmp_path):
  3051	    """round-4 A: 前导空格的引用内列表围栏（` > - ``` `）藏信号必须拦。
  3052	
  3053	    `_quote_width` 原来只从 `>` 起算——引用标记**前**的前导空白不计入时，
  3054	    内容列被算大，` >   信号行` 被误判「缩进不足→容器结束→可见正文」而放行；
  3055	    markdown-it 确认该形态渲染在 `<pre><code>` 内（Codex round-4 stderr 实证）。
  3056	    """
  3057	    vault = standard_vault(tmp_path)
  3058	    scan = collect_json(vault)
  3059	    report = write_report(vault, scan)
  3060	    lines = report.read_text(encoding="utf-8").splitlines()
  3061	    idx = [i for i, ln in enumerate(lines) if any(lb in ln for lb in SIGNAL_LABELS)]
  3062	    core = [lines[i].lstrip("> ").lstrip("- ").strip() for i in range(idx[0], idx[-1] + 1)]
  3063	    body = [" > - ```"] + [" >   " + x for x in core] + [" >   ```"]
  3064	    out = lines[: idx[0]] + body + lines[idx[-1] + 1 :]
  3065	    report.write_text("\n".join(out) + "\n", encoding="utf-8")
  3066	    r = run_verify(report)
  3067	    assert r.returncode != 0, f"前导空格引用内列表围栏藏信号被放行:\n{r.stdout}"
  3068	    assert "代码块内出现信号名" in r.stdout or "缺信号行" in r.stdout
