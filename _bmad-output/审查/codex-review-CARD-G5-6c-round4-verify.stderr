   189	def sha(p: pathlib.Path) -> str:
   190	    return hashlib.sha256(p.read_bytes()).hexdigest()
   191	
   192	
   193	def run_suite() -> tuple[int, set[str], str]:
   194	    r = subprocess.run(
   195	        PYTEST,
   196	        cwd=BACKEND,
   197	        capture_output=True,
   198	        text=True,
   199	        env={
   200	            "PATH": "/usr/bin:/bin",
   201	            "PYTHONDONTWRITEBYTECODE": "1",
   202	            "HOME": str(pathlib.Path.home()),
   203	            "LC_ALL": "C.UTF-8",
   204	        },
   205	    )
   206	    out = r.stdout + r.stderr
   207	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   208	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   209	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   210	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   211	    failed = {
   212	        ln.split("::")[1].split(" ")[0].strip()
   213	        for ln in out.splitlines()
   214	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   215	    }
   216	    tail = [
   217	        ln
   218	        for ln in out.splitlines()
   219	        if "passed" in ln or "failed" in ln or "error" in ln
   220	    ]
   221	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   222	
   223	
   224	original = SRC.read_bytes()
   225	base_sha = sha(SRC)
   226	print(f"源码基线 sha256 = {base_sha}\n", flush=True)
   227	
   228	
   229	def _restore_on_signal(signum, _frame):
   230	    """⛔ 真事故（2026-09-02）：本脚本被 2 分钟超时 SIGTERM 杀掉时，`finally`
   231	    **没有执行** —— Python 默认信号处理器直接终止进程，不抛异常，源码被留在
   232	    M-PAIRS 变异态。原地改源码的脚本必须显式注册处理器才谈得上「一定还原」。
   233	    （能安全恢复靠的是上面那行基线 sha 已经打印出来 —— 有它，还原才有可验证
   234	    判据；没有它只能凭记忆猜该改回什么。）"""
   235	    SRC.write_bytes(original)
   236	    print(f"\n⛔ 收到信号 {signum}，已还原源码 sha256={sha(SRC)}", flush=True)
   237	    sys.exit(128 + signum)
   238	
   239	
   240	for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
   241	    signal.signal(_sig, _restore_on_signal)
   242	
   243	results: list[tuple[str, bool]] = []
   244	try:
   245	    for name, expected, layers in MUTATIONS:
   246	        text = original.decode("utf-8")
   247	        for old, new in layers:
   248	            n = text.count(old)
   249	            if n != 1:
   250	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   251	            text = text.replace(old, new)
   252	        SRC.write_text(text, encoding="utf-8")
   253	        if sha(SRC) == base_sha:
   254	            raise SystemExit(f"[{name}] 变异没有真的改到字节")
   255	
   256	        rc, failed, summary = run_suite()
   257	        SRC.write_bytes(original)
   258	        restored = sha(SRC)
   259	
   260	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   261	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   262	        # 「跑完了且有测试失败」的只有 rc=1。
   263	        ok = failed == expected and rc == 1 and restored == base_sha
   264	        results.append((name, ok))
   265	        print(f"{'✅' if ok else '❌'} {name}")
   266	        print(f"   期望红: {sorted(expected)}")
   267	        print(f"   实际红: {sorted(failed)}")
   268	        if failed - expected:
   269	            print(f"   ⚠️ 多红（波及面比预期大）: {sorted(failed - expected)}")
   270	        if expected - failed:
   271	            print(f"   ⛔ 少红（该防线没有门在测）: {sorted(expected - failed)}")
   272	        print(
   273	            f"   rc={rc} | {summary} | 还原 sha "
   274	            f"{'一致' if restored == base_sha else '⛔不一致'}\n"
   275	        )
   276	finally:
   277	    SRC.write_bytes(original)
   278	    final = sha(SRC)
   279	    print(
   280	        f"finally 还原后 sha256 = {final} "
   281	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   282	    )
   283	
   284	allok = (
   285	    all(ok for _, ok in results)
   286	    and sha(SRC) == base_sha
   287	    and len(results) == len(MUTATIONS)
   288	)
   289	print("\n" + "=" * 70)
   290	print(
   291	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   292	    f"（{sum(1 for _, ok in results if ok)}/{len(MUTATIONS)} 变异的实际失败集合等于预先声明集合）"
   293	)
   294	sys.exit(0 if allok else 1)

