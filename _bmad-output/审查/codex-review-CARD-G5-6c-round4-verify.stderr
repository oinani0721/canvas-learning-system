   755	def skeleton_note(text: str, size: int) -> str:
   756	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   757	
   758	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   759	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   760	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   761	    """
   762	    if size == 0:
   763	        return "0 字节空文件"
