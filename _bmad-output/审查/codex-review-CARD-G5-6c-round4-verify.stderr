  1540	def test_source_inside_closed_html_comment_blocks_deletion(tmp_path):
  1541	    """⛔ round-3 审查 HIGH: 唯一来源写在**闭合** HTML 注释里时 C3/C4 双出口全穿。
  1542	
  1543	    根因是保护面不对称: `<!--` 没等到 `-->` (未闭合) 受①保护, 而闭合注释被
  1544	    `_classify_lines_typed` 整段剥掉后**无人接** —— 来源扫描与⑨兜底都只看
  1545	    frontmatter。信号⑩与①对称补上: ①保护「不知道被吞了什么」, ⑩保护「知道被
  1546	    吞了什么, 但引擎没消费它」。
  1547	    ⚠\ufe0f 语义代价如实: 任何带非空闭合注释的骨架件都不再确定删除, 不只是带来源的
  1548	    那些 —— 因为「注释里那句话重不重要」同样不可机械判定 (与取消白名单同源)。
  1549	    """
  1550	    vault, out = base_vault(tmp_path)
  1551	    inbox = vault / "_待处理"
  1552	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1553	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1554	    for name, text in (
  1555	        ("注释里的URL.md", "# 标题\n\n<!-- source: https://example.test/p -->\n"),
  1556	        ("注释里的DOI.md", "# 标题\n\n<!-- DOI:10.1000/hidden -->\n"),
  1557	        ("注释里的ISBN.md", "# 标题\n\n<!-- citation: ISBN 978-7-111-54742-6 -->\n"),
  1558	        ("注释里的生成声明.md", "# 标题\n\n<!-- generated with GPT-4 -->\n"),
  1559	        ("注释里的URL重复件.md", "<!-- source: https://only-here.test/p -->\n" + body),
  1560	    ):
  1561	        mk(inbox / name, text, age_days=6)
  1562	    # ⛔ 正向对照(验伪锚): 没有注释的骨架 → 仍 C3 确定删除
  1563	    mk(inbox / "无注释骨架.md", "# 标题\n\n## 小节\n", age_days=3)
  1564	
  1565	    assert run_cli(vault, out).returncode == 0
  1566	    data = load_json(out)
  1567	    assert data["items"], "items 为空则本门恒真 = 假绿"
  1568	    for name in (
  1569	        "注释里的URL.md",
  1570	        "注释里的DOI.md",
  1571	        "注释里的ISBN.md",
  1572	        "注释里的生成声明.md",
  1573	        "注释里的URL重复件.md",
  1574	    ):
  1575	        it = item_by_name(data, name)
  1576	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  1577	        assert it["criterion"] == "C6_undecided", name
  1578	        assert it["confident"] is False, name
  1579	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1580	        assert "注释" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1581	    assert item_by_name(data, "注释里的URL重复件.md")["exact_duplicate_of"] == "节点/库内正本.md"
  1582	    ctrl = item_by_name(data, "无注释骨架.md")
  1583	    assert ctrl["criterion"] == "C3_empty_or_skeleton", ctrl["basis"]
  1584	    assert ctrl["verdict"] == "建议删"
