   277	+
   278	+
   279	+def test_source_inside_closed_html_comment_blocks_deletion(tmp_path):
   280	+    """⛔ round-3 审查 HIGH: 唯一来源写在**闭合** HTML 注释里时 C3/C4 双出口全穿。
   281	+
   282	+    根因是保护面不对称: `<!--` 没等到 `-->` (未闭合) 受①保护, 而闭合注释被
   283	+    `_classify_lines_typed` 整段剥掉后**无人接** —— 来源扫描与⑨兜底都只看
   284	+    frontmatter。信号⑩与①对称补上: ①保护「不知道被吞了什么」, ⑩保护「知道被
   285	+    吞了什么, 但引擎没消费它」。
   286	+    ⚠\ufe0f 语义代价如实: 任何带非空闭合注释的骨架件都不再确定删除, 不只是带来源的
   287	+    那些 —— 因为「注释里那句话重不重要」同样不可机械判定 (与取消白名单同源)。
   288	+    """
   289	+    vault, out = base_vault(tmp_path)
   290	+    inbox = vault / "_待处理"
   291	+    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
   292	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   293	+    for name, text in (
   294	+        ("注释里的URL.md", "# 标题\n\n<!-- source: https://example.test/p -->\n"),
   295	+        ("注释里的DOI.md", "# 标题\n\n<!-- DOI:10.1000/hidden -->\n"),
   296	+        ("注释里的ISBN.md", "# 标题\n\n<!-- citation: ISBN 978-7-111-54742-6 -->\n"),
   297	+        ("注释里的生成声明.md", "# 标题\n\n<!-- generated with GPT-4 -->\n"),
   298	+        ("注释里的URL重复件.md", "<!-- source: https://only-here.test/p -->\n" + body),
   299	+    ):
   300	+        mk(inbox / name, text, age_days=6)
   301	+    # ⛔ 正向对照(验伪锚): 没有注释的骨架 → 仍 C3 确定删除
   302	+    mk(inbox / "无注释骨架.md", "# 标题\n\n## 小节\n", age_days=3)
   303	+
   304	+    assert run_cli(vault, out).returncode == 0
   305	+    data = load_json(out)
   306	+    assert data["items"], "items 为空则本门恒真 = 假绿"
   307	+    for name in (
   308	+        "注释里的URL.md",
   309	+        "注释里的DOI.md",
   310	+        "注释里的ISBN.md",
