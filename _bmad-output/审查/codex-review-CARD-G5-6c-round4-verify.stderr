   979	def _find_marker_pos(ln: str, marker: str) -> int:
   980	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   981	
   982	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   983	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   984	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   985	    行内更靠后的真命中。
   986	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   987	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   988	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   989	    只认行尾或标点；漏判方向落 C6，安全。"""
   990	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   991	    start = 0
   992	    while (i := ln.find(marker, start)) >= 0:
   993	        j = i + len(marker)
   994	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   995	            return i
   996	        if not ascii_ending and ln[j].isspace():
   997	            return i
   998	        start = i + 1
   999	    return -1
