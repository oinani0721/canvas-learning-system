  2459	def test_source_inside_closed_html_comment_blocks_deletion(tmp_path):
  2460	    """⛔ round-3 审查 HIGH: 唯一来源写在**闭合** HTML 注释里时 C3/C4 双出口全穿。
  2461	
  2462	    根因是保护面不对称: `<!--` 没等到 `-->` (未闭合) 受①保护, 而闭合注释被
  2463	    `_classify_lines_typed` 整段剥掉后**无人接** —— 来源扫描与⑨兜底都只看
  2464	    frontmatter。信号⑩与①对称补上: ①保护「不知道被吞了什么」, ⑩保护「知道被
  2465	    吞了什么, 但引擎没消费它」。
  2466	    ⚠\ufe0f 语义代价如实: 任何带非空闭合注释的骨架件都不再确定删除, 不只是带来源的
  2467	    那些 —— 因为「注释里那句话重不重要」同样不可机械判定 (与取消白名单同源)。
  2468	    """
  2469	    vault, out = base_vault(tmp_path)
  2470	    inbox = vault / "_待处理"
  2471	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2472	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2473	    for name, text in (
  2474	        ("注释里的URL.md", "# 标题\n\n<!-- source: https://example.test/p -->\n"),
