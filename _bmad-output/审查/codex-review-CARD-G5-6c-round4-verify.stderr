  2506	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  2507	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  2508	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  2509	
  2510	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  2511	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  2512	    """
  2513	    mod = load_module()
  2514	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  2515	    samples = [
  2516	        "\u200b",
  2517	        "\u200c",
  2518	        "\u200d",
  2519	        "\u2060",
  2520	        "\ufeff",
  2521	        "\u00ad",  # 原表六个
  2522	        "\u2063",
  2523	        "\u200e",
  2524	        "\u200f",
  2525	        "\u061c",
  2526	        "\u034f",  # round-3 新抓
  2527	        "\ufe0f",
  2528	        "\u2062",
  2529	        "\u180e",
  2530	        "\u202e",  # round-3 新抓
  2531	    ]
  2532	    for ch in samples:
  2533	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  2534	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  2535	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  2536	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  2537	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  2538	
