  1002	def find_ai_marker(text: str) -> tuple[int, str] | None:
  1003	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
  1004	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
  1005	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
  1006	    —— 行号准确，文本保真。"""
  1007	    for lineno, ln in head_window(text):
  1008	        norm = _norm_ai_line(ln)
  1009	        hits = [
  1010	            (pos, -len(nm), orig)
