   799	#: SEPARATOR 以及 U+200E/200F/061C/034F/FE0F/2062/180E/202E 共 9 个同族**全部
   800	#: 穿透**，C3 与 C4 两个出口都中。这与 round-2 的模型名教训是同一件事：
   801	#: **不可见字符不是一张能数完的表**，判它得按类别而不是按名单。
   802	#:   Cf = 格式字符（零宽空格/连接符/双向控制/不可见分隔符…）
   803	#:   Mn = 非间距标记（VS16、CGJ 这类零宽度记号）
   804	#:   Cc = 控制字符
   805	#: ⚠️ 只用在**护栏匹配面**：剥掉组合记号会改变带重音文本的词形，但护栏只判
   806	#: 「这行像不像生成声明」，方向是更容易命中；产物输出一律走原文，不受影响。
   807	_INVISIBLE_CATEGORIES = frozenset({"Cf", "Mn", "Cc"})
