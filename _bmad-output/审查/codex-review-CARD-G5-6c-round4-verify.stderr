   292	def test_c4_exact_duplicate_gives_canonical_path(tmp_path):
   293	    """C4 正例: 归一化正文逐字相等 → 建议删 + 正本相对路径。
   294	    归一化须吸收行尾空白 / 空行 / NFD-NFC 差异 (三者同时施加)。"""
   295	    vault, out = base_vault(tmp_path)
   296	    body = "转学政策原文第一段。\n第二段内容 café。\n"
   297	    mk(vault / "节点" / "政策正本.md", "# 正本\n\n" + body, age_days=40)
   298	    # 收件箱副本: 行尾空白 + 多余空行 + NFD 形态
   299	    dup = unicodedata.normalize("NFD", "转学政策原文第一段。   \n\n\n第二段内容 café。  \n")
   300	    mk(vault / "_待处理" / "政策粘贴-重复.md", "# 抄来的\n\n" + dup, age_days=2)
   301	
   302	    assert run_cli(vault, out).returncode == 0
   303	    it = load_json(out)["items"][0]
   304	    assert it["criterion"] == "C4_exact_duplicate"
   305	    assert it["verdict"] == "建议删"
   306	    assert it["exact_duplicate_of"] == "节点/政策正本.md"
   307	    assert it["confident"] is True
   308	
