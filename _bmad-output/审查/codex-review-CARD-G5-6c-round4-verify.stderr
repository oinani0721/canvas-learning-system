  1587	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  1588	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  1589	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  1590	
  1591	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  1592	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  1593	    """
  1594	    mod = load_module()
  1595	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  1596	    samples = [
  1597	        "\u200b",
  1598	        "\u200c",
  1599	        "\u200d",
  1600	        "\u2060",
  1601	        "\ufeff",
  1602	        "\u00ad",  # 原表六个
  1603	        "\u2063",
  1604	        "\u200e",
  1605	        "\u200f",
  1606	        "\u061c",
  1607	        "\u034f",  # round-3 新抓
  1608	        "\ufe0f",
  1609	        "\u2062",
  1610	        "\u180e",
  1611	        "\u202e",  # round-3 新抓
  1612	    ]
  1613	    for ch in samples:
  1614	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  1615	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  1616	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  1617	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  1618	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  1619	
  1620	    # 端到端半边: 用 round-3 审查的原始反例形态
  1621	    vault, out = base_vault(tmp_path)
  1622	    inbox = vault / "_待处理"
  1623	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1624	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1625	    mk(inbox / "u2063英文标题.md", "# Genera\u2063ted by GPT-4\n", age_days=7)
  1626	    mk(inbox / "u2063中文标题.md", "# 本文由 GPT-4 生\u2063成\n", age_days=6)
  1627	    mk(inbox / "u2063重复件.md", "# Genera\u2063ted by GPT-4\n\n" + body, age_days=5)
  1628	    mk(inbox / "无注释骨架.md", "# 标题\n\n## 小节\n", age_days=3)
  1629	
  1630	    assert run_cli(vault, out).returncode == 0
  1631	    data = load_json(out)
  1632	    for name in ("u2063英文标题.md", "u2063中文标题.md", "u2063重复件.md"):
  1633	        it = item_by_name(data, name)
  1634	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  1635	        assert it["criterion"] == "C6_undecided", name
  1636	        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1637	    ctrl = item_by_name(data, "无注释骨架.md")
  1638	    assert ctrl["criterion"] == "C3_empty_or_skeleton"
  1639	    assert ctrl["verdict"] == "建议删"

