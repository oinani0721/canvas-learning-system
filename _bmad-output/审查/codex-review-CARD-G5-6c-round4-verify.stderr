   266	def test_c3_empty_and_skeleton_positive_and_negative(tmp_path):
   267	    """C3: 0 字节 / 剥离后无正文的骨架 → 建议删; 有正文者不得命中。"""
   268	    vault, out = base_vault(tmp_path)
   269	    inbox = vault / "_待处理"
   270	    mk(inbox / "未命名 5.md", "", age_days=9)
   271	    # round-3 起闭合注释里有内容也算未消化（信号⑩），故 C3 正例不带注释
   272	    mk(inbox / "空骨架.md", "# 标题\n\n## 小节\n\n- \n- \n", age_days=8)
   273	    mk(inbox / "有正文.md", "# 标题\n\n这里有真正的正文内容。\n还有第二行。\n", age_days=7)
   274	
   275	    assert run_cli(vault, out).returncode == 0
   276	    data = load_json(out)
   277	
   278	    zero = item_by_name(data, "未命名 5.md")
   279	    assert zero["criterion"] == "C3_empty_or_skeleton"
   280	    assert zero["verdict"] == "建议删"
   281	    assert "0 字节" in zero["basis"]
   282	
   283	    skel = item_by_name(data, "空骨架.md")
   284	    assert skel["criterion"] == "C3_empty_or_skeleton"
   285	    assert skel["verdict"] == "建议删"
   286	
   287	    body = item_by_name(data, "有正文.md")
