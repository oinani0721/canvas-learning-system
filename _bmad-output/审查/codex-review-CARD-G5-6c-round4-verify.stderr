   330	def test_c4_empty_body_never_enters_dup_index(tmp_path):
   331	    """空正文不得互为「正本」—— 否则两个空骨架会互相支撑出一条有后果的建议删。"""
   332	    vault, out = base_vault(tmp_path)
   333	    # round-3 起 frontmatter 任何非空值都让 C3 让位给 C6，故此处用无 fm 的骨架，
   334	    # 本门要锁的是「空正文不进重复索引」，不是 fm 的处置。
   335	    mk(vault / "节点" / "库内空壳.md", "# 库内标题\n\n## 小节\n", age_days=40)
   336	    mk(vault / "_待处理" / "收件箱空壳.md", "# 收件箱标题\n\n## 小节\n", age_days=2)
   337	
   338	    assert run_cli(vault, out).returncode == 0
   339	    it = load_json(out)["items"][0]
   340	    assert it["criterion"] == "C3_empty_or_skeleton"
   341	    assert it["exact_duplicate_of"] is None, "空正文不得进重复索引"
