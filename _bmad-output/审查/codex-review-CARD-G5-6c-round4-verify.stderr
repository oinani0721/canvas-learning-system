   708	
   709	def dup_body(text: str) -> str:
   710	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   711	
   712	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   713	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   714	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   715	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   716	    有后果的提名，依据必须逐字。
   717	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   718	    """
   719	    parts: list[str] = []
   720	    for ln, is_code in _classify_lines(text):
   721	        if not is_code and _HEADING_RE.match(ln):
   722	            continue
   723	        t = ln.rstrip()
   724	        if not t:
   725	            continue
   726	        parts.append(nfc(t))
   727	    return "\n".join(parts)
   728	
   729	
   730	def has_substantive_content(text: str) -> bool:
   731	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   732	
   733	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   734	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   735	    合用一个函数正是 Codex BLOCKER 的根因。
   736	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   737	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   738	    （round-3 自审 B3-3）。
   739	    """
   740	    for ln, kind in _classify_lines_typed(text)[0]:
   741	        if kind == "code":
   742	            if ln.strip():
   743	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   744	            continue
   745	        if kind == "fence":
   746	            continue
   747	        if _HEADING_RE.match(ln):
   748	            continue
   749	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   750	        if t and not _ONLY_STRUCT_RE.match(t):
   751	            return True
   752	    return False
