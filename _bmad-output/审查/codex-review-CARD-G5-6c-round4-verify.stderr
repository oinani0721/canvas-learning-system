   247	def test_basis_line_number_survives_empty_frontmatter(tmp_path):
   248	    """依据里的行号是给人核对用的 —— 空 frontmatter（`---` 紧接 `---`）时不得偏移。
   249	
   250	    早先版本用 `len(fm) + 2` 反推 frontmatter 跨度, 空 frontmatter 的 fm == []
   251	    被当成「没有 frontmatter」, 行号整体少算 2。行号偏了等于没给依据。
   252	    """
   253	    vault, out = base_vault(tmp_path)
