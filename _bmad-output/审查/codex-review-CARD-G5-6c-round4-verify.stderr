   330	def test_c4_empty_body_never_enters_dup_index(tmp_path):
   331	    """空正文不得互为「正本」—— 否则两个空骨架会互相支撑出一条有后果的建议删。"""
   332	    vault, out = base_vault(tmp_path)
   333	    # round-3 起 frontmatter 任何非空值都让 C3 让位给 C6，故此处用无 fm 的骨架，
   334	    # 本门要锁的是「空正文不进重复索引」，不是 fm 的处置。
   335	    mk(vault / "节点" / "库内空壳.md", "# 库内标题\n\n## 小节\n", age_days=40)
   336	    mk(vault / "_待处理" / "收件箱空壳.md", "# 收件箱标题\n\n## 小节\n", age_days=2)
   337	
   338	    assert run_cli(vault, out).returncode == 0
   339	    it = load_json(out)["items"][0]
   340	    assert it["criterion"] == "C3_empty_or_skeleton"
   341	    assert it["exact_duplicate_of"] is None, "空正文不得进重复索引"
   342	
   343	
   344	def test_corpus_index_excludes_empty_bodies(tmp_path):
   345	    """索引层自己的门。⛔ 与上一条**不是重复**: 上一条走端到端(受 nominate 的
   346	    `if body` 兜底保护, 单删索引层杀不掉它); 本条直取 scan_corpus, 单删索引层即翻红。
   347	    每层各有一道门, 才不会出现「删掉一层没人发现」。"""
   348	    mod = load_module()
   349	    vault, _ = base_vault(tmp_path)
   350	    mk(vault / "节点" / "空壳甲.md", "---\ntitle: a\n---\n\n# 只有标题\n")
   351	    mk(vault / "节点" / "空壳乙.md", "# 另一个只有标题\n\n## 二级\n\n- \n")
   352	    mk(vault / "节点" / "有正文.md", "真正的正文一行。\n第二行。\n")
   353	
   354	    index, bodies, stats = mod.scan_corpus(vault, [])
   355	    assert "" not in index, "空正文进了重复索引 —— 两个空骨架会互为「正本」"
   356	    assert stats["skipped_empty_body"] == 2
   357	    assert stats["files_indexed"] == 1
   358	    assert all(b for _, b in bodies)
   359	
