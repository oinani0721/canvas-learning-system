   206	def test_c2_ai_self_declared_positive_and_negative(tmp_path):
   207	    """C2: 文头自述 AI 生成 → 二手综合·归档 DR 目录; 标记落在文头窗口外不得命中。"""
   208	    vault, out = base_vault(tmp_path)
   209	    inbox = vault / "_待处理"
   210	    mk(
   211	        inbox / "三校转学率对比.md",
   212	        "# 三校转学率对比\n\n> 本文由 Deep Research 生成\n\n正文若干行内容。\n再一行正文。\n",
   213	        age_days=7,
   214	    )
   215	    # 反例: 同一标记出现在很靠后的位置(文头窗口之外) → 不得命中 C2
   216	    tail = "\n".join(f"第 {i} 行普通正文。" for i in range(1, 60))
   217	    mk(inbox / "尾部提及.md", f"# 普通笔记\n\n{tail}\n\n这里才说 由 Deep Research 生成\n", age_days=6)
