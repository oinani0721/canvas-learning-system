   965	        for norm in _guard_variants(ln):
   966	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
   967	                m = rx.search(norm)
   968	                if not m:
   969	                    continue
   970	                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
   971	                # `generated by l` —— 人工核对时看不出是哪个模型。补到该词结束。
   972	                end = m.end()
   973	                while end < len(norm) and (norm[end].isalnum() or norm[end] in "-_.:"):
   974	                    end += 1
   975	                return norm[m.start() : end]
   976	    return None
