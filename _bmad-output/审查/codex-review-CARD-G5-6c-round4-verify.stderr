   176	def test_c1_source_url_positive_and_negative(tmp_path):
   177	    """C1: frontmatter source 为 http(s) URL → 一手快照·留原地; 非 URL 不得命中。"""
   178	    vault, out = base_vault(tmp_path)
   179	    inbox = vault / "_待处理"
   180	    mk(
   181	        inbox / "剪藏-学费页.md",
   182	        "---\nsource: https://deanza.edu/tuition\n---\n\n学费明细正文若干字, 足以过正文门。\n第二行正文。\n",
   183	        age_days=5,
   184	    )
   185	    # 反例: source 不是 URL → 不得判一手
   186	    mk(
   187	        inbox / "非URL来源.md",
   188	        "---\nsource: 我自己整理的\n---\n\n一些正文内容, 长度足够。\n第二行。\n",
   189	        age_days=4,
   190	    )
   191	    assert run_cli(vault, out).returncode == 0
   192	    data = load_json(out)
   193	
   194	    pos = item_by_name(data, "剪藏-学费页.md")
   195	    assert pos["criterion"] == "C1_source_url"
   196	    assert pos["verdict"] == "留原地"
   197	    assert pos["nomination_type"] == "primary-record"
   198	    assert pos["confident"] is True
   199	    assert "https://deanza.edu/tuition" in pos["basis"]
   200	
   201	    neg = item_by_name(data, "非URL来源.md")
   202	    assert neg["criterion"] != "C1_source_url"
   203	    assert neg["nomination_type"] != "primary-record"
