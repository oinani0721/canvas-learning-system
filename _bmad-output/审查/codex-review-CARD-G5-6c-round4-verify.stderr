     8	     C4 精确重复给正本路径 / C5 R{n} 归轮次 / C6 拿不准兜底, 每条正反各一
     9	  B. 「拿不准」0 硬猜 —— 近似重复(difflib)恒不产出建议删; 兜底条目恒无去向;
    10	     引擎不可达的去向词恒不出现
    11	  C. 零写快照 —— tmp fixture 全树 sha256+mtime_ns+mode 前后全等 (out-dir 在树外)
    12	  D. 确定性二跑 —— JSON 与 MD 逐字节相等
    13	  E. 拒绝路径零产物 —— 非法标签 / 超 255B / 显式 inbox 不存在 / 坏 --now /
    14	     batch-size 越界 / out-dir 祖先含 symlink, 一律 exit≠0 且 out-dir 无产物
    15	  F. 分批与台账 —— ≤10 最旧优先 + deferred 清单 + Sleeping 台账 + 30 天标记
    16	  G. 稳定 ID —— inb1- 前缀、路径决定、内容/mtime 无关、与 split anchor 不同空间
    17	
    18	fixtures 全部在 tmp_path 程序化构造 (mtime 与 NFD 文件名进 git 会被平台搅浑),
    19	构造逻辑即 fixture 定义。⛔ 本目录禁建 conftest.py, 故一切工具函数就地定义。
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import hashlib
    25	import importlib.util
    26	import json
    27	import os
    28	import shutil
    29	import subprocess
    30	import sys
    31	import unicodedata
    32	from datetime import datetime, timedelta, timezone
    33	from pathlib import Path
    34	
    35	import pytest
    36	
    37	REPO_ROOT = Path(__file__).resolve().parents[3]
    38	SKILLS = REPO_ROOT / "canvas-vault" / ".claude" / "skills"
    39	SCRIPT = SKILLS / "clear-inbox" / "scripts" / "inbox_preview.py"
    40	SPLIT_SCRIPT = SKILLS / "board-split" / "scripts" / "split_preview.py"
    41	
    42	NOW_ISO = "2026-08-31T00:00:00+08:00"
    43	NOW_DT = datetime.fromisoformat(NOW_ISO)
    44	
    45	#: 判据编号 —— 卡片钦定次序, 落盘键与本元组逐字相同
    46	CRITERIA = (
    47	    "C1_source_url",
    48	    "C2_ai_self_declared",
    49	    "C3_empty_or_skeleton",
    50	    "C4_exact_duplicate",
    51	    "C5_round_filename",
    52	    "C6_undecided",
    53	)
    54	
    55	
    56	# ───────────────────────── 工具 ─────────────────────────
    57	
    58	
    59	def _exec_no_bytecode(spec, mod):
    60	    """⛔ 裁判自己也不许往 vault 里落 `__pycache__` —— 否则「零写侧」的证据链
    61	    是被测程序干净、而验证它的测试在旁边写文件。"""
    62	    prev = sys.dont_write_bytecode
    63	    sys.dont_write_bytecode = True
    64	    try:
    65	        spec.loader.exec_module(mod)
    66	    finally:
    67	        sys.dont_write_bytecode = prev
    68	
    69	
    70	def load_module():
    71	    if not SCRIPT.exists():
    72	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
    73	    spec = importlib.util.spec_from_file_location("inbox_preview", SCRIPT)
    74	    mod = importlib.util.module_from_spec(spec)
    75	    _exec_no_bytecode(spec, mod)
    76	    return mod
    77	
    78	
    79	def load_split_module():
    80	    if not SPLIT_SCRIPT.exists():
    81	        pytest.fail(f"复用来源脚本不存在: {SPLIT_SCRIPT}")
    82	    spec = importlib.util.spec_from_file_location("split_preview_ref", SPLIT_SCRIPT)
    83	    mod = importlib.util.module_from_spec(spec)
    84	    _exec_no_bytecode(spec, mod)
    85	    return mod
    86	
    87	
    88	def run_cli(vault: Path, out_dir: Path, *extra: str, now: str = NOW_ISO):
    89	    # ⛔ 防「脚本不存在 → returncode≠0 → 拒绝类断言假绿」
    90	    if not SCRIPT.exists():
    91	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
    92	    return subprocess.run(
    93	        [
    94	            sys.executable,
    95	            str(SCRIPT),
    96	            "--vault",
    97	            str(vault),
    98	            "--out-dir",
    99	            str(out_dir),
   100	            "--now",
   101	            now,
   102	            *extra,
   103	        ],
   104	        capture_output=True,
   105	        text=True,
   106	    )
   107	
   108	
   109	def products(out_dir: Path, label: str = "_待处理") -> tuple[Path, Path]:
   110	    return (
   111	        out_dir / f"inbox-preview-{label}.json",
   112	        out_dir / f"inbox-preview-{label}.md",
   113	    )
   114	
   115	
   116	def load_json(out_dir: Path, label: str = "_待处理") -> dict:
   117	    return json.loads(products(out_dir, label)[0].read_text(encoding="utf-8"))
   118	
   119	
   120	def no_products(out_dir: Path) -> bool:
   121	    """拒绝路径必须零产物。⛔ 判据是「目录不存在, 或存在但**完全为空**」——
   122	    原先只查 `inbox-preview-*`, 那样实现即便留下空目录、`.tmp` 半成品或换个名字的
   123	    产物, 断言照样为真（Codex MEDIUM: 断言证明不了它声称证明的事）。"""
   124	    if not out_dir.exists():
   125	        return True
   126	    return not any(out_dir.iterdir())
   127	
   128	
   129	def snapshot(root: Path) -> dict:
   130	    """全树取证: 每个条目 (sha256 | "dir") + st_mtime_ns + st_mode。
   131	    ⛔ 只对**不含产物**的树使用 —— 产物落在树内会让本快照自证其罪式失效。"""
   132	    out: dict[str, tuple] = {}
   133	    for p in sorted(root.rglob("*")):
   134	        st = p.lstat()
   135	        if p.is_symlink():
   136	            digest = "symlink:" + os.readlink(p)
   137	        elif p.is_dir():
   138	            digest = "dir"
   139	        else:
   140	            digest = hashlib.sha256(p.read_bytes()).hexdigest()
   141	        out[str(p.relative_to(root))] = (digest, st.st_mtime_ns, st.st_mode)
   142	    return out
   143	
   144	
   145	def days_ago(n: float) -> float:
   146	    return (NOW_DT - timedelta(days=n)).timestamp()
   147	
   148	
   149	def mk(path: Path, text: str, age_days: float = 1.0) -> Path:
   150	    path.parent.mkdir(parents=True, exist_ok=True)
   151	    path.write_text(text, encoding="utf-8")
   152	    ts = days_ago(age_days)
   153	    os.utime(path, (ts, ts))
   154	    return path
   155	
   156	
   157	def base_vault(tmp_path: Path) -> tuple[Path, Path]:
   158	    """最小合法 vault + 空收件箱; 返回 (vault, out_dir)。out_dir 恒在 vault 树外。"""
   159	    vault = tmp_path / "vault"
   160	    (vault / "原白板").mkdir(parents=True)
   161	    (vault / "节点").mkdir(parents=True)
   162	    (vault / "_待处理").mkdir(parents=True)
   163	    return vault, tmp_path / "out"
   164	
   165	
   166	def item_by_name(data: dict, name: str) -> dict:
   167	    for it in data["items"]:
   168	        if it["name"] == name:
   169	            return it
   170	    raise AssertionError(f"提名清单里没有 {name!r}; 实有 {[i['name'] for i in data['items']]}")
   171	
   172	
   173	# ───────────────────────── A. 六判据正反例 ─────────────────────────
   174	
   175	
   176	def test_c1_source_url_positive_and_negative(tmp_path):
   177	    """C1: frontmatter source 为 http(s) URL → 一手快照·留原地; 非 URL 不得命中。"""
   178	    vault, out = base_vault(tmp_path)
   179	    inbox = vault / "_待处理"
   180	    mk(
   181	        inbox / "剪藏-学费页.md",
   182	        "---\nsource: https://deanza.edu/tuition\n---\n\n学费明细正文若干字, 足以过正文门。\n第二行正文。\n",
   183	        age_days=5,
   184	    )
   185	    # 反例: source 不是 URL → 不得判一手
   186	    mk(
   187	        inbox / "非URL来源.md",
   188	        "---\nsource: 我自己整理的\n---\n\n一些正文内容, 长度足够。\n第二行。\n",
   189	        age_days=4,
   190	    )
   191	    assert run_cli(vault, out).returncode == 0
   192	    data = load_json(out)
   193	
   194	    pos = item_by_name(data, "剪藏-学费页.md")
   195	    assert pos["criterion"] == "C1_source_url"
   196	    assert pos["verdict"] == "留原地"
   197	    assert pos["nomination_type"] == "primary-record"
   198	    assert pos["confident"] is True
   199	    assert "https://deanza.edu/tuition" in pos["basis"]
   200	
   201	    neg = item_by_name(data, "非URL来源.md")
   202	    assert neg["criterion"] != "C1_source_url"
   203	    assert neg["nomination_type"] != "primary-record"
   204	
