   179	function humanizeDue(ts, nowMs) {
   180	  // ⚠ 纯显示层格式化 — 不是 due 判定: 谁到期/计数/排序全来自投影字段
   181	  // (boards[].due / due_count), 删掉本函数页面依然知道谁到期。
   182	  // 口径对齐服务端 _humanize_due (上海本地日差), 同源锁见 pytest 对拍测试。
   183	  if (ts === null || ts === undefined) return {text: "—", color: "#6b7280"};
   184	  if (ts === "") return {text: "现在", color: "#d97706"};
   185	  const ms = parseDueMs(ts);
   186	  if (ms === null) return {text: "—", color: "#6b7280"};
   187	  const d1 = shDay(ms), d0 = shDay(nowMs);
   188	  const days = Math.round((Date.parse(d1) - Date.parse(d0)) / 86400000);
   189	  if (days < 0) return {text: "逾期" + (-days) + "天", color: "#dc2626"};
   190	  if (days === 0) return {text: "现在", color: "#d97706"};
   191	  if (days === 1) return {text: "明天", color: "#374151"};
   192	  if (days <= 7) return {text: days + "天后", color: "#374151"};
   193	  const parts = d1.split("-").map(Number);
   194	  const y0 = Number(d0.split("-")[0]);
   195	  return {text: (parts[0] === y0 ? "" : parts[0] + "年") + parts[1] + "月" + parts[2] + "日", color: "#6b7280"};
   196	}
   197	function computePollDelayMs(data, nowMs) {
   198	  // 轮询周期 = clamp(最近**未来** next_upcoming.next_due − now, 5s, 60s)。
   199	  // next_due 只定「下一次去问服务端」的节奏; 已过期的 next_due 意味着数据
   200	  // 要等生产器重跑才会变 → 回落上限 60s, 不空转。
   201	  let best = null;
   202	  const vaults = data && Array.isArray(data.vaults) ? data.vaults : [];
   203	  for (const v of vaults) {
   204	    const nu = v && v.projection && v.projection.next_upcoming;
   205	    const ms = nu ? parseDueMs(nu.next_due) : null;
   206	    if (ms !== null && ms > nowMs && (best === null || ms < best)) best = ms;
   207	  }
   208	  const raw = best === null ? POLL_MAX_MS : best - nowMs;
   209	  return Math.min(POLL_MAX_MS, Math.max(POLL_MIN_MS, raw));
   210	}
