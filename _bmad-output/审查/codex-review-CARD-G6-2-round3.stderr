  1852	        result, entry = _rebuild_projection(vault_dir, script)
  1853	        if entry is None:  # debounced / in_progress 分支没读回, 这里补一次
  1854	            entry = _read_entry(vault_dir)
  1855	    except HTTPException as e:
  1856	        if redirect != "page":
  1857	            raise
  1858	        return HTMLResponse(
  1859	            content=_error_page_html(e.status_code, vault_id, e.detail, request.url_for("review_overview_page").path),
  1860	            status_code=e.status_code,
  1861	        )
  1862	    if redirect == "page":
  1863	        # ⛔ **凡是没真重建的分支, 都不许走那条与成功逐字节同形的 303**。
  1864	        # round-3 只为 in_progress 做了这件事, 把 debounced 漏在原地 (收官审计
  1865	        # 抓到, 复核员实测"实况比报告更坏: 连『生成于』时间没走这条线索都不存在"):
  1866	        # 用户刚做完一道题 (写了 fsrs_due) 、10 秒内点刷新 → 拿到与成功一模一样
  1867	        # 的 303 + 相同 Location + 空 body → 页面看着刷新了、数字却没动, 而他
  1868	        # 没有任何办法知道"这次根本没重建"。
  1869	        if not result["rebuilt"]:
  1870	            wait = result.get("retry_after_seconds") or 0
  1871	            title, body = (
  1872	                (f"{vault_id} 正在重建中", "这个库已经有一次刷新在跑了，本次没有重复启动。等几秒回总览页看最新数字。")
  1873	                if result["reason"] == "in_progress"
  1874	                else (
  1875	                    f"{vault_id} 刚刚才刷新过",
  1876	                    f"{_REFRESH_TTL_SECONDS:g} 秒内已经重建过一次，本次**没有**重新计算，"
  1877	                    f"页面上还是上一次的结果。若你刚改过节点，等约 {wait:.0f} 秒后再点一次。",
  1878	                )
  1879	            )
  1880	            return HTMLResponse(
  1881	                content=_notice_page_html(title, body, request.url_for("review_overview_page").path),
  1882	                status_code=200,
  1883	            )
  1884	        # PRG: 303 回 GET, 浏览器刷新不会重复提交 —— 只有**真重建了**才走这里
  1885	        return RedirectResponse(url=request.url_for("review_overview_page").path, status_code=303)
