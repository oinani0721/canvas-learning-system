  1065	def find_generation_claim(text: str) -> str | None:
  1066	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
  1067	
  1068	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
  1069	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
  1070	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
  1071	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
  1072	    """
  1073	    for _, ln in head_window(text):
  1074	        for norm in _guard_variants(ln):
  1075	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
  1076	                m = rx.search(norm)
  1077	                if not m:
