   692	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   693	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   694	            # 的 info string 允许反引号，不受此限。
   695	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   696	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   697	                # ⛔ 第七轮终审 HIGH（R7-H1）：围栏开启行的 **info string**
   698	                # （`~~~ {source=https://…}`）整行被标成 "fence" 后不进正文，
   699	                # 写在那儿的来源静默消失。这是「来源被引擎剥掉」的**第四种写法**
   700	                # （前三种：跨行 HTML 注释 / fm 整行 YAML 注释 / fm 行尾注释）。
   701	                info = ln[m.end() :].strip()
