   966	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   967	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   968	
   969	#: ⛔ 护栏级 AI 信号（结构性，不依赖枚举表）：文本含独立「AI」字样即算嫌疑。
   970	#: 「独立」= 左右都**不是 ASCII 字母**（`\bAI\b` 在 CJK 邻接时无词边界 ——
   971	#: round-7 BLOCKER-1：`由AI系统生成` 曾穿透）。有限标记表无论怎么扩都追不上
   972	#: 自然语言的肯定式声明（round-6 BLOCKER-1：`This report was generated by an
   973	#: AI system` 不含任何表项，双层全盲，无正文时掉进 C3 建议删）。本信号只降
   974	#: C6 不裁决 —— C2 确定命中仍走有限表 + 边界规则（宽匹配会给话题提及发确定
   975	#: 归档，那是硬猜）。
   976	_AI_WORD_RE = re.compile(r"(?<![A-Za-z])AI(?![A-Za-z])", re.IGNORECASE)
   977	
   978	#: ⛔ 护栏级**生成断言结构**（round-8 BLOCKER-2）：`generator: 由 GPT-4 生成`
   979	#: 里既没有表项（表只收到 `由 GPT 生成`，`GPT-4` 差一个版本号）也没有独立词
   980	#: 「AI」，三层护栏全盲 → 无正文时掉进 C3 `建议删 + confident=true`。
   981	#: 修法按**声明骨架**而不是**枚举模型名**（卡文 §3 默认裁决）：模型名是开放
   982	#: 集合，`GPT-4` 之后还有 `GPT-4o`/`Claude 3.5`/`Gemini 2.5`/下个月发布的那个，
   983	#: 枚举永远追不上；「由 <某物> 生成」这个断言骨架是闭合的。
   984	#: ⚠️ 只作**未消化信号降 C6**，绝不进 C2：宽匹配给话题提及发确定归档就是硬猜
   985	#: （`由编译器生成`、`generated by hand` 都会命中本条 —— 它们降 C6，方向安全）。
   986	#: 中文：`由` 与 `生成` 之间任意个**非句读**字符（句读收尾防跨句吞成假断言）。
   987	#: ⛔ round-2 审查 BLOCKER：原先写 `{1,40}?` 加了长度上界，于是
   988	#: `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
   989	#: （中间 65 字符）穿透 —— **上界本身就是缝隙**，而当初说「断言骨架是闭合的」
   990	#: 正因为这个上界而不成立。去掉上界后骨架才真的闭合（同一行、中间不跨句读）。
