   233	def sha(p: pathlib.Path) -> str:
   234	    return hashlib.sha256(p.read_bytes()).hexdigest()
   235	
   236	
   237	def run_suite() -> tuple[int, set[str], str]:
   238	    r = subprocess.run(
   239	        PYTEST,
   240	        cwd=BACKEND,
   241	        capture_output=True,
   242	        text=True,
   243	        env={
   244	            "PATH": "/usr/bin:/bin",
   245	            "PYTHONDONTWRITEBYTECODE": "1",
   246	            "HOME": str(pathlib.Path.home()),
   247	            "LC_ALL": "C.UTF-8",
   248	        },
   249	    )
   250	    out = r.stdout + r.stderr
   251	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   252	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   253	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   254	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   255	    failed = {
   256	        ln.split("::")[1].split(" ")[0].strip()
   257	        for ln in out.splitlines()
   258	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   259	    }
   260	    tail = [
   261	        ln
   262	        for ln in out.splitlines()
   263	        if "passed" in ln or "failed" in ln or "error" in ln
   264	    ]
   265	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   266	
   267	
   268	original = SRC.read_bytes()
   269	base_sha = sha(SRC)
   270	print(f"源码基线 sha256 = {base_sha}\n", flush=True)
   271	
   272	
   273	def _restore_on_signal(signum, _frame):
   274	    """⛔ 真事故（2026-09-02）：本脚本被 2 分钟超时 SIGTERM 杀掉时，`finally`
   275	    **没有执行** —— Python 默认信号处理器直接终止进程，不抛异常，源码被留在
   276	    M-PAIRS 变异态。原地改源码的脚本必须显式注册处理器才谈得上「一定还原」。
   277	    （能安全恢复靠的是上面那行基线 sha 已经打印出来 —— 有它，还原才有可验证
   278	    判据；没有它只能凭记忆猜该改回什么。）"""
   279	    SRC.write_bytes(original)
   280	    print(f"\n⛔ 收到信号 {signum}，已还原源码 sha256={sha(SRC)}", flush=True)
   281	    sys.exit(128 + signum)
   282	
   283	
   284	for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
   285	    signal.signal(_sig, _restore_on_signal)
   286	
   287	results: list[tuple[str, bool]] = []
   288	try:
   289	    for name, expected, layers in MUTATIONS:
   290	        text = original.decode("utf-8")
   291	        for old, new in layers:
   292	            n = text.count(old)
   293	            if n != 1:
   294	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   295	            text = text.replace(old, new)
   296	        SRC.write_text(text, encoding="utf-8")
   297	        if sha(SRC) == base_sha:
   298	            raise SystemExit(f"[{name}] 变异没有真的改到字节")
   299	
   300	        rc, failed, summary = run_suite()
   301	        SRC.write_bytes(original)
   302	        restored = sha(SRC)
   303	
   304	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   305	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   306	        # 「跑完了且有测试失败」的只有 rc=1。
   307	        ok = failed == expected and rc == 1 and restored == base_sha
   308	        results.append((name, ok))
   309	        print(f"{'✅' if ok else '❌'} {name}")
   310	        print(f"   期望红: {sorted(expected)}")
   311	        print(f"   实际红: {sorted(failed)}")
   312	        if failed - expected:
   313	            print(f"   ⚠️ 多红（波及面比预期大）: {sorted(failed - expected)}")
   314	        if expected - failed:
   315	            print(f"   ⛔ 少红（该防线没有门在测）: {sorted(expected - failed)}")
   316	        print(
   317	            f"   rc={rc} | {summary} | 还原 sha "
   318	            f"{'一致' if restored == base_sha else '⛔不一致'}\n"
   319	        )
   320	finally:
   321	    SRC.write_bytes(original)
   322	    final = sha(SRC)
   323	    print(
   324	        f"finally 还原后 sha256 = {final} "
   325	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   326	    )
   327	
   328	allok = (
   329	    all(ok for _, ok in results)
   330	    and sha(SRC) == base_sha
   331	    and len(results) == len(MUTATIONS)
   332	)
   333	print("\n" + "=" * 70)
   334	print(
   335	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   336	    f"（{sum(1 for _, ok in results if ok)}/{len(MUTATIONS)} 变异的实际失败集合等于预先声明集合）"
   337	)
   338	sys.exit(0 if allok else 1)
