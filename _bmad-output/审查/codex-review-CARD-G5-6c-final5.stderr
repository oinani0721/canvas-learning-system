   652	def frontmatter_map(fm_lines: list[str]) -> dict:
   653	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   654	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   655	    `frontmatter_pairs`。"""
   656	    out: dict[str, str] = {}
   657	    for k, v in frontmatter_pairs(fm_lines):
   658	        out.setdefault(k, v)
   659	    return out
