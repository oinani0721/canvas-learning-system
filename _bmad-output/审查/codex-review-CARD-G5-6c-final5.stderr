   257	# ───────────────────── 复用来源装载（fail-closed，不做降级副本） ─────────────────────
   258	
   259	#: 兄弟 skill 的只读 preview 引擎 —— 写侧物理防御与身份键编码的单一真相源。
   260	_SP_PATH = (
   261	    Path(__file__).resolve().parents[2] / "board-split" / "scripts" / "split_preview.py"
   262	)
   263	
   264	
   265	def _load_split_preview():
   266	    """加载复用来源。⛔ 缺失即拒绝运行：本引擎的写侧防御全部来自它，
   267	    退化成「自己简单写一下」等于在安全面上开一个没人审过的旁路。"""
   268	    if not _SP_PATH.is_file():
   269	        raise SystemExit(
   270	            "✗ 复用来源缺失，拒绝以未加固的写侧运行。需要文件: "
   271	            f"{_SP_PATH}\n"
   272	            "  （本引擎的 out-dir symlink 守卫 / O_NOFOLLOW 准入 / 双产物原子发布"
   273	            " 全部复用该模块，不做本地降级副本。）"
   274	        )
   275	    spec = importlib.util.spec_from_file_location("_g56_split_preview", _SP_PATH)
   276	    mod = importlib.util.module_from_spec(spec)
   277	    # ⛔ 零写侧的第一现场（Codex 审查实证抓出）：`exec_module` 默认会在被导入模块
   278	    # 旁边写 `__pycache__/*.pyc` —— 那是往 **vault 里**、而且是**另一条车道的
   279	    # board-split 目录里**落文件。零写侧不是"不改用户的 md"，是"除 out-dir 外
   280	    # 一个字节都不落"。原先的零写快照抓不到它: fixture 树里根本没有真实 skills 目录，
   400	    ),
   401	}
   402	
   403	UNDECIDED_ASK = "这份要归入哪块白板、还是新建节点、还是归档（二手综合 / 一手快照）？"
   404	
   405	NOT_EXECUTED = (
   406	    "本 preview 只读生成：未移动、未删除、未修改任何 vault 或收件箱既有文件"
   407	    "（唯一写入 = out-dir 下两份 preview 产物，缺省落 <vault>/outputs/）；"
   408	    "逐条拍板与执行属 CARD-G5-7，本引擎不提供任何写侧动作。"
   409	)
   410	
   411	LAST_CLEANUP_NOTE = (
   412	    "只读 preview 不持有清仓台账（R8 Step 0 的「上次清仓 N 天前」需执行侧记录，"
   413	    "属 CARD-G5-7）。此处如实留空，不推测、不伪造。"
   414	)
   415	
   416	#: 标签（= 收件箱目录 basename，进产物文件名）的非法字符类。
   417	#: ⛔ 与 split_preview._BAD_NAME **逐字同源**：该常量为私有，故此处平行定义，
   418	#: 由裁判 `test_reuses_split_preview_helpers_by_import` 断言两者 pattern 逐字相等，
   419	#: 防「两套判据各自漂移」。
   420	_BAD_LABEL = re.compile(r'[\\/`$"\']|\.\.|^\.|[\x00-\x1f]')
   421	
   422	#: 人话时区：**固定 +08:00**，刻意不走 `ZoneInfo("Asia/Shanghai")`。
   423	#: ⛔ 理由是本卡有「二跑逐字节相等」硬门，而该门必须**跨宿主**成立：ZoneInfo 在装了
   424	#: tzdata 的机器上会给 1986-1991 年的日期套上夏令时（实测 1988-07-01 → +09:00），
   425	#: 没装 tzdata 的机器退化成 +08:00 —— 同一份输入在两台机器产出不同字节。
   426	#: 代价是那六年的历史时刻不带夏令时；收件箱材料不可能有 1980 年代的 mtime，
   427	#: 拿一个不可能发生的历史精度去换一个每次都要成立的确定性，是划算的。
   428	#: （与 `scripts/daily_review_pick.py` 优先 ZoneInfo 的口径有意分歧，理由如上。）
   429	_TZ_SHANGHAI = timezone(timedelta(hours=8))
   430	
   431	#: ATX 标题：**最多 3 个字面空格**缩进（⛔ 与 _FENCE_RE 同口径，\s 会放行
   432	#: 制表符/NBSP —— `\t# keep` 是缩进代码、`\xa0# keep` 是普通正文，都曾被当
   433	#: 标题剥掉 → 空骨架建议删，round-7 BLOCKER-2）。
   434	#: ⛔ **井号后的分隔同样只认 ASCII 空格/制表符**（CommonMark §4.2：开头的 `#`
   435	#: 序列后必须跟空格、制表符或行尾）：round-8 BLOCKER-1 实证前置缩进收窄后
   436	#: 后边界仍写着 `(?:\s|$)`，而 Python `re` 的 `\s` 在 str 模式下是 Unicode
   437	#: 语义 —— `#\xa0keep`（字节 23c2a06b6565700a）被当成标题剥掉 → 「标题 1 行、
   438	#: 实质正文 0 字符」→ `建议删 + confident=true`。同一条规则的两半只修一半，
   439	#: 等于没修。⚠️ 边界如实声明：本条只管**标题判定**；`#` 孤行（`# ` / `#\xa0`
   440	#: 这类井号后无实质内容者）经 `_ONLY_STRUCT_RE` 归入「纯结构行」，与普通空格
   441	#: 版本同桶 —— 那是既有的结构行口径，不是本条收窄出来的新差异。
   442	_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:[ \t]|$)")
   443	_LIST_PREFIX_RE = re.compile(r"^\s*(?:[-*+]\s+|\d{1,3}[.)]\s+|>\s?)+")
   444	#: 纯结构行（分隔线 / 表格分隔 / 空列表符）。⛔ 不含 `~`：`~~~` 是代码围栏标记，
   445	#: 由 `_classify_lines` 的状态机处理；把它当"结构"曾让整段围栏代码凭空消失。
   446	#: ⛔ 第七轮终审 HIGH（R7-H2）：原表含 `=`/`|`/`:`，于是 `:=`、`=>`、`||` 这类
   447	#: **有语义的运算符**被当纯结构忽略，3 字节文件被判空骨架确定删除。
   448	#: 收窄口径：一行只有在**全部由同一种结构字符（加空白）构成**时才算结构行 ——
   449	#: `---`/`***`/`|||`/`>>>` 是结构，`:=`/`=>`/`||=` 是内容。
   450	#: ⛔ 第八轮 HIGH：上一版把线画在「同字符重复」上，于是 `||`（逻辑或）被判结构
   451	#: 而删除。真正的分界是**这行是不是 Markdown 的结构记号**：分隔线要 ≥3 个
   452	#: （CommonMark `---`/`***`/`___`），表格分隔要含 `-`，引用/标题记号是 `>`/`#`。
   453	#: `||` 两个竖线既不是分隔线也不是表格分隔，它就是正文。
   454	_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
   455	_STRUCT_CHARS = "-=*_|:#>"
   456	
   457	
   458	def _is_structural_line(t: str) -> bool:
   459	    """纯结构行判定（分隔线 / 表格分隔 / 空列表符）。"""
   460	    if not _ONLY_STRUCT_RE.match(t):
   461	        return False
   462	    kinds = {c for c in t if c in _STRUCT_CHARS}
   463	    if len(kinds) > 1:
   464	        return False
   465	    core = t.strip()
   466	    if not core:
   467	        return True
   468	    ch = core[0]
   469	    # 分隔线（CommonMark 要求 ≥3 个）/ 引用与标题记号 / 表格分隔（含 `-`）
   470	    if ch in "-=*_" and len(core) >= 3:
   471	        return True
   472	    return ch in ">#:|" and set(core) <= {ch} and len(core) >= 3
   473	
   474	
   475	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   476	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   477	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   478	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   479	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   480	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   481	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   482	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   483	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   484	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   485	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   486	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   487	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   488	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   489	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   490	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   491	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   492	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   493	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   494	#: 里仍保留作防御深度。
   495	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
   496	
   497	
   498	def _is_primary_source_url(src: str) -> bool:
   499	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   500	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   501	    if not _URL_RE.match(src):
   502	        return False
   503	    try:
   504	        parts = urlsplit(src)
   505	    except ValueError:
   506	        return False
   507	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   508	
   509	
   510	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
   511	
   512	
   513	# ───────────────────────────── 身份键 ─────────────────────────────
   514	
   515	
   516	def compute_inbox_stable_id(rel_path: str) -> str:
   517	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   518	
   519	    编码纪律复用 `split_preview.compute_stable_id`（长度前缀载荷，对任意字节单射），
   520	    命名空间经 heading-path 槽位注入，返回值改挂自有前缀 —— 见文件头「身份空间
   521	    不可互换」。**不**把 mtime/size/内容进键：那样一改正文就换身份，diff 无意义。
   522	    """
   523	    raw = _SP.compute_stable_id(rel_path, [INBOX_ID_NAMESPACE], 1, INBOX_ID_BASIS)
   524	    return INBOX_ID_PREFIX + raw[len(_SP.STABLE_ID_PREFIX) :]
   525	
   526	
   527	# ───────────────────────────── 时间 ─────────────────────────────
   528	
   529	
   530	def parse_now(raw: str) -> datetime:
   531	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   532	    try:
   533	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   534	    except ValueError as e:
   535	        raise SystemExit(
   536	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   537	        ) from e
   538	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   539	
   540	
   541	def _epoch_s(dt: datetime) -> float:
   542	    return dt.timestamp()
   543	
   544	
   545	def days_between(now_s: float, then_s: float) -> int:
   546	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   547	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   548	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   549	    return int(round(now_s - then_s)) // 86400
   550	
   551	
   552	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   553	UNREPRESENTABLE = "unrepresentable"
   554	
   555	
   556	def _fmt(sec: float, tz, pattern: str) -> str:
   557	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   558	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   559	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   560	    **不**伪造一个看似正常的时间。"""
   561	    try:
   562	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   563	    except (OverflowError, OSError, ValueError):
   564	        return UNREPRESENTABLE
   565	
   566	
   567	def fmt_utc(sec: float) -> str:
   568	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   569	
   570	
   571	def fmt_local(sec: float) -> str:
   572	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
   573	
   574	
   575	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   576	
   577	
   578	def frontmatter_span(lines: list[str]) -> int:
   579	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   580	
   581	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   582	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   583	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   584	    行号是给人核对用的，偏了就等于没有。
   585	    """
   586	    if not lines or lines[0].strip() != "---":
   587	        return 0
   588	    end = None
   589	    for i in range(1, len(lines)):
   590	        if lines[i].strip() in ("---", "..."):
   591	            end = i
   592	            break
   593	    if end is None:
   594	        return 0  # 缺闭合 → 视为无 frontmatter
   595	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   596	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   597	    # 空文件的删除提名，比不提名坏得多。
   598	    for ln in lines[1:end]:
   599	        t = ln.strip()
   600	        if not t or t.startswith("#"):
   601	            continue  # 空行与 YAML 注释不作数
   602	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   603	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   604	
   605	
   606	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   607	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   608	    lines = text.splitlines()
   609	    n = frontmatter_span(lines)
   610	    return (lines[1 : n - 1] if n else []), lines[n:]
   611	
   612	
   613	def _clean_fm_value(raw: str) -> str:
   614	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   615	
   616	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   617	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   618	    （round-3 自审 H1-6）。
   619	    """
   620	    val = (raw or "").strip()
   621	    val = re.sub(r"\s+#.*$", "", val).strip()
   622	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   623	        val = val[1:-1]
   624	    return val
   625	
   626	
   627	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   628	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   629	
   630	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   631	    于是
   632	
   633	        ---
   634	        doi:
   635	        doi: 10.1000/hidden
   636	        ---
   637	
   638	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   639	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   640	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   641	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   642	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
