  2533	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  2534	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  2535	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  2536	
  2537	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  2538	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  2539	    """
  2540	    mod = load_module()
  2541	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  2542	    samples = [
  2543	        "\u200b",
  2544	        "\u200c",
  2545	        "\u200d",
  2546	        "\u2060",
  2547	        "\ufeff",
  2548	        "\u00ad",  # 原表六个
  2549	        "\u2063",
  2550	        "\u200e",
  2551	        "\u200f",
  2552	        "\u061c",
  2553	        "\u034f",  # round-3 新抓
  2554	        "\ufe0f",
  2555	        "\u2062",
  2556	        "\u180e",
  2557	        "\u202e",  # round-3 新抓
  2558	    ]
  2559	    for ch in samples:
  2560	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  2561	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  2562	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  2563	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  2564	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  2565	
  2566	    # 端到端半边: 用 round-3 审查的原始反例形态
  2567	    vault, out = base_vault(tmp_path)
  2568	    inbox = vault / "_待处理"
  2569	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2570	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2571	    # ⛔ 端到端半边走 **frontmatter**：标题侧在用户裁决后已由「标题里写了字算
  2572	    # 实质正文」直接保护，隐形字符再怎么插也走不到护栏 —— 拿它当端到端样本，
  2573	    # 本门就测不到 `_strip_invisible` 那一层（纯函数半边仍直锁该函数）。
  2574	    mk(inbox / "u2063英文声明.md", "---\nnote: Genera\u2063ted by GPT-4\n---\n", age_days=7)
  2575	    mk(inbox / "u2063中文声明.md", "---\nnote: 本文由 GPT-4 生\u2063成\n---\n", age_days=6)
  2576	    mk(
  2577	        inbox / "u2063重复件.md",
  2578	        "---\nnote: Genera\u2063ted by GPT-4\n---\n" + body,
  2579	        age_days=5,
  2580	    )
  2581	    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)
  2582	
  2583	    assert run_cli(vault, out).returncode == 0
  2584	    data = load_json(out)
  2585	    for name in ("u2063英文声明.md", "u2063中文声明.md", "u2063重复件.md"):
  2586	        it = item_by_name(data, name)
  2587	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2588	        assert it["criterion"] == "C6_undecided", name
  2589	        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2590	    ctrl = item_by_name(data, "无注释骨架.md")
  2591	    assert ctrl["criterion"] == "C3_empty_or_skeleton"
  2592	    assert ctrl["verdict"] == "建议删"
