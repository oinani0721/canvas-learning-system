   766	def dup_body(text: str) -> str:
   767	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   768	
   769	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   770	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   771	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   772	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   773	    有后果的提名，依据必须逐字。
   774	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   775	    """
   776	    parts: list[str] = []
   777	    for ln, is_code in _classify_lines(text):
   778	        if not is_code and _HEADING_RE.match(ln):
   779	            continue
   780	        t = ln.rstrip()
   781	        if not t:
   782	            continue
   783	        parts.append(nfc(t))
   784	    return "\n".join(parts)
