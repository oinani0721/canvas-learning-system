   707	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   708	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   709	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   710	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   711	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   712	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   713	            # 在 CommonMark 里是围栏内容）。
   714	            if (
   715	                tok[0] == fence_char
   716	                and len(tok) >= fence_len
   717	                and all(c in " \t" for c in ln[m.end() :])
   718	            ):
   719	                in_fence, fence_char, fence_len = False, "", 0
   720	                rows.append((ln, "fence"))
   721	                continue
   722	        if in_fence:
   723	            rows.append((ln, "code"))
   724	            continue
   725	        kept, rem = "", ln
   726	        while rem:
   727	            if in_comment:
   728	                i = rem.find("-->")
   729	                if i < 0:
   730	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   731	                    # （只收了闭合那一行的 `rem[:i]`），于是
   732	                    #   <!--
   733	                    #   source: https://…
   734	                    #   -->
   735	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   736	                    stripped_comments.append(rem)
   737	                    break
   738	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   739	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   740	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   741	                stripped_comments.append(rem[:i])
   742	                rem, in_comment = rem[i + 3 :], False
   743	            else:
   744	                i = rem.find("<!--")
   745	                if i < 0:
   746	                    kept += rem
   747	                    break
   748	                kept += rem[:i]
