  2700	def test_information_in_key_name_blocks_deletion(tmp_path):
  2701	    """⛔ 第八轮 HIGH：信号⑨ 只看**值**，把信息写进**键名**就整条穿透。
  2702	
  2703	    `ISBN_978-7-111-54742-6:`（值为空）是唯一的出处标识，却因为「值为空」不触发
  2704	    兜底，被判空骨架确定删除。⚠️ 信息在键名还是在值里，对「引擎没消费它」这件事
  2705	    毫无区别 —— 这是本卡第 N 次同型：**我按自己消费数据的方式定义了「有信息」，
  2706	    而不是按用户写下东西的方式。**
  2707	    """
  2708	    vault, out = base_vault(tmp_path)
  2709	    inbox = vault / "_待处理"
  2710	    mk(inbox / "ISBN键名.md", "---\nISBN_978-7-111-54742-6:\n---\n", age_days=7)
  2711	    mk(inbox / "馆藏键名.md", "---\nTP311-13-K92-3:\n---\n", age_days=6)
  2712	    # ⛔ 正向对照：引擎**已知**的键即使空值也不触发（否则 C3 会被空 title 废掉）
  2713	    mk(inbox / "空值已知键.md", "---\ntitle:\ntags:\n---\n\n# \n", age_days=5)
  2714	    mk(inbox / "零字节.md", "", age_days=4)
  2715	
  2716	    assert run_cli(vault, out).returncode == 0
  2717	    data = load_json(out)
  2718	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2719	    for name, frag in (("ISBN键名.md", "ISBN_978"), ("馆藏键名.md", "TP311")):
  2720	        it = item_by_name(data, name)
  2721	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2722	        assert it["criterion"] == "C6_undecided", name
  2723	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2724	    for name in ("空值已知键.md", "零字节.md"):
  2725	        ctrl = item_by_name(data, name)
  2726	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2727	        assert ctrl["verdict"] == "建议删", name
