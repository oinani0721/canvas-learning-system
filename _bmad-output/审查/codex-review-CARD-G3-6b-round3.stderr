import hashlib
import importlib.util
import os
import py_compile
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from types import SimpleNamespace

ROOT = Path.cwd()
source_path = ROOT / 'scripts' / 'daily_review_pick.py'
base = source_path.read_text(encoding='utf-8')
a = '\"board_last_recommended\": board_last_recommended.get(board, \"\"),  # 空串 = 从未被推荐, 排最前'
b = '\"min_last_examined\": min(n[\"last_examined\"] for n in due),        # 空串 = 有从未考节点, 排最前'
assert a in base and b in base
marker = '__G36B_SWAP_MARKER__'
mut = base.replace(a, marker).replace(b, a).replace(marker, b)
assert len(mut.encode()) == len(base.encode())

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

def exercise(mod):
    now = datetime(2026, 9, 1, tzinfo=timezone.utc)
    common = {
        'node': 'n', 'due_now': True, 'fsrs_due': '', 'due_fail_open': False,
        'idle_days': 31, 'difficulty': 0.5, 'pick': 0.25,
    }
    nodes = [
        dict(common, node='A', board='A板', last_examined='2026-07-01T00:00:00Z'),
        dict(common, node='B', board='B板', last_examined='2026-08-30T00:00:00Z'),
    ]
    blr = {'A板': '2026-08-30', 'B板': '2026-07-01'}
    decay = SimpleNamespace(BETA_EXPLORE=1.0, FLOOR=0.05, GAMMA=0.9,
                            GAMMA_DAILY=0.99, PRIOR_A=0.9, PRIOR_B=2.1)
    order = [r['board'] for r in mod.rank_boards(nodes, blr, now)[0]]
    sha = mod.build_rank_manifest(decay, 1, dict(mod.DEFAULT_MINUTES), {})['sha256']
    return order, sha, mod._implementation_sha()

with tempfile.TemporaryDirectory(prefix='g36b-fingerprint-') as td:
    td = Path(td)
    p0, p1 = td / 'pick_base.py', td / 'pick_swapped.py'
    p0.write_text(base, encoding='utf-8')
    p1.write_text(mut, encoding='utf-8')
    baseline = exercise(load(p0, 'pick_base'))
    static_mut = exercise(load(p1, 'pick_swapped'))

    # Real import-cache attack: compile swapped code, then restore baseline source
    # with the same timestamp+size. Timestamp pyc remains valid and is executed,
    # while _implementation_sha() reads the restored baseline .py bytes.
    pa = td / 'pick_cached.py'
    pa.write_text(mut, encoding='utf-8')
    st = pa.stat()
    pyc = Path(importlib.util.cache_from_source(str(pa)))
    py_compile.compile(str(pa), cfile=str(pyc), doraise=True,
                       invalidation_mode=py_compile.PycInvalidationMode.TIMESTAMP)
    pa.write_text(base, encoding='utf-8')
    os.utime(pa, ns=(st.st_atime_ns, st.st_mtime_ns))
    cached_mut = exercise(load(pa, 'pick_cached'))

    print('static_binding_swap', {
        'order_before': baseline[0], 'order_after': static_mut[0],
        'rank_sha_changed': baseline[1] "'!= static_mut[1],
        '"'implementation_sha_changed': baseline[2] "'!= static_mut[2],
    })
    print('"'stale_pyc_boundary', {
        'source_bytes_equal_baseline': pa.read_bytes() == p0.read_bytes(),
        'order_baseline': baseline[0], 'order_executed_from_cache': cached_mut[0],
        'rank_sha_equal': baseline[1] == cached_mut[1],
        'implementation_sha_equal': baseline[2] == cached_mut[2],
        'pyc_exists': pyc.exists(),
    })
