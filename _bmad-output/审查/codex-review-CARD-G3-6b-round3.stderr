   555	    version 字段双双可用时为整数, 其余一律 None ("没有版本"而非假装有)。
   556	    """
   557	    path = Path(path) if path is not None else Path(__file__).resolve().parent / MANIFEST_FILENAME
   558	    minutes = dict(DEFAULT_MINUTES)
   559	    try:
