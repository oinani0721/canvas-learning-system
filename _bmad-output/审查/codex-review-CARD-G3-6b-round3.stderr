  1692	def test_g36b_tie_keys_are_single_source(tmp_path, monkeypatch):
  1693	    """Codex round-1 HIGH 整改门: TIE_FACTOR_KEYS 同时驱动实际排序与 sha 指纹
  1694	    —— 交换/删除因子, 板序与指纹必须**同变**。
  1695	
  1696	    Codex 的攻击场景: 因子序存在两份独立表达时, 内存里改 _tie 而 sha 纹丝
  1697	    不动, 版本化成摆设。本门在性质层面锁定单源: 任何让排序变化的常量改动
  1698	    都必然改变 sha, 反之亦然。
  1699	
  1700	    fixture 设计 (与 pick 级的数学耦合): pick 平要求 top 同参同 idle ⟹ top 的
  1701	    last 相同 ⟹ min_last 级在此 fixture 恒平 (两板各单节点, min_last 皆同);
  1702	    blr 与 board 的优劣刻意相反 (A 有记录罚后但字典序在前), 交换后才翻转。"""
  1703	    vault = _mk_min_vault(
  1704	        tmp_path,
  1705	        "tie_src",
  1706	        {
  1707	            # 两板 top 同参同 idle (a=2,b=3, last=07-25) → priority_pick 平;
  1708	            # A 板有 blr 记录 (罚后), B 从未 → 默认 [1] B 先;
  1709	            # board 字典序 A < B → 交换 blr/board 位置后 A 先 (优劣相反)
  1710	            "A1": _node(board="A板", extra="mastery_a: 2.0\nmastery_b: 3.0\nlast_examined: 2026-07-25T01:00:00Z\n"),
  1711	            "B1": _node(board="B板", extra="mastery_a: 2.0\nmastery_b: 3.0\nlast_examined: 2026-07-25T01:00:00Z\n"),
  1712	        },
  1713	    )
  1714	    blr = {"A板": "2026-07-28"}
  1715	    decay = picker.load_decay(vault)
  1716	    nodes = picker.scan_nodes(vault, NOW, decay)[0]
  1717	
  1718	    order_default = [r["board"] for r in picker.rank_boards(nodes, blr, NOW)[0]]
  1719	    assert order_default == ["B板", "A板"], "默认序: blr 级先决 (B 从未被推荐)"
  1720	
  1721	    _, minutes, _ = picker.load_rank_manifest(_REAL_MANIFEST)
  1722	    sha_before = picker.build_rank_manifest(decay, 1, minutes, {})["sha256"]
  1723	
  1724	    keys = picker.TIE_FACTOR_KEYS
  1725	    # 交换位置 1 (blr) 与 3 (board): pick/min_last 平局下, board 级提前
  1726	    # 先决 → A板(字典序在前)翻到第一 —— 板序变; sha 同变
  1727	    swapped = (keys[0], keys[3], keys[2], keys[1])
  1728	    monkeypatch.setattr(picker, "TIE_FACTOR_KEYS", swapped)
  1729	    order_swapped = [r["board"] for r in picker.rank_boards(nodes, blr, NOW)[0]]
  1730	    assert order_swapped == ["A板", "B板"], "交换因子位置后板序必须随之变化 (单一真相源)"
  1731	    sha_after = picker.build_rank_manifest(decay, 1, minutes, {})["sha256"]
  1732	    assert sha_after != sha_before, "交换因子位置后 sha 必须同变"
