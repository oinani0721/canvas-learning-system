   427	        return BUCKET_DUE_TODAY, f"今天 {due_sh:%H:%M} 到期（尚未到点）"
   428	    when = "明天" if delta == 1 else f"{delta} 天后"
   429	    return BUCKET_FUTURE, f"{when} {due_sh.month}月{due_sh.day}日 {due_sh:%H:%M} 到期"
   430	
   431	
   432	def scan_nodes(vault: Path, now: datetime, decay):
   433	    """扫描 节点/ 池 → (nodes, stats, ineligible, placeholder_boards)。
   434	    逐节点容错: 单个脏节点不崩全轮。
   435	
   436	    ineligible 分桶 (schema v3, CARD-A2): 被跳过的节点按原因点名, 不再只有
   437	    计数 — Dashboard 消费 placeholder 桶显示"待剖析积压"。
   438	    placeholder_boards (CARD-D1 P1): {板名: 占位符数} 板级归属, 供 boards
   439	    rollup; 无 source_board 的占位符不入 (只在扁平列表)。
   440	    """
   441	    stats = {"new": 0, "legacy": 0, "none": 0, "ineligible": 0, "test_excluded": 0, "corrupt": 0}
   442	    ineligible = {"placeholder": [], "test_excluded": [], "corrupt": []}
   443	    placeholder_boards: dict[str, int] = {}  # CARD-D1 P1: 占位符板级归属
   444	    now_z = now.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   445	    nodes = []
   446	    for path in sorted((vault / "节点").glob("*.md")):
   447	        stem = path.stem
   448	        try:
   449	            text = path.read_text(encoding="utf-8")
   450	        except OSError as e:
   451	            stats["corrupt"] += 1
   452	            ineligible["corrupt"].append(stem)
   453	            print(f"[pick] 读取失败跳过 {stem}: {e}", file=sys.stderr)
   454	            continue
   455	        if any(mk in stem for mk in TEST_MARKERS):
   456	            stats["test_excluded"] += 1
   457	            ineligible["test_excluded"].append(stem)
   458	            continue
   459	        m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---\r?\n?(.*)$", text, re.S)
   460	        fm, body = (m.group(1), m.group(2)) if m else ("", text)
   461	        if PLACEHOLDER in body:
   462	            stats["ineligible"] += 1
   463	            ineligible["placeholder"].append(stem)
   464	            # CARD-D1 P1: 占位符按 source_board 归板 (fm 已解析零额外 IO);
   465	            # 无 source_board 的占位符只留扁平列表, 不虚构归属
   466	            ph_board = _board_name(_fm_str(fm, "source_board"))
   467	            if ph_board:
   468	                placeholder_boards[ph_board] = placeholder_boards.get(ph_board, 0) + 1
   469	            continue
   470	
   471	        a_raw, b_raw = _fm_num(fm, "mastery_a"), _fm_num(fm, "mastery_b")
   472	        legacy = next(
   473	            (v for k in ("mastery_score", "mastery", "mastery_level")
   474	             if (v := _fm_num(fm, k)) is not None),
   475	            None,
   476	        )
   477	        if a_raw is not None and b_raw is not None:
   478	            a, b, state = a_raw, b_raw, "new"
   479	        elif legacy is not None:
   480	            a, b = decay.from_legacy(legacy)
   481	            state = "legacy"
   482	        else:
   483	            a, b, state = decay.PRIOR_A, decay.PRIOR_B, "none"
   484	        stats[state] += 1
   485	
  1058	        os.replace(tmp, path)
  1059	    except BaseException:
  1060	        try:
  1061	            tmp.unlink()
  1062	        except OSError:
  1063	            pass
  1064	        raise
