   816	
   817	def _title(board: str) -> str:
   818	    prefix = "📚 今日复习 · "
   819	    room = TITLE_LIMIT - len(prefix)
   820	    return prefix + (board if len(board) <= room else board[: room - 1] + "…")
   821	
   822	
   823	def _body(top: dict) -> str:
   824	    idle = "从未考察" if top["idle_days"] is None else f"已闲置 {top['idle_days']} 天"
   825	    if top["pending"] >= 2:
   826	        return f"{top['top_node']} 等 {top['pending']} 节点待巩固 · {idle}"
   827	    return f"{top['top_node']} 待巩固 · {idle}"
