   561	    except (OSError, ValueError) as e:  # ValueError ⊃ JSONDecodeError
   562	        print(f"[pick] 系数清单不可用, 用内置默认: {path} ({type(e).__name__})", file=sys.stderr)
   563	        return None, minutes, {}
   564	    if not isinstance(raw, dict):
   565	        print(f"[pick] 系数清单不是 object, 用内置默认: {path}", file=sys.stderr)
   566	        return None, minutes, {}
   567	
   568	    version = raw.get("version")
   569	    if not isinstance(version, int) or isinstance(version, bool):
   570	        print(f"[pick] 系数清单 version 非整数, 记为 None: {version!r}", file=sys.stderr)
   571	        version = None
