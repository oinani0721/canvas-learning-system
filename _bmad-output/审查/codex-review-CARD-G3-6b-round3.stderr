   758	
   759	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   760	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   761	
   762	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   763	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   764	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   765	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   766	    """
   767	    minutes = minutes or DEFAULT_MINUTES
   768	    today_sh = _today_sh(now)
   769	    boards: dict[str, list] = {}
   770	    unassigned = []
   771	    for n in nodes:
   772	        if not n["board"]:
   773	            unassigned.append(n["node"])
   774	            continue
   775	        boards.setdefault(n["board"], []).append(n)
   776	
   777	    ranked, upcoming = [], []
   778	    for board, members in boards.items():
   779	        due = [n for n in members if n["due_now"]]
   780	        if not due:
   781	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   782	            nxt = min(members, key=lambda n: n["fsrs_due"])
   783	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   784	            continue
   785	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   786	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   787	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   788	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   789	        tie_parts = {
   790	            "priority_pick": round(top["pick"], TIE_PICK_ROUND_DIGITS),
   791	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   792	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   793	            "board": board,
   794	        }
   795	        ranked.append({
   796	            "board": board,
   797	            "top_node": top["node"],
   798	            "priority": round(top["pick"], 4),
   799	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   800	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   801	            "difficulty": top["difficulty"],
   802	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   803	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   804	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   805	            "why_this_board": why_this_board(factors),
   806	            "estimated_minutes": estimated_minutes(factors, minutes),
   807	            "factors": factors,
   808	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   809	        })
