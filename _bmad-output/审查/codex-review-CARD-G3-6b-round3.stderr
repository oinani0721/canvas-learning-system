   672	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   673	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   674	
   675	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   676	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   677	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   678	    """
   679	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   680	    overdue_days = None
   681	    if scheduled:
   682	        earliest_sh = _sh_local(min(scheduled))
   683	        if earliest_sh is not None:
   684	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   685	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   686	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   687	
   688	    rec = board_last_recommended.get(board, "")
   689	    gap = None
   690	    if rec:
   740	        # 不 clamp 成 0 伪装成"今天刚推荐过" (Codex round-1 MEDIUM)
   741	        parts.append("上次推荐日期晚于今天")
   742	    elif f["recommend_gap_days"] == 0:
   743	        parts.append("今天已推荐过")
   744	    else:
   745	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   746	    return " · ".join(parts)
   747	
   748	
   749	def estimated_minutes(f: dict, minutes: dict) -> int:
   750	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   751	
   752	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   753	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   754	    """
   755	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   756	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
