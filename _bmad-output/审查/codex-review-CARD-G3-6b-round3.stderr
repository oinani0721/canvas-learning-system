   585	                  "分钟用内置默认", file=sys.stderr)
   586	            cfg = {}
   587	    if isinstance(cfg, dict):
   588	        for k in DEFAULT_MINUTES:
   589	            v = cfg.get(k)
   590	            if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
   591	                minutes[k] = v
   592	            else:
   593	                # 缺键与非法值同等待遇: 点名后再回落 (Codex round-1 MEDIUM —
   594	                # 只验"在场但坏", 会放过"压根没写"的半份配置, 让静默回落
   595	                # 伪装成用户确实配了)
   596	                print(f"[pick] estimated_minutes.{k} 缺失或非法({v!r}), 用内置默认 {minutes[k]}",
   597	                      file=sys.stderr)
