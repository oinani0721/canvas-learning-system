+DEFAULT_MINUTES = {"per_due_node": 3, "per_new_node": 5}
+
+#: S5 入指纹的 decay_beta 六常量名 (排序固定 → 指纹稳定)
+DECAY_CONSTANT_NAMES = ("BETA_EXPLORE", "FLOOR", "GAMMA", "GAMMA_DAILY", "PRIOR_A", "PRIOR_B")
+
 
