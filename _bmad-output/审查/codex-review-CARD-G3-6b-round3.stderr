   830	def build_payload(vault: Path, now: datetime, board_last_recommended: dict, decay,
   831	                  manifest_path=None):
   832	    """CARD-G3-6b: 新增可选 manifest_path (缺省 = 本脚本同目录的系数清单)。
   833	
   834	    runner 侧调用形态不变 (daily_review_run:159-160 传四个位置参数) —— 新
   835	    参数是加性关键字, 消费面零变化。
  1080	    args = ap.parse_args()
  1081	
  1082	    vault = Path(args.vault)
  1083	    # 裸时间当本地时区, 与 daily_review_run.py 语义统一 (Code-Review L6)
  1084	    if args.now:
  1085	        dt = datetime.fromisoformat(args.now.replace("Z", "+00:00"))
  1086	        now = dt if dt.tzinfo else dt.astimezone()
  1087	        # Codex-G3-6a round-1 HIGH: 日历极值时刻 (如 9999-12-31T23:59:59Z)
  1088	        # 在本地/上海时区换算时 OverflowError —— HEAD 起就会在
  1089	        # payload["date"] 处抛 traceback 中断整轮, 本卡把桶位判定挪到更前
  1090	        # 只是让崩点提前。与其抛 traceback, 在入口一次性拒绝并说清原因
  1091	        # (不改任何冻结字段的计算)。
  1092	        try:
  1093	            now.astimezone()
  1094	            now.astimezone(_TZ_SHANGHAI)
  1095	        except (OverflowError, OSError):
  1096	            ap.error(f"--now 超出可换算范围 (本地/上海时区换算溢出): {args.now}")
  1097	    else:
  1098	        now = datetime.now(timezone.utc)
  1099	    blr = {}
  1100	    if args.state and Path(args.state).exists():
  1101	        try:
  1102	            blr = json.loads(Path(args.state).read_text(encoding="utf-8")).get(
  1103	                "board_last_recommended", {})
  1104	        except (json.JSONDecodeError, OSError):
  1105	            pass  # state 损坏由 runner 处置, 选点侧降级为无记录
  1106	
  1107	    payload, ranked = build_payload(vault, now, blr, load_decay(vault))
  1108	    if args.write:
  1109	        out = vault / "outputs"
  1110	        out.mkdir(parents=True, exist_ok=True)
  1111	        # CARD-G6-1: 两份内容先全部渲染好, 再连着发布两次 —— md 与 json 是
  1112	        # 一对, 两个写者并发时可能各中一半 (md 来自 B、json 来自 A, Codex
  1113	        # 探针 PAIR_FINAL 实测成立)。把渲染/序列化挪到两次 rename 之前,
  1114	        # 窗口从"一次 json.dumps 的时长"收窄到"一次文件 I/O 的时长"。
  1115	        # ⚠ 只是收窄不是消除: 真正的配对原子性要目录级换名或跨进程锁,
  1116	        # VirtioFS 上锁行为不可证, 本卡不假装做到 (如实登记)。
  1117	        md_text = render_md(payload, ranked)
  1118	        json_text = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
  1119	        atomic_write(out / "今日复习.md", md_text)
  1120	        atomic_write(out / "今日复习.json", json_text)
  1121	    print(json.dumps(payload, ensure_ascii=False))
  1122	
