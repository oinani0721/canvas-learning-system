   613	def _warn_recorded_drift(recorded: dict, effective: dict):
   614	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   615	
   616	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   617	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   618	    """
   619	    for label, claimed, actual in (
   620	        ("ranking_factors.order",
   621	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   622	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   623	        ("decay_beta_constants",
   624	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   625	    ):
   626	        if claimed is not None and claimed != actual:
   627	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   628	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
   629	
   630	
   631	def _implementation_sha(path=None) -> str:
   632	    """S5 本生成器源码的实现指纹 (Codex round-2 HIGH)。
   633	
   634	    因子清单/精度常量只能覆盖「登记过的配置面」, 覆不完取值绑定这类字面
   635	    代码 —— 把 pick.py 自身字节也摘进指纹, 任何排序规则改动 (精度/绑定/
   636	    方向/新因子) 必然变 sha。粒度因此从「系数」变粗为「实现+系数」: 改
   637	    注释也会变指纹, 属预期内的保守取舍 (宁可指纹变多, 不可规则变更漏网)。
   638	    """
   639	    p = Path(path) if path is not None else Path(__file__).resolve()
   640	    return hashlib.sha256(p.read_bytes()).hexdigest()
   641	
   642	
   643	def effective_rank_config(decay, version, minutes: dict) -> dict:
   644	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   645	
   646	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   647	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   648	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   649	    该变), 上限与因子序/取整精度取代码常量, 分钟取 manifest 生效值,
   650	    implementation_sha256 摘本文件字节 (round-2 HIGH: 取值绑定无法全部
   651	    数据化, 实现指纹兜住「改代码规则而指纹不动」的整类攻击)。
   652	    """
   653	    return {
   654	        "version": version,
   655	        "ranking_factors": list(TIE_FACTOR_KEYS),
   656	        "tie_pick_round_digits": int(TIE_PICK_ROUND_DIGITS),
   657	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   658	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   659	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   660	        "implementation_sha256": _implementation_sha(),
   661	    }
   662	
   663	
   664	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   665	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   666	    effective = effective_rank_config(decay, version, minutes)
   667	    _warn_recorded_drift(recorded, effective)
   668	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   669	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
