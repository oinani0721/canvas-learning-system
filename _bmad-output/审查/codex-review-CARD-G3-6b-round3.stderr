   575	    # null 或形状不符都必须点名回落, 不许静默 (Codex round-2 MEDIUM: 前一轮
   576	    # 只修了叶键, 父节缺失照样无声 —— 配置断裂被伪装成"就该是这个数")
   577	    if not isinstance(auth, dict):
   578	        print(f"[pick] authoritative 节缺失或形状不符({auth!r}), 分钟用内置默认",
   579	              file=sys.stderr)
   580	        cfg = None
   581	    else:
   582	        cfg = auth.get("estimated_minutes")
   583	        if not isinstance(cfg, dict):
