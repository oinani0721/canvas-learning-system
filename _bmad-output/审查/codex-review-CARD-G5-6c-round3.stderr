   834	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   835	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   836	
   837	#: ⛔ 护栏级 AI 信号（结构性，不依赖枚举表）：文本含独立「AI」字样即算嫌疑。
   838	#: 「独立」= 左右都**不是 ASCII 字母**（`\bAI\b` 在 CJK 邻接时无词边界 ——
   839	#: round-7 BLOCKER-1：`由AI系统生成` 曾穿透）。有限标记表无论怎么扩都追不上
   840	#: 自然语言的肯定式声明（round-6 BLOCKER-1：`This report was generated by an
   841	#: AI system` 不含任何表项，双层全盲，无正文时掉进 C3 建议删）。本信号只降
   842	#: C6 不裁决 —— C2 确定命中仍走有限表 + 边界规则（宽匹配会给话题提及发确定
   843	#: 归档，那是硬猜）。
   844	_AI_WORD_RE = re.compile(r"(?<![A-Za-z])AI(?![A-Za-z])", re.IGNORECASE)
   845	
   846	#: ⛔ 护栏级**生成断言结构**（round-8 BLOCKER-2）：`generator: 由 GPT-4 生成`
   847	#: 里既没有表项（表只收到 `由 GPT 生成`，`GPT-4` 差一个版本号）也没有独立词
   848	#: 「AI」，三层护栏全盲 → 无正文时掉进 C3 `建议删 + confident=true`。
   849	#: 修法按**声明骨架**而不是**枚举模型名**（卡文 §3 默认裁决）：模型名是开放
   850	#: 集合，`GPT-4` 之后还有 `GPT-4o`/`Claude 3.5`/`Gemini 2.5`/下个月发布的那个，
   851	#: 枚举永远追不上；「由 <某物> 生成」这个断言骨架是闭合的。
   852	#: ⚠️ 只作**未消化信号降 C6**，绝不进 C2：宽匹配给话题提及发确定归档就是硬猜
   853	#: （`由编译器生成`、`generated by hand` 都会命中本条 —— 它们降 C6，方向安全）。
   854	#: 中文：`由` 与 `生成` 之间任意个**非句读**字符（句读收尾防跨句吞成假断言）。
   855	#: ⛔ round-2 审查 BLOCKER：原先写 `{1,40}?` 加了长度上界，于是
   856	#: `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
   857	#: （中间 65 字符）穿透 —— **上界本身就是缝隙**，而当初说「断言骨架是闭合的」
   858	#: 正因为这个上界而不成立。去掉上界后骨架才真的闭合（同一行、中间不跨句读）。
   859	#: 放宽的代价是 `由于…最终生成了报告` 这类也会命中，但那只降 C6（拿不准、不删），
   860	#: 误命中方向安全 —— 用一点召回换掉一条确定删除的路径，是划算的。
   861	_GEN_CLAIM_CN_RE = re.compile(r"由[^。；！？\n]*?生成")
   862	#: 英文：在归一（连续空白折叠为单空格 + casefold）后的行上匹配，故只写单空格。
   863	#: ⛔ round-2 审查 BLOCKER：原先写 `generated by \S`（字面空格 + 非空），于是
   864	#: `Generated by: GPT-4` 穿透 —— `by` 后面是冒号不是空格。改为 `by` 词边界后
   865	#: 允许任意非词字符（冒号/破折号/空格）再要求一个词字符：
   866	#: ⛔ round-3 审查 HIGH：上一版写 `generated by\b\W*\w`，而 `_` 属于 `\w` ——
   867	#: `Generated by_GPT-4` 的 `by` 与 `_` 之间**没有**词边界，整条穿透（C3 与 C4
   868	#: 两个出口都中）。词边界这个概念在这里本来就不对：要判的是「by 是不是一个
   869	#: 完整的词」，直接写成「后面不是字母数字」才准确，分隔符则连下划线一起吃。
   870	#:   `generated by: gpt-4` ✅ / `generated by llama` ✅ / `generated by_gpt-4` ✅
   871	#:   / `generated byte` ❌（by 后面是字母）/ 行尾 `generated by` ❌（没有主语）
   872	_GEN_CLAIM_EN_RE = re.compile(r"generated by(?![^\W_])[\W_]*[^\W_]")
   873	
   874	#: ⛔ 护栏级**生成器声明字段**（round-8 BLOCKER-2 的另一半）：键名本身就是声明。
   875	#: `generator: gpt-4`（值里没有「生成」二字）只有本条能接住，`本文由 GPT-4 生成`
   876	#: 写在正文里（无 frontmatter）只有 `_GEN_CLAIM_*` 能接住 —— 两条互补，都不冗余。
   877	#: 键名归一口径见 `_norm_fm_key`。
   878	_GENERATOR_DECL_KEYS = frozenset(
   879	    {"generator", "generated_by", "ai_generated", "model", "llm", "ai"}
   880	)
   881	
   882	#: ⛔ 来源声明键别名（round-8 HIGH）：`Source: DOI:10.1000/xyz` 的唯一来源标识
   883	#: 曾被当作不存在 —— `"source" in fm` 是**大小写敏感**的字面查找，取不到 `Source`；
   884	#: 而值不含 `http(s)://`，`url_bearing_keys` 也接不住。⚠️ 本别名集合只用于
   885	#: **护栏**：C1 仍只认字面小写 `source` 键（R8 稿约定），DOI 更不冒充 URL 或 C1
   886	#: （卡文 §3 默认裁决）—— 信号只把来源摆上台面降 C6，不给出「留原地/一手」提名。
   887	_SOURCE_DECL_KEYS = frozenset({"source", "sources"})
   888	
   889	#: ⛔ C3「空骨架」的兜底口径**两轮才收敛到位**，过程记在这里以免后人重走：
   890	#:
   891	#: round-2 审查 HIGH 先逼出**方向反转**：此前所有来源护栏都在枚举「危险的键名和
   892	#: 值形态」（source/url/doi…），那是 fail-open —— 漏一个就是一条确定删除的路径，
   893	#: 而 `citation: ISBN 978-7-111-54742-6` 正好两样都不沾，被判 C3 确定删除。
   894	#: 于是改成枚举「已知无害、删掉不丢信息」的键名白名单，默认拦住。
   895	#:
   896	#: round-3 审查 HIGH 又把那份白名单打穿：**放行的是键名，可信息在值里**。
   897	#: `title: ISBN 978-…`、`aliases: <馆藏号>`、`title: <这份材料仅有的那句话>`
   898	#: 全都因为键名在白名单而被判 C3 确定删除；C4 侧更直接 —— 引擎自己挂着
   899	#: 「正文重复证据不覆盖这些元数据」的冲突，却仍然 confident=true。
   900	#: **「这个键名无害」是个无法机械成立的断言**：`title` 可能是一句 t，也可能是
   901	#: 这份材料唯一写下来的东西，引擎分不出来，分不出来就不能替用户决定。
   902	#:
   903	#: 现口径（信号⑨）：**frontmatter 里只要有任何非空值，C3/C4 就不确定删除**。
   904	#: 白名单整个取消 —— 不是收窄，是这条路本身走不通。
   905	#: ⚠️ 代价如实说：C3 的可达面明显变窄，只剩「0 字节」「没有 frontmatter 的纯
   906	#: 骨架」「frontmatter 全是空值」三种。这是刻意选的偏向 —— 少删一份的代价是
   907	#: 用户多看一眼，多删一份的代价是材料没了。
   908	#: 依据是卡文 §3 默认裁决「未知结构或来源信号至少降级 C6」。
   909	
   910	#: DOI 形态（ISO 26324：`10.<registrant>/<suffix>`）。左界排除字母数字与点，
   911	#: 于是 `DOI:10.1000/xyz`、`doi: 10.1000/xyz`、裸 `10.1000/xyz` 都命中，而
   912	#: 版本号 `v10.1000/x` 之类不命中。⚠️ 只作来源信号，不解析、不解引用、不联网。
   913	_DOI_RE = re.compile(r"(?<![0-9A-Za-z.])10\.\d{4,9}/[^\s\"'<>]+")
   914	
   915	
   916	def _norm_fm_key(k: str) -> str:
   917	    """frontmatter 键名归一：casefold + `-`→`_`。
   918	
   919	    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
   920	    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
   921	    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
   922	    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
   923	    """
   924	    return k.casefold().replace("-", "_")
   925	
   926	
   927	def _looks_like_doi_value(v: str) -> bool:
   928	    """值里含 DOI 形态的来源标识（⛔ substring 级，与 `_looks_like_source_value`
   929	    同口径）。非空才算 —— 卡文 (d) 要的是「**非空** DOI 来源阻止 C3 删除」。"""
   930	    return bool(v) and bool(_DOI_RE.search(v))
