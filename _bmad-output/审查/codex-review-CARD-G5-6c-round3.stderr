   997	def raw_ai_marker(text: str) -> str | None:
   998	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   999	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
  1000	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
  1001	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
  1002	    返回原表原文（uncertain_reason 展示用）。
  1003	    ⛔ 走 `_norm_guard_line`（比 C2 判据多剥零宽）—— 护栏宽、判据不动。"""
  1004	    for _, ln in head_window(text):
  1005	        for norm in _guard_variants(ln):
  1006	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
  1007	                if nm in norm:
  1008	                    return orig
  1009	    return None
