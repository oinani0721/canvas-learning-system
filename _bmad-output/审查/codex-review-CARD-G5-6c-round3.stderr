  1291	    # 信号③b：非 source 键名但值是 URL 形态（url:/URL:/Source: 等剪藏工具
  1292	    # 常见键名 —— round-5 自审 F2 实证它们曾穿透全部信号被建议删且 URL 零留痕；
  1293	    # 值损坏的别名见 `_looks_like_source_value`）。
  1294	    # 合法 source 键在此不可能出现（C1 已先行返回）。⚠️ C1 仍只认字面 source 键
  1295	    # （R8 稿约定）；本信号只把这类来源摆上台面降 C6，不扩大 C1。
  1296	    url_bearing_pairs = [
  1297	        (k, v) for k, v in fm_pairs if v and _looks_like_source_value(v)
  1298	    ]
  1299	    # 信号③a'（round-8 HIGH）：`source` 键名的**大小写/连字符变体**。原实现只查
  1300	    # 字面小写 `source`，于是 `Source: DOI:10.1000/xyz` 的唯一来源标识被当作
