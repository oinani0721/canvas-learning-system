  1012	def round_of(name: str) -> str | None:
  1013	    m = _ROUND_RE.search(name)
  1014	    return m.group(1) if m else None
  1015	
  1016	
  1017	def round_type(name: str) -> str | None:
  1018	    for pat, typ in ROUND_SUBPATTERNS:
  1019	        if pat in name:
  1020	            return typ
  1021	    return None
