from pathlib import Path
import sys
root = Path(sys.argv[1])
def vault(name):
    v = root / name / \"vault\"
    (v / \"_待处理\").mkdir(parents=True)
    return v
def put(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(text.encode(\"utf-8\"))

