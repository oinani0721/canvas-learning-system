  1302	    source_alias_pairs = [
  1303	        (k, v) for k, v in fm_pairs if _norm_fm_key(k) in _SOURCE_DECL_KEYS
  1304	    ]
  1305	    # 信号③c（round-8 HIGH）：值是 DOI 形态的来源标识（`identifier:` 之类
  1306	    # 不在别名表的键名靠它接住）。DOI 不是 URL —— 文案分列，不冒充。
