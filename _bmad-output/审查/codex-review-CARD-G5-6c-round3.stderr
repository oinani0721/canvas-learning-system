  2225	def test_schema_v1_full_key_sets_are_frozen(tmp_path):
  2226	    """⛔ round-2 审查 MEDIUM: `test_schema_version_frozen_at_one` 只锁
  2227	    `schema_version`/`id_namespace`/disclaimer —— 删改大多数 top/item/nested 键
  2228	    仍能保持它绿。schema v1 是**冻结**契约，键集合必须整体上锁。
  2229	
  2230	    期望值取自 round-2 审查报告 §二.3 实测清单（独立来源，不是从本次输出反抄
  2231	    —— 自抄期望值等于让门给自己签字，见 reference_gate_design_pitfalls）。
  2232	    """
  2233	    vault, out = base_vault(tmp_path)
  2234	    inbox = vault / "_待处理"
  2235	    mk(inbox / "a.md", "# A\n\n正文内容一。\n正文内容二。\n", age_days=3)
  2236	    mk(inbox / "b.md", "---\nsource: https://x.test/p\n---\n\n正文。\n正文二。\n", age_days=2)
  2237	    # ⛔ round-3 审查 MEDIUM: 原先建在 `vault/Sleeping`，而生产读的是
  2238	    # `<收件箱>/Sleeping` —— fixture 建错位置 ⇒ sleeping.items 恒空 ⇒ 那一层的
  2239	    # 键集合根本没被锁（在副本里给 sleeping.items[*] 加一个键，88 门照样全绿）。
  2240	    (inbox / "Sleeping").mkdir(exist_ok=True)
  2241	    mk(inbox / "Sleeping" / "s.md", "---\nslept_at: 2026-07-01\n---\n\n睡着的。\n", age_days=40)
  2242	
  2243	    assert run_cli(vault, out).returncode == 0
  2244	    data = load_json(out)
  2245	    assert data["schema_version"] == 1
  2246	    assert data["items"], "items 为空则 item_keys 断言恒真 = 假绿"
  2247	
  2248	    expected_top = {
  2249	        "corpus",
  2250	        "criteria_order",
  2251	        "generator",
  2252	        "id_namespace",
  2253	        "id_stability",
  2254	        "inbox_dir",
  2255	        "inbox_exists",
  2256	        "inventory",
  2257	        "items",
  2258	        "label",
  2259	        "last_cleanup",
  2260	        "last_cleanup_note",
  2261	        "near_dup_scan",
  2262	        "not_executed_disclaimer",
  2263	        "now",
  2264	        "now_local",
  2265	        "now_utc",
  2266	        "receipt",
  2267	        "schema_version",
  2268	        "sleeping",
  2269	        "vault_fingerprint",
  2270	        "verdict_vocabulary",
  2271	    }
  2272	    expected_item = {
  2273	        "age_days",
  2274	        "ask",
  2275	        "basis",
  2276	        "confident",
  2277	        "conflicts",
  2278	        "criterion",
  2279	        "exact_duplicate_of",
  2280	        "exact_duplicate_others",
  2281	        "index",
  2282	        "mtime_local",
  2283	        "mtime_utc",
  2284	        "name",
  2285	        "near_duplicates",
  2286	        "nomination_type",
  2287	        "rel_path",
  2288	        "size_bytes",
