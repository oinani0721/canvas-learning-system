  1561	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1562	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1563	    items: list[dict] = []
  1564	    skipped: list[dict] = []
  1565	    with os.scandir(inbox) as it:
  1566	        entries = sorted(it, key=lambda e: e.name)
  1567	    for entry in entries:
  1568	        p = Path(entry.path)
  1569	        if entry.is_symlink():
  1570	            skipped.append(
  1571	                {
  1572	                    "name": entry.name,
  1573	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1574	                }
  1575	            )
  1576	            continue
  1577	        if entry.is_dir():
  1578	            if entry.name == SLEEPING_DIR_NAME:
  1579	                continue  # 走 Sleeping 台账
  1580	            skipped.append(
  1581	                {
  1582	                    "name": entry.name,
  1583	                    "reason": "子目录不在本卡盘点范围（只盘点顶层文件与 Sleeping/ 台账）",
  1584	                }
  1585	            )
  1586	            continue
  1587	        if not entry.is_file():
  1588	            # FIFO / 设备 / 套接字：read_bytes 可能直接阻塞，绝不碰
  1589	            skipped.append(
  1590	                {
  1591	                    "name": entry.name,
  1592	                    "reason": "不是普通文件（FIFO / 设备 / 套接字等），不读取",
  1593	                }
  1594	            )
  1595	            continue
  1596	        try:
  1597	            st = p.stat()
  1598	        except OSError as e:
  1599	            # 扫目录与取属性之间材料被移走 —— 跳过留痕, 不让一次竞态崩掉整份 preview
  1600	            skipped.append(
  1601	                {
  1602	                    "name": entry.name,
  1603	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1604	                }
  1605	            )
  1606	            continue
  1607	        items.append(
  1608	            {
  1609	                "stable_id": compute_inbox_stable_id(
  1610	                    f"{nfc(inbox.name)}/{nfc(entry.name)}"
  1611	                ),
  1612	                "name": entry.name,
  1613	                "rel_path": f"{inbox.name}/{entry.name}",
  1614	                "size_bytes": st.st_size,
  1615	                "mtime_utc": fmt_utc(st.st_mtime),
  1616	                "mtime_local": fmt_local(st.st_mtime),
  1617	                "age_days": days_between(now_s, st.st_mtime),
  1618	                # 排序用纳秒整数（float 秒会把相差 1ns 的两件折叠成相等，
  1619	                # 于是"最旧优先"退化成按文件名 —— Codex LOW 实证）
  1620	                "_mtime_ns": st.st_mtime_ns,
  1621	                "_path": str(p),
  1622	            }
  1623	        )
  1624	    # 最旧优先；同 mtime 按名字升序 —— 二跑同序的唯一保证
  1625	    items.sort(key=lambda d: (d["_mtime_ns"], d["name"]))
  1626	    return items, skipped
