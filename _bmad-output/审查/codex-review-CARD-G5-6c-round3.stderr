  1215	            {
  1216	                "kind": "duplicate_within_batch",
  1217	                "detail": "本批内另有正文逐字相同的材料 —— 谁是正本在只读侧不可判，"
  1218	                "故不产出建议删，请你指定保留哪一份",
  1219	            }
  1220	        )
  1221	
