   162	def run_suite() -> tuple[int, set[str], str]:
   163	    r = subprocess.run(
   164	        PYTEST,
   165	        cwd=BACKEND,
   166	        capture_output=True,
   167	        text=True,
   168	        env={
   169	            "PATH": "/usr/bin:/bin",
   170	            "PYTHONDONTWRITEBYTECODE": "1",
   171	            "HOME": str(pathlib.Path.home()),
   172	            "LC_ALL": "C.UTF-8",
   173	        },
   174	    )
   175	    out = r.stdout + r.stderr
   176	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   177	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   178	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   179	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   180	    failed = {
   181	        ln.split("::")[1].split(" ")[0].strip()
   182	        for ln in out.splitlines()
   183	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   184	    }
   185	    tail = [
   186	        ln
   187	        for ln in out.splitlines()
   188	        if "passed" in ln or "failed" in ln or "error" in ln
   189	    ]
   190	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
