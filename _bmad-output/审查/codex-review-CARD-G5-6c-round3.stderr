  2027	def validate_product_filename(label: str) -> None:
  2028	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  2029	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  2030	    for suffix in (".json", ".md"):
  2031	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  2032	        if n > MAX_FILENAME_BYTES:
  2033	            raise SystemExit(
  2034	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  2035	                f"inbox-preview-{label}{suffix}"
  2036	            )
