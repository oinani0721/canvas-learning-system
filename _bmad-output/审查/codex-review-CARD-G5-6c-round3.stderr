  2110	def test_duplicate_frontmatter_key_does_not_mask_source(tmp_path):
  2111	    """⛔ round-2 审查 BLOCKER: `frontmatter_map` 用 `setdefault` 只留**首值**，
  2112	
  2113	        ---
  2114	        doi:
  2115	        doi: 10.1000/hidden
  2116	        ---
  2117	
  2118	    折叠后只剩一个空值，所有基于 `fm.items()` 的护栏信号全扫不到那个 DOI ——
  2119	    同形 `url:` 反例同时穿透 C3 与 C4 两个出口。护栏改扫 `frontmatter_pairs`
  2120	    的全量键值对；判据侧的首值语义不动。
  2121	    """
  2122	    mod = load_module()
  2123	    pairs = mod.frontmatter_pairs(["doi:", "doi: 10.1000/hidden"])
  2124	    assert pairs == [("doi", ""), ("doi", "10.1000/hidden")], pairs
  2125	    assert mod.frontmatter_map(["doi:", "doi: 10.1000/hidden"]) == {"doi": ""}, (
  2126	        "判据侧首值语义必须保持不动 —— 改它是有后果的行为变更"
  2127	    )
  2128	
  2129	    vault, out = base_vault(tmp_path)
  2130	    inbox = vault / "_待处理"
  2131	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2132	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2133	    mk(inbox / "重复DOI键.md", "---\ndoi:\ndoi: 10.1000/hidden\n---\n", age_days=9)
  2134	    mk(inbox / "重复URL键.md", "---\nurl:\nurl: https://example.test/hidden\n---\n", age_days=8)
  2135	    mk(
  2136	        inbox / "重复DOI重复件.md",
  2137	        "---\ndoi:\ndoi: 10.1000/dup-hidden\n---\n" + body,
  2138	        age_days=7,
  2139	    )
  2140	    mk(inbox / "纯空骨架.md", "# 只有标题\n\n## 小节\n", age_days=6)
  2141	
  2142	    assert run_cli(vault, out).returncode == 0
  2143	    data = load_json(out)
  2144	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2145	    for name, frag in (
  2146	        ("重复DOI键.md", "10.1000/hidden"),
  2147	        ("重复URL键.md", "example.test/hidden"),
  2148	        ("重复DOI重复件.md", "10.1000/dup-hidden"),
  2149	    ):
  2150	        it = item_by_name(data, name)
  2151	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2152	        assert it["criterion"] == "C6_undecided", name
  2153	        assert it["confident"] is False, name
  2154	        r = it["uncertain_reason"] or ""
  2155	        assert frag in r, r
  2156	        # ⛔ 信号归属：兜底 reason 也会把值原样打出来，`frag in r` 单独不够判别。
  2157	        assert ("DOI 来源标识" in r) or ("来源 URL" in r), f"{name} 未由来源族接住: {r}"
  2158	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2159	    dup = item_by_name(data, "重复DOI重复件.md")
  2160	    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "C4 出口也要拦，且证据留痕"
  2161	    skeleton = item_by_name(data, "纯空骨架.md")
  2162	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2163	    assert skeleton["verdict"] == "建议删"
  2164	
