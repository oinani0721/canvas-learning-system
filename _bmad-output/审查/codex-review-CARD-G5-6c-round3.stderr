  2059	def test_long_model_name_and_punctuated_generation_claims_are_undigested(tmp_path):
  2060	    """⛔ round-2 审查 BLOCKER: 生成声明骨架的三条缝隙——
  2061	
  2062	    1. 中文骨架原写 `由[^。；！？\\n]{1,40}?生成`，**长度上界本身就是缝隙**：
  2063	       `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
  2064	       中间 65 字符，穿透后无正文被判 C3 确定删除；
  2065	    2. 英文骨架原写 `generated by \\S`（字面空格），`Generated by: GPT-4` 的
  2066	       `by` 后是冒号，不匹配；
  2067	    3. `Generated by<U+200B>GPT-4` 的零宽空格**不是** `str.isspace()` 认的空白，
  2068	       `ln.split()` 折叠不掉。护栏改走 `_norm_guard_line`（零宽→空格）。
  2069	    """
  2070	    mod = load_module()
  2071	    # 纯函数半边：上界去掉后，长度这一维不再是缝（但骨架另有边界，见 docstring）
  2072	    long_name = "openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01"
  2073	    assert len(long_name) > 40, "反例必须真的超过原上界，否则本门是死门"
  2074	    assert mod._GEN_CLAIM_CN_RE.search(f"本文由 {long_name} 生成")
  2075	    assert mod._GEN_CLAIM_EN_RE.search("generated by: gpt-4"), "by 后标点必须放行"
  2076	    assert mod._GEN_CLAIM_EN_RE.search("generated by llama-4"), "原空格形态不得连坐"
  2077	    assert not mod._GEN_CLAIM_EN_RE.search("generated byte order mark"), "`byte` 不是 `by` —— 词边界必须挡住"
  2078	    assert not mod._GEN_CLAIM_EN_RE.search("generated by"), "光一句没有主语不算断言"
  2079	    assert mod._norm_guard_line("Generated by\u200bGPT-4") == "generated by gpt-4", (
  2080	        "零宽必须换成空格而非删除，否则 by 与 GPT 粘连、词边界照样认不出"
  2081	    )
  2082	
  2083	    vault, out = base_vault(tmp_path)
  2084	    inbox = vault / "_待处理"
  2085	    mk(inbox / "长模型名.md", f"---\nnote: 本文由 {long_name} 生成\n---\n", age_days=9)
  2086	    mk(inbox / "英文冒号.md", "---\nnote: Generated by: GPT-4\n---\n", age_days=8)
  2087	    mk(inbox / "英文零宽.md", "---\nnote: Generated by\u200bGPT-4\n---\n", age_days=7)
  2088	    # 正向对照: 白名单键 + 无正文 → 仍 C3 建议删（护栏不得吞掉存量判据）
  2089	    # round-3: C3 的正向对照必须是**没有 frontmatter 非空值**的骨架
  2090	    mk(inbox / "纯空骨架.md", "# 只有标题\n\n## 小节\n", age_days=6)
  2091	
  2092	    assert run_cli(vault, out).returncode == 0
  2093	    data = load_json(out)
  2094	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2095	    for name in ("长模型名.md", "英文冒号.md", "英文零宽.md"):
  2096	        it = item_by_name(data, name)
  2097	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2098	        assert it["criterion"] == "C6_undecided", name
  2099	        assert it["confident"] is False, name
  2100	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2101	        assert it["uncertain_reason"], name
  2102	        # ⛔ 信号归属：必须是**生成断言结构**接住的。这三份的键都是 `note`，
  2103	        # 不在白名单里，兜底同样能接住 —— 不锁信号就测不到骨架那一层。
  2104	        assert "生成断言结构" in it["uncertain_reason"], f"{name} 未由生成断言结构接住: {it['uncertain_reason']}"
  2105	    skeleton = item_by_name(data, "纯空骨架.md")
  2106	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2107	    assert skeleton["verdict"] == "建议删"
  2108	
