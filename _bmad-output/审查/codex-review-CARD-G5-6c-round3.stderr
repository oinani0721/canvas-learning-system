  1990	def test_doi_source_identifier_blocks_deletion(tmp_path):
  1991	    """⛔ round-8 HIGH: `Source: DOI:10.1000/xyz` 的唯一来源标识被当作不存在。
  1992	
  1993	    两处缺口: `"source" in fm` 是**大小写敏感**的字面查找(取不到 `Source`),
  1994	    而值不含 `http(s)://` 时 `url_bearing_keys` 也接不住 → C3 `建议删 +
  1995	    confident=true`。护栏两侧都补: 键名归一(大小写/连字符) + DOI 值形态。
  1996	    ⚠️ DOI **不冒充 URL 也不升 C1**(卡文 §3): 只把来源摆上台面降 C6。
  1997	    """
  1998	    vault, out = base_vault(tmp_path)
  1999	    inbox = vault / "_待处理"
  2000	    # round-8 反例原样
  2001	    mk(inbox / "DOI来源.md", "---\nSource: DOI:10.1000/xyz\n---\n", age_days=9)
  2002	    # 键名归一半边: 值不是 URL 也不是 DOI, 靠键名接住
  2003	    mk(inbox / "大写SOURCE手抄.md", "---\nSOURCE: 手抄自 2019 年讲义 P37\n---\n", age_days=8)
  2004	    # 值形态半边: 键名不在别名表, 靠 DOI 形态接住
  2005	    mk(inbox / "identifier键DOI.md", "---\nidentifier: 10.1145/3292500.3330701\n---\n", age_days=7)
  2006	    # C4 出口也必须拦
  2007	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2008	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2009	    mk(inbox / "DOI重复件.md", "---\ndoi: 10.1000/dup-only\n---\n" + body, age_days=6)
  2010	    # 正向对照 1: 无来源声明的纯空骨架 → 仍 C3 建议删
  2011	    mk(inbox / "纯空骨架.md", "# 只有标题\n\n## 小节\n", age_days=5)
  2012	    # 正向对照 2: 合法 source URL → 仍 C1(护栏不得扩大也不得挤掉判据)
  2013	    mk(inbox / "正常剪藏.md", "---\nsource: https://ok.test/clip\n---\n", age_days=4)
  2014	
  2015	    assert run_cli(vault, out).returncode == 0
  2016	    data = load_json(out)
  2017	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2018	    for name, frag in (
  2019	        ("DOI来源.md", "DOI:10.1000/xyz"),
  2020	        ("大写SOURCE手抄.md", "讲义 P37"),
  2021	        ("identifier键DOI.md", "10.1145/3292500.3330701"),
  2022	    ):
  2023	        it = item_by_name(data, name)
  2024	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2025	        assert it["criterion"] == "C6_undecided", name
  2026	        assert it["confident"] is False, name
  2027	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2028	        # ⛔ 来源标识必须逐字留痕 —— 否则「拦住了」等于把线索一起吞掉
  2029	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2030	    # ⛔ 信号归属（round-2 MEDIUM-4）：必须是**来源族**信号接住的，不是白名单兜底。
  2031	    # 单独回退来源信号时兜底会接住材料、verdict 断言仍绿 —— 那条防线就没被测到。
  2032	    for name in ("DOI来源.md", "大写SOURCE手抄.md"):
  2033	        r = item_by_name(data, name)["uncertain_reason"] or ""
  2034	        assert "不是可机判的" in r, f"{name} 应由 source 键名归一接住: {r}"
  2035	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2036	    for name in ("identifier键DOI.md", "DOI重复件.md"):
  2037	        r = item_by_name(data, name)["uncertain_reason"] or ""
  2038	        assert "DOI 来源标识" in r, f"{name} 应由 DOI 值形态接住: {r}"
  2039	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2040	    # ⛔ DOI 不冒充 URL / 不升 C1
  2041	    doi_item = item_by_name(data, "DOI来源.md")
  2042	    assert doi_item["criterion"] != "C1_source_url", "DOI 不得被判成一手 URL"
  2043	    assert "DOI" in (doi_item["uncertain_reason"] or "")
  2044	    dup = item_by_name(data, "DOI重复件.md")
  2045	    assert dup["verdict"] != "建议删", f"带 DOI 的重复件被建议删了: {dup['basis']}"
  2046	    assert dup["criterion"] == "C6_undecided"
  2047	    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
  2048	    skeleton = item_by_name(data, "纯空骨架.md")
  2049	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2050	    assert skeleton["verdict"] == "建议删"
  2051	    primary = item_by_name(data, "正常剪藏.md")
  2052	    assert primary["criterion"] == "C1_source_url"
  2053	    assert primary["verdict"] == "留原地"
