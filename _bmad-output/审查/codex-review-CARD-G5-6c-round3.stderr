   730	    for ln, kind in _classify_lines_typed(text)[0]:
   731	        if kind == "code":
   732	            if ln.strip():
   733	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   734	            continue
   735	        if kind == "fence":
   736	            continue
   737	        if _HEADING_RE.match(ln):
   738	            continue
   739	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   740	        if t and not _ONLY_STRUCT_RE.match(t):
   741	            return True
   742	    return False
