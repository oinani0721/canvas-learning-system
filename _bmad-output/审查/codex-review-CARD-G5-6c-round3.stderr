  2389	def test_zero_width_split_marker_still_reads_as_ai_suspect(tmp_path):
  2390	    """⛔ round-2 负控 M-ZEROWIDTH 照出的**不承重层**，本门是它唯一的裁判。
  2391	
  2392	    回退 `_norm_guard_line` 后套件一门都不红 —— 因为 `Generated by<ZWSP>GPT-4`
  2393	    在旧归一下**已经**命中生成骨架（骨架里的非词字符段/非句读字符类都吃零宽），
  2394	    一条修法顺手覆盖了另一条。`_norm_guard_line` 真正承重的只有 `raw_ai_marker`:
  2395	    零宽插在**标记表项中间**时（`Generated by<ZWSP>AI Lab`），不剥零宽就匹配不到
  2396	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
  2397	
  2398	    ⚠️ 如实声明本门测的是**理由质量**不是安全: 两种情况材料都不会被删，
  2399	    差别只在 uncertain_reason 说的是「疑似 AI 自述」还是「生成断言结构」。
  2400	    留着这一层是因为前者对人更有用 —— 但不写成安全防线，也就不能假装它是。
  2401	    """
  2402	    mod = load_module()
  2403	    zw = "\u200b"
  2404	
  2405	    # 纯函数半边: 零宽切断表项时，只有护栏归一能还原出表项
  2406	    def _raw_hit(line, norm_fn):
  2407	        n = norm_fn(line)
  2408	        return next((o for nm, o in zip(mod._AI_MARKERS_NORM, mod.AI_MARKERS) if nm in n), None)
  2409	
  2410	    line = f"note: Generated by{zw}AI Lab"
  2411	    assert _raw_hit(line, mod._norm_ai_line) is None, "旧归一本就认不出（这是本门的前提）"
  2412	    assert _raw_hit(line, mod._norm_guard_line) == "Generated by AI"
  2413	
  2414	    # ⛔ round-3 审查 BLOCKER: 零宽换空格只对**词间**插入成立；插在**词内部**时
  2415	    # 反而把关键词拆开（`Genera<ZWSP>ted` → `genera ted`），骨架与标记表一起失效
  2416	    # —— 比不处理更糟。故两种还原都要试：换空格还原词间，直接删还原词内。
  2417	    spaced, stripped = mod._guard_variants(f"title: Genera{zw}ted by GPT-4")
  2418	    assert "genera ted" in spaced, "换空格版必然拆词（这是需要第二个变体的理由）"
  2419	    assert mod._GEN_CLAIM_EN_RE.search(spaced) is None, "拆词后骨架认不出（前提）"
  2420	    assert mod._GEN_CLAIM_EN_RE.search(stripped), "直接删版必须还原出 generated by"
  2421	    # 反向：词间插入靠换空格版，直接删会把 by 与 GPT 粘成 bygpt
  2422	    sp2, st2 = mod._guard_variants(f"title: Generated by{zw}GPT-4")
  2423	    assert mod._GEN_CLAIM_EN_RE.search(sp2), "换空格版必须还原词间分隔"
  2424	    assert "bygpt" in st2, "直接删版会粘连（这是需要第一个变体的理由）"
  2425	    # C2 判据不得被这一层带宽：确定归档面必须原地不动
  2426	    assert mod.find_ai_marker(line) is None, "护栏加宽不得顺带扩大 C2 确定提名面"
  2427	
  2428	    vault, out = base_vault(tmp_path)
  2429	    inbox = vault / "_待处理"
  2430	    mk(inbox / "零宽切断表项.md", f"---\nnote: Generated by{zw}AI Lab\n---\n", age_days=6)
  2431	    mk(inbox / "纯空骨架.md", "# 只有标题\n\n## 小节\n", age_days=5)
  2432	
  2433	    assert run_cli(vault, out).returncode == 0
  2434	    data = load_json(out)
  2435	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2436	    it = item_by_name(data, "零宽切断表项.md")
  2437	    assert it["verdict"] != "建议删", it["basis"]
  2438	    assert it["criterion"] == "C6_undecided"
  2439	    assert it["confident"] is False
  2440	    # ⛔ 信号归属就是本门的全部判别力: 回退护栏归一后这里会变成「生成断言结构」
  2441	    r = it["uncertain_reason"] or ""
  2442	    assert "疑似 AI 生成自述" in r, f"未由 ai_suspect 接住（护栏归一没起作用）: {r}"
  2443	    skeleton = item_by_name(data, "纯空骨架.md")
  2444	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2445	    assert skeleton["verdict"] == "建议删"

