   933	def find_generation_claim(text: str) -> str | None:
   934	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
   935	
   936	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
   937	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
   938	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
   939	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
   940	    """
   941	    for _, ln in head_window(text):
   942	        for norm in _guard_variants(ln):
   943	            for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
   944	                m = rx.search(norm)
   945	                if not m:
   946	                    continue
   947	                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
   948	                # `generated by l` —— 人工核对时看不出是哪个模型。补到该词结束。
   949	                end = m.end()
   950	                while end < len(norm) and (norm[end].isalnum() or norm[end] in "-_.:"):
   951	                    end += 1
   952	                return norm[m.start() : end]
   953	    return None
   954	
   955	
   956	def _find_marker_pos(ln: str, marker: str) -> int:
   957	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   958	
   959	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   960	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   961	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   962	    行内更靠后的真命中。
   963	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   964	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   965	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   966	    只认行尾或标点；漏判方向落 C6，安全。"""
   967	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   968	    start = 0
   969	    while (i := ln.find(marker, start)) >= 0:
   970	        j = i + len(marker)
   971	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   972	            return i
   973	        if not ascii_ending and ln[j].isspace():
   974	            return i
   975	        start = i + 1
   976	    return -1
   977	
   978	
   979	def find_ai_marker(text: str) -> tuple[int, str] | None:
   980	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   981	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   982	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   983	    —— 行号准确，文本保真。"""
   984	    for lineno, ln in head_window(text):
   985	        norm = _norm_ai_line(ln)
   986	        hits = [
   987	            (pos, -len(nm), orig)
   988	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   989	            if (pos := _find_marker_pos(norm, nm)) >= 0
   990	        ]
   991	        if hits:
   992	            _, _, marker = min(hits)
   993	            return lineno, marker
   994	    return None
   995	
