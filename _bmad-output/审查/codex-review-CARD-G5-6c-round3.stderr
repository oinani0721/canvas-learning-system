  2166	def test_any_nonempty_frontmatter_value_blocks_confident_deletion(tmp_path):
  2167	    """⛔ round-2 HIGH → round-3 HIGH: 这条口径**两轮才收敛到位**。
  2168	
  2169	    round-2: `citation: ISBN 978-7-111-54742-6` 不沾 URL 也不沾 DOI，八类信号
  2170	    全盲被判 C3 确定删除。当时的答案是**方向反转** —— 从枚举「危险的键名/值形态」
  2171	    改为枚举「已知无害的键名」白名单，默认拦住。
  2172	    round-3: 白名单被打穿 —— **放行的是键名，可信息在值里**。`title: ISBN 978-…`、
  2173	    `aliases: <馆藏号>`、`title: <这份材料唯一写下的那句话>` 全都因键名在白名单
  2174	    而确定删除；C4 侧更直接，引擎挂着「正文重复证据不覆盖这些元数据」的冲突却
  2175	    仍 confident=true。
  2176	    「这个键名无害」是个无法机械成立的断言：`title` 可能是一句 t，也可能是这份
  2177	    材料唯一写下来的东西 —— 引擎分不出，分不出就不能替用户决定。
  2178	    现口径: frontmatter 里**任何非空值**都让 C3/C4 让位给 C6。
  2179	    """
  2180	    vault, out = base_vault(tmp_path)
  2181	    inbox = vault / "_待处理"
  2182	    # round-2 原始反例
  2183	    mk(inbox / "ISBN来源.md", "---\ncitation: ISBN 978-7-111-54742-6\n---\n", age_days=9)
  2184	    mk(inbox / "馆藏号.md", "---\nshelfmark: TP311.13/K92-3\n---\n", age_days=8)
  2185	    # ⛔ round-3 反例: 信息藏在**白名单键**的值里
  2186	    mk(inbox / "标题即来源.md", "---\ntitle: ISBN 978-7-111-54742-6\n---\n", age_days=7)
  2187	    mk(inbox / "别名即馆藏.md", "---\naliases: TP311.13/K92-3\n---\n", age_days=6)
  2188	    mk(inbox / "标题即唯一内容.md", "---\ntitle: 微积分基本定理的两种证法\n---\n", age_days=5)
  2189	    # C4 出口同样要拦
  2190	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2191	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2192	    mk(inbox / "标题独有重复件.md", "---\ntitle: 只有这里写了出处\n---\n" + body, age_days=4)
  2193	    # ⛔ 正向对照(验伪锚): C3 在新口径下的三种可达面，一条都不能失守
  2194	    mk(inbox / "零字节.md", "", age_days=3)
  2195	    mk(inbox / "无fm骨架.md", "# 只有标题\n\n## 小节\n", age_days=2)
  2196	    mk(inbox / "全空值fm骨架.md", "---\ntitle:\ntags:\n---\n\n# 只有标题\n", age_days=1)
  2197	
  2198	    assert run_cli(vault, out).returncode == 0
  2199	    data = load_json(out)
  2200	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2201	    for name, frag in (
  2202	        ("ISBN来源.md", "978-7-111-54742-6"),
  2203	        ("馆藏号.md", "TP311.13/K92-3"),
  2204	        ("标题即来源.md", "978-7-111-54742-6"),
  2205	        ("别名即馆藏.md", "TP311.13/K92-3"),
  2206	        ("标题即唯一内容.md", "微积分基本定理的两种证法"),
  2207	        ("标题独有重复件.md", "只有这里写了出处"),
  2208	    ):
  2209	        it = item_by_name(data, name)
  2210	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2211	        assert it["criterion"] == "C6_undecided", name
  2212	        assert it["confident"] is False, name
  2213	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2214	        # ⛔ 值必须逐字留痕 —— 拦住了却把线索一起吞掉等于没拦
  2215	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2216	    assert item_by_name(data, "标题独有重复件.md")["exact_duplicate_of"] == "节点/库内正本.md"
  2217	    # ⛔ C3 的三种可达面: 一条都不能失守，否则「少删」就变成了「判据死了」
  2218	    for name in ("零字节.md", "无fm骨架.md", "全空值fm骨架.md"):
  2219	        ctrl = item_by_name(data, name)
  2220	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2221	        assert ctrl["verdict"] == "建议删", name
  2222	        assert ctrl["confident"] is True, name
  2223	
