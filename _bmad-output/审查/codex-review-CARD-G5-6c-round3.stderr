  2020	def validate_label(label: str) -> None:
  2021	    if not label or _BAD_LABEL.search(label):
  2022	        raise SystemExit(
  2023	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
  2024	        )
