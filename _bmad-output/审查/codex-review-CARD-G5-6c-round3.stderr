   745	def skeleton_note(text: str, size: int) -> str:
   746	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   747	
   748	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   749	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   750	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   751	    """
   752	    if size == 0:
   753	        return "0 字节空文件"
   754	    rows = _classify_lines_typed(text)[0]
   755	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   756	    struct = sum(
   757	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   758	    )
   759	    fences = sum(1 for _, k in rows if k == "fence")
   760	    return (
   761	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   762	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   763	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   764	    )
   765	
   766	
   767	def head_window(text: str) -> list[tuple[int, str]]:
   768	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   769	    lines = text.splitlines()
   770	    n = frontmatter_span(lines)
   771	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   772	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   773	        win.append((n + j + 1, ln))
   774	    return win
   775	
   776	
   777	def _norm_ai_line(ln: str) -> str:
   778	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   779	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   780	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   781	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   782	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   783	    return " ".join(ln.split()).casefold()
   784	
   785	
   786	#: 零宽 / 不可见连接类字符：ZWSP、ZWNJ、ZWJ、WORD JOINER、BOM、SOFT HYPHEN。
   787	#: ⛔ 它们**不是** `str.isspace()` 认的空白，所以 `_norm_ai_line` 的 `ln.split()`
   788	#: 折叠不掉（round-2 审查 BLOCKER：`Generated by<U+200B>GPT-4` 穿透）。
   789	#: ⚠️ 替换成**空格**而不是删除：删除会把 `by` 和 `GPT` 粘成 `bygpt`，词边界一样
   790	#: 认不出来；替换成空格才还原出人眼看到的那个词边界。
   791	_ZERO_WIDTH_RE = re.compile(r"[\u200b\u200c\u200d\u2060\ufeff\u00ad]")
   792	
   793	
   794	def _guard_variants(ln: str) -> tuple[str, str]:
   795	    """护栏归一的**两种**零宽还原，都要试。
   796	
   797	    ⛔ round-3 审查 BLOCKER：上一版只做「零宽→空格」，那只对**词间**插入成立
   798	    （`by<ZWSP>GPT` → `by GPT`）。零宽插在**词内部**时（`genera<ZWSP>ted`），
   799	    换空格反而把关键词拆成 `genera ted`，骨架与标记表一起失效 —— 比不处理更糟。
   800	    两种还原互补，没有哪一种单独够用：
   801	      · 换空格：还原词间分隔（`by<ZWSP>GPT` → `by gpt`）；
   802	      · 直接删：还原词内断裂（`genera<ZWSP>ted` → `generated`）。
   803	    调用方对两个变体分别匹配，任一命中即算 —— 护栏宁可宽。
   804	    """
   805	    return (
   806	        _norm_ai_line(_ZERO_WIDTH_RE.sub(" ", ln)),
   807	        _norm_ai_line(_ZERO_WIDTH_RE.sub("", ln)),
   808	    )
   809	
   810	
   811	def _norm_guard_line(ln: str) -> str:
   812	    """**护栏专用**归一：先把零宽字符换成空格，再走 `_norm_ai_line`。
   813	
   814	    ⛔ 刻意与 C2 判据用的 `_norm_ai_line` 分家，不是图省事：C2 命中意味着
   815	    「AI 自述 · 确定归档 · confident=true」，是**有后果的提名**，扩大它的命中面
   816	    必须是明写的决定；护栏只降 C6，宽一点的代价仅是少几条「建议删」。
   817	    两者混用等于让一次护栏加宽顺带扩大确定提名面。
   818	
   819	    ⚠️ **承重面如实声明**（round-2 负控 M-ZEROWIDTH 实测，别高估这一层）：
   820	    回退本函数后套件**一门都不红**，因为 `Generated by<ZWSP>GPT-4` 与
   821	    `本文由<ZWSP>X<ZWSP>生成` 在 `_norm_ai_line` 下**已经**命中骨架 ——
   822	    `_GEN_CLAIM_EN_RE` 的非词字符段会吃掉零宽（Cf 类不算词字符），
   823	    `_GEN_CLAIM_CN_RE` 的非句读字符类同样吃它。一条修法顺手覆盖了另一条。
   824	    本函数真正承重的只有 `raw_ai_marker`：零宽插在标记表项**中间**时
   825	    （`Generated by<ZWSP>AI Lab`、`由<ZWSP>AI<ZWSP>生成`），不剥零宽就匹配不到
   826	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
   827	    ⚠️ 所以它是一层**理由质量**而非安全底线：两种情况下材料都不会被删，
   828	    差别只在 `uncertain_reason` 说的是「疑似 AI 自述」还是「生成断言结构」。
   829	    留着它是因为前者对人更有用；但不要把它写成安全防线。
   830	    """
   831	    return _norm_ai_line(_ZERO_WIDTH_RE.sub(" ", ln))
