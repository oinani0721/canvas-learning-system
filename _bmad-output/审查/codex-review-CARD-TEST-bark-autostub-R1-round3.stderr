   164	def test_probe(tmp_path, monkeypatch, capsys):
   165	    # 本探针自身的最后防线: 无论守卫在不在, 双墙 (DNS + 建连) 恒断网。
   166	    # 两墙都记录 host — 任一被触发都满足「观察到解析尝试」的断言; 即便
   167	    # 未来 urllib 绕过 getaddrinfo 直连, create_connection 墙仍拦住
   168	    resolved_hosts = []
   169	
   170	    def _intercept_getaddrinfo(host, *args, **kwargs):
   171	        resolved_hosts.append(host)
   172	        raise socket.gaierror(-2, "blocked by bark_egress_probe")
   173	
   174	    def _intercept_create_connection(address, *args, **kwargs):
   175	        if isinstance(address, tuple) and address:
   176	            resolved_hosts.append(address[0])
   177	        raise socket.gaierror(-2, "blocked by bark_egress_probe (create_connection)")
   178	
   179	    monkeypatch.setattr(socket, "getaddrinfo", _intercept_getaddrinfo)
   180	    monkeypatch.setattr(socket, "create_connection", _intercept_create_connection)
   181	    # 代理会把首跳解析目标换成代理主机, 断言锚点 api.day.app 就失配 —
   182	    # 且 urllib 在 env 之外还读 macOS 系统代理 (getproxies_macosx_sysconf;
   183	    # 本机实测系统代理在)。env + getproxies + 模块级敌对 opener 三处同禁 =
   184	    # 强制直连形态; 拦截器保证两种形态下都不出网。
   185	    # _opener 必须一并复位: 模块 import 期为 F 门装的敌对 opener 会把首跳
   186	    # 抢走 (A 形态下会记到 127.0.0.1:63128 而不是 api.day.app)。
   187	    for var in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "all_proxy"):
   188	        monkeypatch.delenv(var, raising=False)
   189	    monkeypatch.setattr(runner.send_bark.urllib.request, "getproxies", lambda: {})
   190	    monkeypatch.setattr(urllib.request, "_opener", None)
   191	
   192	    key_file = tmp_path / "bark.key"
   193	    key_file.write_text("probekey-12345678\n", encoding="utf-8")
   194	    monkeypatch.setattr(runner.send_bark, "KEY_FILE", key_file)
   195	    # 单次尝试足以取证 — 免 RETRIES=2 的 2s+4s 重试空等
   196	    monkeypatch.setattr(runner.send_bark, "RETRIES", 0)
   197	    # A 模式 (无守卫) 下 push:failed 会走 osascript 兜底 subprocess 真弹
   198	    # macOS 通知 — 探针自行打桩 (B 模式守卫已桩, 此处覆盖等价)
   199	    monkeypatch.setattr(runner, "osascript_fallback", lambda noti: True)
   200	
   201	    vault = _make_vault(tmp_path)
   202	    monkeypatch.setattr(runner, "VAULT", vault)
   203	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
   204	    # 窗口门放行 (机器时区无关) — 既有 _push_harness 同款; 探针证的是
   205	    # 「send 被调后会不会出网」, 不是窗口语义
   206	    monkeypatch.setattr(runner, "PUSH_WINDOW", (dtime(0, 0), dtime(23, 59, 59)))
   207	    monkeypatch.setattr(sys, "argv", ["daily_review_run.py", "--now", NOW_ARG, "--vault", str(vault)])
   208	
   209	    assert runner.main() == 0
   210	    out = capsys.readouterr().out
   211	    assert any("api.day.app" in str(h) for h in resolved_hosts), (
   212	        f"BARK-GATE-A-RESOLVE: 未观察到对 api.day.app 的解析尝试 (resolved={resolved_hosts!r})"
   213	    )
   214	    assert "push:failed" in out
   215	    _assert_no_real_egress()
   216	
