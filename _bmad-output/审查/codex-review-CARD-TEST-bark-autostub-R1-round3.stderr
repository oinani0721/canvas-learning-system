   181	        "file": CONFTEST,
   182	        "desc": "层⑤d 改用 install_opener 直接装 (布防期内行为一样, 但 teardown 不还原) "
   183	        "— 检验全局还原对账是不是真的能看见进程级污染",
   184	        "old": '            patcher.setattr(urllib.request, "_opener", _safe_opener)',
   185	        "new": "            urllib.request.install_opener(_safe_opener)",
   186	        "gate": "E/armed-reload-selfheal",
   187	        "sentinel": "globals 未还原",
   188	    },
   189	    {
   190	        "id": "M14",
   191	        "file": CONFTEST,
   192	        "desc": "subprocess 移出 reload 名单 — round-2 审查实测 reload(subprocess) 会冲掉层⑥",
   193	        "old": '    "subprocess",\n',
   194	        "new": "",
   195	        "gate": "E/armed-reload-selfheal",
   196	        "sentinel": "BARK-GATE-E-RELOAD-SUBPROCESS",
   197	    },
   198	    {
   199	        "id": "M15",
   200	        "file": CONFTEST,
   201	        "desc": "⑤c 的 proxy settings 存根退回「没有例外」语义 — 重载后 proxy_bypass "
   202	        "会判定不 bypass, 别处握持的 opener 重新走代理 (round-2 审查击穿点)",
   203	        "old": '            return {"exclude_simple": True, "exceptions": ["*"]}',
   204	        "new": '            return {"exclude_simple": False, "exceptions": []}',
   205	        "gate": "R/armed-held-opener-after-prebound-reload",
   206	        "sentinel": "BARK-GATE-R-HELDHOP",
   207	    },
   208	    {
   209	        "id": "M16",
   210	        "file": CONFTEST,
   211	        "desc": "层⑥ 判定退回「argv[0] 的 substring」— 误吞面: 名字里带 osascript 的无关命令被静默吞掉",
   212	        "old": '            return any(os.path.basename(str(x)) == "osascript" for x in argv)',
   213	        "new": '            return "osascript" in str(argv[0])',
   214	        "gate": "H/armed-osascript-prebound-blocked",
   215	        "sentinel": "BARK-GATE-H-DECOY",
   216	    },
   217	    {
   218	        "id": "M17",
   219	        "file": CONFTEST,
   220	        "desc": "层⑥ 判定退回「只看 argv[0]」(basename 全等但不扫整条 argv) — 漏判面: "
   221	        "/usr/bin/env osascript 这种间接形态会抵达真 spawn",
   222	        "old": '            return any(os.path.basename(str(x)) == "osascript" for x in argv)',
   223	        "new": '            return os.path.basename(str(argv[0])) == "osascript"',
   224	        "gate": "H/armed-osascript-prebound-blocked",
   225	        "sentinel": "BARK-GATE-H-INDIRECT",
   226	    },
   227	]
   228	
   229	#: M9 单列: 它变异的是探针而非守卫, 且要双判据对比。
   230	M9 = {
   231	    "id": "M9",
   232	    "file": PROBE,
   233	    "desc": "(e) stdout 伪造绕过 (复刻 round-3 实证形态): 同文件无关失败 + 打印伪造的 traceback 行与 E 行",
   234	    "old": "def test_probe(tmp_path, monkeypatch, capsys):\n",
   235	    "new": (
   236	        "def test_probe(tmp_path, monkeypatch, capsys):\n"
   237	        '    print("  tests/regression/conftest.py:335: in _refuse_egress")\n'
   238	        '    print("E   AssertionError: Bark egress attempted in tests")\n'
   239	        '    assert False, "unrelated failure in probe"\n'
   240	    ),
   241	    "gate": "B/armed-probe-refused",
   242	    "sentinel": "异常首行不符",
   243	}
   244	
   245	_LEGACY_SUMMARY = r"=+\s+(.*?)\s+in\s+[\d.]+s\s*=+$"
   246	_LEGACY_PATTERN = r"^E\s+AssertionError: Bark egress attempted in tests\s*$"
   247	_LEGACY_SRC_HINT = "conftest.py"
   248	
   249	
   250	def _legacy_text_judge(rc: int, out: str) -> bool:
   251	    """第八批 (HEAD 2cacbb0c) 的文本判据, 逐行重写用于对照。
   252	
   253	    摘要唯一性 + 形态 + `^E ...$` 整行锚定 + 「E 行前 1500 字符窗口含
   254	    conftest.py」。它判 True 而 R1 判 FAIL, 就是 (e) 关掉的那条通路。"""
   255	    summaries = [m.group(1) for line in out.splitlines() if (m := re.match(_LEGACY_SUMMARY, line.strip()))]
   256	    shape_ok = (
   257	        len(summaries) == 1
   258	        and re.fullmatch(r"1 failed(, \d+ warnings?)?", summaries[0]) is not None
   259	        and " no tests ran" not in out
   260	        and "= ERRORS =" not in out
   261	    )
   262	    m = re.search(_LEGACY_PATTERN, out, re.MULTILINE)
   263	    regex_ok = m is not None
   264	    src_ok = bool(m) and _LEGACY_SRC_HINT in out[max(0, m.start() - 1500) : m.start()]
   265	    return rc == 1 and shape_ok and regex_ok and src_ok
   266	
   267	
   268	def _apply(mut) -> str:
   269	    path: Path = mut["file"]
   270	    original = path.read_bytes()
   271	    before = sha256(original).hexdigest()
   272	    text = original.decode("utf-8")
   273	    n = text.count(mut["old"])
   274	    if n != 1:
   275	        raise SystemExit(f"[{mut['id']}] 锚点命中 {n} 次 (必须恰好 1) — 锚点漂移, 中止")
   276	    mutated = text.replace(mut["old"], mut["new"])
   277	    for i, (eo, en) in enumerate(mut.get("extras", []), start=2):
   278	        n2 = mutated.count(eo)
   279	        if n2 != 1:
   280	            raise SystemExit(f"[{mut['id']}] 第 {i} 个锚点命中 {n2} 次 (必须恰好 1) — 锚点漂移, 中止")
   281	        mutated = mutated.replace(eo, en)
   282	    _INFLIGHT[path] = original
   283	    path.write_text(mutated, encoding="utf-8")
   284	    return before
   285	
   286	
   287	def _restore(mut, before: str) -> bool:
   288	    path: Path = mut["file"]
   289	    path.write_bytes(_INFLIGHT.pop(path))
   290	    after = sha256(path.read_bytes()).hexdigest()
   291	    same = before == after
   292	    print(f"[{mut['id']}] 还原逐字节一致: {'YES' if same else 'NO!!'} ({after})")
   293	    return same
   294	
   295	
   296	def _run_negctl(gate: str):
   297	    proc = subprocess.run(
   298	        [sys.executable, NEGCTL, "--only", gate],
   299	        cwd=BACKEND,
   300	        capture_output=True,
   301	        text=True,
   302	        timeout=1800,
   303	        env={**_child_env()},
   304	    )
   305	    return proc.returncode, proc.stdout + proc.stderr
   306	
   307	
   308	def _child_env():
   309	    import os
   310	
   311	    env = dict(os.environ)
   312	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   313	    return env
   314	
   315	
   316	def _check(mut) -> bool:
   317	    print(f"\n=== [{mut['id']}] {mut['desc']}")
   318	    print(f"    指定门: {mut['gate']} / 期望 sentinel: {mut['sentinel']}")
   319	    before = _apply(mut)
   320	    try:
   321	        rc, out = _run_negctl(mut["gate"])
   322	        # 元裁判收紧 (round-2 审查 MEDIUM): 「rc!=0 + 输出含 sentinel」会把
   323	        # 「基础设施炸了 + 恰好打印了那串文本」判成「指定门承重」。现在要求
   324	        # rc 恰为 1、负控确实跑完给出总判、且**指定的那道跑**自己判 ok=False。
   325	        gate_line = re.search(r"^\[" + re.escape(mut["gate"]) + r"\].*-> ok=False", out, re.MULTILINE)
   326	        went_red = rc == 1 and "NEGATIVE-CONTROL: FAIL" in out and gate_line is not None
   327	        has_sentinel = mut["sentinel"] in out
   328	        ok = went_red and has_sentinel
   329	        print(f"[{mut['id']}] 指定门变红={went_red} (negctl rc={rc}); sentinel 命中={has_sentinel}")
   330	        if mut["id"] == "M9":
   331	            legacy = _legacy_text_judge(1, out)
   332	            print(f"[{mut['id']}] 第八批文本判据对同一份输出的判定: {legacy} (True = 老判据会放行, 正是 R1 关掉的通路)")
   333	            ok = ok and legacy
   334	        if not ok:
   335	            print(out[-4000:])
   336	    finally:
   337	        restored = _restore(mut, before)
   338	    return ok and restored
   339	
   340	
   341	def main() -> int:
   342	    results = []
   343	    for mut in MUTATIONS + [M9]:
   344	        results.append((mut["id"], _check(mut)))
   345	    print()
   346	    for mid, ok in results:
   347	        print(f"{mid}: {'指定门变红 ✓' if ok else 'NOT-RED ✗'}")
   348	    if all(ok for _, ok in results):
   349	        print(f"MUTATION-NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} 条变异均使指定门变红)")
   350	        return 0
   351	    print("MUTATION-NEGATIVE-CONTROL: FAIL")
   352	    return 1
   353	
   354	
   355	if __name__ == "__main__":
   356	    sys.exit(main())

