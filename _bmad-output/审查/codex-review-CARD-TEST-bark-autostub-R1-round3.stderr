   140	def _assert_no_real_egress():
   141	    """结账: 本条测试期间没有任何真实建连 / 解析 / spawn 抵达过总账层。"""
   142	    assert _REAL_CALLS == {"connect": 0, "resolve": 0, "spawn": 0}, (
   143	        f"BARK-LEDGER-NONZERO: 出现真实出网或 spawn 调用 {_REAL_CALLS!r}"
   144	    )
