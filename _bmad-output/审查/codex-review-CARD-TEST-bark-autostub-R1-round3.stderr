   235	def test_osascript_guarded():
   236	    """D 门 (armed): 守卫层③ osascript_fallback 模块属性打桩的放行门 —
   237	    布防下它必须是守卫的记录桩而非 runner 原始实现。按 __qualname__ 结构性
   238	    断言 (任何测试侧替身都会改 qualname), 不调用函数, 布防/卸甲两形态都零
   239	    副作用 (调真函数 = 卸甲形态下真弹通知, 恰是要避免的事; 预绑定别名那条
   240	    路径由 H 门单独覆盖, 它有自己的 Popen 墙)。"""
   241	    import daily_review_run
   242	
   243	    fn = daily_review_run.osascript_fallback
   244	    assert getattr(fn, "__qualname__", "") != "osascript_fallback", (
   245	        "BARK-GATE-D-OSASCRIPT: 守卫未布防 — osascript_fallback 仍是 runner 原始实现"
   246	    )
