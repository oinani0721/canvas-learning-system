   218	def test_keyfile_guarded():
   219	    """C 门 (armed): 守卫层① KEY_FILE 重定向的放行门 — 布防下
   220	    send_bark.KEY_FILE 必须已被移出真实 key 位置, 且其内容 server 段是
   221	    loopback discard (round-3 M: 八跑此前不锁内容, 守卫回退成外网 server
   222	    时 C 仍绿 — 内容断言把「loopback 纵深」本身钉进门里)。只读守卫自己的
   223	    tmp 假 key, 不触真实 key, 布防/卸甲两形态都零副作用。"""
   224	    import send_bark
   225	
   226	    kf = Path(send_bark.KEY_FILE)
   227	    assert kf != REAL_KEY, "BARK-GATE-C-KEYFILE: 守卫未布防 — send_bark.KEY_FILE 仍指向真实 key 位置"
   228	    content = kf.read_text(encoding="utf-8").strip()
   229	    server = content.rpartition("/")[0]
   230	    assert server == "http://127.0.0.1:9", (
   231	        f"BARK-GATE-C-LOOPBACK: 守卫假 key 的 server 段不是 loopback discard 端口 (实测 {server!r})"
   232	    )
