import _scproxy

def first_hop(opener, url):
    seen = []
    real = socket.getaddrinfo
    def block(host, port, *a, **kw):
        seen.append((host, port))
        raise socket.gaierror(-2, \"audit blocked before network\")
    socket.getaddrinfo = block
    try:
        opener.open(url, timeout=0.1)
    except (urllib.error.URLError, OSError):
        pass
    finally:
        socket.getaddrinfo = real
    assert seen, (url, \"no first hop\")
    return seen[0]

def check_layers(tag):
    assert Path(send_bark.KEY_FILE).parent.name.startswith(\"bark-guard-\")
    assert send_bark._urlopen is urllib.request.urlopen
    assert send_bark._urlopen.__qualname__.endswith(\"_refuse_egress\")
    assert daily_review_run.osascript_fallback.__qualname__.endswith(\"_stub_osascript\")
    assert subprocess.run.__qualname__.endswith(\"_guarded_subprocess_run\")
    assert urllib.request.getproxies() == {}
    assert urllib.request.proxy_bypass(\"198.51.100.99\") is True
    assert importlib.reload.__qualname__.endswith(\"_guarded_reload\")
    assert _scproxy._get_proxies() == {}
    assert _scproxy._get_proxy_settings()[\"exceptions\"] == [\"*\"]
    for k in conf._BARK_PROXY_ENV_VARS:
        assert os.environ.get(k) is None
    return first_hop(urllib.request._opener, \"http://127.0.0.1:9/push\")

observed = {\"initial-global\": check_layers(\"initial\")}
observed[\"fresh\"] = first_hop(urllib.request.build_opener(), \"http://127.0.0.1:9/push\")
for name, pair in held.items():
    observed[name] = first_hop(pair[0], pair[1])
mods = [send_bark, daily_review_run, urllib.request, subprocess, _scproxy, importlib]
for mod in mods:
    importlib.reload(mod)
    observed[\"after-reload:\" + mod.__name__] = check_layers(mod.__name__)
spawn = {\"n\": 0}
real_popen = subprocess.Popen
def wall(*a, **kw):
    spawn[\"n\"] += 1
    raise AssertionError(\"Popen checkpoint reached\")
subprocess.Popen = wall
try:
    alias_result = prebound_osascript({\"title\": \"audit\", \"body\": \"audit\"})
finally:
    subprocess.Popen = real_popen
stale = importlib.reload
send_before = send_bark.send
load_before = send_bark.load_key
try:
    next(gen)
except StopIteration:
    pass
refused = False
try:
    stale(send_bark)
except RuntimeError:
    refused = True
result = {
    \"hops\": observed,
    \"alias_result\": alias_result,
    \"popen_calls\": spawn[\"n\"],
    \"stale_refused\": refused,
    \"send_identity_unchanged\": send_bark.send is send_before,
    \"load_identity_unchanged\": send_bark.load_key is load_before,
}
print(\"AUDIT_CORE\", json.dumps(result, sort_keys=True, default=str))
