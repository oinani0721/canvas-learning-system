import send_bark
prebound_reload(urllib.request)
prebound_reload(send_bark)

def first_hop(open_call):
    seen = []
    real = socket.getaddrinfo
    def block(host, port, *a, **kw):
        seen.append((host, port))
        raise socket.gaierror(-2, \"audit blocked before network\")
    socket.getaddrinfo = block
    try:
        open_call()
    except (urllib.error.URLError, OSError):
        pass
    finally:
        socket.getaddrinfo = real
    assert seen
    return seen[0]

hops = {}
for name, pair in held.items():
    hops[name] = first_hop(lambda p=pair: p[0].open(p[1], timeout=0.1))
hops[\"send_bark_urlopen\"] = first_hop(lambda: send_bark._urlopen(\"http://127.0.0.1:9/push\", timeout=0.1))
state = {
    \"getproxies\": urllib.request.getproxies(),
    \"opener_is_none\": urllib.request._opener is None,
    \"send_urlopen_is_global\": send_bark._urlopen is urllib.request.urlopen,
    \"send_urlopen_qualname\": send_bark._urlopen.__qualname__,
    \"proxy_bypass_qualname\": urllib.request.proxy_bypass.__qualname__,
    \"scproxy_settings\": __import__(\"_scproxy\")._get_proxy_settings(),
    \"hops\": hops,
}
try:
    next(gen)
except StopIteration:
    pass
print(\"AUDIT_PREBOUND\", json.dumps(state, sort_keys=True, default=str))
