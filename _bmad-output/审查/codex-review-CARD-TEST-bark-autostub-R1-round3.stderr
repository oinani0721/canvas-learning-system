   389	def test_osascript_prebound_alias_blocked(monkeypatch):
   390	    """H 门 (armed): collection 期 from-import 预绑定的 osascript_fallback
   391	    别名, 也必须在**副作用之前**被拦 (round-3 MEDIUM 升级为 R1 完成条件 d)。
   392	
   393	    守卫层③ 换的是模块属性, 换不掉 _PREBOUND_OSASCRIPT 这个已绑定对象;
   394	    它执行时仍按模块全局查 subprocess.run —— 层⑥ 就拦在那里。
   395	    探针自装 Popen 墙作最后防线: 卸甲形态下真 subprocess.run 会走到墙,
   396	    抛 AssertionError (osascript_fallback 只吞 OSError/TimeoutExpired,
   397	    AssertionError 必然穿透) → H' 必红, 且两形态都不会真弹通知。"""
   398	
   399	    def _wall(*a, **kw):
   400	        raise AssertionError("BARK-GATE-H-OSASCRIPT-SPAWN: 真 osascript spawn 已抵达 subprocess.Popen")
   401	
   402	    monkeypatch.setattr(subprocess, "Popen", _wall)
   403	    assert _PREBOUND_OSASCRIPT({"title": "bark-gate-h", "body": "bark-gate-h"}) is True, (
   404	        "BARK-GATE-H-RETURN: 预绑定别名未被守卫层⑥ 接管"
   405	    )
   406	
   407	    # 误吞面: basename 不是 osascript 的命令必须原样透传 (会撞上探针的 Popen 墙)。
   408	    # 原来的 substring 判定会把它静默吞成 rc=0, 于是守卫在悄悄改变无关命令的行为。
   409	    # 不用 pytest.raises: 它失败时给的是 "DID NOT RAISE", 消息里没有本门的
   410	    # sentinel, 判据就锚不住红因 (变异 M16 首跑当场暴露)。
   411	    decoy_hit_wall = False
   412	    try:
   413	        subprocess.run(["/tmp/bark-gate-h-not-osascript-helper"])
   414	    except AssertionError:
   415	        decoy_hit_wall = True
   416	    assert decoy_hit_wall, "BARK-GATE-H-DECOY: 名字里带 osascript 的无关命令被层⑥ 误吞 — 判定必须按 basename 全等"
   417	
   418	    # 漏判面: /usr/bin/env osascript ... 这种间接形态也必须被层⑥ 接管
   419	    # (round-2 审查实测原判定只看 argv[0], 这条会抵达真 spawn)。
   420	    try:
   421	        indirect = subprocess.run(["/usr/bin/env", "osascript", "-", "t", "b"], capture_output=True)
   422	    except AssertionError as exc:  # 撞上探针的 Popen 墙 = 层⑥ 漏判了这条形态
   423	        raise AssertionError("BARK-GATE-H-INDIRECT: env osascript 未被守卫层⑥ 接管, 已抵达真 spawn") from exc
   424	    assert indirect.returncode == 0, "BARK-GATE-H-INDIRECT: env osascript 未被守卫层⑥ 接管"
   425	    _assert_no_real_egress()
   426	
   427	
   428	def test_stale_reload_stash():
   429	    """S 门前置: 在布防期内取到当次 importlib.reload 的 wrapper 存进模块级
   430	    信箱; 本条测试 teardown 之后, 它就是一个 stale wrapper。
   431	    卸甲形态下这里存到的是真 importlib.reload —— 正是 S' 要暴露的东西。"""
   432	    _STASHED_RELOAD["fn"] = importlib.reload
   433	    assert callable(_STASHED_RELOAD["fn"])
   434	
   435	
   436	def test_stale_reload_refused_before_reload():
   437	    """S 门 (armed): 上一条留下的 stale wrapper 必须在**执行 reload 之前**
   438	    拒绝 —— 拒绝之后两个生产 sentinel 都不得生效 (round-3 H2: 先 reload
   439	    后 raise 时模块已被重载, 抛异常并不回滚)。
   440	
   441	    卸甲形态下 stale 就是真 reload: 调用直接重新执行模块, 第一条断言即红。
   442	    整条测试不调 send、不读 key 内容, 两形态零外发。
   443	
   444	    ⚠️ 判别器为什么是**模块对象身份**而不是 KEY_FILE/_urlopen 的值:
   445	    本条测试自己也在布防中, 所以「先 reload 后 raise」的错误实现里, reload
   446	    重跑模块顶层拿到的 KEY_FILE 仍是当前守卫的 tmp key、_urlopen 仍是当前
   447	    守卫的拒绝器 —— 两种世界给出**同一个观测**, 值断言在此语境下判不出来
   448	    (R1 变异 M7 首跑当场证伪了值断言版本)。reload 必然重建模块里所有 def
   449	    出来的函数对象, 这一点任何重打桩都掩盖不掉, 所以身份比对才是承重判据;
   450	    KEY_FILE/_urlopen 两条保留为卡文字面的 sentinel 复核, 它们是身份判据的
   451	    推论 (模块没被重新执行 → 生产值不可能被写回)。"""
   452	    import send_bark
   453	
   454	    stale = _STASHED_RELOAD.get("fn")
   455	    assert stale is not None, "BARK-GATE-S-NOSTASH: S 门前置测试未先跑"
   456	    send_before = send_bark.send
   457	    load_key_before = send_bark.load_key
   458	    key_before = send_bark.KEY_FILE
   459	    urlopen_before = send_bark._urlopen
   460	    try:
   461	        stale(send_bark)
   462	        refused = False
   463	    except RuntimeError:
   464	        refused = True
   465	
   466	    assert refused, "BARK-GATE-S-STALE-RELOAD: stale wrapper 未拒绝对受保护模块的 reload"
   467	    assert send_bark.send is send_before and send_bark.load_key is load_key_before, (
   468	        "BARK-GATE-S-MODULE-REEXECUTED: 拒绝之前模块已被重新执行 — reload 已发生, 抛异常并不回滚"
   469	    )
   470	    assert send_bark.KEY_FILE == key_before and Path(send_bark.KEY_FILE) != REAL_KEY, (
   471	        "BARK-GATE-S-KEYFILE-SENTINEL: KEY_FILE 生产 sentinel 已生效"
   472	    )
   473	    assert send_bark._urlopen is urlopen_before, "BARK-GATE-S-URLOPEN-SENTINEL: _urlopen 生产 sentinel 已生效"
   474	
   475	
   476	def test_held_opener_after_prebound_reload(monkeypatch):
   477	    """R 门 (armed): 用预绑定的真 reload 绕开 reload 双保险之后, **别处握持的
   478	    opener** 仍然不得把请求送出本机。
   479	
   480	    这是 round-2 审查击穿的那条链: 依次 _REAL_RELOAD(urllib.request) 与
   481	    _REAL_RELOAD(send_bark) 会把 ②④⑤b⑤d⑤e 一并抹掉 (它们都挂在
   482	    urllib.request 的模块属性上); 此刻还站着的只剩 ⑤a (env, 不随模块重载复原)
   483	    与 ⑤c (_scproxy, 同理)。重载后的真 proxy_bypass 在 env 为空时走 macOS
   484	    分支读 _get_proxy_settings —— 那正是 ⑤c 的存根, 返回「一切主机都绕过代理」,
   485	    于是握持的 opener 直连本机 discard 端口。
   486	
   487	    判据锚机外地址 198.51.100.1:63128: 只有它能区分「留在本机」与「送出机」。
   488	    卸甲形态下 env 代理还在, 第一条断言 (getproxies 恒空) 即红。
   489	    全程 socket 层拦截, 两形态都不真建连。"""
   490	    hops = []
   491	
   492	    def _intercept(address, *a, **kw):
   493	        hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   494	        raise OSError(61, "blocked by bark_egress_probe (post-reload held-opener gate)")
   495	
   496	    monkeypatch.setattr(socket, "create_connection", _intercept)
   497	
   498	    import send_bark
   499	
   500	    _REAL_RELOAD(urllib.request)
   501	    _REAL_RELOAD(send_bark)
   502	
   503	    assert urllib.request.getproxies() == {}, (
   504	        f"BARK-GATE-R-GETPROXIES: 预绑定 reload 之后代理来源复活 ({urllib.request.getproxies()!r})"
   505	    )
   506	    try:
   507	        _HOSTILE_EXTERNAL_OPENER.open("http://127.0.0.1:9/push", timeout=1)
   508	    except urllib.error.URLError:
   509	        pass
   510	
   511	    assert hops, "BARK-GATE-R-NOHOP: 未观察到任何建连尝试"
   512	    assert hops[0] == ("127.0.0.1", 9), (
   513	        f"BARK-GATE-R-HELDHOP: 预绑定 reload 之后握持的 opener 又走了代理 (首跳 {hops[0]!r}, 期望 ('127.0.0.1', 9))"
   514	    )

