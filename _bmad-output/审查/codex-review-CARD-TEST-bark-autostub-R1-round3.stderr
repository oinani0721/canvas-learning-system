   365	def test_proxy_state_neutralized():
   366	    """F2 门 (armed, 状态): 守卫层⑤a/⑤b/⑤c 三处代理来源同时哑火。
   367	
   368	    F 是行为门但只承重 ⑤d; 这三条各自承重一层, 任一层被摘掉本门必红
   369	    (变异负控按层逐条验)。⑤c 分两处断言是因为 darwin 的
   370	    `from _scproxy import _get_proxies` 把补丁点劈成了两个绑定:
   371	    urllib.request 侧管当下, _scproxy 侧管 reload(urllib.request) 之后。"""
   372	    assert not any(os.environ.get(v) for v in ("http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY")), (
   373	        "BARK-GATE-F2-ENVPROXY: 布防期内代理 env 未被清空"
   374	    )
   375	    assert urllib.request.getproxies() == {}, (
   376	        f"BARK-GATE-F2-GETPROXIES: getproxies() 非空 ({urllib.request.getproxies()!r})"
   377	    )
   378	    if sys.platform == "darwin":
   379	        import _scproxy
   380	
   381	        assert _scproxy._get_proxies() == {}, (
   382	            "BARK-GATE-F2-SCPROXY: _scproxy._get_proxies 未中和 — reload(urllib.request) 后代理会复活"
   383	        )
   384	        assert getattr(urllib.request, "_get_proxies", None) is not None and (urllib.request._get_proxies() == {}), (
   385	            "BARK-GATE-F2-URLLIB-GETPROXIES: urllib.request._get_proxies 未中和"
   386	        )
