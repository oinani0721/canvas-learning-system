   249	def test_reload_selfheal():
   250	    """E 门 (armed): reload 双保险 — 对**两个**受保护生产模块各自
   251	    reload 重跑模块顶层 (KEY_FILE/_urlopen / osascript_fallback 被生产值
   252	    重写) 后, 守卫须对两侧都自动重打桩 (round-2 MEDIUM: 只锁 send_bark
   253	    时, 守卫漏 rearm daily_review_run 本门仍绿)。仅 reload 不调 send,
   254	    布防/卸甲两形态都零出网。"""
   255	    import daily_review_run
   256	    import send_bark
   257	
   258	    importlib.reload(send_bark)
   259	    assert Path(send_bark.KEY_FILE) != REAL_KEY, "BARK-GATE-E-RELOAD-KEYFILE: reload 后 KEY_FILE 回到真实 key 位置"
   260	    assert getattr(send_bark._urlopen, "__qualname__", "") != "urlopen", (
   261	        "BARK-GATE-E-RELOAD-URLOPEN: reload 后 _urlopen 回到真实 urlopen"
   262	    )
   263	
   264	    importlib.reload(daily_review_run)
   265	    assert Path(daily_review_run.send_bark.KEY_FILE) != REAL_KEY, (
   266	        "BARK-GATE-E-RELOAD-RUNNER-KEYFILE: reload runner 后 send_bark.KEY_FILE 回到真实 key 位置"
   267	    )
   268	    assert getattr(daily_review_run.osascript_fallback, "__qualname__", "") != "osascript_fallback", (
   269	        "BARK-GATE-E-RELOAD-OSASCRIPT: reload 后 osascript_fallback 回到 runner 原始实现"
   270	    )
   271	
   272	    # round-3 H1 的逃逸链第一步就是 reload(urllib.request) —— 它会把④⑤ 全部
   273	    # 抹掉。属性式调用现在也在双保险名单内, 重打必须覆盖到这两层。
   274	    importlib.reload(urllib.request)
   275	    assert getattr(urllib.request.urlopen, "__qualname__", "") != "urlopen", (
   276	        "BARK-GATE-E-RELOAD-URLLIB-URLOPEN: reload(urllib.request) 后全局 urlopen 未被重打"
   277	    )
   278	
   279	    # round-2 审查抓出的同型第二条: subprocess 也被守卫打了桩 (层⑥), 却不在
   280	    # reload 名单里 —— reload 它就把层⑥ 冲掉, 预绑定的通知别名随即抵达真 spawn。
   281	    importlib.reload(subprocess)
   282	    assert getattr(subprocess.run, "__qualname__", "") != "run", (
   283	        "BARK-GATE-E-RELOAD-SUBPROCESS: reload(subprocess) 后层⑥ 未被重打"
   284	    )
   285	    assert urllib.request.getproxies() == {}, (
   286	        "BARK-GATE-E-RELOAD-URLLIB-PROXY: reload(urllib.request) 后代理中和未被重打"
   287	    )
