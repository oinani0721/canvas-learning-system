   278	def _run_pytest(case, report_path: Path):
   279	    cmd = [
   280	        sys.executable,
   281	        "-m",
   282	        "pytest",
   283	        "-p",
   284	        "no:cacheprovider",
   285	        "-p",
   286	        "bark_negctl_report_plugin",
   287	        *case["extra"],
   288	        *case["nodeids"],
   289	    ]
   290	    env = dict(os.environ)
   291	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   292	    env["BARK_NEGCTL_REPORT"] = str(report_path)
   293	    env["PYTHONPATH"] = os.pathsep.join([str(SCRIPTS)] + ([env["PYTHONPATH"]] if env.get("PYTHONPATH") else []))
   294	    print(f"[{case['label']}] $ {' '.join(cmd)}", flush=True)
   295	    try:
   296	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   297	    except subprocess.TimeoutExpired as e:
   298	        sys.stdout.write(e.stdout if isinstance(e.stdout, str) else "")
   299	        sys.stderr.write(str(e))
   300	        print(f"[{case['label']}] TIMEOUT after 600s")
   301	        return None, None
   302	    sys.stdout.write(proc.stdout)
   303	    sys.stderr.write(proc.stderr)
   304	    return proc.returncode, report_path
   305	
   306	
   307	def _judge_pytest(case) -> bool:
   308	    problems = []
   309	    with tempfile.TemporaryDirectory(prefix="bark-negctl-") as td:
   310	        report_path = Path(td) / "report.json"
   311	        rc, _ = _run_pytest(case, report_path)
   312	        if rc is None:
   313	            return False
   314	        if not report_path.exists():
   315	            print(f"[{case['label']}] MISMATCH: 插件未落报告 (进程可能崩溃) rc={rc}")
   316	            return False
   317	        data = json.loads(report_path.read_text(encoding="utf-8"))
   318	
   319	    if data.get("exitstatus") != rc:
   320	        problems.append(f"进程 rc={rc} 与插件 exitstatus={data.get('exitstatus')} 不一致")
   321	
   322	    # 进程级全局还原对账 (每一跑都查): 守卫在一次测试里可能反复 _reapply,
   323	    # 任何一层没被 MonkeyPatch 正确还原, 桩就会漏进后续测试。
   324	    gb, ga = data.get("globals_before"), data.get("globals_after")
   325	    if case["globals_may_drift"]:
   326	        pass  # 见 CASES 里该跑的注释: 卸甲形态没有守卫可还原, 漂移是预期结果
   327	    elif gb is None or ga is None:
   328	        problems.append("插件未落全局快照 (globals_before/after 缺失)")
   329	    elif gb != ga:
   330	        diff = [
   331	            f"{k}: 布防前 {gb.get(k)!r} → teardown 后 {ga.get(k)!r}"
   332	            for k in sorted(set(gb) | set(ga))
   333	            if gb.get(k) != ga.get(k)
   334	        ]
   335	        problems.append("globals 未还原 (进程级污染): " + "; ".join(diff))
   336	
   337	    calls, other_failed = {}, []
   338	    for rep in data["reports"]:
   339	        if rep["when"] == "call":
   340	            calls[_short(rep["nodeid"])] = rep
   341	        elif rep["outcome"] == "failed":
   342	            other_failed.append(f"{rep['when']}:{rep['nodeid']}")
   343	    if other_failed:
   344	        problems.append(f"非 call 阶段出现失败: {other_failed}")
   345	
   346	    got = {k: v["outcome"] for k, v in calls.items()}
   347	    if got != case["expect"]:
   348	        problems.append(f"outcome 集合不符: 实测 {got} != 期望 {case['expect']}")
   349	
   350	    for name, (want_path, want_msg, is_prefix) in case["crash"].items():
   351	        rep = calls.get(name)
   352	        if rep is None or "crash_path" not in rep:
   353	            problems.append(f"{name}: 无 crash 记录")
   354	            continue
   355	        if os.path.realpath(rep["crash_path"]) != os.path.realpath(want_path):
   356	            problems.append(f"{name}: 异常抛出点文件不符 {rep['crash_path']} != {want_path}")
   357	        first = rep["crash_message"].splitlines()[0]
   358	        ok_msg = first.startswith(want_msg) if is_prefix else first == want_msg
   359	        if not ok_msg:
   360	            problems.append(f"{name}: 异常首行不符\n      实测 {first!r}\n      期望 {want_msg!r}")
   361	
   362	    for name, wanted in case["require_frames"].items():
   363	        rep = calls.get(name)
   364	        # frame 里的 path 是相对 rootdir 的, 先还原成绝对再**路径全等**比对 ——
   365	        # 用 endswith 的话同尾巴的别的模块也能满足 (round-2 审查 LOW)。
   366	        chain = {os.path.realpath(os.path.join(BACKEND, f["path"])) for f in (rep or {}).get("frames", [])}
   367	        for want in wanted:
   368	            if os.path.realpath(want) not in chain:
   369	                problems.append(f"{name}: frame 链缺少 {want} (实测 {sorted(chain)})")
   370	
   371	    ok = not problems
   372	    print(f"[{case['label']}] expect {case['expect']} -> ok={ok} rc={rc}")
   373	    for p in problems:
   374	        print(f"    ✗ {p}")
   375	    return ok
   376	
   377	
   378	def _judge_residue() -> bool:
   379	    cmd = [sys.executable, G_SCRIPT]
   380	    env = dict(os.environ)
   381	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   382	    print(f"[{G_LABEL}] $ {' '.join(cmd)}", flush=True)
   383	    try:
   384	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600, env=env)
   385	    except subprocess.TimeoutExpired as e:
   386	        sys.stderr.write(str(e))
   387	        print(f"[{G_LABEL}] TIMEOUT after 600s")
   388	        return False
   389	    sys.stdout.write(proc.stdout)
   390	    sys.stderr.write(proc.stderr)
   391	    lines = [ln for ln in proc.stdout.splitlines() if ln.startswith("BARK-KEYFILE-RESIDUE:")]
   392	    ok = proc.returncode == 0 and len(lines) == 1 and lines[0].startswith(G_OK_PREFIX)
   393	    print(f"[{G_LABEL}] expect OK -> ok={ok} rc={proc.returncode} lines={lines}")
   394	    return ok
   395	
   396	
   397	def main() -> int:
   398	    ap = argparse.ArgumentParser(description="Bark 外发守卫负控裁判 (二十二跑)")
   399	    ap.add_argument("--only", help="逗号分隔的跑标签, 只跑这些 (变异负控用)")
   400	    args = ap.parse_args()
   401	
   402	    wanted = None
   403	    if args.only:
   404	        wanted = [w.strip() for w in args.only.split(",") if w.strip()]
   405	        unknown = [w for w in wanted if w not in ALL_LABELS]
   406	        if unknown:
   407	            print(f"未知跑标签 {unknown}; 可用: {ALL_LABELS}")
   408	            return 2
   409	
   410	    results = []
   411	    for case in CASES:
   412	        if wanted is not None and case["label"] not in wanted:
   413	            continue
   414	        results.append((case["label"], _judge_pytest(case)))
   415	    if wanted is None or G_LABEL in wanted:
   416	        results.append((G_LABEL, _judge_residue()))
   417	
   418	    print()
   419	    for label, ok in results:
   420	        print(f"{label}: {'ok' if ok else 'MISMATCH'}")
   421	    if results and all(ok for _, ok in results):
   422	        print(f"NEGATIVE-CONTROL: PASS ({len(results)}/{len(results)} runs as expected)")
   423	        return 0
   424	    print("NEGATIVE-CONTROL: FAIL")
   425	    return 1
   426	
   427	
   428	if __name__ == "__main__":
   429	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	"""负控裁判的结构化报告插件 (CARD-TEST-bark-autostub-R1 完成条件 (e))。
     3	
     4	**为什么不看 stdout**: pytest 的 stdout 里那行 `E   AssertionError: ...`
     5	是被测进程自己的输出流, 被测代码可以逐字打印同一行。round-3 实证过这条
     6	绕过: 「同一探针文件里制造一个无关失败 + captured stdout 打印目标 E 行 +
     7	唯一摘要」就骗过了「E 行正则 + 前 1500 字符窗口找文件名子串」的文本判据;
     8	连 `not_conftest.py` 也因为包含子串 `conftest.py` 而满足来源检查。
     9	
    10	本插件改从 pytest 自己的 TestReport 取证并落 JSON:
    11	  - crash_path / crash_lineno — longrepr.reprcrash, 即**异常抛出点所在
    12	    frame** 的文件与行号, 由解释器 traceback 决定, 被测代码 print 不出来;
    13	  - crash_message           — 异常对象自身的首行 (不是 stdout 的一行文本);
    14	  - frames                  — 完整 traceback frame 链的文件/行号。
    15	
    16	另落一份**进程级全局还原对账**: 在 collection 结束 (模块都 import 完、
    17	一条测试都还没跑) 与 sessionfinish (所有 fixture 都 teardown 完) 各取一次
    18	守卫会碰的全局快照 —— urlopen / getproxies / _opener / subprocess.run /
    19	importlib.reload / _scproxy._get_proxies / 代理 env。
    20	
    21	**为什么不含 sys.path**: `sys.path[0]` 不是守卫拥有的全局 —— 生产代码
    22	(daily_review_run 会把 vault 的 .claude/scripts 插到 0 位) 与 pytest 自己都会
    23	动它, 纳进来会产生与守卫无关的红 (R1 首跑二十跑里十八跑因此误红)。判据要
    24	恰好覆盖被测对象拥有的状态; 守卫对 sys.path 的边界由 bark_unguarded_probe
    25	的 U 门直接断言。
    26	守卫在一次测试里可能反复 _reapply (每次 reload 都重打), 若 MonkeyPatch 的
    27	undo 顺序或某一层的还原方式出问题, 桩就会漏到后续测试里去 —— 这份对账
    28	是唯一能在进程外看见那件事的判据 (裁判在 negative_control 侧比对)。
    29	裁判据此做**路径全等**比对 (不是子串), 于是 not_conftest.py 这类同尾巴
    30	文件名不再蒙混。
    31	
    32	用法 (由 bark_autostub_negative_control.py 装配):
    33	    PYTHONPATH=<backend/scripts>  BARK_NEGCTL_REPORT=<out.json>
    34	    pytest -p bark_negctl_report_plugin ...
    35	`--noconftest` 不影响 `-p` 插件加载 —— 卸甲形态同样有结构化取证。
    36	
    37	如实边界: 本插件信任 pytest 自己的报告结构。能改写 pytest 内部报告对象的
    38	被测代码 (例如自装 hook 覆盖 pytest_runtest_logreport) 依然能造假; 那属于
    39	「测试进程内故意自解脱绑」, 与守卫的威胁模型同级, 不在本门承诺内。
    40	"""
    41	
    42	import json
    43	import os
    44	import subprocess
    45	import sys
    46	import urllib.request
    47	
    48	_RECORDS = []
    49	_GLOBALS = {}
    50	
    51	#: 守卫会碰的进程级全局 —— 用于「布防前 vs 全部 teardown 后」的还原对账。
    52	#: 只用 __module__/__qualname__ 与代理配置这类**结构指纹**, 不用 id():
    53	#: 对象回收后 id 可能被复用, 拿它当相等判据是自证 (看起来还原了)。
    54	_PROXY_ENV_KEYS = (
    55	    "http_proxy",
    56	    "https_proxy",
    57	    "ftp_proxy",
    58	    "all_proxy",
    59	    "no_proxy",
    60	    "HTTP_PROXY",
    61	    "HTTPS_PROXY",
    62	    "FTP_PROXY",
    63	    "ALL_PROXY",
    64	    "NO_PROXY",
    65	    "BARK_KEY_FILE",
    66	)
    67	
    68	
    69	def _fn_id(fn):
    70	    return f"{getattr(fn, '__module__', '?')}.{getattr(fn, '__qualname__', repr(fn))}"
    71	
    72	
    73	def _opener_fingerprint():
    74	    op = urllib.request._opener
    75	    if op is None:
    76	        return None
    77	    return {
    78	        "handlers": sorted(h.__class__.__name__ for h in op.handlers),
    79	        "proxies": [getattr(h, "proxies", None) for h in op.handlers if h.__class__.__name__ == "ProxyHandler"],
    80	        "addheaders": sorted(map(str, getattr(op, "addheaders", []))),
    81	    }
    82	
    83	
    84	def _module_attr_fingerprint(tracked):
    85	    """守卫直接改过的**模块属性**。只看 collection 期就已加载的模块 ——
    86	    冷启动 (守卫自己那次 import) 让模块从无到有是预期行为, 不是污染;
    87	    那一面由 bark_keyfile_residue_check.py 单独把关。"""
    88	    out = {}
    89	    for name, attrs in (("send_bark", ("KEY_FILE", "_urlopen")), ("daily_review_run", ("osascript_fallback",))):
    90	        if name not in tracked:
    91	            continue
    92	        mod = sys.modules.get(name)
    93	        out[name] = None if mod is None else {a: _fn_id(getattr(mod, a, None)) for a in attrs}
    94	    return out
    95	
    96	
    97	def _globals_snapshot(tracked=()):
    98	    import importlib
    99	
   100	    snap = {
   101	        "module_attrs": _module_attr_fingerprint(tracked),
   102	        "opener": _opener_fingerprint(),
   103	        "urlopen": _fn_id(urllib.request.urlopen),
   104	        "getproxies": _fn_id(urllib.request.getproxies),
   105	        "proxy_bypass": _fn_id(urllib.request.proxy_bypass),
   106	        "subprocess_run": _fn_id(subprocess.run),
   107	        "importlib_reload": _fn_id(importlib.reload),
   108	        "env": {k: os.environ.get(k) for k in _PROXY_ENV_KEYS},
   109	    }
   110	    if sys.platform == "darwin":
   111	        try:
   112	            import _scproxy
   113	
   114	            snap["scproxy_get_proxies"] = _fn_id(_scproxy._get_proxies)
   115	            snap["scproxy_get_proxy_settings"] = _fn_id(_scproxy._get_proxy_settings)
   116	        except ImportError:
   117	            pass
   118	    if hasattr(urllib.request, "_get_proxies"):
   119	        snap["urllib_get_proxies"] = _fn_id(urllib.request._get_proxies)
   120	    if hasattr(urllib.request, "_get_proxy_settings"):
   121	        snap["urllib_get_proxy_settings"] = _fn_id(urllib.request._get_proxy_settings)
   122	    return snap
   123	
   124	
   125	def pytest_collection_finish(session):
   126	    """基线取在「所有测试模块都已 import、但一条测试都还没跑」的时刻 ——
   127	    探针模块自己的 import 期副作用 (敌对代理态) 已经在里面, 于是这条对账
   128	    问的正是「守卫把它动过的东西还回去了没有」, 而不是「进程有没有被改过」。"""
   129	    _GLOBALS["tracked"] = tuple(m for m in ("send_bark", "daily_review_run") if m in sys.modules)
   130	    _GLOBALS["before"] = _globals_snapshot(_GLOBALS["tracked"])
   131	
   132	
   133	def _fileloc(entry):
   134	    loc = getattr(entry, "reprfileloc", None)
   135	    if loc is None:
   136	        return None
   137	    return {"path": loc.path, "lineno": loc.lineno}
   138	
   139	
   140	def pytest_runtest_logreport(report):
   141	    rec = {
   142	        "nodeid": report.nodeid,
   143	        "when": report.when,
   144	        "outcome": report.outcome,
   145	    }
   146	    longrepr = getattr(report, "longrepr", None)
   147	    crash = getattr(longrepr, "reprcrash", None)
   148	    if crash is not None:
   149	        rec["crash_path"] = crash.path
   150	        rec["crash_lineno"] = crash.lineno
   151	        rec["crash_message"] = crash.message
   152	    tb = getattr(longrepr, "reprtraceback", None)
   153	    if tb is not None:
   154	        rec["frames"] = [f for f in (_fileloc(e) for e in getattr(tb, "reprentries", [])) if f]
   155	    _RECORDS.append(rec)
   156	
   157	
   158	def pytest_collectreport(report):
   159	    if report.outcome == "failed":
   160	        _RECORDS.append({"nodeid": report.nodeid, "when": "collect", "outcome": "failed"})
   161	
   162	
   163	def pytest_sessionfinish(session, exitstatus):
   164	    out = os.environ.get("BARK_NEGCTL_REPORT")
   165	    if not out:
   166	        return
   167	    with open(out, "w", encoding="utf-8") as fh:
   168	        json.dump(
   169	            {
   170	                "exitstatus": int(exitstatus),
   171	                "reports": _RECORDS,
   172	                "globals_before": _GLOBALS.get("before"),
   173	                "globals_after": _globals_snapshot(_GLOBALS.get("tracked", ())),
   174	            },
   175	            fh,
   176	            ensure_ascii=False,
   177	            indent=1,
   178	        )

