   290	def test_proxy_first_hop_stays_loopback(monkeypatch):
   291	    """F 门 (armed, 行为): 模块 import 期就已存在的敌对「已建 opener」
   292	    (ProxyHandler 指向 127.0.0.1:63128) 不得把 loopback 请求转出机 ——
   293	    首跳必须是 loopback discard 端口本身。
   294	
   295	    这是 (b) 的行为门: 判据锚 (host, port) 二元组而不是只锚 host ——
   296	    本机系统代理实测就是 127.0.0.1:1082, 与兜底目标同主机不同端口, 只比
   297	    host 会两形态同值 = 假门。
   298	    建连在 socket.create_connection 层被拦并抛 OSError, 布防/卸甲两形态
   299	    都不会真建连、不出机 (63128 也不监听)。
   300	    三段各自承重不同的层: 第一段 (模块全局 _opener) 承重 ⑤d, 第二段 (现场
   301	    新建 opener) 承重 ⑤a/⑤b/⑤c, 第三段 (别处握持的 opener 对象) 承重 ⑤e
   302	    —— 变异任一层, 本门都会红在对应那一段。"""
   303	    hops = []
   304	
   305	    def _intercept(address, *a, **kw):
   306	        hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   307	        raise OSError(61, "blocked by bark_egress_probe (first-hop gate)")
   308	
   309	    monkeypatch.setattr(socket, "create_connection", _intercept)
   310	    opener = urllib.request._opener
   311	    assert opener is not None, "BARK-GATE-F-NOOPENER: _opener 为空, 前置态未建立"
   312	    try:
   313	        opener.open("http://127.0.0.1:9/push", timeout=1)
   314	    except urllib.error.URLError:
   315	        pass
   316	
   317	    assert hops, "BARK-GATE-F-NOHOP: 未观察到任何建连尝试"
   318	    assert hops[0] == ("127.0.0.1", 9), (
   319	        f"BARK-GATE-F-FIRSTHOP: 代理首跳未被中和 (首跳 {hops[0]!r}, 期望 ('127.0.0.1', 9))"
   320	    )
   321	
   322	    # 第二段: 现场新建的 opener —— 这是 `_opener is None` 时 urlopen 走的路
   323	    # (reload(urllib.request) 之后就是这个状态)。build_opener() 会在此刻读
   324	    # getproxies(), 于是这段behaviorally 覆盖的是「系统/环境代理」向量,
   325	    # 与上面「已建 opener」向量互补, 合起来才是完成条件 (b) 的两条。
   326	    fresh_hops = []
   327	
   328	    def _intercept_fresh(address, *a, **kw):
   329	        fresh_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   330	        raise OSError(61, "blocked by bark_egress_probe (fresh-opener gate)")
   331	
   332	    monkeypatch.setattr(socket, "create_connection", _intercept_fresh)
   333	    try:
   334	        urllib.request.build_opener().open("http://127.0.0.1:9/push", timeout=1)
   335	    except urllib.error.URLError:
   336	        pass
   337	
   338	    assert fresh_hops, "BARK-GATE-F-NOFRESHHOP: 新建 opener 未观察到任何建连尝试"
   339	    assert fresh_hops[0] == ("127.0.0.1", 9), (
   340	        f"BARK-GATE-F-FRESHHOP: 新建 opener 的首跳被代理接管 (首跳 {fresh_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   341	    )
   342	
   343	    # 第三段: 直接握着的 opener 对象 —— 不经 urllib.request._opener 这个模块
   344	    # 全局, 所以 ⑤d 换引用对它无效; 承重的是 ⑤e (proxy_bypass 恒 True)。
   345	    # R1 round-1 审查正是用这条路径击穿了只有 ⑤d 的版本。
   346	    held_hops = []
   347	
   348	    def _intercept_held(address, *a, **kw):
   349	        held_hops.append(tuple(address[:2]) if isinstance(address, tuple) else (str(address), None))
   350	        raise OSError(61, "blocked by bark_egress_probe (held-opener gate)")
   351	
   352	    monkeypatch.setattr(socket, "create_connection", _intercept_held)
   353	    try:
   354	        _HOSTILE_OPENER.open("http://127.0.0.1:9/push", timeout=1)
   355	    except urllib.error.URLError:
   356	        pass
   357	
   358	    assert held_hops, "BARK-GATE-F-NOHELDHOP: 握持 opener 未观察到任何建连尝试"
   359	    assert held_hops[0] == ("127.0.0.1", 9), (
   360	        f"BARK-GATE-F-HELDHOP: 别处握持的 opener 首跳被代理接管 (首跳 {held_hops[0]!r}, 期望 ('127.0.0.1', 9))"
   361	    )
   362	    _assert_no_real_egress()
   363	
