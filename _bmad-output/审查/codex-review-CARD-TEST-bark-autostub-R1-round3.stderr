import importlib.util
import json
import os
import socket
import types
import urllib.error
import urllib.parse
import urllib.request
spec = importlib.util.spec_from_file_location(\"audit_conftest\", \"tests/regression/conftest.py\")
conf = importlib.util.module_from_spec(spec)
spec.loader.exec_module(conf)
for key in list(os.environ):
    if key.lower() in {\"http_proxy\", \"https_proxy\", \"ftp_proxy\", \"all_proxy\", \"no_proxy\"}:
        os.environ.pop(key, None)
system_opener = urllib.request.build_opener()
proxy_entries = []
for h in system_opener.handlers:
    if isinstance(h, urllib.request.ProxyHandler):
        for scheme, value in h.proxies.items():
            p = urllib.parse.urlsplit(value)
            proxy_entries.append({\"scheme\": scheme, \"host\": p.hostname, \"port\": p.port, \"has_auth\": p.username is not None or p.password is not None})
req = types.SimpleNamespace(module=types.SimpleNamespace(__name__=\"test_daily_review_system_proxy\"))
gen = conf._bark_egress_guard.__wrapped__(req)
next(gen)
seen = []
real = socket.getaddrinfo
def block(host, port, *a, **kw):
    seen.append((host, port))
    raise socket.gaierror(-2, \"audit blocked\")
socket.getaddrinfo = block
try:
    system_opener.open(\"http://127.0.0.1:9/push\", timeout=0.1)
except (urllib.error.URLError, OSError):
    pass
finally:
    socket.getaddrinfo = real
try:
    next(gen)
except StopIteration:
    pass
print(\"AUDIT_SYSTEM_PROXY\", json.dumps({\"pre_guard_proxy_entries\": proxy_entries, \"first_hop\": seen[0] if seen else None}, sort_keys=True, default=str))
