   147	def _make_vault(tmp_path: Path) -> Path:
   148	    """test_daily_review_run._vault 同款最小 vault: 一张即刻到期节点卡,
   149	    保证 payload 带 notification (否则 push:skip-empty, send 根本不被调,
   150	    探针在 A/B 两种形态下都空转)。live vault 只读 (只 copy decay_beta.py)。"""
   151	    vault = tmp_path / "vault"
   152	    scripts = vault / ".claude" / "scripts"
   153	    scripts.mkdir(parents=True)
   154	    (vault / "节点").mkdir()
   155	    decay = WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py"
   156	    (scripts / "decay_beta.py").write_bytes(decay.read_bytes())
   157	    (vault / "节点" / "甲.md").write_text(
   158	        '---\ntype: concept\nsource_board: "[[原白板/普通板]]"\n---\n真实内容。\n',
   159	        encoding="utf-8",
   160	    )
   161	    return vault
   162	
