   252	# ── Codex MEDIUM: plist 12 档 (Hour,Minute) 契约整体锁定 (Hour 计数太弱) ──
   253	
   254	
   255	def test_plist_hourly_slots_inside_push_window():
   256	    with open(WT / "scripts" / "launchd" / "com.canvas.daily-review.plist", "rb") as f:
   257	        plist = plistlib.load(f)
   258	    slots = plist["StartCalendarInterval"]
   259	    assert slots == [{"Hour": h, "Minute": 5} for h in range(9, 21)]  # 9:05–20:05 共 12 档
   260	    lo, hi = runner.PUSH_WINDOW
   261	    for s in slots:
   262	        assert lo <= dtime(s["Hour"], s["Minute"]) < hi  # 全部落在推送窗内
