   690	# ── CARD-D2b (BATCH-2026-08-27-Anki化与诚实收尾): 休息日反转推送 (方案甲) ──
   691	# 实测缺陷链: 09:06 休息推送 accepted → 14:06 due_crossed 重扫, payload/总览
   692	# 页已更新, 但 last_push_accepted_date==today 门拦推送 (skip-done) → 手机
   693	# 整天停留「今日无到期」。方案甲: 仅放行 rest→due 语义反转一次 (同 id 服务
   694	# 端覆盖 = A4 既有契约, 通知中心不堆叠); state 持久化成立时每天推送上界
   695	# = 2 (rest + due; accepted 后崩溃窗/损坏重建残余 = A4/A7 既有语义, 入档)。
   696	
   697	
   698	def _push_harness(monkeypatch, tmp_path, vault, rcs):
   699	    """main() 端到端打桩: 窗口门放行 (机器时区无关), send 按 rcs 队列返回并
   700	    截获 (id, title) — 多余的 send 调用会越界报错 (兼当哨兵), osascript
   701	    兜底打桩防真弹通知。"""
   702	    _patch_runner(monkeypatch, vault, tmp_path)
   703	    monkeypatch.setattr(runner, "PUSH_WINDOW", (dtime(0, 0), dtime(23, 59, 59)))
   704	    calls = []
   705	
   706	    def _send(noti, vault_id=None):
   707	        calls.append((noti["id"], noti["title"]))
   708	        return rcs[len(calls) - 1]
   709	
   710	    monkeypatch.setattr(runner.send_bark, "send", _send)
   711	    monkeypatch.setattr(runner, "osascript_fallback", lambda noti: True)
   712	    return calls
   713	
   714	
   715	def _run_main(monkeypatch, capsys, vault, now_arg) -> str:
   716	    monkeypatch.setattr(sys, "argv", ["daily_review_run.py", "--now", now_arg, "--vault", str(vault)])
   717	    assert runner.main() == 0
   718	    return capsys.readouterr().out
