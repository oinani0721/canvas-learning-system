   147	class RegressionMetricsCollector:
   148	    """Collects per-scenario metrics during a regression test run."""
   149	
   150	    def __init__(self):
   151	        self.results: List[Dict[str, Any]] = list()
   152	
   153	    def record(
   154	        self,
   155	        scenario_id: str,
   156	        prompt_name: str,
   157	        prompt_version: int,
   158	        metrics: Dict[str, Any],
   159	        passed: bool,
   160	        details: str = "",
   161	    ):
   162	        self.results.append(
   163	            {
   164	                "scenario_id": scenario_id,
   165	                "prompt_name": prompt_name,
   166	                "prompt_version": prompt_version,
   167	                "metrics": metrics,
   168	                "passed": passed,
   169	                "details": details,
   170	            }
   171	        )
   172	
   173	    def summary(self) -> Dict[str, Any]:
   174	        total = len(self.results)
   175	        passed_count = sum(1 for r in self.results if r["passed"])
   176	        failed_count = total - passed_count
   177	        pass_rate = (passed_count / total * 100) if total > 0 else 0.0
   178	        return {
   179	            "total_scenarios": total,
   180	            "passed": passed_count,
   181	            "failed": failed_count,
   182	            "pass_rate": pass_rate,
   183	            "results": self.results,
   184	        }
   185	
   186	
   187	@pytest.fixture
   188	def regression_metrics() -> RegressionMetricsCollector:
   189	    """Per-test metrics collector for regression report generation."""
   190	    return RegressionMetricsCollector()
