    56	def test_probe(tmp_path, monkeypatch, capsys):
    57	    # 本探针自身的最后防线: 无论守卫在不在, 双墙 (DNS + 建连) 恒断网。
    58	    # 两墙都记录 host — 任一被触发都满足「观察到解析尝试」的断言; 即便
    59	    # 未来 urllib 绕过 getaddrinfo 直连, create_connection 墙仍拦住
    60	    resolved_hosts = []
    61	
    62	    def _intercept_getaddrinfo(host, *args, **kwargs):
    63	        resolved_hosts.append(host)
    64	        raise socket.gaierror(-2, "blocked by bark_egress_probe")
    65	
    66	    def _intercept_create_connection(address, *args, **kwargs):
    67	        if isinstance(address, tuple) and address:
    68	            resolved_hosts.append(address[0])
    69	        raise socket.gaierror(-2, "blocked by bark_egress_probe (create_connection)")
    70	
    71	    monkeypatch.setattr(socket, "getaddrinfo", _intercept_getaddrinfo)
    72	    monkeypatch.setattr(socket, "create_connection", _intercept_create_connection)
    73	    # 代理会把首跳解析目标换成代理主机, 断言锚点 api.day.app 就失配 —
    74	    # 且 urllib 在 env 之外还读 macOS 系统代理 (getproxies_macosx_sysconf;
    75	    # 本机实测系统代理在, A 模式首跳解析记到 127.0.0.1)。env + getproxies
    76	    # 双禁 = 尽力消除代理首跳 (已建 opener 的缓存形态拦不住, 如实边界 —
    77	    # 上面双墙恒兜底); 拦截器保证两种形态下都不出网
    78	    for var in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "all_proxy"):
    79	        monkeypatch.delenv(var, raising=False)
    80	    monkeypatch.setattr(runner.send_bark.urllib.request, "getproxies", lambda: {})
