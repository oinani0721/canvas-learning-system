   362	def test_empty_vault_first_scan_then_new_node_gets_credit(tmp_path, monkeypatch):
   363	    """纯空形态: 空 vault 首扫 (无通知) 不落账; 同日新增真板节点后重扫,
   364	    该榜首必须落账 — 不得因「今天已首扫过」而整天欠账。"""
