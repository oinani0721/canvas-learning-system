   152	def test_infile_update_alone_triggers_rescan(tmp_path, monkeypatch):
   153	    """只有文件 mtime 变、目录 mtime 钉旧 (APFS 原地更新 fsrs_due 的
   154	    真实形态 — quiz 写侧头号生产场景) 也必须失效缓存。"""
   155	    vault = _vault(tmp_path, {"甲": _node()})
   156	    _patch_runner(monkeypatch, vault, tmp_path)
   157	    st = runner.load_state()
   158	    _, gen1 = runner.ensure_payload(st, NOW, TODAY)
   159	    assert gen1 == "new"
   160	
   161	    _pin_pool_older_than_payload(vault, BASE)
   162	    _set_mtime(vault / "节点" / "甲.md", BASE + 200)  # 只 bump 文件, 目录不动
   163	
   164	    _, gen2 = runner.ensure_payload(st, NOW, TODAY)
   165	    assert gen2 == "new", "原地更新节点内容 (目录 mtime 不变) 必须触发重扫"
