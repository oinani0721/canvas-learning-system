   289	# ── CARD-D2a (BATCH-2026-08-27-Anki化与诚实收尾): 空首扫日轮转账修复 ──
   290	# 实测缺陷链: 首扫为空 (休息日/纯空 vault) 时 first_gen_today 已被消耗,
   291	# 同日重扫出的第一个非空榜首永远不落账 → board_last_recommended 全程 {},
   292	# tie-break 第 2 键把空串当「从未推荐」排最前 → 启动期并列时同板霸榜。
   293	
   294	
   295	def test_rest_day_first_nonempty_top_gets_credit(tmp_path, monkeypatch):
   296	    """休息日形态: 首扫全员未来到期 (榜空) 不落账; 时间跨过到期点后重扫出的
   297	    当天第一个非空榜首必须落账; 同日再重扫换榜不得二次落账 (每天只一次)。"""
   298	    due_extra = "fsrs_due: 2026-07-30T02:30:00Z\n"
   299	    vault = _vault(tmp_path, {"重学卡": _node(board="A板", extra=due_extra)})
   300	    _patch_runner(monkeypatch, vault, tmp_path)
   301	    st = runner.load_state()
   302	
   303	    # 02:00 首扫: 卡 02:30 才到期 → 榜空 (休息日形态), 不落账
   304	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
   305	    assert gen1 == "new" and payload1["top_boards"] == []
   306	    assert st["board_last_recommended"] == {}
   307	
   308	    # 03:05 跨过到期点重扫: 当天第一个非空榜首 → 必须落账
   309	    _pin_pool_older_than_payload(vault, BASE)
   310	    later = datetime(2026, 7, 30, 3, 5, tzinfo=timezone.utc)
   311	    payload2, gen2 = runner.ensure_payload(st, later, TODAY)
   312	    assert gen2 == "new"
   313	    assert payload2["top_boards"][0]["board"] == "A板"
   314	    assert st["board_last_recommended"] == {"A板": TODAY}, (
   315	        "空首扫日的第一个非空榜首必须获得轮转账, 否则 tie-break 永远视其从未推荐"
   316	    )
   317	    # Codex-D2a L1: 落账必须已随 save_state 落盘 (跨进程持久化), 第三段
   318	    # 从磁盘重载 state 继续 — 「赋值挪到 save 之后」类回归在此现形
   319	    on_disk = json.loads(runner.state_path().read_text(encoding="utf-8"))
   320	    assert on_disk["board_last_recommended"] == {"A板": TODAY}
   321	    assert on_disk["last_recommend_credit_date"] == TODAY
   322	    st = runner.load_state()
   323	
   324	    # 同日再重扫: 同形 B板 节点 (pick 相同) 靠 tie-break 登顶, 也不得补账
   325	    (vault / "节点" / "b乙.md").write_text(_node(board="B板", extra=due_extra), encoding="utf-8")
   326	    _pin_pool_older_than_payload(vault, BASE)
   327	    _set_mtime(vault / "节点" / "b乙.md", BASE + 200)
   328	    _set_mtime(vault / "节点", BASE + 200)
   329	    payload3, gen3 = runner.ensure_payload(st, later, TODAY)
   330	    assert gen3 == "new"
   331	    assert payload3["top_boards"][0]["board"] == "B板"
   332	    assert st["board_last_recommended"] == {"A板": TODAY}, "当日已落账后, 重扫换榜不得把第二个板标成「今天推荐过」"
   333	
