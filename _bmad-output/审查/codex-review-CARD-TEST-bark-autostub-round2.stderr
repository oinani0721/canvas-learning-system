   168	def test_deletion_via_dir_mtime_triggers_rescan(tmp_path, monkeypatch):
   169	    """删除节点不留文件 mtime、只改目录 mtime, 也必须失效缓存,
   170	    且被删节点从投影消失 (否则被删节点整天霸占推荐)。"""
