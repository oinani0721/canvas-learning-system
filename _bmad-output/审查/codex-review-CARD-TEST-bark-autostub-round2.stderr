    20	from pathlib import Path
    21	
    22	WT = Path(__file__).resolve().parents[3]
    23	sys.path.insert(0, str(WT / "scripts"))
    24	
    25	import daily_review_run as runner  # noqa: E402
    26	
    27	NOW = datetime(2026, 7, 30, 2, 0, tzinfo=timezone.utc)
    28	TODAY = "2026-07-30"
    29	BASE = 1_700_000_000  # 人工 mtime 基准: 只比大小, 绝对值无意义
