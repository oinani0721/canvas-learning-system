   265	# ── tie-break 守卫: 当天已落账后, 重扫不补写 board_last_recommended ──
   266	
   267	
   268	def test_rescan_does_not_touch_board_last_recommended(tmp_path, monkeypatch):
   269	    vault = _vault(tmp_path, {"a甲": _node(board="A板")})
   270	    _patch_runner(monkeypatch, vault, tmp_path)
   271	    st = runner.load_state()
   272	    _, gen1 = runner.ensure_payload(st, NOW, TODAY)
   273	    assert gen1 == "new"
   274	    assert st["board_last_recommended"] == {"A板": TODAY}
   275	
   276	    # 新增 B 板节点后重扫: 同分 tie-break 下 B 板 (从未被推荐) 会登顶
   277	    (vault / "节点" / "b乙.md").write_text(_node(board="B板"), encoding="utf-8")
   278	    _pin_pool_older_than_payload(vault, BASE)
   279	    _set_mtime(vault / "节点" / "b乙.md", BASE + 200)
   280	    _set_mtime(vault / "节点", BASE + 200)
   281	
   282	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
   283	    assert gen2 == "new"
   284	    assert payload2["top_boards"][0]["board"] == "B板"
   285	    # 核心: 重扫换榜也不得把 B板 标成「今天推荐过」— 当天的账已记在 A板
   286	    assert st["board_last_recommended"] == {"A板": TODAY}
