   450	def test_payload_carries_top_level_vault_id(tmp_path, monkeypatch):
   451	    """C1a 加性契约: payload 顶层新增 vault_id, schema_version 仍 3,
   452	    notification.id 值不动 (A2 冻结 — send 侧才组合 vault 维度)。"""
   453	    vault = _vault(tmp_path, {"甲": _node()}, name="vaultA")
   454	    _patch_runner(monkeypatch, vault, tmp_path)
   455	    st = runner.load_state()
   456	    payload, gen = runner.ensure_payload(st, NOW, TODAY)
   457	    assert gen == "new"
   458	    assert payload["vault_id"] == "vaultA"
   459	    assert payload["schema_version"] == 3
   460	    assert payload["notification"]["id"] == f"canvas-review-{payload['date']}"
   461	    on_disk = json.loads((vault / "outputs" / "今日复习.json").read_text(encoding="utf-8"))
   462	    assert on_disk["vault_id"] == "vaultA"
