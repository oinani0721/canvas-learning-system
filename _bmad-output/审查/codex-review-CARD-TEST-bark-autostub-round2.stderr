   335	def test_legacy_state_credited_today_without_marker_not_double_credited(tmp_path, monkeypatch):
   336	    """升级当天兼容 (Codex-D2a H1): 旧版 runner 已在今天落账 (值=today) 但
   337	    state 自然缺 last_recommend_credit_date — 同日换榜重扫不得再次落账,
   338	    否则 A、B 同日均标 today, 突破每日一次上界并污染 tie-break。"""
   339	    vault = _vault(tmp_path, {"a甲": _node(board="A板")})
   340	    _patch_runner(monkeypatch, vault, tmp_path)
   341	    st = runner.load_state()
   342	    _, gen1 = runner.ensure_payload(st, NOW, TODAY)
   343	    assert gen1 == "new"
   344	    assert st["board_last_recommended"] == {"A板": TODAY}
   345	    # 模拟旧版 runner 留下的 state: 当日已落账、自然缺新 marker
   346	    del st["last_recommend_credit_date"]
   347	    runner.save_state(st)
   348	    st = runner.load_state()
   349	
   350	    (vault / "节点" / "b乙.md").write_text(_node(board="B板"), encoding="utf-8")
   351	    _pin_pool_older_than_payload(vault, BASE)
   352	    _set_mtime(vault / "节点" / "b乙.md", BASE + 200)
   353	    _set_mtime(vault / "节点", BASE + 200)
   354	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
   355	    assert gen2 == "new"
   356	    assert payload2["top_boards"][0]["board"] == "B板"
   357	    assert st["board_last_recommended"] == {"A板": TODAY}, (
   358	        "旧 state 无 marker 但值已含 today — 视为当日已落账, 不得给 B 补账"
   359	    )
