   109	def test_keyfile_guarded():
   110	    """自证门 C (armed): 守卫层① KEY_FILE 重定向的放行门 — 布防下
   111	    send_bark.KEY_FILE 必须已被移出真实 key 位置。结构性断言, 只比路径
   112	    不读内容, 布防/卸甲两形态都零副作用。"""
   113	    import send_bark
   114	
   115	    real_key = Path.home() / ".config" / "canvas-review" / "bark.key"
   116	    kf = Path(send_bark.KEY_FILE)
   117	    assert kf != real_key, "守卫未布防: send_bark.KEY_FILE 仍指向真实 key 位置"
   118	
   119	
   120	def test_osascript_guarded():
   121	    """自证门 D (armed): 守卫层③ osascript_fallback 打桩的放行门 — 布防下
   122	    它必须是守卫的记录桩而非 runner 原始实现。按 __qualname__ 结构性断言
   123	    (任何测试侧替身都会改 qualname), 不调用函数, 布防/卸甲两形态都零副作用
   124	    (调真函数 = 卸甲形态下真弹通知, 恰是要避免的事)。"""
   125	    import daily_review_run
   126	
   127	    fn = daily_review_run.osascript_fallback
   128	    assert getattr(fn, "__qualname__", "") != "osascript_fallback", (
   129	        "守卫未布防: osascript_fallback 仍是 runner 原始实现"
   130	    )
   131	
   132	
   133	def test_reload_selfheal():
   134	    """自证门 E (armed): reload 双保险 — reload(send_bark) 重跑模块顶层
   135	    (KEY_FILE/_urlopen 被生产值重写) 后, 守卫须自动重打三层。仅 reload
   136	    不调 send, 布防/卸甲两形态都零出网。"""
   137	    import importlib
   138	
   139	    import send_bark
   140	
   141	    importlib.reload(send_bark)
   142	    real_key = Path.home() / ".config" / "canvas-review" / "bark.key"
   143	    assert Path(send_bark.KEY_FILE) != real_key, (
   144	        "守卫未布防或 reload 自愈失效: reload 后 KEY_FILE 回到真实 key 位置"
   145	    )
   146	    assert getattr(send_bark._urlopen, "__qualname__", "") != "urlopen", (
   147	        "守卫未布防或 reload 自愈失效: reload 后 _urlopen 回到真实 urlopen"
   148	    )
     1	#!/usr/bin/env python3
     2	"""CARD-TEST-bark-autostub 负控裁判 (A/B/C'/C/D/D'/E/E' 八跑, 串行子进程)。
     3	
     4	A  (disarmed): --noconftest 卸下守卫 → test_probe 期望 PASS —— 证明「去掉
     5	   fixture 就会真的尝试外发」(探针自装的 getaddrinfo/create_connection
     6	   双拦截器挡住, 任何情况下不出网);
     7	B  (armed):    正常 conftest → test_probe 期望 FAIL, 且失败必须是指定的
     8	   那道断言 (pytest 输出里整行 `E   AssertionError: Bark egress attempted
     9	   in tests`) —— 拒绝器层在被它验证的逻辑;
    10	C  (armed):    test_keyfile_guarded 期望 PASS —— 守卫层① KEY_FILE 重定向
    11	   的放行门;
    12	C' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— 层①篡改门:
    13	   证明 C 真的依赖守卫, 不是恒真;
    14	D  (armed):    test_osascript_guarded 期望 PASS —— 守卫层③ osascript 打桩
    15	   的放行门;
    16	D' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— 层③篡改门;
    17	E  (armed):    test_reload_selfheal 期望 PASS —— reload 双保险放行门;
    18	E' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— reload 篡改门。
    19	
    20	判据口径 (round-2 收紧): 每跑核「退出码 + pytest 摘要行 + 指定断言正则」
    21	—— 摘要必须恰为 `1 passed` / `1 failed` (可选 `, N warnings`), 出现 error
    22	或多余用例即拒收; 指定断言按整行锚定 (^E\\s+...), 字符串碰巧出现在
    23	traceback 源码行里不算数。TimeoutExpired 捕获记 FAIL, 不炸取证面。
    24	
    25	exit 0 仅当八跑全部按期望。串行、子进程、-p no:cacheprovider 防并行
    26	session 共享 .pytest_cache 踩踏。
    27	"""
    28	
    29	import re
    30	import subprocess
    31	import sys
    32	from pathlib import Path
    33	
    34	BACKEND = Path(__file__).resolve().parents[1]
    35	PROBE = "tests/regression/bark_egress_probe.py"
    36	CASES = [
    37	    ("A/disarmed-probe-egress-attempted", f"{PROBE}::test_probe", ["--noconftest"], "pass", None),
    38	    ("B/armed-probe-refused", f"{PROBE}::test_probe", [], "fail",
    39	     r"^E\s+AssertionError: Bark egress attempted in tests\s*$"),
    40	    ("C/armed-keyfile-guarded", f"{PROBE}::test_keyfile_guarded", [], "pass", None),
    41	    ("C'/disarmed-keyfile-tamper", f"{PROBE}::test_keyfile_guarded", ["--noconftest"], "fail",
    42	     r"^E\s+AssertionError: 守卫未布防: send_bark\.KEY_FILE"),
    43	    ("D/armed-osascript-guarded", f"{PROBE}::test_osascript_guarded", [], "pass", None),
    44	    ("D'/disarmed-osascript-tamper", f"{PROBE}::test_osascript_guarded", ["--noconftest"], "fail",
    45	     r"^E\s+AssertionError: 守卫未布防: osascript_fallback"),
    46	    ("E/armed-reload-selfheal", f"{PROBE}::test_reload_selfheal", [], "pass", None),
    47	    ("E'/disarmed-reload-tamper", f"{PROBE}::test_reload_selfheal", ["--noconftest"], "fail",
    48	     r"^E\s+AssertionError: 守卫未布防或 reload 自愈失效: reload 后 KEY_FILE"),
    49	]
    50	
    51	
    52	def _summary_body(stdout: str) -> str:
    53	    """取 pytest 末行摘要的正文, 如 '1 failed, 10 warnings'。"""
    54	    for line in reversed(stdout.splitlines()):
    55	        m = re.match(r"=+\s+(.*?)\s+in\s+[\d.]+s(?:\s.*)?\s*=+\s*$", line.strip())
    56	        if m:
    57	            return m.group(1)
    58	    return ""
    59	
    60	
    61	def _judged(label: str, nodeid: str, extra: list, expect: str, pattern: str | None) -> bool:
    62	    cmd = [sys.executable, "-m", "pytest", "-p", "no:cacheprovider", *extra, nodeid]
    63	    print(f"[{label}] $ {' '.join(cmd)}", flush=True)
    64	    try:
    65	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600)
    66	        rc, out = proc.returncode, proc.stdout
    67	        sys.stdout.write(out)
    68	        sys.stderr.write(proc.stderr)
    69	    except subprocess.TimeoutExpired as e:
    70	        sys.stdout.write(e.stdout or "" if isinstance(e.stdout, str) else "")
    71	        sys.stderr.write(str(e))
    72	        print(f"[{label}] TIMEOUT after 600s")
    73	        return False
    74	
    75	    body = _summary_body(out)
    76	    shape_ok = bool(re.fullmatch(r"1 passed(, \d+ warnings?)?", body)) if expect == "pass" else (
    77	        bool(re.fullmatch(r"1 failed(, \d+ warnings?)?", body))
    78	    )
    79	    shape_ok = shape_ok and " no tests ran" not in out and "error" not in body
    80	    regex_ok = pattern is None or (
    81	        pattern is not None and re.search(pattern, out, re.MULTILINE) is not None
    82	    )
    83	    rc_ok = rc == (0 if expect == "pass" else 1)
    84	    ok = rc_ok and shape_ok and regex_ok
    85	    print(
    86	        f"[{label}] expect {expect.upper()} -> ok={ok} rc={rc} summary='{body}' "
    87	        f"regex={'n/a' if pattern is None else bool(regex_ok)}"
    88	    )
    89	    return ok
    90	
    91	
    92	def main() -> int:
    93	    results = [_judged(label, nodeid, extra, expect, pattern) for label, nodeid, extra, expect, pattern in CASES]
    94	    for (label, _, _, expect, _), ok in zip(CASES, results):
    95	        print(f"{label}: expect {expect.upper()} -> {'ok' if ok else 'MISMATCH'}")
    96	    if all(results):
    97	        print(
    98	            "NEGATIVE-CONTROL: PASS "
    99	            "(armed=probe-FAILED-as-expected, disarmed=probe-PASSED-egress-attempted)"
   100	        )
   101	        return 0
   102	    print("NEGATIVE-CONTROL: FAIL")
   103	    return 1
   104	
   105	
   106	if __name__ == "__main__":
   107	    sys.exit(main())

