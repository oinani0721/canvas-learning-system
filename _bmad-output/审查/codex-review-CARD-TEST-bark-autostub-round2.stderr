    74	class BaselineLoader:
    75	    """Load baseline scenario JSON files for a specific prompt type."""
    76	
    77	    def __init__(self, prompt_name: str, baselines_dir: Path):
    78	        self._dir = baselines_dir / prompt_name
    79	        self._prompt_name = prompt_name
    80	
    81	    def load_all(self) -> List[Dict[str, Any]]:
    82	        """Load all scenario JSON files, sorted by filename."""
    83	        if not self._dir.exists():
    84	            raise FileNotFoundError(f"Baseline directory not found: {self._dir}")
    85	        scenarios = list()
    86	        for f in sorted(self._dir.glob("scenario_*.json")):
    87	            data = json.loads(f.read_text(encoding="utf-8"))
    88	            data["_source_file"] = f.name
    89	            scenarios.append(data)
    90	        if not scenarios:
    91	            raise FileNotFoundError(f"No scenario_*.json files found in {self._dir}")
    92	        return scenarios
    93	
    94	    def load_one(self, filename: str) -> Dict[str, Any]:
    95	        """Load a specific scenario file."""
    96	        path = self._dir / filename
    97	        if not path.exists():
    98	            raise FileNotFoundError(f"Scenario file not found: {path}")
    99	        data = json.loads(path.read_text(encoding="utf-8"))
   100	        data["_source_file"] = filename
   101	        return data
   102	
