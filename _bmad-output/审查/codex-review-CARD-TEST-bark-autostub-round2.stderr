   467	
   468	def _capture_bark_request(monkeypatch, tmp_path) -> dict:
   469	    """网络出口打桩 (仅测试进程内): 截获 send_bark 实际提交给 Bark API 的
   470	    请求体做断言。真发 = 每次跑测试都向真机推真通知, 才是纪律违规;
   471	    仓库既有惯例同源 (本文件场景 3 的 send 哨兵)。"""
   472	    key_file = tmp_path / "bark.key"
   473	    key_file.write_text("testkey-12345678\n", encoding="utf-8")
   474	    monkeypatch.setattr(runner.send_bark, "KEY_FILE", key_file)
   475	    captured = {}
   476	
   477	    class _AcceptedResp:
   478	        status = 200
   479	
   480	        def read(self):
   481	            return b'{"code":200}'
   482	
   483	        def __enter__(self):
   484	            return self
   485	
   486	        def __exit__(self, *args):
   487	            return False
   488	
   489	    def _capture_urlopen(req, timeout=None):
   490	        captured["body"] = json.loads(req.data.decode("utf-8"))
   491	        return _AcceptedResp()
   492	
   493	    # CARD-TEST-bark-autostub: patch 模块内唯一出口缝, 不再改全局
   494	    # urllib.request.urlopen (旧写法会波及同进程内一切 urllib 用户)
   495	    monkeypatch.setattr(runner.send_bark, "_urlopen", _capture_urlopen)
   496	    return captured
   497	
   498	
