   193	# ── CARD-TEST-bark-autostub: Bark 外发自动打桩守卫 ──────────────────────
   194	# 生产链 daily_review_run.main() → send_bark.send() → _urlopen(POST
   195	# {server}/push) 会真推真机 (--now 10:00+08:00 恒在推送窗内); send 失败还会
   196	# osascript 真弹 macOS 通知。此前全靠每条测试各自记得替换 send — 新增一条
   197	# main() 测试忘替换 = 真推。本 fixture 把「忘了打桩」的默认后果从「真推」
   198	# 翻转为「响亮失败」。
   199	
   200	#: 守卫布防面 = 精确枚举 (按模块名末段比对)。不用 endswith 启发: 它会误伤
   201	#: foo_test_daily_review_run, 也漏防 test_daily_review_run_cli 这类未来
   202	#: 拆分名 (Codex round-1 MEDIUM)。新推送测试文件要布防必须显式加进本元组 —
   203	#: 「目录内新增文件默认不设防」是如实边界 (验收单裁决点 2), 不是疏漏。
   204	_BARK_GUARDED_MODULES = ("test_daily_review_run", "bark_egress_probe")
   205	
   206	
   207	@pytest.fixture(autouse=True)
   208	def _bark_egress_guard(request):
   209	    """daily_review_run 测试的三层外发防线 (function 级 autouse)。
   210	
   211	    ① send_bark.KEY_FILE → tmp 假 key (格式合法且真实存在): 让 load_key
   212	       成功, 忘打桩的测试必然走到 ② 拒绝器 — 不存在的 key 会让 send 静默
   213	       skip-nokey 返 0, 那恰是假绿通道 (Codex round-1 HIGH)。
   214	       env BARK_KEY_FILE 同步重定向: reload(send_bark) 重跑模块顶层重新
   215	       解析时仍落 tmp。
   216	    ② send_bark._urlopen → 抛 AssertionError("Bark egress attempted in
   217	       tests") 的拒绝器 — send_bark 的 except 只吞 HTTPError/URLError/
   218	       TimeoutError/OSError (send_bark.py:138/:140), AssertionError 必然
   219	       穿透 send 与 runner.main 炸红测试。
   220	    ③ daily_review_run.osascript_fallback → 记录并返回 True (不弹真通知)。
   221	
   222	    独立 MonkeyPatch 实例 (round-1 HIGH): 测试自己的 monkeypatch.undo()
   223	    只拆测试自己的桩, 波及不到本守卫。
   224	    reload 双保险: importlib.reload 的属性式调用被拦, 对布防模块的 reload
   225	    完成后自动重打三层; `from importlib import reload` 预绑定形态拦不住
   226	    (如实边界 — reload 自毁属进程内故意对抗, 不在「忘打桩」威胁模型内)。
   227	
   228	    测试内显式 monkeypatch.setattr 可覆盖任意一层 (守卫 setup 在先, 测试
   229	    的 patch 后设先生效) — _capture_bark_request 即覆盖 ①②。
   230	    imports 在模块门之后惰性执行; scripts 目录只对布防模块进 sys.path。
   231	    非布防模块: 本 fixture 只实例化 request, 不碰 fixture 图其余部分。
   232	    """
   233	    if request.module.__name__.rsplit(".", 1)[-1] not in _BARK_GUARDED_MODULES:
   234	        yield None
   235	        return
   236	
   237	    scripts_dir = _BACKEND_DIR.parent / "scripts"
   238	    patcher = pytest.MonkeyPatch()
   239	    tmp_dir = Path(tempfile.mkdtemp(prefix="bark-guard-"))
   240	    osascript_calls: List[Dict[str, Any]] = []
   241	    try:
   242	        key_file = tmp_dir / "bark.key"
   243	        key_file.write_text("bark-guard-fake-key-0001\n", encoding="utf-8")
   244	        patcher.setenv("BARK_KEY_FILE", str(key_file))
   245	        patcher.syspath_prepend(str(scripts_dir))
   246	        import daily_review_run
   247	        import send_bark
   248	
   249	        def _refuse_egress(*args, **kwargs):
   250	            raise AssertionError("Bark egress attempted in tests")
   251	
   252	        def _stub_osascript(noti):
   253	            osascript_calls.append(dict(noti))
   254	            return True
   255	
   256	        def _reapply():
   257	            patcher.setattr(send_bark, "KEY_FILE", key_file)
   258	            patcher.setattr(send_bark, "_urlopen", _refuse_egress)
   259	            patcher.setattr(daily_review_run, "osascript_fallback", _stub_osascript)
   260	
   261	        _real_reload = importlib.reload
   262	
   263	        #: reload 双保险盯的是「守卫打过桩的生产模块」— reload 它们会重跑
   264	        #: 模块顶层把生产值写回 (KEY_FILE/_urlopen/osascript_fallback),
   265	        #: 完成后重打; 不是盯测试模块名 (round-2 自测抓出: 拿
   266	        #: _BARK_GUARDED_MODULES 判被 reload 的生产模块名, 条件恒假)。
   267	        _PATCHED_MODULES = ("send_bark", "daily_review_run")
   268	
   269	        def _guarded_reload(module):
   270	            result = _real_reload(module)
   271	            if module.__name__ in _PATCHED_MODULES:
   272	                _reapply()
   273	            return result
   274	
   275	        patcher.setattr(importlib, "reload", _guarded_reload)
   276	        _reapply()
   277	        yield osascript_calls
   278	    finally:
   279	        patcher.undo()
   280	        shutil.rmtree(tmp_dir, ignore_errors=True)
     1	"""daily_review_run 当天重学卡刷新 (CARD-A3, BATCH-2026-08-24-复习闭环)。
     2	
     3	ensure_payload 缓存失效三场景锁定: 当天已生成后, 节点池比 payload 新
     4	(quiz 写侧刚更新 fsrs_due / 新增节点) 必须重扫; 无变动仍复用; 重扫后
     5	同日推送去重 (skip-done) 与 tie-break 语义 (board_last_recommended
     6	每天只在第一个非空榜首落账一次, CARD-D2a) 不被破坏。
     7	
     8	只 assert dict / 状态 / runner 状态行, 不 assert 今日复习.md 渲染文本
     9	(与 A2 渲染层解耦)。mtime 全部 os.utime 显式钉死, 不依赖墙钟顺序。
    10	"""
    11	
    12	import hashlib
    13	import json
    14	import os
