   187	# ── 内审 MEDIUM (实测复现): 扫描-落盘窗口内的写侧更新不得整天丢失 ──
   188	
   189	
   190	def test_write_during_scan_window_not_lost(tmp_path, monkeypatch):
   191	    """写侧恰在扫描完成后、payload 落盘前落地一张重学卡: 该卡 mtime 早于
   192	    payload 落盘时刻, 若以落盘时刻为基准则整天 cached 丢卡。基准必须是
   193	    扫描起点。真实 build_payload 照常执行, 仅在其返回后注入竞态写入。"""
   194	    vault = _vault(tmp_path, {"甲": _node()})
   195	    _patch_runner(monkeypatch, vault, tmp_path)
   196	    st = runner.load_state()
   197	
   198	    import daily_review_pick as picker
   199	
   200	    real_build = picker.build_payload
   201	    fired = []
   202	
   203	    def _race_build(*args, **kwargs):
   204	        result = real_build(*args, **kwargs)
   205	        if not fired:  # 只在首轮注入一次
   206	            fired.append(1)
   207	            (vault / "节点" / "竞态.md").write_text(_node(), encoding="utf-8")
   208	        return result
   209	
   210	    monkeypatch.setattr(picker, "build_payload", _race_build)
   211	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
   212	    assert gen1 == "new"
   213	    assert "竞态" not in {d["node"] for d in payload1["due_nodes"]}  # 首轮扫描没看到它
   214	
   215	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
   216	    assert gen2 == "new", "竞态窗口内落地的节点必须在下一轮触发重扫, 不得整天 cached"
   217	    assert "竞态" in {d["node"] for d in payload2["due_nodes"]}
   218	
   219	
   220	# ── Codex BLOCKER: 时间推进跨过未来 fsrs_due 也必须失效缓存 ──
   221	# 复现链: 09:59 写侧落 fsrs_due=10:09 → 10:05 mtime 重扫 (未到期, 空清单)
   222	# → 11:05 已到期但节点池没再变 → 若只看 mtime 则整天 cached, 当天到期卡
   223	# 丢失 — 恰是卡片档案 :89 警告的「缺陷位移」。
   224	
   225	
   226	def test_time_crossing_future_due_invalidates_cache(tmp_path, monkeypatch):
   227	    vault = _vault(
   228	        tmp_path,
   229	        {"重学卡": _node(extra="fsrs_due: 2026-07-30T02:30:00Z\n")},
   230	    )
   231	    _patch_runner(monkeypatch, vault, tmp_path)
   232	    st = runner.load_state()
   233	
   234	    # 02:00 生成: 卡 02:30 才到期, 清单为空 (upcoming 记录了未来到期)
   235	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
   236	    assert gen1 == "new" and payload1["due_nodes"] == []
   237	
   238	    _pin_pool_older_than_payload(vault, BASE)
   239	
   240	    # 03:05 (跨过 02:30, 节点池零变动): 必须重扫, 到期卡进清单
   241	    later = datetime(2026, 7, 30, 3, 5, tzinfo=timezone.utc)
   242	    payload2, gen2 = runner.ensure_payload(st, later, TODAY)
   243	    assert gen2 == "new", "时间越过未来到期点必须失效缓存, 不得因节点未变而整天 cached"
   244	    assert {d["node"] for d in payload2["due_nodes"]} == {"重学卡"}
   245	
   246	    # 03:06 再跑: 已无未来到期点、池未变 → 回到正常缓存 (不得退化成每轮全扫)
   247	    _pin_pool_older_than_payload(vault, BASE)
   248	    _, gen3 = runner.ensure_payload(st, datetime(2026, 7, 30, 3, 6, tzinfo=timezone.utc), TODAY)
   249	    assert gen3 == "cached"
