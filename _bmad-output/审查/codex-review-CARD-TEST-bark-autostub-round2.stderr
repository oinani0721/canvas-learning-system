   649	def test_migrate_interrupted_states_have_explicit_exits(tmp_path, monkeypatch, capsys):
   650	    """Codex-C1a F3 状态机锁定: 仅剩 .bak (写 new 前中止) → rc1 且给出恢复
   651	    指引, 不得谎报 '无需迁移'; new+.bak 双在 (已完成) → rc0 幂等;
   652	    new 损坏 + .bak 在 (写入途中中止) → rc1 指引重迁。"""
   653	    backups = tmp_path / "backups"
   654	    backups.mkdir()
   655	    bak = backups / "daily-review.state.json.bak"
   656	    new = backups / "daily-review.canvas-vault.state.json"
   657	
   658	    bak.write_text('{"schema_version": 1}', encoding="utf-8")
   659	    rc = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   660	    assert rc == 1
   661	    assert "恢复" in capsys.readouterr().err
   662	
   663	    new.write_text('{"schema_version": 1}', encoding="utf-8")
   664	    rc2 = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   665	    assert rc2 == 0
   666	    assert "已完成" in capsys.readouterr().out
   667	
   668	    new.write_text('{"半截', encoding="utf-8")
   669	    rc3 = _run_migrate(monkeypatch, ["--vault", "canvas-vault", "--backups", str(backups)])
   670	    assert rc3 == 1
   671	    assert "重迁" in capsys.readouterr().err
