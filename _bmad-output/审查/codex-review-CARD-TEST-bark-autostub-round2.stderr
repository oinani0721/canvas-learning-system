    32	def _node(board="普通板", extra=""):
    33	    return f'---\ntype: concept\nsource_board: "[[原白板/{board}]]"\n{extra}---\n真实内容。\n'
    34	
    35	
    36	def _vault(tmp_path, nodes: dict, name: str = "vault") -> Path:
    37	    vault = tmp_path / name
    38	    scripts = vault / ".claude" / "scripts"
    39	    scripts.mkdir(parents=True)
    40	    (vault / "节点").mkdir()
    41	    shutil.copy(WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py", scripts)
    42	    for fname, content in nodes.items():
    43	        (vault / "节点" / f"{fname}.md").write_text(content, encoding="utf-8")
    44	    return vault
    45	
    46	
    47	def _patch_runner(monkeypatch, vault, tmp_path):
    48	    """CARD-C1a: STATE/LOG 常量已函数化为 BACKUPS 派生 (state_path/log_line),
    49	    fixture 只注入 BACKUPS 一处 — 所有 state/log 写入随之进 tmp, 防写真实
    50	    backups/。逐用例检查: 本文件所有落盘路径均经 VAULT (tmp) 或 BACKUPS (tmp)。"""
    51	    monkeypatch.setattr(runner, "VAULT", vault)
    52	    monkeypatch.setattr(runner, "BACKUPS", tmp_path / "backups")
    53	
    54	
    55	def _set_mtime(path: Path, ts: float):
    56	    os.utime(path, (ts, ts))
    57	
    58	
    59	def _pin_pool_older_than_payload(vault: Path, payload_ts: float):
    60	    """把 节点/ 目录与现有节点文件全部钉到 payload 之前 (无变动基线)。"""
    61	    for p in (vault / "节点").glob("*.md"):
    62	        _set_mtime(p, payload_ts - 100)
    63	    _set_mtime(vault / "节点", payload_ts - 100)
    64	    _set_mtime(vault / "outputs" / "今日复习.json", payload_ts)
    65	
    66	
    67	# ── 场景 1: 节点变动 → 同日缓存失效, 重扫结果含该节点 ──
    68	
    69	
    70	def test_node_change_invalidates_same_day_cache(tmp_path, monkeypatch):
    71	    vault = _vault(tmp_path, {"甲": _node()})
    72	    _patch_runner(monkeypatch, vault, tmp_path)
    73	    st = runner.load_state()
    74	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
    75	    assert gen1 == "new"
    76	    assert {d["node"] for d in payload1["due_nodes"]} == {"甲"}
    77	
    78	    # 写侧模拟: 当天考完甲后新增重学卡乙 (新卡无 fsrs_due = 即刻到期)
    79	    (vault / "节点" / "乙.md").write_text(_node(), encoding="utf-8")
    80	    _pin_pool_older_than_payload(vault, BASE)
    81	    _set_mtime(vault / "节点" / "乙.md", BASE + 200)
    82	    _set_mtime(vault / "节点", BASE + 200)
    83	
    84	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
    85	    assert gen2 == "new", "节点池比 payload 新时必须重扫, 不得整日复用早晨快照"
    86	    assert "乙" in {d["node"] for d in payload2["due_nodes"]}
    87	    assert payload2["schema_version"] == 3  # 只消费 A2 的 v3, 不改 schema
    88	
    89	
    90	# ── 场景 2: 无变动 → 仍走缓存 (每小时触发不得变成每小时全量重扫) ──
    91	
    92	
    93	def test_unchanged_pool_still_cached(tmp_path, monkeypatch):
    94	    vault = _vault(tmp_path, {"甲": _node()})
    95	    _patch_runner(monkeypatch, vault, tmp_path)
    96	    st = runner.load_state()
    97	    payload1, gen1 = runner.ensure_payload(st, NOW, TODAY)
    98	    assert gen1 == "new"
    99	
   100	    _pin_pool_older_than_payload(vault, BASE)
   101	
   102	    payload2, gen2 = runner.ensure_payload(st, NOW, TODAY)
   103	    assert gen2 == "cached"
   104	    assert payload2 == payload1  # 复用的是同一份落盘 payload
   105	
   106	
   107	# ── 场景 3: 重扫后同日推送仍 skip-done (Bark 同 id 去重门不被重扫击穿) ──
   108	
   109	
   110	def test_rescan_keeps_same_day_push_skip_done(tmp_path, monkeypatch, capsys):
   111	    vault = _vault(tmp_path, {"甲": _node()})
   112	    _patch_runner(monkeypatch, vault, tmp_path)
   113	    now_arg = "2026-07-30T10:00:00+08:00"
   114	    # today 按 runner 同一变换推导 (机器时区无关): skip-done 门在窗口门之前
   115	    today = datetime.fromisoformat(now_arg).astimezone().date().isoformat()
   116	
   117	    st = runner.load_state()
   118	    _, gen1 = runner.ensure_payload(st, datetime.fromisoformat(now_arg), today)
   119	    assert gen1 == "new"
   120	    st["last_push_accepted_date"] = today  # 早晨那次推送已被服务端接受
   121	    runner.save_state(st)
   122	
   123	    (vault / "节点" / "乙.md").write_text(_node(), encoding="utf-8")
   124	    _pin_pool_older_than_payload(vault, BASE)
   125	    _set_mtime(vault / "节点" / "乙.md", BASE + 200)
   126	    _set_mtime(vault / "节点", BASE + 200)
   127	
   128	    # 哨兵而非 mock: 该路径下 send 被调用即测试失败 (同日去重门失守)
   129	    def _sentinel(noti):
   130	        raise AssertionError("同日已推送后, 重扫不得再次触发 Bark 发送")
   131	
   132	    monkeypatch.setattr(runner.send_bark, "send", _sentinel)
   133	    monkeypatch.setattr(
   134	        sys,
   135	        "argv",
   136	        ["daily_review_run.py", "--now", now_arg, "--vault", str(vault)],
   137	    )
   138	    assert runner.main() == 0
   139	    out = capsys.readouterr().out
   140	    assert "generate:new" in out, "重扫必须真的发生 (否则本场景空转)"
   141	    assert "push:skip-done" in out
   142	
   143	    st2 = runner.load_state()
   144	    assert st2["last_push_accepted_date"] == today
   145	    assert st2["last_generate_date"] == today
   146	
   147	
   148	# ── 内审 HIGH (mutation 缺口): 两条 mtime 失效通道各自单独锁定 ──
   149	# 场景 1/3 同时钉文件+目录 mtime, 任一通道被删测试仍绿; 以下两测各锁一半。
