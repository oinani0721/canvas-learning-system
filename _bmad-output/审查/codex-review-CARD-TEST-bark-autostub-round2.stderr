   500	    captured = _capture_bark_request(monkeypatch, tmp_path)
   501	    noti = {"title": "t", "body": "b", "group": "canvas复习", "id": "canvas-review-2026-07-30"}
   502	    assert runner.send_bark.send(noti, "vaultA") == 0
   503	    assert captured["body"]["id"] == "canvas-review-2026-07-30-vaultA"
   504	    assert "vaultA" in captured["body"]["group"]
   505	    # 传入 dict 不被就地改写 (payload 落盘值 = A2 冻结契约)
   506	    assert noti["id"] == "canvas-review-2026-07-30"
   507	    assert noti["group"] == "canvas复习"
