  1474	def test_unclosed_html_comment_never_suggested_for_deletion(tmp_path):
  1475	    """⛔ round-3 自审 B3-1: `<!--` 没等到 `-->` 就到文件尾时, 哪些内容被注释吞掉
  1476	    是引擎猜不了的 —— 不得据此判「空骨架 → 建议删」, 更不得给出
  1477	    「标题 0 行、代码围栏 0 行」这种与肉眼可见内容矛盾的假依据。"""
  1478	    vault, out = base_vault(tmp_path)
  1479	    inbox = vault / "_待处理"
  1480	    mk(
  1481	        inbox / "注释未闭合.md",
  1482	        "<!-- 说明: 粘贴时忘了闭合\n```python\n# keep\n这段正文其实存在\n",
  1483	        age_days=5,
  1484	    )
  1485	    # 正向对照: 闭合注释的空骨架 → 仍 C3 建议删 (护栏不误伤存量判据)
  1486	    # ⛔ round-3 审查 HIGH 起语义变了: 闭合注释里**有内容**也算未消化(信号⑩),
  1487	    # 与①(未闭合注释)对称 —— ①保护「不知道被吞了什么」, ⑩保护「知道被吞了
  1488	    # 什么但引擎没消费它」。此前只有①有保护, 于是把唯一来源写在闭合注释里的
  1489	    # 文件 C3/C4 双出口全穿。故这里改测「闭合注释同样落 C6」。
  1490	    mk(inbox / "闭合注释骨架.md", "# \n\n<!-- 注释 -->\n", age_days=4)
  1491	    # 正向对照: 完全没有注释的骨架 → 仍 C3 建议删
  1492	    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)
  1493	
