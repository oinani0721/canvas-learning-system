   874	def skeleton_note(text: str, size: int) -> str:
   875	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   876	
   877	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   878	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   879	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   880	    """
   881	    if size == 0:
   882	        return "0 字节空文件"
   883	    rows = _classify_lines_typed(text)[0]
   884	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   885	    struct = sum(
   886	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   887	    )
   888	    fences = sum(1 for _, k in rows if k == "fence")
   889	    return (
   890	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   891	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   892	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   893	    )
   894	
   895	
   896	def head_window(text: str) -> list[tuple[int, str]]:
   897	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   898	    lines = text.splitlines()
   899	    n = frontmatter_span(lines)
   900	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   901	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   902	        win.append((n + j + 1, ln))
   903	    return win
