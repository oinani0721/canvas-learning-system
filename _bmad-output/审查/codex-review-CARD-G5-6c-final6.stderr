  1448	            criterion,
  1449	            verdict,
  1450	            ntype,
  1451	            target,
  1452	            basis,
  1453	            confident,
  1454	            exact_of=exact_of,
  1455	            exact_others=exact_others,
  1456	            near=near,
  1457	            conflicts=conflicts,
  1458	            **kw,
