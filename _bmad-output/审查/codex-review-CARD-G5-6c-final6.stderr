   292	def test_c4_exact_duplicate_gives_canonical_path(tmp_path):
   293	    """C4 正例: 归一化正文逐字相等 → 建议删 + 正本相对路径。
   294	
   295	    ⛔ 第九轮审查 HIGH（R9-H1）后**语义收窄**：归一化只吸收 NFD/NFC 与标题差异。
   296	    行尾双空格（Markdown 硬换行）与空行（段落边界）**有语义，不再被吸收** ——
   297	    判据名叫「精确重复」，比较形态却是有损投影，那是名实不符。
   298	    本门的 fixture 相应改为只差 NFD/NFC 与标题。
   299	    """
   300	    vault, out = base_vault(tmp_path)
   301	    body = "转学政策原文第一段。\n第二段内容 café。\n"
   302	    mk(vault / "节点" / "政策正本.md", "# 正本\n\n" + body, age_days=40)
   303	    # 收件箱副本: 只差 NFD 形态与标题（行尾空白/空行现在是语义，不能再当噪声）
   304	    dup = unicodedata.normalize("NFD", body)
   305	    mk(vault / "_待处理" / "政策粘贴-重复.md", "# 抄来的\n\n" + dup, age_days=2)
   306	
   307	    assert run_cli(vault, out).returncode == 0
   308	    it = load_json(out)["items"][0]
   309	    assert it["criterion"] == "C4_exact_duplicate"
   310	    assert it["verdict"] == "建议删"
   311	    assert it["exact_duplicate_of"] == "节点/政策正本.md"
   312	    assert it["confident"] is True
