   462	    于是 `# # #` 的**中间那个 `#`**（它是可见的标题内容）被当成 opening 的一部分
   463	    剥掉，整行判成空标题 → 文件被确定删除。ATX 的结构是
   464	    `opening(1-6 个 #) + 空白 + content + 可选 closing(全 # 且前有空白)`，
   465	    分离得按这个结构走，不能靠字符集剥离。
   466	    """
   467	    m = re.match(r"^ {0,3}(#{1,6})(?:[ \t]+|$)", ln)
   468	    if not m:
   469	        return ""
   470	    rest = ln[m.end() :].strip()
   471	    # 可选的收尾序列：必须整段是 #，且与内容之间有空白（CommonMark §4.2）
   472	    closing = re.search(r"(?:^|\s)(#+)$", rest)
   473	    if closing and set(closing.group(1)) == {"#"}:
   474	        rest = rest[: closing.start()].strip()
   475	    return rest
   476	
   477	
   478	def _is_structural_line(t: str) -> bool:
   479	    """纯结构行判定（分隔线 / 表格分隔 / 空列表符）。"""
   480	    if not _ONLY_STRUCT_RE.match(t):
   481	        return False
   482	    kinds = {c for c in t if c in _STRUCT_CHARS}
   483	    if len(kinds) > 1:
   484	        return False
   485	    core = t.strip()
   486	    if not core:
   487	        return True
   488	    ch = core[0]
   489	    # 分隔线（CommonMark 要求 ≥3 个）/ 引用与标题记号 / 表格分隔（含 `-`）
   490	    if ch in "-=*_" and len(core) >= 3:
   491	        return True
   492	    if ch == "#":
   493	        # ⛔ 第九轮 HIGH（R9-H3）：ATX 最多六级，`#######`（7 个）**不是**空标题
   494	        # 模板而是普通文本。此前 `set(core) <= {ch}` 把任意个数都当结构。
   495	        return len(core) <= 6
   496	    return ch in ">:|" and set(core) <= {ch} and len(core) >= 3
   497	
   498	
   499	#: 代码围栏（``` 或 ~~~，允许**最多 3 个空格**缩进 —— ⛔ 必须是字面空格：
   500	#: `\s{0,3}` 会放行制表符，而 CommonMark 里制表符缩进 ≥4 列是缩进代码块，
   501	#: `\t```` 既能开也能**关**围栏，会让围栏提前闭合、其后的标题被剥（round-3 自审 B3-4）。
   502	_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
   503	#: ⛔ YAML 映射键必须是 `key:` 后接**空白或行尾**：正文行 `http://example.com/path`
   504	#: 里的 `http:` 曾被当成键，整篇被吞成 frontmatter → 空骨架 → 建议删（round-2 H3）。
   505	#: 连带：`source:https://x`（冒号后无空格）此后不再识别为键 —— 若它是块内首个有效
   506	#: 行则整块降为正文，否则被 span 吞掉；两种形态都由 C3 护栏（显式偏差 15）兜住落 C6。
   507	#: 冒号前允许空白（`title : x` 与 `_FM_LOOKS_LIKE_KEY_RE` 同口径，pyyaml 亦认它是键；
   508	#: round-3 自审 H3-3：两条正则曾对「什么算键」各说各话，span 认而 map 不认 → 空正文）。
   509	_FM_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:(?:\s+(.*))?\s*$")
   510	#: frontmatter 首个有效行必须像 YAML 映射键 —— 否则那只是被两条 `---` 夹住的正文
   511	_FM_LOOKS_LIKE_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*\s*:(?:\s|$)")
   512	#: URL 形状初筛（`https?://\S+` 会把 `https://?` 也认成一手来源，Codex HIGH）。
   513	#: ⛔ 但正则列不尽 authority 段的空 host 形态（`https://:443/x`、`https://user@/x`
   514	#: 都能过它）——host 非空由 `_is_primary_source_url` 的 urlsplit 检查保证
   515	#: （round-2 H1 实证），本正则只负责拦明显不是 URL 的值。
   516	#: re.I：URI scheme 按 RFC 3986 §3.1 大小写不敏感，`HTTPS://example.com` 也是
   517	#: 一手来源（round-3 自审 H1-2）；大小写归一后 scheme 检查在 `_is_primary_source_url`
   518	#: 里仍保留作防御深度。
   519	_URL_RE = re.compile(r"^https?://[^\s/?#]+\S*$", re.IGNORECASE)
   520	
   521	
   522	def _is_primary_source_url(src: str) -> bool:
   523	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   524	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   525	    if not _URL_RE.match(src):
   526	        return False
   527	    try:
   528	        parts = urlsplit(src)
   529	    except ValueError:
   530	        return False
   531	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   532	
   533	
   534	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
   535	
   600	
   601	
   602	def frontmatter_span(lines: list[str]) -> int:
   603	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   604	
   605	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   606	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   607	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   608	    行号是给人核对用的，偏了就等于没有。
   609	    """
   610	    if not lines or lines[0].strip() != "---":
   611	        return 0
   612	    end = None
   613	    for i in range(1, len(lines)):
   614	        if lines[i].strip() in ("---", "..."):
   615	            end = i
   616	            break
   617	    if end is None:
   618	        return 0  # 缺闭合 → 视为无 frontmatter
   619	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   620	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   621	    # 空文件的删除提名，比不提名坏得多。
   622	    for ln in lines[1:end]:
   623	        t = ln.strip()
   624	        if not t or t.startswith("#"):
   625	            continue  # 空行与 YAML 注释不作数
   626	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   627	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   628	
   629	
   630	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   631	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   632	    lines = text.splitlines()
   633	    n = frontmatter_span(lines)
   634	    return (lines[1 : n - 1] if n else []), lines[n:]
   635	
   636	
   637	def _clean_fm_value(raw: str) -> str:
   638	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   639	
   640	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   641	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   642	    （round-3 自审 H1-6）。
   643	    """
   644	    val = (raw or "").strip()
   645	    val = re.sub(r"\s+#.*$", "", val).strip()
   646	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   647	        val = val[1:-1]
   648	    return val
   649	
   650	
   651	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   652	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   653	
   654	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   655	    于是
   656	
   657	        ---
   658	        doi:
   659	        doi: 10.1000/hidden
   660	        ---
   661	
   662	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   663	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   664	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   665	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   666	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   667	    """
   668	    out: list[tuple[str, str]] = []
   669	    for ln in fm_lines:
   670	        m = _FM_KEY_RE.match(ln)
   671	        if m:
   672	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   673	    return out
   674	
   675	
   676	def frontmatter_map(fm_lines: list[str]) -> dict:
   677	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   678	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   679	    `frontmatter_pairs`。"""
   680	    out: dict[str, str] = {}
   681	    for k, v in frontmatter_pairs(fm_lines):
   682	        out.setdefault(k, v)
   683	    return out
   684	
   685	
   686	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
   687	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。
   688	
   689	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   690	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   691	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   692	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   693	    分隔行由状态机精确标记，内容行一律是内容。
   694	
   695	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   696	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   697	
   698	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   699	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   700	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   701	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   702	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   703	    """
   704	    _, rest = split_frontmatter(text)
   705	    rows: list[tuple[str, str]] = []
   706	    stripped_comments: list[str] = []
   707	    in_fence = False
   708	    fence_char = ""
   709	    fence_len = 0
   710	    in_comment = False
   711	    for ln in rest:
   712	        m = _FENCE_RE.match(ln)
   713	        if m and not in_comment:
   714	            tok = m.group(1)
   715	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   716	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   717	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   718	            # 的 info string 允许反引号，不受此限。
   719	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   720	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   721	                # ⛔ 第七轮终审 HIGH（R7-H1）：围栏开启行的 **info string**
   722	                # （`~~~ {source=https://…}`）整行被标成 "fence" 后不进正文，
   723	                # 写在那儿的来源静默消失。这是「来源被引擎剥掉」的**第四种写法**
   724	                # （前三种：跨行 HTML 注释 / fm 整行 YAML 注释 / fm 行尾注释）。
   725	                info = ln[m.end() :].strip()
   726	                if info:
   727	                    stripped_comments.append(info)
   728	                rows.append((ln, "fence"))
   729	                continue
   730	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   731	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   732	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   733	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   734	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   735	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   736	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   737	            # 在 CommonMark 里是围栏内容）。
   738	            if (
   739	                tok[0] == fence_char
   740	                and len(tok) >= fence_len
   741	                and all(c in " \t" for c in ln[m.end() :])
   742	            ):
   743	                in_fence, fence_char, fence_len = False, "", 0
   744	                rows.append((ln, "fence"))
   745	                continue
   746	        if in_fence:
   747	            rows.append((ln, "code"))
   748	            continue
   749	        kept, rem = "", ln
   750	        while rem:
   751	            if in_comment:
   752	                i = rem.find("-->")
   753	                if i < 0:
   754	                    # ⛔ 第五轮终审 HIGH：跨行注释里**中间那些整行**此前没被收集
   755	                    # （只收了闭合那一行的 `rem[:i]`），于是
   756	                    #   <!--
   757	                    #   source: https://…
   758	                    #   -->
   759	                    # 的来源整条丢掉，文件被判空骨架确定删除。单行注释反而受保护。
   760	                    stripped_comments.append(rem)
   761	                    break
   762	                # ⛔ round-4 验证 MEDIUM：收集的必须是**注释内部的内容**。
   763	                # 先前记的是「被剥掉的原文片段」，于是 `<!---->` 这种空注释也
   764	                # 触发信号⑩，把安全方向的少删又扩大了一圈。
   765	                stripped_comments.append(rem[:i])
   766	                rem, in_comment = rem[i + 3 :], False
   767	            else:
   768	                i = rem.find("<!--")
   769	                if i < 0:
   770	                    kept += rem
   771	                    break
   772	                kept += rem[:i]
   773	                rem, in_comment = rem[i + 4 :], True
   774	        rows.append((kept, "text"))
   775	        # ⛔ round-3 审查 HIGH：闭合注释被这里整段剥掉，而来源/生成信号只扫
   776	        # frontmatter，⑨ 兜底也只覆盖 frontmatter —— 于是
   777	        # `<!-- source: https://… -->`、`<!-- DOI:10.1000/… -->`、
   778	        # `<!-- citation: ISBN … -->` 这类「唯一信息写在注释里」的文件
   779	        # C3/C4 双出口全穿。只有**未闭合**注释受保护，闭合的反而不受。
   780	        # 注释内容在上面的闭合分支里逐段收集，与「未闭合注释」对称地作信号。
   781	    return rows, in_comment, stripped_comments
   782	
   783	
   784	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   785	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   786	    三态细节见 `_classify_lines_typed`。"""
   787	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   788	
   789	
   790	def dup_body(text: str) -> str:
   791	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   792	
   793	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   794	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   795	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   796	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   797	    有后果的提名，依据必须逐字。
   798	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   799	    """
   800	    parts: list[str] = []
   801	    for ln, is_code in _classify_lines(text):
   802	        if not is_code and _HEADING_RE.match(ln):
   803	            continue
   804	        # ⛔ 第九轮 HIGH（R9-H1）：此前无条件 `rstrip()` + 丢空行，把**有语义的
   805	        # 空白**一起抹了 —— Markdown 行尾双空格是硬换行、空行是段落边界、围栏
   806	        # 里的空格与空行更是字面内容。于是 `alpha  \nbeta` 与 `alpha\nbeta`
   807	        # 被判「逐字相等」并确定删除。⚠️ 判据名叫「精确重复」，比较形态却是
   808	        # 有损投影 —— 名实不符本身就是缺陷。
   809	        if is_code:
   810	            # 围栏内一律逐字保真（含空行与行尾空格）
   811	            parts.append(nfc(ln))
   812	            continue
   813	        t = ln.rstrip()
   814	        if not t:
   815	            parts.append("")  # 段落边界是语义，不能丢
   816	            continue
   817	        if len(ln) - len(t) >= 2 and not ln[len(t) :].strip():
   818	            t += "  "  # 行尾 ≥2 空格 = 硬换行，保留其语义
   819	        parts.append(nfc(t))
   820	    return "\n".join(parts)
   821	
   822	
   823	def has_substantive_content(text: str) -> bool:
   824	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   825	
   826	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   827	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   828	    合用一个函数正是 Codex BLOCKER 的根因。
   829	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   830	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   831	    （round-3 自审 B3-3）。
   832	    """
   833	    for ln, kind in _classify_lines_typed(text)[0]:
   834	        if kind == "code":
   835	            if ln.strip():
   836	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   837	            continue
   838	        if kind == "fence":
   839	            continue
   840	        if _HEADING_RE.match(ln):
   841	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   842	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   843	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   844	            # confident=true` —— 那不是对抗构造，是真实使用场景。
