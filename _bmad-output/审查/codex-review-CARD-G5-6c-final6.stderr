  1409	def test_source_declared_clipping_is_never_suggested_for_deletion(tmp_path):
  1410	    """⛔ round-3 自审 H1-1/H3-1: C1 判据收窄后,「只有 frontmatter、没有正文」的
  1411	    剪藏不得从「留原地」翻成「空骨架 → 建议删」。
  1412	
  1413	    未消化信号护栏 (显式偏差 15): frontmatter 有 source 声明 / 含解析不成键的行 /
  1414	    文件以未闭合 HTML 注释结尾 → 一律落 C6 拿不准, 永不判 C3。
  1415	    同时覆盖: 引号+行尾注释的 source 仍走 C1 (先剥注释再剥引号)、
  1416	    冒号前空格的键仍被解析、大写 scheme 仍是一手来源。
  1417	    """
  1418	    vault, out = base_vault(tmp_path)
  1419	    inbox = vault / "_待处理"
  1420	    # 护栏 A: source 声明了但不是合法 URL, 无正文 → 拿不准, 不建议删
  1421	    mk(inbox / "空host剪藏.md", "---\nsource: https://:443/x\n---\n", age_days=9)
  1422	    mk(inbox / "空host用户剪藏.md", "---\nsource: https://user@/x\n---\n", age_days=8)
  1423	    # 护栏 B: source 冒号后无空格排在合法键后面 → 该行被吞, 但解析不全不判空骨架
  1424	    mk(
  1425	        inbox / "书签无空格键.md",
  1426	        "---\ntitle: 论文摘录\nsource:https://arxiv.org/abs/2401.00001\n---\n",
  1427	        age_days=7,
  1428	    )
  1429	    # 正向对照: 合法 source + 无正文 → 仍 C1 留原地 (C1 在 C3 之前, 剪藏受保护)
  1430	    mk(inbox / "正常空剪藏.md", "---\nsource: https://ok.test/clip\n---\n", age_days=6)
  1431	    # 引号 + 行尾注释组合: 先剥注释再剥引号 → C1
  1432	    mk(
  1433	        inbox / "引号注释剪藏.md",
  1434	        '---\nsource: "https://quoted.test/x" # 官方来源\n---\n',
  1435	        age_days=5,
  1436	    )
  1437	    # 冒号前空格: `source : url` 也是合法 YAML 键 (pyyaml 同判) → C1
  1438	    mk(inbox / "冒号前空格剪藏.md", "---\nsource : https://spaced.test/x\n---\n", age_days=4)
  1439	    # 大写 scheme: RFC 3986 §3.1 大小写不敏感 → C1
  1440	    mk(
  1441	        inbox / "大写scheme.md",
  1442	        "---\nsource: HTTPS://Upper.Test/a\n---\n\n正文一。\n正文二。\n",
  1443	        age_days=3,
  1444	    )
  1445	    # 正向对照: 无 source 的纯空骨架 → 仍 C3 建议删 (护栏不得误伤存量判据)
  1446	    mk(inbox / "纯空骨架.md", "# \n\n## \n", age_days=2)
  1447	
  1448	    assert run_cli(vault, out).returncode == 0
  1449	    data = load_json(out)
  1450	    for name in ("空host剪藏.md", "空host用户剪藏.md", "书签无空格键.md"):
  1451	        it = item_by_name(data, name)
  1452	        assert it["verdict"] != "建议删", f"{name} 被护栏漏掉了: {it['basis']}"
  1453	        assert it["criterion"] == "C6_undecided", name
  1454	        assert it["confident"] is False, name
  1455	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  1456	        # ⛔ round-4 MEDIUM: 护栏必须说清「为什么拿不准」, 不能只换 verdict 不给理由
  1457	        assert it["uncertain_reason"], name
  1458	    for name in (
  1459	        "正常空剪藏.md",
  1460	        "引号注释剪藏.md",
  1461	        "冒号前空格剪藏.md",
  1462	        "大写scheme.md",
  1463	    ):
  1464	        it = item_by_name(data, name)
  1465	        assert it["criterion"] == "C1_source_url", f"{name}: {it['basis']}"
  1466	        assert it["verdict"] == "留原地", name
  1467	    quoted = item_by_name(data, "引号注释剪藏.md")
  1468	    assert "官方来源" not in quoted["basis"], quoted["basis"]
  1469	    skeleton = item_by_name(data, "纯空骨架.md")
  1470	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1471	    assert skeleton["verdict"] == "建议删"
