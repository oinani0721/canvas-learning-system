   274	def sha(p: pathlib.Path) -> str:
   275	    return hashlib.sha256(p.read_bytes()).hexdigest()
   276	
   277	
   278	def run_suite() -> tuple[int, set[str], str]:
   279	    r = subprocess.run(
   280	        PYTEST,
   281	        cwd=BACKEND,
   282	        capture_output=True,
   283	        text=True,
   284	        env={
   285	            "PATH": "/usr/bin:/bin",
   286	            "PYTHONDONTWRITEBYTECODE": "1",
   287	            "HOME": str(pathlib.Path.home()),
   288	            "LC_ALL": "C.UTF-8",
   289	        },
   290	    )
   291	    out = r.stdout + r.stderr
   292	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   293	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   294	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   295	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   296	    failed = {
   297	        ln.split("::")[1].split(" ")[0].strip()
   298	        for ln in out.splitlines()
   299	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   300	    }
   301	    tail = [
   302	        ln
   303	        for ln in out.splitlines()
   304	        if "passed" in ln or "failed" in ln or "error" in ln
   305	    ]
   306	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   307	
   308	
   309	original = SRC.read_bytes()
   310	base_sha = sha(SRC)
   311	print(f"源码基线 sha256 = {base_sha}\n", flush=True)
   312	
   313	
   314	def _restore_on_signal(signum, _frame):
   315	    """⛔ 真事故（2026-09-02）：本脚本被 2 分钟超时 SIGTERM 杀掉时，`finally`
   316	    **没有执行** —— Python 默认信号处理器直接终止进程，不抛异常，源码被留在
   317	    M-PAIRS 变异态。原地改源码的脚本必须显式注册处理器才谈得上「一定还原」。
   318	    （能安全恢复靠的是上面那行基线 sha 已经打印出来 —— 有它，还原才有可验证
   319	    判据；没有它只能凭记忆猜该改回什么。）"""
   320	    SRC.write_bytes(original)
   321	    print(f"\n⛔ 收到信号 {signum}，已还原源码 sha256={sha(SRC)}", flush=True)
   322	    sys.exit(128 + signum)
   323	
   324	
   325	for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
   326	    signal.signal(_sig, _restore_on_signal)
   327	
   328	results: list[tuple[str, bool]] = []
   329	try:
   330	    for name, expected, layers in MUTATIONS:
   331	        text = original.decode("utf-8")
   332	        for old, new in layers:
   333	            n = text.count(old)
   334	            if n != 1:
   335	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   336	            text = text.replace(old, new)
   337	        SRC.write_text(text, encoding="utf-8")
   338	        if sha(SRC) == base_sha:
   339	            raise SystemExit(f"[{name}] 变异没有真的改到字节")
   340	
   341	        rc, failed, summary = run_suite()
   342	        SRC.write_bytes(original)
   343	        restored = sha(SRC)
   344	
   345	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   346	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   347	        # 「跑完了且有测试失败」的只有 rc=1。
   348	        ok = failed == expected and rc == 1 and restored == base_sha
   349	        results.append((name, ok))
   350	        print(f"{'✅' if ok else '❌'} {name}")
   351	        print(f"   期望红: {sorted(expected)}")
   352	        print(f"   实际红: {sorted(failed)}")
   353	        if failed - expected:
