  2542	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  2543	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  2544	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  2545	
  2546	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  2547	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  2548	    """
  2549	    mod = load_module()
  2550	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  2551	    samples = [
  2552	        "\u200b",
  2553	        "\u200c",
  2554	        "\u200d",
  2555	        "\u2060",
  2556	        "\ufeff",
  2557	        "\u00ad",  # 原表六个
  2558	        "\u2063",
  2559	        "\u200e",
  2560	        "\u200f",
  2561	        "\u061c",
  2562	        "\u034f",  # round-3 新抓
  2563	        "\ufe0f",
  2564	        "\u2062",
  2565	        "\u180e",
  2566	        "\u202e",  # round-3 新抓
  2567	    ]
  2568	    for ch in samples:
  2569	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  2570	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  2571	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  2572	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  2573	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  2574	
  2575	    # 端到端半边: 用 round-3 审查的原始反例形态
  2576	    vault, out = base_vault(tmp_path)
  2577	    inbox = vault / "_待处理"
  2578	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2579	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2580	    # ⛔ 端到端半边走 **frontmatter**：标题侧在用户裁决后已由「标题里写了字算
  2581	    # 实质正文」直接保护，隐形字符再怎么插也走不到护栏 —— 拿它当端到端样本，
  2582	    # 本门就测不到 `_strip_invisible` 那一层（纯函数半边仍直锁该函数）。
  2583	    mk(inbox / "u2063英文声明.md", "---\nnote: Genera\u2063ted by GPT-4\n---\n", age_days=7)
  2584	    mk(inbox / "u2063中文声明.md", "---\nnote: 本文由 GPT-4 生\u2063成\n---\n", age_days=6)
  2585	    mk(
  2586	        inbox / "u2063重复件.md",
  2587	        "---\nnote: Genera\u2063ted by GPT-4\n---\n" + body,
  2588	        age_days=5,
  2589	    )
  2590	    mk(inbox / "无注释骨架.md", "# \n\n## \n", age_days=3)
  2591	
  2592	    assert run_cli(vault, out).returncode == 0
  2593	    data = load_json(out)
  2594	    for name in ("u2063英文声明.md", "u2063中文声明.md", "u2063重复件.md"):
  2595	        it = item_by_name(data, name)
  2596	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2597	        assert it["criterion"] == "C6_undecided", name
  2598	        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2599	    ctrl = item_by_name(data, "无注释骨架.md")
  2600	    assert ctrl["criterion"] == "C3_empty_or_skeleton"
  2601	    assert ctrl["verdict"] == "建议删"
