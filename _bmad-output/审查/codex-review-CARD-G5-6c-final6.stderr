 succeeded in 0ms:
#: ⛔ 第八轮 HIGH：上一版把线画在「同字符重复」上，于是 `||`（逻辑或）被判结构
#: 而删除。真正的分界是**这行是不是 Markdown 的结构记号**：分隔线要 ≥3 个
#: （CommonMark `---`/`***`/`___`），表格分隔要含 `-`，引用/标题记号是 `>`/`#`。
#: `||` 两个竖线既不是分隔线也不是表格分隔，它就是正文。
_ONLY_STRUCT_RE = re.compile(r"^[\s\-=*_|:#>]*$")
_STRUCT_CHARS = "-=*_|:#>"


def _atx_heading_text(ln: str) -> str:
    """ATX 标题行里**真正的标题文字**（去掉 opening 与可选的 closing 序列）。

    ⛔ 第九轮审查 HIGH（R9-H3）：此前用 `ln.lstrip(" \t#")` 一把撸掉所有井号，
    于是 `# # #` 的**中间那个 `#`**（它是可见的标题内容）被当成 opening 的一部分
    剥掉，整行判成空标题 → 文件被确定删除。ATX 的结构是
    `opening(1-6 个 #) + 空白 + content + 可选 closing(全 # 且前有空白)`，
    分离得按这个结构走，不能靠字符集剥离。
    """
    m = re.match(r"^ {0,3}(#{1,6})(?:[ \t]+|$)", ln)
    if not m:
        return ""
    rest = ln[m.end() :].strip()
    # 可选的收尾序列：必须整段是 #，且与内容之间有空白（CommonMark §4.2）
    closing = re.search(r"(?:^|\s)(#+)$", rest)
    if closing and set(closing.group(1)) == {"#"}:
        rest = rest[: closing.start()].strip()
    return rest


def _is_structural_line(t: str) -> bool:
    """纯结构行判定（分隔线 / 表格分隔 / 空列表符）。"""
    if not _ONLY_STRUCT_RE.match(t):
    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
    # 空文件的删除提名，比不提名坏得多。
    for ln in lines[1:end]:
        t = ln.strip()
        if not t or t.startswith("#"):
            continue  # 空行与 YAML 注释不作数
        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
    return end + 1  # 空 frontmatter（`---` 紧接 `---`）


def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
    lines = text.splitlines()
    n = frontmatter_span(lines)
    return (lines[1 : n - 1] if n else []), lines[n:]


def _clean_fm_value(raw: str) -> str:
    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。

    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
    （round-3 自审 H1-6）。
    """
    val = (raw or "").strip()
    val = re.sub(r"\s+#.*$", "", val).strip()
    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
        val = val[1:-1]
    return val


def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。

    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
    于是

        ---
        doi:
        doi: 10.1000/hidden
        ---

    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
    """
    out: list[tuple[str, str]] = []
    for ln in fm_lines:
        m = _FM_KEY_RE.match(ln)
        if m:
            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
    return out


def frontmatter_map(fm_lines: list[str]) -> dict:
    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
    `frontmatter_pairs`。"""
    out: dict[str, str] = {}
    for k, v in frontmatter_pairs(fm_lines):
        out.setdefault(k, v)
    return out


def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool, list[str]]:
    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释, 被注释剥掉过的原文行]。

    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
    分隔行由状态机精确标记，内容行一律是内容。

    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。

    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
    """
    _, rest = split_frontmatter(text)
    rows: list[tuple[str, str]] = []
    stripped_comments: list[str] = []
    in_fence = False
    fence_char = ""
    fence_len = 0
    in_comment = False
    for ln in rest:
        m = _FENCE_RE.match(ln)
        if m and not in_comment:
            tok = m.group(1)
            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
    三态细节见 `_classify_lines_typed`。"""
    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]


def dup_body(text: str) -> str:
    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。

    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
    有后果的提名，依据必须逐字。
    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
    """
    parts: list[str] = []
    for ln, is_code in _classify_lines(text):
        if not is_code and _HEADING_RE.match(ln):
            continue
        # ⛔ 第九轮 HIGH（R9-H1）：此前无条件 `rstrip()` + 丢空行，把**有语义的
        # 空白**一起抹了 —— Markdown 行尾双空格是硬换行、空行是段落边界、围栏
        # 里的空格与空行更是字面内容。于是 `alpha  \nbeta` 与 `alpha\nbeta`
        # 被判「逐字相等」并确定删除。⚠️ 判据名叫「精确重复」，比较形态却是
        # 有损投影 —— 名实不符本身就是缺陷。
        if is_code:
            # 围栏内一律逐字保真（含空行与行尾空格）
            parts.append(nfc(ln))
            continue
        t = ln.rstrip()
        if not t:
            parts.append("")  # 段落边界是语义，不能丢
            continue
        if len(ln) - len(t) >= 2 and not ln[len(t) :].strip():
            t += "  "  # 行尾 ≥2 空格 = 硬换行，保留其语义
        parts.append(nfc(t))
    return "\n".join(parts)


def has_substantive_content(text: str) -> bool:
    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。

            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
            # ⛔ 第八轮 HIGH 收窄措辞：此前写「只剩五种」并逐一列举 —— 那是
            # **数出来的**，实测还有空围栏、空列表、全空值 frontmatter 同样落
            # C3。**数「剩几种」本身就是过宽的写法**：可达面由判据的性质决定，
            # 不由我列举的完整度决定，列举永远会漏。
            # 准确的说法是性质：`has_substantive_content` 找不到任何一个
            # 「剥掉结构记号后还剩字符」的行时，才判空骨架。
            if _atx_heading_text(ln):
                return True
            continue
        t = _LIST_PREFIX_RE.sub("", ln).strip()
        if t and not _is_structural_line(t):
            return True
    return False


def skeleton_note(text: str, size: int) -> str:
    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
        for k, v in fm_pairs
        if not v and _norm_fm_key(k) not in _KNOWN_FM_KEYS
    ]
    # 未消化信号⑩（round-3 审查 HIGH）：被**闭合** HTML 注释剥掉的原文行。
    # ⚠️ 与①（未闭合注释）对称：①保护的是「不知道被吞了什么」，⑩保护的是
    # 「知道被吞了什么，但引擎没消费它」。此前只有①有保护，于是把唯一来源
    # 写在闭合注释里的文件 C3/C4 双出口全穿。只收**注释里有非空内容**的行。
    commented_out = [ln for ln in stripped_comments if ln.strip()] + fm_comment_lines
    # ⛔ 第九轮 HIGH（R9-H2）：文件名进了 item，但护栏一条都不看它 —— 于是
    # `ISBN_978-7-111-54742-6.md`、`DOI_10.1000_xyz.md` 这类**唯一来源写在文件名
    # 里**的材料，正文一撞上库内某份就被确定删除，文件名里的标识零留痕。
    # 判据与既有来源信号同源（URL / DOI 形态），只是扫描面加上文件名。
    # ⚠️ 用模块级判据，不用 judge() 内那个同名闭包 —— 它定义在本行之后。
    # 文件名里的分隔符常被换成 `_`（`DOI_10.1000_xyz.md`、
    # `source_https_example.test_article.md`），故把 `_` 还原成 `:` 与 `/` 各试一遍。
    _stem = name[:-3] if name.endswith(".md") else name
    name_signal = next(
        (
            _stem
            for probe in (
                _stem,
                _stem.replace("_", ":"),
                _stem.replace("_", "/"),
                _stem.replace("_", ":", 1).replace("_", "/"),
            )
            if (
                _URL_RE.match(probe)
                or _looks_like_doi_value(probe)
                or _looks_like_isbn_value(probe)
            )
        ),
        None,
    )

    def undigested_reason() -> str | None:
        """⛔ 「未消化信号」统一护栏（显式偏差 15）：C3/C4 是仅有的两个产出
        「建议删」的判据，命中时若文件带有引擎未能完全消化的结构信号 ——
        未闭合注释 / 解析不成的 frontmatter 行 / 来源声明（source 键或任意
        URL 形态键值）/ 睡眠台账键 / AI 自述嫌疑 —— 一律降 C6 拿不准。
        判据收窄漏掉的文件曾掉进这两个判据被建议删（round-3 自审 H1-1/H3-1 +
        round-4 BLOCKER-1/BLOCKER-2 + round-5 自审 F2/F3 实证）；
        L.append("")
        L.append("**跳过留痕**（不静默消失）：")
        for x in skp:
            L.append(f"- {x['name']} —— {x['reason']}")
    L.append("")

    L.append("## 七、引擎边界（如实声明）")
    L.append("")
    v = d["verdict_vocabulary"]
    L.append(f"- 引擎可达去向：{'、'.join(v['reachable_by_engine'])}")
    L.append(f"- **恒不产出**：{'、'.join(v['human_only'])} —— {v['human_only_note']}")
    L.append(
        "- 近似重复（difflib）**永不**产出建议删：**在重复这条判据里**，只有"
        "归一化正文逐字相等才建议删（另一个建议删的出口是「空/空骨架」，"
        "它跟像不像别的文件无关）；库内只有一份同正文时给正本路径，多份同正文时"
        "给出全部候选并声明「哪一份是正本不可判」。"
    )
    L.append(
        "- 建议删有两个出口（空骨架 / 正文重复），共用一组护栏（如实声明）："
        "在来源链接与 AI 自述都未确定命中时，文件若带下列任一信号 —— "
        "① 以未闭合的 HTML 注释结尾；② frontmatter 含解析不了的行；"
        "③ frontmatter 有来源声明（source 键，键名大小写不敏感；或任意键的值里"
        "含网址、含 DOI 编号）；④ 带睡眠台账键 slept_at；⑤ 文头有疑似 AI 自述；"
        "⑥ 文头或 frontmatter 出现独立的「AI」字样；⑦ 文头出现「由 X 生成」/"
        "「generated by X」这类生成声明；⑧ frontmatter 带 generator/model 之类的"
        "生成器声明键 —— 空骨架不判、重复也不建议删，一律落「拿不准」把证据摆给你。"
        "⚠️ 这八条是**已知形态的登记表**，不是完备判据：它们是被真实反例逐轮"
        "打穿后一条条补上的，没有哪一轮证明了「没有下一条」。"
    )
    L.append(
        "- AI 自述标记为字面量 + 右边界规则（汉字收尾标记后须为行尾/空白/有限标点"
        "表，英文收尾标记后须为行尾/表中标点），仍不做语义否定检测：语义否定"
        "（「这不是由 AI 生成」）与满足边界的话题提及仍可能给出归档提名 —— 依据"
        "带行号与**命中的标记文本**（⚠️ 那是标记表里的规范写法，不是你文件里的"
        "原字，匹配在大小写/空白归一后做；行号是准的），请按行号回看原文再拍板。"
        "⚠️ 漏判方向（该认出是 AI 写的却没认出）：**已登记的**形态由上面 ⑤⑥⑦⑧"
        "四条信号接住落「拿不准」；**未登记的**新写法仍可能被判成空骨架建议删 —— "
        "这条护栏是尽力而为，不是保证。"
    )
    L.append(f"- 判据次序（先命中者定去向）：{' → '.join(d['criteria_order'])}")
    L.append("")
    return "\n".join(L) + "\n"


