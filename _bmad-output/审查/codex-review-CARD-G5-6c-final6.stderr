  1084	def _norm_fm_key(k: str) -> str:
  1085	    """frontmatter 键名归一：casefold + `-`→`_`。
  1086	
  1087	    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
  1088	    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
  1089	    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
  1090	    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
  1091	    """
  1092	    return k.casefold().replace("-", "_")
