  2604	def test_heading_with_text_counts_as_substantive_content(tmp_path):
  2605	    """⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
  2606	
  2607	    起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了标题、正文
  2608	    还没动笔」的日常笔记，旧口径下是 `建议删 + confident=true` —— 那不是对抗
  2609	    构造，是真实使用场景。论证与本卡「取消 frontmatter 白名单」逐字同构：
  2610	    标题可能是随手一个字，也可能是这份材料唯一写下来的东西，引擎分不出，
  2611	    分不出就不该替用户决定。
  2612	    它顺带关闭了 U+3164/U+2800 那条此前未闭合的 BLOCKER —— 隐形字符伪装成正常
  2613	    标题时，标题里仍然「有字」。
  2614	
  2615	    ⚠\ufe0f 代价如实（本门同时锁住代价的边界）：C3 的可确定删除面收窄到「一个字都
  2616	    没写」的五种。这五种是正向对照，一条都不能失守，否则「少删」就变成
  2617	    「判据死了」。
  2618	    """
  2619	    mod = load_module()
  2620	    assert mod.has_substantive_content("# 微积分基本定理的两种证法\n") is True
  2621	    assert mod.has_substantive_content("# \n\n## \n") is False, "空标题模板仍是骨架"
  2622	    assert mod.has_substantive_content("#\t\n") is False, "井号+制表符+空 仍是骨架"
  2623	
  2624	    vault, out = base_vault(tmp_path)
  2625	    inbox = vault / "_待处理"
  2626	    mk(inbox / "只写了标题.md", "# 微积分基本定理的两种证法\n", age_days=9)
  2627	    mk(inbox / "标题加空小节.md", "# 待整理\n\n## \n", age_days=8)
  2628	    # ⛔ 关闭的 BLOCKER：隐形字符伪装成正常标题
  2629	    mk(inbox / "隐形字符标题.md", "# Genera\u3164ted by GPT-4\n", age_days=7)
  2630	    mk(inbox / "盲文空白标题.md", "# Genera\u2800ted by GPT-4\n", age_days=6)
  2631	    # ⛔ 正向对照（验伪锚）：C3 在新口径下**仅剩**的五种可达面
  2632	    mk(inbox / "C3-零字节.md", "", age_days=5)
  2633	    mk(inbox / "C3-纯空行.md", "\n\n\n", age_days=4)
  2634	    mk(inbox / "C3-纯分隔线.md", "---\n\n***\n", age_days=3)
  2635	    mk(inbox / "C3-空标题模板.md", "# \n\n## \n\n### \n", age_days=2)
  2636	    mk(inbox / "C3-只有引用符.md", "> \n> \n", age_days=1)
  2637	
  2638	    assert run_cli(vault, out).returncode == 0
  2639	    data = load_json(out)
  2640	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2641	    for name in ("只写了标题.md", "标题加空小节.md", "隐形字符标题.md", "盲文空白标题.md"):
  2642	        it = item_by_name(data, name)
  2643	        assert it["verdict"] != "建议删", f"{name} 被确定删除了: {it['basis']}"
  2644	        assert it["criterion"] == "C6_undecided", name
  2645	        assert it["confident"] is False, name
  2646	    for name in (
  2647	        "C3-零字节.md",
  2648	        "C3-纯空行.md",
  2649	        "C3-纯分隔线.md",
  2650	        "C3-空标题模板.md",
  2651	        "C3-只有引用符.md",
  2652	    ):
  2653	        ctrl = item_by_name(data, name)
  2654	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  2655	        assert ctrl["verdict"] == "建议删", name
  2656	        assert ctrl["confident"] is True, name
