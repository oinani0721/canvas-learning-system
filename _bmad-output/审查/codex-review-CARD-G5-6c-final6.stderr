  1564	def test_unparsed_source_with_duplicate_body_is_not_suggested_for_deletion(tmp_path):
  1565	    """⛔ round-4 BLOCKER-2: 非标准 source × 正文与库内逐字重复 → 不得建议删。
  1566	
  1567	    C4 只证明「剥掉 frontmatter 后正文相等」, 不证明「整个文件多余」—— 这份
  1568	    还带着一个独有的来源声明(冒号后无空格, 键正则不认)。来源信息必须在建议里
  1569	    摆到台面上; 摆不出来就不许删。护栏拦在 C4 出口, 降 C6 且重复证据留痕。"""
  1570	    vault, out = base_vault(tmp_path)
  1571	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1572	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1573	    mk(
  1574	        vault / "_待处理" / "带来源重复.md",
  1575	        "---\ntitle: 剪藏\nsource:https://unique.example/a\n---\n" + body,
  1576	        age_days=3,
  1577	    )
  1578	    # 正向对照: 无 source 的重复件 → 仍 C4 建议删 (护栏不得误伤存量判据)
  1579	    mk(vault / "_待处理" / "无来源重复.md", body, age_days=2)
  1580	    # ⛔ round-3 审查 HIGH 的修复点: 带**非空**元数据的重复件不再确定删除。
  1581	    # 上一版判 C4 建议删 confident=true, 却同时挂着「正文重复证据不覆盖这些
  1582	    # 元数据」的冲突 —— 报告自己承认证据不足, verdict 却是确定的, 自相矛盾。
  1583	    mk(
  1584	        vault / "_待处理" / "带标签重复.md",
  1585	        "---\ntags: [剪藏, 待整理]\n---\n" + body,
  1586	        age_days=1,
  1587	    )
  1588	    # 正向对照: frontmatter 只有**空值**键 → ⑨ 不触发, 仍 C4 建议删 + 挂冲突留痕。
  1589	    # 这是 `frontmatter_metadata_present` 冲突分支在新口径下的可达面。
  1590	    mk(vault / "_待处理" / "空值键重复.md", "---\ntags:\n---\n" + body, age_days=1)
  1591	
  1592	    assert run_cli(vault, out).returncode == 0
  1593	    data = load_json(out)
  1594	    it = item_by_name(data, "带来源重复.md")
  1595	    assert it["verdict"] != "建议删", f"带来源的重复件被建议删了: {it['basis']}"
  1596	    assert it["criterion"] == "C6_undecided"
  1597	    assert it["confident"] is False
  1598	    assert it["target_hint"] is None and it["nomination_type"] is None
  1599	    assert it["exact_duplicate_of"] == "节点/库内正本.md", "重复证据必须留痕"
  1600	    assert any(c["kind"] == "exact_duplicate_under_other_verdict" for c in it["conflicts"]), "重复证据必须挂冲突留痕"
  1601	    assert "unique.example" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1602	    dup = item_by_name(data, "无来源重复.md")
  1603	    assert dup["criterion"] == "C4_exact_duplicate"
  1604	    assert dup["verdict"] == "建议删"
  1605	    tagged = item_by_name(data, "带标签重复.md")
  1606	    assert tagged["verdict"] != "建议删", f"带非空元数据的重复件被确定删除了: {tagged['basis']}"
  1607	    assert tagged["criterion"] == "C6_undecided"
  1608	    assert tagged["confident"] is False
  1609	    assert tagged["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
  1610	    assert "剪藏" in (tagged["uncertain_reason"] or ""), tagged["uncertain_reason"]
  1611	    empty_key = item_by_name(data, "空值键重复.md")
  1612	    assert empty_key["criterion"] == "C4_exact_duplicate", empty_key["basis"]
  1613	    assert empty_key["verdict"] == "建议删"
  1614	    assert any(c["kind"] == "frontmatter_metadata_present" for c in empty_key["conflicts"]), (
  1615	        "C4 删除前 frontmatter 元数据必须留痕"
  1616	    )
