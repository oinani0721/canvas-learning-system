   355	        if expected - failed:
   356	            print(f"   ⛔ 少红（该防线没有门在测）: {sorted(expected - failed)}")
   357	        print(
   358	            f"   rc={rc} | {summary} | 还原 sha "
   359	            f"{'一致' if restored == base_sha else '⛔不一致'}\n"
   360	        )
   361	finally:
   362	    SRC.write_bytes(original)
   363	    final = sha(SRC)
   364	    print(
   365	        f"finally 还原后 sha256 = {final} "
   366	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   367	    )
   368	
   369	allok = (
   370	    all(ok for _, ok in results)
   371	    and sha(SRC) == base_sha
   372	    and len(results) == len(MUTATIONS)
   373	)
   374	print("\n" + "=" * 70)
   375	print(
   376	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   377	    f"（{sum(1 for _, ok in results if ok)}/{len(MUTATIONS)} 变异的实际失败集合等于预先声明集合）"
   378	)
   379	sys.exit(0 if allok else 1)
