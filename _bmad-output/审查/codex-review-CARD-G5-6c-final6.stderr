  1104	def _looks_like_isbn_value(v: str) -> bool:
  1105	    """值/文件名里含 ISBN 形态的标识符（非空才算）。"""
  1106	    if not v:
  1107	        return False
  1108	    m = _ISBN_RE.search(v)
  1109	    if not m:
  1110	        return False
  1111	    digits = [c for c in m.group(0) if c.isdigit() or c in "Xx"]
  1112	    return len(digits) in (10, 13)
  1113	
  1114	
  1115	def _looks_like_doi_value(v: str) -> bool:
  1116	    """值里含 DOI 形态的来源标识（⛔ substring 级，与 `_looks_like_source_value`
  1117	    同口径）。非空才算 —— 卡文 (d) 要的是「**非空** DOI 来源阻止 C3 删除」。"""
  1118	    return bool(v) and bool(_DOI_RE.search(v))
