   790	def dup_body(text: str) -> str:
   791	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   792	
   793	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   794	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   795	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   796	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   797	    有后果的提名，依据必须逐字。
   798	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   799	    """
   800	    parts: list[str] = []
   801	    for ln, is_code in _classify_lines(text):
   802	        if not is_code and _HEADING_RE.match(ln):
   803	            continue
   804	        # ⛔ 第九轮 HIGH（R9-H1）：此前无条件 `rstrip()` + 丢空行，把**有语义的
   805	        # 空白**一起抹了 —— Markdown 行尾双空格是硬换行、空行是段落边界、围栏
   806	        # 里的空格与空行更是字面内容。于是 `alpha  \nbeta` 与 `alpha\nbeta`
   807	        # 被判「逐字相等」并确定删除。⚠️ 判据名叫「精确重复」，比较形态却是
   808	        # 有损投影 —— 名实不符本身就是缺陷。
   809	        if is_code:
   810	            # 围栏内一律逐字保真（含空行与行尾空格）
   811	            parts.append(nfc(ln))
   812	            continue
   813	        t = ln.rstrip()
   814	        if not t:
   815	            parts.append("")  # 段落边界是语义，不能丢
   816	            continue
   817	        if len(ln) - len(t) >= 2 and not ln[len(t) :].strip():
   818	            t += "  "  # 行尾 ≥2 空格 = 硬换行，保留其语义
   819	        parts.append(nfc(t))
   820	    return "\n".join(parts)
