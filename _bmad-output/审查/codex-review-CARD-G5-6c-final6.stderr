  2399	    unsure = sum(1 for i in data["items"] if not i["confident"])
  2400	    print(
  2401	        f"  本批 {len(data['items'])} 件 · 拿不准 {unsure} 件 · "
  2402	        f"建议删 {sum(1 for i in data['items'] if i['verdict'] == V_DELETE)} 件"
  2403	    )
  2404	    return 0
