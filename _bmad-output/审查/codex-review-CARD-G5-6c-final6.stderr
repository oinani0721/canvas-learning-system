   906	def _norm_ai_line(ln: str) -> str:
   907	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   908	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   909	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   910	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   911	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   912	    return " ".join(ln.split()).casefold()
