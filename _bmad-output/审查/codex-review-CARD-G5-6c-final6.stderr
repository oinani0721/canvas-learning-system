  1070	#:
  1071	#: 现口径（信号⑨）：**frontmatter 里只要有任何非空值，C3/C4 就不确定删除**。
  1072	#: 白名单整个取消 —— 不是收窄，是这条路本身走不通。
  1073	#: ⚠️ 代价如实说：C3 的可达面明显变窄，只剩「0 字节」「没有 frontmatter 的纯
  1074	#: 骨架」「frontmatter 全是空值」三种。这是刻意选的偏向 —— 少删一份的代价是
  1075	#: 用户多看一眼，多删一份的代价是材料没了。
  1076	#: 依据是卡文 §3 默认裁决「未知结构或来源信号至少降级 C6」。
  1077	
  1078	#: DOI 形态（ISO 26324：`10.<registrant>/<suffix>`）。左界排除字母数字与点，
  1079	#: 于是 `DOI:10.1000/xyz`、`doi: 10.1000/xyz`、裸 `10.1000/xyz` 都命中，而
  1080	#: 版本号 `v10.1000/x` 之类不命中。⚠️ 只作来源信号，不解析、不解引用、不联网。
  1081	_DOI_RE = re.compile(r"(?<![0-9A-Za-z.])10\.\d{4,9}/[^\s\"'<>]+")
  1082	
  1083	
  1084	def _norm_fm_key(k: str) -> str:
  1085	    """frontmatter 键名归一：casefold + `-`→`_`。
  1086	
  1087	    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
  1088	    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
  1089	    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
  1090	    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
  1091	    """
  1092	    return k.casefold().replace("-", "_")
  1093	
  1094	
  1095	#: ISBN-10 / ISBN-13：`ISBN` 前缀（可选）+ 9-13 位数字/连字符，末位可为 X。
  1096	#: ⛔ 与 DOI 同源的**正面形态**判定，不是枚举关键词：ISBN 有固定位数与校验位，
  1097	#: 这是它「像个标识符」的结构证据。用于文件名与值两处来源信号。
  1098	_ISBN_RE = re.compile(
  1099	    r"(?<![0-9A-Za-z])(?:ISBN[-\s_:]*)?(?=[\d-]{9,17}[\dXx](?![\d-]))[\d-]{9,17}[\dXx]",
  1100	    re.IGNORECASE,
  1101	)
  1102	
  1103	
  1104	def _looks_like_isbn_value(v: str) -> bool:
  1105	    """值/文件名里含 ISBN 形态的标识符（非空才算）。"""
  1106	    if not v:
  1107	        return False
  1108	    m = _ISBN_RE.search(v)
  1109	    if not m:
  1110	        return False
  1111	    digits = [c for c in m.group(0) if c.isdigit() or c in "Xx"]
  1112	    return len(digits) in (10, 13)
  1113	
  1114	
  1115	def _looks_like_doi_value(v: str) -> bool:
  1116	    """值里含 DOI 形态的来源标识（⛔ substring 级，与 `_looks_like_source_value`
  1117	    同口径）。非空才算 —— 卡文 (d) 要的是「**非空** DOI 来源阻止 C3 删除」。"""
  1118	    return bool(v) and bool(_DOI_RE.search(v))
