   823	def has_substantive_content(text: str) -> bool:
   824	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   825	
   826	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   827	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   828	    合用一个函数正是 Codex BLOCKER 的根因。
   829	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   830	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   831	    （round-3 自审 B3-3）。
   832	    """
   833	    for ln, kind in _classify_lines_typed(text)[0]:
   834	        if kind == "code":
   835	            if ln.strip():
   836	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   837	            continue
   838	        if kind == "fence":
   839	            continue
   840	        if _HEADING_RE.match(ln):
   841	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   842	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   843	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   844	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   845	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   846	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   847	            # 替用户决定。
   848	            # ⛔ **声明收窄（第五轮终审实测证伪）**：本裁决只关闭 **C3 那一半**。
   849	            # C4 侧 `dup_body()` 仍把标题整行丢掉再比对，所以
   850	            # `# 只有这一份写了母本第37页` + 与库内相同的正文，照样是
   851	            # `C4 建议删 + confident=true` —— 标题里的独有信息随重复件一起没了。
   852	            # 我曾在 commit 里写「顺带关闭了 U+3164/U+2800 那条 BLOCKER」，
   853	            # 那句话**过宽**：隐形字符伪装的标题在 C3 侧确实被接住了，
   854	            # 但只要它带着一段与库内重复的正文，C4 侧照样确定删除。
   855	            # 用户第二次裁决（2026-09-02）：**C4 不跟进** —— 让标题进重复比对会
   856	            # 使「同一段正文粘两份、标题不同」不再算重复（5 件取样只剩 1 件被
   857	            # 识别），而那正是清收件箱最常见的场景。保住重复识别，代价如实登记。
   858	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   859	            # ⛔ 第八轮 HIGH 收窄措辞：此前写「只剩五种」并逐一列举 —— 那是
   860	            # **数出来的**，实测还有空围栏、空列表、全空值 frontmatter 同样落
   861	            # C3。**数「剩几种」本身就是过宽的写法**：可达面由判据的性质决定，
