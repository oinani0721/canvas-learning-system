  1338	                item,
  1339	                "C3_empty_or_skeleton",
  1340	                V_DELETE,
  1341	                None,
  1342	                None,
  1343	                "0 字节空文件",
  1344	                True,
  1345	                conflicts=conflicts,
  1346	            )
