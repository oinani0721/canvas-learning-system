  2381	        )
  2382	    excluded = [inbox_real, out_real]
  2383	
  2384	    data = build_preview(vault, inbox, inbox_exists, now, args.batch_size, excluded)
  2385	    payload_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
  2386	    payload_md = render_md(data)
  2387	
  2388	    out_dir = _SP.prepare_out_dir(out_dir_arg)
  2389	    json_path = out_dir / f"inbox-preview-{inbox.name}.json"
  2390	    md_path = out_dir / f"inbox-preview-{inbox.name}.md"
  2391	    _SP.write_pair_atomically_checked(
