  1348	            item,
  1349	            "C6_undecided",
  1350	            V_UNSURE,
  1351	            None,
  1352	            None,
  1353	            "非 UTF-8 文本，本引擎不解析其正文",
  1354	            False,
  1355	            uncertain_reason="非 UTF-8 文本（如 PDF / 图片），六判据中除「0 字节」外无一可施加",
  1356	            ask=UNDECIDED_ASK,
  1357	            conflicts=conflicts,
