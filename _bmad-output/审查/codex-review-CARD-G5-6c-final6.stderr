  2347	
  2348	    # ⛔ 次序铁律：全部输入守卫跑完**再**碰 out-dir —— 拒绝路径必须零产物。
  2349	    if not (1 <= args.batch_size <= BATCH_MAX):
  2350	        raise SystemExit(
