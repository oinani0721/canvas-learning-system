  1619	def test_source_like_keys_are_undigested_signals(tmp_path):
  1620	    """⛔ round-5 自审 F2 (BLOCKER): 来源声明信号不能只认字面 source 键 ——
  1621	    `url:`/`URL:`/`Source:` 等剪藏工具常见键名曾穿透全部信号: 无正文判 C3 建议删、
  1622	    带独有 URL 的重复件判 C4 建议删且 URL 零留痕。任意键的值为合法 URL 形态
  1623	    即为来源声明信号(降 C6); C1 仍只认 source 键(R8 稿约定), 信号只降级不扩大。"""
  1624	    vault, out = base_vault(tmp_path)
  1625	    inbox = vault / "_待处理"
  2520	        "注释里的ISBN.md",
  2521	        "注释里的生成声明.md",
  2522	        "注释里的URL重复件.md",
  2523	        "多行注释来源.md",
  2524	        "fm里YAML注释.md",
  2525	        "fm行尾注释.md",
  2526	    ):
  2527	        it = item_by_name(data, name)
