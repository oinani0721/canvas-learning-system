   264	        """
   265	        if FSRS_AVAILABLE:
   266	            # ✅ Verified from Context7 - Check Next Due Date
   267	            return getattr(card, "due", None)
   268	        else:
   269	            return card.get("due") if isinstance(card, dict) else None
