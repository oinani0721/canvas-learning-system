   360	                    # 正参数属矛盾形状: 保留并告警, 不猜成 Review。
   361	                    card.state = State.Learning
   362	                    if not card.stability:
   363	                        card.stability = None
   364	                    if not card.difficulty:
   365	                        card.difficulty = None
   366	                    if (
   367	                        card_dict.get("stability")
   368	                        or card_dict.get("reps")
   369	                        or card_dict.get("last_review")
   370	                    ):
   371	                        logger.warning(
   372	                            "legacy state:0 record carries non-empty params "
   373	                            "(stability=%s, reps=%s, last_review=%s) — mapped "
   374	                            "to Learning with params preserved",
   375	                            card_dict.get("stability"),
   376	                            card_dict.get("reps"),
   377	                            card_dict.get("last_review"),
   378	                        )
   379	                else:
   380	                    card.state = State(raw_state)
   381	            if "reps" in card_dict:
   382	                card.reps = card_dict["reps"]
   383	            if "lapses" in card_dict:
   384	                card.lapses = card_dict["lapses"]
   385	            if card_dict.get("last_review"):
   386	                card.last_review = datetime.fromisoformat(card_dict["last_review"])
   387	
   388	            return card
   389	        else:
   390	            # Return dict for fallback
   391	            if card_dict.get("due"):
   392	                card_dict["due"] = datetime.fromisoformat(card_dict["due"])
   393	            if card_dict.get("state") == 0:
   394	                # legacy New → Learning (与真实分支同规则)。数值参数保留:
   395	                # fallback 调度算术依赖数值而非 None 哨兵 (_fallback_review)。
   396	                card_dict["state"] = 1
   397	            return card_dict
   398	
   399	    def card_to_state(self, card: Any, concept: str, canvas_file: str) -> CardState:
   400	        """
   401	        Convert FSRS card to CardState for database storage.
   402	
   403	        Args:
   404	            card: FSRS Card object
   405	            concept: Concept name
   406	            canvas_file: Canvas file path
   407	
   408	        Returns:
   409	            CardState object
   410	        """
   411	        if FSRS_AVAILABLE:
   412	            # fsrs 6.x new-card semantics: keep None as None (see serialize_card)
   413	            difficulty = getattr(card, "difficulty", None)
   414	            stability = getattr(card, "stability", None)
   415	            return CardState(
   416	                concept=concept,
   417	                canvas_file=canvas_file,
   418	                difficulty=float(difficulty) if difficulty is not None else None,
   419	                stability=float(stability) if stability is not None else None,
   420	                due=card.due if hasattr(card, "due") else None,
   421	                # 兜底 1 而非 0: fsrs 6.x 无 New(0) 态, 写侧不得产出非法值
   422	                state=int(card.state.value) if hasattr(card, "state") else 1,
   423	                last_review=card.last_review if hasattr(card, "last_review") else None,
   424	                reps=int(card.reps) if hasattr(card, "reps") else 0,
   425	                lapses=int(card.lapses) if hasattr(card, "lapses") else 0,
   426	                card_data=self.serialize_card(card),
   427	            )
   428	        else:
   429	            return CardState(
   430	                concept=concept,
   431	                canvas_file=canvas_file,
   432	                difficulty=card.get("difficulty", 0.0),
   433	                stability=card.get("stability", 0.0),
   434	                due=card.get("due"),
   435	                state=card.get("state") or 1,  # 0/缺失 → Learning, 写侧不产 0
   436	                last_review=card.get("last_review"),
   437	                reps=card.get("reps", 0),
   438	                lapses=card.get("lapses", 0),
   439	                card_data=self.serialize_card(card),
   440	            )
   441	
   442	    def state_to_card(self, state: CardState) -> Any:
   443	        """
   444	        Convert CardState back to FSRS card.
   445	
   446	        Args:
   447	            state: CardState object
   448	
   449	        Returns:
   450	            FSRS Card object
   451	        """
   452	        if state.card_data:
   453	            return self.deserialize_card(state.card_data)
   454	        else:
   455	            return self.create_card()
   456	
   457	
   458	def get_rating_from_score(score: float) -> int:
   459	    """
   460	    Convert a 0-100 score to FSRS Rating.
   461	
   462	    Args:
   463	        score: Score from 0 to 100
   464	
   465	    Returns:
   466	        Rating value (1-4)
   467	    """
   468	    # ✅ Verified from Context7 - Rating Values
   469	    # Rating.Again (==1) - forgot
   470	    # Rating.Hard (==2) - serious difficulty
   471	    # Rating.Good (==3) - hesitation
   472	    # Rating.Easy (==4) - easily
   473	    if score < 40:
   474	        return Rating.Again  # 1
   475	    elif score < 60:
   476	        return Rating.Hard  # 2
   477	    elif score < 85:
   478	        return Rating.Good  # 3
   479	    else:
   480	        return Rating.Easy  # 4

