   239	            except Exception:
   240	                return 0.5  # Default if calculation fails
   241	        else:
   242	            # Fallback: estimate based on time since last review
   243	            if isinstance(card, dict):
   244	                stability = card.get("stability", 1.0)
   245	                due = card.get("due")
   246	                if due and stability > 0:
   247	                    now = datetime.now(timezone.utc)
   248	                    days_overdue = (now - due).days if now > due else 0
   249	                    # Simple exponential decay
   250	                    import math
   251	
   252	                    return math.exp(-days_overdue / max(stability, 1))
   253	            return 0.5
