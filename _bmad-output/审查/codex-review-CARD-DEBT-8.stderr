   175	            # Rating.Again (==1) forgot the card
   176	            # Rating.Hard (==2) remembered with serious difficulty
   177	            # Rating.Good (==3) remembered after hesitation
   178	            # Rating.Easy (==4) remembered easily
   179	            rating_enum = Rating(rating)
