   162	    def review_card(self, card: Any, rating: int) -> Tuple[Any, Any]:
   163	        """
   164	        Review a card with a rating.
   165	
   166	        Args:
   167	            card: FSRS Card object
   168	            rating: Rating value (1=Again, 2=Hard, 3=Good, 4=Easy)
   169	
   170	        Returns:
   171	            Tuple of (updated_card, review_log)
   172	        """
   173	        if FSRS_AVAILABLE:
   174	            # ✅ Verified from Context7 - Review Card with Rating
   175	            # Rating.Again (==1) forgot the card
   176	            # Rating.Hard (==2) remembered with serious difficulty
   177	            # Rating.Good (==3) remembered after hesitation
   178	            # Rating.Easy (==4) remembered easily
   179	            rating_enum = Rating(rating)
