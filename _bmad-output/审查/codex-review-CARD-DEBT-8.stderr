  1725	    async def get_multi_review_progress(
  1726	        self, original_canvas_path: str
  1727	    ) -> Dict[str, Any]:
  1728	        """
  1729	        Get multi-review trend analysis for an original canvas.
  1730	
  1731	        Queries Graphiti for all verification canvases generated from
  1732	        this original canvas and calculates trend metrics.
  1733	
  1734	        ✅ Verified from Story 24.4 Dev Notes (lines 230-267)
  1735	        [Source: specs/api/review-api.openapi.yml#L346-378]
  1736	
  1737	        Args:
  1738	            original_canvas_path: Path to the original canvas file
  1739	
  1740	        Returns:
  1741	            MultiReviewProgressResponse dict with reviews and trends
  1742	
  1743	        Raises:
  1744	            CanvasNotFoundException: If no review history exists
  1745	        """
  1746	        # Query Graphiti for review sessions (Story 24.4)
  1747	        reviews = await self._query_review_sessions_from_memory(original_canvas_path)
  1748	
  1749	        if not reviews:
  1750	            raise CanvasNotFoundException(
  1751	                f"No review history for: {original_canvas_path}"
  1752	            )
  1753	
  1754	        # Calculate trends
  1755	        trends = self._calculate_trend_analysis(reviews)
  1756	
  1757	        return {
  1758	            "original_canvas_path": original_canvas_path,
  1759	            "review_count": len(reviews),
  1760	            "reviews": reviews,
  1761	            "trends": trends,
  1762	        }
  1763	
  1764	    async def _query_review_sessions_from_memory(
  1765	        self, original_canvas_path: str
  1766	    ) -> List[Dict[str, Any]]:
  1767	        """
  1768	        Query LearningMemoryClient (JSON storage) for all review sessions linked to original canvas.
  1769	
  1770	        Renamed from _query_review_sessions_from_graphiti: uses LearningMemoryClient
  1771	        (JSON-backed), not graphiti-core. See Task 10 fake naming cleanup.
  1772	
  1773	        ✅ Verified from Story 24.4 Dev Notes (lines 268-316)
  1774	        [Source: docs/architecture/decisions/0003-graphiti-memory.md]
  1775	
  1776	        Cypher Query Pattern (for future Neo4j):
  1777	        MATCH (review:ReviewCanvas)-[r:GENERATED_FROM]->(original:Canvas {path: $path})
  1778	        RETURN review, r.mode, r.generated_at
  1779	        ORDER BY r.generated_at DESC
  1780	
  1781	        For now, using JSON storage via LearningMemoryClient.
  1782	
  1783	        Args:
  1784	            original_canvas_path: Path to the original canvas file
  1785	
  1786	        Returns:
  1787	            List of review session dicts
  1788	        """
  1789	        if not self.graphiti_client:
  1790	            logger.warning(
  1791	                "功能 %s 降级运行: %s 为 None，返回默认值 %s",
  1792	                "get_review_sessions",
  1793	                "graphiti_client",
  1794	                "[]",
  1795	            )
  1796	            return []
  1797	
  1798	        try:
  1799	            # Story 36.7: Uses LearningMemoryClient (supports both JSON and Neo4j backends)
  1800	            from app.clients.graphiti_client import get_learning_memory_client
  1801	
  1802	            memory_client = get_learning_memory_client()
  1803	            await memory_client.initialize()
  1804	
  1805	            # Get all learning episodes for this canvas
  1806	            # Filter for verification canvas pattern: *-检验白板-*
  1807	            all_memories = await memory_client.get_learning_history(
  1808	                original_canvas_path, limit=100
  1809	            )
  1810	
  1811	            # Group by verification canvas sessions
  1812	            review_sessions: Dict[str, Dict[str, Any]] = {}
  1813	
  1814	            for memory in all_memories:
  1815	                # Check if this is from a verification canvas
  1816	                source = memory.get("source_canvas", "")
  1817	                if "-检验白板-" not in source:
  1818	                    continue
  1819	
  1820	                # Extract session info
  1821	                if source not in review_sessions:
  1822	                    review_sessions[source] = {
  1823	                        "review_canvas_path": source,
  1824	                        "date": memory.get("timestamp", datetime.now(timezone.utc)),
  1825	                        "mode": memory.get("mode", "fresh"),
  1826	                        "concepts": [],
  1827	                        "scores": [],
  1828	                    }
  1829	
  1830	                # Add concept score
  1831	                score = memory.get("score")
  1832	                if score is not None:
  1833	                    review_sessions[source]["concepts"].append(
  1834	                        memory.get("concept", "")
  1835	                    )
  1836	                    review_sessions[source]["scores"].append(score)
  1837	
  1838	            # Transform to ReviewEntry format
  1839	            reviews = []
  1840	            for session_data in review_sessions.values():
  1841	                scores = session_data["scores"]
  1842	                if not scores:
  1843	                    continue
  1844	
  1845	                total_concepts = len(scores)
  1846	                passed_concepts = sum(1 for s in scores if s >= 24)  # >= 60% threshold
  1847	                pass_rate = (
  1848	                    passed_concepts / total_concepts if total_concepts > 0 else 0.0
  1849	                )
  1850	
  1851	                reviews.append(
  1852	                    {
  1853	                        "review_canvas_path": session_data["review_canvas_path"],
  1854	                        "date": session_data["date"],
  1855	                        "mode": session_data["mode"],
  1856	                        "pass_rate": pass_rate,
  1857	                        "total_concepts": total_concepts,
  1858	                        "passed_concepts": passed_concepts,
  1859	                    }
  1860	                )
  1861	
  1862	            # Sort by date descending (newest first)
  1863	            reviews.sort(key=lambda x: x["date"], reverse=True)
  1864	
  1865	            logger.info(
  1866	                f"Found {len(reviews)} review sessions for {original_canvas_path}"
  1867	            )
  1868	            return reviews
  1869	
  1870	        except (
  1871	            ConnectionError,
  1872	            TimeoutError,
  1873	            ValueError,
  1874	            KeyError,
  1875	            TypeError,
  1876	            AttributeError,
  1877	        ) as e:
  1878	            logger.error(f"Error querying review history: {e}")
  1879	            return []
  1880	
  1881	    def _calculate_trend_analysis(
  1882	        self, reviews: List[Dict[str, Any]]
  1883	    ) -> Optional[Dict[str, Any]]:
  1884	        """
  1885	        Calculate trend metrics from review history.
  1886	
  1887	        ✅ Verified from Story 24.4 Dev Notes (lines 317-362)
  1888	
  1889	        Includes:
  1890	        - pass_rate_trend: Time series of pass rates
  1891	        - weak_concepts_improvement: Per-concept improvement tracking
  1892	        - overall_progress: Aggregate progress metrics
  1893	
  1894	        Args:
  1895	            reviews: List of review entry dicts
  1896	
  1897	        Returns:
  1898	            TrendAnalysis dict or None if insufficient data
  1899	        """
  1900	        if not reviews:
  1901	            return None
  1902	
  1903	        # Pass rate trend (newest first in reviews, reverse for chronological chart)
  1904	        pass_rate_trend = [
  1905	            {
  1906	                "date": r["date"].split("T")[0]
  1907	                if isinstance(r["date"], str)
  1908	                else r["date"].strftime("%Y-%m-%d"),
  1909	                "pass_rate": r["pass_rate"],
  1910	            }
  1911	            for r in reversed(reviews)
  1912	        ]
  1913	
  1914	        # Calculate overall progress
  1915	        if len(reviews) >= 2:
  1916	            first_pass_rate = reviews[-1]["pass_rate"]  # Oldest
  1917	            last_pass_rate = reviews[0]["pass_rate"]  # Newest
  1918	            progress_rate = last_pass_rate - first_pass_rate
  1919	
  1920	            if progress_rate > 0.05:
  1921	                trend_direction = "up"
  1922	            elif progress_rate < -0.05:
  1923	                trend_direction = "down"
  1924	            else:
  1925	                trend_direction = "stable"
  1926	        else:
  1927	            progress_rate = 0.0
  1928	            trend_direction = "stable"
  1929	
  1930	        return {
  1931	            "pass_rate_trend": pass_rate_trend,
  1932	            "weak_concepts_improvement": [],  # Populated by separate query if needed
  1933	            "overall_progress": {
  1934	                "progress_rate": progress_rate,
  1935	                "trend_direction": trend_direction,
  1936	            },
  1937	        }
  1938	
  1939	    async def _query_weak_concepts_improvement(
  1940	        self, original_canvas_path: str
  1941	    ) -> List[Dict[str, Any]]:
  1942	        """
  1943	        Query Graphiti for weak concept improvement over time.
  1944	
  1945	        ✅ Verified from Story 24.4 Dev Notes (lines 404-456)
  1946	
  1947	        Tracks concepts that were weak (score < 60) in early reviews
  1948	        and their current status.
  1949	
  1950	        Args:
  1951	            original_canvas_path: Path to the original canvas file
  1952	
  1953	        Returns:
  1954	            List of WeakConceptImprovement dicts
  1955	        """
  1956	        if not self.graphiti_client:
  1957	            logger.warning(
  1958	                "功能 %s 降级运行: %s 为 None，返回默认值 %s",
  1959	                "get_weak_concept_improvement",
  1960	                "graphiti_client",
  1961	                "[]",
  1962	            )
  1963	            return []
  1964	
  1965	        try:
  1966	            from app.clients.graphiti_client import get_learning_memory_client
  1967	
  1968	            memory_client = get_learning_memory_client()
  1969	            await memory_client.initialize()
  1970	
  1971	            # Get all verification session memories
  1972	            all_memories = await memory_client.get_learning_history(
  1973	                original_canvas_path, limit=200
  1974	            )
  1975	
  1976	            # Filter for verification canvas sessions
  1977	            verification_memories = [
  1978	                m for m in all_memories if "-检验白板-" in m.get("source_canvas", "")
  1979	            ]
  1980	
  1981	            # Group by concept
  1982	            concept_scores: Dict[str, List[Dict[str, Any]]] = {}
  1983	            for memory in verification_memories:
  1984	                concept = memory.get("concept", "")
  1985	                score = memory.get("score")
  1986	                timestamp = memory.get("timestamp")
  1987	
  1988	                if concept and score is not None and timestamp:
  1989	                    if concept not in concept_scores:
  1990	                        concept_scores[concept] = []
  1991	                    concept_scores[concept].append(
  1992	                        {"score": score, "timestamp": timestamp}
  1993	                    )
  1994	
  1995	            # Calculate improvement for each concept
  1996	            improvements = []
  1997	            for concept_name, score_history in concept_scores.items():
  1998	                # Sort by timestamp
  1999	                score_history.sort(key=lambda x: x["timestamp"])
  2000	
  2001	                first_score = score_history[0]["score"]
  2002	                last_score = score_history[-1]["score"]
  2003	
  2004	                # Only include if initially weak (< 60%)
  2005	                if first_score < 24:  # 24/40 = 60%
  2006	                    improvement_rate = (
  2007	                        last_score - first_score
  2008	                    ) / 40  # Normalize to 0-1
  2009	
  2010	                    # Determine status
  2011	                    if last_score >= 32:  # >= 80%
  2012	                        status = "mastered"
  2013	                    elif last_score > first_score:
  2014	                        status = "improving"
  2015	                    else:
  2016	                        status = "weak"
  2017	
  2018	                    improvements.append(
  2019	                        {
  2020	                            "concept_name": concept_name,
  2021	                            "improvement_rate": max(0, improvement_rate),
  2022	                            "current_status": status,
  2023	                        }
  2024	                    )
  2025	
  2026	            # Sort by improvement_rate descending
  2027	            improvements.sort(key=lambda x: x["improvement_rate"], reverse=True)
  2028	
  2029	            return improvements
  2030	
  2031	        except (
  2032	            ConnectionError,
  2033	            TimeoutError,
  2034	            ValueError,
  2035	            KeyError,
  2036	            TypeError,
  2037	            AttributeError,
  2038	        ) as e:
  2039	            logger.error(f"Error querying weak concept improvement: {e}")
  2040	            return []
  2041	
  2042	    # ═══════════════════════════════════════════════════════════════════════════════
  2043	    # Story 32.2 Task 4: FSRS Card State Persistence
  2044	    # [Source: docs/stories/32.2.story.md#Task-4]
  2045	    # ═══════════════════════════════════════════════════════════════════════════════
  2046	
  2047	    async def load_card_state(
  2048	        self, concept_id: str, canvas_name: Optional[str] = None
  2049	    ) -> Optional[str]:
  2050	        """
  2051	        Load FSRS card state from the in-memory cache (file-backed, P0-2).
  2052	
  2053	        Story 32.2 AC-32.2.4: Backward compatible - returns None for new concepts.
  2054	        CARD-C4 (G-FAKE-007): 原 "load from Graphiti" 读侧死块已下线——它查询
  2055	        的 LearningMemoryClient 是本地 JSON 存储, 其 canonical schema
  2056	        (add_learning_episode/LearningMemory) 从不承载 card_data 字段: 历史
  2057	        普通学习记录存在, 但 FSRS 卡镜像从未被持久化过, 死块按 card_data
  2058	        过滤故永远返回 None (详见 docs/known-gotchas.md G-FAKE-007)。真接
  2059	        Graphiti 须等 epic-5a C-1/C-2 契约 (episode schema 归主干工程独占)。
  2060	
  2061	        Args:
  2062	            concept_id: Concept identifier
  2063	            canvas_name: Unused; kept for call-site compatibility
  2064	
  2065	        Returns:
  2066	            Serialized card JSON string or None if not found
  2067	        """
  2068	        if concept_id in self._card_states:
  2069	            logger.debug(f"Loaded card state from memory cache: {concept_id}")
  2070	            return self._card_states[concept_id]
  2071	
  2072	        return None
  2073	
  2074	    async def save_card_state(
  2075	        self,
  2076	        concept_id: str,
  2077	        card_data: str,
  2078	        canvas_name: str,
  2079	        rating: int,
  2080	        score: Optional[float] = None,
  2081	    ) -> bool:
  2082	        """
  2083	        Save FSRS card state to the in-memory cache + JSON file (P0-2).
  2084	
  2085	        Story 32.2 AC-32.2.4: Stores card state for later scheduling.
  2086	        CARD-C4 (G-FAKE-007): 原 "persist to Graphiti" 幻影调用已下线——
  2087	        它调用的方法在整个 git 历史中从未定义, 每次抛 AttributeError 被吞
  2088	        后记 warning, 但 return True 不区分镜像失败, 且源码含永远不可达的
  2089	        "已存入 Graphiti" 成功日志 (详见 docs/known-gotchas.md G-FAKE-007);
  2090	        底层 LearningMemoryClient 也非 Graphiti 而是本地 JSON。文件通道
  2091	        (_save_card_states) 是唯一真实持久化。真接 Graphiti 须等 epic-5a
  2092	        C-1/C-2 契约。
  2093	
  2094	        Args:
  2095	            concept_id: Concept identifier
  2096	            card_data: Serialized FSRS card JSON
  2097	            canvas_name: Unused; kept for call-site compatibility
  2098	            rating: Unused; kept for call-site compatibility
  2099	            score: Unused; kept for call-site compatibility
  2100	
  2101	        Returns:
  2102	            True if persisted to file; False if the file write failed
  2103	            (in-memory cache still updated, lost on restart). Codex HIGH-1:
  2104	            返回值必须如实反映唯一真实通道的结果。
  2105	        """
  2106	        # CARD-D3 Codex HIGH-2: mutation 随 pending 进锁内
  2107	        persisted = await self._save_card_states(pending=(concept_id, card_data))
  2108	        logger.debug(f"Saved card state to memory cache: {concept_id}")
  2109	        return persisted
  2110	
  2111	    def get_cached_card_states(self) -> Dict[str, str]:
  2112	        """
  2113	        Get all cached card states.
  2114	
  2115	        Returns:
  2116	            Dictionary of concept_id -> card_data JSON
  2117	        """
  2118	        return dict(self._card_states)
  2119	
  2120	    # ═══════════════════════════════════════════════════════════════════════════════
  2121	    # Story 32.3: FSRS State Query for Plugin Priority Calculation
  2122	    # [Source: docs/stories/32.3.story.md#Task-1]
  2123	    # ═══════════════════════════════════════════════════════════════════════════════
  2124	
  2125	    async def get_fsrs_state(self, concept_id: str) -> Optional[Dict[str, Any]]:
  2126	        """
  2127	        Get FSRS state for a concept for plugin priority calculation.
  2128	
  2129	        Story 32.3 AC-32.3.1: Plugin queries backend for FSRS state.
  2130	        Story 32.3 AC-32.3.2: Returns stability, difficulty, state, reps, lapses,
  2131	                              retrievability, due.
  2132	        Story 32.3 AC-32.3.3: Includes full card_state JSON for plugin caching.
  2133	
  2134	        Args:
  2135	            concept_id: Concept identifier (node_id from canvas)
  2136	
  2137	        Returns:
  2138	            Dict with FSRS state fields and card_state JSON, or None if not found
  2139	        """
  2140	        logger.debug(f"Getting FSRS state for concept: {concept_id}")
  2141	
  2142	        # Story 32.3: Try to get card from cache or persistence
  2143	        if self._fsrs_manager is None:
  2144	            logger.warning(
  2145	                "功能 %s 降级运行: %s 为 None，返回默认值 %s",
  2146	                "get_fsrs_state",
  2147	                "fsrs_manager",
  2148	                "found=False",
  2149	            )
  2150	            return {"found": False, "reason": "fsrs_not_initialized"}
  2151	
  2152	        try:
  2153	            # Check in-memory cache first
  2154	            card_data = self._card_states.get(concept_id)
  2155	
  2156	            if not card_data:
  2157	                # Try to load from persistence
  2158	                card_data = await self.load_card_state(concept_id)
  2159	
  2160	            if not card_data:
  2161	                # Story 38.3 AC-4: Auto-create default FSRS card for new concepts
  2162	                logger.info(
  2163	                    f"Auto-creating default FSRS card for concept: {concept_id}"
  2164	                )
  2165	                card = self._fsrs_manager.create_card()
  2166	                card_data = self._fsrs_manager.serialize_card(card)
  2167	                # Cache the newly created card + persist to file (P0-2).
  2168	                # CARD-C4 (G-FAKE-007): 原 fire-and-forget "_persist_auto_created_card"
  2169	                # 后台任务已下线——它调用的方法从未存在 (详见 known-gotchas
  2170	                # G-FAKE-007), 每次必失败只留 warning + 计数器, 从未写入过任何
  2171	                # 存储。文件通道即唯一真实持久化; 真接 Graphiti 须等 epic-5a
  2172	                # C-1/C-2 契约。
  2173	                # CARD-D3: 消费返回值 — auto-create 写失败时卡只活在内存,
  2174	                # 重启后消失、due 被重置, 必须让调用方看见 (persisted=False)。
  2175	                # Codex HIGH-2: mutation 随 pending 进锁内。
  2176	                auto_created = True
  2177	                persisted = await self._save_card_states(
  2178	                    pending=(concept_id, card_data)
  2179	                )
  2180	                if not persisted:
  2181	                    logger.warning(
  2182	                        f"Auto-created FSRS card for {concept_id} NOT persisted "
  2183	                        f"(file write failed) — card exists in memory only"
  2184	                    )
  2185	            else:
  2186	                # Deserialize existing card
  2187	                card = self._fsrs_manager.deserialize_card(card_data)
  2188	                # CARD-D3 Codex HIGH-1: 缓存命中不得无条件视为已持久化 —
  2189	                # 此前写失败的 concept 在 _unpersisted_concepts 里, 命中它
  2190	                # 必须继续如实上报 False (锁内读: 与在途写串行, 写者失败
  2191	                # add / 成功 clear 之后本读取才进行)。
  2192	                auto_created = False
  2193	                async with _card_states_lock:
  2194	                    persisted = concept_id not in self._unpersisted_concepts
  2195	
  2196	            # Get retrievability (current recall probability)
  2197	            retrievability = self._fsrs_manager.get_retrievability(card)
  2198	
  2199	            # Get due date
  2200	            due_date = self._fsrs_manager.get_due_date(card)
  2201	
  2202	            # Extract state value safely
  2203	            state_val = getattr(card, "state", 0)
  2204	            if hasattr(state_val, "value"):
  2205	                state_int = int(state_val.value)
  2206	            elif hasattr(state_val, "__int__"):
  2207	                state_int = int(state_val)
  2208	            else:
  2209	                state_int = 0
  2210	
  2211	            # fsrs 6.x new cards: stability/difficulty are None until first
  2212	            # review. card_state (below) keeps the authoritative JSON null for
  2213	            # roundtrip; these two display fields fall back to the Story 38.3
  2214	            # AC-4 default-card contract (stability=1.0, difficulty=5.0)
  2215	            # because FSRSStateResponse requires float (difficulty ge=1) and
  2216	            # the API layer forwards them via result.get().
  2217	            stability = getattr(card, "stability", None)
  2218	            difficulty = getattr(card, "difficulty", None)
  2219	            result = {
  2220	                "found": True,
  2221	                # CARD-D3: found=True 只说明卡存在 (可能仅内存), persisted
  2222	                # 才是持久层的真话; reason 仅在失败时出现 (避免 None 值
  2223	                # 破坏既有 result.get("reason", "") 消费方)。
  2224	                "persisted": persisted,
  2225	                "stability": float(stability) if stability is not None else 1.0,
  2226	                "difficulty": float(difficulty) if difficulty is not None else 5.0,
  2227	                "state": state_int,
  2228	                "reps": int(getattr(card, "reps", 0)),
  2229	                "lapses": int(getattr(card, "lapses", 0)),
  2230	                "retrievability": retrievability,
  2231	                "due": due_date,
  2232	                "last_review": getattr(card, "last_review", None),
  2233	                "card_state": card_data,  # Full JSON for plugin to cache/deserialize
  2234	            }
  2235	            if not persisted:
  2236	                result["reason"] = (
  2237	                    "auto_created_not_persisted"
  2238	                    if auto_created
  2239	                    else "cached_state_not_persisted"
  2240	                )
  2241	            # CARD-DEBT-8: 底层 py-fsrs 缺失时加性声明降级（真实库在位
  2242	            # 不加键, 响应逐键与此前相同）。retrievability/due 此时来自
  2243	            # fallback 估算, 消费方须能看见这不是 FSRS-4.5 的输出。
  2244	            if not self._fsrs_library_ok():
  2245	                result["algorithm"] = "fsrs-fallback-scheduler"
  2246	                result["degraded_reason"] = "fsrs_library_missing"
  2247	
  2248	            logger.debug(
  2249	                f"FSRS state for {concept_id}: stability={result['stability']:.2f}, "
  2250	                f"difficulty={result['difficulty']:.2f}, retrievability={f'{retrievability:.3f}' if retrievability is not None else 'N/A'}"
  2251	            )
  2252	
  2253	            return result
  2254	
  2255	        # INTENTIONAL: API-facing endpoint; third-party FSRS library may raise unpredictable errors
  2256	        except Exception as e:
  2257	            logger.error(f"Error getting FSRS state for {concept_id}: {e}")
  2258	            return {"found": False, "reason": f"error: {e}"}
  2259	
  2260	    async def cleanup(self) -> None:
  2261	        """
  2262	        Cleanup resources when service is no longer needed.
  2263	
  2264	        Note: _card_states is NOT cleared here because it is shared persistent state
  2265	        that survives across requests. Clearing it would cause unnecessary file re-reads.
  2266	
  2267	        [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#依赖注入设计]
  2268	        """
  2269	        self._initialized = False
  2270	        self._task_canvas_map.clear()
  2271	        # H1 fix: Do NOT clear _card_states — it's cross-request persistent cache.
  2272	        # Clearing here causes data loss when DI yield calls cleanup after each request.
  2273	        logger.debug("ReviewService cleanup completed")
  2274	
  2275	
  2276	# ═══════════════════════════════════════════════════════════════════════════════
  2277	# Story 38.9: ReviewService Singleton Factory (canonical entry point)
  2278	# Pattern: async double-check lock (aligned with get_memory_service in memory_service.py)
  2279	# ═══════════════════════════════════════════════════════════════════════════════
  2280	
  2281	_review_service_singleton: Optional["ReviewService"] = None
  2282	_review_service_singleton_lock = asyncio.Lock()
  2283	
  2284	
  2285	async def get_review_service() -> "ReviewService":
  2286	    """Get or create the ReviewService singleton.
  2287	
  2288	    Story 38.9 AC1: Canonical singleton factory with double-check lock.
  2289	    All consumers (dependencies.py, review.py endpoints) must use this
  2290	    single entry point to ensure DI alignment.
  2291	
  2292	    Dependencies created:
  2293	    - CanvasService with memory_client (EPIC-36 P0 fix)
  2294	    - BackgroundTaskManager
  2295	    - FSRSManager via create_fsrs_manager() (Story 32.8)
  2296	    - graphiti_client via get_graphiti_temporal_client() (Story 34.8 AC2)
  2297	    """
  2298	    global _review_service_singleton
  2299	    if _review_service_singleton is not None:
  2300	        return _review_service_singleton
  2301	
  2302	    async with _review_service_singleton_lock:
  2303	        # Double-check after acquiring lock
  2304	        if _review_service_singleton is not None:
  2305	            return _review_service_singleton
  2306	
  2307	        from app.config import get_settings
  2308	        from app.services.background_task_manager import BackgroundTaskManager
  2309	        from app.services.canvas_service import CanvasService
  2310	
  2311	        settings = get_settings()
  2312	
  2313	        # 1. CanvasService with memory_client (EPIC-36 P0 fix alignment)
  2314	        memory_client = None
  2315	        try:
  2316	            from app.services.memory_service import get_memory_service as _get_mem
  2317	
  2318	            memory_client = await _get_mem()
  2319	        except (ImportError, RuntimeError, AttributeError) as e:
  2320	            logger.warning(
  2321	                f"MemoryService not available for CanvasService edge sync: {e}"
  2322	            )
