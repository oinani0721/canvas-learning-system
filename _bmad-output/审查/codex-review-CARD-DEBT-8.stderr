   598	    async def generate_verification_canvas(
   599	        self,
   600	        source_canvas_name: str,
   601	        mode: str = "fresh",
   602	        weak_weight: float = 0.7,
   603	        mastered_weight: float = 0.3,
   604	        include_colors: Optional[List[str]] = None,
   605	        question_count: Optional[int] = None,
   606	    ) -> Dict[str, Any]:
   607	        """
   608	        Generate a verification canvas with mode support.
   609	
   610	        ✅ Verified from Story 24.1 Dev Notes (lines 180-220)
   611	
   612	        Args:
   613	            source_canvas_name: Name of source canvas to create verification from
   614	            mode: "fresh" for blind test, "targeted" for weakness-focused
   615	            weak_weight: Weight for weak concepts (targeted mode only)
   616	            mastered_weight: Weight for mastered concepts (targeted mode only)
   617	            include_colors: Optional color filter for node selection
   618	            question_count: Optional limit on question count
   619	
   620	        Returns:
   621	            Generated verification canvas data with mode metadata
   622	
   623	        [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#Layer-2-服务层]
   624	        [Source: Story 24.1 - Mode Support Implementation]
   625	        """
   626	        logger.debug(
   627	            f"Generating verification canvas from: {source_canvas_name} "
   628	            f"(mode={mode}, weak_weight={weak_weight}, mastered_weight={mastered_weight})"
   629	        )
   630	
   631	        # Get all eligible concepts from canvas
   632	        # Mastery-aware: color filter kept as fallback; mastery engine provides
   633	        # more nuanced filtering via effective_proficiency < 0.70
   634	        if include_colors is None:
   635	            include_colors = ["3", "4"]  # Default fallback: purple and red
   636	
   637	        # Load canvas data to get nodes
   638	        canvas_data = await self.canvas_service.get_canvas(source_canvas_name)
   639	        all_nodes = canvas_data.get("nodes", [])
   640	
   641	        # Filter by colors (baseline)
   642	        eligible_nodes = [
   643	            node
   644	            for node in all_nodes
   645	            if node.get("type") == "text" and node.get("color") in include_colors
   646	        ]
   647	
   648	        # === Mastery enrichment (Phase 1.5) ===
   649	        # Expand eligible_nodes with mastery-weak concepts not caught by color filter
   650	        mastery_lookup: dict = {}  # node_text[:50] -> effective_proficiency
   651	        enrichment_available = (
   652	            False  # G-SILENT-001: signal whether enrichment succeeded
   653	        )
   654	        try:
   655	            from app.clients.neo4j_client import get_neo4j_client
   656	            from app.services.mastery_engine import get_mastery_engine
   657	            from app.services.mastery_store import MasteryStore
   658	
   659	            m_engine = get_mastery_engine()  # Uses fusion-enabled singleton
   660	            m_store = MasteryStore(get_neo4j_client())
   661	            from app.config import DEFAULT_GROUP_ID
   662	            from app.core.subject_config import (
   663	                canonical_group_id,
   664	                get_current_subject_id,
   665	            )
   666	
   667	            # wave-5 Stage B P0 (2026-05-11): prefer ContextVar so the review
   668	            # candidates are pulled from the originating request's vault.
   669	            _ctx_value = get_current_subject_id()
   670	            _effective_group_id = (
   671	                canonical_group_id(_ctx_value) if _ctx_value else DEFAULT_GROUP_ID
   672	            )
   673	
   674	            all_mastery = await m_store.get_all_concepts(group_id=_effective_group_id)
   675	            review_candidates = m_engine.get_review_candidates(all_mastery)
   676	
   677	            # Build name -> proficiency lookup for question_generator
   678	            mastery_lookup = {
   679	                c.name: m_engine.effective_proficiency(c) for c in all_mastery
   680	            }
   681	
   682	            # Add mastery-weak concepts that aren't already in eligible_nodes
   683	            eligible_ids = {n.get("id") for n in eligible_nodes}
   684	            candidate_names = {c.name for c in review_candidates}
   685	            for node in all_nodes:
   686	                if (
   687	                    node.get("type") == "text"
   688	                    and node.get("id") not in eligible_ids
   689	                    and (node.get("text", "")[:50].strip() in candidate_names)
   690	                ):
   691	                    eligible_nodes.append(node)
   692	                    eligible_ids.add(node.get("id"))
   693	
   694	            enrichment_available = True
   695	            logger.info(
   696	                f"Mastery enrichment: {len(review_candidates)} weak concepts, "
   697	                f"{len(eligible_nodes)} total eligible after enrichment"
   698	            )
   699	        except (
   700	            ImportError,
   701	            RuntimeError,
   702	            ConnectionError,
   703	            ValueError,
   704	            TypeError,
   705	            AttributeError,
   706	        ) as e:
   707	            logger.warning(f"Mastery enrichment unavailable (degraded mode): {e}")
   708	
   709	        weak_concepts_data = []
   710	        weight_config = {
   711	            "weak_weight": weak_weight,
   712	            "mastered_weight": mastered_weight,
   713	            "applied": False,
   714	            "enrichment_available": enrichment_available,
   715	        }
   716	        fallback_used = False  # AC2 of Story 24.6: Track fallback usage
   717	
   718	        if mode == "targeted":
   719	            # Query Graphiti for review history (Story 24.3)
   720	            review_history = await self._query_review_history_from_memory(
   721	                source_canvas_name
   722	            )
   723	
   724	            # AC2: Detect fallback scenario (Graphiti unavailable or no history)
   725	            if not review_history:
   726	                fallback_used = True
   727	                logger.warning(
   728	                    f"Targeted mode fallback: No Graphiti history for {source_canvas_name}, "
   729	                    "using equal probability selection for all eligible concepts"
   730	                )
   731	
   732	            # Prepare concepts list from eligible nodes
   733	            concepts = [
   734	                {"id": node.get("id", ""), "name": node.get("text", "")}
   735	                for node in eligible_nodes
   736	            ]
   737	
   738	            # Calculate weakness scores using WeightCalculator (Story 24.3)
   739	            calculator = WeightCalculator()
   740	            weight_data = await calculator.calculate_weakness_scores(
   741	                concepts, review_history
   742	            )
   743	
   744	            # Apply weighted selection (Story 24.3)
   745	            target_count = question_count or len(eligible_nodes)
   746	            selected_weight_data = await self._apply_weighted_selection(
   747	                weight_data, target_count, weak_weight, mastered_weight
   748	            )
   749	
   750	            # Convert back to node objects for canvas generation
   751	            selected_ids = {c.concept_id for c in selected_weight_data}
   752	            selected_concepts = [
   753	                node for node in eligible_nodes if node.get("id", "") in selected_ids
   754	            ]
   755	
   756	            # Prepare weak_concepts for response (AC5)
   757	            weak_concepts_data = [
   758	                {
   759	                    "concept_name": c.concept_name,
   760	                    "weakness_score": c.weakness_score,
   761	                    "failure_count": c.failure_count,
   762	                    "avg_rating": c.avg_rating,
   763	                }
   764	                for c in weight_data
   765	                if c.category == "weak"
   766	            ]
   767	
   768	            weight_config["applied"] = True
   769	
   770	            logger.info(
   771	                f"Targeted mode: selected {len(selected_concepts)} concepts using weighted algorithm "
   772	                f"({sum(1 for c in selected_weight_data if c.category == 'weak')} weak, "
   773	                f"{sum(1 for c in selected_weight_data if c.category == 'mastered')} mastered)"
   774	            )
   775	        else:
   776	            # Fresh mode: equal probability selection from all eligible nodes
   777	            selected_concepts = eligible_nodes
   778	            logger.info(f"Fresh mode: selected {len(selected_concepts)} concepts")
   779	
   780	        # Apply question_count limit if specified
   781	        if question_count and len(selected_concepts) > question_count:
   782	            selected_concepts = random.sample(selected_concepts, question_count)
   783	
   784	        # Generate verification canvas (simplified stub - actual generation logic elsewhere)
   785	        timestamp = datetime.now(timezone.utc).strftime("%Y%m%d")
   786	        review_canvas_name = f"{source_canvas_name}-检验白板-{timestamp}"
   787	
   788	        # Store relationship in Graphiti
   789	        await self._store_review_relationship(
   790	            source_canvas_name, review_canvas_name, mode
   791	        )
   792	
   793	        result = {
   794	            "review_canvas_name": review_canvas_name,
   795	            "source_canvas_name": source_canvas_name,
   796	            "question_count": len(selected_concepts),
   797	            "mode_used": mode,
   798	            "generated_at": datetime.now(timezone.utc).isoformat(),
   799	            "weak_concepts": weak_concepts_data,  # AC5: Enhanced response
   800	            "weight_config": weight_config,  # AC5: Weight configuration
   801	            "fallback_used": fallback_used,  # AC2 of Story 24.6: Indicate if fallback was triggered
   802	        }
   803	
   804	        log_decision(
   805	            function="generate_verification_canvas",
   806	            input_summary={
   807	                "source_canvas": source_canvas_name,
   808	                "mode": mode,
   809	                "eligible_nodes": len(eligible_nodes),
   810	            },
   811	            output=f"selected {len(selected_concepts)} nodes -> {review_canvas_name}",
   812	            reason=f"mode={mode}, fallback_used={fallback_used}, "
   813	            f"weak_weight={weak_weight}, mastered_weight={mastered_weight}",
   814	        )
   815	
   816	        logger.info(
   817	            f"Generated verification canvas: {review_canvas_name} "
   818	            f"with {len(selected_concepts)} questions (mode={mode})"
   819	        )
   820	
   821	        return result
   822	
   823	    async def schedule_review(
   824	        self,
   825	        canvas_name: str,
   826	        concept_id: str = "",
   827	        trigger_point: int = 1,
   828	        card_state: Optional[str] = None,
   829	    ) -> Dict[str, Any]:
   830	        """
   831	        Schedule a review using FSRS algorithm (Story 32.2).
   832	
   833	        Story 32.2 AC-32.2.3: FSRS calculates dynamic intervals based on
   834	        card state (stability, difficulty) rather than fixed Ebbinghaus intervals.
   835	
   836	        Args:
   837	            canvas_name: Canvas to schedule review for
   838	            concept_id: Concept identifier for card tracking
   839	            trigger_point: Legacy parameter (maintained for backward compatibility)
   840	            card_state: Optional serialized FSRS card JSON from previous review
   841	
   842	        Returns:
   843	            Review schedule with FSRS-calculated due date and card state
   844	
   845	        Migration Path (AC-32.2.5):
   846	        - If card_state is None: Creates new FSRS card (first review)
   847	        - If card_state exists: Deserializes and uses existing card state
   848	        - Existing Ebbinghaus records: Treated as new cards on first FSRS review
   849	
   850	        [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#Layer-2-服务层]
   851	        [Source: Story 32.2 - FSRS Integration]
   852	        """
   853	        logger.debug(f"Scheduling FSRS review for {canvas_name}/{concept_id}")
   854	
   855	        # Story 32.2: Use FSRS for scheduling if available
   856	        if self._fsrs_manager is not None:
   857	            try:
   858	                # Load or create card (AC-32.2.4 backward compatibility)
   859	                if card_state:
   860	                    card = self._fsrs_manager.deserialize_card(card_state)
   861	                    logger.debug(f"Loaded existing FSRS card for {concept_id}")
   862	                else:
   863	                    # Check in-memory cache
   864	                    cached_state = self._card_states.get(concept_id)
   865	                    if cached_state:
   866	                        card = self._fsrs_manager.deserialize_card(cached_state)
   867	                        logger.debug(f"Loaded cached FSRS card for {concept_id}")
   868	                    else:
   869	                        # New card - immediately due for first review
   870	                        card = self._fsrs_manager.create_card()
   871	                        logger.info(f"Created new FSRS card for {concept_id}")
   872	
   873	                # Get due date from card
   874	                due_date = self._fsrs_manager.get_due_date(card)
   875	                retrievability = self._fsrs_manager.get_retrievability(card)
   876	
   877	                # Calculate interval in days from now
   878	                if due_date:
   879	                    interval_days = max(
   880	                        0, (due_date - datetime.now(due_date.tzinfo)).days
   881	                    )
   882	                else:
   883	                    interval_days = 0  # New card, due immediately
   884	
   885	                log_decision(
   886	                    function="schedule_review",
   887	                    input_summary={
   888	                        "canvas_name": canvas_name,
   889	                        "concept_id": concept_id,
   890	                        "card_state_provided": card_state is not None,
   891	                    },
   892	                    output=f"interval={interval_days}d, R={retrievability:.3f}",
   893	                    # New cards: stability/difficulty are None — formatting them
   894	                    # with ':.2f' raised TypeError, silently degrading every new
   895	                    # concept to the Ebbinghaus fallback via the except below.
   896	                    # CARD-DEBT-8: 底层 fallback 激活时决策日志也不得谎报 FSRS-4.5。
   897	                    reason=f"{'FSRS-4.5' if self._fsrs_library_ok() else 'fallback'} scheduling, "
   898	                    f"stability={_fmt_optional_2f(getattr(card, 'stability', None))}, "
   899	                    f"difficulty={_fmt_optional_2f(getattr(card, 'difficulty', None))}",
   900	                )
   901	
   902	                # CARD-DEBT-8: manager 在位 != py-fsrs 在位。底层 fallback
   903	                # 激活时如实上报 fsrs-fallback-scheduler + degraded_reason
   904	                # （加性, 沿 CARD-D3 先例; 真实库在位响应逐键与此前相同）。
   905	                lib_ok = self._fsrs_library_ok()
   906	                response = {
   907	                    "canvas_name": canvas_name,
   908	                    "concept_id": concept_id,
   909	                    "scheduled_date": due_date.isoformat()
   910	                    if due_date
   911	                    else (
   912	                        datetime.now(timezone.utc) + timedelta(days=interval_days)
   913	                    ).isoformat(),
   914	                    "interval_days": interval_days,
   915	                    "retrievability": retrievability,
   916	                    # Display mirror of the card: new cards carry None
   917	                    # stability/difficulty — surface the Story 38.3 AC-4
   918	                    # default-card contract (1.0/5.0) so consumers building
   919	                    # FSRSStateResponse (requires float, difficulty ge=1)
   920	                    # never hit ValidationError. card_data below keeps the
   921	                    # authoritative null for scheduler roundtrip.
   922	                    "fsrs_state": {
   923	                        "stability": getattr(card, "stability", None)
   924	                        if getattr(card, "stability", None) is not None
   925	                        else 1.0,
   926	                        "difficulty": getattr(card, "difficulty", None)
   927	                        if getattr(card, "difficulty", None) is not None
   928	                        else 5.0,
   929	                        "state": int(getattr(card, "state", 0).value)
   930	                        if hasattr(getattr(card, "state", 0), "value")
   931	                        else int(getattr(card, "state", 0)),
   932	                        "reps": getattr(card, "reps", 0),
   933	                        "lapses": getattr(card, "lapses", 0),
   934	                    },
   935	                    "card_data": self._fsrs_manager.serialize_card(card),
   936	                    "status": "scheduled",
   937	                    "algorithm": "fsrs-4.5" if lib_ok else "fsrs-fallback-scheduler",
   938	                }
   939	                if not lib_ok:
   940	                    response["degraded_reason"] = "fsrs_library_missing"
   941	                return response
   942	
   943	            # INTENTIONAL: Third-party py-fsrs library may raise unpredictable errors; fallback to Ebbinghaus
   944	            except Exception as e:
   945	                logger.error(f"FSRS scheduling failed, using fallback: {e}")
   946	                # Fall through to fallback
   947	
   948	        # Fallback: Legacy Ebbinghaus fixed intervals
   949	        logger.warning("Using fallback Ebbinghaus scheduling (FSRS unavailable)")
   950	        ebbinghaus_intervals = {1: 1, 2: 7, 3: 30, 4: 90}
   951	        interval = ebbinghaus_intervals.get(trigger_point, 1)
   952	
   953	        # Story 32.9 AC-1: scheduled_date must be a future date, not "now"
   954	        scheduled_date = datetime.now(timezone.utc) + timedelta(days=interval)
   955	        return {
   956	            "canvas_name": canvas_name,
   957	            "concept_id": concept_id,
   958	            "trigger_point": trigger_point,
   959	            "scheduled_date": scheduled_date.isoformat(),
   960	            "interval_days": interval,
   961	            "status": "scheduled",
   962	            "algorithm": "ebbinghaus-fallback",
   963	        }
   964	
   965	    async def record_review_result(
   966	        self,
   967	        canvas_name: str,
   968	        concept_id: str = "",
   969	        score: Optional[float] = None,
   970	        rating: Optional[int] = None,
   971	        card_state: Optional[str] = None,
   972	        details: Optional[Dict[str, Any]] = None,
   973	    ) -> Dict[str, Any]:
   974	        """
   975	        Record the result of a review session using FSRS algorithm (Story 32.2).
   976	
   977	        Story 32.2 AC-32.2.2: Accepts FSRS ratings (1=Again, 2=Hard, 3=Good, 4=Easy)
   978	        Story 32.2 AC-32.2.3: Returns dynamically calculated next review date
   979	        Story 32.2 AC-32.2.4: Backward compatible with score-based inputs (0-100)
   980	
   981	        Args:
   982	            canvas_name: Canvas that was reviewed
   983	            concept_id: Concept identifier for card tracking
   984	            score: Legacy score (0-100), converted to rating if rating not provided
   985	            rating: FSRS rating (1=Again, 2=Hard, 3=Good, 4=Easy)
   986	            card_state: Optional serialized FSRS card JSON from previous review
   987	            details: Optional detailed scoring breakdown
   988	
   989	        Returns:
   990	            Recorded review result with FSRS state:
   991	            - next_review: ISO timestamp of next scheduled review
   992	            - interval_days: Days until next review
   993	            - fsrs_state: {stability, difficulty, state, reps, lapses}
   994	            - card_data: Serialized card for persistence
   995	
   996	        Rating Conversion (AC-32.2.4 backward compatibility):
   997	            Score 0-39:   Again (1) - forgot
   998	            Score 40-59:  Hard (2) - serious difficulty
   999	            Score 60-84:  Good (3) - remembered with hesitation
  1000	            Score 85-100: Easy (4) - easily recalled
  1001	
  1002	        [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#Layer-2-服务层]
  1003	        [Source: Story 32.2 - FSRS Integration]
  1004	        """
  1005	        logger.debug(f"Recording FSRS review result for {canvas_name}/{concept_id}")
  1006	
  1007	        # Story 32.2 AC-32.2.2/AC-32.2.4: Convert score to rating if needed
  1008	        if rating is None and score is not None:
  1009	            if get_rating_from_score is not None:
  1010	                rating = get_rating_from_score(score)
  1011	                logger.debug(f"Converted score {score} to FSRS rating {rating}")
  1012	            else:
  1013	                # Fallback conversion
  1014	                if score < 40:
  1015	                    rating = 1  # Again
  1016	                elif score < 60:
  1017	                    rating = 2  # Hard
  1018	                elif score < 85:
  1019	                    rating = 3  # Good
  1020	                else:
  1021	                    rating = 4  # Easy
  1022	        elif rating is None:
  1023	            rating = 3  # Default to Good if no input provided
  1024	
  1025	        # P0-3: Validate rating - handle non-integer types (e.g. "abc", 5.7)
  1026	        try:
  1027	            rating = int(rating)
  1028	        except (TypeError, ValueError):
  1029	            logger.warning(f"Invalid rating value '{rating}', defaulting to 3")
  1030	            rating = 3
  1031	        rating = max(1, min(4, rating))
  1032	
  1033	        # Story 32.2: Use FSRS for recording if available
  1034	        if self._fsrs_manager is not None:
  1035	            try:
  1036	                # Load or create card (AC-32.2.4 backward compatibility)
  1037	                if card_state:
  1038	                    card = self._fsrs_manager.deserialize_card(card_state)
  1039	                    logger.debug(f"Loaded existing FSRS card for {concept_id}")
  1040	                else:
  1041	                    # Check in-memory cache
  1042	                    cached_state = self._card_states.get(concept_id)
  1043	                    if cached_state:
  1044	                        card = self._fsrs_manager.deserialize_card(cached_state)
  1045	                        logger.debug(f"Loaded cached FSRS card for {concept_id}")
  1046	                    else:
  1047	                        # New card - existing Ebbinghaus records treated as first FSRS review
  1048	                        card = self._fsrs_manager.create_card()
  1049	                        logger.info(
  1050	                            f"Created new FSRS card for {concept_id} (migration from Ebbinghaus)"
  1051	                        )
  1052	
  1053	                # Story 32.2 AC-32.2.3: Review card with FSRS algorithm
  1054	                updated_card, review_log = self._fsrs_manager.review_card(card, rating)
  1055	
  1056	                # Get next due date (dynamically calculated by FSRS)
  1057	                due_date = self._fsrs_manager.get_due_date(updated_card)
  1058	
  1059	                # Calculate interval in days
  1060	                if due_date:
  1061	                    now = datetime.now(timezone.utc)
  1062	                    interval_days = max(0, (due_date - now).days)
  1063	                else:
  1064	                    interval_days = 1
  1065	
  1066	                # Serialize card for persistence
  1067	                card_data = self._fsrs_manager.serialize_card(updated_card)
  1068	
  1069	                # Store in memory cache + persist to file (P0-2)
  1070	                # CARD-D3: 消费 _save_card_states 返回值 (Codex HIGH-1 的
  1071	                # 失败信号在此前被丢弃) — 文件是唯一真实持久化通道, 写失败
  1072	                # 意味着"仅内存暂存、重启即丢", 必须在返回值里如实标注。
  1073	                if concept_id:
  1074	                    # Codex HIGH-2: mutation 随 pending 进锁内, 不在此处赋值
  1075	                    card_state_persisted = await self._save_card_states(
  1076	                        pending=(concept_id, card_data)
  1077	                    )
  1078	                    degraded_reason = (
  1079	                        None if card_state_persisted else "card_state_write_failed"
  1080	                    )
  1081	                else:
  1082	                    # M3 fix: Warn when concept_id is empty — card state will not be persisted
  1083	                    logger.warning(
  1084	                        f"Empty concept_id for canvas '{canvas_name}' — "
  1085	                        f"FSRS card state computed but NOT persisted"
  1086	                    )
  1087	                    card_state_persisted = False
  1088	                    degraded_reason = "empty_concept_id_not_persisted"
  1089	
  1090	                # CARD-DEBT-8: 底层 py-fsrs 缺失时如实上报, 不再谎报 fsrs-4.5。
  1091	                # fsrs_library_missing 与 CARD-D3 的持久化降级原因并存时
  1092	                # 逗号拼接——两个降级都真实, 谁也不冲掉谁。
  1093	                lib_ok = self._fsrs_library_ok()
  1094	                if not lib_ok:
  1095	                    degraded_reason = (
  1096	                        "fsrs_library_missing"
  1097	                        if degraded_reason is None
  1098	                        else f"fsrs_library_missing,{degraded_reason}"
  1099	                    )
  1100	
  1101	                # Extract state value safely
  1102	                state_val = getattr(updated_card, "state", 0)
  1103	                if hasattr(state_val, "value"):
  1104	                    state_int = int(state_val.value)
  1105	                elif hasattr(state_val, "__int__"):
  1106	                    state_int = int(state_val)
  1107	                else:
  1108	                    state_int = 0
  1109	
  1110	                return {
  1111	                    "canvas_name": canvas_name,
  1112	                    "concept_id": concept_id,
  1113	                    "rating": rating,
  1114	                    "score": score,  # Preserve original score for logging
  1115	                    "next_review": due_date.isoformat()
  1116	                    if due_date
  1117	                    else (
  1118	                        datetime.now(timezone.utc) + timedelta(days=interval_days)
  1119	                    ).isoformat(),
  1120	                    "interval_days": interval_days,
  1121	                    "fsrs_state": {
  1122	                        "stability": float(getattr(updated_card, "stability", 0.0)),
  1123	                        "difficulty": float(getattr(updated_card, "difficulty", 0.0)),
  1124	                        "state": state_int,
  1125	                        "reps": int(getattr(updated_card, "reps", 0)),
  1126	                        "lapses": int(getattr(updated_card, "lapses", 0)),
  1127	                    },
  1128	                    "card_data": card_data,
  1129	                    "details": details or {},
  1130	                    "recorded_at": datetime.now(timezone.utc).isoformat(),
  1131	                    "status": "recorded",
  1132	                    "algorithm": "fsrs-4.5" if lib_ok else "fsrs-fallback-scheduler",
  1133	                    # CARD-D3: 持久化诚实信号 (评分计算成功 != 状态已落盘)
  1134	                    "card_state_persisted": card_state_persisted,
  1135	                    "degraded_reason": degraded_reason,
  1136	                }
  1137	
  1138	            # INTENTIONAL: Third-party py-fsrs library may raise unpredictable errors; fallback to legacy
  1139	            except Exception as e:
  1140	                logger.error(f"FSRS recording failed, using fallback: {e}")
  1141	                # Fall through to fallback
  1142	
  1143	        # Fallback: Legacy Ebbinghaus fixed intervals
  1144	        logger.warning("Using fallback Ebbinghaus recording (FSRS unavailable)")
  1145	
  1146	        # Calculate interval based on score (legacy behavior)
  1147	        if score is not None:
  1148	            if score >= 85:
  1149	                interval = 30
  1150	            elif score >= 60:
  1151	                interval = 7
  1152	            elif score >= 40:
  1153	                interval = 3
  1154	            else:
  1155	                interval = 1
  1156	        else:
  1157	            # Map rating to interval
  1158	            rating_intervals = {1: 1, 2: 3, 3: 7, 4: 30}
  1159	            interval = rating_intervals.get(rating, 1)
  1160	
  1161	        # Story 32.9 AC-1: next_review must be a future date, not "now"
  1162	        now_utc = datetime.now(timezone.utc)
  1163	        next_review_date = now_utc + timedelta(days=interval)
  1164	        return {
  1165	            "canvas_name": canvas_name,
  1166	            "concept_id": concept_id,
  1167	            "rating": rating,
  1168	            "score": score,
  1169	            "next_review": next_review_date.isoformat(),
  1170	            "interval_days": interval,
  1171	            "details": details or {},
  1172	            "recorded_at": now_utc.isoformat(),
  1173	            "status": "recorded",
  1174	            "algorithm": "ebbinghaus-fallback",
  1175	            # CARD-D3: fallback 分支没有 FSRS 卡状态可持久化 → 不适用 (None)
  1176	            "card_state_persisted": None,
  1177	            "degraded_reason": None,
  1178	        }
  1179	
  1180	    # ═══════════════════════════════════════════════════════════════════════════
  1181	    # Story 34.4: Review History with Pagination
  1182	    # [Source: specs/api/review-api.openapi.yml#L185-216]
  1183	    # [Source: docs/stories/34.4.story.md]
  1184	    # ═══════════════════════════════════════════════════════════════════════════
  1185	
  1186	    async def get_history(
  1187	        self,
  1188	        days: int = 7,
  1189	        canvas_path: Optional[str] = None,
  1190	        concept_name: Optional[str] = None,
  1191	        limit: Optional[int] = 5,
  1192	    ) -> Dict[str, Any]:
  1193	        """
  1194	        Get review history with pagination support.
  1195	
  1196	        Story 34.4 AC1: Default limit=5 records.
  1197	        Story 34.4 AC2: limit=None returns all records.
  1198	        Story 34.4 AC3: Supports filtering by canvas_path and concept_name.
  1199	
  1200	        Args:
  1201	            days: Number of days to look back (7, 30, 90)
  1202	            canvas_path: Filter by canvas file path
  1203	            concept_name: Filter by concept name
  1204	            limit: Maximum records (None = all, default=5)
  1205	
  1206	        Returns:
  1207	            Dict with records, statistics, and has_more flag
  1208	        """
  1209	        from collections import defaultdict
  1210	
  1211	        # Calculate date range
  1212	        end_date = datetime.now(timezone.utc).date()
  1213	        start_date = end_date - timedelta(days=days)
  1214	
  1215	        # Get history from storage/graphiti
  1216	        all_records: List[Dict[str, Any]] = []
  1217	
  1218	        # Try to get history from Graphiti first
  1219	        if self.graphiti_client:
  1220	            try:
  1221	                from app.clients.graphiti_client import get_learning_memory_client
  1222	
  1223	                memory_client = get_learning_memory_client()
  1224	                await memory_client.initialize()
  1225	
  1226	                # Query all learning history within date range
  1227	                raw_history = await memory_client.get_learning_history(
  1228	                    canvas_name=canvas_path or "",
  1229	                    limit=1000,  # Get all records for filtering
  1230	                )
  1231	
  1232	                # Filter and convert records
  1233	                for memory in raw_history:
  1234	                    timestamp_str = memory.get("timestamp", "")
  1235	                    try:
  1236	                        if isinstance(timestamp_str, str):
  1237	                            record_date = datetime.fromisoformat(
  1238	                                timestamp_str.replace("Z", "+00:00")
  1239	                            ).date()
  1240	                        else:
  1241	                            record_date = (
  1242	                                timestamp_str.date()
  1243	                                if hasattr(timestamp_str, "date")
  1244	                                else end_date
  1245	                            )
  1246	                    except (ValueError, AttributeError):
  1247	                        continue
  1248	
  1249	                    # Skip records outside date range
  1250	                    if record_date < start_date or record_date > end_date:
  1251	                        continue
  1252	
  1253	                    # Filter by canvas_path if specified
  1254	                    record_canvas = memory.get(
  1255	                        "canvas_name", memory.get("canvas_path", "")
  1256	                    )
  1257	                    if canvas_path and canvas_path not in record_canvas:
  1258	                        continue
  1259	
  1260	                    # Filter by concept_name if specified
  1261	                    record_concept = memory.get(
  1262	                        "concept", memory.get("concept_name", "")
  1263	                    )
  1264	                    if concept_name and concept_name not in record_concept:
  1265	                        continue
  1266	
  1267	                    # Convert score (0-100) to rating (1-4)
  1268	                    score = memory.get("score", 60)
  1269	                    if score >= 85:
  1270	                        rating = 4
  1271	                    elif score >= 60:
  1272	                        rating = 3
  1273	                    elif score >= 40:
  1274	                        rating = 2
  1275	                    else:
  1276	                        rating = 1
  1277	
  1278	                    all_records.append(
  1279	                        {
  1280	                            "concept_id": memory.get(
  1281	                                "concept_id", memory.get("id", "")
  1282	                            ),
  1283	                            "concept_name": record_concept,
  1284	                            "canvas_path": record_canvas,
  1285	                            "rating": rating,
  1286	                            "review_time": timestamp_str,
  1287	                            "date": record_date.isoformat(),
  1288	                        }
  1289	                    )
  1290	
  1291	                logger.info(f"Found {len(all_records)} history records from Graphiti")
  1292	
  1293	            except (
  1294	                ConnectionError,
  1295	                TimeoutError,
  1296	                ValueError,
  1297	                KeyError,
  1298	                TypeError,
  1299	                AttributeError,
  1300	            ) as e:
  1301	                logger.error(f"Error querying history from Graphiti: {e}")
  1302	
  1303	        # If no records from Graphiti, try FSRS card states
  1304	        if not all_records and self._card_states:
  1305	            for key, card_data in self._card_states.items():
  1306	                try:
  1307	                    # Handle both dict and serialized JSON string formats
  1308	                    # (FSRS serialize_card() stores strings, _load_card_states restores as-is)
  1309	                    if isinstance(card_data, str):
  1310	                        try:
  1311	                            card_data = json.loads(card_data)
  1312	                        except (json.JSONDecodeError, ValueError):
  1313	                            continue
  1314	                    if not isinstance(card_data, dict):
  1315	                        continue
  1316	
  1317	                    last_review = card_data.get("last_review")
  1318	                    if not last_review:
  1319	                        continue
  1320	
  1321	                    if isinstance(last_review, str):
  1322	                        record_date = datetime.fromisoformat(
  1323	                            last_review.replace("Z", "+00:00")
  1324	                        ).date()
  1325	                    else:
  1326	                        record_date = (
  1327	                            last_review.date()
  1328	                            if hasattr(last_review, "date")
  1329	                            else end_date
  1330	                        )
  1331	
  1332	                    if record_date < start_date or record_date > end_date:
  1333	                        continue
  1334	
  1335	                    parts = key.split(":")
  1336	                    record_canvas = parts[0] if len(parts) > 0 else ""
  1337	                    record_concept = parts[1] if len(parts) > 1 else key
  1338	
  1339	                    if canvas_path and canvas_path not in record_canvas:
  1340	                        continue
  1341	                    if concept_name and concept_name not in record_concept:
  1342	                        continue
  1343	
  1344	                    all_records.append(
  1345	                        {
  1346	                            "concept_id": key,
  1347	                            "concept_name": record_concept,
  1348	                            "canvas_path": record_canvas,
  1349	                            "rating": card_data.get("rating", 3),
  1350	                            "review_time": last_review,
  1351	                            "date": record_date.isoformat(),
  1352	                        }
  1353	                    )
  1354	                except (ValueError, AttributeError):
  1355	                    continue
  1356	
  1357	        # Sort by review_time descending (newest first)
  1358	        all_records.sort(key=lambda x: x.get("review_time", ""), reverse=True)
  1359	
  1360	        # Determine if there are more records than limit
  1361	        total_count = len(all_records)
  1362	        # Code Review H3 Fix: Cap None to MAX_HISTORY_RECORDS to enforce service-level protection
  1363	        effective_limit = limit if limit is not None else MAX_HISTORY_RECORDS
  1364	        has_more = total_count > effective_limit
  1365	
  1366	        # Code Review H3 Fix: Calculate streak from ALL records BEFORE truncation
  1367	        # (streak must reflect true consecutive days, not limited view)
  1368	        all_dates: set = set()
  1369	        for record in all_records:
  1370	            date_key = record.get("date", "")
  1371	            if date_key:
  1372	                all_dates.add(date_key)
  1373	
  1374	        streak_days = 0
  1375	        check_date = end_date
  1376	        while check_date >= start_date:
  1377	            if check_date.isoformat() in all_dates:
  1378	                streak_days += 1
  1379	                check_date -= timedelta(days=1)
  1380	            else:
  1381	                break
  1382	
  1383	        # Apply limit after streak calculation
  1384	        limited_records = all_records[:effective_limit]
  1385	
  1386	        # Group limited records by date for response
  1387	        records_by_date: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
  1388	        for record in limited_records:
  1389	            date_key = record.get("date", "")
  1390	            if date_key:
  1391	                records_by_date[date_key].append(record)
  1392	
  1393	        # Build daily records list
  1394	        daily_records = []
  1395	        for date_key in sorted(records_by_date.keys(), reverse=True):
  1396	            daily_records.append(
  1397	                {"date": date_key, "reviews": records_by_date[date_key]}
  1398	            )
  1399	
  1400	        # Story 34.12 AC3: Calculate retention_rate from rating data
  1401	        # retention_rate = count(rating >= 3) / count(total records with rating)
  1402	        rated_records = [r for r in all_records if r.get("rating") is not None]
  1403	        if rated_records:
  1404	            good_count = sum(1 for r in rated_records if r.get("rating", 0) >= 3)
  1405	            retention_rate = round(good_count / len(rated_records), 4)
  1406	        else:
  1407	            retention_rate = None
  1408	
  1409	        return {
  1410	            "records": daily_records,
  1411	            "total_count": total_count,
  1412	            "has_more": has_more,
  1413	            "streak_days": streak_days,
  1414	            "retention_rate": retention_rate,
  1415	        }
  1416	
  1417	    async def _query_weak_concepts_from_memory(
  1418	        self, canvas_name: str
  1419	    ) -> List[Dict[str, Any]]:
  1420	        """
  1421	        Query historical weak concepts from LearningMemoryClient (JSON storage).
  1422	
  1423	        Renamed from _query_weak_concepts_from_graphiti: uses LearningMemoryClient
  1424	        (JSON-backed), not graphiti-core. See Task 10 fake naming cleanup.
  1425	
  1426	        ✅ Verified from Story 24.1 Dev Notes (lines 224-239)
  1427	
  1428	        Args:
  1429	            canvas_name: Canvas file name
  1430	
  1431	        Returns:
  1432	            List of weak concept dicts with scores and review counts
  1433	        """
  1434	        if not self.graphiti_client:
  1435	            logger.warning(
  1436	                "功能 %s 降级运行: %s 为 None，返回默认值 %s",
  1437	                "query_weak_concepts",
  1438	                "graphiti_client",
  1439	                "[]",
  1440	            )
  1441	            return []
  1442	
  1443	        try:
  1444	            # Since we're using GraphitiEdgeClient with JSON storage,
  1445	            # we'll query from the learning memories instead
  1446	            from app.clients.graphiti_client import get_learning_memory_client
  1447	
  1448	            memory_client = get_learning_memory_client()
  1449	            await memory_client.initialize()
  1450	
  1451	            # Get learning history for this canvas
  1452	            history = await memory_client.get_learning_history(canvas_name, limit=50)
  1453	
  1454	            # Calculate average scores per concept
  1455	            concept_scores: Dict[str, List[float]] = {}
  1456	            for memory in history:
  1457	                concept = memory.get("concept", "")
  1458	                score = memory.get("score")
  1459	                if concept and score is not None:
  1460	                    if concept not in concept_scores:
  1461	                        concept_scores[concept] = []
  1462	                    concept_scores[concept].append(score)
  1463	
  1464	            # Build weak concepts list (avg score < 24 out of 40)
  1465	            weak_concepts = []
  1466	            for concept, scores in concept_scores.items():
  1467	                avg_score = sum(scores) / len(scores) if scores else 0
  1468	                if avg_score < 24:  # < 60% threshold
  1469	                    weak_concepts.append(
  1470	                        {
  1471	                            "concept_name": concept,
  1472	                            "avg_score": avg_score,
  1473	                            "review_count": len(scores),
  1474	                        }
  1475	                    )
  1476	
  1477	            # Sort by avg_score ascending (weakest first)
  1478	            weak_concepts.sort(key=lambda x: (x["avg_score"], -x["review_count"]))
  1479	
  1480	            logger.info(f"Found {len(weak_concepts)} weak concepts for {canvas_name}")
  1481	            return weak_concepts
  1482	
  1483	        except (
  1484	            ConnectionError,
  1485	            TimeoutError,
  1486	            ValueError,
  1487	            KeyError,
  1488	            TypeError,
  1489	            AttributeError,
  1490	        ) as e:
  1491	            logger.error(f"Error querying weak concepts: {e}")
  1492	            return []
  1493	
  1494	    async def _store_review_relationship(
  1495	        self, original_canvas: str, review_canvas: str, mode: str
  1496	    ) -> None:
  1497	        """
  1498	        Store GENERATED_FROM relationship in Graphiti.
  1499	
  1500	        ✅ Verified from Story 24.1 Dev Notes (lines 241-256)
  1501	
  1502	        Args:
  1503	            original_canvas: Original canvas name
  1504	            review_canvas: Review canvas name
  1505	            mode: Mode used (fresh/targeted)
  1506	        """
  1507	        if not self.graphiti_client:
  1508	            logger.warning(
  1509	                "功能 %s 降级运行: %s 为 None，返回默认值 %s",
  1510	                "store_review_relationship",
  1511	                "graphiti_client",
  1512	                "skip",
  1513	            )
  1514	            return
  1515	
  1516	        try:
  1517	            from app.clients.graphiti_client import EdgeRelationship
  1518	
  1519	            relationship = EdgeRelationship(
  1520	                canvas_name=original_canvas,
  1521	                from_node=review_canvas,
  1522	                to_node=original_canvas,
  1523	                label=f"GENERATED_FROM_{mode.upper()}",
  1524	                edge_id=None,
  1525	            )
  1526	
  1527	            await self.graphiti_client.add_edge_relationship(relationship)
  1528	
  1529	            # Also add episode for tracking
  1530	            await self.graphiti_client.add_episode_for_edge(
  1531	                canvas_name=original_canvas,
  1532	                edge={
  1533	                    "fromNode": review_canvas,
  1534	                    "toNode": original_canvas,
  1535	                    "label": f"generated in {mode} mode",
  1536	                    "id": f"review_{mode}_{datetime.now(timezone.utc).strftime('%Y%m%d')}",
  1537	                },
  1538	            )
  1539	
  1540	            logger.info(
  1541	                f"Stored review relationship: {review_canvas} --[{mode}]--> {original_canvas}"
  1542	            )
  1543	
  1544	        except (
  1545	            ConnectionError,
  1546	            TimeoutError,
  1547	            ValueError,
  1548	            KeyError,
  1549	            TypeError,
  1550	            AttributeError,
  1551	        ) as e:
  1552	            logger.warning(f"Failed to store review relationship: {e}")
  1553	
  1554	    async def _apply_weighted_selection(
  1555	        self,
  1556	        weight_data: List[ConceptWeightData],
  1557	        question_count: int,
  1558	        weak_weight: float = 0.7,
  1559	        mastered_weight: float = 0.3,
  1560	    ) -> List[ConceptWeightData]:
  1561	        """
  1562	        Apply weighted selection to concept list.
  1563	
  1564	        ✅ Verified from Story 24.3 Dev Notes (lines 345-401)
  1565	
  1566	        AC2: Configurable Weight Distribution
  1567	        AC3: Weighted Concept Selection
  1568	
  1569	        Args:
  1570	            weight_data: Calculated weight data for all concepts
  1571	            question_count: Number of questions to select
  1572	            weak_weight: Weight for weak concepts (default 0.7)
  1573	            mastered_weight: Weight for mastered concepts (default 0.3)
  1574	
  1575	        Returns:
  1576	            Selected concepts based on weight distribution
  1577	
  1578	        Raises:
  1579	            ValueError: If weights don't sum to 1.0
  1580	        """
  1581	        # AC2: Validate weights
  1582	        if abs(weak_weight + mastered_weight - 1.0) > 0.01:
  1583	            raise ValueError("weak_weight + mastered_weight must equal 1.0")
  1584	
  1585	        # AC3: Categorize concepts
  1586	        weak = [c for c in weight_data if c.category == "weak"]
  1587	        mastered = [c for c in weight_data if c.category == "mastered"]
  1588	        borderline = [c for c in weight_data if c.category == "borderline"]
  1589	
  1590	        # Calculate target counts
  1591	        weak_count = int(question_count * weak_weight)
  1592	        mastered_count = int(question_count * mastered_weight)
  1593	        borderline_count = question_count - weak_count - mastered_count
  1594	
  1595	        selected = []
  1596	
  1597	        # Select from each category (with fallback if insufficient)
  1598	        if weak:
  1599	            selected.extend(self._weighted_sample(weak, min(weak_count, len(weak))))
  1600	        if mastered:
  1601	            selected.extend(
  1602	                self._weighted_sample(mastered, min(mastered_count, len(mastered)))
  1603	            )
  1604	        if borderline:
  1605	            selected.extend(
  1606	                self._weighted_sample(
  1607	                    borderline, min(borderline_count, len(borderline))
  1608	                )
  1609	            )
  1610	
  1611	        # Fill remaining from any category
  1612	        remaining = question_count - len(selected)
  1613	        if remaining > 0:
  1614	            all_remaining = [c for c in weight_data if c not in selected]
  1615	            selected.extend(
  1616	                self._weighted_sample(all_remaining, min(remaining, len(all_remaining)))
  1617	            )
  1618	
  1619	        logger.info(
  1620	            f"Weighted selection complete: {len(selected)} concepts selected "
  1621	            f"(target: {question_count}, weights: {weak_weight:.1%} weak / {mastered_weight:.1%} mastered)"
  1622	        )
  1623	
  1624	        return selected
  1625	
  1626	    def _weighted_sample(
  1627	        self, concepts: List[ConceptWeightData], count: int
  1628	    ) -> List[ConceptWeightData]:
  1629	        """
  1630	        Sample concepts with weights based on weakness_score.
  1631	
  1632	        ✅ Verified from Story 24.3 Dev Notes (lines 403-445)
  1633	
  1634	        AC3: Selection probability follows weight distribution.
  1635	
  1636	        Args:
  1637	            concepts: List of concepts to sample from
  1638	            count: Number to sample
  1639	
  1640	        Returns:
  1641	            Sampled concepts
  1642	        """
  1643	        if not concepts or count <= 0:
  1644	            return []
  1645	
  1646	        # Use weakness_score as probability weight
  1647	        weights = [c.weakness_score for c in concepts]
  1648	        total = sum(weights)
  1649	
  1650	        if total == 0:
  1651	            # Equal probability if all scores are 0
  1652	            return random.sample(concepts, min(count, len(concepts)))
  1653	
  1654	        # Normalize weights
  1655	        probabilities = [w / total for w in weights]
  1656	
  1657	        # Weighted sampling without replacement
  1658	        selected = []
  1659	        remaining = list(zip(concepts, probabilities))
  1660	
  1661	        for _ in range(min(count, len(concepts))):
  1662	            if not remaining:
  1663	                break
  1664	
  1665	            # Random selection based on probabilities
  1666	            r = random.random()
  1667	            cumulative = 0
  1668	            for i, (concept, prob) in enumerate(remaining):
  1669	                cumulative += prob
  1670	                if r <= cumulative:
  1671	                    selected.append(concept)
  1672	                    remaining.pop(i)
  1673	                    # Renormalize remaining probabilities
  1674	                    if remaining:
  1675	                        total_prob = sum(p for _, p in remaining)
  1676	                        remaining = [(c, p / total_prob) for c, p in remaining]
  1677	                    break
  1678	
  1679	        return selected
  1680	
  1681	    async def _query_review_history_from_memory(self, canvas_name: str) -> List[Dict]:
  1682	        """
  1683	        Query review history from LearningMemoryClient (JSON storage).
  1684	
  1685	        Renamed from _query_review_history_from_graphiti: uses LearningMemoryClient
  1686	        (JSON-backed), not graphiti-core. See Task 10 fake naming cleanup.
  1687	
  1688	        ✅ Verified from Story 24.3 Dev Notes (lines 538-592)
  1689	
  1690	        PRD Reference: v1.1.8 - query_review_history_from_graphiti tool
  1691	
  1692	        Args:
  1693	            canvas_name: Canvas file name
  1694	
  1695	        Returns:
