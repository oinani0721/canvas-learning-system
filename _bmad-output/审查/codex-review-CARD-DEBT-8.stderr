   184	
   185	    def _fallback_review(self, card: Dict, rating: int) -> Tuple[Dict, Dict]:
   186	        """Fallback review implementation when py-fsrs is not available."""
   187	        from datetime import timedelta
   188	
   189	        now = datetime.now(timezone.utc)
   190	
   191	        # Simple interval multipliers based on rating
   192	        multipliers = {1: 0.5, 2: 1.0, 3: 2.5, 4: 4.0}
   193	        base_interval = max(1, card.get("stability", 1))
   194	
   195	        # Calculate new interval
   196	        new_interval = base_interval * multipliers.get(rating, 1.0)
   197	
   198	        # Update difficulty based on rating
   199	        old_difficulty = card.get("difficulty", 5.0)
   200	        difficulty_change = {1: 0.5, 2: 0.25, 3: 0, 4: -0.25}
   201	        new_difficulty = max(
   202	            1, min(10, old_difficulty + difficulty_change.get(rating, 0))
   203	        )
   204	
   205	        # Update card state
   206	        updated_card = {
   207	            "due": now + timedelta(days=new_interval),
   208	            "stability": new_interval,
   209	            "difficulty": new_difficulty,
   210	            "state": State.Review if rating >= 2 else State.Relearning,
   211	            "reps": card.get("reps", 0) + 1,
   212	            "lapses": card.get("lapses", 0) + (1 if rating == 1 else 0),
   213	        }
   214	
   215	        review_log = {
   216	            "rating": rating,
   217	            "review_datetime": now,
   218	            "elapsed_days": 0,
   219	        }
   220	
   221	        return updated_card, review_log
