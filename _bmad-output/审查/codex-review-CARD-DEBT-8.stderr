   201	def create_fsrs_manager(settings=None) -> Optional[Any]:
   202	    """
   203	    Unified FSRSManager factory. Used by both DI and singleton paths.
   204	
   205	    Story 32.8 AC-32.8.3 + AC-32.8.4: Single creation path with USE_FSRS check.
   206	
   207	    Args:
   208	        settings: Application settings. If None, loads from get_settings().
   209	
   210	    Returns:
   211	        FSRSManager instance or None if FSRS is disabled/unavailable.
   212	    """
   213	    if settings is None:
   214	        try:
   215	            from app.config import get_settings
   216	
   217	            settings = get_settings()
   218	        except (ImportError, RuntimeError) as e:
   219	            logger.warning(f"Cannot load settings for FSRSManager: {e}")
   220	            return None
   221	
   222	    if not settings.USE_FSRS:
   223	        logger.info("FSRS disabled via USE_FSRS=False")
   224	        return None
   225	
   226	    if not FSRS_AVAILABLE or FSRSManager is None:
   227	        logger.warning("FSRS not available (py-fsrs not installed)")
   228	        return None
   229	
   230	    try:
   231	        retention = settings.FSRS_DESIRED_RETENTION
   232	        mgr = FSRSManager(desired_retention=retention)
   233	        logger.info(f"FSRSManager created (desired_retention={retention})")
   234	        return mgr
   235	    except (TypeError, ValueError, RuntimeError) as e:
   236	        logger.warning(f"FSRSManager creation failed: {e}")
   237	        return None
   238	
   239	
   240	class ReviewService:
   241	    """
   242	    Review and verification canvas business logic service.
   243	
   244	    Provides async methods for:
   245	    - Generating verification canvases
   246	    - Scheduling reviews based on Ebbinghaus curve
   247	    - Tracking review progress
   248	
   249	    [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#Layer-2-服务层]
   250	    """
   251	
   252	    def __init__(
   253	        self,
   254	        canvas_service: "CanvasService",
   255	        task_manager: "BackgroundTaskManager",
   256	        graphiti_client: Optional[Any] = None,
   257	        fsrs_manager: Optional[Any] = None,
   258	    ):
   259	        """
   260	        Initialize ReviewService.
   261	
   262	        Args:
   263	            canvas_service: CanvasService instance for canvas operations
   264	            task_manager: BackgroundTaskManager instance for async tasks
   265	            graphiti_client: Optional GraphitiEdgeClient for history tracking
   266	            fsrs_manager: Optional FSRSManager for FSRS-4.5 scheduling (Story 32.2)
   267	
   268	        [Source: docs/architecture/EPIC-11-BACKEND-ARCHITECTURE.md#依赖注入设计]
   269	        [Source: Story 24.1 - Graphiti Integration]
   270	        [Source: Story 32.2 - FSRS Integration]
   271	        """
   272	        self.canvas_service = canvas_service
   273	        self.task_manager = task_manager
   274	        self.graphiti_client = graphiti_client
   275	
   276	        # Story 32.2 AC-32.2.1: Initialize FSRSManager with configurable desired_retention
   277	        # Story 32.8 AC-32.8.3: USE_FSRS=False skips FSRSManager initialization
   278	        # Story 38.3 AC-3: Enhanced init logging for FSRS status
   279	        self._fsrs_init_ok = False
   280	        self._fsrs_init_reason: Optional[str] = None
   281	        global FSRS_RUNTIME_OK
   282	        if fsrs_manager is not None:
   283	            self._fsrs_manager = fsrs_manager
   284	            self._fsrs_init_ok = True
   285	            FSRS_RUNTIME_OK = True
   286	            logger.info("FSRS manager initialized successfully")
   287	        else:
   288	            # Story 32.8: Auto-create via unified factory (checks USE_FSRS internally)
   289	            auto_mgr = create_fsrs_manager()
   290	            if auto_mgr is not None:
   291	                self._fsrs_manager = auto_mgr
   292	                self._fsrs_init_ok = True
   293	                FSRS_RUNTIME_OK = True
   294	                logger.info("FSRS manager auto-created via factory")
   295	            else:
   296	                self._fsrs_manager = None
   297	                self._fsrs_init_reason = "FSRS disabled or unavailable"
   298	                FSRS_RUNTIME_OK = False
   299	                logger.warning(
   300	                    f"FSRS manager not initialized: {self._fsrs_init_reason}"
   301	                )
   302	
   303	        self._initialized = True
   304	        self._task_canvas_map: Dict[str, str] = {}  # Maps task_id to canvas_name
   305	        # Story 32.2 + P0-2: Card state storage with file persistence
   306	        self._card_states: Dict[str, str] = self._load_card_states()
   307	        # CARD-D3 Codex HIGH-1: 写失败后仍留在内存缓存的 concept (重启即丢)。
   308	        # 全量快照写成功时整体治愈 (clear), 查询侧据此如实上报 persisted。
   309	        self._unpersisted_concepts: set = set()
   310	        logger.debug("ReviewService initialized")
   311	
   312	    def _fsrs_library_ok(self) -> bool:
   313	        """CARD-DEBT-8: 底层 py-fsrs 是否真在位。
   314	
   315	        manager 存在只证明 fsrs_manager 模块可导入; py-fsrs 缺失时底层走
   316	        _fallback_review（简单倍率调度）, algorithm 字段必须据此如实上报。
   317	        getattr 缺省 True: 测试注入的替身 manager 无此属性时按"在位"处理,
   318	        与 HEAD 行为一致; 真实 FSRSManager 恒有 library_available。
   319	        """
   320	        return bool(getattr(self._fsrs_manager, "library_available", True))
   321	
   322	    @staticmethod
   323	    def _load_card_states() -> Dict[str, str]:
   324	        """P0-2: Load card states from persistent JSON file on startup."""
   325	        try:
   326	            if _CARD_STATES_FILE.exists():
   327	                data = _CARD_STATES_FILE.read_text(encoding="utf-8")
   328	                loaded = json.loads(data)
   329	                if isinstance(loaded, dict):
   330	                    logger.info(
   331	                        f"Loaded {len(loaded)} FSRS card states from {_CARD_STATES_FILE}"
   332	                    )
   333	                    return loaded
   334	        except (OSError, json.JSONDecodeError, UnicodeDecodeError) as e:
   335	            logger.warning(f"Failed to load FSRS card states: {e}")
   336	        return {}
   337	
   338	    async def _save_card_states(
   339	        self, pending: Optional[Tuple[str, str]] = None
   340	    ) -> bool:
   341	        """P0-2: Persist card states to JSON file with concurrency protection.
   342	
   343	        H2 fix: Uses asyncio.Lock to prevent concurrent writes and atomic
   344	        write (temp file + rename) to prevent file corruption.
   345	
   346	        Args:
   347	            pending: (concept_id, card_data) 本次要写入的状态。
   348	                CARD-D3 Codex HIGH-2: mutation 必须在锁内应用, 快照才必然
   349	                包含本次状态 — 返回的 bool 才与本次响应的 card_data 绑定
   350	                (原锁外 mutate 可被并发覆盖, True 证明不了本次成功)。
   351	
   352	        Returns:
   353	            True if the atomic write completed; False if it failed (logged).
   354	            CARD-C4 Codex HIGH-1: 文件是唯一真实持久化通道, 失败必须可被
   355	            调用方看见。CARD-D3: 评分/auto-create/save_card_state 三处
   356	            调用点均已消费此值。失败时 pending concept 进 _unpersisted_
   357	            concepts; 成功的全量快照治愈全部历史失败 (clear)。
   358	            CARD-D3 Codex HIGH-3: except 含 ValueError — lone surrogate
   359	            concept_id 的 UnicodeEncodeError 属 ValueError 族, 必须在
   360	            持久化边界归一为 False, 不得冒泡进算法 fallback。
   361	        """
   362	        _missing = object()
   363	        async with _card_states_lock:
   364	            if pending is not None:
   365	                prev = self._card_states.get(pending[0], _missing)
   366	                self._card_states[pending[0]] = pending[1]
   367	            try:
   368	                _CARD_STATES_FILE.parent.mkdir(parents=True, exist_ok=True)
   369	                data = json.dumps(self._card_states, ensure_ascii=False, indent=2)
   370	                # Atomic write: write to temp file then rename
   371	                tmp_file = _CARD_STATES_FILE.with_suffix(".json.tmp")
   372	                await asyncio.to_thread(tmp_file.write_text, data, "utf-8")
   373	                await asyncio.to_thread(tmp_file.replace, _CARD_STATES_FILE)
   374	                logger.debug(
   375	                    f"Saved {len(self._card_states)} FSRS card states to {_CARD_STATES_FILE}"
   376	                )
   377	                # 全量快照已落盘 → 所有历史写失败的 concept 同时被治愈
   378	                self._unpersisted_concepts.clear()
   379	                return True
   380	            except (TypeError, ValueError) as e:
   381	                # Codex 二轮残留 HIGH: 序列化/编码失败 = 本次 pending 数据
   382	                # 有毒 (mutation 是唯一入口, 存量条目必然干净) — 必须回滚
   383	                # 隔离, 否则毒 key 留在全量快照里拖垮后续所有 concept 的写。
   384	                if pending is not None:
   385	                    if prev is _missing:
   386	                        self._card_states.pop(pending[0], None)
   387	                    else:
   388	                        self._card_states[pending[0]] = prev
   389	                    self._unpersisted_concepts.add(pending[0])
   390	                logger.warning(f"Failed to save FSRS card states: {e}")
   391	                return False
   392	            except OSError as e:
   393	                # 磁盘失败: 卡数据本身没问题, 保留内存 (重启即丢, dirty
   394	                # 标记), 磁盘恢复后下一次成功全量写即治愈。
   395	                if pending is not None:
   396	                    self._unpersisted_concepts.add(pending[0])
   397	                logger.warning(f"Failed to save FSRS card states: {e}")
   398	                return False
   399	
   400	    def _extract_question_from_node(self, node: Dict[str, Any]) -> str:
   401	        """
   402	        Extract a question from a node's text content.
   403	
   404	        If the text contains a colon, treat the part before as the topic
   405	        and generate a question about it.
   406	
   407	        Args:
   408	            node: Node dict with 'text' field
   409	
   410	        Returns:
   411	            Generated question string
   412	        """
   413	        text = node.get("text", "")
   414	        if "：" in text:
   415	            # Chinese colon - extract topic
   416	            topic = text.split("：")[0]
   417	            return f"请解释{topic}的概念和含义？"
   418	        elif ":" in text:
   419	            # English colon - extract topic
   420	            topic = text.split(":")[0]
   421	            return f"请解释{topic}的概念和含义？"
   422	        else:
   423	            # No colon - ask about the whole text
   424	            return f"请解释{text}的概念和含义？"
   425	
   426	    async def generate_review_canvas(
   427	        self, canvas_name: str, node_ids: Optional[List[str]] = None
   428	    ) -> Dict[str, Any]:
   429	        """
   430	        Generate a verification canvas asynchronously.
   431	
   432	        Returns immediately with task_id, actual generation happens in background.
   433	
   434	        Args:
   435	            canvas_name: Source canvas name
   436	            node_ids: Optional list of specific node IDs to include
   437	
   438	        Returns:
   439	            Dict with task_id and status
   440	
   441	        Raises:
   442	            CanvasNotFoundException: If source canvas doesn't exist
   443	        """
   444	        # Check if canvas exists
   445	        if not await self.canvas_service.canvas_exists(canvas_name):
   446	            raise CanvasNotFoundException(f"Canvas not found: {canvas_name}")
   447	
   448	        # Create background task
   449	        async def _generate():
   450	            timestamp = datetime.now(timezone.utc).strftime("%Y%m%d")
   451	            return {
   452	                "name": f"{canvas_name}-检验白板-{timestamp}",
   453	                "source_canvas": canvas_name,
   454	                "nodes": [],
   455	                "edges": [],
   456	            }
   457	
   458	        task_id = await self.task_manager.create_task(
   459	            "review_generation", _generate, metadata={"canvas_name": canvas_name}
   460	        )
   461	
   462	        self._task_canvas_map[task_id] = canvas_name
   463	
   464	        return {
   465	            "task_id": task_id,
   466	            "status": "processing",
   467	            "message": f"Generating verification canvas for {canvas_name}",
   468	        }
   469	
   470	    async def get_progress(self, task_id: str) -> ReviewProgress:
   471	        """
   472	        Get progress of a review generation task.
   473	
   474	        Args:
   475	            task_id: Task ID from generate_review_canvas
   476	
   477	        Returns:
   478	            ReviewProgress object
   479	
   480	        Raises:
   481	            TaskNotFoundError: If task doesn't exist
   482	        """
   483	        task_info = self.task_manager.get_task_status(task_id)
   484	        canvas_name = self._task_canvas_map.get(task_id, "unknown")
   485	
   486	        # Map TaskStatus to ReviewStatus
   487	        from app.services.background_task_manager import TaskStatus
   488	
   489	        status_map = {
   490	            TaskStatus.PENDING: ReviewStatus.PENDING,
   491	            TaskStatus.RUNNING: ReviewStatus.RUNNING,
   492	            TaskStatus.COMPLETED: ReviewStatus.COMPLETED,
   493	            TaskStatus.FAILED: ReviewStatus.FAILED,
   494	            TaskStatus.CANCELLED: ReviewStatus.CANCELLED,
   495	        }
   496	
   497	        return ReviewProgress(
   498	            task_id=task_id,
   499	            canvas_name=canvas_name,
   500	            status=status_map.get(task_info.status, ReviewStatus.PENDING),
   501	            progress=task_info.progress,
   502	            error=task_info.error,
   503	        )
   504	
   505	    async def get_progress_dict(self, task_id: str) -> Dict[str, Any]:
   506	        """
   507	        Get progress as a dictionary.
   508	
   509	        Args:
   510	            task_id: Task ID
   511	
   512	        Returns:
   513	            Progress dictionary
   514	        """
   515	        progress = await self.get_progress(task_id)
   516	        return progress.to_dict()
   517	
   518	    async def cancel_generation(self, task_id: str) -> bool:
   519	        """
   520	        Cancel a running generation task.
   521	
   522	        Args:
   523	            task_id: Task ID to cancel
   524	
   525	        Returns:
   526	            True if cancelled, False if already completed
   527	        """
   528	        try:
   529	            return await self.task_manager.cancel_task(task_id)
   530	        except TaskNotFoundError:
   531	            return False
   532	
   533	    async def list_tasks(
   534	        self, canvas_name: Optional[str] = None, status: Optional[ReviewStatus] = None
   535	    ) -> List[ReviewProgress]:
   536	        """
   537	        List review generation tasks.
   538	
   539	        Args:
   540	            canvas_name: Optional filter by canvas name
   541	            status: Optional filter by status
   542	
   543	        Returns:
   544	            List of ReviewProgress objects
   545	        """
   546	        from app.services.background_task_manager import TaskStatus
   547	
   548	        # Get all review tasks from task manager
   549	        tasks = self.task_manager.list_tasks(task_type="review_generation")
   550	
   551	        results = []
   552	        for task_info in tasks:
   553	            task_canvas = self._task_canvas_map.get(task_info.task_id, "unknown")
   554	
   555	            # Filter by canvas_name if specified
   556	            if canvas_name and task_canvas != canvas_name:
   557	                continue
   558	
   559	            # Map TaskStatus to ReviewStatus
   560	            status_map = {
   561	                TaskStatus.PENDING: ReviewStatus.PENDING,
   562	                TaskStatus.RUNNING: ReviewStatus.RUNNING,
   563	                TaskStatus.COMPLETED: ReviewStatus.COMPLETED,
   564	                TaskStatus.FAILED: ReviewStatus.FAILED,
   565	                TaskStatus.CANCELLED: ReviewStatus.CANCELLED,
   566	            }
   567	            review_status = status_map.get(task_info.status, ReviewStatus.PENDING)
   568	
   569	            # Filter by status if specified
   570	            if status and review_status != status:
   571	                continue
   572	
   573	            results.append(
   574	                ReviewProgress(
   575	                    task_id=task_info.task_id,
   576	                    canvas_name=task_canvas,
   577	                    status=review_status,
   578	                    progress=task_info.progress,
   579	                    error=task_info.error,
   580	                )
   581	            )
   582	
   583	        return results
   584	
   585	    async def get_pending_reviews(self) -> List[Dict[str, Any]]:
   586	        """
