  1277	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  1278	    (vault / "learning_events.jsonl").unlink()
  1279	    assert _run_writer(vault, _payload()).returncode == 0
  1280	    sha_full = _sha(vault / NODE_REL)
