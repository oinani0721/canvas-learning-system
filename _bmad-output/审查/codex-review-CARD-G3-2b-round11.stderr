   381	def _fm_has_event_compat(fm_text, ev_id, all_ledger_ids=()):
   382	    """F1 判定: 按**完整** event_id 查; 裸键回落**仅在映射可证唯一时**才做。
   383	
   384	    回落只为**历史兼容** —— 本卡之前写入的校准记录存的是剥前缀形态。新写入一律
   385	    存完整形态, 所以新数据不会再走回落分支。
   386	
   387	    ⛔ 但回落本身会**制造新的别名** (Codex round-5 BLOCKER, 实测): 账本里同时
   388	    存在裸键 `K` 与带前缀的 `quiz:K` 时, 后者回落查 `K` 会命中前者写下的校准
   389	    条目 —— 两个**不同的完整 event_id** 别名成一个, 那次评分静默不入账
   390	    (实测 rc=0、账本 attempts=[1,2]、第三次评分没有校准条目)。
   391	
   392	    所以回落前必须**先证明映射唯一**: 账本里若同时存在 `K` 与 `quiz:K`
   393	    (裸形态相同的两个不同完整 id), 歧义不可消解 —— **停下**, 而不是猜一个。
   394	    """
   395	    # ⛔ **exact 命中也不得绕过歧义检查** (Codex round-7 BLOCKER)。
   396	    # 上一版第一行就是 `if _fm_has_event(fm_text, ev_id): return True` ——
   397	    # 实测漏账链: 首次提交 event_id='quiz:K' ⇒ 账本行 `quiz:quiz:K`; 把校准改成
   398	    # 历史形态 `quiz:K`; 再提交**新** id `K`(完整 id 也是 `quiz:K`) ⇒ exact 命中
   399	    # 那条历史条目、判「已完整应用」而幂等跳过, **账本/attempt/校准都没增加**。
   400	    #
   401	    # 正确做法: 一个校准 token 可能来自两种来源 —— 某个账本 id 的**完整**形态,
   402	    # 或某个带 `quiz:` 前缀的账本 id 的**历史裸**形态。先把命中的 token 反查回
   403	    # **所有可能的来源 id**, 再要求那个集合**恰为**当前这一个 id。
   404	    _cands = []
   405	    if _fm_has_event(fm_text, ev_id):
   406	        _cands.append(ev_id)
   407	    _bare = ev_id[5:] if ev_id.startswith("quiz:") else None
   408	    if _bare is not None and _fm_has_event(fm_text, _bare):
   409	        _cands.append(_bare)
   410	    if not _cands:
   411	        return False
   412	    # 反查: 每个账本 id 贡献「完整」token; 带前缀的再贡献「历史裸」token。
   413	    _sources = set()
   414	    for _tok in _cands:
   415	        for _lid in all_ledger_ids:
   416	            if _lid == _tok or (_lid.startswith("quiz:") and _lid[5:] == _tok):
   417	                _sources.add(_lid)
   418	    _sources.discard("")
   419	    if _sources and _sources != {ev_id}:
   420	        raise SystemExit(
   421	            f"[quiz-answer] 校准记录里的条目可能来自账本里的多个 event_id "
   422	            f"{sorted(_sources)!r} (完整形态与历史裸形态无法区分), 而本次要判定的是 "
   423	            f"{ev_id!r} — 猜一个就会让另一个静默不入账, fail-closed 拒写 — "
   424	            f"请人工统一这些 id (去掉裸形态或补上 `quiz:` 前缀)"
   425	        )
   426	    return True
