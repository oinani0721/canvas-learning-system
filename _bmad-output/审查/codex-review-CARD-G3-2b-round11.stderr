  3244	def test_round10_findings(vault):
  3245	    """round-10 的 5 BLOCKER + 1 HIGH。多条是我自己引入或没做完的：
  3246	
  3247	    · B③ 是「修一半」的**第五次** —— round-9 加 NFC 归一化只改了 dup owner 一处，
  3248	      适用集路由、concept_id、空白扫描、序数回推四处仍是 raw compare。
  3249	    · B⑤ 是「**声明比实现宽**」—— 声称四项可证事实，实际只比了 scored_at 与 grade_norm。
  3250	    · B④ 是我 round-5 加的 `_EARLY_LEDGER_IDS + (evid,)` —— 把「本次要判定的 id」
  3251	      自己当成了唯一性证据。
  3252	    """
  3253	    import unicodedata
  3254	    import yaml
  3255	
  3256	    LED = vault / "learning_events.jsonl"
  3257	
  3258	    def _fresh():
  3259	        (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
  3260	        LED.unlink(missing_ok=True)
  3261	
