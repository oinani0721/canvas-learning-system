   483	def main() -> int:
   484	    resolved = CE_ROOT.resolve() if CE_ROOT.exists() else CE_ROOT
   485	    if not str(resolved).startswith(str(FIXTURE_ROOT)):
   486	        sys.exit(f"[g32b-ce] 目标目录越出约定前缀 ({resolved}) — 拒跑")
   487	    if FIXTURE_ROOT.exists() and not (FIXTURE_ROOT / MARKER).is_file():
   488	        sys.exit(f"[g32b-ce] {FIXTURE_ROOT} 缺标记文件 {MARKER} — 先跑 g32b_build_fixture.py")
   489	    if CE_ROOT.exists():
   490	        shutil.rmtree(CE_ROOT)
   491	    CE_ROOT.mkdir(parents=True)
   492	    print(f"反例 fixture 根: {CE_ROOT}")
   493	    for fn in (r1, r2, r3, r4, r5, r6, r7, n1_n5):
   494	        fn()
   495	    bad = [t for t, ok, _ in RESULTS if not ok]
   496	    print(f"\n{'=' * 70}\n判据 {len(RESULTS) - len(bad)}/{len(RESULTS)} PASS")
   497	    if bad:
   498	        print("FAIL:", bad)
   499	        return 1
   500	    print("R1-R7 + round-1 后续 N1-N5 全部 fail-closed / 幂等 — 裁判 2 PASS")
   501	    return 0
   502	
   503	
   504	if __name__ == "__main__":
   505	    sys.exit(main())

