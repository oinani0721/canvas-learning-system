   101	#: 复习域扩展标记 (schema 文档 §六): 含此标记的行强制扩展键
   102	REVIEW_EXT_MARKER = "review/1"
   103	#: 降级写点的合法哨兵前缀 (fsrs 库不可用时的诚实口径, §六)
