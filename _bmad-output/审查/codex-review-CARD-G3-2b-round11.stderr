   352	def _no_dup_keys(pairs):
   353	    _seen = set()
   354	    for _k, _ in pairs:
   355	        if _k in _seen:
   356	            raise _DupKey(repr(_k))
   357	        _seen.add(_k)
   358	    return dict(pairs)
