  1236	def _strip_calibration(vault: Path) -> None:
  1237	    """删掉 frontmatter 的 calibration_log 块 (制造 f1=False 而其余副作用已在)。"""
  1238	    text = (vault / NODE_REL).read_text(encoding="utf-8")
  1239	    head, fm, body = text.split("---\n", 2)
  1240	    lines, out, skipping = fm.split("\n"), [], False
  1241	    for ln in lines:
  1242	        if ln.startswith("calibration_log:"):
  1243	            skipping = True
  1244	            continue
  1245	        if skipping and (ln.startswith("  ") or ln == ""):
  1246	            continue
  1247	        skipping = False
  1248	        out.append(ln)
  1249	    # calibration_log 通常是 frontmatter 最后一个键, 其块尾的空串元素会被上面的
  1250	    # skipping 分支吃掉 ⇒ 直接 join 会丢掉收尾换行、把 `---` 粘到末行上。
  1251	    new_fm = "\n".join(out).rstrip("\n") + "\n"
  1252	    (vault / NODE_REL).write_text(head + "---\n" + new_fm + "---\n" + body, encoding="utf-8")
  1253	
  1254	
  1255	def test_six_cell_state_machine_closed(vault):
  1256	    # ── 格1 dup=None, f1=F: 正常新写 (A2 先把 foreign pending 重放至空)
  1257	    foreign = _review_row(event_id="quiz:板A#q1")
  1258	    _write_ledger(vault, foreign)
  1259	    r1 = _run_writer_settled(vault, _payload(ts="2026-08-02T10:00:00Z", review_time="2026-08-02T10:00:00Z"))
  1260	    assert r1.returncode == 0, r1.stdout + r1.stderr
  1261	    assert "A2 重放已应用" in r1.stdout, "格1: foreign pending 必须在新写前重放"
  1262	    assert "恢复已落定" in r1.stderr, "格1: 恢复必须先独立落盘再要求重跑（两阶段）"
  1263	    assert len(_ledger_lines(vault)) == 2 and _fm_fields(vault)["fsrs_last_review"] == "2026-08-02T10:00:00Z"
  1264	
  1265	    # ── 格2 dup=None, f1=T: 旧写序孤儿 (frontmatter 已应用而账本无该事件) → 整体 no-op
  1266	    _write_ledger(vault, foreign)  # 抹掉本次事件行, calibration 仍在 frontmatter
  1267	    sha_before = _sha(vault / NODE_REL)
  1268	    # 同一次评分的**续跑**（同 event_id 的旧写序孤儿）：ts 变而稳定业务时刻不变。
  1269	    # round-9 后 F1-only 会拿 receipt 与本次逐项比对 —— 若这里让 review_time
  1270	    # 跟着 ts 走，那就成了「同 ID 承载另一次评分」，会被正确拒绝。
  1271	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z", review_time="2026-08-02T10:00:00Z"))
