   239	        r.returncode == 0 and "幂等跳过" in r.stdout and sha(v / NODE_REL) == s and len(rows(v)) == 2,
   240	        f"durable attempts={atts} rc={r.returncode} 节点未改={sha(v / NODE_REL) == s} "
   241	        f"账本={len(rows(v))}行 | {last_line(r.stdout)[:90]}",
