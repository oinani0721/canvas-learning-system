  3269	    row["event_id"] = "quiz:E1#q1"
  3270	    row["node_id"] = unicodedata.normalize("NFD", nfc)
  3271	    row["payload"]["concept_id"] = unicodedata.normalize("NFD", nfc)
  3272	    row["payload"]["scored_at"] = TS1
  3273	    _write_ledger(vault, row)
