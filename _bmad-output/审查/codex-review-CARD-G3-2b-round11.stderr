  1642	def main(argv: list[str]) -> int:
  1643	    if len(argv) != 2 or argv[1] in ("-h", "--help"):
  1644	        print(
  1645	            "用法: validate_learning_events.py <learning_events.jsonl 路径>",
  1646	            file=sys.stderr,
  1647	        )
  1648	        return 2
  1649	    path = Path(argv[1])
  1650	    if not path.is_file():
  1651	        print(f"错误: 文件不存在: {path}", file=sys.stderr)
  1652	        return 2
  1653	
  1654	    try:
  1655	        violations, warnings = validate_file(path)
  1656	    except OSError as e:
  1657	        print(f"错误: 读取失败: {e}", file=sys.stderr)
  1658	        return 2
  1659	
  1660	    for warning in warnings:
  1661	        print(f"WARN  {warning}")
  1662	    for violation in violations:
  1663	        print(f"FAIL  {violation}")
  1664	    if violations:
  1665	        print(f"RESULT: FAIL — {len(violations)} 项违规 (schema v1, {path})")
  1666	        return 1
  1667	    print(f"RESULT: PASS — schema v1 合规 ({path})")
  1668	    return 0
  1669	
  1670	
  1671	if __name__ == "__main__":
  1672	    sys.exit(main(sys.argv))

