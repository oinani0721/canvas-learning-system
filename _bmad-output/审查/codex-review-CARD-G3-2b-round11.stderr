   243	    rf = run(v, ts="2026-09-01T12:00:00Z", abandoned=True)
   244	    check("R3/验伪-换事实仍冲突", rf.returncode != 0 and "envelope 冲突" in rf.stderr, f"rc={rf.returncode}")
