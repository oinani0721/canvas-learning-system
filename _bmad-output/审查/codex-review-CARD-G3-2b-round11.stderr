   355	def n1_n5():
   356	    """round-1 后续：Codex 正文被内容过滤器拦下，按 stderr 保留的推理标题线索
   357	    逐条实测出的五个残留面（4 条复现为真缺陷 + 1 条诊断不精确）。"""
   358	    print("\n── N1 (BLOCKER) 标 out_of_order 但 review_time > W：被伪装成乱序的真实后继 ──")
   359	    v = new_vault("n1")
   360	    late = _pending_row(out_of_order=True, review_time="2026-08-05T10:00:00Z")
   361	    late["effective_at"] = "2026-08-05T10:00:00Z"
   362	    write_rows(v, late)
   363	    s = sha(v / NODE_REL)
   364	    r = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   365	    check(
   366	        "N1/伪装成乱序的后继",
   367	        r.returncode != 0 and "伪装成乱序的真实后继" in r.stderr and sha(v / NODE_REL) == s,
   368	        f"rc={r.returncode} 零写={sha(v / NODE_REL) == s} | {last_line(r.stderr)}",
   369	    )
   370	    for bad in (False, "true", 1):
   371	        write_rows(v, _pending_row(out_of_order=bad))
   372	        rb = run(v, event_id="板B#q1", ts="2026-08-02T10:00:00Z")
   373	        # round-5 后完整校验前移到乱序分流之前 ⇒ 坏形态先被**校验器本体**拦
   374	        # (两侧同口径), 写点自己的形态门成了其后的第二道。两种拒因都算达标,
   375	        # 但必须点名是这两者之一 —— 不能退化成「随便什么理由拒了都行」。
   376	        _why_ok = ("形态非法" in rb.stderr) or ("out_of_order 唯一合法值" in rb.stderr)
   377	        check(f"N1/形态 {bad!r} 非法", rb.returncode != 0 and _why_ok, f"rc={rb.returncode} | {last_line(rb.stderr)}")
   378	    (v / "learning_events.jsonl").unlink()
   379	    assert run(v).returncode == 0
   380	    early = _pending_row(out_of_order=True, review_time="2026-07-01T10:00:00Z")
   381	    early["effective_at"] = "2026-07-01T10:00:00Z"
   382	    early["event_id"] = "quiz:补录旧事件"
   383	    write_rows(v, rows(v)[0], early)
   384	    ro = run(v, event_id="板C#q1", ts="2026-08-03T10:00:00Z")
   385	    check(
   386	        "N1/验伪-合法乱序 (review_time ≤ W) 放行且不推进 W",
   387	        ro.returncode == 0 and fsrs_fields(v).get("fsrs_last_review") == "2026-08-03T10:00:00Z",
   388	        f"rc={ro.returncode} W={fsrs_fields(v).get('fsrs_last_review')}",
   389	    )
   390	
   391	    print("\n── N2 (HIGH) EOF 的 LF 判据必须落在字节上（文本模式会把裸 \\r 读成 \\n）──")
   392	    v = new_vault("n2")
   393	    good = _pending_row(review_time="2026-07-01T10:00:00Z")
   394	    good["event_id"] = "quiz:旧板"
   395	    good["effective_at"] = "2026-07-01T10:00:00Z"
   396	    good["node_id"] = "别的节点"
   397	    torn = '{"event_id": "quiz:损坏行", "event_ty'
   398	    head = (json.dumps(good, ensure_ascii=False) + "\n").encode("utf-8") + torn.encode("utf-8")
   399	    (v / "learning_events.jsonl").write_bytes(head + b"\r")
   400	    r = run(v)
   401	    check(
   402	        "N2/裸 \\r 结尾按字节算截断",
   403	        r.returncode == 0 and "截断尾行" in r.stdout,
   404	        f"rc={r.returncode} | {last_line(r.stdout)[:90]}",
   405	    )
   406	    (v / "learning_events.jsonl").write_bytes(head + b"\r\n")
   407	    rb = run(v, event_id="板D#q1", ts="2026-08-04T10:00:00Z")
   408	    check(
   409	        "N2/对照-真带 LF 仍 fail-closed",
   410	        rb.returncode != 0 and "完整写入的损坏行" in rb.stderr,
   411	        f"rc={rb.returncode}",
   412	    )
   413	    # R7-blank（Codex round-2 线索 "R7 blank bug"，实测复现）：判据必须落在
   414	    # 「**最后一个非空行**有没有终止 LF」上，不是「文件末尾有没有 LF」——
   415	    # 坏行后跟一个纯空白行、文件不以 LF 收尾时，旧判据说「截断」，可那行明明
   416	    # 后面还跟着东西。
   417	    (v / "learning_events.jsonl").write_bytes(head + b"\n   ")
   418	    rc2 = run(v, event_id="板E#q1", ts="2026-08-06T10:00:00Z")
   419	    # ⚠️ round-6 口径变更: 空行现在与校验器同口径**拒收** (校验器 VALIDATOR:737/:1571
   420	    # 判「append-only JSONL 不应出现空行」, 写点此前静默忽略 ⇒ 写点 rc=0 而校验器
   421	    # rc=1)。本例的构造含纯空白行 ⇒ 空行门先拦。两种拒因都是 fail-closed, 但必须
   422	    # 点名是这两者之一 —— 不能退化成「随便什么理由拒了都行」。
   423	    _why2 = ("完整写入的损坏行" in rc2.stderr) or ("是空行" in rc2.stderr)
   424	    check(
   425	        "N2/R7-blank：坏行带 LF + 末尾空白行 → 仍 fail-closed（round-6 起空行门先拦）",
   426	        rc2.returncode != 0 and _why2,
   427	        f"rc={rc2.returncode} | {last_line(rc2.stderr)}",
   428	    )
   429	    (v / "learning_events.jsonl").write_bytes(head + b"   ")
   430	    rd = run(v, event_id="板F#q1", ts="2026-08-07T10:00:00Z")
   431	    check(
   432	        "N2/R7-blank 验伪：坏行无 LF 但有尾随空格 → 仍算截断",
   433	        rd.returncode == 0 and "截断尾行" in rd.stdout,
   434	        f"rc={rd.returncode}",
   435	    )
   436	
   437	    print("\n── N3 (MEDIUM) 账本行 JSON 重复键：loads 静默取最后一个 ──")
   438	    v = new_vault("n3")
   439	    row = _pending_row()
   440	    row["event_id"] = "quiz:" + EID
   441	    text = json.dumps(row, ensure_ascii=False)
   442	    dup = text.replace('"grade_norm": 0.75', '"grade_norm": 0.11, "grade_norm": 0.75', 1)
   443	    assert dup.count('"grade_norm"') == 2
   444	    (v / "learning_events.jsonl").write_text(dup + "\n", encoding="utf-8")
   445	    r = run(v)
   446	    check(
   447	        "N3/重复键歧义",
   448	        r.returncode != 0 and "重复键" in r.stderr and not fsrs_fields(v),
   449	        f"rc={r.returncode} | {last_line(r.stderr)}",
   450	    )
   451	
   452	    print("\n── N4 (MEDIUM) 非法 UTF-8 字节须 clean fail-closed，不是 traceback ──")
   453	    v = new_vault("n4")
   454	    (v / "learning_events.jsonl").write_bytes(b'{"event_id": "quiz:x"}\n\xff\xfe bad\n')
   455	    r = run(v)
   456	    check(
   457	        "N4/非 UTF-8 字节",
   458	        r.returncode != 0 and "非 UTF-8 字节" in r.stderr and "Traceback" not in r.stderr,
   459	        f"rc={r.returncode} clean={'Traceback' not in r.stderr} | {last_line(r.stderr)}",
   460	    )
   461	
   462	    print("\n── N5 (MEDIUM) 多 pending 并存 → attempt 序数不可从账本边界确证 ──")
   463	    v = new_vault("n5")
   464	    e1 = _pending_row(review_time="2026-08-03T10:00:00Z")
   465	    e1["event_id"] = "quiz:板A#q1"
   466	    e1["effective_at"] = "2026-08-03T10:00:00Z"
   467	    e2 = _pending_row(
   468	        review_time="2026-08-04T10:00:00Z",
   469	        attempt_count=2,
   470	        exam_board="检验白板/测试检验-2026-08-01-1000.md",
   471	    )
   472	    e2["event_id"] = "quiz:" + EID
   473	    e2["effective_at"] = "2026-08-04T10:00:00Z"
   474	    write_rows(v, e1, e2)
   475	    r = run(v)
   476	    check(
   477	        "N5/A2 不变量破坏时报真因",
   478	        r.returncode != 0 and "不变量已被破坏" in r.stderr and not fsrs_fields(v),
   479	        f"rc={r.returncode} | {last_line(r.stderr)}",
   480	    )
