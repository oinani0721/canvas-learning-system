   630	    if ma and mb:
   631	        a_, b_ = float(ma.group(1)), float(mb.group(1))
   632	    elif old is not None:
   633	        a_, b_ = from_legacy(old)  # 旧 EMA 分迁移: 均值继承, 只给等效样本量3的低置信
   634	    else:
   635	        a_, b_ = PRIOR_A, PRIOR_B
   636	    # 闲置感知评分 (终审 A2, DAILY-REVIEW-PUSH-2026-07-29): 先按闲置天数折旧
