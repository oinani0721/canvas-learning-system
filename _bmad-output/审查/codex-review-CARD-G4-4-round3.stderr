   846	        if not LANCEDB_AVAILABLE:
   847	            if LOGURU_ENABLED:
   848	                logger.warning("LanceDB not installed. Run: pip install lancedb")
   849	            self._initialized = True
   850	            return False
   851	
   852	        try:
   853	            # ✅ Verified from LanceDB docs: lancedb.connect(path)
   854	            self._db = lancedb.connect(self.db_path)
   855	            self._initialized = True
   856	
   857	            # 缓存表信息
   858	            await self._cache_tables()
   859	
   860	            # Pre-load embedding model to avoid cold-start timeout during search
   861	            await self._init_vectorizer()
   862	
   863	            if LOGURU_ENABLED:
   864	                logger.info(f"LanceDBClient initialized: path={self.db_path}, tables={list(self._tables_cache.keys())}")
   865	
   866	            return True
   867	
   868	        except Exception as e:
   869	            if LOGURU_ENABLED:
   870	                logger.error(f"LanceDBClient initialization failed: {e}")
