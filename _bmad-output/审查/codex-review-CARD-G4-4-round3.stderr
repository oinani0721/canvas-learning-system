   730	            return "default"
   731	
   732	    def resolve_table_name(self, table_name: str) -> str:
   733	        """Prefix table_name with vault_id for namespace isolation.
   734	
   735	        Phase B0.7 (Round-4 ChatGPT V3 Q2 选项 B 兼容读策略):
   736	        若 {vid}_{table_name} 不存在但 unprefixed {table_name} 存在
   737	        → 回退到 unprefixed 读取（保留 'default' 旧数据兼容期）
   738	        新 vault 数据写入仍用 prefixed; 旧数据通过 fallback 仍可见.
   739	        """
   740	        vid = self.active_vault_id
   741	        if not vid or vid == "default":
   742	            return table_name
   743	        if table_name.startswith(f"{vid}_"):
   744	            return table_name
   745	        prefixed = f"{vid}_{table_name}"
   746	        # Phase B0.7 fallback: 若 prefixed 不存在但 unprefixed 存在 → 读 unprefixed
   747	        try:
   748	            if self._db is not None:
   749	                all_tables = self._db.table_names()
   750	                if prefixed not in all_tables and table_name in all_tables:
   751	                    logger.debug(
   752	                        "[LanceDB B0.7 fallback] %s not found, reading legacy %s",
   753	                        prefixed,
   754	                        table_name,
   755	                    )
   756	                    return table_name
   757	        except Exception:
   758	            pass
   759	        return prefixed
   760	
   761	    def list_vault_tables(self, vault_id: str | None = None) -> list[str]:
   762	        """Return table names belonging to a specific vault."""
   763	        if self._db is None:
   764	            return []
   765	        prefix = f"{vault_id}_" if vault_id and vault_id != "default" else ""
   766	        all_tables = self._db.table_names()
   767	        if not prefix:
   768	            # RAG-S1 Code-Review H3 (2026-08-03): 精确匹配裸指纹表 —
   769	            # endswith 会把每个 vault 的 {vid}_file_fingerprints 都归入
   770	            # default, DELETE /index/default 一次抹掉全部 vault 的变更检测。
   771	            return [t for t in all_tables if "_" not in t or t == self.FINGERPRINT_TABLE]
   772	        return [t for t in all_tables if t.startswith(prefix)]
   773	
   774	    def get_all_vault_stats(self) -> dict[str, dict]:
   775	        """Return per-vault table/row statistics."""
   776	        if self._db is None:
   777	            return {}
   778	        stats: dict[str, dict] = {}
   779	        for tname in self._db.table_names():
   780	            parts = tname.split("_", 1)
   781	            vid = parts[0] if len(parts) >= 2 else "default"
   782	            if vid not in stats:
   783	                stats[vid] = {"tables": 0, "rows": 0}
   784	            stats[vid]["tables"] += 1
   785	            try:
   786	                tbl = self._db.open_table(tname)
   787	                stats[vid]["rows"] += tbl.count_rows()
   788	            except Exception:
   789	                pass
   790	        return stats
   791	
   792	    def drop_vault_tables(self, vault_id: str) -> int:
   793	        """Drop all tables for a given vault_id. Returns count of dropped tables."""
   794	        if self._db is None:
   795	            return 0
   796	        tables = self.list_vault_tables(vault_id)
   797	        for tname in tables:
   798	            try:
   799	                self._db.drop_table(tname, ignore_missing=True)
   800	                self._tables_cache.pop(tname, None)
   801	            except Exception:
   802	                pass
   803	        return len(tables)
   804	
   805	    def connect_lightweight(self) -> bool:
   806	        """
   807	        RAG-S1 (2026-08-03): connect the DB WITHOUT loading the CPU embedding
   808	        model or running startup dimension checks.
   809	
   810	        For write-side callers (index orchestrator) that embed via the Ollama
   811	        batch path: full initialize() preloads bge-m3 CPU weights (~7.4s
   812	        measured) purely as a fallback, and _cache_tables() runs
   813	        _check_and_fix_dimension_mismatch which can DROP an in-construction
   814	        table from a read path. index_single_file / fingerprint methods only
   815	        need a live _db handle — they open tables per call.
   816	
   817	        Returns:
   818	            True if connection successful.
   819	        """
   820	        if not LANCEDB_AVAILABLE:
   821	            if LOGURU_ENABLED:
   822	                logger.warning("LanceDB not installed. Run: pip install lancedb")
   823	            self._initialized = True
   824	            return False
   825	        try:
   826	            self._db = lancedb.connect(self.db_path)
   827	            self._initialized = True
   828	            if LOGURU_ENABLED:
   829	                logger.info(f"LanceDBClient connect_lightweight: path={self.db_path}")
   830	            return True
   831	        except Exception as e:
   832	            if LOGURU_ENABLED:
   833	                logger.error(f"LanceDBClient connect_lightweight failed: {e}")
   834	            self._initialized = True
   835	            return False
