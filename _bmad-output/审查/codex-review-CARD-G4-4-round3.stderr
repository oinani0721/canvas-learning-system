+   102	    """
+   103	
+   104	    def __init__(self, inner: logging.Logger) -> None:
+   105	        self.inner = inner
+   106	
+   107	    # ── 内部 ────────────────────────────────────────────────────────────
+   108	    def _guarded(self, method: str, *args: Any, **kwargs: Any) -> None:
+   109	        """转调 ``inner.<method>``, 吞掉它抛出的一切并降级登记。
+   110	
+   111	        ``method`` 只来自本模块的 ``_LEVEL_METHODS`` 字面量, 不接受外部输入 ——
+   112	        ``getattr`` 本身不会失败, 除非 ``inner`` 根本不是 Logger (那属于调用方
+   113	        用错了本类, 会走进同一个 fallback 并留下 ``AttributeError`` 的 repr)。
+   114	
+   115	        ⚠️ stacklevel 补偿**必须在 try 内**做 (Codex round-1 HIGH-1):
+   116	        ``kwargs.get("stacklevel")`` 之外的求值若放在 try 外 —— 例如调用方传
+   117	        ``stacklevel=None`` 时 ``1 + None`` 的 TypeError —— 会直接传播, 击穿
+   118	        本类唯一的 no-throw 承诺。参数归一化本身就是可能抛错的操作。
+   119	        """
+   120	        try:
+   121	            kwargs["stacklevel"] = kwargs.get("stacklevel", 1) + _STACKLEVEL_OFFSET
+   122	            getattr(self.inner, method)(*args, **kwargs)
+   123	        except Exception as exc:  # noqa: BLE001 — 观测面刻意兜底, 见模块 docstring
+   124	            try:
