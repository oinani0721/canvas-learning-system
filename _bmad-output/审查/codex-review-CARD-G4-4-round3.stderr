+import tempfile
+import lancedb
+from agentic_rag.clients.lancedb_client import LanceDBClient
+import agentic_rag._nodes_impl as nodes
+from app.core.subject_config import _current_subject_id
+rows=[
+ {\"doc_id\":\"math_seed\",\"content\":\"math seed [[共同主题]]\",\"content_tokenized\":\"math seed\",\"vector\":[0.1]*8,\"canvas_file\":\"seed.canvas\",\"subject\":\"math\"},
+ {\"doc_id\":\"math_neighbor\",\"content\":\"math neighbor\",\"content_tokenized\":\"math neighbor\",\"vector\":[0.2]*8,\"canvas_file\":\"共同主题.canvas\",\"subject\":\"math\"},
+ {\"doc_id\":\"physics_secret\",\"content\":\"PHYSICS_SECRET\",\"content_tokenized\":\"physics secret\",\"vector\":[0.3]*8,\"canvas_file\":\"共同主题.canvas\",\"subject\":\"physics\"},
+]
+async def main():
+    with tempfile.TemporaryDirectory(prefix=\"g44-subject-\") as d:
+        db=lancedb.connect(d)
+        db.create_table(\"vault_a_canvas_nodes\",data=rows)
+        c=LanceDBClient(db_path=d,embedding_dim=8)
+        c._db=db
+        c._initialized=True
+        async def emb(q):
+            return [0.1]*8
+        async def get():
+            return c
+        c.embed=emb
+        nodes._get_lancedb_client=get
+        tok=_current_subject_id.set(\"vault:vault_a:math\")
+        try:
+            out=await nodes.retrieve_lancedb({\"messages\":[{\"role\":\"user\",\"content\":\"seed\"}],\"canvas_file\":None,\"subject\":\"math\",\"cross_subject\":False},None)
+        finally:
+            _current_subject_id.reset(tok)
+        rows_out=[(x.get(\"doc_id\"),x.get(\"content\"),x.get(\"metadata\",{}).get(\"source_type\")) for x in out[\"lancedb_results\"]]
