+   538	async def update_rag_config(updates: dict) -> dict:
+   539	    """
+   540	    Story 2.11 AC-5: Update RAG config and persist to YAML file.
+   541	    """
+   542	    import os
+   543	
+   544	    try:
+   545	        from agentic_rag.config import DEFAULT_CONFIG, validate_config
+   546	
+   547	        # Validate incoming updates against defaults
+   548	        test_config = DEFAULT_CONFIG.copy()
+   549	        test_config.update(updates)
+   550	        validated = validate_config(test_config)
+   551	
+   552	        # Persist to YAML file
+   553	        config_path = os.path.join(os.getcwd(), "config", "rag_config.yaml")
+   554	        try:
+   555	            import yaml
+   556	
+   557	            os.makedirs(os.path.dirname(config_path), exist_ok=True)
+   558	
+   559	            # Load existing file config
+   560	            existing = {}
+   561	            if os.path.isfile(config_path):
+   562	                with open(config_path, "r", encoding="utf-8") as f:
+   563	                    existing = yaml.safe_load(f) or {}
+   564	
+   565	            # Merge updates
+   566	            existing.update(updates)
+   567	
+   568	            with open(config_path, "w", encoding="utf-8") as f:
+   569	                yaml.dump(existing, f, default_flow_style=False, allow_unicode=True)
+   570	
+   571	            logger.info(
+   572	                f"[CONFIG] Updated {len(updates)} params, persisted to {config_path}"
+   573	            )
+   574	        except ImportError:
+   575	            logger.warning(
+   576	                "[CONFIG] pyyaml not installed, config not persisted to file"
+   577	            )
+   578	
+   579	        # Log changes
+   580	        for param, value in updates.items():
+   581	            old_val = DEFAULT_CONFIG.get(param, "N/A")
+   582	            logger.info(f"[CONFIG] Updated {param}: {old_val} -> {value}")
+   583	
+   584	        return {
+   585	            "status": "ok",
+   586	            "updated_keys": list(updates.keys()),
+   587	            "config": dict(validated),
+   588	        }
+   589	
+   590	    except Exception as e:
+   591	        logger.error(f"Failed to update RAG config: {e}")
+   592	        raise HTTPException(status_code=400, detail=f"Config update failed: {e}") from e
