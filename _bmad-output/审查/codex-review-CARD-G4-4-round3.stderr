    92	class TestCalculateTrend:
    93	    """Test _calculate_trend helper function (AC-31.3.4)."""
    94	
    95	    def test_single_score_returns_stable(self):
    96	        """Single score should return stable trend."""
    97	        result = _calculate_trend([75])
    98	        assert result == ActionTrend.stable
    99	
   100	    def test_empty_scores_returns_stable(self):
   101	        """Empty scores should return stable trend."""
   102	        # Actually, with < 2 scores, it returns stable
   103	        result = _calculate_trend([])
   104	        assert result == ActionTrend.stable
   105	
   106	    def test_improving_trend(self):
   107	        """Recent scores higher than older scores = improving."""
   108	        # Recent: [85, 80], avg=82.5; Older: [70, 65, 60], avg=65
   109	        # diff = 82.5 - 65 = 17.5 > 5 -> improving
   110	        result = _calculate_trend([85, 80, 70, 65, 60])
   111	        assert result == ActionTrend.improving
   112	
   113	    def test_declining_trend(self):
   114	        """Recent scores lower than older scores = declining."""
   115	        # Recent: [55, 50], avg=52.5; Older: [70, 75, 80], avg=75
   116	        # diff = 52.5 - 75 = -22.5 < -5 -> declining
   117	        result = _calculate_trend([55, 50, 70, 75, 80])
   118	        assert result == ActionTrend.declining
   119	
   120	    def test_stable_trend_small_diff(self):
   121	        """Small difference between recent and older scores = stable."""
   122	        # Recent: [72, 70], avg=71; Older: [70, 68, 69], avg=69
   123	        # diff = 71 - 69 = 2, not > 5 and not < -5 -> stable
   124	        result = _calculate_trend([72, 70, 70, 68, 69])
   125	        assert result == ActionTrend.stable
   126	
   127	    def test_two_scores_returns_stable(self):
   128	        """[Code Review M2]: Two scores should return stable (need ≥3 for trend)."""
   129	        result = _calculate_trend([80, 60])
   130	        assert result == ActionTrend.stable
   131	
   132	    def test_two_scores_declining_returns_stable(self):
   133	        """[Code Review M2]: Two scores should return stable even with large diff."""
   134	        result = _calculate_trend([50, 75])
   135	        assert result == ActionTrend.stable
   136	
   137	    def test_three_scores_improving(self):
   138	        """Three scores with clear improvement → improving."""
   139	        # mid = 1, recent: [85], older: avg([60, 55]) = 57.5, diff = 27.5 > 5
   140	        result = _calculate_trend([85, 60, 55])
   141	        assert result == ActionTrend.improving
   142	
   143	    def test_three_scores_declining(self):
   144	        """Three scores with clear decline → declining."""
   145	        # mid = 1, recent: [40], older: avg([70, 80]) = 75, diff = -35 < -5
   146	        result = _calculate_trend([40, 70, 80])
   147	        assert result == ActionTrend.declining
