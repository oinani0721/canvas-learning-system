    47	    ):
    48	        """
    49	        Initialize mock service.
    50	
    51	        Args:
    52	            history_items: List of history items to return (each with optional 'score' key)
    53	            should_raise: Whether to raise an exception
    54	        """
    55	        self.history_items = history_items or []
    56	        self.should_raise = should_raise
    57	        self.call_count = 0
    58	        self.last_params: Dict[str, Any] = {}
    59	
    60	    async def get_learning_history(
    61	        self,
    62	        user_id: str,
    63	        concept: Optional[str] = None,
    64	        page: int = 1,
    65	        page_size: int = 5,
    66	    ) -> Dict[str, Any]:
    67	        """Mock get_learning_history method."""
    68	        self.call_count += 1
    69	        self.last_params = {
    70	            "user_id": user_id,
    71	            "concept": concept,
    72	            "page": page,
    73	            "page_size": page_size,
    74	        }
    75	
    76	        if self.should_raise:
    77	            # CARD-G4-4 适配注: 原抛裸 Exception, 但 handler 的优雅降级
    78	            # 只捕预期依赖故障 (RuntimeError/ConnectionError/Timeout/Value/
    79	            # TypeError) — 裸 Exception 穿透是 handler 的**设计行为**, 本
    80	            # 测试意图「依赖故障不阻断响应」应在预期异常类型内验证。
    81	            raise RuntimeError("Mock history query error")
    82	
    83	        return {
    84	            "items": self.history_items,
    85	            "total": len(self.history_items),
    86	            "page": page,
    87	            "page_size": page_size,
    88	            "pages": 1,
    89	        }
