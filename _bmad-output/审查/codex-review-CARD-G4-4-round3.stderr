+   132	                pass
+   133	
+   134	    # ── stdlib Logger 的日志方法 ────────────────────────────────────────
+   135	    def debug(self, *args: Any, **kwargs: Any) -> None:
+   136	        self._guarded("debug", *args, **kwargs)
+   137	
+   138	    def info(self, *args: Any, **kwargs: Any) -> None:
+   139	        self._guarded("info", *args, **kwargs)
+   140	
+   141	    def warning(self, *args: Any, **kwargs: Any) -> None:
+   142	        self._guarded("warning", *args, **kwargs)
+   143	
+   144	    def error(self, *args: Any, **kwargs: Any) -> None:
+   145	        self._guarded("error", *args, **kwargs)
+   146	
+   147	    def exception(self, *args: Any, **kwargs: Any) -> None:
+   148	        self._guarded("exception", *args, **kwargs)
+   149	
+   150	    def critical(self, *args: Any, **kwargs: Any) -> None:
+   151	        self._guarded("critical", *args, **kwargs)
+   152	
+   153	    def log(self, level: int, *args: Any, **kwargs: Any) -> None:
+   154	        self._guarded("log", level, *args, **kwargs)
