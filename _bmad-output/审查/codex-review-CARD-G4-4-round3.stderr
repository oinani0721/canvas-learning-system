   150	class TestRecommendActionFromScore:
   151	    """Test _recommend_action_from_score helper function (AC-31.3.3)."""
   152	
   153	    def test_low_score_recommends_decompose(self):
   154	        """Score < 60 should recommend decompose."""
   155	        action, reason, agent, priority, review, alts = _recommend_action_from_score(45)
   156	        assert action == ActionType.decompose
   157	        assert agent == "/agents/decompose/basic"
   158	        assert "基础拆解" in reason
   159	        assert priority == 1
   160	        assert review is False
   161	
   162	    def test_medium_score_recommends_explain(self):
   163	        """Score 60-79 should recommend explain."""
   164	        action, reason, agent, priority, review, alts = _recommend_action_from_score(70)
   165	        assert action == ActionType.explain
   166	        assert agent == "/agents/explain/oral"
   167	        assert "解释" in reason
   168	        assert priority == 2
   169	        assert review is False
   170	
   171	    def test_high_score_recommends_next(self):
   172	        """Score >= 80 should recommend next."""
   173	        action, reason, agent, priority, review, alts = _recommend_action_from_score(85)
   174	        assert action == ActionType.next
   175	        assert agent is None
   176	        assert "继续" in reason
   177	        assert priority == 3
   178	        assert review is False
   179	
   180	    def test_boundary_60_recommends_explain(self):
   181	        """Score exactly 60 should recommend explain."""
   182	        action, _, _, _, _, _ = _recommend_action_from_score(60)
   183	        assert action == ActionType.explain
   184	
   185	    def test_boundary_80_recommends_next(self):
   186	        """Score exactly 80 should recommend next."""
   187	        action, _, _, _, _, _ = _recommend_action_from_score(80)
   188	        assert action == ActionType.next
   189	
   190	    def test_boundary_59_recommends_decompose(self):
   191	        """Score exactly 59 should recommend decompose."""
   192	        action, _, _, _, _, _ = _recommend_action_from_score(59)
   193	        assert action == ActionType.decompose
   194	
   195	    def test_declining_trend_suggests_review(self):
   196	        """Declining trend should suggest review."""
   197	        history = HistoryContext(
   198	            recent_scores=[55, 50, 45],
   199	            average_score=50.0,
   200	            trend=ActionTrend.declining,
   201	            consecutive_low_count=3,
   202	        )
   203	        _, _, _, priority, review, _ = _recommend_action_from_score(45, history)
   204	        assert review is True
   205	        assert priority == 1
   206	
   207	    def test_consecutive_low_scores_adds_alternatives(self):
   208	        """Consecutive low scores should add memory anchor alternative."""
   209	        history = HistoryContext(
   210	            recent_scores=[45, 40, 35, 38, 42],
   211	            average_score=40.0,
   212	            trend=ActionTrend.declining,
   213	            consecutive_low_count=5,
   214	        )
   215	        _, _, _, _, _, alts = _recommend_action_from_score(35, history)
   216	        assert len(alts) >= 1
   217	        assert any("/agents/explain/memory" in alt.agent for alt in alts)
   218	
   219	    def test_high_score_ignores_history(self):
   220	        """High score should not suggest review even with history."""
   221	        history = HistoryContext(
   222	            recent_scores=[85, 88, 90],
   223	            average_score=87.67,
   224	            trend=ActionTrend.improving,
   225	            consecutive_low_count=0,
   226	        )
   227	        action, _, _, _, review, _ = _recommend_action_from_score(90, history)
   228	        assert action == ActionType.next
   229	        assert review is False
   230	
   231	    def test_high_score_with_declining_trend_preserves_review(self):
   232	        """[Bug fix] High score with declining trend should still suggest review.
   233	
   234	        AC-31.3.4 requires considering historical trends even when current score is high.
   235	        Scenario: Student scores 82 but trend is 90→85→60→50→40 (declining).
   236	        """
   237	        history = HistoryContext(
   238	            recent_scores=[82, 60, 50, 40],
   239	            average_score=58.0,
   240	            trend=ActionTrend.declining,
   241	            consecutive_low_count=0,
   242	        )
   243	        action, _, _, _, review, _ = _recommend_action_from_score(82, history)
   244	        assert action == ActionType.next
   245	        assert review is True  # Must preserve declining trend warning
   246	
   247	    def test_high_score_with_consecutive_low_preserves_review(self):
   248	        """[Bug fix] High score after 3+ consecutive lows should still suggest review."""
   249	        history = HistoryContext(
   250	            recent_scores=[40, 35, 30],
   251	            average_score=35.0,
   252	            trend=ActionTrend.declining,
   253	            consecutive_low_count=3,
   254	        )
   255	        action, _, _, priority, review, alts = _recommend_action_from_score(85, history)
   256	        assert action == ActionType.next
   257	        assert review is True  # History concern persists
   258	        assert len(alts) >= 1  # Memory anchor alternative should be present
