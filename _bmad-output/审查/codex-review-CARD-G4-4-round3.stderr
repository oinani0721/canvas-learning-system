   396	def _make_client(tmp_path):
   397	    """不带 vault override 的 client — 表名完全由 ContextVar 推导 (这是被测行为)。
   398	    跳过 initialize() 的向量模型预载, 手动连 tmp 库。"""
   399	    import lancedb
   400	    from agentic_rag.clients.lancedb_client import LanceDBClient
   401	
   402	    client = LanceDBClient(db_path=str(tmp_path), embedding_dim=_DIM)
   403	    client._db = lancedb.connect(str(tmp_path))
   404	    client._initialized = True
   405	    return client
   406	
   407	
   408	def _run_retrieve_lancedb(monkeypatch, tmp_path, *, vault: str, query: str):
   409	    """以 vault 作用域跑真实 retrieve_lancedb 节点。
   410	
   411	    返回 (doc_id, content, source_type) 三元组列表 —— source_type 来自
   412	    metadata (expand_neighbors 标 neighbor_expansion), 活性门靠它区分
   413	    「主检索带回」与「扩展带回」。
   414	    """
   415	    client = _make_client(tmp_path)
