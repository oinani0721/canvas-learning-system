+    old = """        lancedb_results = await client.expand_neighbors(
+            results=lancedb_results,
+            table_name=client.resolve_table_name("canvas_nodes"),
+            max_neighbors=neighbor_max_count,
+            score_decay=neighbor_score_decay,
