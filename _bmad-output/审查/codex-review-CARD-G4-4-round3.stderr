   303	def _seed_dual_vault_db(tmp_path):
   304	    """同一个 tmp 目录预置 vault_a / vault_b 两张命名空间表。
   305	
   306	    「只有它在 B」笔记 (b_unique) 与 A/B 同名不同内容笔记 (same_name_*)
   307	    是隔离判据的核心; A 表另放干扰行保证正向对照不是查空表。
   308	    """
   309	    import lancedb
   310	
   311	    rows = {
   312	        "vault_a_canvas_nodes": [
   313	            {
   314	                "doc_id": "a_unique",
   315	                "subject": "math",
   316	                "content": "红黑树旋转的颜色翻转规则 [[递归基础]] [[b秘密板]]",
   317	                "vector": _vec(0.10),
   318	                "content_tokenized": _jieba_tokens("红黑树旋转的颜色翻转规则"),
   319	                "canvas_file": "a.canvas",
   320	            },
   321	            {
   322	                "doc_id": "same_name_a",
   323	                "subject": "math",
   324	                "content": "递归的基础定义: 函数调用自身",
   325	                "vector": _vec(0.20),
   326	                "content_tokenized": _jieba_tokens("递归的基础定义: 函数调用自身"),
   327	                "canvas_file": "a.canvas",
   328	            },
   329	            {
   330	                "doc_id": "a_neighbor",
   331	                "subject": "math",
   332	                "content": "递归基础 A 库版本内容",
   333	                "vector": _vec(0.30),
   334	                "content_tokenized": _jieba_tokens("递归基础 A 库版本内容"),
   335	                "canvas_file": "递归基础.canvas",
   336	            },
   337	        ],
   338	        "vault_b_canvas_nodes": [
   339	            {
   340	                "doc_id": "b_unique",
   341	                "subject": "cs",
   342	                "content": "贝尔不等式的量子纠缠判据",
   343	                "vector": _vec(0.10),
   344	                "content_tokenized": _jieba_tokens("贝尔不等式的量子纠缠判据"),
   345	                "canvas_file": "b.canvas",
   346	            },
   347	            {
   348	                "doc_id": "same_name_b",
   349	                "subject": "cs",
   350	                "content": "递归的进阶定义: 尾递归优化与调用栈",
   351	                "vector": _vec(0.20),
   352	                "content_tokenized": _jieba_tokens("递归的进阶定义: 尾递归优化与调用栈"),
   353	                "canvas_file": "b.canvas",
   354	            },
   355	        ],
   356	        # 裸 legacy 表 (无 vault 前缀) — Codex round-1 BLOCKER-1 反例:
   357	        # 邻居扩展若绕过作用域解析直接 open 裸表, B 的秘密内容会混进
   358	        # vault A 的检索结果。本表只有 B 内容, 修复后 A 作用域永不触达。
   359	        "vault_notes": [
   360	            {
   361	                "doc_id": "b_secret",
   362	                "subject": "cs",
   363	                "content": "B 库绝密量子隐形传态",
   364	                "vector": _vec(0.10),
   365	                "content_tokenized": _jieba_tokens("B 库绝密量子隐形传态"),
   366	                "canvas_file": "b秘密板.canvas",
   367	            },
   368	        ],
   369	    }
   370	    # 干扰行 (近距): 把 a_neighbor 挤出主检索 top — Codex round-2 整改:
   371	    # a_neighbor 原本就在主检索结果里, 扩展结果被 existing_doc_ids 去重,
   372	    # neighbor_expansion 标记恒不出现 (Codex 恒等函数反例)。挤出后
   373	    # a_neighbor 只能经 wiki-link 扩展进入, 活性门才成立。
   374	    rows["vault_a_canvas_nodes"].extend(
   375	        {
   376	            "doc_id": f"a_filler_{i}",
   377	            "subject": "math",
   378	            "content": f"占位干扰内容第{i}号与查询词无关",
   379	            "vector": _vec(0.12 + i * 0.001),
   380	            "content_tokenized": _jieba_tokens(f"占位干扰内容第{i}号"),
   381	            "canvas_file": f"a{i}.canvas",
   382	        }
   383	        for i in range(6)
   384	    )
   385	
   386	    db = lancedb.connect(str(tmp_path))
   387	    for name, data in rows.items():
   388	        db.create_table(name, data=data)
   389	        try:  # FTS 索引尽力建 — 失败则 hybrid 降级 dense-only, 判据不受影响
   390	            db.open_table(name).create_fts_index("content_tokenized", replace=True)
   391	        except Exception:
   392	            pass
   393	    return db
