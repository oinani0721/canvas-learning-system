    87	class TestCalculateTrend:
    88	    """Test _calculate_trend helper function (AC-31.3.4)."""
    89	
    90	    def test_single_score_returns_stable(self):
    91	        """Single score should return stable trend."""
    92	        result = _calculate_trend([75])
    93	        assert result == ActionTrend.stable
    94	
    95	    def test_empty_scores_returns_stable(self):
    96	        """Empty scores should return stable trend."""
    97	        # Actually, with < 2 scores, it returns stable
    98	        result = _calculate_trend([])
    99	        assert result == ActionTrend.stable
   100	
   101	    def test_improving_trend(self):
   102	        """Recent scores higher than older scores = improving."""
   103	        # Recent: [85, 80], avg=82.5; Older: [70, 65, 60], avg=65
   104	        # diff = 82.5 - 65 = 17.5 > 5 -> improving
   105	        result = _calculate_trend([85, 80, 70, 65, 60])
   106	        assert result == ActionTrend.improving
   107	
   108	    def test_declining_trend(self):
   109	        """Recent scores lower than older scores = declining."""
   110	        # Recent: [55, 50], avg=52.5; Older: [70, 75, 80], avg=75
   111	        # diff = 52.5 - 75 = -22.5 < -5 -> declining
   112	        result = _calculate_trend([55, 50, 70, 75, 80])
   113	        assert result == ActionTrend.declining
   114	
   115	    def test_stable_trend_small_diff(self):
   116	        """Small difference between recent and older scores = stable."""
   117	        # Recent: [72, 70], avg=71; Older: [70, 68, 69], avg=69
   118	        # diff = 71 - 69 = 2, not > 5 and not < -5 -> stable
   119	        result = _calculate_trend([72, 70, 70, 68, 69])
   120	        assert result == ActionTrend.stable
   121	
   122	    def test_two_scores_returns_stable(self):
   123	        """[Code Review M2]: Two scores should return stable (need ≥3 for trend)."""
   124	        result = _calculate_trend([80, 60])
   125	        assert result == ActionTrend.stable
   126	
   127	    def test_two_scores_declining_returns_stable(self):
   128	        """[Code Review M2]: Two scores should return stable even with large diff."""
   129	        result = _calculate_trend([50, 75])
   130	        assert result == ActionTrend.stable
   131	
   132	    def test_three_scores_improving(self):
   133	        """Three scores with clear improvement → improving."""
   134	        # mid = 1, recent: [85], older: avg([60, 55]) = 57.5, diff = 27.5 > 5
   135	        result = _calculate_trend([85, 60, 55])
