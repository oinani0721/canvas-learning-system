   872	            self._initialized = True
   873	            return False
   874	
   875	    async def _cache_tables(self):
   876	        """缓存表信息，并检查向量维度是否与当前模型匹配"""
   877	        if self._db is None:
   878	            return
   879	
   880	        try:
   881	            table_names = self._db.table_names()
   882	            for name in table_names:
   883	                try:
   884	                    self._tables_cache[name] = self._db.open_table(name)
   885	                except Exception:
   886	                    pass
   887	
   888	            # Story 2.3 Task 6: Auto-detect dimension mismatch on startup
   889	            # Check vector tables against expected embedding_dim
   890	            # RAG-S1 F1 (2026-08-03): endswith — 前缀化后 {vid}_file_fingerprints
   891	            # 也必须跳过, 否则维度检查会把无 vector 列的指纹表 drop 掉
   892	            vector_tables = [t for t in self._tables_cache if not t.endswith(self.FINGERPRINT_TABLE)]
   893	            for tname in vector_tables:
   894	                self._check_and_fix_dimension_mismatch(tname, self.embedding_dim)
   895	
   896	        except Exception as e:
   897	            if LOGURU_ENABLED:
   898	                logger.debug(f"Failed to cache tables: {e}")
