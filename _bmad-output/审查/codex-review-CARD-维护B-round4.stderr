  1438	_CJK_NUM = {
  1439	    "零": 0,
  1440	    "〇": 0,
  1441	    "一": 1,
  1442	    "二": 2,
  1443	    "两": 2,
  1444	    "三": 3,
  1445	    "四": 4,
  1446	    "五": 5,
  1447	    "六": 6,
  1448	    "七": 7,
  1449	    "八": 8,
  1450	    "九": 9,
  1451	}
  1452	_CJK_UNIT = {"十": 10, "百": 100, "千": 1000, "万": 10000, "亿": 100000000}
  1453	_CJK_NUM_RE = re.compile(r"[零〇一二两三四五六七八九十百千万亿]{1,12}")
