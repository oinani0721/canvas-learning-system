  1563	def _mutate_report(tmp_path: Path, mutate) -> subprocess.CompletedProcess:
  1564	    """在标准 fixture 报告上施加一处变异后跑 --verify。"""
  1565	    vault = standard_vault(tmp_path)
  1566	    scan = collect_json(vault)
  1567	    report = write_report(vault, scan)
  1568	    base = run_verify(report)
  1569	    assert base.returncode == 0, f"基线报告本身就不过 verifier:\n{base.stdout}"
  1570	    before = report.read_text(encoding="utf-8")
  1571	    after = mutate(before, scan)
  1572	    # ⛔ MEMORY `reference_gate_design_pitfalls`: `str.replace` 不命中**不报错**——
  1573	    # 变异没打上去、报告没变、verifier 当然 exit 0，而拦截门会把这读成"未被拦"，
  1574	    # 或者更糟：某天实现修好了，这条门却因为构造失效而恒绿。变异必须真的改到东西。
  1575	    assert after != before, "变异未命中：报告一字未改，这条门测的是空气"
  1576	    report.write_text(after, encoding="utf-8")
  1577	    return run_verify(report)
  1578	
  1579	
  1580	def _sig_line(text: str, label: str = "来源覆盖率") -> str:
  1581	    return next(ln for ln in text.splitlines() if label in ln)
