  1662	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  1663	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  1664	
  1665	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  1666	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  1667	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  1668	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  1669	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  1670	    """
  1671	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  1672	    if not mb:
  1673	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  1674	        return
  1675	    board_id = mb.group(1).strip()
  1676	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  1677	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  1678	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  1679	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
  1680	    if not mname:
  1681	        problems.append(f"报告文件名不符 `回顾-<板>-<日期>.md`: {report_path.name}")
  1682	    elif mname.group(1) != board_id:
  1683	        problems.append(
  1684	            f"数字终核: frontmatter board={board_id!r} 与文件名的板 "
  1685	            f"{mname.group(1)!r} 不一致 (不得绑定另一块板的 scan JSON)"
  1686	        )
  1687	    scan_path = report_path.parent / f".recap-scan-{board_id}.json"
  1688	    try:
  1689	        scan = json.loads(scan_path.read_text(encoding="utf-8"))
  1690	    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
  1691	        problems.append(
  1692	            f"数字终核 fail-closed: scan JSON 缺失或损坏 ({scan_path.name})"
  1693	        )
  1694	        return
  1695	    for key, pat in (
  1696	        ("board_sha256", r'^board_sha256:\s*"?([0-9a-f]{64})"?'),
  1697	        ("data_mode", r"^data_mode:\s*(\S+)"),
  1698	        ("recap_date", r"^recap_date:\s*(\S+)"),
  1699	    ):
  1700	        mm = re.search(pat, fm, re.M)
  1701	        want = (
  1702	            scan.get(key)
