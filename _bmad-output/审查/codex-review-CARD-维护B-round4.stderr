fence = chr(96) * 3
labels = [\"未答问题年龄\", \"来源覆盖率\", \"无来源结论\", \"重复堆积\"]

def outcome(name, report):
    r = m.run_verify(report)
    line = r.stdout.strip().replace(chr(10), \" | \")
    print(f\"{name}: rc={r.returncode}; {line}\")
    return r

with tempfile.TemporaryDirectory(prefix=\"codex-r4-a-\") as td:
    vault = m.standard_vault(Path(td))
    scan = m.collect_json(vault)
    report = m.write_report(vault, scan)
    lines = report.read_text(encoding=\"utf-8\").splitlines()
    idx = [i for i, ln in enumerate(lines) if any(lb in ln for lb in labels)]
    core = [re.sub(r\""'^[>'"\\s]*-\\s*\", \"\", lines[i]) for i in range(idx[0], idx[-1] + 1)]
    body = [\" > - \" + fence] + [\" >   \" + x for x in core] + [\" >   \" + fence]
    html = MarkdownIt(\"commonmark\").render(chr(10).join(body))
    code_html = html.split(\"<pre><code>\", 1)[1].split(\"</code></pre>\", 1)[0]
    print(\"A-render: pre_code=yes; all_four_labels_in_code=\" + str(all(lb in code_html for lb in labels)))
    lines = lines[:idx[0]] + body + lines[idx[-1] + 1:]
    report.write_text(chr(10).join(lines) + chr(10), encoding=\"utf-8\")
    outcome(\"A-indented-blockquote-list-hidden-signals\", report)

with tempfile.TemporaryDirectory(prefix=\"codex-r4-b-\") as td:
    vault = m.standard_vault(Path(td))
    manifest = m.make_manifest(vault)
    scan = m.collect_json(vault, \"--manifest\", str(manifest))
    report = m.write_report(vault, scan)
    text = report.read_text(encoding=\"utf-8\")
    text += chr(10) + \"## 附录\" + chr(10) * 2 + \"- 无来源结论：987654/2 派生角色成员缺来源锚点【实测】\" + chr(10)
    report.write_text(text, encoding=\"utf-8\")
    outcome(\"B-manifest-appendix-fake-signal\", report)

with tempfile.TemporaryDirectory(prefix=\"codex-r4-c-\") as td:
    vault = m.standard_vault(Path(td))
    scan = m.collect_json(vault)
