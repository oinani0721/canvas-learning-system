  3018	
  3019	def test_domain_r3_derive_allow_numbers_in_pool(tmp_path):
  3020	    """HIGH-6: fallback 允许式放行的行，行内数字必须在 scan 数值池。
  3021	
  3022	    · `#### 派生子女 987654 个的说明`（四级标题，不截断③段）曾放行；
  3023	    · `- 关系类型分布：无 987654` 曾放行。
  3024	    反向: 无数字的合法标题/关系行、报告主标题年份不受牵连。
  3025	    """
  3026	    for name, inject, want in (
  3027	        ("标题夹伪计数", "\n#### 派生子女 987654 个的说明\n", 1),
  3028	        ("关系行夹伪计数", "\n- 关系类型分布：无 987654\n", 1),
  3029	        ("合法关系行无数字", "\n- 关系类型分布：无\n", 0),
  3030	    ):
  3031	        r = _mutate_report(
  3032	            tmp_path / name,
  3033	            lambda t, s, e=inject: t.replace("方向叙述：", f"{e}\n方向叙述：", 1) if e else t,
  3034	        )
  3035	        if want == 1:
  3036	            assert r.returncode != 0, f"{name}: 无出处数字被放行:\n{r.stdout}"
  3037	            assert "无出处" in r.stdout, f"{name}: 拦截理由异常:\n{r.stdout}"
  3038	        else:
  3039	            assert r.returncode == 0, f"{name}: 合法行被误伤:\n{r.stdout}"
  3040	    # 主标题年份不误伤（`# 回顾 · 板 · 2026-09-01` 不含「派生」，不在检查范围）
  3041	    # ——由上面「合法关系行无数字」与全套件的放行门共同覆盖；不单列空变异 case
  3042	    # （_mutate_report 的防空气断言会拒绝不改内容的变异）。

