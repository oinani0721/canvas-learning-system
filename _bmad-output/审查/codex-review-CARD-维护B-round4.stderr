  1068	def _verify_signal_lines(text: str, signals: dict, problems: list[str]) -> None:
  1069	    """G5-4 信号绑定 (fail-closed): scan JSON 含 signals 键才进本函数。
  1070	
  1071	    ③段必须逐信号给**独占一行**的标准行, 行内数字与 availability 档与
  1072	    signals.* 全等 — 篡改任一数字 / 档位 / 缺行 / 无据错标 / 合并行 → FAIL。
  1073	    旧 scan JSON (无 signals 键) 由调用方跳过 (兼容)。同 label 行若出现
  1074	    多条, 逐条全查 — 防"一条合规一条私货"的双行逃逸。
  1075	    """
  1076	    # M3 (round-2 → round-4): ③ 段止于下一个 ## / ###。历轮收紧:
  1077	    #   round-2 只认 ###（"## 附录"可越界）→ round-3 认 tab 分隔（"##\t附录"）
  1078	    #   → round-4 认**空标题** `##`（行尾即止，无标题文字也是合法标题）。
  1079	    # 另: 信号行**不得藏在代码块里** — fenced (```/~~~) 与四空格缩进块在渲染
  1080	    # 时是字面文本, 与"报告在说什么"分叉, 故校验前整体剔除。
  1081	    scan_text = _strip_code_blocks(text)
  1082	    # ⛔ round-6 终裁复核: 剔除代码块是**双向**的 — 它挡住"把必需行藏进围栏",
  1083	    # 却放行"在合规行之外再往围栏里追加一组造假信号行"(围栏内容在 Obsidian
  1084	    # 里照常渲染为可见文本, 读者会看到与 scan JSON 冲突的第二组数字)。
  1085	    # 故: 被剔除的那部分文本里**不得出现任何信号 label**。
  1086	    # ⛔ CARD-维护B-R2 round-3 HIGH-3: 原 zip() 在行数不等时静默截断 ——
  1087	    # EOF 未闭合围栏把尾部行全部剥空后, splitlines() 行数差让**最后一行原文
  1088	    # 不参与比较**, 藏在里面的伪信号逃过本检查。改 zip_longest 对齐。
  1089	    stripped_only = "\n".join(
  1090	        a
  1091	        for a, b in zip_longest(text.splitlines(), scan_text.splitlines(), fillvalue="")
  1092	        if a != b
  1093	    )
  1094	    for _, lb in _SIGNAL_SPECS:
  1095	        if lb in stripped_only:
  1096	            problems.append(
  1097	                f"代码块内出现信号名 {lb} (围栏内容仍会渲染给读者, "
  1098	                "不得放置第二组信号数字)"
  1099	            )
  1100	    s3 = "\n".join(
  1101	        re.findall(r"^### ③.*?(?=^#{2,3}(?:[^\S\n]|$)|\Z)", scan_text, re.M | re.S)
  1102	    )
  1103	    if not s3:
  1104	        problems.append("数字终核: scan JSON 含 signals 但报告缺 ③ 段可绑定信号行")
  1105	        return
  1106	    all_labels = [lb for _, lb in _SIGNAL_SPECS]
  1107	    for key, label in _SIGNAL_SPECS:
  1108	        sig = signals.get(key)
  1109	        if not _verify_signal_schema(key, sig, problems):
  1110	            continue

