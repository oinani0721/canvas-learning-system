  3006	    scan = collect_json(vault)
  3007	    assert scan["data_mode"] == "fallback_local"
  3008	    assert scan["signals"]["unsourced_conclusions"]["value"] == 0, "fixture 真值变化，先改此门"
  3009	    report = write_report(vault, scan)
