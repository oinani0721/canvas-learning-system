   138	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   139	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   140	
   141	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   142	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   143	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   144	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   145	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   146	    要求"确实收集到用例"且"确实有失败"才算变红。
   147	    """
   148	    r = subprocess.run(
   149	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   150	        cwd=ROOT / "backend",
   151	        capture_output=True,
   152	        text=True,
   153	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   154	        timeout=600,
   155	    )
   156	    out = r.stdout
   157	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   158	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   159	    return r.returncode, out[-400:], passed + failed, failed
   160	
   161	
   162	def main() -> int:
   163	    try:
   164	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   165	    except FileExistsError:
   166	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   167	        return 2
   168	    try:
   169	        original = TARGET.read_bytes()
   170	        backup_sha = hashlib.sha256(original).hexdigest()
   171	
   172	        rc0, out0, n0, f0 = run_suite("domain_")
   173	        if rc0 != 0 or f0 or n0 == 0:
   174	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   175	            return 2
   176	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   177	
   178	        failures = 0
   179	        for name, subs, keyword in MUTANTS:
   180	            text = original.decode("utf-8")
   181	            for old, new in subs:
   182	                if old not in text:
   183	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   184	                    failures += 1
   185	                    text = None
   186	                    break
   187	                text = text.replace(old, new, 1)
   188	            if text is None:
   189	                continue
   190	            TARGET.write_text(text, encoding="utf-8")
   191	            try:
   192	                rc, out, n, f = run_suite(keyword)
   193	            finally:
   194	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   195	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   196	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   197	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   198	            if n == 0:
   199	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   200	                failures += 1
   201	            elif f == 0:
   202	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   203	                failures += 1
   204	            else:
   205	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   206	
   207	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   208	        return 1 if failures else 0
   209	    finally:
   210	        LOCK.rmdir()
   211	
   212	
   213	if __name__ == "__main__":
   214	    sys.exit(main())

