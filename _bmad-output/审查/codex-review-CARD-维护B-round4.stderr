   114	# ────────────────────────── fixture 构造器 ──────────────────────────
   115	
   116	
   117	def write_node(
   118	    vault: Path,
   119	    name: str,
   120	    *,
   121	    source_note: str | None = None,
   122	    derived_from: str | None = None,
   123	    tips: list[dict] | None = None,
   124	    stub: bool = False,
   125	) -> None:
   126	    fm = ["---", "type: concept", f'source_board: "[[原白板/{BOARD}]]"']
   127	    if source_note:
   128	        fm.append(f'source_note: "{source_note}"')
   129	    if derived_from:
   130	        fm.append(f'derived-from: "{derived_from}"')
   131	    if tips:
   132	        fm.append("tips:")
   133	        for t in tips:
   134	            fm.append(f"  - text: {t['text']}")
   135	            if t.get("added_at"):
   136	                fm.append(f"    added_at: {t['added_at']}")
   137	            if t.get("understanding"):
   138	                fm.append(f"    understanding: {t['understanding']}")
   139	    fm.append("---")
   140	    body = f"# {name}\n\n## 核心概念\n\n"
   141	    body += "（你的 1-2 句精准定义。）\n" if stub else "已有正文。\n"
   142	    (vault / "节点" / f"{name}.md").write_text("\n".join(fm) + "\n" + body, encoding="utf-8")
   143	
   144	
   145	def build_vault(tmp_path: Path, members: list[str]) -> Path:
   146	    vault = tmp_path / "vault"
   147	    for sub in ("原白板", "节点", "outputs"):
   148	        (vault / sub).mkdir(parents=True)
   149	    links = "\n".join(f"- [[节点/{m}]]" for m in members)
   150	    (vault / "原白板" / f"{BOARD}.md").write_text(
   151	        f"---\ntype: whiteboard\nboard_name: {BOARD}\n---\n\n# {BOARD}\n\n## Concepts\n\n{links}\n",
   152	        encoding="utf-8",
   153	    )
   154	    return vault
   155	
   156	
   157	def standard_vault(tmp_path: Path) -> Path:
   158	    """3 成员: 种子无 provenance + 派生带 source_note + 派生缺 source_note。"""
   159	    vault = build_vault(tmp_path, ["SeedA", "DerivedB", "DerivedC"])
   160	    write_node(
   161	        vault,
   162	        "SeedA",
   163	        tips=[
   164	            {"text": "What is X", "added_at": _ts(11)},
   165	            {"text": "what   is x", "added_at": _ts(5)},
   166	        ],
   167	    )
   168	    write_node(
   169	        vault,
   170	        "DerivedB",
   171	        source_note="[[节点/SeedA|别名]]",
   172	        derived_from="[[SeedA]]",
   173	        tips=[
   174	            {"text": "What is X", "added_at": _ts(2)},
   175	            {"text": "unique question", "added_at": "not-a-date"},
   176	        ],
   177	        stub=True,
   178	    )
   179	    write_node(vault, "DerivedC", derived_from="[[SeedA]]")
   180	    return vault
   181	
   182	
   183	def collect_json(vault: Path, *extra: str) -> dict:
   184	    r = run_collect(vault, BOARD, *extra)
   185	    assert r.returncode == 0, r.stderr
   186	    return json.loads(r.stdout)
   187	
   188	
   189	def make_manifest(vault: Path) -> Path:
   190	    """manifest 模式 fixture: 与 standard_vault 同板 3 成员。"""
   191	    nodes = [
   192	        {
   193	            "node_id": "SeedA",
   194	            "role": "seed",
   195	            "is_stub": False,
   196	            "source_note": None,
   197	            "tips": [
   198	                {"text": "What is X", "added_at": _ts(11)},
   199	                {"text": "what   is x", "added_at": _ts(5)},
   200	            ],
   201	        },
   202	        {
   203	            "node_id": "DerivedB",
   204	            "role": "derived",
   205	            "is_stub": True,
   206	            "source_note": "SeedA",
   207	            # L1 (Codex round-2 fixture 忠实度): 真 frontmatter 只有
   208	            # derived-from 单链 → _node_relation 走退路分支产 derived_from
   209	            # 且 derived_reason/derived_at 为 None（原先手写成 extends 失真）
   210	            "relation": {
   211	                "type": "derived_from",
   212	                "target_node_id": "SeedA",
   213	                "derived_reason": None,
   214	                "derived_at": None,
   215	            },
   216	            "tips": [{"text": "What is X", "added_at": _ts(2)}],
   217	        },
   218	        {
   219	            "node_id": "DerivedC",
   220	            "role": "derived",
   221	            "is_stub": False,
   222	            "source_note": None,
   223	            # 镜像真 build_manifest: derived-from 单链 → relation 退路分支
   224	            # (Codex round-1 指出手搓 manifest 漏此字段与真形状不符;
   225	            #  round-2 L1 补 derived_reason/derived_at 两键)
   226	            "relation": {
   227	                "type": "derived_from",
   228	                "target_node_id": "SeedA",
   229	                "derived_reason": None,
   230	                "derived_at": None,
   231	            },
   232	            "tips": [],
   233	        },
   234	    ]
   235	    manifest = {
   236	        "board": {"board_id": BOARD, "board_name": BOARD},
   237	        "source_status": "ok",
   238	        "source": "live",
   239	        "nodes": nodes,
   240	        "freshness": {"generated_at": _ts(0), "lag_seconds": 1, "stale": False},
   241	    }
   242	    p = vault / "outputs" / f".recap-manifest-{BOARD}.json"
   243	    p.write_text(json.dumps(manifest, ensure_ascii=False), encoding="utf-8")
   244	    return p
   245	
   246	
   247	def vault_snapshot(vault: Path) -> dict[str, tuple[str, int]]:
   248	    out: dict[str, tuple[str, int]] = {}
   249	    for p in sorted(vault.rglob("*")):
   250	        if p.is_file():
   251	            st = p.stat()
   252	            out[str(p.relative_to(vault))] = (
   253	                hashlib.sha256(p.read_bytes()).hexdigest(),
   254	                st.st_mtime_ns,
   255	            )
   256	    return out
   257	
