  1456	def _cjk_to_int(s: str) -> int | None:
  1457	    """中文数字串 → int; 无法确定地解析则 None (不猜)。
  1458	
  1459	    ⛔ 对抗审查 BLOCKER: D2 的数字原为 `[0-9]+`, 于是「本板共有九十八万个子节点」
  1460	    这类**完全虚构**的规模自陈整域免检。scan 的计数都是 ASCII 整数, 报告换个写法
  1461	    不该换来免检 —— 归一后照常比对。解析不了的 (生僻/歧义写法) 返回 None,
  1462	    由调用方按"无法验证"处理, 不静默放行。
  1463	    """
  1464	    total, section, digit, seen = 0, 0, None, False
  1465	    for ch in s:
  1466	        if ch in _CJK_NUM:
  1467	            digit = _CJK_NUM[ch]
  1468	            seen = True
  1469	        elif ch in _CJK_UNIT:
  1470	            unit = _CJK_UNIT[ch]
  1471	            if unit >= 10000:
  1472	                section = (section + (digit or 0)) if (section or digit) else 1
  1473	                total += section * unit
  1474	                section, digit = 0, None
  1475	            else:
  1476	                section += (digit if digit is not None else 1) * unit
  1477	                digit = None
  1478	            seen = True
  1479	        else:
  1480	            return None
  1481	    if not seen:
  1482	        return None
  1483	    return total + section + (digit or 0)
