  3364	def test_domain_r5_prose_single_char_value_enters_pool():
  3365	    """R3 round-2 单元门：D2 侧单字数词同样必须**带自身值**进池比对。
  3366	
  3367	    ⚠️ 与 fallback 侧同因：标准 fixture 池 `[0..16,22]` 覆盖 `_CJK_NUM` 全部值
  3368	    （0-9），CLI 层构造不出「单字且值不在池」的用例，于是「值不在池」这条分支
  3369	    在 D2 侧**零门覆盖**（车道对抗审查实测：摘掉该分支 253 用例仍全绿）。
  3370	    合成 scan 把池收窄到 `[0,1,2]`，`九` 才能证明 9 确实进了池比对。
  3371	
  3372	    **它证明什么**：D2 段内单字 → 按自身值查池（九→找不到同值来源 / 二→放行）；
  3373	    多字与被切断的数串 → 走「无法解析」，且诊断里出现的是**剥噪声后的完整数串**。
  3374	    **它不证明什么**：不证明段切分、豁免跨度剥离与句式门——那是 CLI 门的事。
  3375	    """
  3376	    rs = _load_recap_scan()
  3377	    synth = {"data_mode": "fallback_local", "counts": {"members": 1, "seeds": 1}}
  3378	    assert rs._derived_number_pool(synth) == {0, 1, 2}, "合成池漂移，判别前提失效"
  3379	
  3380	    def probs(tok: str) -> list[str]:
  3381	        out: list[str] = []
  3382	        rs._verify_prose_counts(f"## 三维审查\n\n- 本板共有{tok}个子节点。【实测】\n", synth, out)
  3383	        return out
  3384	
  3385	    got = probs("九")
  3386	    assert any("九(9)" in p and "找不到同值来源" in p for p in got), f"单字未按自身值查池: {got}"
  3387	    assert probs("二") == [], "值在池的单字被误伤"
  3388	    for tok, joined in (("一零", "一零"), ("九十八万**五", "九十八万五")):
  3389	        got = probs(tok)
  3390	        assert any("无法解析" in p for p in got), f"{tok}: 未 fail-closed: {got}"
  3391	        assert any(joined in p for p in got), f"{tok}: 诊断未还原成完整数串: {got}"
  3392	        assert not any("找不到同值来源" in p for p in got), f"{tok}: 仍按局部值查池: {got}"

