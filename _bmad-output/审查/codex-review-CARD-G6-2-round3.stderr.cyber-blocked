   363	def _extract_script(html: str) -> str:
   364	    """从实际响应体取出**整个** <script> 原文 — 且必须与浏览器 tokenizer 同源。
   365	
   366	    HTML 解析对 script 结束符**大小写不敏感**、正文里出现注释开合也会改变
   367	    解析状态 (round-2 HIGH-3 实证: `// </SCRIPT>` 后的"好代码"能骗过大小写
   368	    敏感的正则, 但浏览器根本不会执行它)。所以除定位外, 还要拒绝一切会让
   369	    「正则提取的字节」与「浏览器执行的字节」分叉的序列。
   370	    """
   371	    # 开标签: 大小写不敏感地只允许一个, 且必须恰是字面 <script> (无属性)
   372	    openings = re.findall(r"<script\b[^>]*>", html, flags=re.I)
   373	    assert openings == ["<script>"], f"script 开标签形态变了: {openings!r}"
   374	    _prefix, sep, rest = html.partition("<script>")
   375	    assert sep, "script 开标签未命中"
   376	    # 结束符**总数**恰为 1 (大小写不敏感) — 正文任何位置多出结束符 (哪怕在
   377	    # JS 注释里), 浏览器都会在那里提前终止脚本; maxsplit 截断式提取会把它
   378	    # 当切割点吞掉, 那道门就是死的 (round-3 自查), 数段数才漏不掉
   379	    parts = re.split(r"</script\s*>", rest, flags=re.I)
   380	    assert len(parts) == 2, f"script 结束符出现 {len(parts) - 1} 次 (应恰 1) — 浏览器会在正文处提前终止"
   381	    src = parts[0]
   382	    # 正文分叉面: HTML 注释开合改变 tokenizer 状态 (script data escaped)
   383	    assert "<!--" not in src and "-->" not in src, "script 正文含 HTML 注释开合 — tokenizer 状态分叉面"
   384	    assert "__URLS_JSON__" not in src, "占位符没被替换 — 页面发出去的是模板本身"
   385	    return src
