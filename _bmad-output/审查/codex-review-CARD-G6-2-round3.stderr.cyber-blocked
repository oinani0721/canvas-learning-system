   261	            collected.update(a.name for a in node.names)
   262	        elif isinstance(node, ast.ImportFrom):
   263	            mod = node.module or ""
   264	            collected.update(f"{mod}.{a.name}" if mod else a.name for a in node.names)
   265	    banned = collected - ALLOWED_IMPORTS
   266	    assert not banned, f"出现白名单外的 import: {sorted(banned)} — 第二套管道的载体"
   267	    for node in ast.walk(tree):
