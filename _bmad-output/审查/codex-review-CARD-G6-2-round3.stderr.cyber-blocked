   392	        hits = original_text.count(old)
   393	        if hits != 1:
   394	            failures.append(f"{mid} 锚点在原文命中 {hits} 次 (须恰好 1) — 变异会静默空转")
   395	            print(f"[{idx:>2}/{len(MUTATIONS)}] {mid} ✗ 锚点命中 {hits} 次: {desc}")
