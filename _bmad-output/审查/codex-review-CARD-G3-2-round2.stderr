   204	# ── 门② 中断注入: 事件已落账、frontmatter 未推进 → A2 重放恢复 ──
   205	
   206	
   207	def test_crash_window_ledger_without_frontmatter_recovers(vault):
   208	    r = _run_writer(vault, _payload())
   209	    assert r.returncode == 0, r.stdout + r.stderr
   210	    golden_fsrs = _fm_fields(vault)
   211	    # 模拟崩溃窗口①: 回滚 frontmatter 到评分前 (账本保留该事件)
   212	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   213	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:30:00Z"))
   214	    assert r2.returncode == 0, r2.stdout + r2.stderr
   215	    assert len(_ledger_lines(vault)) == 1, "恢复路径不得二次 append"
   216	    got = _fm_fields(vault)
   217	    for key in golden_fsrs:
   218	        assert got.get(key) == golden_fsrs[key], (
   219	            f"恢复后 {key} 与直接应用不一致: {got.get(key)!r} != {golden_fsrs[key]!r}"
   220	        )
   221	    assert "A2 重放已应用" in r2.stdout or "restore" in r2.stdout
