   315	# ── 门⑧ envelope 冲突 (同 id 不同 event_type) → 拒绝; 同 envelope → no-op ──
   316	
   317	
   318	def test_envelope_conflict_rejected_and_same_envelope_noop(vault):
   319	    # ①同 id 同 envelope: 完整成功后再跑, 绝不二次 apply (W 不动即证明)
   320	    r = _run_writer(vault, _payload())
   321	    assert r.returncode == 0, r.stdout + r.stderr
   322	    sha = _sha(vault / NODE_REL)
   323	    r2 = _run_writer(vault, _payload(ts="2026-09-01T08:00:00Z"))
   324	    assert r2.returncode == 0
   325	    assert _sha(vault / NODE_REL) == sha, "同 id 同 envelope 重放不得二次 apply"
   326	    # ②同 id 不同事实 (abandoned 翻转 event_type) → fail-closed 拒写
   327	    (vault / NODE_REL).write_text(NODE_V0, encoding="utf-8")  # 回到崩溃窗口①前置态
   328	    r3 = _run_writer(vault, _payload(abandoned=True))
   329	    assert r3.returncode != 0, "同 id 不同 event_type 必须 envelope 冲突拒绝"
   330	    assert "envelope 冲突" in r3.stderr, r3.stderr
   331	    assert len(_ledger_lines(vault)) == 1, "冲突拒绝不得追加"
   332	    assert not _fm_fields(vault), "冲突拒绝不得推进 frontmatter"
   333	    # ③Codex round-1 BLOCKER: 五字段局部比对抓不到的篡改 — durable 行被
   334	    # 改动 payload 事实键 (exam_board) / 顶层 event_version 后, 恢复必须拒。
   335	    base_event = _ledger_lines(vault)[0]
   336	    for tweak, desc in (
   337	        ({"payload.exam_board": "检验白板/被篡改.md"}, "payload 事实键 exam_board"),
   338	        ({"event_version": 2}, "顶层 event_version"),
   339	    ):
   340	        tampered = json.loads(json.dumps(base_event))
   341	        key, val = next(iter(tweak.items()))
   342	        if "." in key:
   343	            tampered["payload"][key.split(".")[1]] = val
   344	        else:
   345	            tampered[key] = val
   346	        ledger = vault / "learning_events.jsonl"
   347	        ledger.write_text(json.dumps(tampered, ensure_ascii=False) + "\n", encoding="utf-8")
   348	        rt = _run_writer(vault, _payload())
   349	        assert rt.returncode != 0, f"篡改 {desc} 后恢复必须拒绝"
   350	        assert "envelope 冲突" in rt.stderr, rt.stderr
   351	    # 恢复正常 durable 行后 (原样回写), 同一续跑必须成功 (restore)
   352	    (vault / "learning_events.jsonl").write_text(json.dumps(base_event, ensure_ascii=False) + "\n", encoding="utf-8")
   353	    r4 = _run_writer(vault, _payload())
   354	    assert r4.returncode == 0, r4.stdout + r4.stderr
   355	    assert "restore" in r4.stdout
