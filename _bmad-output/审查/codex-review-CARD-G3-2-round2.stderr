   601	    }
   602	    line_text = json.dumps(other, ensure_ascii=False)
   603	    assert trap_needle in line_text, "陷阱行必须真的命中旧子串谓词 (否则本门为假门)"
   604	    (vault / "learning_events.jsonl").write_text(line_text + "\n", encoding="utf-8")
   605	    r = _run_writer(vault, _payload(event_id=TRAP_EID))
   606	    assert r.returncode == 0, r.stdout + r.stderr
   607	    recs = _ledger_lines(vault)
