   103	    ⚠️ Codex round-1 MEDIUM 如实声明: bridge 是 symlink, 其 `_venv_python()`
   104	    对 `__file__` 调 resolve() 会穿回 WT — re-exec 实际命中 **WT 的 venv**
   105	    (与 fixture 同一解释器, 结果等价), tmp 的目录级 backend/.venv symlink
   106	    **不参与** re-exec 选路 (保留它是为了 bridge 若改为 copy 布局仍可达,
   107	    及文件级 symlink 会丢 pyvenv.cfg 的实测教训)。本 fixture 证明的是
   108	    「bridge re-exec 链可达且 fsrs 真实参与」, 不是「tmp candidate 被选中」。
   109	    """
   110	    repo = tmp_path
   111	    v = repo / "canvas-vault"
   112	    (v / "节点").mkdir(parents=True)
   113	    (v / ".claude" / "scripts").mkdir(parents=True)
   114	    (repo / "backend" / "scripts").mkdir(parents=True)
   115	    (repo / "backend" / ".venv").symlink_to(WT / "backend" / ".venv", target_is_directory=True)
   116	    (repo / "backend" / "scripts" / "validate_learning_events.py").symlink_to(VALIDATOR)
   117	    (v / ".claude" / "scripts" / "fsrs_bridge.py").symlink_to(VAULT_SCRIPTS / "fsrs_bridge.py")
   118	    (v / ".claude" / "scripts" / "decay_beta.py").symlink_to(VAULT_SCRIPTS / "decay_beta.py")
   119	    # 故意连字符+中文: 校验器绑定的是 sanitize 后的 canvas_vault_测试;
   120	    # 写侧漏 sanitize (写原始形式) 会在 validator 绑定比对处翻红
   121	    (v / ".canvas-config.yaml").write_text(
   122	        '# 测试 config\nvault_id: "canvas-vault-测试"\nsubject: cs-61b\n', encoding="utf-8"
   123	    )
   124	    (v / NODE_REL).write_text(NODE_V0, encoding="utf-8")
   125	    return v
   126	
   127	
   128	def _writer_code(vault: Path, payload: dict) -> str:
   129	    pfile = vault.parent / "payload.json"
   130	    pfile.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   131	    return CODE.replace('"/tmp/quiz-answer-payload.json"', json.dumps(str(pfile)))
   132	
   133	
   134	def _run_writer(vault: Path, payload: dict, env_extra: dict | None = None):
   135	    """生产形态执行: 子进程 + cwd=vault (NODE 相对路径与生产一致)。"""
   136	    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", **(env_extra or {}))
   137	    return subprocess.run(
   138	        [sys.executable, "-c", _writer_code(vault, payload)],
   139	        capture_output=True,
   140	        text=True,
   141	        timeout=180,
   142	        cwd=str(vault),
   143	        env=env,
   144	    )
   145	
   146	
   147	def _ledger_lines(vault: Path) -> list[dict]:
   148	    ledger = vault / "learning_events.jsonl"
   149	    if not ledger.exists():
   150	        return []
   151	    return [json.loads(ln) for ln in ledger.read_text(encoding="utf-8").splitlines() if ln.strip()]
   152	
   153	
   154	def _fm(vault: Path) -> str:
   155	    import yaml
   156	
   157	    text = (vault / NODE_REL).read_text(encoding="utf-8")
   158	    return text.split("---\n")[1]
   159	
   160	
   161	def _fm_fields(vault: Path) -> dict:
   162	    """按 bridge 同款正则抽 fsrs_* 行 (值+冒号后文本)。"""
   163	    fm = _fm(vault)
   164	    out = {}
   165	    for key in ("fsrs_due", "fsrs_state", "fsrs_step", "fsrs_stability", "fsrs_difficulty", "fsrs_last_review"):
   166	        m = re.search(rf"^{key}:\s*\"?([^\"\n]+?)\"?\s*$", fm, re.M)
   167	        if m:
   168	            out[key] = m.group(1)
   169	    return out
   170	
   171	
   172	def _run_validator(vault: Path):
   173	    return subprocess.run(
   174	        [sys.executable, str(VALIDATOR), str(vault / "learning_events.jsonl")],
   175	        capture_output=True,
   176	        text=True,
   177	        timeout=60,
   178	    )
   179	
   180	
   181	def _sha(p: Path) -> str:
   182	    import hashlib
   183	
   184	    return hashlib.sha256(p.read_bytes()).hexdigest()
   185	
