   490	           "payload": {"schema_ext": "review/1",
   491	                       "vault_id": _vid,
   492	                       "concept_id": node_id,
   493	                       "rating": rating,
   494	                       "grade_norm": GN2,
   495	                       "review_time": review_time,
   496	                       "fsrs_library_version": lib_ver,
   497	                       "fsrs_params_hash": p_hash,
   498	                       "exam_board": p.get("exam_board", ""),
   499	                       "attempt_count": n_att}}
   500	    # 防御性二次查重 (单写者下不可达 — _rows 快照在 dup 判定时已排除; 保留作
   501	    # 纵深防御, 与 A4.5 "查重紧贴写入" 同型)
   502	    _again = next((o for _, o in _rows if isinstance(o, dict) and o.get("event_id") == evid), None)
   503	    if _again is not None:
   504	        print(f"[quiz-answer] {evid} 已在账本 (防御性二次查重命中), 跳过 append")
   505	    else:
   506	        _created = not os.path.exists(EV)
   507	        if not _created and os.path.getsize(EV) > 0:
   508	            with open(EV, "rb") as _f:
   509	                _f.seek(-1, os.SEEK_END)
   510	                if _f.read(1) != b"\n":
   511	                    with open(EV, "a", encoding="utf-8") as _f2:
   512	                        _f2.write("\n")  # LF 守卫: 截断尾行自愈隔离
   513	        _line = (json.dumps(rec, ensure_ascii=False) + "\n").encode("utf-8")
   514	        _fd = os.open(EV, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
   515	        try:
   516	            _n = os.write(_fd, _line)
   517	            if _n != len(_line):
   518	                raise SystemExit(f"[quiz-answer] 账本短写 ({_n}/{len(_line)} 字节), fail-closed 中止 — frontmatter 未动, 可安全重跑")
   519	            os.fsync(_fd)
   520	        finally:
   521	            os.close(_fd)
   522	        if _created:
   523	            _dfd = os.open(VAULT, os.O_RDONLY)
   524	            try:
   525	                os.fsync(_dfd)
   526	            finally:
   527	                os.close(_dfd)
   528	        print(f"[quiz-answer] 事件已落日志(write-ahead): {etype} @ {review_time}")
   529	
   530	# calibration_log 结构化事件（开头的事件级幂等已保证本事件未记录过）
   531	q = lambda v: json.dumps(v, ensure_ascii=False)
   532	scn = p.get("self_confidence_norm")
   533	entry = (f'  - event_id: {q(eid)}\n'
   534	         f'    ts: {q(p["ts"])}\n'
   535	         f'    exam_board: {q(p.get("exam_board",""))}\n'
   536	         f'    question_id: {q(p.get("question_id","q1"))}\n'
   537	         f'    self_confidence_raw: {q(p.get("self_confidence_raw") or "null")}\n'
   538	         f'    self_confidence_norm: {scn if scn is not None else "null"}\n'
   539	         f'    grade_norm: {GN2}\n'
   540	         f'    abandoned: {"true" if p.get("abandoned") else "false"}')
   541	# F3 修复 (2026-07-12): 定位 calibration_log 块末尾插入 — 旧逻辑无条件追加
   542	# 到 frontmatter 末尾, 当 calibration_log 非最后一个 key 时 (Obsidian
   543	# Properties 面板默认在末尾新增属性, 极常见), 事件条目会被 YAML 静默
   544	# 归档进相邻列表键 (如 aliases), 校准数据丢失且零报错。
   545	mcal = re.search(r'^calibration_log:', fm, re.M)
   546	if mcal:
   547	    lines = fm.split("\n")
   548	    li = next(i for i, ln in enumerate(lines) if re.match(r'^calibration_log:', ln))
   549	    j = li + 1
   550	    while j < len(lines) and lines[j].startswith("  "):
   551	        j += 1
   552	    lines[j:j] = entry.split("\n")
   553	    fm = "\n".join(lines)
   554	else:
   555	    fm = fm.rstrip() + "\ncalibration_log:\n" + entry
   556	
   557	# 疑问归纳 callout（前置空行防并块；内容幂等：续跑不重复 append）
   558	cal = (p.get("callout") or "").strip()
   559	if cal and cal not in body:
   560	    body = body.rstrip() + "\n\n" + cal + "\n"
   561	
   562	# ── G3-2 A4.4 原子发布: temp → flush → fsync → os.replace → fsync 父目录。
   563	# 六字段与 fsrs_last_review 在同一次替换中落盘 (半态会被三态判别判残缺 →
   564	# fail-closed, 是正确降级方向, 但不应由每次崩溃制造)。
   565	tmp = NODE + ".quiz-tmp"
   566	_f = open(tmp, "w", encoding="utf-8")
   567	_f.write(f"---\n{fm}\n---\n{body}")
   568	_f.flush()
   569	os.fsync(_f.fileno())
   570	_f.close()
   571	os.replace(tmp, NODE)
   572	_dfd = os.open(os.path.dirname(NODE) or ".", os.O_RDONLY)
   573	try:
   574	    os.fsync(_dfd)
   575	finally:
   576	    os.close(_dfd)
   577	os.remove(P)
   578	print(f"[quiz-answer] {NODE}: mastery {old}->{new}; event={eid}; fsrs={'applied @ ' + review_time if fsrs_ok else 'degraded (事件已入账, W 未推进)'}; ledger={_mode}; callout={'yes' if cal else 'no'}")
   579	PYEOF
   580	```
