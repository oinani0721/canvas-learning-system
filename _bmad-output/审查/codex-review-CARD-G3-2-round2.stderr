   187	# ── 门① 同 event_id 重放两次 → frontmatter 不二次推进、账本一行 ──
   188	
   189	
   190	def test_same_event_id_replay_no_double_advance(vault):
   191	    r = _run_writer(vault, _payload())
   192	    assert r.returncode == 0, r.stdout + r.stderr
   193	    w1 = _fm_fields(vault)["fsrs_last_review"]
   194	    ledger = vault / "learning_events.jsonl"
   195	    n1 = len(_ledger_lines(vault))
   196	    # 二跑: recorded_at 变化不构成事实差异 (envelope 显式排除), 必须 no-op
   197	    r2 = _run_writer(vault, _payload(ts="2026-09-01T09:00:00Z"))
   198	    assert r2.returncode == 0, r2.stdout + r2.stderr
   199	    assert _fm_fields(vault)["fsrs_last_review"] == w1, "同 event_id 重放不得二次推进 W"
   200	    assert len(_ledger_lines(vault)) == n1 == 1, "账本必须恰 1 行"
   201	    assert "幂等跳过" in r2.stdout
   202	
