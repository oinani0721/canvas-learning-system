    69	def _aware(s: str) -> datetime:
    70	    """受理语法内时刻 → tz-aware datetime, 统一 astimezone(UTC)。
    71	
    72	    naive (无时区) 一律 ValueError 拒绝 —— G3-2 契约 A6: 无时区的时刻无法
    73	    与水位线 W 做绝对瞬间比较, 静默当 UTC 等于伪造事实。原实现
    74	    `dt.replace(tzinfo=utc)` 只补 tzinfo 不转换, 合法的 '12:00:00+08:00'
    75	    会原样传给 fsrs 库并被其 UTC 硬校验抛 ValueError (§九登记缺陷①②)。
    76	    """
    77	    dt = datetime.fromisoformat(str(s).strip().replace("Z", "+00:00"))
    78	    if dt.tzinfo is None:
    79	        raise ValueError(f"naive 时刻拒收 (无法与水位线比较, 请带时区重传): {s!r}")
    80	    return dt.astimezone(timezone.utc)
    81	
    82	
    83	def _whole_second(dt: datetime) -> datetime:
    84	    """截掉小数秒 (向零取整, 即丢弃小数部分) —— A5 整秒口径。
    85	
    86	    W 与事件 review_time 都只有秒级精度; 原实现只在 _iso() 输出时截,
    87	    写出的 W 与调用方手里的 ts 差一个小数秒, A5 "同一瞬间" 不成立。
    88	    """
    89	    return dt.replace(microsecond=0)
    90	
    91	
    92	def _iso(dt: datetime) -> str:
    93	    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    94	
    95	
    96	def rating_from_grade(grade_norm: float, abandoned: bool) -> int:
    97	    """[Decision-FSRS-1] 弃答→Again; 否则还原 grade=1+3·gn 就近落四档。"""
    98	    if abandoned:
    99	        return 1
   100	    g = 1.0 + 3.0 * max(0.0, min(1.0, float(grade_norm)))
   101	    if g < 1.5:
   102	        return 1
   103	    if g < 2.5:
   104	        return 2
   105	    if g < 3.5:
   106	        return 3
   107	    return 4
   108	
   109	
   110	_ONE_MINUTE = timedelta(minutes=1)
   111	
   112	
   113	def _steps_to_minutes(steps) -> list[int]:
   114	    """timedelta 序列 → 整分钟列表。非整分钟步长直接抛错, 不静默截断。
   115	
   116	    用 timedelta 整除/取余 (内部纯整数微秒), 不走 total_seconds() 浮点 ——
   117	    json.dumps 把 1.0 写成 "1.0"、1 写成 "1", hash 会分叉。
   118	    """
   119	    minutes: list[int] = []
   120	    for td in steps:
   121	        if td % _ONE_MINUTE != timedelta(0):
   122	            raise ValueError(f"学习步长 {td!r} 非整分钟, 无法用 *_steps_minutes 表达")
   123	        minutes.append(td // _ONE_MINUTE)
   124	    return minutes
   125	
   126	
   127	def scheduler_identity(sched) -> tuple[str, str]:
   128	    """从活体 fsrs Scheduler 反推 (library_version, params_hash)。
   129	
   130	    params_hash 口径与 backend/scripts/generate_fsrs_golden_vectors.py::
   131	    params_hash() 逐字一致 (sha256 of canonical JSON, 六键形状), 零硬编码 ——
   132	    golden manifest 真值相等是被**复算证明**的, 不是被声明的。库/参数升级时
   133	    此处如实返回新身份, 与 manifest 的相等性检查由校验器负责。
   134	    """
   135	    from importlib.metadata import version as _pkg_version
   136	
   137	    config = {
   138	        "parameters": [float(p) for p in sched.parameters],
   139	        "desired_retention": float(sched.desired_retention),
   140	        "learning_steps_minutes": _steps_to_minutes(sched.learning_steps),
   141	        "relearning_steps_minutes": _steps_to_minutes(sched.relearning_steps),
   142	        "maximum_interval": int(sched.maximum_interval),
   143	        "enable_fuzzing": bool(sched.enable_fuzzing),
   144	    }
   145	    canonical = json.dumps(config, sort_keys=True, separators=(",", ":"))
   146	    return _pkg_version("fsrs"), hashlib.sha256(canonical.encode("utf-8")).hexdigest()
   147	
   148	
   149	def fields_from_frontmatter(fm: str) -> dict:
   150	    """从 frontmatter 文本抽 fsrs_* 字段 (纯 stdlib, 读侧同款正则)。"""
   151	    out = {}
   152	    for key in FIELD_ORDER:
   153	        m = re.search(rf'^{key}:\s*"?([^"\n]+?)"?\s*$', fm, re.M)
   154	        if m:
   155	            out[key] = m.group(1).strip()
   156	    return out
   157	
   158	
   159	def _legacy_param(v):
   160	    """legacy state:0 伴生参数哨兵归一: 空/null/~/0/0.0/不可解析 → None。"""
   161	    if v in (None, ""):
   162	        return None
   163	    s = str(v).strip().lower()
   164	    if s in ("null", "none", "~"):
   165	        return None
   166	    try:
   167	        return None if float(s) == 0.0 else v
   168	    except ValueError:
   169	        return None
   170	
   171	
   172	#: A7 review 域上界 (schema v1 §6.2): review_time 与 W 同域同界且均须严格小于。
   173	#: 调度会在其上叠加 interval, A3 还要 +1s —— 逼近上界时新事件不可写, fail-closed。
   174	_REVIEW_MAX = datetime(9000, 1, 1, tzinfo=timezone.utc)
   175	
   176	
   177	def review(fields: dict, grade_norm: float, abandoned: bool, ts: str, rating: int | None = None) -> dict:
   178	    """一次评分 → 新 fsrs_* 字段 (需要 fsrs 可导入)。
   179	
   180	    G3-2 时刻语义 (schema v1 §6.2 A3/A5/A6):
   181	      - ts 归一 UTC 整秒后作为本次 review 时刻 (写出的 fsrs_last_review 与
   182	        返回的 review_time 逐字相同);
   183	      - 若当前 frontmatter 有 W (fsrs_last_review) 且本次时刻 ≤ W, 推进到
   184	        W+1s 再写 (A3 等时唯一口径: 推进不拒绝);
   185	      - rating 可显式指定 (A2 pending 重放按事件已断言的 rating 复算),
   186	        缺省按 grade_norm+abandoned 推导; abandoned 恒为 1 (弃答一票否决)。
   187	    """
   188	    from fsrs import Card, Rating, Scheduler, State
   189	
   190	    now = _whole_second(_aware(ts))
   191	    if now >= _REVIEW_MAX:
   192	        raise ValueError(f"review 时刻 {ts!r} 越出 A7 review 域上界 (须严格小于 {_iso(_REVIEW_MAX)})")
   193	    if abandoned:
   194	        used_rating = 1
   195	    elif rating is not None:
   196	        # 严格 int (Codex round-1 MEDIUM): int(1.5)==1 会把非法 pending 行
   197	        # 静默应用; §6.1 冻结 rating 为真 int 1-4, bool 伪装同样拒绝。
   198	        if isinstance(rating, bool) or not isinstance(rating, int) or rating not in (1, 2, 3, 4):
   199	            raise ValueError(f"显式 rating 必须为 int 1-4, 实为 {rating!r}")
   200	        used_rating = rating
   201	    else:
   202	        used_rating = rating_from_grade(grade_norm, abandoned)
   203	
   204	    sched = Scheduler(enable_fuzzing=False)
   205	    if fields.get("fsrs_due"):
   206	        step = fields.get("fsrs_step")
   207	        stability = fields.get("fsrs_stability")
   208	        difficulty = fields.get("fsrs_difficulty")
   209	        raw_state = int(fields.get("fsrs_state", 1))
   210	        if raw_state == 0:
   211	            # legacy New 形状字段级迁移 (CARD-C3, roundtrip 显式例外):
   212	            # state 0→Learning(1) — py-fsrs 4+ 无 New 态, State(0) 抛
   213	            # ValueError; 伴生哨兵 0/0.0/null → None (0.0 会进 v6 稳定度
   214	            # 幂运算抛 ZeroDivisionError); step 兜底 0 (Learning 首步)。
   215	            raw_state = 1
   216	            stability = _legacy_param(stability)
   217	            difficulty = _legacy_param(difficulty)
   218	            step = _legacy_param(step) or 0
   219	        card = Card(
   220	            state=State(raw_state),
   221	            step=int(step) if step not in (None, "") else None,
   222	            stability=float(stability) if stability else None,
   223	            difficulty=float(difficulty) if difficulty else None,
   224	            due=_aware(fields["fsrs_due"]),
   225	            last_review=_aware(fields["fsrs_last_review"]) if fields.get("fsrs_last_review") else None,
   226	        )
   227	        # A3 等时消解: 时刻 ≤ W → 推进 W+1s (写侧唯一口径, 禁止拒绝丢评分)。
   228	        # W 与 review_time 同域同界, W+1s 越出 A7 上界 ⇒ 后继不可写, fail-closed。
   229	        if fields.get("fsrs_last_review"):
   230	            w = _whole_second(_aware(fields["fsrs_last_review"]))
   231	            if now <= w:
   232	                bumped = w + timedelta(seconds=1)
   233	                if bumped >= _REVIEW_MAX:
   234	                    raise ValueError(f"A3 推进 W+1s 越出 A7 上界 (W={_iso(w)}) — 后继事件不可写")
   235	                now = bumped
   236	    else:
   237	        card = Card(due=now)  # 无字段 = New 卡即刻到期 (零迁移)
   238	
   239	    card, _log = sched.review_card(
   240	        card, Rating(used_rating), review_datetime=now
   241	    )
   242	    lib_ver, p_hash = scheduler_identity(sched)
   243	    out = {
   244	        "fsrs_due": _iso(card.due),
   245	        "fsrs_state": int(card.state),
   246	        "fsrs_step": card.step if card.step is not None else "",
   247	        "fsrs_stability": round(card.stability, 4) if card.stability is not None else "",
   248	        "fsrs_difficulty": round(card.difficulty, 4) if card.difficulty is not None else "",
   249	        "fsrs_last_review": _iso(now),
   250	        # G3-2 加性输出: 调用方必须把 review_time 原样写进事件 payload
   251	        # (与 effective_at 同一瞬间), 不要自己另算一份。
   252	        "review_time": _iso(now),
   253	        "rating": used_rating,
   254	        "fsrs_library_version": lib_ver,
   255	        "fsrs_params_hash": p_hash,
   256	    }
   257	    out["fm_block"] = "\n".join(
   258	        f"{k}: {out[k]}" for k in FIELD_ORDER if out[k] != ""
   259	    )
   260	    return out
   261	
   262	
   263	def _ensure_fsrs() -> bool:
   264	    try:
   265	        import fsrs  # noqa: F401
   266	        return True
   267	    except ImportError:
   268	        venv_py = _venv_python()
   269	        if os.environ.get("FSRS_BRIDGE_REEXEC") != "1" and venv_py:
   270	            os.environ["FSRS_BRIDGE_REEXEC"] = "1"
   271	            os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
   272	        return False
   273	
   274	
   275	def main() -> int:
   276	    if not _ensure_fsrs():
   277	        print(json.dumps({"error": "fsrs_unavailable — backend/.venv 缺失或未装 fsrs"}))
   278	        return 3
   279	    p = json.load(sys.stdin)
   280	    try:
   281	        out = review(
   282	            fields_from_frontmatter(p.get("fm", "")),
   283	            float(p.get("grade_norm", 0.0)),
   284	            bool(p.get("abandoned")),
   285	            p["ts"],
   286	            rating=p.get("rating"),
   287	        )
   288	    except ValueError as e:
   289	        # G3-2: naive/越界/非法 rating 等输入缺陷 —— 拒绝并 stdout 明说,
   290	        # 不静默降级。exit 2 = 输入错误 (区别于 3 = fsrs 不可用)。
   291	        print(json.dumps({"error": f"invalid_input — {e}"}, ensure_ascii=False))
   292	        return 2
   293	    print(json.dumps(out, ensure_ascii=False))
   294	    return 0
   295	
   296	
   297	if __name__ == "__main__":
   298	    sys.exit(main())

