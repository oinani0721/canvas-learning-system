   413	# ── 门⑫ 裁决② degraded: 事件仍落账 + 哨兵成对 + W 不推进 ──
   414	
   415	
   416	def test_fsrs_unavailable_degraded_sentinels_pair_and_w_frozen(vault):
   417	    """FSRS_BRIDGE_REEXEC=1 阻断 re-exec; bridge 子进程用系统 python3
   418	    (无 fsrs, 本机实证) → 诚实 exit 3 → 裁决②路径。"""
   419	    r = _run_writer(vault, _payload(), env_extra={"FSRS_BRIDGE_REEXEC": "1"})
   420	    assert r.returncode == 0, r.stdout + r.stderr
   421	    assert "degraded" in r.stdout
   422	    rec = _ledger_lines(vault)[0]
   423	    pl = rec["payload"]
   424	    assert pl["fsrs_library_version"].startswith("degraded:"), "库版本必须填哨兵"
   425	    assert pl["fsrs_params_hash"].startswith("degraded:"), "参数 hash 必须填哨兵"
   426	    assert pl["fsrs_library_version"] == pl["fsrs_params_hash"], "两键哨兵必须成对 (同因)"
   427	    assert pl["fsrs_library_version"][len("degraded:") :].strip(), "哨兵原因必须非空"
   428	    assert not _fm_fields(vault), "degraded 不得写任何 fsrs_* 字段 (W 不推进)"
   429	    assert "mastery_score" in _fm(vault), "衰减 Beta 照常写"
   430	    assert _run_validator(vault).returncode == 0, "哨兵成对产物必须过校验器"
   431	    # degraded 事件 review_time > W(无 W = -inf) → 留 pending; fsrs 恢复后
   432	    # 下次评分的 A2 会自动补应用 (write-ahead 的价值, 产品可见)
