   231	    r = _run_writer(vault, _payload(ts="2026-08-01T10:00:00"))
   232	    assert r.returncode != 0, "naive ts 必须拒绝"
   233	    assert _sha(vault / NODE_REL) == sha_node, "fail-closed 必须零写节点"
   234	    assert not (vault / "learning_events.jsonl").exists(), "fail-closed 必须零写账本"
