   435	# ── 门⑬ 耐久序列 + 写序 (A4.3/A4.4): spy 调用序列 ──
   436	# ⚠️ 本门证明耐久序列**被调用** (fsync 覆盖账本/temp/父目录, append fsync 先于
   437	# os.replace), 不证明掉电后数据存活 — 后者需真实断电, 不在本卡。
   438	
   439	
   440	def test_durable_sequence_and_write_ahead_order(vault, monkeypatch):
   441	    events: list[tuple] = []
   442	    real_fsync, real_replace, real_open = os.fsync, os.replace, os.open
   443	
   444	    def spy_fsync(fd):
   445	        try:
   446	            st = os.fstat(fd)
   447	            kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
   448	            events.append(("fsync", kind, st.st_ino))
   449	        except OSError:
   450	            events.append(("fsync", "unknown", -1))
   451	        return real_fsync(fd)
   452	
   453	    def spy_replace(src, dst):
   454	        events.append(("replace", str(src), str(dst)))
   455	        return real_replace(src, dst)
   456	
   457	    monkeypatch.setattr(os, "fsync", spy_fsync)
   458	    monkeypatch.setattr(os, "replace", spy_replace)
   459	    monkeypatch.chdir(vault)
   460	    saved_path = list(sys.path)
   461	    saved_modules = {
   462	        k: sys.modules.pop(k) for k in ("fsrs_bridge", "decay_beta", "validate_learning_events") if k in sys.modules
   463	    }
   464	    try:
   465	        exec(compile(_writer_code(vault, _payload()), "quiz-answer-SKILL-extract", "exec"), {})
   466	    except SystemExit as e:
   467	        assert e.code in (0, None), f"静态块异常退出: {e.code}"
   468	    finally:
   469	        sys.path[:] = saved_path
   470	        sys.modules.pop("fsrs_bridge", None)
   471	        sys.modules.pop("decay_beta", None)
   472	        sys.modules.pop("validate_learning_events", None)
   473	        sys.modules.update(saved_modules)
   474	
   475	    ledger, node = vault / "learning_events.jsonl", vault / NODE_REL
   476	    ledger_ino, node_ino = ledger.stat().st_ino, node.stat().st_ino
   477	    fsyncs = [e for e in events if e[0] == "fsync"]
   478	    replaces = [e for e in events if e[0] == "replace"]
   479	    assert len(replaces) == 1, f"恰一次原子发布, 实得 {len(replaces)}"
   480	    replace_idx = events.index(replaces[0])
   481	    # 账本 fsync (file) 与 temp fsync (temp inode == 发布后节点 inode)
   482	    fsynced_files = {e[2] for e in fsyncs if e[1] == "file"}
   483	    assert ledger_ino in fsynced_files, "账本 fd 必须 fsync (A4.3)"
   484	    assert node_ino in fsynced_files, "temp fd 必须 fsync (A4.4; replace 保留 inode)"
   485	    dir_count = sum(1 for e in fsyncs if e[1] == "dir")
   486	    assert dir_count >= 2, f"首建账本父目录 + 节点父目录均须 fsync, 实得 dir fsync {dir_count} 次"
   487	    # Codex round-1 验证限制: dir fsync 必须绑定两个**不同**目录 inode
   488	    # (VAULT 根 = 账本父目录, 节点/ = 节点父目录), 不是同一目录刷两次
   489	    dir_inodes = {e[2] for e in fsyncs if e[1] == "dir"}
   490	    assert len(dir_inodes) >= 2, f"两个不同父目录都要 fsync, 实得 {len(dir_inodes)} 个 inode"
   491	    assert vault.stat().st_ino in dir_inodes, "账本父目录 (VAULT 根) 必须 fsync"
   492	    assert (vault / "节点").stat().st_ino in dir_inodes, "节点父目录必须 fsync"
   493	    # 写序: 账本 durable 必须先于 os.replace (真 write-ahead, 非改名)
   494	    ledger_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == ledger_ino)
   495	    temp_fsync_idx = max(i for i, e in enumerate(events) if e[0] == "fsync" and e[1] == "file" and e[2] == node_ino)
   496	    assert ledger_fsync_idx < replace_idx, "账本 fsync 必须先于 frontmatter 发布 (A1 write-ahead)"
   497	    assert temp_fsync_idx < replace_idx, "temp fsync 必须先于 os.replace (A4.4)"
   498	
