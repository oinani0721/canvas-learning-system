   227	def test_fail_before_append_keeps_ledger_and_node_consistent(vault):
   228	    """bridge exit 2 (naive ts) 在 append 之前 fail-closed — 系统保持评分前
   229	    一致态, 重跑即可 (scored_pending_node_update 续跑语义)。"""
