    96	        """Load a specific scenario file."""
    97	        path = self._dir / filename
    98	        if not path.exists():
    99	            raise FileNotFoundError(f"Scenario file not found: {path}")
   100	        data = json.loads(path.read_text(encoding="utf-8"))
   101	        data["_source_file"] = filename
