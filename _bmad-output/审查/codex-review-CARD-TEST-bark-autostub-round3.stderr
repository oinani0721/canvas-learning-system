   148	class RegressionMetricsCollector:
   149	    """Collects per-scenario metrics during a regression test run."""
   150	
   151	    def __init__(self):
   152	        self.results: List[Dict[str, Any]] = list()
   153	
   154	    def record(
   155	        self,
   156	        scenario_id: str,
   157	        prompt_name: str,
   158	        prompt_version: int,
   159	        metrics: Dict[str, Any],
   160	        passed: bool,
   161	        details: str = "",
   162	    ):
   163	        self.results.append(
   164	            {
   165	                "scenario_id": scenario_id,
   166	                "prompt_name": prompt_name,
   167	                "prompt_version": prompt_version,
   168	                "metrics": metrics,
   169	                "passed": passed,
   170	                "details": details,
   171	            }
   172	        )
   173	
   174	    def summary(self) -> Dict[str, Any]:
   175	        total = len(self.results)
   176	        passed_count = sum(1 for r in self.results if r["passed"])
   177	        failed_count = total - passed_count
   178	        pass_rate = (passed_count / total * 100) if total > 0 else 0.0
   179	        return {
   180	            "total_scenarios": total,
   181	            "passed": passed_count,
   182	            "failed": failed_count,
   183	            "pass_rate": pass_rate,
   184	            "results": self.results,
   185	        }
   186	
   187	
   188	@pytest.fixture
   189	def regression_metrics() -> RegressionMetricsCollector:
   190	    """Per-test metrics collector for regression report generation."""
   191	    return RegressionMetricsCollector()
