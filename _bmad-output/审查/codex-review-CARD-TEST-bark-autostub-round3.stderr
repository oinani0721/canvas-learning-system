   138	            last_err = f"http={http} code={code}"
   139	        except urllib.error.HTTPError as e:
   140	            last_err = f"http={e.code}"
   141	        except (urllib.error.URLError, TimeoutError, OSError) as e:
   142	            last_err = f"net={type(e).__name__}"
   143	    print(f"bark failed {last_err}")  # 永不打印 key/URL
   144	    return 1
