    75	class BaselineLoader:
    76	    """Load baseline scenario JSON files for a specific prompt type."""
    77	
    78	    def __init__(self, prompt_name: str, baselines_dir: Path):
    79	        self._dir = baselines_dir / prompt_name
    80	        self._prompt_name = prompt_name
    81	
    82	    def load_all(self) -> List[Dict[str, Any]]:
    83	        """Load all scenario JSON files, sorted by filename."""
    84	        if not self._dir.exists():
    85	            raise FileNotFoundError(f"Baseline directory not found: {self._dir}")
    86	        scenarios = list()
    87	        for f in sorted(self._dir.glob("scenario_*.json")):
    88	            data = json.loads(f.read_text(encoding="utf-8"))
    89	            data["_source_file"] = f.name
    90	            scenarios.append(data)
    91	        if not scenarios:
    92	            raise FileNotFoundError(f"No scenario_*.json files found in {self._dir}")
    93	        return scenarios
    94	
