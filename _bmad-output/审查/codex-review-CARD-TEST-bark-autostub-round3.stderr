   194	# ── CARD-TEST-bark-autostub: Bark 外发自动打桩守卫 ──────────────────────
   195	# 生产链 daily_review_run.main() → send_bark.send() → _urlopen(POST
   196	# {server}/push) 会真推真机 (--now 10:00+08:00 恒在推送窗内); send 失败还会
   197	# osascript 真弹 macOS 通知。此前全靠每条测试各自记得替换 send — 新增一条
   198	# main() 测试忘替换 = 真推。本 fixture 把「忘了打桩」的默认后果从「真推」
   199	# 翻转为「响亮失败」。
   200	
   201	#: 守卫布防面 (按模块名末段判定):
   202	#:   - test_daily_review* 前缀 — 语义化前缀: 叫这个名字的文件几乎必然是
   203	#:     每日复习测试 (含未来的 test_daily_review_push.py 等), 全部布防;
   204	#:     前缀挂在**功能名**上, 不会像 endswith 那样误伤 foo_test_daily_review_run;
   205	#:   - bark_egress_probe 精确名 — 本卡的负门探针。
   206	#: 其它命名的新文件 (如 test_review_push.py) 不布防: 要布防就把它加进
   207	#: _BARK_GUARDED_EXTRA 或改名进 test_daily_review* 系列 — 这是如实边界
   208	#: (验收单裁决点 5), 不是疏漏。布防 = 该测试期间 import scripts 模块并打
   209	#: 三层桩, 不布防的文件零 import / sys.path 副作用 (卡文 (b) 模块门铁律)。
   210	_BARK_GUARDED_PREFIX = "test_daily_review"
   211	_BARK_GUARDED_MODULES = ("bark_egress_probe",)
   212	
   213	
   214	def _is_guarded_module(module_name: str) -> bool:
   215	    last = module_name.rsplit(".", 1)[-1]
   216	    return last.startswith(_BARK_GUARDED_PREFIX) or last in _BARK_GUARDED_MODULES
   217	
   218	
   219	@pytest.fixture(autouse=True)
   220	def _bark_egress_guard(request):
   221	    """daily_review_run 测试的四层外发防线 (function 级 autouse)。
   222	
   223	    ① send_bark.KEY_FILE → tmp 假 key (格式合法且真实存在, server 指向
   224	       loopback discard 端口 http://127.0.0.1:9/): 让 load_key 成功, 忘打桩
   225	       的测试必然走到 ② 拒绝器 — 不存在的 key 会让 send 静默 rc=2
   226	       (send 返回 2 / runner.main 归并为 0), 那恰是假绿通道 (Codex
   227	       round-1 HIGH)。server 用 loopback 是纵深防御 (round-2 HIGH): 即便
   228	       某条 reload 逃逸路径让 _urlopen 回到生产 urlopen, 最坏后果也只是
   229	       向 127.0.0.1:9 发一个必被拒的请求 — 不出外网、不触真 key、不弹
   230	       通知。env BARK_KEY_FILE 同步重定向: reload(send_bark) 重跑模块
   231	       顶层重新解析时仍落 tmp。
   232	    ② send_bark._urlopen → 抛 AssertionError("Bark egress attempted in
   233	       tests") 的拒绝器 — send_bark 的 except 只吞 HTTPError/URLError/
   234	       TimeoutError/OSError (send_bark.py:138/:140), AssertionError 必然
   235	       穿透 send 与 runner.main 炸红测试。
   236	    ③ daily_review_run.osascript_fallback → 记录并返回 True (不弹真通知)。
   237	    ④ 全局 urllib.request.urlopen → 同一拒绝器 (round-2 HIGH): 即便
   238	       `from importlib import reload` 的预绑定形态绕过 reload 拦截、把
   239	       send_bark._urlopen 还原成「当时的全局 urlopen」, 那个全局也已换成
   240	       拒绝器 — 预绑定逃逸的最坏结果从「真出网」变成「响亮失败」。
   241	
   242	    独立 MonkeyPatch 实例 (round-1 HIGH): 测试自己的 monkeypatch.undo()
   243	    只拆测试自己的桩, 波及不到本守卫。
   244	    reload 双保险 (round-2 HIGH 收紧): importlib.reload 的属性式调用被拦,
   245	    对 send_bark / daily_review_run 的 reload 完成后自动重打四层;
   246	    wrapper 带 active 旗标 — teardown 后被外部留存的旧 wrapper 只做
   247	    真 reload、绝不再用已 undo 的 patcher 重挂桩 (防 stale 闭包跨测试
   248	    污染)。`from importlib import reload` 的预绑定形态绕过重打, 但被
   249	    第④层兜住 (见上), 后果是响亮失败而非外发。
   250	
   251	    测试内显式 monkeypatch.setattr 可覆盖任意一层 (守卫 setup 在先, 测试
   252	    的 patch 后设先生效) — _capture_bark_request 即覆盖 ①②。
   253	    imports 在模块门之后惰性执行; scripts 目录只对布防模块进 sys.path。
   254	    非布防模块: 本 fixture 只实例化 request, 不碰 fixture 图其余部分。
   255	    """
   256	    if not _is_guarded_module(request.module.__name__):
   257	        yield None
   258	        return
   259	
   260	    scripts_dir = _BACKEND_DIR.parent / "scripts"
   261	    patcher = pytest.MonkeyPatch()
   262	    tmp_dir = Path(tempfile.mkdtemp(prefix="bark-guard-"))
   263	    osascript_calls: List[Dict[str, Any]] = []
   264	    reload_band_active = {"on": True}
   265	    try:
   266	        key_file = tmp_dir / "bark.key"
   267	        # 整段 URL 形态 (load_key 兼容): server 钉死 loopback discard 端口,
   268	        # reload 逃逸场景下 send 的最坏后果 = 本机必被拒的一次连接
   269	        key_file.write_text("http://127.0.0.1:9/bark-guard-fake-key-0001\n", encoding="utf-8")
   270	        patcher.setenv("BARK_KEY_FILE", str(key_file))
   271	        patcher.syspath_prepend(str(scripts_dir))
   272	        import daily_review_run
   273	        import send_bark
   274	
   275	        def _refuse_egress(*args, **kwargs):
   276	            raise AssertionError("Bark egress attempted in tests")
   277	
   278	        def _stub_osascript(noti):
   279	            osascript_calls.append(dict(noti))
   280	            return True
   281	
   282	        def _reapply():
   283	            patcher.setattr(send_bark, "KEY_FILE", key_file)
   284	            patcher.setattr(send_bark, "_urlopen", _refuse_egress)
   285	            patcher.setattr(daily_review_run, "osascript_fallback", _stub_osascript)
   286	            patcher.setattr(urllib.request, "urlopen", _refuse_egress)
   287	
   288	        _real_reload = importlib.reload
   289	
   290	        #: reload 双保险盯的是「守卫打过桩的生产模块」— reload 它们会重跑
   291	        #: 模块顶层把生产值写回 (KEY_FILE/_urlopen/osascript_fallback),
   292	        #: 完成后重打; 不是盯测试模块名 (round-2 自测抓出: 拿
   293	        #: 测试模块名单判被 reload 的生产模块名, 条件恒假)。
   294	        #: reload_band_active: 守卫 teardown 后被外部留存的 wrapper 引用
   295	        #: 只做真 reload — 已 undo 的 patcher 重挂桩会把已删的旧 key 路径
   296	        #: 钉回模块 (round-2 HIGH: stale 闭包跨测试污染)。
   297	        _PATCHED_MODULES = ("send_bark", "daily_review_run")
   298	
   299	        def _guarded_reload(module):
   300	            result = _real_reload(module)
   301	            if module.__name__ not in _PATCHED_MODULES:
   302	                return result
   303	            if not reload_band_active["on"]:
   304	                # fail-closed (round-2 HIGH): 布防 teardown 后调用留存的旧
   305	                # wrapper reload 受保护模块, 会得到生产态模块 (真实
   306	                # ~/.config/canvas-review/bark.key 在位 + 真 urlopen) 并
   307	                # 泄漏给同进程后续测试 = 跨测试外发面。此时 patcher 已
   308	                # undo、无处重挂桩, 唯一安全动作是拒绝 reload。
   309	                raise RuntimeError(
   310	                    f"reload({module.__name__}) 仅可在 _bark_egress_guard "
   311	                    "布防的测试内调用 (teardown 后受保护模块处于生产态, "
   312	                    "reload 会把真实 key + 真 urlopen 装回模块)"
   313	                )
   314	            _reapply()
   315	            return result
   316	
   317	        patcher.setattr(importlib, "reload", _guarded_reload)
   318	        _reapply()
   319	        yield osascript_calls
   320	    finally:
   321	        reload_band_active["on"] = False
   322	        patcher.undo()
   323	        shutil.rmtree(tmp_dir, ignore_errors=True)

