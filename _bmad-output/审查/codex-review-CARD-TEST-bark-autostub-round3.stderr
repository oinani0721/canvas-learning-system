     1	#!/usr/bin/env python3
     2	"""CARD-TEST-bark-autostub 负控裁判 (A/B/C'/C/D/D'/E/E' 八跑, 串行子进程)。
     3	
     4	A  (disarmed): --noconftest 卸下守卫 → test_probe 期望 PASS —— 证明「去掉
     5	   fixture 就会真的尝试外发」(探针自装的 getaddrinfo/create_connection
     6	   双拦截器挡住, 任何情况下不出网);
     7	B  (armed):    正常 conftest → test_probe 期望 FAIL, 且失败必须是指定的
     8	   那道断言 (pytest 输出里整行 `E   AssertionError: Bark egress attempted
     9	   in tests`) —— 拒绝器层在被它验证的逻辑;
    10	C  (armed):    test_keyfile_guarded 期望 PASS —— 守卫层① KEY_FILE 重定向
    11	   的放行门;
    12	C' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— 层①篡改门:
    13	   证明 C 真的依赖守卫, 不是恒真;
    14	D  (armed):    test_osascript_guarded 期望 PASS —— 守卫层③ osascript 打桩
    15	   的放行门;
    16	D' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— 层③篡改门;
    17	E  (armed):    test_reload_selfheal 期望 PASS —— reload 双保险放行门;
    18	E' (disarmed): --noconftest 同 nodeid 期望 FAIL(指定消息) —— reload 篡改门。
    19	
    20	判据口径 (round-3 收紧): 每跑核「退出码 + 摘要唯一性 + 指定断言正则 +
    21	异常来源绑定」——
    22	- 摘要: 全 stdout 中形态为 `= N passed/failed(, N warnings) in Xs =` 的
    23	  摘要行必须**恰好 1 条**且形态精确 (atexit/插件追加的伪摘要 → 2 条 → 拒
    24	  收; `N error` 摘要与 `= ERRORS =` 段一律拒收) (round-2 MEDIUM);
    25	- 指定断言: `^E\\s+...\\s*$` 整行锚定 (round-2: C'/D'/E' 补上行尾锚),
    26	  字符串碰巧出现在 traceback 源码行里不算数;
    27	- 来源绑定 (round-2 MEDIUM): `E ` 行所在 traceback 块 (其前 1500 字符窗
    28	  口) 必须含 src_hint — B 的拒绝异常须真的来自 conftest.py, 探针三条须来
    29	  自探针文件自身; 测试打印同文本却在别处失败无法同时满足。
    30	TimeoutExpired 捕获记 FAIL, 不炸取证面。
    31	
    32	exit 0 仅当八跑全部按期望。串行、子进程、-p no:cacheprovider 防并行
    33	session 共享 .pytest_cache 踩踏。
    34	"""
    35	
    36	import re
    37	import subprocess
    38	import sys
    39	from pathlib import Path
    40	
    41	BACKEND = Path(__file__).resolve().parents[1]
    42	PROBE = "tests/regression/bark_egress_probe.py"
    43	#: (label, nodeid, extra_args, expect, pattern, src_hint)
    44	CASES = [
    45	    ("A/disarmed-probe-egress-attempted", f"{PROBE}::test_probe", ["--noconftest"], "pass", None, None),
    46	    ("B/armed-probe-refused", f"{PROBE}::test_probe", [], "fail",
    47	     r"^E\s+AssertionError: Bark egress attempted in tests\s*$", "conftest.py"),
    48	    ("C/armed-keyfile-guarded", f"{PROBE}::test_keyfile_guarded", [], "pass", None, None),
    49	    ("C'/disarmed-keyfile-tamper", f"{PROBE}::test_keyfile_guarded", ["--noconftest"], "fail",
    50	     r"^E\s+AssertionError: 守卫未布防: send_bark\.KEY_FILE 仍指向真实 key 位置\s*$",
    51	     "bark_egress_probe.py"),
    52	    ("D/armed-osascript-guarded", f"{PROBE}::test_osascript_guarded", [], "pass", None, None),
    53	    ("D'/disarmed-osascript-tamper", f"{PROBE}::test_osascript_guarded", ["--noconftest"], "fail",
    54	     r"^E\s+AssertionError: 守卫未布防: osascript_fallback 仍是 runner 原始实现\s*$",
    55	     "bark_egress_probe.py"),
    56	    ("E/armed-reload-selfheal", f"{PROBE}::test_reload_selfheal", [], "pass", None, None),
    57	    ("E'/disarmed-reload-tamper", f"{PROBE}::test_reload_selfheal", ["--noconftest"], "fail",
    58	     r"^E\s+AssertionError: 守卫未布防或 reload 自愈失效: reload 后 KEY_FILE 回到真实 key 位置\s*$",
    59	     "bark_egress_probe.py"),
    60	]
    61	
    62	_SUMMARY = r"=+\s+(.*?)\s+in\s+[\d.]+s(?:\s.*)?\s*=+\s*$"
    63	
    64	
    65	def _summaries(stdout: str) -> list[str]:
    66	    """全 stdout 中所有 pytest 摘要行正文 (正常恰 1 条; 伪摘要 → 多条)。"""
    67	    return [
    68	        m.group(1)
    69	        for line in stdout.splitlines()
    70	        if (m := re.match(_SUMMARY, line.strip()))
    71	    ]
    72	
    73	
    74	def _judged(label, nodeid, extra, expect, pattern, src_hint) -> bool:
    75	    cmd = [sys.executable, "-m", "pytest", "-p", "no:cacheprovider", *extra, nodeid]
    76	    print(f"[{label}] $ {' '.join(cmd)}", flush=True)
    77	    try:
    78	        proc = subprocess.run(cmd, cwd=BACKEND, capture_output=True, text=True, timeout=600)
    79	        rc, out = proc.returncode, proc.stdout
    80	        sys.stdout.write(out)
    81	        sys.stderr.write(proc.stderr)
    82	    except subprocess.TimeoutExpired as e:
    83	        sys.stdout.write(e.stdout or "" if isinstance(e.stdout, str) else "")
    84	        sys.stderr.write(str(e))
    85	        print(f"[{label}] TIMEOUT after 600s")
    86	        return False
    87	
    88	    summaries = _summaries(out)
    89	    shape_re = r"1 passed(, \d+ warnings?)?" if expect == "pass" else r"1 failed(, \d+ warnings?)?"
    90	    # 摘要唯一性 + 精确形态 + 无 error 摘要/ERRORS 段 (round-2 MEDIUM)
    91	    shape_ok = (
    92	        len(summaries) == 1
    93	        and re.fullmatch(shape_re, summaries[0]) is not None
    94	        and " no tests ran" not in out
    95	        and "= ERRORS =" not in out
    96	    )
    97	    regex_ok = True
    98	    src_ok = True
    99	    if pattern is not None:
   100	        m = re.search(pattern, out, re.MULTILINE)
   101	        if m is None:
   102	            regex_ok = False
   103	        elif src_hint is not None:
   104	            # 来源绑定: E 行之前的 traceback 窗口必须含来源文件 (round-2 MEDIUM)
   105	            window = out[max(0, m.start() - 1500):m.start()]
   106	            src_ok = src_hint in window
   107	    rc_ok = rc == (0 if expect == "pass" else 1)
   108	    ok = rc_ok and shape_ok and regex_ok and src_ok
   109	    print(
   110	        f"[{label}] expect {expect.upper()} -> ok={ok} rc={rc} "
   111	        f"n_summaries={len(summaries)} summary='{summaries[0] if summaries else ''}' "
   112	        f"regex={regex_ok} src={src_ok if pattern is not None else 'n/a'}"
   113	    )
   114	    return ok
   115	
   116	
   117	def main() -> int:
   118	    results = [_judged(*case) for case in CASES]
   119	    for (label, _, _, expect, _, _), ok in zip(CASES, results):
   120	        print(f"{label}: expect {expect.upper()} -> {'ok' if ok else 'MISMATCH'}")
   121	    if all(results):
   122	        print(
   123	            "NEGATIVE-CONTROL: PASS "
   124	            "(armed=probe-FAILED-as-expected, disarmed=probe-PASSED-egress-attempted)"
   125	        )
   126	        return 0
   127	    print("NEGATIVE-CONTROL: FAIL")
   128	    return 1
   129	
   130	
   131	if __name__ == "__main__":
   132	    sys.exit(main())

