    51	def vault_key(vault_id: str) -> str:
    52	    """vault 目录名 → 文件名/通知 id 安全 key (CARD-C1a 命名空间规则唯一定义点)。
    53	
    54	    两域设计 (Codex-C1a B2/H1 处置):
    55	      原样域 — ASCII 短名 (canvas-vault) 原样返回; 但排除恰好长得像 hash 域
    56	               后缀 (-<16hex> 结尾) 的名字与超长名;
    57	      hash 域 — 其余 (中文库名 / 超长名 / 撞后缀形态) slug 化并追加 sha256
    58	               前 16 hex (64 bit — 8 hex 时 2^16 生日构造即可撞, 已实测)。
    59	    两域互不重叠 → 不同目录名撞 key 只剩 64bit hash 碰撞一条路。state 文件名
    60	    (daily_review_run.state_path) / push.sh 锁 / Bark 有效 id 共用本函数,
    61	    同一 vault 三处 key 恒等 (push.sh 经 python 调用本函数, 不再 basename)。
    62	    """
    63	    # 目录名按字面精确处理, 不裁剪空白 — str.strip() 会吞 Unicode 空白,
    64	    # 令 "foo" 与 "foo\xa0" 两个不同目录名撞 key (Codex-C1a round2 实测)
    65	    raw = str(vault_id or "").rstrip("/").rsplit("/", 1)[-1] or "vault"
    66	    safe = re.sub(r"[^0-9A-Za-z._-]", "-", raw).strip("-.")
    67	    if (safe == raw and not _HASH_TAIL.search(raw)
    68	            and len(raw.encode("utf-8")) <= _KEY_MAX_BYTES):
    69	        return safe
    70	    digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]
    71	    return f"{(safe or 'vault')[:_KEY_MAX_BYTES]}-{digest}"
    72	
