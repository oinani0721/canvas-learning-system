   261	def _read_text(path: Path) -> str | None:
   262	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。
   263	
   264	    ⛔ symlink 一律拒绝读 (Codex round-1 HIGH-1): 文件 symlink 会被 is_file() 接纳并
   265	    跟随到 vault 外 —— 外部内容里的 wikilink 能藏住真孤儿。指 vault 内的 symlink
   266	    同样拒读 (保守, 方向 = 报盲区不假绿)。祖先链/越界由 `_scan_block_reason` 在
   267	    调用方先行拦截并记盲区 —— 本函数只是最后一道。
   268	    """
   269	    if path.is_symlink():
   270	        return None
   271	    try:
   272	        return path.read_text(encoding="utf-8")
