   402	
   403	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   404	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   405	
   406	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   407	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   408	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   409	    文件级检查), 再补两层本检查需要的:
   410	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   411	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   412	    """
   413	    if not root.is_dir():
   414	        return [], {}
   415	    blind: dict[str, str] = {}
   416	    dirs, files, cvr_blind = cvr._walk_vault(root)
   417	    for rel, why in cvr_blind:
   418	        blind[rel] = f"枚举盲区: {why}"
   419	    for d in dirs:
   420	        if d.is_symlink():
   421	            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
   422	    mds = sorted(f for f in files if f.suffix.lower() == ".md")
   423	    return mds, blind
   424	
   425	
   426	def _iter_md(root: Path) -> list[Path]:
   427	    """`_walk_md` 的只取文件面 (盲区面请用 `_walk_md`)。"""
   428	    return _walk_md(root)[0]
   429	
   430	
   431	# ---------------------------------------------------------------------------
   432	# 检查 1 — orphan_nodes
   433	# ---------------------------------------------------------------------------
   434	def check_orphan_nodes(vault: Path) -> CheckResult:
   435	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   436	
   437	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   438	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   439	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   440	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   441	
   442	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   443	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   444	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   445	
   446	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   447	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   448	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   449	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   450	    """
   451	    node_root = vault / NODE_DIR
   452	    notes: list[str] = []
   453	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   454	
   455	    if not node_root.is_dir():
   456	        return CheckResult(
   457	            name="orphan_nodes",
   458	            status=FAIL,
   459	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   460	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   461	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   462	            details={"nodes_scanned": 0, "inbound_targets": 0},
   463	        )
   464	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   465	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   466	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   467	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   468	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   469	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   470	    inbound: dict[str, set[str]] = {}
   471	    nodes: list[Path] = []
   472	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   473	        srcs, src_blind = _walk_md(vault / src_dir)
   474	        for rel, why in src_blind.items():
   475	            blind[f"{src_dir}/{rel}"] = why
   476	        if src_dir == NODE_DIR:
   477	            nodes = srcs
   478	        for src in srcs:
   479	            blocked = _scan_block_reason(vault, src)
   480	            if blocked:
   481	                blind[src.relative_to(vault).as_posix()] = blocked
   482	                continue
   483	            text = _read_text(src)
   484	            if text is None:
   485	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   486	                continue
   487	            _fm, body = _split_frontmatter(text)
   488	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   489	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   490	            src_phys = os.path.realpath(src)
   491	            for target in _wikilink_targets(body):
   492	                inbound.setdefault(target, set()).add(src_phys)
   493	
   494	    findings: list[Finding] = []
   495	    for node in nodes:
   496	        own = node.relative_to(vault).as_posix()
   497	        blocked = _scan_block_reason(vault, node)
   498	        if blocked:
   499	            blind[own] = blocked
   500	            continue
   501	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   502	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   503	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   504	        #    realpath 归并, 不得绕过自身排除。
   505	        own_phys = os.path.realpath(node)
   506	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   507	        if sources:
   508	            continue
   509	        text = _read_text(node)
   510	        if text is None:
   511	            blind[own] = "unreadable"
   512	            continue
   513	        fm, _body = _split_frontmatter(text)
   514	        if _fm_scalar(fm, "source_board"):
   515	            continue
   516	        findings.append(
   517	            Finding(
   518	                own,
   519	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   520	                f"(自身出链不计), 且 frontmatter 无 source_board",
   521	            )
   522	        )
   523	
   524	    if blind:
   525	        notes.append(
   526	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   527	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   528	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   529	        )
   530	    notes.append(
   531	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   532	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   533	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   534	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   535	    )
   536	    status = WARN if (findings or blind) else OK
   537	    return CheckResult(
   538	        name="orphan_nodes",
   539	        status=status,
   540	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   541	        findings=findings,
   542	        notes=notes,
   543	        details={
   544	            "nodes_scanned": len(nodes),
   545	            "inbound_targets": len(inbound),
   546	            "blind_spots": len(blind),
   547	            "blind_detail": dict(sorted(blind.items())),
   548	        },
   549	    )
   550	
   551	
   552	# ---------------------------------------------------------------------------
   553	# 检查 2 — raw_derived_confusion
   554	# ---------------------------------------------------------------------------
   555	def check_raw_derived(vault: Path) -> CheckResult:
   556	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   557	
   558	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   559	
   560	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   561	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   562	      G2 未登记根级文件    同上, 根级面
   563	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   564	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   565	                          正是"raw-derived 混淆"的机械定义
   566	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   567	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   568	
   569	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   570	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   571	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   572	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   573	                 **本次未验证**, 报告逐次声明
   574	
   575	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   576	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。
   577	    """
   578	    try:
   579	        data = cvr.load_rules()
   580	    except cvr.ConfigError as exc:
   581	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   582	    try:
   583	        res = cvr.scan(data, vault, with_probe=False)
   584	    except cvr.ConfigError as exc:
   585	        raise LintConfigError(str(exc)) from exc
   586	
   587	    findings = [
   588	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   589	        for fd in res.findings
   590	        if fd.code in CONFUSION_CODES and fd.blocking
   591	    ]
   592	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   593	
   594	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   595	    recap_bad = 0
   596	    recap_blind: dict[str, str] = {}
   597	    for md in _iter_md(vault):
   598	        if not md.name.startswith(RECAP_PREFIX):
   599	            continue
   600	        # ⛔ 与 orphan 同一条边界守卫 (Codex round-2 HIGH-1 第三旁路):
   601	        #    指向 vault 外的 回顾-* symlink 会被 read_frontmatter_type 跟随读取 ——
   602	        #    先拦截记盲区, 不读不判 (越界细节由 G8-1 的 G10/G11 判红)。
   603	        blocked = _scan_block_reason(vault, md)
   604	        if blocked:
   605	            recap_blind[md.relative_to(vault).as_posix()] = blocked
   606	            continue
   607	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   608	        ftype = cvr.read_frontmatter_type(md, parser=None)
   609	        if ftype != "recap":
   610	            recap_bad += 1
   611	            findings.append(
   612	                Finding(
   613	                    md.relative_to(vault).as_posix(),
   614	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   615	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   616	                )
   617	            )
   618	    notes: list[str] = [
   619	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   620	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   621	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   622	    ]
   623	    if recap_blind:
   624	        notes.append(
   625	            "recap 扫描盲区 (未读未判): " + ", ".join(f"{rel}[{why}]" for rel, why in sorted(recap_blind.items())[:5])
   626	        )
   627	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   628	    if blind:
   629	        notes.append(
   630	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   631	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   632	        )
   633	    if exempted:
   634	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   635	    for msg in res.info:
   636	        notes.append(f"台账扫描 info: {msg}")
   637	
   638	    return CheckResult(
   639	        name="raw_derived_confusion",
   640	        # ⛔ 盲区 ≥ warn (Codex round-3 H1c): recap 扫描有拒读对象时, "0 混淆" 是
   641	        #    "没查全" 而非 "没问题" —— 与 orphan 的 blind≥warn 规则对齐。
   642	        status=WARN if (findings or recap_blind) else OK,
   643	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   644	        findings=findings,
   645	        notes=notes,
   646	        details={
   647	            "files_seen": res.files_seen,
   648	            "dirs_seen": res.dirs_seen,
   649	            "codes_counted": list(CONFUSION_CODES),
   650	            "recap_missing_type": recap_bad,
   651	            "recap_blind": dict(sorted(recap_blind.items())),
   652	            "blind_spots": len(blind),
   653	            "probe_skipped": res.probe_skipped,
   654	        },
   655	    )
   656	
   657	
   658	# ---------------------------------------------------------------------------
   659	# 检查 3 — projection_freshness
   660	# ---------------------------------------------------------------------------
   661	def _is_stale(generated_at: Any, today: date) -> bool:
   662	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   663	
   664	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   665	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   666	    都按 stale 降级, 绝不逃逸成异常。
   667	    """
   668	    stale = True
   669	    try:
   670	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   671	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   672	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   673	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   674	        stale = True
   675	    return stale
   676	
   677	
   678	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   679	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   680	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。
   681	
   682	    ⛔ corrupt 面**比 oracle 窄**, 如实声明: oracle 在 stale 判定之前还要过
   683	       `_summarize()` 的严格 v3 形状门禁 (schema_version==3 / 五个容器形状 /
   684	       boards·buckets 对账 / 非有限数拒收…), 任何不符即 corrupt。本函数**不复制**
   685	       那几百行 (复制必漂, 且 W6 独占该文件), 只覆盖四类:
   686	       读不出 / 不是 JSON object / 缺 generated_at 键 / generated_at 非字符串
   687	       (最后这类的同语义是实测钉的: int 20260831 → oracle=corrupt, 不是 stale)。
   688	       故同源锁只在**合法 v3 投影**上成立; 其余形状垃圾面两侧可能分歧
   689	       (oracle=corrupt, 本函数可能=stale/ok) —— 验收单「不比什么」表登记。
   690	       反向差异同理登记: 越界投影 (outputs 为 symlink/解析出 vault) 本函数判
   691	       corrupt, oracle 不查越界直接读 —— 本函数**比 oracle 严**, 方向 = 安全,
   692	       同源锁不对该面做等值断言。
   693	    """
   694	    proj = vault.joinpath(*_PROJECTION_REL)
   695	    # ⛔ 越界前置检查 (Codex round-3 H1d): `outputs -> vault 外目录` 时投影真实文件在
   696	    #    vault 外 —— 一个只读审计器不读 vault 外内容, 判 corrupt (fail) 而非照常消费。
   697	    if proj.is_symlink() or not cvr._resolves_inside_vault(vault, "/".join(_PROJECTION_REL)):
   698	        return "corrupt", "投影路径是 symlink 或解析后越出 vault, 拒读", None
   699	    raw = _read_text(proj)
   700	    if raw is None:
   701	        if not proj.exists():
   702	            return "no_projection", None, None
   703	        return "corrupt", "读取失败 (非 UTF-8 / 权限)", None
   704	    try:
   705	        payload = json.loads(raw)
   706	    except (ValueError, RecursionError) as e:
   707	        return "corrupt", f"{type(e).__name__}: {str(e)[:200]}", None
   708	    if not isinstance(payload, dict):
   709	        return "corrupt", "投影根节点不是 JSON object", None
   710	    if "generated_at" not in payload:
   711	        return "corrupt", "投影缺 generated_at 字段", None
   712	    gen = payload["generated_at"]
   713	    # oracle 的 `_summarize` (:678-680) 对非字符串 generated_at 抛 ValueError → corrupt
   714	    # (实测: int 20260831 → oracle=corrupt 而非 stale)。必须同语义, 否则同源锁在此分叉。
   715	    if not isinstance(gen, str):
   716	        return "corrupt", f"generated_at 应为字符串, 实为 {type(gen).__name__}", None
   717	    return ("stale" if _is_stale(gen, today) else "ok"), None, gen
   718	
   719	
   720	def check_projection_freshness(vault: Path, today: date) -> CheckResult:
   721	    """`outputs/今日复习.json` 的 generated_at 是否是上海本地的今日。
   722	
   723	    状态分级 (**待用户裁决**):
   724	      ok            → ok
   725	      stale         → warn  (只是今天还没跑推送, 不是坏)
   726	      no_projection → warn  (该 vault 从没跑过推送 —— 新 vault 的正常初态)
   727	      corrupt       → fail  (投影文件坏了, 下游 Web UI / 推送会拿不到数据 = 真故障)
   728	    """
   729	    status, error, gen = _projection_status(vault, today)
   730	    mapped = {"ok": OK, "stale": WARN, "no_projection": WARN, "corrupt": FAIL}[status]
   731	    detail = {
   732	        "ok": f"generated_at={gen!r} 是 {today} 的投影",
   733	        "stale": f"generated_at={gen!r} 不是 {today} ({_DISPLAY_TZ_NAME}) 的投影",
   734	        "no_projection": f"{'/'.join(_PROJECTION_REL)} 不存在 —— 该 vault 尚未跑过推送",
   735	        "corrupt": f"投影不可用: {error}",
   736	    }[status]
   737	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   738	    return CheckResult(
   739	        name="projection_freshness",
   740	        status=mapped,
   741	        summary=f"projection_status={status}",
   742	        findings=findings,
   743	        notes=[
   744	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   745	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   746	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   747	            "只判 读不出/非 object/缺 generated_at",
   748	        ],
   749	        details={"projection_status": status, "generated_at": gen, "error": error},
   750	    )
   751	
   752	
   753	# ---------------------------------------------------------------------------
   754	# runner
   755	# ---------------------------------------------------------------------------
   756	#: 检查注册表 —— name → (说明, 是否需要 today)
   757	CHECKS: dict[str, str] = {
   758	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   759	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
   760	    "projection_freshness": "outputs/今日复习.json 的 generated_at 是否过期",

