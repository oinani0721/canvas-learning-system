    29	p = "backend/scripts/vault_lint.py"
    30	src = open(p, encoding="utf-8").read()
    31	n = src.count(old)
    32	assert n == 1, f"替换锚必须恰命中 1 次, 实际 {n}: {old!r}"
    33	open(p, "w", encoding="utf-8").write(src.replace(old, new))
    34	PYEOF
    35	  if [ $? -ne 0 ]; then
    36	    echo "MUTANT $name: REPLACE-FAILED (锚不唯一/不命中) — 脚本缺陷, 不算通过"
    37	    cp "$SCRIPT.bak-g82" "$SCRIPT"; rm -f "$SCRIPT.bak-g82"
