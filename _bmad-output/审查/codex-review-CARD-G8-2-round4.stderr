   375	def _wikilink_targets(body: str) -> set[str]:
   376	    """正文里全部 wikilink 的 basename 集合 (已归一)。先经 `_strip_nonsemantic`。
   377	
   378	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   379	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   380	    (`resolve_node_id`) —— 三者本就同规则。
   381	
   382	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   383	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   384	       `__pycache__` —— 一个只读审计器绝不该改被审对象。
   385	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   386	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   387	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   388	
   389	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   390	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写,
   391	    Codex round-1 MEDIUM-1a)。**不**覆盖: 围栏/行内 code、HTML 注释 (含 AUTO 哨兵块)、
   392	    跨行 `[[..]]`、空 `[[]]` —— 全部判定为非入链。
   393	    """
   394	    out: set[str] = set()
   395	    for raw in _WIKILINK.findall(_strip_nonsemantic(body)):
   396	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   397	        inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   398	        if inner:
   399	            out.add(_norm_key(inner))
   400	    return out
