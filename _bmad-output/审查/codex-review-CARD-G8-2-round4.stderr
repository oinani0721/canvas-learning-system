   838	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   839	"""
   840	
   841	
   842	class _LintArgumentParser(argparse.ArgumentParser):
   843	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   844	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   845	
   846	    def error(self, message: str):  # type: ignore[override]
   847	        self.print_usage(sys.stderr)
   848	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   849	        raise SystemExit(EXIT_CONFIG)
   850	
   851	
   852	def main(argv: list[str] | None = None) -> int:
   853	    ap = _LintArgumentParser(
   854	        prog="vault_lint.py",
   855	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   856	        epilog=_EPILOG,
   857	        formatter_class=argparse.RawDescriptionHelpFormatter,
   858	    )
   859	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   860	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   861	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   862	    ap.add_argument(
   863	        "--only",
   864	        action="append",
   865	        choices=sorted(CHECKS),
   866	        default=None,
   867	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   868	    )
   869	    args = ap.parse_args(argv)
   870	
   871	    try:
   872	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   873	    except LintConfigError as exc:
   874	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   875	        return EXIT_CONFIG
   876	
   877	    if args.json:
   878	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   879	    else:
   880	        print(render_text(report, color=sys.stdout.isatty()))
   881	    return exit_code(report)
   882	
   883	
   884	if __name__ == "__main__":
   885	    sys.exit(main())

