   868	
   869	    tree = _ast.parse(Path(__file__).read_text(encoding="utf-8"))
   870	    names = [
   871	        n.name
   872	        for node in _ast.walk(tree)
   873	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef))
   874	        for n in [node]
   875	        if n.name.startswith("test_")
   876	    ]
   877	    dupes = sorted({n for n in names if names.count(n) > 1})
   878	    assert dupes == [], f"存在重名测试 (后定义静默覆盖前定义): {dupes}"
