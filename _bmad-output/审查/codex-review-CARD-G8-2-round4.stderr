   239	def _scan_block_reason(vault: Path, path: Path) -> str | None:
   240	    """扫描读取的统一边界守卫: 返回拦截原因; None = 可以读。
   241	
   242	    覆盖 (Codex round-2 HIGH-1 的三条旁路, 复用 G8-1 的 G11 判据 `cvr.
   243	    _resolves_inside_vault` —— realpath 展开整条 symlink 链):
   244	      - 文件自身是 symlink (无论指内指外, 保守拒读);
   245	      - **祖先链上有 symlink** (目录 symlink 指向 vault 外时, 其后代文件自身
   246	        is_symlink()==False, 只有整链 realpath 才能识破);
   247	      - 解析后越出 vault (含 `..` 穿越、dangling 指外)。
   248	    dangling 指内的文件 resolve 在内但读不了 → 由 `_read_text` 的 OSError 分支记盲区。
   249	    """
   250	    if path.is_symlink():
   251	        return "symlink"
   252	    try:
   253	        rel = path.relative_to(vault).as_posix()
   254	    except ValueError:
   255	        return "outside-vault"
   256	    if not cvr._resolves_inside_vault(vault, rel):
   257	        return "resolves-outside-vault"
   258	    return None
