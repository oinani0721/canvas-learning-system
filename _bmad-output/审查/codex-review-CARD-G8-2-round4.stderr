  1120	def _walk_vault(vault_root: Path) -> tuple[list[Path], list[Path], list[tuple[str, str]]]:
  1121	    """枚举 vault, 并把**枚举不下去的地方**如实带出来。
  1122	
  1123	    ⛔ 为什么不用 `rglob` (round-4 BLOCKER): 它会静默吞掉
  1124	      - 权限不可读的子树 (整棵消失, files_seen 直接少);
  1125	      - dangling / self 指向的 symlink (`is_dir()` 与 `is_file()` 都为 False,
  1126	        两轮过滤把它们一起滤没了);
  1127	      - 超长路径 (本机 macOS/py3.14 实测 relative_chars=1307 时枚举不到)。
  1128	    这些静默点都会让 "0 finding" 变成 "没看见"。本函数用 `os.walk(onerror=...)`
  1129	    收集错误, 并把"既非 dir 也非 file"的条目单列, 交由 G10 判红。
  1130	    """
  1131	    dirs: list[Path] = []
  1132	    files: list[Path] = []
  1133	    blind: list[tuple[str, str]] = []
  1134	    base = str(vault_root)
  1135	
  1136	    def _onerror(err: OSError) -> None:
  1137	        try:
  1138	            rel = os.path.relpath(getattr(err, "filename", base) or base, base)
  1139	        except ValueError:  # pragma: no cover - 跨卷等异常
  1140	            rel = str(getattr(err, "filename", "<unknown>"))
  1141	        blind.append((rel, f"枚举失败, 该子树整棵不在扫描面内: {err.__class__.__name__}: {err}"))
  1142	
  1143	    for dirpath, dirnames, filenames in os.walk(base, topdown=True, onerror=_onerror, followlinks=False):
  1144	        for name in list(dirnames) + list(filenames):
  1145	            full = Path(dirpath) / name
  1146	            try:
  1147	                rel = full.relative_to(vault_root).as_posix()
  1148	            except ValueError:  # pragma: no cover
  1149	                continue
  1150	            if rel.split("/")[0] == ".git":
  1151	                continue
  1152	            try:
  1153	                is_dir, is_file = full.is_dir(), full.is_file()
  1154	            except OSError as exc:
  1155	                blind.append((rel, f"无法判定类型 (stat 失败): {exc.__class__.__name__}: {exc}"))
  1156	                continue
  1157	            if is_dir:
  1158	                dirs.append(full)
  1159	            elif is_file:
  1160	                if not os.access(full, os.R_OK):
  1161	                    blind.append((rel, "文件不可读 (权限), 其 frontmatter 无法核对"))
  1162	                files.append(full)
  1163	            else:
  1164	                blind.append((rel, f"既非目录也非普通文件 (symlink={full.is_symlink()}) —— rglob 会静默漏掉这类条目"))
  1165	    return sorted(dirs), sorted(files), sorted(set(blind))
  1166	
  1167	
  1168	def _is_resolution_stable(vault_root: Path, rel: str) -> bool:
  1169	    """vault 内的 `rel` 是否"解析稳定" —— 路径上没有任何一段 symlink 改变了它的身份。
  1170	
  1171	    判据 = `realpath(vault/rel)` 等于 `realpath(vault)/rel`。
  1172	    **必须以 realpath(vault) 为基准**而不是拿 `realpath(p) == p` 硬比: macOS 上
  1173	    `/tmp` 本身就是指向 `/private/tmp` 的 symlink, 硬比会把临时 fixture 里的
  1174	    每个文件都误判成不稳定, 从而让已登记分歧类在测试里全部失效。
  1175	
  1176	    为什么要这个判据: 路径含 symlink 时, `should_index` 判的是 **lexical** 路径、
  1177	    `check_vault_path` 判的是 **resolved** 路径 —— 两者看的是**两个不同的对象**,
  1178	    已登记的分歧类 (都只为普通文件论证过) 不适用, 必须交回 G5/G6 如实报出。
  1179	    """
  1180	    try:
  1181	        base = os.path.realpath(str(vault_root))
  1182	        expected = os.path.normpath(os.path.join(base, rel))
  1183	        actual = os.path.realpath(os.path.join(str(vault_root), rel))
  1184	    except OSError:
  1185	        return False

