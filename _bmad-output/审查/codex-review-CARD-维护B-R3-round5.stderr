  3758	def test_domain_r7_range_endpoints_and_fallback_seps_cli(tmp_path):
  3759	    """R3 round-4 行为门：区间两端都终核；fallback 也有小数/千分位防线。
  3760	
  3761	    三条实测反例（修前全部 exit 0）：
  3762	      · `本板共有987654-0个子节点` —— 某端无出处时区间不挖空，而后面的循环只取
  3763	        **紧邻量词**的右端 `0`；任一非空池都由 `abs(a-a)` 生成 0 ⇒ 放行。
  3764	        既有门只测了反方向 `1-987654`（大数在右）。
  3765	      · fallback `#### 派生子女 0.0 个` / `零点零` / `1,005` —— 千分位归一与小数
  3766	        防线原先**只在 D2 路径**，fallback 直接对原行 findall 逐片入池。
  3767	      · `本板共有987654<b>.</b>0个子节点` —— 渲染成 `987654.0`，但小数式原要求
  3768	        数串与 `.` 直接相邻，两道防线全不命中；`987654，000个` 的全角逗号同理。
  3769	
  3770	    **它证明什么**：区间两端都进池比对且**只在规模自陈句式内**报（非自陈句
  3771	    `建议覆盖 2~3 个节点` 不受伤——第一版把报错放在句式门之前，当场误伤）；
  3772	    千分位与小数防线在 D2 与 fallback **两侧都在**，且认全角逗号与被标签包住的
  3773	    小数点。
  3774	    **它不证明什么**：分隔符集合（`,`/`，`）与小数分隔符集合（`.`/`．`/`点`）
  3775	    仍是**封闭表**；其它千分位写法（空格已由连接集覆盖，撇号 `'` 等未覆盖）
  3776	    未验证。见验收单 §五之三。
  3777	    """
  3778	    vault = standard_vault(tmp_path)
  3779	    scan = collect_json(vault)
  3780	    pool = _load_recap_scan()._derived_number_pool(scan)
  3781	    assert 0 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3782	    report = write_report(vault, scan)
  3783	    base_text = report.read_text(encoding="utf-8")
  3784	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3785	
  3786	    def verify(anchor: str, injected: str):
  3787	        text = base_text.replace(anchor, injected, 1)
  3788	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3789	        report.write_text(text, encoding="utf-8")
  3790	        return run_verify(report)
  3791	
  3792	    def d2(line: str):
  3793	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3794	
  3795	    def fb(tok: str):
  3796	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3797	
  3798	    # 区间：大数在左（本轮新反例）与在右（既有方向）都必须被点名
  3799	    for name, line in (
  3800	        ("大数在左", "- 本板共有987654-0个子节点。【实测】"),
  3801	        ("大数在右", "- 本板共有0-987654个子节点。【实测】"),
  3802	        ("到字式", "- 本板共有987654到0个子节点。【实测】"),
  3803	    ):
  3804	        r = d2(line)
  3805	        assert r.returncode != 0, f"区间 {name} 被放行:\n{r.stdout}"
  3806	        assert _one_problem_has(r.stdout, "区间端点", "987654"), (
  3807	            f"区间 {name}: 未点名无出处的那一端:\n{r.stdout}"
  3808	        )
  3809	    # fallback 侧小数与千分位
  3810	    for name, tok, needles in (
  3811	        ("小数 ASCII", "0.0", ("小数形态", "0.0")),
  3812	        ("小数 CJK", "零点零", ("小数形态", "零点零")),
  3813	        ("千分位", "1,005", ("无出处", "1005")),
  3814	    ):
  3815	        r = fb(tok)
  3816	        assert r.returncode != 0, f"fallback {name} 被放行:\n{r.stdout}"
  3817	        assert _one_problem_has(r.stdout, *needles), (
  3818	            f"fallback {name}: 诊断未绑定:\n{r.stdout}"
  3819	        )
  3820	    # D2 侧：标签包住小数点 / 全角逗号
  3821	    r = d2("- 本板共有987654<b>.</b>0个子节点。【实测】")
  3822	    assert r.returncode != 0 and _one_problem_has(r.stdout, "小数形态", "987654.0"), (
  3823	        f"标签包住小数点未被识别为小数:\n{r.stdout}"
  3824	    )
  3825	    r = d2("- 本板共有987654，000个子节点。【实测】")
  3826	    assert r.returncode != 0 and _one_problem_has(
