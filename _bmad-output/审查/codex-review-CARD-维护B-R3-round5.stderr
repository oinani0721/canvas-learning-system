  1967	def _verify_fallback_derive_numbers(text: str, scan: dict, problems: list[str]) -> None:
  1968	    """CARD-维护B-R2 round-3 (Codex HIGH-4/5b/6): fallback 允许式的**数字出处**绑定。
  1969	
  1970	    措辞白名单 ``_FALLBACK_DERIVE_ALLOW`` (在 _verify_report) 只管「这句话允许说」,
  1971	    这里管「说出来的数字必须有据」——白名单匹配与值绑定分属两处, 缺一即漏:
  1972	      · HIGH-4 (round-4 补: ③段限定移出 data_mode 条件——manifest 报告的附录
  1973	        伪信号实测同样放行): 「无来源结论」信号行只许出现在**③段** ——
  1974	        ③段外 (附录/自造段) 的同形行不受信号绑定保护;
  1975	      · HIGH-5b: ⑦『N 个派生角色成员缺来源锚点』的前置 N 必须全等
  1976	        ``signals.unsourced_conclusions.value`` (无据档不容许前置 N);
  1977	      · HIGH-6: 允许式 #2 (段落标题) 与 #5 (关系类型分布行) 行内出现的任何
  1978	        数字都必须在 scan 数值池 —— `#### 派生子女 987654 个的说明` /
  1979	        `- 关系类型分布：无 987654` 实测曾放行。
  1980	    """
  1981	    # HIGH-4 (round-4: 对 manifest 模式同样生效)
  1982	    s3 = "\n".join(
  1983	        re.findall(r"^### ③.*?(?=^#{2,3}(?:[^\S\n]|$)|\Z)", text, re.M | re.S)
  1984	    )
  1985	    rest = text.replace(s3, "", 1) if s3 else text
