  3315	def test_domain_r5_cjk_single_char_only_unit_contract():
  3316	    """R3 判据契约: 只认单字数词；多字 / 单字量词 / 集合外一律 None。
  3317	
  3318	    **它证明什么**: 判据函数本身的逐形态取值；提取字符类由 `_CJK_NUM ∪ _CJK_UNIT`
  3319	    **机械派生**（手抄两份字面量正是 D2 与 fallback 两侧此前分叉的成因）；
  3320	    多位解析器 `_cjk_to_int` 确已退役、不得复活。
  3321	    **它不证明什么**: 不证明调用方正确使用了它——那是下面三道门的事。
  3322	    """
  3323	    rs = _load_recap_scan()
  3324	
  3325	    assert not hasattr(rs, "_cjk_to_int"), (
  3326	        "多位中文数词解析器复活了——R3 冻结口径禁止重新引入（round-5 HIGH 的根因）"
  3327	    )
  3328	    # ⛔ 期望值必须有**独立来源**: 第一版写成 `for ch, want in rs._CJK_NUM.items()`
  3329	    # ——期望值与被测值取自同一张表，把 `零/〇` 的映射改成 7 全套件照样 253 全绿
  3330	    # （车道对抗审查实测）。自抄期望 = 自证恒真 = 假门。这里逐字写死。
  3331	    EXPECT = {
  3332	        "零": 0,
  3333	        "〇": 0,
  3334	        "一": 1,
  3335	        "二": 2,
  3336	        "两": 2,
  3337	        "三": 3,
  3338	        "四": 4,
  3339	        "五": 5,
  3340	        "六": 6,
  3341	        "七": 7,
  3342	        "八": 8,
  3343	        "九": 9,
  3344	    }
  3345	    UNITS = {"十": 10, "百": 100, "千": 1000, "万": 10000, "亿": 100000000}
  3346	    assert rs._CJK_NUM == EXPECT, f"单字数词表被改动: {rs._CJK_NUM}"
  3347	    assert rs._CJK_UNIT == UNITS, f"量词表被改动: {rs._CJK_UNIT}"
  3348	    for ch, want in EXPECT.items():
  3349	        assert rs._cjk_single_to_int(ch) == want, f"单字数词 {ch} 取值错"
  3350	    for ch in UNITS:  # 十百千万亿 不在 _CJK_NUM ⇒ 单字量词同样无法确定
  3351	        assert rs._cjk_single_to_int(ch) is None, f"单字量词 {ch} 必须 fail-closed"
  3352	    for s in ("一零", "五四", "九十八万", "零一", "十二", "两三", "", "甲", "五个"):
  3353	        assert rs._cjk_single_to_int(s) is None, f"{s!r} 必须判「无法确定」（不猜）"
  3354	
  3355	    # 提取面必须覆盖判据面: **抓得到才拒得掉**。提取面漏字 ⇒ 该字组成的串落到
  3356	    # 检查面之外 = 漏拦（不是 fail-closed）。
  3357	    assert set(rs._CJK_NUM_CHARS) == set(EXPECT) | set(UNITS)
  3358	    # ⛔ R3 round-3: 取数用的是**宽集合**（数词样字符），它只用于**定界**、不赋值。
  3359	    # 表外数词字（廿卅/大写金融数字）必须进得来——进不来 ⇒ `廿五个` 会从 `五`
  3360	    # 重锚按 5 查池而放行（Codex round-2 HIGH，车道实测 rc=0）。
  3361	    # ⛔ 精确相等而非子集包含（Codex round-3 属实指出：子集断言锁不住声明里的
  3362	    # `卌` 与各种异体，表少一个字就意味着那类写法会从尾片重锚）。
  3363	    assert set(rs._NUMERAL_LIKE_CHARS) == (
  3364	        set(rs._CJK_NUM_CHARS)
  3365	        | set("0123456789")
  3366	        | set("廿卅卌壹贰貳叁參参肆伍陆陸柒捌玖拾佰仟萬亿億两兩兆京垓秭穰")
  3367	    ), f"定界集漂移: {rs._NUMERAL_LIKE_CHARS}"
  3368	    # 宽集合只定界不赋值：表外字符进来只会让整串"无法确定"，不会被猜成某个数。
  3369	    for s in ("廿五", "壹佰", "九十八万5", "五四", "一零"):
  3370	        assert rs._count_token_value(s) is None, f"{s!r} 不得被赋值"
  3371	    for s, want in (("980005", 980005), ("016", 16), ("五", 5), ("0", 0)):
  3372	        assert rs._count_token_value(s) == want, f"{s!r} 取值错"
  3373	    m = rs._NUM_RUN_RE.match("九十八万")
  3374	    assert m and m.group(0) == "九十八万", "提取面抓不到连续多字串 = 漏拦"
  3375	    # ⛔ 且必须**跨排版噪声/不可见字符**整体抓 —— 断开就只剩尾片，判据再「绝对
  3376	    # 确定」也没用（拿到的 token 不是那句话里的数）。这一条是 R3 round-2 的
  3377	    # BLOCKER：`九十八万**五**个` 渲染出来就是「九十八万五个」，实测曾 exit 0。
  3378	    for name, s in (
  3379	        ("粗体", "九十八万**五"),
  3380	        ("空白", "九十八万 五"),
  3381	        ("nbsp", "九十八万&nbsp;五"),
  3382	        ("零宽", "九十八万\u200b五"),
  3383	        ("空标签", "九十八万<span></span>五"),
  3384	        ("HTML注释", "九十八万<!--x-->五"),
  3385	    ):
  3386	        m = rs._NUM_RUN_RE.match(s)
  3387	        assert m and m.group(0) == s, f"{name}切断: 提取面只抓到 {m and m.group(0)!r}"
  3388	        assert rs._join_free(m.group(0)) == "九十八万五", f"{name}: 剥噪声后不是原数"
  3389	        assert rs._cjk_single_to_int(rs._join_free(m.group(0))) is None
