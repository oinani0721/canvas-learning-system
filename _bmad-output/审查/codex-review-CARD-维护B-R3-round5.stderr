   328	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   329	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   330	
   331	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   332	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   333	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   334	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   335	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   336	    要求"确实收集到用例"且"确实有失败"才算变红。
   337	    """
   338	    r = subprocess.run(
   339	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   340	        cwd=ROOT / "backend",
   341	        capture_output=True,
   342	        text=True,
   343	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   344	        timeout=600,
   345	    )
   346	    out = r.stdout
   347	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   348	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   349	    return r.returncode, out[-400:], passed + failed, failed
   350	
   351	
   352	def main() -> int:
   353	    try:
   354	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   355	    except FileExistsError:
   356	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   357	        return 2
   358	    try:
   359	        original = TARGET.read_bytes()
   360	        backup_sha = hashlib.sha256(original).hexdigest()
   361	
   362	        rc0, out0, n0, f0 = run_suite("domain_")
   363	        if rc0 != 0 or f0 or n0 == 0:
   364	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   365	            return 2
   366	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   367	
   368	        failures = 0
   369	        for name, subs, keyword in MUTANTS:
   370	            text = original.decode("utf-8")
   371	            for old, new in subs:
   372	                if old not in text:
   373	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   374	                    failures += 1
   375	                    text = None
   376	                    break
   377	                text = text.replace(old, new, 1)
   378	            if text is None:
   379	                continue
   380	            TARGET.write_text(text, encoding="utf-8")
   381	            try:
   382	                rc, out, n, f = run_suite(keyword)
   383	            finally:
   384	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   385	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   386	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   387	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   388	            if n == 0:
   389	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   390	                failures += 1
   391	            elif f == 0:
   392	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   393	                failures += 1
   394	            else:
   395	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   396	
   397	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   398	        return 1 if failures else 0
   399	    finally:
   400	        LOCK.rmdir()
   401	
   402	
   403	if __name__ == "__main__":
   404	    sys.exit(main())

