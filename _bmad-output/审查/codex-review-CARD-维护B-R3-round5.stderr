  2074	def _verify_report(path: str) -> int:
  2075	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2076	
  2077	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2078	    """
  2079	    try:
  2080	        text_raw = Path(path).read_text(encoding="utf-8")
  2081	    except (OSError, UnicodeDecodeError) as e:
  2082	        print(f"✗ 报告不可读: {type(e).__name__}")
  2083	        return 1
  2084	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2085	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。

