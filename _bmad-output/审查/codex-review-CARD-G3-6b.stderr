   393	def assign_bucket(n: dict, now: datetime) -> tuple[str, str]:
   394	    """S1 级联判桶 + S3 模板生成 → (bucket, why_due)。
   395	
   396	    调用前提: n 已归板 (划分域)。级联顺序即 BUCKET_ORDER — 先匹配先归,
   397	    因此每个域内节点恰好落一桶 (互斥), 且 due_now 布尔二分被五桶穷尽
   398	    (完备)。why_due 恒非空。
   399	    """
   400	    today_sh = _today_sh(now)
   401	    idle = _idle_cn(n["idle_days"])
   402	    if n["due_now"]:
   403	        if not n["fsrs_due"] and not n["due_fail_open"]:
   404	            return BUCKET_NEW, f"新卡未排期，视同即刻到期 · {idle}"
   405	        if n["fsrs_state"] in LEARNING_STATES:
   406	            phase = "重学中" if n["fsrs_state"] == 3 else "学习中"
   407	            return BUCKET_LEARNING, f"{phase} · {_overdue_cn(n, today_sh)} · {idle}"
   408	        return BUCKET_DUE_NOW, f"到期待复习 · {_overdue_cn(n, today_sh)} · {idle}"
   409	    # 未到期两桶: fsrs_due 恒为规范非空串 (空串必定 due_now)
   410	    due_sh = _sh_local(n["fsrs_due"])
   411	    if due_sh is None:
   412	        # 不可表示 = 年份极值远期, 定义上不可能是"今天" → future 兜底
   413	        return BUCKET_FUTURE, "到期时刻超出可显示范围，按未来排期处理"
   414	    delta = (due_sh.date() - today_sh).days
   415	    if delta == 0:
   416	        return BUCKET_DUE_TODAY, f"今天 {due_sh:%H:%M} 到期（尚未到点）"
   417	    when = "明天" if delta == 1 else f"{delta} 天后"
   418	    return BUCKET_FUTURE, f"{when} {due_sh.month}月{due_sh.day}日 {due_sh:%H:%M} 到期"
