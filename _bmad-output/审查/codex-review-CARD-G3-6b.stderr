  1581	def _tie_fixture_vault(tmp_path) -> tuple[Path, Path]:
  1582	    """排序金样 fixture: 四块板 pick 全同 (同 mastery 无 fsrs_due), tie-break
  1583	    逐级可辨 —— 乙板有推荐记录 (blr 罚后), 其余三块按 板名 排。state 单独
  1584	    成文件供两个版本的 CLI 同参消费。"""
  1585	    vault = tmp_path / "tiefixture"
  1586	    (vault / ".claude" / "scripts").mkdir(parents=True)
  1587	    (vault / "节点").mkdir()
  1588	    shutil.copy(WT / "canvas-vault" / ".claude" / "scripts" / "decay_beta.py", vault / ".claude" / "scripts")
  1589	    for board in ("甲板", "乙板", "丙板", "丁板"):
