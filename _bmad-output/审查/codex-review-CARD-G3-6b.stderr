   915	def render_md(payload, ranked) -> str:
   916	    s = payload["stats"]
   917	    lines = [
   918	        f"# 今日复习 · {payload['date']}",
   919	        "",
   920	        f"> 生成 {payload['generated_at']} · 到期={s['due_nodes']} / 未到期={s['future_nodes']}（不含未归板）"
   921	        f" · 节点状态: new={s['new']} / legacy={s['legacy']}"
   922	        f" / 无字段={s['none']} / 未剖析跳过={s['ineligible']} / 测试排除={s['test_excluded']}"
