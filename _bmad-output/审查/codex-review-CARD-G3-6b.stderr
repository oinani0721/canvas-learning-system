  2089	        "board": board,
  2090	        "top_node": top_node,
  2091	        "priority": 1.0,
  2092	        "pending": 1,
  2093	        "idle_days": None,
  2094	        "difficulty": "",
  2095	        "next_due": "",
  2096	        "why_this_board": "1 个节点到期 · 最该考的从未考察 · 这块板从未被推荐过",
  2097	        "estimated_minutes": 5,
  2098	        "factors": {"due_total": 1},
  2099	    }
  2100	    row.update(extra)
  2101	    return row
