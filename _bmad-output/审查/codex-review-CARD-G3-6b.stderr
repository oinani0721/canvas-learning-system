  1507	def test_g36b_golden_new_fields_frozen(tmp_path):
  1508	    """G3-6b 金样 (累积冻结链第三环): 本卡新增字段的值逐字冻结。旧字段的
  1509	    冻结由 D1 / G3-6a 两个累积金样承担 (它们已各自 pop 掉本卡字段后与各自
  1510	    时代之前的字面量全等) —— 本测试守的是「本卡加了什么」。下一轮加性卡
  1511	    应在本断言基础上 pop 自己的字段后与这份字面量全等。"""
  1512	    payload, _ = _build(
  1513	        tmp_path,
  1514	        {
  1515	            "存量": _node(),
  1516	            "已排期": _node(board="别板", extra="fsrs_due: 2026-08-15T01:00:00Z\n"),
  1517	            "占位": _node().replace("真实内容。", "> 你的 1-2 句精准定义"),
  1518	        },
  1519	    )
  1520	    tb = payload["top_boards"][0]
  1521	    assert list(tb) == [
  1522	        "board",
  1523	        "top_node",
  1524	        "priority",
  1525	        "pending",
  1526	        "idle_days",
  1527	        "difficulty",
  1528	        "next_due",
  1529	        "why_this_board",
  1530	        "estimated_minutes",
  1531	        "factors",
  1532	    ], "top_boards 行键序: 旧七字段在前, 本卡三件套行尾追加"
  1533	    assert tb["board"] == "普通板"
  1534	    assert tb["why_this_board"] == "1 个节点到期（其中 1 张新卡） · 最该考的从未考察 · 这块板从未被推荐过"
  1535	    assert tb["estimated_minutes"] == 5
  1536	    assert tb["factors"] == {
  1537	        "due_total": 1,
  1538	        "due_new": 1,
  1539	        "due_scheduled": 0,
  1540	        "due_malformed": 0,
  1541	        "overdue_days": None,
