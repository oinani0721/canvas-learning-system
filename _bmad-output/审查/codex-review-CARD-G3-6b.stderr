   538	def load_rank_manifest(path=None):
   539	    """S5 读系数清单 → (version, minutes, recorded)。缺失/损坏 = 诚实降级。
   540	
   541	    返回的 minutes 恒是可用的一对非负 int: manifest 给不出合法值时逐项回落
   542	    内置默认并 stderr 点名 —— 配置文件丢了不该让每日推送整轮失败, 但也绝不
   543	    静默 (静默降级 = 把配置断裂伪装成"就该是这个数")。version 只在文件与
   544	    version 字段双双可用时为整数, 其余一律 None ("没有版本"而非假装有)。
   545	    """
   546	    path = Path(path) if path is not None else Path(__file__).resolve().parent / MANIFEST_FILENAME
   547	    minutes = dict(DEFAULT_MINUTES)
   548	    try:
   549	        raw = json.loads(path.read_text(encoding="utf-8"))
   550	    except (OSError, ValueError) as e:  # ValueError ⊃ JSONDecodeError
   551	        print(f"[pick] 系数清单不可用, 用内置默认: {path} ({type(e).__name__})", file=sys.stderr)
   552	        return None, minutes, {}
   553	    if not isinstance(raw, dict):
   554	        print(f"[pick] 系数清单不是 object, 用内置默认: {path}", file=sys.stderr)
   555	        return None, minutes, {}
   556	
   557	    version = raw.get("version")
   558	    if not isinstance(version, int) or isinstance(version, bool):
   559	        print(f"[pick] 系数清单 version 非整数, 记为 None: {version!r}", file=sys.stderr)
   560	        version = None
   561	
   562	    auth = raw.get("authoritative")
   563	    cfg = auth.get("estimated_minutes") if isinstance(auth, dict) else None
   564	    if isinstance(cfg, dict):
   565	        for k in DEFAULT_MINUTES:
   566	            v = cfg.get(k)
   567	            if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
   568	                minutes[k] = v
   569	            elif v is not None:
   570	                print(f"[pick] estimated_minutes.{k} 非法({v!r}), 用内置默认 {minutes[k]}",
   571	                      file=sys.stderr)
   572	    elif cfg is not None:
   573	        print(f"[pick] authoritative.estimated_minutes 形状不符, 用内置默认: {cfg!r}",
   574	              file=sys.stderr)
