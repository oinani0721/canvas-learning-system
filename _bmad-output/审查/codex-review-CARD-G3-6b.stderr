  1253	def test_g36b_sha_digests_effective_values_not_file_bytes(tmp_path):
  1254	    """S5 本卡最容易做假的一条, 正反双向验:
  1255	
  1256	    正向 — 一个字节都不碰 manifest 文件, 只改 decay 模块的系数 → sha 必须变。
  1257	           (「对 manifest 文件取 hash」的实现在这里恒绿 —— 那正是本门的靶子。)
  1258	    反向 — 只改文件里的说明文字, 生效值一个没变 → sha 必须不变。
  1259	           (「把整个文件塞进摘要」的实现在这里会红。)
  1260	    """
  1261	    real = json.loads(_REAL_MANIFEST.read_text(encoding="utf-8"))
  1262	    v, minutes, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1263	    baseline = picker.build_rank_manifest(_fake_decay(), v, minutes, recorded)["sha256"]
  1264	
  1265	    moved = picker.build_rank_manifest(_fake_decay(GAMMA=0.5), v, minutes, recorded)["sha256"]
  1266	    assert moved != baseline, "改 decay 系数(不碰文件) 指纹必须变"
  1267	
  1268	    chatty = json.loads(json.dumps(real))
  1269	    chatty["_说明"] = "改一段与生效值无关的说明文字"
  1270	    chatty["recorded"]["_说明"] = "同上"
  1271	    v2, m2, r2 = picker.load_rank_manifest(_write_manifest(tmp_path, chatty))
  1272	    same = picker.build_rank_manifest(_fake_decay(), v2, m2, r2)["sha256"]
  1273	    assert same == baseline, "只改说明文字, 生效值没变, 指纹不该变"
  1274	
  1275	
  1276	def test_g36b_recorded_decay_snapshot_matches_real_module(tmp_path):
