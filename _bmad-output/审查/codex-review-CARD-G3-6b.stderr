  1555	    ], "factors 键序冻结 (落盘 diff 稳定性)"
  1556	    assert payload["truncated"] == {"top_boards": False, "upcoming": False}
  1557	    assert payload["rank_manifest"]["version"] == 1
  1558	    # sha 不冻结字面量 (用户改 manifest 分钟常量是预期内变更), 冻结「与复算一致」:
  1559	    # 拿生产 manifest 与生产 decay 重跑指纹函数, 必须逐字复得
  1560	    v, minutes, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1561	    decay = picker.load_decay(_mk_min_vault(tmp_path, "sha_v", {}))
  1562	    assert payload["rank_manifest"]["sha256"] == picker.build_rank_manifest(decay, v, minutes, recorded)["sha256"]
  1563	    # due_nodes 行: idle_days 行尾追加 (None = 从未考察), 旧键序不动
