   580	def _recorded_claim(recorded: dict, key: str, subkey: str | None = None):
   581	    """recorded 小节取值, 剥掉 "_" 开头的说明键; 形状不符返 None (= 未登记)。"""
   582	    node = recorded.get(key)
   583	    if not isinstance(node, dict):
   584	        return None
   585	    if subkey is not None:
   586	        return node.get(subkey)
   587	    return {k: v for k, v in node.items() if not k.startswith("_")}
   588	
   589	
   590	def _warn_recorded_drift(recorded: dict, effective: dict):
   591	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   592	
   593	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   594	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   595	    """
   596	    for label, claimed, actual in (
   597	        ("ranking_factors.order",
   598	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   599	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   600	        ("decay_beta_constants",
   601	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   602	    ):
   603	        if claimed is not None and claimed != actual:
   604	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   605	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
   606	
   607	
   608	def effective_rank_config(decay, version, minutes: dict) -> dict:
   609	    """S5 运行时实际生效的全部系数 —— sha256 的被摘要对象。
   610	
   611	    ⚠ 摘要的是"生效值"而不是 manifest 文件字节: 只对文件取 hash 的话, 别人
   612	    改 decay_beta.py 的 GAMMA (系数真的变了) 指纹却纹丝不动, 版本化就成了
   613	    摆设。decay 六常量一律从模块现场读 (getattr 缺失记 None —— 缺了指纹也
   614	    该变), 上限与因子序取代码常量, 分钟取 manifest 生效值。
   615	    """
   616	    return {
   617	        "version": version,
   618	        "ranking_factors": list(RANKING_FACTOR_ORDER),
   619	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   620	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   621	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   622	    }
   623	
   624	
   625	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   626	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   627	    effective = effective_rank_config(decay, version, minutes)
   628	    _warn_recorded_drift(recorded, effective)
   629	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   630	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   631	
   632	
   633	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   634	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   635	
   636	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   637	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   638	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   639	    """
   640	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   641	    overdue_days = None
   642	    if scheduled:
   643	        earliest_sh = _sh_local(min(scheduled))
   644	        if earliest_sh is not None:
   645	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   646	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   647	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   648	
   649	    rec = board_last_recommended.get(board, "")
   650	    gap = None
   651	    if rec:
   652	        try:
   653	            gap = max(0, (today_sh - date.fromisoformat(rec)).days)
   654	        except (ValueError, TypeError):
   655	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   656	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   657	            gap = None
   658	    return {
   659	        "due_total": len(due),
   660	        "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   661	        "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   662	        "due_malformed": sum(1 for n in due if n["due_fail_open"]),
   663	        "overdue_days": overdue_days,
   664	        "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   665	        "never_recommended": not rec,
   666	        "recommend_gap_days": gap,
   667	    }
   668	
   669	
   670	def why_this_board(f: dict) -> str:
   671	    """S4 模板: factors → 恒非空人话串。纯函数 — 同一 factors 恒得同一句。
   672	
   673	    契约测试把落盘的 factors 原样喂回本函数, 要求与落盘的 why_this_board
   674	    逐字相同 —— 解释与数字之间没有第二条通路 (没有 LLM, 没有渲染层再算)。
   675	    """
   676	    scale = f"{int(f['due_total'])} 个节点到期"
   677	    if f["due_new"]:
   678	        scale += f"（其中 {int(f['due_new'])} 张新卡）"
   679	    parts = [scale]
   680	    if f["due_scheduled"]:
   681	        od = f["overdue_days"]
   682	        if od is None:
   683	            parts.append("最早到期时刻超出可显示范围")
   684	        elif od > 0:
   685	            parts.append(f"最早的已逾期 {int(od)} 天")
   686	        else:
   687	            parts.append("最早的今天到期")
   688	    if f["due_malformed"]:
   689	        parts.append(f"含 {int(f['due_malformed'])} 个到期时间无法解析的节点")
   690	    parts.append("最该考的从未考察" if f["idle_days"] is None
   691	                 else f"最该考的已闲置 {int(f['idle_days'])} 天")
   692	    if f["never_recommended"]:
   693	        parts.append("这块板从未被推荐过")
   694	    elif f["recommend_gap_days"] is None:
   695	        parts.append("上次推荐日期无法解析")
   696	    elif f["recommend_gap_days"] == 0:
   697	        parts.append("今天已推荐过")
   698	    else:
   699	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   700	    return " · ".join(parts)
   701	
   702	
   703	def estimated_minutes(f: dict, minutes: dict) -> int:
   704	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   705	
   706	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   707	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   708	    """
   709	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   710	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
   711	
   712	
   713	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   714	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   715	
   716	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   717	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   718	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   719	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   720	    """
   721	    minutes = minutes or DEFAULT_MINUTES
   722	    today_sh = _today_sh(now)
   723	    boards: dict[str, list] = {}
   724	    unassigned = []
   725	    for n in nodes:
   726	        if not n["board"]:
   727	            unassigned.append(n["node"])
   728	            continue
   729	        boards.setdefault(n["board"], []).append(n)
   730	
   731	    ranked, upcoming = [], []
   732	    for board, members in boards.items():
   733	        due = [n for n in members if n["due_now"]]
   734	        if not due:
   735	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   736	            nxt = min(members, key=lambda n: n["fsrs_due"])
   737	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   738	            continue
   739	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   740	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   741	        ranked.append({
   742	            "board": board,
   743	            "top_node": top["node"],
   744	            "priority": round(top["pick"], 4),
   745	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   746	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   747	            "difficulty": top["difficulty"],
   748	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   749	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   750	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   751	            "why_this_board": why_this_board(factors),
   752	            "estimated_minutes": estimated_minutes(factors, minutes),
   753	            "factors": factors,
   754	            "_tie": (
   755	                round(top["pick"], 8),
   756	                board_last_recommended.get(board, ""),   # 空串 = 从未被推荐, 排最前
   757	                min(n["last_examined"] for n in due),    # 空串 = 有从未考节点, 排最前
   758	                board,
   759	            ),
   760	        })
   761	    ranked.sort(key=lambda r: r["_tie"])
   762	    for r in ranked:
   763	        del r["_tie"]
   764	    upcoming.sort(key=lambda u: u["next_due"])
   765	    return ranked, upcoming, unassigned
   766	
   767	
   768	def _title(board: str) -> str:
   769	    prefix = "📚 今日复习 · "
   770	    room = TITLE_LIMIT - len(prefix)
   771	    return prefix + (board if len(board) <= room else board[: room - 1] + "…")
   772	
   773	
   774	def _body(top: dict) -> str:
   775	    idle = "从未考察" if top["idle_days"] is None else f"已闲置 {top['idle_days']} 天"
   776	    if top["pending"] >= 2:
   777	        return f"{top['top_node']} 等 {top['pending']} 节点待巩固 · {idle}"
   778	    return f"{top['top_node']} 待巩固 · {idle}"
   779	
   780	
   781	def build_payload(vault: Path, now: datetime, board_last_recommended: dict, decay,
   782	                  manifest_path=None):
   783	    """CARD-G3-6b: 新增可选 manifest_path (缺省 = 本脚本同目录的系数清单)。
   784	
   785	    runner 侧调用形态不变 (daily_review_run:159-160 传四个位置参数) —— 新
   786	    参数是加性关键字, 消费面零变化。
   787	    """
   788	    version, minutes, recorded = load_rank_manifest(manifest_path)
   789	    rank_manifest = build_rank_manifest(decay, version, minutes, recorded)
   790	    nodes, stats, ineligible, placeholder_boards = scan_nodes(vault, now, decay)
   791	    ranked, upcoming, unassigned = rank_boards(nodes, board_last_recommended, now, minutes)
   792	    stats["unassigned"] = len(unassigned)
   793	    # CARD-G3-6a S1: 级联判桶 + why_due 一次算好, due_nodes 行与 buckets 分组
   794	    # 同源引用同一对值 (禁两处各算一遍 → 禁口径分裂)。划分域 = 已归板。
   795	    for n in nodes:
   796	        if n["board"]:
   797	            n["bucket"], n["why_due"] = assign_bucket(n, now)
   798	    # v3 (CARD-A2): due_nodes 明细与 stats 数字同源派生 — 自洽靠构造保证,
   799	    # 本投影是全系统到期口径唯一裁判 (Dashboard 只消费不重算)
   800	    due_rows = [
   801	        {
   802	            "node": n["node"],
   803	            "board": n["board"],
   804	            "state": n["state"],
   805	            "pick": round(n["pick"], 4),

exec
/bin/zsh -lc "nl -ba scripts/daily_review_pick.py | sed -n '805,990p'" in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-w6-whyboard
 succeeded in 0ms:
   805	            "pick": round(n["pick"], 4),
   806	            "fsrs_due": n["fsrs_due"],           # 空串 = 新卡即刻到期
   807	            # Codex-A2 M1: 消费方须能区分真新卡与 fail-open 的脏日期卡
   808	            "due_reason": ("malformed" if n["due_fail_open"]
   809	                           else ("scheduled" if n["fsrs_due"] else "new")),
   810	            "last_examined": n["last_examined"],
   811	            "difficulty": n["difficulty"],
   812	            # CARD-G3-6a 加性 (S2 加标签不搬移): 行仍在 due_nodes 内, 只多两
   813	            # 个字段 — 到期三桶之一 + 人话理由。旧字段一个不改。
   814	            "bucket": n["bucket"],
   815	            "why_due": n["why_due"],
   816	            # CARD-G3-6b 加性 (裁决②, 承 G3-6a 移交 #2): 结构化闲置天数 ——
   817	            # 与 why_due 的闲置片段同源同值 (都出自 scan_nodes 的 idle_days),
   818	            # 下游要按闲置排序时不必再从人话串里抠数字。None = 从未考察。
   819	            "idle_days": (None if n["idle_days"] is None else int(n["idle_days"])),
   820	        }
   821	        for n in nodes if n["board"] and n["due_now"]
   822	    ]
   823	    stats["due_nodes"] = len(due_rows)
   824	    stats["future_nodes"] = sum(1 for n in nodes if n["board"] and not n["due_now"])
   825	    # CARD-D1 P1 (BATCH-2026-08-27): 顶层加性 boards 全量 rollup — 补
   826	    # top_boards/upcoming 各截 [:3] 与 placeholder 板级无归属的结构性缺口。
   827	    # schema_version 保持 3; ineligible.placeholder 扁平列表 / notification /
   828	    # top_boards / upcoming 零改动 (A2 冻结)。due 计数与 due_rows 同源分组,
   829	    # 合计恒等 stats.due_nodes。
   830	    members_by_board: dict[str, list] = {}
   831	    for n in nodes:
   832	        if n["board"]:
   833	            members_by_board.setdefault(n["board"], []).append(n)
   834	    boards_rollup = []
   835	    for board in sorted(set(members_by_board) | set(placeholder_boards)):
   836	        members = members_by_board.get(board, [])
   837	        due = [n for n in members if n["due_now"]]
   838	        future = [n for n in members if not n["due_now"]]
   839	        boards_rollup.append({
   840	            "board": board,
   841	            "due": len(due),
   842	            # 三分语义与 due_rows.due_reason 同一判据: new=真新卡 /
   843	            # scheduled=已排期 / malformed=due-new-scheduled 隐含
   844	            "due_new": sum(1 for n in due if not n["fsrs_due"] and not n["due_fail_open"]),
   845	            "due_scheduled": sum(1 for n in due if n["fsrs_due"]),
   846	            "future": len(future),
   847	            "next_due": min((n["fsrs_due"] for n in future), default=""),
   848	            "placeholder": placeholder_boards.get(board, 0),
   849	            "earliest_overdue": min((n["fsrs_due"] for n in due if n["fsrs_due"]), default=""),
   850	        })
   851	    # CARD-G3-6a 加性: 顶层 buckets 五桶节点级分组 — 划分的权威表达。
   852	    # 五键恒在 (空 vault 亦为五个空数组, 与 ineligible 同风格, 消费方不做
   853	    # 存在性分支); 桶内按扫描序 (= due_nodes 行序) 稳定。行只带消费方渲染
   854	    # 队列必需的四字段: 到期三桶与 due_nodes 同源, due_today/future 是
   855	    # due_nodes 结构上装不下的那两桶 (它们不到期, 搬进去就违反 S2)。
   856	    buckets: dict[str, list] = {b: [] for b in BUCKET_ORDER}
   857	    for n in nodes:
   858	        if not n["board"]:
   859	            continue
   860	        buckets[n["bucket"]].append({
   861	            "node": n["node"],
   862	            "board": n["board"],
   863	            "why_due": n["why_due"],
   864	            "fsrs_due": n["fsrs_due"],
   865	        })
   866	    payload = {
   867	        "unassigned_nodes": unassigned,  # Code-Review M3: 点名而非只给数字
   868	        "schema_version": 3,             # v3: +due_nodes 明细 +ineligible 分桶
   869	        #                                  (纯加性; v2: FSRS WHEN 化 upcoming/due 语义)
   870	        # CARD-C1a: 顶层加性新增 — send 侧据此组合 per-vault 有效通知 id,
   871	        # C2 总览页据此标卡片; notification.id 值与其余字段零改动 (A2 冻结)
   872	        "vault_id": Path(vault).resolve().name,
   873	        "date": now.astimezone().date().isoformat(),
   874	        "generated_at": now.astimezone().isoformat(timespec="seconds"),
   875	        # CARD-G3-6b: 字面量 3 换成具名常量 —— 值恒等 (行为零变化), 但让
   876	        # truncated 的判据与截断本身同源, 不给"上限改了一处漏一处"留缝
   877	        "top_boards": ranked[:TOP_BOARDS_LIMIT],
   878	        "upcoming": upcoming[:UPCOMING_LIMIT],
   879	        "due_nodes": due_rows,
   880	        "boards": boards_rollup,  # CARD-D1 P1 加性: 板级全量 rollup
   881	        "buckets": buckets,       # CARD-G3-6a 加性: 五桶节点级分组 (S1 划分)
   882	        "ineligible": ineligible,
   883	        "stats": stats,
   884	        "notification": None,
   885	        # CARD-G3-6b 加性 (S5): 本轮实际生效系数的版本与指纹 — 消费方据此
   886	        # 判断"解释是按哪套系数算的"; version=None 表示清单缺失/损坏
   887	        "rank_manifest": rank_manifest,
   888	        # CARD-G3-6b 加性 (S6): 显式说"你看到的不是全部"。截断行为本身零
   889	        # 改动 (HEAD 起就截 3), 这里只是把它从隐式变成可见。
   890	        "truncated": {
   891	            "top_boards": len(ranked) > TOP_BOARDS_LIMIT,
   892	            "upcoming": len(upcoming) > UPCOMING_LIMIT,
   893	        },
   894	    }
   895	    day_id = f"canvas-review-{payload['date']}"
   896	    if ranked:
   897	        payload["notification"] = {
   898	            "title": _title(ranked[0]["board"]),
   899	            "body": _body(ranked[0]),
   900	            "group": "canvas复习",
   901	            "id": day_id,
   902	        }
   903	    elif upcoming:
   904	        # F1 放假语义: 有调度中的板但今天零到期 → 诚实说不用复习
   905	        nxt = upcoming[0]
   906	        payload["notification"] = {
   907	            "title": "📚 今日无到期节点",
   908	            "body": f"按计划推进，休息一天 · 最近到期 {nxt['board']} · {nxt['next_due'][:10]}",
   909	            "group": "canvas复习",
   910	            "id": day_id,
   911	        }
   912	    return payload, ranked
