  1284	    claimed = picker._recorded_claim(recorded, "decay_beta_constants")
  1285	    actual = {k: getattr(decay, k) for k in picker.DECAY_CONSTANT_NAMES}
  1286	    assert claimed == actual, "manifest 登记的 decay 常量与 decay_beta.py 实际值不符"
