     清空)。年份极值 (9999-12-31T23:59:59Z + 8h) astimezone 会 OverflowError
     — 人话层绝不崩全轮, 交由调用方走兜底文案 / 归 future。
     """
     try:
         return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(
