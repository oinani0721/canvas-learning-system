  2052	def test_g64_narrow_viewport_structural_guarantees(overview_env):
  2053	    """⑧ 窄窗不横溢 (结构性断言 —— 真实像素测量属用户 UAT 那一步)。
  2054	
  2055	    锁三条会导致 375px 横向溢出的写法:
  2056	      (a) 表格必须仍在 overflow-x:auto 容器里 (宽内容自己滚, 不推 body);
  2057	      (b) 节点条目必须允许长词折行 (overflow-wrap/word-break) —— 长节点名或
  2058	          长 why_due 不折行就会把整行顶宽;
  2059	      (c) 页面里不许出现固定 px 的 width/min-width (相对单位才随窗口缩)。
  2060	    """
  2061	    root, client = overview_env
  2062	    rows = [
  2063	        _due_row(
  2064	            "一个非常非常长的节点名字用来测试折行行为" * 3,
  2065	            "甲板",
  2066	            bucket="new",
  2067	            why_due="一段很长的理由" * 20,
  2068	        )
  2069	    ]
  2070	    _mk_vault(root, "vault-a", _nodes_projection("vault-a", rows))
  2071	    page = client.get("/api/v1/review/overview/page").text
  2072	
  2073	    assert "overflow-x:auto" in page, "(a) 宽表格要有自己的横向滚动容器"
  2074	    assert "overflow-wrap:anywhere" in page and "word-break:break-word" in page, "(b) 节点条目必须能折行"
  2075	    assert not re.search(r"(?<!max-)width:\s*\d+px", page), "(c) 不许固定 px 宽度"
  2076	    # viewport meta 在位 (缺了移动端会按 980px 虚拟视口渲染, 必横溢)
  2077	    assert 'name="viewport" content="width=device-width, initial-scale=1"' in page
  2078	
