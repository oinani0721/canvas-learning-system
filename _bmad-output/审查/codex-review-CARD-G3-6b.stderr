  1243	    assert _sha_of(minutes={"per_due_node": 3, "per_new_node": 6}) != baseline, "per_new_node"
  1244	    for name in picker.DECAY_CONSTANT_NAMES:
  1245	        assert _sha_of(decay=_fake_decay(**{name: 12.5})) != baseline, f"decay 常量 {name} 变了指纹却没动"
  1246	
  1247	    class _Missing:  # 模块被删了五个常量 —— 缺了也是变了
  1248	        PRIOR_A = 0.9
  1249	
  1250	    assert _sha_of(decay=_Missing()) != baseline, "decay 常量缺失"
