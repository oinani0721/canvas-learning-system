+#: 本卡开工基线 (worktree 分叉点) —— 排序金样对比的「改动前」版本。
+#: ⚠ 用固定 SHA 而不是 HEAD: 本卡一旦提交, HEAD 就是改动后的版本, 拿它当基准
+#: 等于自己跟自己比 —— 那是一道恒绿的假门。
+_BASELINE_SHA = "9af18b27"
+
+#: manifest 真文件 (生产默认加载的那一份)
+_REAL_MANIFEST = WT / "scripts" / "review_rank_manifest.json"
