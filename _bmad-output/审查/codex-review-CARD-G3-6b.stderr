   336	def _sh_local(ts: str):
   337	    """UTC-Z 定长时间串 → Asia/Shanghai aware datetime; 不可表示时 None。
   338	
   339	    ts 已由 scan_nodes 的 fsrs_due 门禁保证形态 (非规范值早被 fail-open
   340	    清空)。年份极值 (9999-12-31T23:59:59Z + 8h) astimezone 会 OverflowError
   341	    — 人话层绝不崩全轮, 交由调用方走兜底文案 / 归 future。
   342	    """
   343	    try:
   344	        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(
   345	            tzinfo=timezone.utc).astimezone(_TZ_SHANGHAI)
   346	    except (ValueError, OverflowError, OSError):
   347	        return None
   348	
   349	
   350	def _today_sh(now: datetime):
   351	    """判桶的「今天」基准 (Asia/Shanghai 日)。
   352	
   353	    极值 now (年份边界) 换算会 OverflowError —— 此处退化为 UTC 日而非崩掉
   354	    整轮 (S3 极值兜底同款诚实降级)。注意: HEAD 起 build_payload 的
   355	    payload["date"] 对同类极值本就会抛 OverflowError, main() 已在入口显式
   356	    拒绝这类 --now; 本兜底是给直接调用 build_payload 的路径留的防线。
   357	
   358	    Codex round-2 MEDIUM: UTC 回退本身也可能溢出 (如 year=1 且 offset=+14,
   359	    换算要减 14 小时 → 年份下溢), 故最后再退一档到 now 自身表示的日期 ——
   360	    该值恒可得, 三档保证本函数永不抛。
   361	    """
   362	    for tz in (_TZ_SHANGHAI, timezone.utc):
   363	        try:
   364	            return now.astimezone(tz).date()
   365	        except (OverflowError, OSError):
   366	            continue
   367	    return now.date()
