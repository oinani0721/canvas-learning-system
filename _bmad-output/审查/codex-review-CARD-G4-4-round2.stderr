     1	#!/usr/bin/env python3
     2	"""CARD-G4-4 变异负控制 v2 — 串行; 每变异后立即还原 + SHA 逐字节比对。
     3	
     4	v2 (Codex round-1 整改):
     5	- 判据收紧: 只有 exit==1 (pytest 真失败) 算杀门; exit==4 等 usage error
     6	  一律硬失败 (v1 的「任意非零当 kill」证据缺陷)。
     7	- M5 改为真降级 (warning → debug), 不再只改文案。
     8	- 新增 M6: expand_neighbors 表名改回裸 "vault_notes" → 杀 BLOCKER-1 门。
     9	"""
    10	import hashlib
    11	import os
    12	import subprocess
    13	import sys
    14	from pathlib import Path
    15	
    16	BACKEND = Path(os.environ["G44_BACKEND"]).resolve()
    17	
    18	RAG = BACKEND / "app/api/v1/endpoints/rag.py"
    19	NODES = BACKEND / "lib/agentic_rag/nodes.py"
    20	UNIT = BACKEND / "tests/unit/test_agentic_rag_vault_scope.py"
    21	
    22	TARGETS = (RAG, NODES, UNIT)
    23	BACKUP = {p: p.read_bytes() for p in TARGETS}
    24	SHA0 = {p: hashlib.sha256(b).hexdigest() for p, b in BACKUP.items()}
    25	
    26	def run_gate(test_id: str):
    27	    if test_id.startswith(("TestInner", "TestDual", "TestCurrent", "TestAgent", "TestSubject")):
    28	        f = "tests/unit/test_agentic_rag_vault_scope.py"
    29	    else:
    30	        f = "tests/api/v1/endpoints/test_rag_vault_scope_api.py"
    31	    r = subprocess.run(
    32	        [".venv/bin/pytest", f"{f}::{test_id}", "-q", "-p", "no:cacheprovider"],
