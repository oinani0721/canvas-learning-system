   103	def active_vault_aliases() -> set:
   104	    """当前 active vault 的**全部合法别名** (sanitize 后)。
   105	
   106	    Codex CARD-G2-2 round-1 HIGH-10 整改: ``Settings.vault_id`` 优先取
   107	    ``.canvas-config.yaml`` 的显式稳定 ID, 而插件 / SessionEnd hook /
   108	    exam skill 发来的往往是 **vault 目录名或 display name**。二者在
   109	    「稳定 ID ≠ 目录名」的合法配置下并不相等 —— 只比稳定 ID 会把每一个
   110	    正常请求都误判成跨 vault 并 409, 等于全站瘫痪。
   111	
   112	    因此一致性判定采用别名集合:
   113	      1. ``get_current_vault_id()`` — 稳定 ID (yaml 显式值优先)
   114	      2. ``sanitize_vault_id(ACTIVE_VAULT)`` — 环境变量里的目录名
   115	      3. ``sanitize_vault_id(basename(CANVAS_BASE_PATH))`` — 实际挂载目录名
   116	
   117	    命中任一即视为「指向当前挂载 vault」。fail-closed 不被削弱: 真正
   118	    指向**另一个** vault 的请求三项都不命中, 仍然 409。
   119	    """
   120	    import os
   121	
   122	    from app.config import get_current_vault_id, get_settings, sanitize_vault_id
   123	
   124	    aliases = {get_current_vault_id()}
   125	    try:
   126	        settings = get_settings()
   127	        if settings.ACTIVE_VAULT:
   128	            aliases.add(sanitize_vault_id(settings.ACTIVE_VAULT))
   129	        base = settings.CANVAS_BASE_PATH
   130	        if base:
   131	            aliases.add(sanitize_vault_id(os.path.basename(str(base).rstrip("/"))))
   132	    except Exception as e:  # noqa: BLE001 — 别名扩展失败只收窄到稳定 ID
   133	        logger.debug("vault_scope: alias expansion skipped (%s)", e)
   134	    return {a for a in aliases if a}
