   685	            ctx_value = get_current_subject_id()
   686	            if ctx_value and ctx_value != DEFAULT_SUBJECT_ID:
   687	                # vault:cs_61b → cs_61b ; vault:cs_61b:algorithms → cs_61b
   688	                derived = ctx_value
   689	                if derived.startswith("vault:"):
   690	                    derived = derived[len("vault:") :]
   691	                # take first segment (drop :subject / :canvas suffix)
   692	                first_seg = derived.split(":", 1)[0].strip()
   693	                if first_seg:
   694	                    logger.debug(
   695	                        "[LanceDB vault wiring] active_vault_id resolved from subject_config ContextVar: %s → %s",
   696	                        ctx_value,
   697	                        first_seg,
   698	                    )
   699	                    return first_seg
   700	        except (ImportError, AttributeError, RuntimeError, ValueError) as e:
   701	            # subject_config not importable (lib used standalone) or accessor
   702	            # broke at runtime → fall through to Level 3. Surface in debug log
   703	            # so Ops can spot wiring regressions without flooding warnings on
   704	            # the legitimate standalone-lib path.
   705	            logger.debug(
   706	                "[LanceDB vault wiring] subject_config ContextVar unavailable (%s: %s) — falling back to app.config",
   707	                type(e).__name__,
   708	                e,
   709	            )
   710	
   711	        # Step 3: legacy fallback — global active vault from settings.
   712	        # Same narrow-exception discipline as Level 2.
   713	        try:
   714	            from app.config import get_current_vault_id
   715	
   716	            return get_current_vault_id()
   717	        except (ImportError, AttributeError, RuntimeError, ValueError) as e:
   718	            # Level 4 (final): hard fallback to "default" table namespace.
   719	            # ⛔ This is the cross-vault-leak danger zone — warn loudly so Ops
   720	            # see it in production logs. Reaching here means BOTH the request
   721	            # ContextVar AND the legacy global config are unreachable, which
   722	            # should never happen inside a running FastAPI process.
   723	            logger.warning(
   724	                "[LanceDB vault wiring] active_vault_id fell back to 'default' "
   725	                "— both subject_config ContextVar and app.config unavailable "
   726	                "(last error: %s: %s); possible cross-vault leak",
   727	                type(e).__name__,
   728	                e,
   729	            )
   730	            return "default"
   731	
   732	    def resolve_table_name(self, table_name: str) -> str:
   733	        """Prefix table_name with vault_id for namespace isolation.
   734	
   735	        Phase B0.7 (Round-4 ChatGPT V3 Q2 选项 B 兼容读策略):
   736	        若 {vid}_{table_name} 不存在但 unprefixed {table_name} 存在
   737	        → 回退到 unprefixed 读取（保留 'default' 旧数据兼容期）
   738	        新 vault 数据写入仍用 prefixed; 旧数据通过 fallback 仍可见.
   739	        """
   740	        vid = self.active_vault_id
   741	        if not vid or vid == "default":
   742	            return table_name
   743	        if table_name.startswith(f"{vid}_"):
   744	            return table_name
   745	        prefixed = f"{vid}_{table_name}"
   746	        # Phase B0.7 fallback: 若 prefixed 不存在但 unprefixed 存在 → 读 unprefixed
   747	        try:
   748	            if self._db is not None:
   749	                all_tables = self._db.table_names()
   750	                if prefixed not in all_tables and table_name in all_tables:
   751	                    logger.debug(
   752	                        "[LanceDB B0.7 fallback] %s not found, reading legacy %s",
   753	                        prefixed,
   754	                        table_name,
   755	                    )
   756	                    return table_name
   757	        except Exception:
   758	            pass
   759	        return prefixed
   760	
   761	    def list_vault_tables(self, vault_id: str | None = None) -> list[str]:
   762	        """Return table names belonging to a specific vault."""
   763	        if self._db is None:
   764	            return []
   765	        prefix = f"{vault_id}_" if vault_id and vault_id != "default" else ""
   766	        all_tables = self._db.table_names()
   767	        if not prefix:
   768	            # RAG-S1 Code-Review H3 (2026-08-03): 精确匹配裸指纹表 —
   769	            # endswith 会把每个 vault 的 {vid}_file_fingerprints 都归入
   770	            # default, DELETE /index/default 一次抹掉全部 vault 的变更检测。
   771	            return [t for t in all_tables if "_" not in t or t == self.FINGERPRINT_TABLE]
   772	        return [t for t in all_tables if t.startswith(prefix)]
   773	
   774	    def get_all_vault_stats(self) -> dict[str, dict]:
   775	        """Return per-vault table/row statistics."""

