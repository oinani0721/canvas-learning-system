 {\"doc_id\":\"math_neighbor\",\"content\":\"math neighbor\",\"content_tokenized\":\"math neighbor\",\"vector\":[0.2]*8,\"canvas_file\":\"共同主题.canvas\",\"subject\":\"math\"},
