   386	def _run_retrieve_lancedb(monkeypatch, tmp_path, *, vault: str, query: str):
   387	    """以 vault 作用域跑真实 retrieve_lancedb 节点, 返回结果 doc_id/content。"""
   388	    client = _make_client(tmp_path)
   389	    monkeypatch.setattr(
   390	        nodes, "_get_lancedb_client", AsyncMock(return_value=client), raising=True
   391	    )
   392	    monkeypatch.setattr(
   393	        "agentic_rag.clients.lancedb_client.LanceDBClient.embed",
   394	        AsyncMock(return_value=_vec(0.15)),
   395	        raising=True,
   396	    )
   397	
   398	    token = _set_scope(f"vault:{vault}")
   399	    try:
   400	        state = {
   401	            "messages": [{"role": "user", "content": query}],
   402	            "canvas_file": None,
   403	            "subject": None,
   404	            "cross_subject": False,
   405	        }
   406	        update = asyncio.run(nodes.retrieve_lancedb(state, None))
   407	    finally:
   408	        _reset_scope(token)
   409	
   410	    results = update.get("lancedb_results", [])
   411	    return [(r.get("doc_id", ""), r.get("content", "")) for r in results]
