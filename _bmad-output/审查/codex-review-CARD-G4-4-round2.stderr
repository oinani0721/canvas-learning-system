   602	
   603	async def get_rag_context_with_timeout(
   604	    rag_service: RAGServiceDep,
   605	    query: str,
   606	    canvas_name: str,
   607	    timeout: float = RAG_TIMEOUT_SECONDS,
   608	) -> Optional[str]:
   609	    """
   610	    Execute RAG query with timeout and graceful degradation.
   611	
   612	    AC4: RAG延迟 < 2s（可接受范围）
   613	    AC5: RAG服务不可用时优雅降级（继续执行但不带上下文）
   614	
   615	    Args:
   616	        rag_service: RAG service instance
   617	        query: Query string (node content)
   618	        canvas_name: Canvas file name for context
   619	        timeout: Timeout in seconds (default: 2.0)
   620	
   621	    Returns:
   622	        Formatted RAG context string, or None if unavailable/timeout
   623	
   624	    [Source: docs/stories/story-12.A.2-agent-rag-bridge.md#Task-3]
   625	    """
   626	    # AC5: Check if RAG service is available
   627	    if not rag_service.is_available:
   628	        logger.warning(f"RAG service not available: {rag_service.import_error}")
   629	        return None
   630	
   631	    try:
   632	        # AC4: 2-second timeout
   633	        rag_result = await asyncio.wait_for(
   634	            rag_service.query_with_fallback(
   635	                query=query, canvas_file=canvas_name, fusion_strategy="weighted"
   636	            ),
   637	            timeout=timeout,
   638	        )
   639	
   640	        # Extract and format results
   641	        reranked = rag_result.get("reranked_results", [])
   642	        if not reranked:
   643	            # Fallback to fused results if no reranked
   644	            reranked = rag_result.get("fused_results", [])
   645	
   646	        if reranked:
   647	            formatted = format_rag_for_agent(reranked)
   648	            logger.info(
   649	                f"RAG context retrieved: {len(reranked)} results, {len(formatted)} chars"
   650	            )
   651	            return formatted
   652	
   653	        logger.debug("RAG query returned no results")
   654	        return None
