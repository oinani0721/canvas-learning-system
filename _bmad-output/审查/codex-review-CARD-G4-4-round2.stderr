   374	def _make_client(tmp_path):
   375	    """不带 vault override 的 client — 表名完全由 ContextVar 推导 (这是被测行为)。
   376	    跳过 initialize() 的向量模型预载, 手动连 tmp 库。"""
   377	    import lancedb
