  2356	def test_zero_width_split_marker_still_reads_as_ai_suspect(tmp_path):
  2357	    """⛔ round-2 负控 M-ZEROWIDTH 照出的**不承重层**，本门是它唯一的裁判。
  2358	
  2359	    回退 `_norm_guard_line` 后套件一门都不红 —— 因为 `Generated by<ZWSP>GPT-4`
  2360	    在旧归一下**已经**命中生成骨架（骨架里的非词字符段/非句读字符类都吃零宽），
  2361	    一条修法顺手覆盖了另一条。`_norm_guard_line` 真正承重的只有 `raw_ai_marker`:
  2362	    零宽插在**标记表项中间**时（`Generated by<ZWSP>AI Lab`），不剥零宽就匹配不到
  2363	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
  2364	
  2365	    ⚠️ 如实声明本门测的是**理由质量**不是安全: 两种情况材料都不会被删，
  2366	    差别只在 uncertain_reason 说的是「疑似 AI 自述」还是「生成断言结构」。
  2367	    留着这一层是因为前者对人更有用 —— 但不写成安全防线，也就不能假装它是。
  2368	    """
  2369	    mod = load_module()
  2370	    zw = "\u200b"
  2371	
  2372	    # 纯函数半边: 零宽切断表项时，只有护栏归一能还原出表项
  2373	    def _raw_hit(line, norm_fn):
  2374	        n = norm_fn(line)
  2375	        return next((o for nm, o in zip(mod._AI_MARKERS_NORM, mod.AI_MARKERS) if nm in n), None)
  2376	
  2377	    line = f"note: Generated by{zw}AI Lab"
  2378	    assert _raw_hit(line, mod._norm_ai_line) is None, "旧归一本就认不出（这是本门的前提）"
  2379	    assert _raw_hit(line, mod._norm_guard_line) == "Generated by AI"
  2380	    # C2 判据不得被这一层带宽：确定归档面必须原地不动
  2381	    assert mod.find_ai_marker(line) is None, "护栏加宽不得顺带扩大 C2 确定提名面"
  2382	
  2383	    vault, out = base_vault(tmp_path)
  2384	    inbox = vault / "_待处理"
  2385	    mk(inbox / "零宽切断表项.md", f"---\nnote: Generated by{zw}AI Lab\n---\n", age_days=6)
  2386	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=5)
  2387	
  2388	    assert run_cli(vault, out).returncode == 0
  2389	    data = load_json(out)
  2390	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2391	    it = item_by_name(data, "零宽切断表项.md")
  2392	    assert it["verdict"] != "建议删", it["basis"]
  2393	    assert it["criterion"] == "C6_undecided"
  2394	    assert it["confident"] is False
  2395	    # ⛔ 信号归属就是本门的全部判别力: 回退护栏归一后这里会变成「生成断言结构」
  2396	    r = it["uncertain_reason"] or ""
  2397	    assert "疑似 AI 生成自述" in r, f"未由 ai_suspect 接住（护栏归一没起作用）: {r}"
  2398	    skeleton = item_by_name(data, "纯空骨架.md")
  2399	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2400	    assert skeleton["verdict"] == "建议删"

