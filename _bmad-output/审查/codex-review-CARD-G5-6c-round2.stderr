   917	def find_generation_claim(text: str) -> str | None:
   918	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
   919	
   920	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
   921	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
   922	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
   923	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
   924	    """
   925	    for _, ln in head_window(text):
   926	        norm = _norm_guard_line(ln)
   927	        for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
   928	            m = rx.search(norm)
   929	            if m:
   930	                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
   931	                # `generated by l` —— 人工核对时看不出是哪个模型。补到该词结束。
   932	                end = m.end()
   933	                while end < len(norm) and (norm[end].isalnum() or norm[end] in "-_.:"):
   934	                    end += 1
