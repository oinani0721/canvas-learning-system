  1083	def near_duplicates(
  1084	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
  1085	) -> list[dict]:
  1086	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
  1087	    if not body:
  1088	        return []
  1089	    a_lines = body.split("\n")
  1090	    la = len(body)
  1091	    hits: list[tuple[float, str]] = []
  1092	    for rel, other in corpus_bodies:
  1093	        if other == body:
  1094	            continue  # 逐字相等归 C4，不重复计入疑似
  1095	        lb = len(other)
  1096	        if la > NEAR_DUP_BODY_CHAR_CAP or lb > NEAR_DUP_BODY_CHAR_CAP:
  1097	            scan["skipped_oversize"] += 1
  1098	            continue
  1099	        if not (1 / NEAR_DUP_LEN_RATIO <= (lb / la if la else 0) <= NEAR_DUP_LEN_RATIO):
  1100	            scan["skipped_length_prefilter"] += 1
  1101	            continue
  1102	        scan["compared_pairs"] += 1
  1103	        sm = difflib.SequenceMatcher(None, a_lines, other.split("\n"), autojunk=False)
  1104	        if sm.real_quick_ratio() < NEAR_DUP_RATIO or sm.quick_ratio() < NEAR_DUP_RATIO:
  1105	            continue
  1106	        r = sm.ratio()
  1107	        if r >= NEAR_DUP_RATIO:
  1108	            hits.append((r, rel))
  1109	    hits.sort(key=lambda x: (-x[0], x[1]))
  1110	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
