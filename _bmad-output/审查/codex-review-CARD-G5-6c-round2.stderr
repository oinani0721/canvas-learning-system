  1975	def test_doi_source_identifier_blocks_deletion(tmp_path):
  1976	    """⛔ round-8 HIGH: `Source: DOI:10.1000/xyz` 的唯一来源标识被当作不存在。
  1977	
  1978	    两处缺口: `"source" in fm` 是**大小写敏感**的字面查找(取不到 `Source`),
  1979	    而值不含 `http(s)://` 时 `url_bearing_keys` 也接不住 → C3 `建议删 +
  1980	    confident=true`。护栏两侧都补: 键名归一(大小写/连字符) + DOI 值形态。
  1981	    ⚠️ DOI **不冒充 URL 也不升 C1**(卡文 §3): 只把来源摆上台面降 C6。
  1982	    """
  1983	    vault, out = base_vault(tmp_path)
  1984	    inbox = vault / "_待处理"
  1985	    # round-8 反例原样
  1986	    mk(inbox / "DOI来源.md", "---\nSource: DOI:10.1000/xyz\n---\n", age_days=9)
  1987	    # 键名归一半边: 值不是 URL 也不是 DOI, 靠键名接住
  1988	    mk(inbox / "大写SOURCE手抄.md", "---\nSOURCE: 手抄自 2019 年讲义 P37\n---\n", age_days=8)
  1989	    # 值形态半边: 键名不在别名表, 靠 DOI 形态接住
  1990	    mk(inbox / "identifier键DOI.md", "---\nidentifier: 10.1145/3292500.3330701\n---\n", age_days=7)
  1991	    # C4 出口也必须拦
  1992	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1993	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1994	    mk(inbox / "DOI重复件.md", "---\ndoi: 10.1000/dup-only\n---\n" + body, age_days=6)
  1995	    # 正向对照 1: 无来源声明的纯空骨架 → 仍 C3 建议删
  1996	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=5)
  1997	    # 正向对照 2: 合法 source URL → 仍 C1(护栏不得扩大也不得挤掉判据)
  1998	    mk(inbox / "正常剪藏.md", "---\nsource: https://ok.test/clip\n---\n", age_days=4)
  1999	
  2000	    assert run_cli(vault, out).returncode == 0
  2001	    data = load_json(out)
  2002	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2003	    for name, frag in (
  2004	        ("DOI来源.md", "DOI:10.1000/xyz"),
  2005	        ("大写SOURCE手抄.md", "讲义 P37"),
  2006	        ("identifier键DOI.md", "10.1145/3292500.3330701"),
  2007	    ):
  2008	        it = item_by_name(data, name)
  2009	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2010	        assert it["criterion"] == "C6_undecided", name
  2011	        assert it["confident"] is False, name
  2012	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2013	        # ⛔ 来源标识必须逐字留痕 —— 否则「拦住了」等于把线索一起吞掉
  2014	        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  2015	    # ⛔ 信号归属（round-2 MEDIUM-4）：必须是**来源族**信号接住的，不是白名单兜底。
  2016	    # 单独回退来源信号时兜底会接住材料、verdict 断言仍绿 —— 那条防线就没被测到。
  2017	    for name in ("DOI来源.md", "大写SOURCE手抄.md"):
  2018	        r = item_by_name(data, name)["uncertain_reason"] or ""
  2019	        assert "不是可机判的" in r, f"{name} 应由 source 键名归一接住: {r}"
  2020	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2021	    for name in ("identifier键DOI.md", "DOI重复件.md"):
  2022	        r = item_by_name(data, name)["uncertain_reason"] or ""
  2023	        assert "DOI 来源标识" in r, f"{name} 应由 DOI 值形态接住: {r}"
  2024	        assert "既不认识这个键" not in r, f"{name} 落到了白名单兜底: {r}"
  2025	    # ⛔ DOI 不冒充 URL / 不升 C1
  2026	    doi_item = item_by_name(data, "DOI来源.md")
  2027	    assert doi_item["criterion"] != "C1_source_url", "DOI 不得被判成一手 URL"
  2028	    assert "DOI" in (doi_item["uncertain_reason"] or "")
  2029	    dup = item_by_name(data, "DOI重复件.md")
  2030	    assert dup["verdict"] != "建议删", f"带 DOI 的重复件被建议删了: {dup['basis']}"
  2031	    assert dup["criterion"] == "C6_undecided"
  2032	    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
  2033	    skeleton = item_by_name(data, "纯空骨架.md")
  2034	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2035	    assert skeleton["verdict"] == "建议删"
  2036	    primary = item_by_name(data, "正常剪藏.md")
  2037	    assert primary["criterion"] == "C1_source_url"
  2038	    assert primary["verdict"] == "留原地"
  2039	
