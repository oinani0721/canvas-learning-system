   962	def find_ai_marker(text: str) -> tuple[int, str] | None:
   963	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   964	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   965	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   966	    —— 行号准确，文本保真。"""
   967	    for lineno, ln in head_window(text):
   968	        norm = _norm_ai_line(ln)
   969	        hits = [
   970	            (pos, -len(nm), orig)
   971	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   972	            if (pos := _find_marker_pos(norm, nm)) >= 0
   973	        ]
   974	        if hits:
   975	            _, _, marker = min(hits)
   976	            return lineno, marker
   977	    return None
   978	
   979	
   980	def raw_ai_marker(text: str) -> str | None:
   981	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   982	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
   983	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
   984	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
   985	    返回原表原文（uncertain_reason 展示用）。
   986	    ⛔ 走 `_norm_guard_line`（比 C2 判据多剥零宽）—— 护栏宽、判据不动。"""
   987	    for _, ln in head_window(text):
   988	        norm = _norm_guard_line(ln)
   989	        for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
   990	            if nm in norm:
   991	                return orig
   992	    return None
