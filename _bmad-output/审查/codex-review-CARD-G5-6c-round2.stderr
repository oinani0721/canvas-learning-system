  2094	def test_duplicate_frontmatter_key_does_not_mask_source(tmp_path):
  2095	    """⛔ round-2 审查 BLOCKER: `frontmatter_map` 用 `setdefault` 只留**首值**，
  2096	
  2097	        ---
  2098	        doi:
  2099	        doi: 10.1000/hidden
  2100	        ---
  2101	
  2102	    折叠后只剩一个空值，所有基于 `fm.items()` 的护栏信号全扫不到那个 DOI ——
  2103	    同形 `url:` 反例同时穿透 C3 与 C4 两个出口。护栏改扫 `frontmatter_pairs`
  2104	    的全量键值对；判据侧的首值语义不动。
  2105	    """
  2106	    mod = load_module()
  2107	    pairs = mod.frontmatter_pairs(["doi:", "doi: 10.1000/hidden"])
  2108	    assert pairs == [("doi", ""), ("doi", "10.1000/hidden")], pairs
  2109	    assert mod.frontmatter_map(["doi:", "doi: 10.1000/hidden"]) == {"doi": ""}, (
  2110	        "判据侧首值语义必须保持不动 —— 改它是有后果的行为变更"
  2111	    )
  2112	
  2113	    vault, out = base_vault(tmp_path)
  2114	    inbox = vault / "_待处理"
  2115	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  2116	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  2117	    mk(inbox / "重复DOI键.md", "---\ndoi:\ndoi: 10.1000/hidden\n---\n", age_days=9)
  2118	    mk(inbox / "重复URL键.md", "---\nurl:\nurl: https://example.test/hidden\n---\n", age_days=8)
  2119	    mk(
  2120	        inbox / "重复DOI重复件.md",
  2121	        "---\ndoi:\ndoi: 10.1000/dup-hidden\n---\n" + body,
  2122	        age_days=7,
  2123	    )
  2124	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=6)
  2125	
  2126	    assert run_cli(vault, out).returncode == 0
  2127	    data = load_json(out)
  2128	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2129	    for name, frag in (
  2130	        ("重复DOI键.md", "10.1000/hidden"),
  2131	        ("重复URL键.md", "example.test/hidden"),
  2132	        ("重复DOI重复件.md", "10.1000/dup-hidden"),
  2133	    ):
  2134	        it = item_by_name(data, name)
  2135	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2136	        assert it["criterion"] == "C6_undecided", name
  2137	        assert it["confident"] is False, name
  2138	        r = it["uncertain_reason"] or ""
  2139	        assert frag in r, r
  2140	        # ⛔ 信号归属：兜底 reason 也会把值原样打出来，`frag in r` 单独不够判别。
  2141	        assert ("DOI 来源标识" in r) or ("来源 URL" in r), f"{name} 未由来源族接住: {r}"
