  1736	+def _norm_fm_key(k: str) -> str:
  1737	+    """frontmatter 键名归一：casefold + `-`→`_`。
  1738	+
  1739	+    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
  1740	+    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
  1741	+    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
  1742	+    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
  1743	+    """
  1744	+    return k.casefold().replace("-", "_")
  1745	+
  1746	+
  1747	+def _looks_like_doi_value(v: str) -> bool:
