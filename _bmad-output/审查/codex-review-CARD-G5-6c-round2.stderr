  2041	# ── round-2 审查（Codex round-1）抓出的同族缝隙回归门 ──
  2042	
  2043	
  2044	def test_long_model_name_and_punctuated_generation_claims_are_undigested(tmp_path):
  2045	    """⛔ round-2 审查 BLOCKER: 生成声明骨架的三条缝隙——
  2046	
  2047	    1. 中文骨架原写 `由[^。；！？\\n]{1,40}?生成`，**长度上界本身就是缝隙**：
  2048	       `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
  2049	       中间 65 字符，穿透后无正文被判 C3 确定删除；
  2050	    2. 英文骨架原写 `generated by \\S`（字面空格），`Generated by: GPT-4` 的
  2051	       `by` 后是冒号，不匹配；
  2052	    3. `Generated by<U+200B>GPT-4` 的零宽空格**不是** `str.isspace()` 认的空白，
  2053	       `ln.split()` 折叠不掉。护栏改走 `_norm_guard_line`（零宽→空格）。
  2054	    """
  2055	    mod = load_module()
  2056	    # 纯函数半边：上界去掉后骨架才真闭合
  2057	    long_name = "openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01"
  2058	    assert len(long_name) > 40, "反例必须真的超过原上界，否则本门是死门"
  2059	    assert mod._GEN_CLAIM_CN_RE.search(f"本文由 {long_name} 生成")
  2060	    assert mod._GEN_CLAIM_EN_RE.search("generated by: gpt-4"), "by 后标点必须放行"
  2061	    assert mod._GEN_CLAIM_EN_RE.search("generated by llama-4"), "原空格形态不得连坐"
  2062	    assert not mod._GEN_CLAIM_EN_RE.search("generated byte order mark"), "`byte` 不是 `by` —— 词边界必须挡住"
  2063	    assert not mod._GEN_CLAIM_EN_RE.search("generated by"), "光一句没有主语不算断言"
  2064	    assert mod._norm_guard_line("Generated by\u200bGPT-4") == "generated by gpt-4", (
  2065	        "零宽必须换成空格而非删除，否则 by 与 GPT 粘连、词边界照样认不出"
  2066	    )
  2067	
  2068	    vault, out = base_vault(tmp_path)
  2069	    inbox = vault / "_待处理"
  2070	    mk(inbox / "长模型名.md", f"---\nnote: 本文由 {long_name} 生成\n---\n", age_days=9)
  2071	    mk(inbox / "英文冒号.md", "---\nnote: Generated by: GPT-4\n---\n", age_days=8)
  2072	    mk(inbox / "英文零宽.md", "---\nnote: Generated by\u200bGPT-4\n---\n", age_days=7)
  2073	    # 正向对照: 白名单键 + 无正文 → 仍 C3 建议删（护栏不得吞掉存量判据）
  2074	    mk(inbox / "纯空骨架.md", "---\ntitle: t\ntags: x\n---\n\n# 只有标题\n", age_days=6)
  2075	
  2076	    assert run_cli(vault, out).returncode == 0
  2077	    data = load_json(out)
  2078	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2079	    for name in ("长模型名.md", "英文冒号.md", "英文零宽.md"):
  2080	        it = item_by_name(data, name)
  2081	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  2082	        assert it["criterion"] == "C6_undecided", name
  2083	        assert it["confident"] is False, name
  2084	        assert it["target_hint"] is None and it["nomination_type"] is None, name
  2085	        assert it["uncertain_reason"], name
  2086	        # ⛔ 信号归属：必须是**生成断言结构**接住的。这三份的键都是 `note`，
  2087	        # 不在白名单里，兜底同样能接住 —— 不锁信号就测不到骨架那一层。
  2088	        assert "生成断言结构" in it["uncertain_reason"], f"{name} 未由生成断言结构接住: {it['uncertain_reason']}"
  2089	    skeleton = item_by_name(data, "纯空骨架.md")
  2090	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2091	    assert skeleton["verdict"] == "建议删"
  2092	
