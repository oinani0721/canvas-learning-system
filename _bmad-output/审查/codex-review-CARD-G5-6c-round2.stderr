   561	
   562	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   563	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   564	    lines = text.splitlines()
   565	    n = frontmatter_span(lines)
   566	    return (lines[1 : n - 1] if n else []), lines[n:]
   567	
   568	
   569	def _clean_fm_value(raw: str) -> str:
   570	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   571	
   572	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   573	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   574	    （round-3 自审 H1-6）。
   575	    """
   576	    val = (raw or "").strip()
   577	    val = re.sub(r"\s+#.*$", "", val).strip()
   578	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   579	        val = val[1:-1]
   580	    return val
   581	
   582	
   583	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   584	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   585	
   586	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   587	    于是
   588	
   589	        ---
   590	        doi:
   591	        doi: 10.1000/hidden
   592	        ---
   593	
   594	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   595	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   596	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   597	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   598	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   599	    """
   600	    out: list[tuple[str, str]] = []
   601	    for ln in fm_lines:
   602	        m = _FM_KEY_RE.match(ln)
   603	        if m:
   604	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   605	    return out
   606	
   607	
   608	def frontmatter_map(fm_lines: list[str]) -> dict:
   609	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   610	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   611	    `frontmatter_pairs`。"""
   612	    out: dict[str, str] = {}
   613	    for k, v in frontmatter_pairs(fm_lines):
   614	        out.setdefault(k, v)
   615	    return out
   616	
   617	
   618	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   619	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   620	
   621	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   622	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   623	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   624	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   625	    分隔行由状态机精确标记，内容行一律是内容。
   626	
   627	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   628	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   629	
   630	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   631	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   632	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   633	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   634	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   635	    """

