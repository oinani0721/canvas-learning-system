  2330	def test_nbsp_heading_narrowing_locks_each_consumer(tmp_path):
  2331	    """⛔ round-2 审查 LOW: NBSP 门只直锁正则，`_HEADING_RE` 的三处消费面
  2332	    (`has_substantive_content` / `skeleton_note` / `dup_body`) 仅由端到端间接覆盖。
  2333	    本门对三处各下一条纯函数断言 —— 未来任一消费点改口径会当场红。
  2334	    """
  2335	    mod = load_module()
  2336	    nbsp_line = "#\u00a0keep\n"
  2337	    tab_line = "#\tonly heading\n"
  2338	
  2339	    # ① has_substantive_content：NBSP 行是正文，制表符行是标题（无正文）
  2340	    assert mod.has_substantive_content(nbsp_line) is True
  2341	    assert mod.has_substantive_content(tab_line) is False
  2342	
  2343	    # ② skeleton_note：NBSP 行不得被计入「标题 N 行」
  2344	    note_nbsp = mod.skeleton_note(nbsp_line, len(nbsp_line.encode()))
  2345	    assert "标题 0 行" in note_nbsp, note_nbsp
  2346	    note_tab = mod.skeleton_note(tab_line, len(tab_line.encode()))
  2347	    assert "标题 1 行" in note_tab, note_tab
  2348	
  2349	    # ③ dup_body：标题不进比对，故 NBSP 行必须**留在**归一化正文里
  2350	    assert mod.dup_body(nbsp_line) == "#\u00a0keep", mod.dup_body(nbsp_line)
  2351	    assert mod.dup_body(tab_line) == "", mod.dup_body(tab_line)
  2352	    # 连带：两份只差「井号后是 NBSP 还是制表符」的文件不得被判逐字相等
  2353	    assert mod.dup_body(nbsp_line) != mod.dup_body(tab_line)
