  1762	+        norm = _norm_guard_line(ln)
  1763	+        for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
  1764	+            m = rx.search(norm)
  1765	+            if m:
  1766	+                # ⛔ round-2 审查 LOW：英文骨架以单个词字符收尾，直接 group(0) 只给到
