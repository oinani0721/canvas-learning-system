   952	    while (i := ln.find(marker, start)) >= 0:
   953	        j = i + len(marker)
   954	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   955	            return i
   956	        if not ascii_ending and ln[j].isspace():
