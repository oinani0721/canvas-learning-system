pattern = re.compile(r'mutate_and_test \"(["'^"]+)"'"\\s+\\\\\\n\\s+\\'(.*?)\\'\\s+\\\\\\n\\s+\"(["'^"]+)"'"', re.S)
rows = []
for name, repl, gate in pattern.findall(harness):
