    old, new = (conv(part) for part in repl.split('|||'))
    rows.append((name, source.count(old), gate, repr(old[:100])))
print(f'parsed_calls={len(rows)}')
for row in rows:
    print(f'{row[0]} count={row[1]} gate={row[2]} old_prefix={row[3]}')
print('exact_once=', sum(count == 1 for _, count, _, _ in rows), 'nonunique=', sum(count "'!= 1 for _, count, _, _ in rows))
