   174	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   175	    """
   176	
   177	    name: str
   178	    status: str  #: ok | warn | fail
   179	    summary: str
   180	    findings: list[Finding] = field(default_factory=list)
   300	def _split_frontmatter(text: str) -> tuple[str, str]:
   301	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   302	    m = _FRONTMATTER.match(text)
   303	    return (m.group(1), m.group(2)) if m else ("", text)
   304	
   305	
   306	def _fm_scalar(fm: str, key: str) -> str | None:
   307	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   308	
   309	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   310	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   311	    ⛔ YAML null 语义 (Codex round-1 MEDIUM-1b + round-2 MEDIUM-1): 只认**裸** null 字面
   312	    (null/Null/NULL/~), 且必须在剥引号**之前**判 —— `source_board: "null"` 是字面
   313	    字符串 "null" (YAML 引号 = 强制字符串), 不是 null。不含 "none": PyYAML 把
   314	    `none` 解析为普通字符串, 吞掉它 = 比 YAML 更宽 = 会误豁免真的叫 "none" 的值。
   315	    """
   316	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   317	    if not matches:
   318	        return None
   319	    v = matches[-1].strip()
   320	    if v in ("null", "Null", "NULL", "~"):
   321	        return None  # 裸 null 字面 (先于剥引号 —— 引号包裹的是字符串, 不是 null)
   322	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   323	        v = re.sub(r"\s+#.*$", "", v)
   324	    v = v.strip().strip('"').strip("'")
   325	    return v or None
   326	
   327	
   328	def _norm_key(name: str) -> str:
   329	    """入链匹配键: NFC 归一 + casefold。
   330	
   331	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   332	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   333	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   334	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   335	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   336	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   337	    (假阴)。该权衡进验收单「不比什么」表。
   338	    """
   339	    return unicodedata.normalize("NFC", name).casefold().strip()
   340	
   341	
   342	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   343	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   344	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   345	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   346	# ⛔ r10 H2: END 须带词边界 —— `<!-- /AUTO-GENERATEDNESS -->` 的前缀匹配曾让畸形
   347	#    END 提前关闸 (深度计数被击穿)。lookahead 限定其后为行尾/空白/-->。
   348	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED(?=$|\s|-->|-)")
   349	
   350	
   351	def _blind_auto_lines(body: str) -> tuple[str, set[int], list[str]]:
   352	    """AUTO-GENERATED 哨兵段内的行盲化为注释行（**保留原行前导空白与纯 fence 标记行**），
   353	    其余行原样；返回（盲化文本, AUTO 行号集合, **结构异常清单**）。
   354	
   355	    ⛔ r10 终局语义（r8/r9 各轮教训累积后收敛）：AUTO 段是 sync_board_concepts.py
   356	      写入的**固定四段结构**（BEGIN/NOTE/成员/END，probe-F 实测 6 块板全部同构）。
   357	      r7-r10 各轮对抗反例（段内 fence 开合、嵌套 BEGIN、畸形 END、info string
   358	      反引号）在真实生成器输出中**不可达** —— 本函数不再试图正确解析这些形态：
   359	      - 按现行规则盲化（纯 fence 标记行原样保留维持开合、其余行盲化、嵌套深度计数）；
   360	      - **检测**到结构异常（段内 fence 标记行 / 嵌套 BEGIN / EOF 未闭合）时记入
   361	        anomalies 返回——调用方转为**显式盲区警告**, 把对抗形态从静默假绿变成可见信号。
   362	    """
   363	    out_lines: list[str] = []
   364	    auto_line_indices: set[int] = set()
   365	    anomalies: list[str] = []
   366	    depth = 0
   367	    # ⛔ 行模型与 mdit map 一致: 仅按 \n 分割 (r9 M5 —— splitlines 会把 VT/FF/NEL 等
   368	    #    也当行界, 导致盲化行号与 token.map 错位)。末行无 \n 时不补。
   369	    raw_lines = body.split("\n")
   370	    line_count = len(raw_lines)
   371	    for idx in range(line_count):
   372	        line = raw_lines[idx] + ("\n" if idx < line_count - 1 else "")
   373	        stripped = line.strip()
   374	        if depth > 0:
   375	            auto_line_indices.add(idx)
   376	            if _AUTO_BEGIN_RE.match(stripped):
   377	                # r9 H2: 嵌套 BEGIN —— 深度 +1 (真实生成器单层; 嵌套 = 结构异常, 显式记录)
   378	                depth += 1
   379	                anomalies.append(f"行 {idx + 1}: AUTO 段内嵌套 BEGIN (深度 {depth})")
   380	                indent = line[: len(line) - len(line.lstrip())]
   381	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   382	                continue
   383	            if _AUTO_END_RE.match(stripped):
   384	                depth -= 1
   385	                indent = line[: len(line) - len(line.lstrip())]
   386	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   387	                if depth > 0:
   388	                    anomalies.append(f"行 {idx + 1}: END 后残余深度 {depth} (嵌套段未闭合)")
   389	                continue
   390	            if re.fullmatch(r"(`{3,}|~{3,})[^`]*", stripped):
   391	                # 纯 fence 标记行原样保留, 维持开合状态 (r10 H1b: info 含反引号的行
   392	                # 不是纯 fence 标记, 落入下方盲化分支随段盲)
   393	                out_lines.append(line)
   394	                anomalies.append(f"行 {idx + 1}: AUTO 段内出现 fence 标记行 (生成器不产出, 按保留处理)")
   395	                continue
   396	            if re.match(r"(`{3,}|~{3,})", stripped):
   397	                # 非纯标记但以 fence 字符开头 (如 info 含反引号) —— 也显式记录
   398	                anomalies.append(f"行 {idx + 1}: AUTO 段内出现疑似 fence 标记行 (info 异常, 已随段盲化)")
   399	            indent = line[: len(line) - len(line.lstrip())]
   400	            out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   401	            continue
   402	        if _AUTO_BEGIN_RE.match(stripped):
   403	            depth += 1
   404	            auto_line_indices.add(idx)
   405	            indent = line[: len(line) - len(line.lstrip())]
   406	            out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   407	            continue
   408	        out_lines.append(line)
   409	    if depth > 0:
   410	        anomalies.append(f"EOF: AUTO 段未闭合 (残余深度 {depth}), 已盲化至文件尾")
   411	    return "".join(out_lines), auto_line_indices, anomalies
   412	
   413	
   414	def _raw_wikilink_targets_in_lines(src_lines: list[str], line_lo: int, line_hi: int) -> set[str]:
   415	    """原文行区间 [line_lo, line_hi) 内、**未被反斜杠转义**的裸 wikilink target 集合
   416	    （已归一）。转义判定含反斜杠奇偶（`` \\\\[[A]] `` 的成对反斜杠后是真链接）。"""
   417	    targets: set[str] = set()
   418	    for i in range(line_lo, min(line_hi, len(src_lines))):
   419	        line = src_lines[i]
   420	        for m in _WIKILINK.finditer(line):
   421	            backslashes = 0
   422	            k = m.start() - 1
   423	            while k >= 0 and line[k] == "\\":
   424	                backslashes += 1
   425	                k -= 1
   426	            if backslashes % 2 == 1:
   427	                continue  # 被转义的 [[ 不是链接起点
   428	            inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   429	            inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   430	            if inner:
   431	                targets.add(_norm_key(inner))
   432	    return targets
   433	
   434	
   435	def _wikilink_targets(body: str) -> tuple[set[str], list[str]]:
   436	    """正文里全部 wikilink 的 basename 集合（已归一）+ AUTO 段结构异常清单 —— **token 流法**。
   437	
   438	    ⛔ round-7 终局重构（r9 H1/H2/H3 再修）：rounds 2-7 手写的 Markdown 剥除/区间解析
   439	      （正则反向引用 → maximal run 配对 → 字符偏移区间 → AUTO 切分逐段解析）每轮
   440	      修复都开新洞。重演 G8-1 的核心教训「不重新实现解析」：
   441	      - `_blind_auto_lines` 先把 AUTO 哨兵段盲化为**保留缩进与 fence 标记行**的等行数
   442	        注释行（Markdown 连续性与容器上下文不破坏），返回 AUTO 原文行号集合；
   443	      - 整文喂 **markdown-it-py**（venv 既有依赖 4.0.0, 各轮审查的对照裁判）：
   444	        block 级 fence/code_block/html_block 整块不扫；inline 级只扫 `text` children；
   445	        closer 等长 / 转义反引号 / maximal run / 跨段落 / 容器嵌套全部库内正确处理；
   446	      - ⛔ r9 H3：decoded match 逐个绑定**原文裸 target 集合**——inline token 的
   447	        `map` 原文行区间内, `_raw_wikilink_targets_in_lines` 收集的裸 target（含反斜杠
   448	        奇偶转义判定）必须包含该 decoded target 才采纳。解码形态（实体/转义/混合）
   449	        在原文无对应裸链接时一律拒绝, 且**逐 match 绑定**而非整 token 放行。
   450	
   451	    ⛔ orphan 权威口径（r8 M4, 待用户裁决）：本检查按 **markdown-it-py 4.0.0 的可渲染
   452	      文本**裁判 wikilink; 生产图（`wikilink_graph_service.Vault.connect()`）与 Obsidian
   453	      实际渲染的口径可能不同（如 HTML 标签内 wikilink）—— 差异为已声明口径边界。
   454	
   455	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   456	    （`_WIKILINK` + `wikilink_basename`）与 `board_manifest_service.py:132`
   457	    （`resolve_node_id`）—— 三者本就同规则。
   458	
   459	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   460	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   461	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   462	       复制的代价 = 会漂; 行为等价由 `test_wikilink_targets_matches_sync_board_concepts`
   463	       同源锁测试绑定（live sync 脚本可读时逐字对照）。
   464	
   465	    覆盖形态（各有测试用例）：`[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   466	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`（含 `.MD` 大写）。**不**覆盖：AUTO 哨兵段
   467	    （含未闭合到 EOF 与嵌套 BEGIN）、fenced/indented code、行内 code、HTML 注释/块、
   468	    blockquote/list 容器内的 code、转义反引号、跨行 `[[..]]`、空 `[[]]`、`\\[\\[` 转义
   469	    方括号（含奇偶判定）、HTML 实体形式的 `[[`、**decoded target 在原文无裸对应**的
   470	    一切形态。
   471	    """
   472	    blinded, auto_line_indices, auto_anomalies = _blind_auto_lines(body)
   473	    src_lines = body.split("\n")
   474	    md = _md_parser()
   475	    out: set[str] = set()
   476	    for token in md.parse(blinded):
   477	        if token.type != "inline" or not token.children:
   478	            continue  # fence/code_block/html_block 等 block 级: 整块不扫
   479	        token_map = token.map or [0, 1]
   480	        # ⛔ r9 H3: 原文裸 target 集合（token 所在原文行区间, 含转义奇偶判定）——
   481	        # decoded match 逐个绑定: 只有原文确实存在的裸链接才采纳。
   482	        raw_targets = _raw_wikilink_targets_in_lines(src_lines, token_map[0], token_map[1])
   483	        if not raw_targets:
   484	            continue
   485	        for child in token.children:
   486	            if child.type != "text" or "[[" not in child.content:
   487	                continue  # code_inline/html_inline/softbreak 等: 不扫
   488	            for m in _WIKILINK.finditer(child.content):
   489	                inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   490	                inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   491	                if not inner:
   492	                    continue
   493	                key = _norm_key(inner)
   494	                if key in raw_targets:
   495	                    out.add(key)
   496	    return out, auto_anomalies
   497	
   498	
   499	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   500	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   501	
   502	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   503	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   504	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   505	    文件级检查), 再补两层本检查需要的:
   506	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   507	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   508	    """
   509	    if not root.is_dir():
   510	        return [], {}
   511	    blind: dict[str, str] = {}
   512	    dirs, files, cvr_blind = cvr._walk_vault(root)
   513	    for rel, why in cvr_blind:
   514	        blind[rel] = f"枚举盲区: {why}"
   515	    for d in dirs:
   516	        if d.is_symlink():
   517	            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
   518	    mds = sorted(f for f in files if f.suffix.lower() == ".md")
   519	    return mds, blind
   520	
   521	
   522	def _iter_md(root: Path) -> list[Path]:
   523	    """`_walk_md` 的只取文件面 (盲区面请用 `_walk_md`)。"""
   524	    return _walk_md(root)[0]
   525	
   526	
   527	# ---------------------------------------------------------------------------
   528	# 检查 1 — orphan_nodes
   529	# ---------------------------------------------------------------------------
   530	def check_orphan_nodes(vault: Path) -> CheckResult:
   531	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   532	
   533	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   534	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   535	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   536	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   537	
   538	    自链不算: 顶层节点正文里的裸 `[[自己]]` 不构成"有人引用 A"。**仅对顶层文件适用**
   539	    (Codex round-1 MEDIUM-1c): 子目录文件 `d1/A.md` 链 `[[d2/a]]` 在 Obsidian 里指向
   540	    `d2/a.md` 而非自己, 一律不排除 (方向 = 少误杀入链 = 少报孤儿, 保守)。
   541	
   542	    ⛔ 状态分级 (Codex round-1 HIGH-3 整改, "没发现" ≠ "没去查"):
   543	       - `节点/` 目录不存在 → **fail** (检查无对象可查, 不是零孤儿);
   544	       - 存在扫描盲区 (symlink/不可读) → **至少 warn** (盲区里的文件可能是孤儿);
   545	       - 孤儿 → warn (治理信号, 非系统故障; 判 fail 会让真实 vault 恒红 = 死门, 待用户裁决)。
   546	    """
   547	    node_root = vault / NODE_DIR
   548	    notes: list[str] = []
   549	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   550	
   551	    if not node_root.is_dir():
   552	        return CheckResult(
   553	            name="orphan_nodes",
   554	            status=FAIL,
   555	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   556	            findings=[Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")],
   557	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   558	            details={"nodes_scanned": 0, "inbound_targets": 0},
   559	        )
   560	    # 入链索引: 三处正文的 wikilink basename → 来源文件**物理路径**集合。
   561	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1); 枚举层盲区
   562	    #    (`_walk_md`): 不可读子树 / dangling / symlink 目录后代, 全部显式可见
   563	    #    (Codex round-3 H1a/H2)。盲区并入**只有这一处** (round-3 M18 教训:
   564	    #    节点/ 既是判定对象又是入链源, 曾被枚举两次、盲区两路并入互为冗余,
   565	    #    变异拆一路测试仍绿) —— `nodes` 直接复用 NODE_DIR 源循环的枚举结果。
   566	    inbound: dict[str, set[str]] = {}
   567	    nodes: list[Path] = []
   568	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   569	        srcs, src_blind = _walk_md(vault / src_dir)
   570	        for rel, why in src_blind.items():
   571	            blind[f"{src_dir}/{rel}"] = why
   572	        if src_dir == NODE_DIR:
   573	            nodes = srcs
   574	        for src in srcs:
   575	            blocked = _scan_block_reason(vault, src)
   576	            if blocked:
   577	                blind[src.relative_to(vault).as_posix()] = blocked
   578	                continue
   579	            text = _read_text(src)
   580	            if text is None:
   581	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   582	                continue
   583	            _fm, body = _split_frontmatter(text)
   584	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   585	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   586	            src_phys = os.path.realpath(src)
   587	            targets, auto_anomalies = _wikilink_targets(body)
   588	            for anomaly in auto_anomalies:
   589	                blind[f"{src_dir}/{src.name}"] = f"AUTO 段结构异常: {anomaly}"
   590	            for target in targets:
   591	                inbound.setdefault(target, set()).add(src_phys)
   592	
   593	    findings: list[Finding] = []
   594	    for node in nodes:
   595	        own = node.relative_to(vault).as_posix()
   596	        blocked = _scan_block_reason(vault, node)
   597	        if blocked:
   598	            blind[own] = blocked
   599	            continue
   600	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   601	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   602	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按
   603	        #    realpath 归并, 不得绕过自身排除。
   604	        own_phys = os.path.realpath(node)
   605	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   606	        if sources:
   607	            continue
   608	        text = _read_text(node)
   609	        if text is None:
   610	            blind[own] = "unreadable"
   611	            continue
   612	        fm, _body = _split_frontmatter(text)
   613	        if _fm_scalar(fm, "source_board"):
   614	            continue
   615	        findings.append(
   616	            Finding(
   617	                own,
   618	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   619	                f"(自身出链不计), 且 frontmatter 无 source_board",
   620	            )
   621	        )
   622	
   623	    if blind:
   624	        notes.append(
   625	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   626	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   627	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   628	        )
   629	    notes.append(
   630	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   630	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   631	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   632	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   633	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   634	    )
   635	    status = WARN if (findings or blind) else OK
   636	    return CheckResult(
   637	        name="orphan_nodes",
   638	        status=status,
   639	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   640	        findings=findings,
   641	        notes=notes,
   642	        details={
   643	            "nodes_scanned": len(nodes),
   644	            "inbound_targets": len(inbound),
   645	            "blind_spots": len(blind),
   646	            "blind_detail": dict(sorted(blind.items())),
   647	        },
   648	    )
   649	
   650	
   651	# ---------------------------------------------------------------------------
   652	# 检查 2 — raw_derived_confusion
   653	# ---------------------------------------------------------------------------
   654	def check_raw_derived(vault: Path) -> CheckResult:
   655	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   656	
   657	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   658	
   659	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   660	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   661	      G2 未登记根级文件    同上, 根级面
   662	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   663	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   664	                          正是"raw-derived 混淆"的机械定义
   665	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   666	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   667	
   668	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   669	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   670	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   671	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   672	                 **本次未验证**, 报告逐次声明
   673	
   674	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   675	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。
   676	    """
   677	    try:
   678	        data = cvr.load_rules()
   679	    except cvr.ConfigError as exc:
   680	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   681	    try:
   682	        res = cvr.scan(data, vault, with_probe=False)
   683	    except cvr.ConfigError as exc:
   684	        raise LintConfigError(str(exc)) from exc
   685	
   686	    findings = [
   687	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   688	        for fd in res.findings
   689	        if fd.code in CONFUSION_CODES and fd.blocking
   690	    ]
   691	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   692	
   693	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   694	    recap_bad = 0
   695	    recap_blind: dict[str, str] = {}
   696	    for md in _iter_md(vault):
   697	        if not md.name.startswith(RECAP_PREFIX):
   698	            continue
   699	        # ⛔ 与 orphan 同一条边界守卫 (Codex round-2 HIGH-1 第三旁路):
   700	        #    指向 vault 外的 回顾-* symlink 会被 read_frontmatter_type 跟随读取 ——
   701	        #    先拦截记盲区, 不读不判 (越界细节由 G8-1 的 G10/G11 判红)。
   702	        blocked = _scan_block_reason(vault, md)
   703	        if blocked:
   704	            recap_blind[md.relative_to(vault).as_posix()] = blocked
   705	            continue
   706	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   707	        ftype = cvr.read_frontmatter_type(md, parser=None)
   708	        if ftype != "recap":
   709	            recap_bad += 1
   710	            findings.append(
   711	                Finding(
   712	                    md.relative_to(vault).as_posix(),
   713	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   714	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   715	                )
   716	            )
   717	    notes: list[str] = [
   718	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   719	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   720	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   721	    ]
   722	    if recap_blind:
   723	        notes.append(
   724	            "recap 扫描盲区 (未读未判): " + ", ".join(f"{rel}[{why}]" for rel, why in sorted(recap_blind.items())[:5])
   725	        )
   726	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   727	    if blind:
   728	        notes.append(
   729	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   730	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   731	        )
   732	    if exempted:
   733	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   734	    for msg in res.info:
   735	        notes.append(f"台账扫描 info: {msg}")
   736	
   737	    return CheckResult(
   738	        name="raw_derived_confusion",
   739	        # ⛔ 盲区 ≥ warn (Codex round-3 H1c + round-4 HIGH-1): 盲区 = recap 拒读对象
   740	        #    (recap_blind) **或** G8/G10/G11 扫描面问题 (blind) —— 两者任一在场,
   741	        #    "0 混淆" 都是 "没查全" 而非 "没问题"。r4 曾只修 recap 特例漏掉 blind。
   742	        status=WARN if (findings or recap_blind or blind) else OK,
   743	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   744	        findings=findings,
   745	        notes=notes,
   746	        details={
   747	            "files_seen": res.files_seen,
   748	            "dirs_seen": res.dirs_seen,
   749	            "codes_counted": list(CONFUSION_CODES),
   750	            "recap_missing_type": recap_bad,
   751	            "recap_blind": dict(sorted(recap_blind.items())),
   752	            "blind_spots": len(blind),
   753	            "probe_skipped": res.probe_skipped,
   754	        },
   755	    )
   756	
   757	
   758	# ---------------------------------------------------------------------------
   759	# 检查 3 — projection_freshness
   760	# ---------------------------------------------------------------------------
   761	def _is_stale(generated_at: Any, today: date) -> bool:
   762	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   763	
   764	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   765	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   766	    都按 stale 降级, 绝不逃逸成异常。
   767	    """
   768	    stale = True
   769	    try:
   770	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   771	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   772	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   773	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   774	        stale = True
   775	    return stale
   776	
   777	
   778	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   779	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   780	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。

