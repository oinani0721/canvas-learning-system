   140	  # ═══════════════════════════════════════════════════════════════════════════════
   141	  # Phase 3: 检测破坏性变更
   142	  # ═══════════════════════════════════════════════════════════════════════════════
   143	  detect-breaking-changes:
   144	    name: Detect Breaking Changes
   145	    runs-on: ubuntu-latest
   146	    needs: export-openapi
   147	    if: github.event_name == 'pull_request'
   148	    outputs:
   149	      has-breaking: ${{ steps.oasdiff.outputs.breaking }}
   150	      breaking-count: ${{ steps.oasdiff.outputs.breaking-count }}
   151	    steps:
   152	      - uses: actions/checkout@v4
   153	        with:
   154	          fetch-depth: 0
   155	
   156	      - name: Download current spec
   157	        uses: actions/download-artifact@v4
   158	        with:
   159	          name: openapi-current
   160	
   161	      # `git show` 读 base 分支的 blob 到文件, 不动工作树 —— 旧写法用
   162	      # `git checkout <base> -- <根级规范文件>` 拉一个从不存在的路径, 恒失败后
   163	      # 再用 `git checkout <head> -- .` 试图还原, 基线因此恒为 `{}`(= 任何变更
   164	      # 都不会被 oasdiff 判为 breaking, 门恒绿)。
   165	      - name: Get base branch spec
   166	        run: |
   167	          git show "origin/${{ github.base_ref }}:backend/openapi.json" > openapi-base.json 2>/dev/null \
   168	            || { echo "::warning::base 分支无 backend/openapi.json, breaking 检测基线退化为空对象"; echo '{}' > openapi-base.json; }
   169	
   170	      - name: Install oasdiff
   171	        run: |
   172	          curl -sSL https://github.com/Tufin/oasdiff/releases/latest/download/oasdiff_linux_amd64.tar.gz | tar xz
   173	          sudo mv oasdiff /usr/local/bin/
   174	
   175	      - name: Run oasdiff
   176	        id: oasdiff
   177	        run: |
   178	          # 检测破坏性变更
   179	          oasdiff breaking openapi-base.json openapi-current.json \
   180	            --format json > breaking-changes.json 2>&1 || true
   181	
   182	          # 解析结果
   183	          BREAKING_COUNT=$(python3 -c "
   184	          import json
   185	          try:
   186	              with open('breaking-changes.json') as f:
   187	                  data = json.load(f)
   188	              count = len(data) if isinstance(data, list) else 0
   189	              print(count)
   190	          except:
   191	              print(0)
   192	          ")
   193	
   194	          echo "breaking-count=$BREAKING_COUNT" >> $GITHUB_OUTPUT
   195	
   196	          if [ "$BREAKING_COUNT" -gt 0 ]; then
   197	            echo "breaking=true" >> $GITHUB_OUTPUT
   198	            echo "::warning::Found $BREAKING_COUNT breaking changes!"
   199	          else
   200	            echo "breaking=false" >> $GITHUB_OUTPUT
   201	            echo "No breaking changes detected"
   202	          fi
   203	
   204	      - name: Generate diff report
   205	        run: |
   206	          oasdiff diff openapi-base.json openapi-current.json \
   207	            --format markdown > api-diff-report.md 2>&1 || echo "No changes" > api-diff-report.md
   208	
   209	      - name: Upload diff report
   210	        uses: actions/upload-artifact@v4
   211	        with:
   212	          name: api-diff-report
   213	          path: |
   214	            api-diff-report.md
   215	            breaking-changes.json
   216	
   217	      - name: Comment PR with changes
   218	        if: github.event_name == 'pull_request'
   219	        uses: actions/github-script@v7
   220	        with:
   221	          script: |
   222	            const fs = require('fs');
   223	
   224	            let diffReport = '';
   225	            try {
   226	              diffReport = fs.readFileSync('api-diff-report.md', 'utf8');
   227	            } catch (e) {
   228	              diffReport = 'No API changes detected.';
   229	            }
   230	
   231	            let breakingCount = '${{ steps.oasdiff.outputs.breaking-count }}';
   232	            let breakingSection = '';
   233	
   234	            if (parseInt(breakingCount) > 0) {
   235	              breakingSection = `
   236	            ## :warning: Breaking Changes Detected
   237	
   238	            **${breakingCount} breaking change(s) found!**
   239	
   240	            Please review carefully before merging. Breaking changes may affect:
   241	            - Frontend API calls
   242	            - External integrations
   243	            - Obsidian plugin compatibility
   244	            `;
   245	            }
   246	
   247	            const body = `## :mag: API Specification Change Report
   248	
   249	            ${breakingSection}
   250	
   251	            <details>
   252	            <summary>View API Diff</summary>
   253	
   254	            ${diffReport}
   255	
   256	            </details>
   257	
   258	            ---
   259	            *Generated by API Spec Sync workflow*
   260	            `;
   261	
   262	            github.rest.issues.createComment({
   263	              issue_number: context.issue.number,
   264	              owner: context.repo.owner,
   265	              repo: context.repo.repo,
   266	              body: body
   267	            });
