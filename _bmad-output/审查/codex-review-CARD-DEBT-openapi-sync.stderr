   189	def test_enum_order_is_drift():
   190	    """规则 4: enum 有序语义 — 顺序变化必须暴露, 不得当集合吞掉。"""
   191	    other = _mutated(lambda s: s["components"]["schemas"]["S"]["properties"]["alpha"].update({"enum": ["a", "m", "z"]}))
   192	    clean, details = drift.compare(other, BASE_SPEC)
   193	    assert not clean, "enum 顺序变化必须报漂移(取值顺序有语义)"
   194	    assert any("enum" in line for line in details), details
