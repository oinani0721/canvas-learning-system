/bin/zsh -lc 'nl -ba ".github/workflows/api-spec-sync.yml"' in /Users/Heishing/Desktop/canvas/canvas-learning-system/.claude/worktrees/card-w4-micro
 succeeded in 0ms:
     1	# Canvas Learning System - API Specification Sync Pipeline
     2	# 规范文档自动化同步检查
     3	#
     4	# 触发条件: OpenAPI 规范或 API 代码变更时
     5	# 功能:
     6	#   1. 快照漂移门: committed backend/openapi.json 必须与 app.openapi() 一致(漂移=红)
     7	#   2. 验证 OpenAPI 规范格式
     8	#   3. 检测破坏性变更 (oasdiff)
     9	#   4. 生成差异报告
    10	#
    11	# ⚠️ CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批] 修正的假门:
    12	#   本文件此前三处 `if [ -f ... ]` 存在性判断查的是**仓库根**下的规范文件, 而
    13	#   仓库根从来没有这个文件(`git log --all` 对该路径为空) —— 三处恒走 else 分支,
    14	#   "spec changed" 恒为 true, breaking-change 基线恒退化为 `{}`。真实快照一直在
    15	#   `backend/openapi.json`。同时 update-spec job 用 `git push || true` 吞掉失败,
    16	#   job 恒绿却从未推上去任何东西(origin main 上该根级文件至今 404)。
    17	#   现改为: 全部路径指向 backend/openapi.json, 且漂移直接让 job 变红。
    18	
    19	name: API Specification Sync
    20	
    21	on:
    22	  pull_request:
    23	    paths:
    24	      - 'backend/app/api/**'
    25	      - 'backend/app/models/**'
    26	      - 'specs/api/**'
    27	      - 'backend/openapi.json'
    28	  push:
    29	    branches:
    30	      - main
    31	      - clean-release
    32	    paths:
    33	      - 'backend/app/api/**'
    34	      - 'backend/app/models/**'
    35	
    36	env:
    37	  PYTHON_VERSION: '3.11'
    38	  NODE_VERSION: '20'
    39	
    40	jobs:
    41	  # ═══════════════════════════════════════════════════════════════════════════════
    42	  # Phase 1: 导出当前 OpenAPI 规范
    43	  # ═══════════════════════════════════════════════════════════════════════════════
    44	  export-openapi:
    45	    name: Export OpenAPI Spec
    46	    runs-on: ubuntu-latest
    47	    steps:
    48	      - uses: actions/checkout@v4
    49	        with:
    50	          fetch-depth: 0
    51	
    52	      - name: Set up Python
    53	        uses: actions/setup-python@v5
    54	        with:
    55	          python-version: ${{ env.PYTHON_VERSION }}
    56	          cache: 'pip'
    57	
    58	      - name: Install dependencies
    59	        run: |
    60	          cd backend
    61	          pip install -r requirements.txt
    62	
    63	      # 产物与 committed 快照同构(同一脚本、同一归一化), 供下游 job 消费。
    64	      - name: Export OpenAPI spec from FastAPI
    65	        run: |
    66	          python scripts/spec-tools/check-openapi-drift.py --write openapi-current.json
    67	
    68	      - name: Upload OpenAPI spec
    69	        uses: actions/upload-artifact@v4
    70	        with:
    71	          name: openapi-current
    72	          path: openapi-current.json
    73	          retention-days: 7
    74	
    75	      # ⛔ 漂移门: committed 快照与 app.openapi() 归一化后必须相等, 否则 job 红。
    76	      # 归一化只吸收 info.x-generated-at/x-generator、对象成员顺序、required 集合
    77	      # 内序; enum 顺序与其余一切差异照报(规则与依据见脚本模块 docstring)。
    78	      # 修法(在仓库根跑, 禁手改快照):
    79	      #   python scripts/spec-tools/check-openapi-drift.py --write backend/openapi.json
    80	      - name: Snapshot drift gate
    81	        run: |
    82	          python scripts/spec-tools/check-openapi-drift.py --snapshot backend/openapi.json
    83	
    84	  # ═══════════════════════════════════════════════════════════════════════════════
    85	  # Phase 2: 验证 OpenAPI 规范格式
    86	  # ═══════════════════════════════════════════════════════════════════════════════
    87	  validate-spec:
    88	    name: Validate OpenAPI Spec
    89	    runs-on: ubuntu-latest
    90	    needs: export-openapi
    91	    steps:
    92	      - uses: actions/checkout@v4
    93	
    94	      - name: Setup Node.js
    95	        uses: actions/setup-node@v4
    96	        with:
    97	          node-version: ${{ env.NODE_VERSION }}
    98	
    99	      - name: Download current spec
   100	        uses: actions/download-artifact@v4
   101	        with:
   102	          name: openapi-current
   103	
   104	      - name: Install Spectral
   105	        run: npm install -g @stoplight/spectral-cli
   106	
   107	      - name: Validate OpenAPI format
   108	        run: |
   109	          spectral lint openapi-current.json --format stylish || true
   110	          # 不强制失败，只报告问题
   111	
   112	      - name: Check for critical issues
   113	        run: |
   114	          # 检查必需字段
   115	          python3 -c "
   116	          import json
   117	          with open('openapi-current.json') as f:
   118	              spec = json.load(f)
   119	
   120	          issues = []
   121	          if 'openapi' not in spec:
   122	              issues.append('Missing openapi version')
   123	          if 'info' not in spec:
   124	              issues.append('Missing info section')
   125	          if 'paths' not in spec:
   126	              issues.append('Missing paths section')
   127	
   128	          if issues:
   129	              print('Critical issues found:')
   130	              for issue in issues:
   131	                  print(f'  - {issue}')
   132	              exit(1)
   133	          else:
   134	              print('OpenAPI spec validation passed')
   135	              print(f'  - Version: {spec.get(\"openapi\")}')
   136	              print(f'  - Title: {spec.get(\"info\", {}).get(\"title\")}')
   137	              print(f'  - Paths: {len(spec.get(\"paths\", {}))}')
   138	          "
   139	
   140	  # ═══════════════════════════════════════════════════════════════════════════════
   141	  # Phase 3: 检测破坏性变更
   142	  # ═══════════════════════════════════════════════════════════════════════════════
   143	  detect-breaking-changes:
   144	    name: Detect Breaking Changes
   145	    runs-on: ubuntu-latest
   146	    needs: export-openapi
   147	    if: github.event_name == 'pull_request'
   148	    outputs:
   149	      has-breaking: ${{ steps.oasdiff.outputs.breaking }}
   150	      breaking-count: ${{ steps.oasdiff.outputs.breaking-count }}
   151	    steps:
   152	      - uses: actions/checkout@v4
   153	        with:
   154	          fetch-depth: 0
   155	
   156	      - name: Download current spec
   157	        uses: actions/download-artifact@v4
   158	        with:
   159	          name: openapi-current
   160	
   161	      # `git show` 读 base 分支的 blob 到文件, 不动工作树 —— 旧写法用
   162	      # `git checkout <base> -- <根级规范文件>` 拉一个从不存在的路径, 恒失败后
   163	      # 再用 `git checkout <head> -- .` 试图还原, 基线因此恒为 `{}`(= 任何变更
   164	      # 都不会被 oasdiff 判为 breaking, 门恒绿)。
   165	      - name: Get base branch spec
   166	        run: |
   167	          git show "origin/${{ github.base_ref }}:backend/openapi.json" > openapi-base.json 2>/dev/null \
   168	            || { echo "::warning::base 分支无 backend/openapi.json, breaking 检测基线退化为空对象"; echo '{}' > openapi-base.json; }
   169	
   170	      - name: Install oasdiff
   171	        run: |
   172	          curl -sSL https://github.com/Tufin/oasdiff/releases/latest/download/oasdiff_linux_amd64.tar.gz | tar xz
   173	          sudo mv oasdiff /usr/local/bin/
   174	
   175	      - name: Run oasdiff
   176	        id: oasdiff
   177	        run: |
   178	          # 检测破坏性变更
   179	          oasdiff breaking openapi-base.json openapi-current.json \
   180	            --format json > breaking-changes.json 2>&1 || true
   181	
   182	          # 解析结果
   183	          BREAKING_COUNT=$(python3 -c "
   184	          import json
   185	          try:
   186	              with open('breaking-changes.json') as f:
   187	                  data = json.load(f)
   188	              count = len(data) if isinstance(data, list) else 0
   189	              print(count)
   190	          except:
   191	              print(0)
   192	          ")
   193	
   194	          echo "breaking-count=$BREAKING_COUNT" >> $GITHUB_OUTPUT
   195	
   196	          if [ "$BREAKING_COUNT" -gt 0 ]; then
   197	            echo "breaking=true" >> $GITHUB_OUTPUT
   198	            echo "::warning::Found $BREAKING_COUNT breaking changes!"
   199	          else
   200	            echo "breaking=false" >> $GITHUB_OUTPUT
   201	            echo "No breaking changes detected"
   202	          fi
   203	
   204	      - name: Generate diff report
   205	        run: |
   206	          oasdiff diff openapi-base.json openapi-current.json \
   207	            --format markdown > api-diff-report.md 2>&1 || echo "No changes" > api-diff-report.md
   208	
   209	      - name: Upload diff report
   210	        uses: actions/upload-artifact@v4
   211	        with:
   212	          name: api-diff-report
   213	          path: |
   214	            api-diff-report.md
   215	            breaking-changes.json
   216	
   217	      - name: Comment PR with changes
   218	        if: github.event_name == 'pull_request'
   219	        uses: actions/github-script@v7
   220	        with:
   221	          script: |
   222	            const fs = require('fs');
   223	
   224	            let diffReport = '';
   225	            try {
   226	              diffReport = fs.readFileSync('api-diff-report.md', 'utf8');
   227	            } catch (e) {
   228	              diffReport = 'No API changes detected.';
   229	            }
   230	
   231	            let breakingCount = '${{ steps.oasdiff.outputs.breaking-count }}';
   232	            let breakingSection = '';
   233	
   234	            if (parseInt(breakingCount) > 0) {
   235	              breakingSection = `
   236	            ## :warning: Breaking Changes Detected
   237	
   238	            **${breakingCount} breaking change(s) found!**
   239	
   240	            Please review carefully before merging. Breaking changes may affect:
   241	            - Frontend API calls
   242	            - External integrations
   243	            - Obsidian plugin compatibility
   244	            `;
   245	            }
   246	
   247	            const body = `## :mag: API Specification Change Report
   248	
   249	            ${breakingSection}
   250	
   251	            <details>
   252	            <summary>View API Diff</summary>
   253	
   254	            ${diffReport}
   255	
   256	            </details>
   257	
   258	            ---
   259	            *Generated by API Spec Sync workflow*
   260	            `;
   261	
   262	            github.rest.issues.createComment({
   263	              issue_number: context.issue.number,
   264	              owner: context.repo.owner,
   265	              repo: context.repo.repo,
   266	              body: body
   267	            });
   268	
   269	  # ═══════════════════════════════════════════════════════════════════════════════
   270	  # Phase 4: 合约测试 (Dredd)
   271	  # ═══════════════════════════════════════════════════════════════════════════════
   272	  # ⛔ 停用 (CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批])
   273	  # 依据:
   274	  #   1. 本 workflow 在 GitHub 上 24/24 runs 全 failure(2026-04-17 → 2026-06-01),
   275	  #      最新一次 run 里唯一 failure 的 job 就是本 job(Export/Validate/Update 均
   276	  #      success, Detect Breaking skipped)。
   277	  #   2. 失败原因**已不可考**: GitHub 日志保留期已过, 拉取返回 410 Gone。
   278	  #      在原因不明的前提下修它 = 猜, 所以本卡只停用不修。
   279	  #   3. 覆盖面并未因此丢失: schemathesis 在进程内做同类契约校验
   280	  #      (backend/tests/contract/test_openapi_contract.py, from_asgi 直接读 app),
   281	  #      不需要起 uvicorn + Neo4j service 容器。
   282	  # 复活或退役由独立候选卡裁决(已登记, 第九批候补)。届时删掉 `if: false` 即可。
   283	  contract-test:
   284	    name: Contract Test (Dredd)
   285	    runs-on: ubuntu-latest
   286	    if: false
   287	    needs: [export-openapi, validate-spec]
   288	    services:
   289	      neo4j:
   290	        image: neo4j:5.26-community
   291	        ports:
   292	          - 7474:7474
   293	          - 7687:7687
   294	        env:
   295	          NEO4J_AUTH: neo4j/testpassword
   296	        options: >-
   297	          --health-cmd "curl -f http://localhost:7474 || exit 1"
   298	          --health-interval 10s
   299	          --health-timeout 5s
   300	          --health-retries 5
   301	    steps:
   302	      - uses: actions/checkout@v4
   303	
   304	      - name: Set up Python
   305	        uses: actions/setup-python@v5
   306	        with:
   307	          python-version: ${{ env.PYTHON_VERSION }}
   308	          cache: 'pip'
   309	
   310	      - name: Setup Node.js
   311	        uses: actions/setup-node@v4
   312	        with:
   313	          node-version: ${{ env.NODE_VERSION }}
   314	
   315	      - name: Download current spec
   316	        uses: actions/download-artifact@v4
   317	        with:
   318	          name: openapi-current
   319	
   320	      - name: Install dependencies
   321	        run: |
   322	          cd backend
   323	          pip install -r requirements.txt
   324	          npm install -g dredd
   325	
   326	      - name: Start FastAPI server
   327	        run: |
   328	          cd backend
   329	          export NEO4J_URI=bolt://localhost:7687
   330	          export NEO4J_USER=neo4j
   331	          export NEO4J_PASSWORD=testpassword
   332	          uvicorn app.main:app --host 0.0.0.0 --port 8000 &
   333	          sleep 10  # 等待服务器启动
   334	
   335	      - name: Wait for API to be ready
   336	        run: |
   337	          for i in {1..30}; do
   338	            if curl -s http://localhost:8000/api/v1/health > /dev/null; then
   339	              echo "API is ready"
   340	              break
   341	            fi
   342	            echo "Waiting for API... ($i/30)"
   343	            sleep 2
   344	          done
   345	
   346	      - name: Run Dredd contract tests
   347	        id: dredd
   348	        continue-on-error: true
   349	        run: |
   350	          dredd openapi-current.json http://localhost:8000 \
   351	            --reporter json:dredd-report.json \
   352	            --reporter markdown:dredd-report.md \
   353	            --hookfiles scripts/spec-tools/dredd-hooks.js \
   354	            --method GET \
   355	            --names || true
   356	
   357	      - name: Parse Dredd results
   358	        run: |
   359	          python3 -c "
   360	          import json
   361	          try:
   362	              with open('dredd-report.json') as f:
   363	                  data = json.load(f)
   364	
   365	              stats = data.get('stats', {})
   366	              print('Contract Test Results:')
   367	              print(f'  - Tests: {stats.get(\"tests\", 0)}')
   368	              print(f'  - Passes: {stats.get(\"passes\", 0)}')
   369	              print(f'  - Failures: {stats.get(\"failures\", 0)}')
   370	              print(f'  - Pending: {stats.get(\"pending\", 0)}')
   371	
   372	              if stats.get('failures', 0) > 0:
   373	                  print('::warning::Contract test failures detected')
   374	          except Exception as e:
   375	              print(f'Could not parse Dredd results: {e}')
   376	          "
   377	
   378	      - name: Upload Dredd report
   379	        uses: actions/upload-artifact@v4
   380	        with:
   381	          name: dredd-report
   382	          path: |
   383	            dredd-report.json
   384	            dredd-report.md
   385	
   386	  # ═══════════════════════════════════════════════════════════════════════════════
   387	  # Phase 5(已删除): 自动提交 OpenAPI 规范文件
   388	  # ═══════════════════════════════════════════════════════════════════════════════
   389	  # 原 update-spec job 已删除 (CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批])。
   390	  # 它做的是: push main 时把导出结果 `mv` 成**仓库根**的规范文件再
   391	  # `git commit || true; git push || true`。三重失效叠在一起:
   392	  #   - 写的是从不存在的根路径, 与真实快照 backend/openapi.json 无关;
   393	  #   - `|| true` 把 commit 与 push 的失败一并吞掉, job 恒 success;
   394	  #   - 结果就是"恒绿却从未推上去": origin main 至今没有那个根级文件
   395	  #     (gh api contents 404, commits?path 为空)。
   396	  # 快照现在由三处保证新鲜, 不再需要 CI 代写:
   397	  #   1. lefthook pre-commit 的 spec-sync —— 改 API 即重生成并 stage;
   398	  #   2. 本 workflow 的 Snapshot drift gate —— 漂移就红, 逼人本地重生成;
   399	  #   3. 批次收官时在最终主干统一 `--write` 并单独 governance commit。
   400	  # ⚠️ 删除自动提交 job 属 CI/CD 变更, 按默认在车道落 commit 但**不 push**,
   401	  #    合并前须用户逐项批(验收单「待你裁决」)。
   402	
   403	  # ═══════════════════════════════════════════════════════════════════════════════
   404	  # Summary Job
   405	  # ═══════════════════════════════════════════════════════════════════════════════
   406	  summary:
   407	    name: Summary
   408	    runs-on: ubuntu-latest
   409	    needs: [export-openapi, validate-spec, detect-breaking-changes, contract-test]
   410	    if: always()
   411	    steps:
   412	      - name: Generate summary
   413	        run: |
   414	          echo "## API Specification Sync Summary" >> $GITHUB_STEP_SUMMARY
   415	          echo "" >> $GITHUB_STEP_SUMMARY
   416	
   417	          echo "| Check | Status |" >> $GITHUB_STEP_SUMMARY
   418	          echo "|-------|--------|" >> $GITHUB_STEP_SUMMARY
   419	
   420	          if [ "${{ needs.export-openapi.result }}" == "success" ]; then
   421	            echo "| Export + Snapshot Drift Gate | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   422	          else
   423	            echo "| Export + Snapshot Drift Gate | :x: backend/openapi.json 已漂移或导出失败 |" >> $GITHUB_STEP_SUMMARY
   424	          fi
   425	
   426	          if [ "${{ needs.validate-spec.result }}" == "success" ]; then
   427	            echo "| Validate Spec | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   428	          else
   429	            echo "| Validate Spec | :x: |" >> $GITHUB_STEP_SUMMARY
   430	          fi
   431	
   432	          if [ "${{ needs.detect-breaking-changes.outputs.has-breaking }}" == "true" ]; then
   433	            echo "| Breaking Changes | :warning: ${{ needs.detect-breaking-changes.outputs.breaking-count }} found |" >> $GITHUB_STEP_SUMMARY
   434	          else
   435	            echo "| Breaking Changes | :white_check_mark: None |" >> $GITHUB_STEP_SUMMARY
   436	          fi
   437	
   438	          if [ "${{ needs.contract-test.result }}" == "skipped" ]; then
   439	            echo "| Contract Tests (Dredd) | :heavy_minus_sign: 已停用 — 见 job 上方注释; 契约校验由 backend/tests/contract/test_openapi_contract.py (schemathesis) 承担 |" >> $GITHUB_STEP_SUMMARY
   440	          elif [ "${{ needs.contract-test.result }}" == "success" ]; then
   441	            echo "| Contract Tests (Dredd) | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   442	          else
   443	            echo "| Contract Tests (Dredd) | :warning: |" >> $GITHUB_STEP_SUMMARY
   444	          fi

