    31	BACKEND_DIR = Path(__file__).resolve().parents[2]
    32	REPO_ROOT = BACKEND_DIR.parent
    33	DRIFT_TOOL = REPO_ROOT / "scripts" / "spec-tools" / "check-openapi-drift.py"
    34	SNAPSHOT = BACKEND_DIR / "openapi.json"
