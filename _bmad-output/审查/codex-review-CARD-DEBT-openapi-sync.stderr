   227	def test_bool_to_number_is_drift():
   228	    """规则 5: Python 的 True == 1 会吞掉 bool↔数字真漂移, 必须显式打破。
   229	
   230	    JSON 里 true 与 1 序列化不同, 是真实契约变更(default: true → default: 1
   231	    改变客户端收到的值)。
   232	    """
   233	    other = _mutated(
   234	        lambda s: s["components"]["schemas"]["S"]["properties"].update({"beta": {"type": "string", "default": 1}})
   235	    )
   236	    base_with_bool = _mutated(
   237	        lambda s: s["components"]["schemas"]["S"]["properties"].update({"beta": {"type": "string", "default": True}})
   238	    )
   239	    clean, details = drift.compare(base_with_bool, other)
   240	    assert not clean, "default true → 1 必须报漂移(Python True==1 的语言坑不许带进门)"
   241	    assert any("boolean" in line and "number" in line for line in details), details
