    93	def test_lockdown_actually_blocks():
    94	    """自证: socket 禁闭真的会拦 connect(否则「无 lifespan」是空话)。"""
    95	    with pytest.raises(RuntimeError, match="socket connect blocked"):
    96	        with drift.socket_connect_lockdown():
    97	            socket.socket().connect(("127.0.0.1", 65000))
    98	    # 退出上下文后必须还原, 不污染同进程其他测试
    99	    assert socket.socket.connect.__name__ != "_blocked_connect"
