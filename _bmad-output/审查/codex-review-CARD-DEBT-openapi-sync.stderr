    97	      #      test_memory_service_contextvar_leak.py 已按 `_vault_scoped_group_id`
    98	      #      新契约（进程级单 active vault，忽略 ContextVar）语义重写，
    99	      #      conftest 的 collect_ignore 已回收，文件已加入下方显式清单。
   100	      #   4. ✅ 已完成 (BATCH-2026-08-29-第六批 / CARD-收口A): G3-1 事件账 schema
   101	      #      契约 test_learning_events_schema_contract.py 与 G3-4 FSRS golden
   102	      #      vectors test_fsrs_golden_vectors.py 此前未接入任何 workflow
   103	      #      (第五批复核裁定 S3-b)，已加入下方显式清单。接入前按本步**完全相同**
   104	      #      的 env/选择集/flags 做过本地等价验证：原 15 文件 303 passed →
   105	      #      加这两个后 516 passed + 1 skipped（303+213=516 严格可加，证明与既有
   106	      #      清单无交叉污染）。那 1 skipped 是 live 账本用例的自带守卫
   107	      #      (contract:1078)，CI 无 vault 时同样 skip，不会红。
   108	      - name: Run tests
   109	        env:
   110	          # R11-BATCH2 第三环 —— 修掉 hypothesis 与 collection error 后暴露出来的:
   111	          #   pydantic ValidationError: NEO4J_PASSWORD must be set explicitly outside local dev
   112	          # conftest.py:23 的 `from app.main import app` 在 **import 阶段**就实例化 Settings,
   113	          # 而 config.py:244-257 的 model_validator 规定 is_local = DEBUG and (CORS 含
   114	          # localhost/127.0.0.1); 非 local 时 NEO4J_PASSWORD 与 INTERNAL_API_KEY 双强制。
   115	          # 本地靠 backend/.env 满足 (该文件不入库), CI 拿不到 → exit 4。
   116	          # 这里提供等价的测试态配置, 与 conftest.py:323-329 的测试 Settings 口径一致。
   117	          # 刻意不设 NEO4J_ENABLED=false: is_local 为真时空密码只 warning 不 raise,
   118	          # 保持该开关默认值可避免改变任何测试的代码路径。
   119	          DEBUG: "true"
   120	          CORS_ORIGINS: "http://localhost:3000,http://127.0.0.1:3000"
   121	          INTERNAL_API_KEY: "ci-test-key-not-a-real-secret"
   122	        run: |
   123	          cd backend
   124	          python -m pytest \
   125	            tests/unit/test_kg_relevance_weighted.py \
   126	            tests/e2e/test_a11_kg_relevance_e2e.py \
   127	            tests/unit/test_mastery_injection_memory_contract.py \
   128	            tests/regression/test_board_manifest_contracts.py \
   129	            tests/regression/test_rag_stage1_index_contracts.py \
   130	            tests/regression/test_reference_config_fallback_contract.py \
   131	            tests/regression/test_snapshot_schema_migration_contract.py \
   132	            tests/regression/test_immutable_skip_dirs_contract.py \
   133	            tests/regression/test_vault_skip_files_scope_contract.py \
   134	            tests/regression/test_snapshot_v3_contract.py \
   135	            tests/regression/test_all_index_entrypoints_hostile_env.py \
   136	            tests/regression/test_tombstone_read_side_contract.py \
   137	            tests/regression/test_real_entrypoint_admission.py \
   138	            tests/regression/test_fsrs_golden_vectors.py \
   139	            tests/regression/test_learning_events_schema_contract.py \
   140	            tests/unit/test_vault_admission.py \
   141	            tests/unit/test_memory_service_contextvar_leak.py \
   142	            -m "not integration" \
   143	            -v --tb=short \
   144	            --junitxml=reports/test-results.xml \
   145	            -q --no-header \
   146	            -p no:cacheprovider \
   147	            --override-ini="addopts=" 2>&1
   148	
   149	      - name: Upload test results
   150	        if: always()
   151	        uses: actions/upload-artifact@v4
   152	        with:
   153	          name: test-results-py${{ matrix.python-version }}
   154	          path: backend/reports/test-results.xml
   155	          retention-days: 14
