    82	          python scripts/spec-tools/check-openapi-drift.py --snapshot backend/openapi.json
    83	
    84	  # ═══════════════════════════════════════════════════════════════════════════════
    85	  # Phase 2: 验证 OpenAPI 规范格式
    86	  # ═══════════════════════════════════════════════════════════════════════════════
    87	  validate-spec:
    88	    name: Validate OpenAPI Spec
    89	    runs-on: ubuntu-latest
    90	    needs: export-openapi
    91	    steps:
    92	      - uses: actions/checkout@v4
    93	
    94	      - name: Setup Node.js
    95	        uses: actions/setup-node@v4
    96	        with:
    97	          node-version: ${{ env.NODE_VERSION }}
    98	
    99	      - name: Download current spec
   100	        uses: actions/download-artifact@v4
   101	        with:
   102	          name: openapi-current
   103	
   104	      - name: Install Spectral
   105	        run: npm install -g @stoplight/spectral-cli
   106	
   107	      - name: Validate OpenAPI format
   108	        run: |
   109	          spectral lint openapi-current.json --format stylish || true
   110	          # 不强制失败，只报告问题
   111	
   112	      - name: Check for critical issues
   113	        run: |
