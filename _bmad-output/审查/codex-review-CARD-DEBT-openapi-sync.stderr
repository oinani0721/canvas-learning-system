   386	  # ═══════════════════════════════════════════════════════════════════════════════
   387	  # Phase 5(已删除): 自动提交 OpenAPI 规范文件
   388	  # ═══════════════════════════════════════════════════════════════════════════════
   389	  # 原 update-spec job 已删除 (CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批])。
   390	  # 它做的是: push main 时把导出结果 `mv` 成**仓库根**的规范文件再
   391	  # `git commit || true; git push || true`。三重失效叠在一起:
   392	  #   - 写的是从不存在的根路径, 与真实快照 backend/openapi.json 无关;
   393	  #   - `|| true` 把 commit 与 push 的失败一并吞掉, job 恒 success;
   394	  #   - 结果就是"恒绿却从未推上去": origin main 至今没有那个根级文件
   395	  #     (gh api contents 404, commits?path 为空)。
   396	  # 快照现在由三处保证新鲜, 不再需要 CI 代写:
   397	  #   1. lefthook pre-commit 的 spec-sync —— 改 API 即重生成并 stage;
   398	  #   2. 本 workflow 的 Snapshot drift gate —— 漂移就红, 逼人本地重生成;
   399	  #   3. 批次收官时在最终主干统一 `--write` 并单独 governance commit。
   400	  # ⚠️ 删除自动提交 job 属 CI/CD 变更, 按默认在车道落 commit 但**不 push**,
   401	  #    合并前须用户逐项批(验收单「待你裁决」)。
   402	
   403	  # ═══════════════════════════════════════════════════════════════════════════════
   404	  # Summary Job
   405	  # ═══════════════════════════════════════════════════════════════════════════════
   406	  summary:
   407	    name: Summary
   408	    runs-on: ubuntu-latest
   409	    needs: [export-openapi, validate-spec, detect-breaking-changes, contract-test]
   410	    if: always()
   411	    steps:
   412	      - name: Generate summary
   413	        run: |
   414	          echo "## API Specification Sync Summary" >> $GITHUB_STEP_SUMMARY
   415	          echo "" >> $GITHUB_STEP_SUMMARY
   416	
   417	          echo "| Check | Status |" >> $GITHUB_STEP_SUMMARY
   418	          echo "|-------|--------|" >> $GITHUB_STEP_SUMMARY
   419	
   420	          if [ "${{ needs.export-openapi.result }}" == "success" ]; then
   421	            echo "| Export + Snapshot Drift Gate | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   422	          else
   423	            echo "| Export + Snapshot Drift Gate | :x: backend/openapi.json 已漂移或导出失败 |" >> $GITHUB_STEP_SUMMARY
   424	          fi
   425	
   426	          if [ "${{ needs.validate-spec.result }}" == "success" ]; then
   427	            echo "| Validate Spec | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   428	          else
   429	            echo "| Validate Spec | :x: |" >> $GITHUB_STEP_SUMMARY
   430	          fi
   431	
   432	          if [ "${{ needs.detect-breaking-changes.outputs.has-breaking }}" == "true" ]; then
   433	            echo "| Breaking Changes | :warning: ${{ needs.detect-breaking-changes.outputs.breaking-count }} found |" >> $GITHUB_STEP_SUMMARY
   434	          else
   435	            echo "| Breaking Changes | :white_check_mark: None |" >> $GITHUB_STEP_SUMMARY
   436	          fi
   437	
   438	          if [ "${{ needs.contract-test.result }}" == "skipped" ]; then
   439	            echo "| Contract Tests (Dredd) | :heavy_minus_sign: 已停用 — 见 job 上方注释; 契约校验由 backend/tests/contract/test_openapi_contract.py (schemathesis) 承担 |" >> $GITHUB_STEP_SUMMARY
   440	          elif [ "${{ needs.contract-test.result }}" == "success" ]; then
   441	            echo "| Contract Tests (Dredd) | :white_check_mark: |" >> $GITHUB_STEP_SUMMARY
   442	          else
   443	            echo "| Contract Tests (Dredd) | :warning: |" >> $GITHUB_STEP_SUMMARY
   444	          fi

