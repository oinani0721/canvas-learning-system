   119	    # ═══════════════════════════════════════════════════════════════════════════
   120	
   121	    INTERNAL_API_KEY: str = Field(
   122	        default="",
   123	        description=(
   124	            "Device-scoped internal API key for backend sensitive endpoints "
   125	            "(currently /api/v1/sync/batch). Sent by the frontend Tauri app "
   126	            "via the X-CLS-Internal-Key header. Empty in production triggers "
   127	            "fail-closed 503; empty in DEBUG mode logs a warning and allows "
