   193	    # API Settings
   194	    # ═══════════════════════════════════════════════════════════════════════════
   195	
   196	    API_V1_PREFIX: str = Field(default="/api/v1", description="API version prefix path")
   197	
   198	    # ═══════════════════════════════════════════════════════════════════════════
   199	    # Field Validators
   200	    # ═══════════════════════════════════════════════════════════════════════════
   201	
   202	    @field_validator("API_V1_PREFIX")
   203	    @classmethod
   204	    def validate_api_prefix(cls, v: str) -> str:
   205	        """
   206	        Fix MSYS/Git Bash path conversion issue.
   207	
   208	        On Windows with Git Bash, paths starting with '/' get converted to
   209	        Windows paths (e.g., '/api/v1' becomes 'C:/Program Files/Git/api/v1').
   210	        This validator detects and corrects such conversions.
   211	
   212	        Args:
   213	            v: The API prefix value (possibly converted by MSYS)
   214	
   215	        Returns:
   216	            Corrected API prefix starting with '/'
   217	        """
   218	        if v.startswith("/"):
   219	            return v
   220	
   221	        # Detect MSYS path conversion - look for /api/ in the converted path
   222	        if "/api/" in v:
   223	            # Extract the API path portion
   224	            idx = v.find("/api/")
   225	            return v[idx:]
   226	
   227	        # Fallback: return default if path is completely invalid
   228	        return "/api/v1"
   229	
   230	    # ✅ Verified from Context7:/websites/pydantic_dev (topic: model_validator)
   231	    # [Source: docs/stories/21.5.2.story.md - AC-1, AC-2]
   232	    # [FIX] Changed from field_validator to model_validator to access AI_PROVIDER
   233	    @model_validator(mode="after")
   234	    def validate_model_name(self) -> "Settings":
   235	        """
   236	        检测并清理AI模型名称中的异常前缀（仅对非 custom provider）。
   237	
   238	        某些终端或配置工具可能会在模型名称前添加前缀（如 [K1], [K2]），
   239	        这会导致某些 API 调用失败。此验证器自动检测并清理这些前缀。
   240	
   241	        **重要**: 对于 custom provider，保留前缀，因为自定义 AI 服务商
   242	        可能使用这些前缀作为模型路由标识。
   243	
   244	        异常前缀示例: [K1], [K2], [TEST]
   245	
   246	        Returns:
   247	            修改后的 Settings 实例
   248	
   249	        [Source: docs/prd/EPIC-21.5-AGENT-RELIABILITY-FIX.md#story-21-5-2]
   250	        """
   251	        v = self.AI_MODEL_NAME
   252	
   253	        # [FIX] Skip prefix cleaning for custom providers - they may use prefixes
   254	        # for model routing (e.g., [K1] routes to a specific model channel)
   255	        if self.AI_PROVIDER == "custom":
   256	            if v.startswith("[") and "]" in v:
   257	                logger.info(f"AI_MODEL_NAME '{v}' contains prefix, preserved for custom provider")
   258	            return self
   259	
   260	        # 检测方括号前缀模式
   261	        if v.startswith("[") and "]" in v:
   262	            bracket_end = v.index("]") + 1
   263	            prefix = v[:bracket_end]
   264	            clean_name = v[bracket_end:]
   265	            logger.warning(f"AI_MODEL_NAME contains abnormal prefix '{prefix}', auto-cleaned to '{clean_name}'")
   266	            self.AI_MODEL_NAME = clean_name
   267	        return self
   268	
   269	    # ═══════════════════════════════════════════════════════════════════════════
   270	    # Round-23 Story 7.1 · Patch 1 — fail-closed 安全默认值校验
   271	    # [Source: _bmad-output/research/round-23-chatgpt-dr-result-and-synthesis-2026-05-08.md]
   272	    # ═══════════════════════════════════════════════════════════════════════════
   273	
   274	    @model_validator(mode="after")
   275	    def validate_security_defaults(self) -> "Settings":
   276	        """
   277	        Round-23 Patch 1: fail-closed 安全默认值校验。
   278	
   279	        生产环境（非 local dev）强制：
   280	        - NEO4J_PASSWORD 在 NEO4J_ENABLED=True 时必须显式设置
   281	        - INTERNAL_API_KEY 必须显式设置（敏感 endpoint 鉴权）
   282	
   283	        本地 dev（DEBUG=True + CORS 含 localhost）允许 warning + 放行。
   284	        防止容器开放端口意外暴露弱密码或无鉴权状态。
   285	        """
   286	        is_local = self.DEBUG and ("localhost" in self.CORS_ORIGINS or "127.0.0.1" in self.CORS_ORIGINS)
   287	
   288	        if self.NEO4J_ENABLED and not self.NEO4J_PASSWORD:
   289	            if not is_local:
   290	                raise ValueError(
   291	                    "NEO4J_PASSWORD must be set explicitly outside local dev. Set env var or disable NEO4J_ENABLED."
   292	                )
   293	            logger.warning("NEO4J_PASSWORD empty in DEBUG mode. Set before deploying.")
   294	
   295	        if not is_local and not self.INTERNAL_API_KEY:
   296	            raise ValueError(
   297	                "INTERNAL_API_KEY required outside local dev. Set env var or enable DEBUG with localhost CORS."
   298	            )
   299	
   300	        if "*" in self.CORS_ORIGINS:
   301	            logger.warning("CORS_ORIGINS contains wildcard '*'. Unsafe in production.")
   302	
   303	        return self
   304	
