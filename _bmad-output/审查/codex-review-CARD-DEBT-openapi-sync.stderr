    74	def test_committed_snapshot_has_no_drift(committed_snapshot, live_schema):
    75	    clean, details = drift.compare(committed_snapshot, live_schema)
    76	    assert clean, (
    77	        "backend/openapi.json 与 app.openapi() 已漂移。禁手改快照, 重生成:\n"
    78	        "  cd backend && .venv/bin/python ../scripts/spec-tools/check-openapi-drift.py "
    79	        "--write openapi.json\n差异前 20 条:\n" + "\n".join(details[:20])
    80	    )
