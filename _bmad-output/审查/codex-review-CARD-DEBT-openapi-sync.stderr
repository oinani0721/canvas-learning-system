   279	    # 若 untag 缺失/不完整, "openapi" 等标量字段会变成 ["string", "3.1.0"] 双元素数组
   280	    assert isinstance(spec.get("openapi"), str), "'openapi' 字段被标签污染"
   281	    assert isinstance(spec.get("info", {}).get("title"), str), "info.title 被标签污染"
   282	    assert isinstance(spec.get("info", {}).get("x-generated-at"), str)
