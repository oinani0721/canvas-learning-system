   285	
   286	
   287	def test_canonicalize_does_not_mutate_input():
   288	    """归一化不得就地改调用方的 spec(负控与门都依赖这一点)。"""
   289	    original = copy.deepcopy(BASE_SPEC)
   290	    drift.canonicalize(BASE_SPEC)
   291	    assert BASE_SPEC == original, "canonicalize 污染了入参"

