    21	def _patch_fastapi_mcp_anyof_bug() -> None:
    22	    """
    23	    Monkey-patch fastapi-mcp v0.4.0 to fix the anyOf + type schema conflict.
    24	
    25	    ROOT CAUSE (fastapi-mcp issue):
    26	    When a Pydantic model has ``Optional[str]`` fields, Pydantic generates JSON Schema
    27	    with ``anyOf: [{type: "string"}, {type: "null"}]`` and NO top-level ``type`` key.
    28	    fastapi-mcp ``convert_openapi_to_mcp_tools()`` sees the missing ``type`` and adds
    29	    ``type="string"`` (extracted from anyOf via ``get_single_param_type_from_schema``).
    30	    This creates an invalid schema with BOTH anyOf and type at the same level.
    31	
    32	    EFFECT:
    33	    The MCP client (Claude Code / Claude Desktop) uses Zod for schema validation.
    34	    Zod sees ``type="string"`` and requires a string value. When the AI omits optional
    35	    fields or sends null, Zod rejects with "expected string, received undefined".
    36	
    37	    FIX:
    38	    After the original conversion, strip the spurious ``type`` from any property that
    39	    already has ``anyOf``, ``oneOf``, or ``allOf`` composition keywords.
    40	    """
    41	    try:
    42	        import fastapi_mcp.openapi.convert as convert_module
    43	        import mcp.types as types
    44	
    45	        _original = convert_module.convert_openapi_to_mcp_tools
    46	
    47	        def _patched_convert(
    48	            openapi_schema: Dict[str, Any],
    49	            describe_all_responses: bool = False,
    50	            describe_full_response_schema: bool = False,
    51	        ) -> Tuple[List[types.Tool], Dict[str, Dict[str, Any]]]:
    52	            """Patched: call original, then strip spurious type from anyOf properties."""
    53	            tools, operation_map = _original(
    54	                openapi_schema,
    55	                describe_all_responses=describe_all_responses,
    56	                describe_full_response_schema=describe_full_response_schema,
    57	            )
    58	
    59	            composition_keywords = {"anyOf", "oneOf", "allOf"}
    60	            patched_count = 0
    61	
    62	            for tool in tools:
    63	                properties = tool.inputSchema.get("properties", {})
    64	                for _prop_name, prop_schema in properties.items():
    65	                    # If a property has both a composition keyword AND "type",
    66	                    # the "type" was spuriously added by fastapi-mcp. Remove it.
    67	                    if isinstance(prop_schema, dict) and "type" in prop_schema:
    68	                        if any(kw in prop_schema for kw in composition_keywords):
    69	                            del prop_schema["type"]
    70	                            patched_count += 1
    71	
    72	            if patched_count > 0:
    73	                logger.info(
    74	                    "[MCP] Stripped spurious 'type' from %d anyOf properties across %d tools",
    75	                    patched_count,
    76	                    len(tools),
    77	                )
    78	
    79	            return tools, operation_map
    80	
    81	        convert_module.convert_openapi_to_mcp_tools = _patched_convert
    82	
    83	        # Also patch the local reference in fastapi_mcp.server, because it uses
    84	        # `from fastapi_mcp.openapi.convert import convert_openapi_to_mcp_tools`
    85	        # which creates a bound local reference that wouldn't see our module-level patch.
    86	        import fastapi_mcp.server as server_module
    87	
    88	        server_module.convert_openapi_to_mcp_tools = _patched_convert
    89	        logger.info("[MCP] Patched fastapi-mcp anyOf+type schema conflict (v0.4.0 bug)")
    90	
    91	    except Exception as e:
    92	        logger.warning("[MCP] Failed to patch fastapi-mcp anyOf bug: %s", e)
