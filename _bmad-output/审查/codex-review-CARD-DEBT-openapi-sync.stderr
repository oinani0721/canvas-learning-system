     1	#!/usr/bin/env python3
     2	"""OpenAPI 快照漂移门 — CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批]
     3	
     4	替代 export-openapi.py 成为 `backend/openapi.json` 的唯一合法写入口(禁手改)。
     5	
     6	用法
     7	  --snapshot <path>  只读比对: committed 快照 vs 当前 app.openapi()(两侧同规则归一化)。
     8	                     无漂移 exit 0 打 `DRIFT: none (paths=N schemas=M)`;
     9	                     有漂移 exit 1 打路径级差异摘要。不落盘。
    10	  --write <path>     重生成快照并落盘。恒写(每次刷新 info.x-generated-at):
    11	                     lefthook 判据依赖「即使 API 面没变也重生成并 stage」这一可证行为,
    12	                     代价是触及 backend/app/{api,models,schemas} 的 commit 会带一行
    13	                     时间戳 diff(噪音已知, 由比对侧归一化吸收, 不会让门误红)。
    14	
    15	只 import 不起 lifespan(脚本内自证)
    16	  - 本脚本从不构造 TestClient、从不进入 app.router.lifespan_context;
    17	    生成 schema 只调 app.openapi()(纯内存, 不跑任何 ASGI 事件)。
    18	  - `from app.main import app` 与 app.openapi() 全程处于 socket-connect 禁闭
    19	    (socket.socket.connect 被换成抛错桩)。任何 lifespan 行为(连 Neo4j 7691/
    20	    LanceDB/graphiti 探活)都会在这里立即炸出来, 而不是静默连库。
    21	  - 禁闭本身不改变输出: 2026-08-31 本机实测「带禁闭」与「不带禁闭」两次导出
    22	    去掉易变键后**逐字节相同**(sha256 前 16 位同为 919d6b41fb870217)。
    23	    唯一被禁闭拦到的是 LiteLLM 拉远程 model cost map(它自带本地 fallback,
    24	    不进 schema)。
    25	
    26	归一化规则(--snapshot 对两侧同规则应用; --write 落盘的也是归一化结果 + 易变键,
    27	所以「快照里看到的」与「门拿去比的」是同一个东西)
    28	  1. 删除 info.x-generated-at / info.x-generator。只删 info 层这两个键——
    29	     2026-08-31 全树扫描实测: 这两个键在 app.openapi() 原生输出中**不存在**,
    30	     只由本脚本 --write 写入, 故不存在「删掉了生产真值」的可能。
    31	  2. dict 按 key 排序(JSON 对象成员无序, 排序只消除表示差异)。
    32	  3. 键名为 `required` 且值为**纯字符串数组** → sorted()。JSON Schema 的
    33	     required 是集合语义, 而 pydantic 按字段声明序生成它——2026-08-31 实测
    34	     281 个 required 数组中 144 个(51.2%)非字典序, 不排序会让一次无关的字段
    35	     重排把半数 schema 报成漂移(误红的门必然被 `|| true` 掉, 那正是本卡要修的病)。
    36	     用 sorted 而非 set: 重复项与数量差异仍会暴露, 不吞真漂移。
    37	     ⚠️ 同名 key 的另一种用法 `required: true`(Parameter Object, 实测 373 处)
    38	     是布尔标量, 走原样分支, 不受此规则影响。
    39	  4. 其余数组一律**保序**。enum 尤其不排序: 取值顺序有语义(文档展示序、
    40	     客户端代码生成器的枚举序), 实测 51 个 enum 中 42 个非字典序, 排了就是真吞漂移。
    41	     parameters / anyOf / tags / security 同理保序。
    42	  5. 标量按 JSON 类型严格比对: bool 与数字**不**相等(JSON 里 true 和 1 序列化
    43	     不同, 是真实契约变更; Python 的 True == 1 必须显式打破)。int 与 float
    44	     **有意**归并为同一 number 类型(JSON 只有一个数字类型, 1 与 1.0 语义相同,
    45	     吸收不算吞漂移)。字符串与 null 各自独立。
    46	
    47	本门证明什么: 归一化后 committed 快照与 app.openapi() 逐键逐值相等。
    48	本门不证明什么: 不验证 schema 语义正确性、不验证实现与 spec 一致(那是 schemathesis
    49	  的 tests/contract/test_openapi_contract.py 在做)、不验证跨机器/跨 Python 版本的
    50	  确定性(本机 3.14 三次连 key 序都逐字节相同, 但 CI 用 3.11, 未跨版本实测)。
    51	  上述五条归一化之外的任何差异(path/schema 增删、enum 取值与顺序、required 集合
    52	  内容、bool↔数字翻转、任意键值变化)都原样报为漂移。
    53	"""
    54	
    55	import argparse
    56	import contextlib
    57	import copy
    58	import json
    59	import socket
    60	import sys
    61	from datetime import datetime, timezone
    62	from pathlib import Path
    63	
    64	REPO_ROOT = Path(__file__).resolve().parent.parent.parent
    65	BACKEND_DIR = REPO_ROOT / "backend"
    66	
    67	VOLATILE_INFO_KEYS = ("x-generated-at", "x-generator")
    68	X_GENERATOR_NAME = "scripts/spec-tools/check-openapi-drift.py --write"
    69	DETAIL_LINE_CAP = 50
    70	
    71	
    72	@contextlib.contextmanager
    73	def socket_connect_lockdown():
    74	    """import app.main + app.openapi() 期间禁一切 socket connect(lifespan 自证)。"""
    75	    real_connect = socket.socket.connect
    76	
    77	    def _blocked_connect(self, address, *args, **kwargs):
    78	        raise RuntimeError(
    79	            f"socket connect blocked during OpenAPI export (target={address!r}) — "
    80	            "check-openapi-drift.py 只允许 import, 不允许 lifespan/网络行为"
    81	        )
    82	
    83	    socket.socket.connect = _blocked_connect
    84	    try:
    85	        yield
    86	    finally:
    87	        socket.socket.connect = real_connect
    88	
    89	
    90	def load_live_schema() -> dict:
    91	    """import app.main(不起 lifespan)并取 app.openapi(), 全程 socket 禁闭。"""
    92	    if str(BACKEND_DIR) not in sys.path:
    93	        sys.path.insert(0, str(BACKEND_DIR))
    94	    with socket_connect_lockdown():
    95	        from app.main import app  # noqa: PLC0415 — 延迟 import 是本脚本的自证边界
    96	
    97	        schema = app.openapi()
    98	    # json 往返: 把 FastAPI 返回的 python 对象钉成纯 JSON 类型, 与快照侧同构
    99	    return json.loads(json.dumps(schema, ensure_ascii=False))
   100	
   101	
   102	def _tag_leaf(value):
   103	    """标量打 JSON 类型标签(归一化规则 5)。
   104	
   105	    bool 必须先于 int 判(isinstance(bool, int) 为真); int/float 同归 "number"
   106	    是**有意**的(JSON 单一数字类型), 除此之外不同标签永不相等。
   107	    """
   108	    if isinstance(value, bool):
   109	        return ("boolean", value)
   110	    if isinstance(value, (int, float)):
   111	        return ("number", value)
   112	    if isinstance(value, str):
   113	        return ("string", value)
   114	    if value is None:
   115	        return ("null", None)
   116	    return ("raw", value)
   117	
   118	
   119	def _normalize(node, parent_key):
   120	    if isinstance(node, dict):
   121	        return {key: _normalize(node[key], key) for key in sorted(node)}
   122	    if isinstance(node, list):
   123	        if parent_key == "required" and all(isinstance(item, str) for item in node):
   124	            return sorted(node)
   125	        return [_normalize(item, None) for item in node]
   126	    return _tag_leaf(node)
   127	
   128	
   129	def canonicalize(spec: dict) -> dict:
   130	    """按模块 docstring 的五条规则归一化。入参不被修改。"""
   131	    spec = copy.deepcopy(spec)
   132	    info = spec.get("info")
   133	    if isinstance(info, dict):
   134	        for key in VOLATILE_INFO_KEYS:
   135	            info.pop(key, None)
   136	    return _normalize(spec, parent_key=None)
   137	
   138	
   139	def _untag(node):
   140	    """把归一化树的标签叶子剥回原始值(供 --write 序列化)。
   141	
   142	    输入若来自 json.loads / load_live_schema, 树中的 tuple 只可能是本模块打的
   143	    类型标签(JSON 不产生 tuple), 故剥标签无歧义。
   144	    """
   145	    if isinstance(node, dict):
   146	        return {key: _untag(value) for key, value in node.items()}
   147	    if isinstance(node, list):
   148	        return [_untag(value) for value in node]
   149	    if isinstance(node, tuple) and len(node) == 2:
   150	        return node[1]
   151	    return node
   152	
   153	
   154	def _display(value) -> str:
   155	    """归一化后的值转回人话: 标签元组展示为 `值(类型)`, 容器展示 JSON 类型名。"""
   156	    if isinstance(value, tuple) and len(value) == 2:
   157	        return f"{value[1]!r}({value[0]})"
   158	    if isinstance(value, dict):
   159	        return "object"
   160	    if isinstance(value, list):
   161	        return "array"
   162	    return repr(value)
   163	
   164	
   165	def diff_nodes(snap, live, pointer, out):
   166	    """收集归一化后两树的**全部**差异(不截断, 截断只发生在展示层); 子树整体
   167	    缺失只报最高层, 不下钻刷屏。"""
   168	    if type(snap) is not type(live):
   169	        out.append(
   170	            f"{pointer}: 类型不同 snapshot={_display(snap)} live={_display(live)}"
   171	        )
   172	        return
   173	    if isinstance(snap, dict):
   174	        for key in sorted(snap.keys() | live.keys()):
   175	            child = f"{pointer}>{key}"
   176	            if key not in live:
   177	                out.append(f"{child}: 仅在 snapshot(已从 app 移除)")
   178	            elif key not in snap:
   179	                out.append(f"{child}: 仅在 app.openapi()(snapshot 缺失)")
   180	            else:
   181	                diff_nodes(snap[key], live[key], child, out)
   182	        return
   183	    if isinstance(snap, list):
   184	        if len(snap) != len(live):
   185	            out.append(f"{pointer}: 数组长度 snapshot={len(snap)} live={len(live)}")
   186	        for index, (item_a, item_b) in enumerate(zip(snap, live)):
   187	            diff_nodes(item_a, item_b, f"{pointer}[{index}]", out)
   188	        return
   189	    if snap != live:
   190	        out.append(f"{pointer}: snapshot={_display(snap)} live={_display(live)}")
   191	
   192	
   193	def _key_set(spec: dict, *path) -> set:
   194	    node = spec
   195	    for part in path:
   196	        node = node.get(part, {}) if isinstance(node, dict) else {}
   197	    return set(node) if isinstance(node, dict) else set()
   198	
   199	
   200	def compare(snapshot: dict, live: dict) -> tuple[bool, list[str]]:
   201	    """归一化后比对。返回 (无漂移, 全部差异摘要行)。供本地门测试直接调用。"""
   202	    snap_canon = canonicalize(snapshot)
   203	    live_canon = canonicalize(live)
   204	    if snap_canon == live_canon:
   205	        return True, []
   206	    details: list[str] = []
   207	    diff_nodes(snap_canon, live_canon, "", details)
   208	    return False, details
   209	
   210	
   211	def check_drift(snapshot_path: Path) -> int:
   212	    if not snapshot_path.is_file():
   213	        print(f"ERROR: snapshot 不存在: {snapshot_path}", file=sys.stderr)
   214	        return 2
   215	    try:
   216	        snapshot = json.loads(snapshot_path.read_text(encoding="utf-8"))
   217	    except (OSError, json.JSONDecodeError) as exc:
   218	        print(f"ERROR: snapshot 读取/解析失败: {exc}", file=sys.stderr)
   219	        return 2
   220	
   221	    live = load_live_schema()
   222	    clean, details = compare(snapshot, live)
   223	
   224	    if clean:
   225	        paths = len(live.get("paths", {}))
   226	        schemas = len(live.get("components", {}).get("schemas", {}))
   227	        print(f"DRIFT: none (paths={paths} schemas={schemas})")
   228	        return 0
   229	
   230	    snap_canon, live_canon = canonicalize(snapshot), canonicalize(live)
   231	    snap_paths, live_paths = (
   232	        _key_set(snap_canon, "paths"),
   233	        _key_set(live_canon, "paths"),
   234	    )
   235	    snap_schemas = _key_set(snap_canon, "components", "schemas")
   236	    live_schemas = _key_set(live_canon, "components", "schemas")
   237	    truncated = len(details) > DETAIL_LINE_CAP
   238	    print(
   239	        f"DRIFT: found (paths: +{len(live_paths - snap_paths)} -{len(snap_paths - live_paths)}, "
   240	        f"schemas: +{len(live_schemas - snap_schemas)} -{len(snap_schemas - live_schemas)}, "
   241	        f"diff lines: {len(details)}{'+' if truncated else ''})"
   242	    )
   243	    for line in details[:DETAIL_LINE_CAP]:
   244	        print(f"  {line}")
   245	    if truncated:
   246	        print(
   247	            f"  ... 以及更多差异(仅显示前 {DETAIL_LINE_CAP} 条, 共 {len(details)} 条)"
   248	        )
   249	    print(
   250	        "FIX: python scripts/spec-tools/check-openapi-drift.py --write backend/openapi.json"
   251	        "  (禁手改快照)",
   252	        file=sys.stderr,
   253	    )
   254	    return 1
   255	
   256	
   257	def write_snapshot(output_path: Path) -> int:
   258	    """归一化 + 易变键后落盘。恒写(见模块 docstring --write 段)。"""
   259	    schema = _untag(canonicalize(load_live_schema()))
   260	    info = dict(schema.get("info", {}))
   261	    info["x-generated-at"] = datetime.now(timezone.utc).isoformat()
   262	    info["x-generator"] = X_GENERATOR_NAME
   263	    schema["info"] = {key: info[key] for key in sorted(info)}
   264	    output_path.parent.mkdir(parents=True, exist_ok=True)
   265	    output_path.write_text(
   266	        json.dumps(schema, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
   267	    )
   268	    paths = len(schema.get("paths", {}))
   269	    schemas = len(schema.get("components", {}).get("schemas", {}))
   270	    print(
   271	        f"WROTE: {output_path} (paths={paths} schemas={schemas}, "
   272	        f"x-generated-at={info['x-generated-at']})"
   273	    )
   274	    return 0
   275	
   276	
   277	def main() -> int:
   278	    parser = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
   279	    mode = parser.add_mutually_exclusive_group(required=True)
   280	    mode.add_argument(
   281	        "--snapshot", metavar="PATH", help="只读比对该快照与 app.openapi()"
   282	    )
   283	    mode.add_argument(
   284	        "--write", metavar="PATH", help="重生成快照并写入该路径(唯一合法落盘口)"
   285	    )
   286	    args = parser.parse_args()
   287	
   288	    if args.snapshot:
   289	        return check_drift(Path(args.snapshot))
   290	    return write_snapshot(Path(args.write))
   291	
   292	
   293	if __name__ == "__main__":
   294	    sys.exit(main())

