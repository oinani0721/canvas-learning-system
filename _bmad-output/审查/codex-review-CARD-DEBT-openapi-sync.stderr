   133	
   134	def test_volatile_keys_are_absorbed():
   135	    """规则 1: info.x-generated-at / x-generator 差异不算漂移(防门恒红)。"""
   136	    other = _mutated(
   137	        lambda s: s["info"].update({"x-generated-at": "1999-01-01T00:00:00+00:00", "x-generator": "whatever"})
   138	    )
   139	    clean, _ = drift.compare(other, BASE_SPEC)
   140	    assert clean, "只差易变键不应报漂移"
   141	
   142	
   143	def test_dict_key_order_is_absorbed():
   144	    """规则 2: 对象成员顺序无语义, 不算漂移。"""
   145	    reordered = {
   146	        "components": BASE_SPEC["components"],
   147	        "paths": BASE_SPEC["paths"],
   148	        "info": BASE_SPEC["info"],
   149	        "openapi": BASE_SPEC["openapi"],
   150	    }
   151	    clean, _ = drift.compare(reordered, BASE_SPEC)
   152	    assert clean, "仅 key 顺序不同不应报漂移"
   153	
   154	
   155	def test_required_order_is_absorbed():
   156	    """规则 3: required 是集合语义 — 顺序变化不算漂移。"""
   157	    other = _mutated(lambda s: s["components"]["schemas"]["S"].update({"required": ["alpha", "beta"]}))
   158	    clean, _ = drift.compare(other, BASE_SPEC)
   159	    assert clean, "required 顺序变化不应报漂移(pydantic 按字段声明序生成)"
   160	
   161	
   162	def test_required_membership_change_is_drift():
   163	    """规则 3 的反面: required 集合**内容**变化必须暴露。"""
   164	    other = _mutated(lambda s: s["components"]["schemas"]["S"].update({"required": ["alpha"]}))
   165	    clean, details = drift.compare(other, BASE_SPEC)
   166	    assert not clean, "required 少一个字段必须报漂移"
   167	    assert any("S" in line and "required" in line for line in details), details
   168	
   169	
   170	def test_required_duplicate_is_drift():
   171	    """sorted 而非 set: 重复项不被吞。"""
