     1	# Canvas Learning System - API Specification Sync Pipeline
     2	# 规范文档自动化同步检查
     3	#
     4	# 触发条件: OpenAPI 规范或 API 代码变更时
     5	# 功能:
     6	#   1. 快照漂移门: committed backend/openapi.json 必须与 app.openapi() 一致(漂移=红)
     7	#   2. 验证 OpenAPI 规范格式
     8	#   3. 检测破坏性变更 (oasdiff)
     9	#   4. 生成差异报告
    10	#
    11	# ⚠️ CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批] 修正的假门:
    12	#   本文件此前三处 `if [ -f ... ]` 存在性判断查的是**仓库根**下的规范文件, 而
    13	#   仓库根从来没有这个文件(`git log --all` 对该路径为空) —— 三处恒走 else 分支,
    14	#   "spec changed" 恒为 true, breaking-change 基线恒退化为 `{}`。真实快照一直在
    15	#   `backend/openapi.json`。同时 update-spec job 用 `git push || true` 吞掉失败,
    16	#   job 恒绿却从未推上去任何东西(origin main 上该根级文件至今 404)。
    17	#   现改为: 全部路径指向 backend/openapi.json, 且漂移直接让 job 变红。
    18	
    19	name: API Specification Sync
    20	
    21	on:
    22	  pull_request:
    23	    paths:
    24	      - 'backend/app/api/**'
    25	      - 'backend/app/models/**'
    26	      - 'specs/api/**'
    27	      - 'backend/openapi.json'
    28	  push:
    29	    branches:
    30	      - main
    31	      - clean-release
    32	    paths:
    33	      - 'backend/app/api/**'
    34	      - 'backend/app/models/**'
    35	
    36	env:
    37	  PYTHON_VERSION: '3.11'
    38	  NODE_VERSION: '20'
    39	
    40	jobs:
    41	  # ═══════════════════════════════════════════════════════════════════════════════
    42	  # Phase 1: 导出当前 OpenAPI 规范
    43	  # ═══════════════════════════════════════════════════════════════════════════════
    44	  export-openapi:
    45	    name: Export OpenAPI Spec
    46	    runs-on: ubuntu-latest
    47	    steps:
    48	      - uses: actions/checkout@v4
    49	        with:
    50	          fetch-depth: 0
    51	
    52	      - name: Set up Python
    53	        uses: actions/setup-python@v5
    54	        with:
    55	          python-version: ${{ env.PYTHON_VERSION }}
    56	          cache: 'pip'
    57	
    58	      - name: Install dependencies
    59	        run: |
    60	          cd backend
    61	          pip install -r requirements.txt
    62	
    63	      # 产物与 committed 快照同构(同一脚本、同一归一化), 供下游 job 消费。
    64	      - name: Export OpenAPI spec from FastAPI
    65	        run: |
    66	          python scripts/spec-tools/check-openapi-drift.py --write openapi-current.json
    67	
    68	      - name: Upload OpenAPI spec
    69	        uses: actions/upload-artifact@v4
    70	        with:
    71	          name: openapi-current
    72	          path: openapi-current.json
    73	          retention-days: 7
    74	
    75	      # ⛔ 漂移门: committed 快照与 app.openapi() 归一化后必须相等, 否则 job 红。
    76	      # 归一化只吸收 info.x-generated-at/x-generator、对象成员顺序、required 集合
