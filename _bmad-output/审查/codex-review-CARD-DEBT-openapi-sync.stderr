 succeeded in 0ms:
     1	# Canvas Learning System - API Specification Sync Pipeline
     2	# 规范文档自动化同步检查
     3	#
     4	# 触发条件: OpenAPI 规范或 API 代码变更时
     5	# 功能:
     6	#   1. 快照漂移门: committed backend/openapi.json 必须与 app.openapi() 一致(漂移=红)
     7	#   2. 验证 OpenAPI 规范格式
     8	#   3. 检测破坏性变更 (oasdiff)
     9	#   4. 生成差异报告
    10	#
    11	# ⚠️ CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批] 修正的假门:
    12	#   本文件此前三处 `if [ -f ... ]` 存在性判断查的是**仓库根**下的规范文件, 而
    13	#   仓库根从来没有这个文件(`git log --all` 对该路径为空) —— 三处恒走 else 分支,
    14	#   "spec changed" 恒为 true, breaking-change 基线恒退化为 `{}`。真实快照一直在
    15	#   `backend/openapi.json`。同时 update-spec job 用 `git push || true` 吞掉失败,
    16	#   job 恒绿却从未推上去任何东西(origin main 上该根级文件至今 404)。
    17	#   现改为: 全部路径指向 backend/openapi.json, 且漂移直接让 job 变红。
    18	
    19	name: API Specification Sync
    20	
    21	on:
    22	  pull_request:
    23	    paths:
    24	      - 'backend/app/api/**'
    25	      - 'backend/app/models/**'
    26	      - 'specs/api/**'
    27	      - 'backend/openapi.json'
    28	  push:
    29	    branches:
    30	      - main
    31	      - clean-release
    32	    paths:
    33	      - 'backend/app/api/**'
    34	      - 'backend/app/models/**'
    35	
    36	env:
    37	  PYTHON_VERSION: '3.11'
    38	  NODE_VERSION: '20'
    39	
    40	jobs:
    41	  # ═══════════════════════════════════════════════════════════════════════════════
    42	  # Phase 1: 导出当前 OpenAPI 规范
    43	  # ═══════════════════════════════════════════════════════════════════════════════
    44	  export-openapi:
    45	    name: Export OpenAPI Spec
    14	# Pre-commit: Parallel checks on staged files
    15	# ============================================================
    16	pre-commit:
    17	  parallel: true
    18	  commands:
    19	    # --- Spec Sync: Regenerate OpenAPI snapshot when backend API files change ---
    20	    # CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批] 把这个 hook 从"死了 4 个月
    21	    # 没人发现"改成"会出声"。原写法三处同时失效, 任何一处都足以让它静默空转:
    22	    #   1. 解析器是裸 `python` —— 本机与 CI 上都不是本仓 venv(甚至可能不存在),
    23	    #      对照同文件 readme-claims-lint 一直用 backend/.venv/bin/python;
    24	    #   2. `2>/dev/null` 把导出失败整个吞掉, 于是失败与成功外观完全相同;
    25	    #   3. 导出脚本默认落到 backend/openapi.json, 而这里 `[ -f openapi.json ]`
    26	    #      查的是**仓库根** —— 那个文件在本仓全部历史中都不存在, 所以永远
    27	    #      走不到 git add。快照 mtime 因此停在 5 月 3 日。
    28	    # 现在: venv 解析器 + 失败 exit 1 阻断 commit + 直接写并 stage backend 下的快照。
    29	    # 代价(已知): 每次改 backend/app/{api,models,schemas} 的 commit 会多花约 20s
    30	    # 导入 app.main 重生成快照, 且快照因 x-generated-at 恒变而必然出现在 diff 里。
    31	    spec-sync:
    32	      glob: "backend/app/{api,models,schemas}/**/*.py"
    33	      run: |
    34	        if [ -f "backend/.venv/bin/python" ]; then PY="backend/.venv/bin/python"; else PY="python3"; fi
