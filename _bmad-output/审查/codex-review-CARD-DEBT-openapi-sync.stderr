    83	def test_snapshot_carries_generator_provenance(committed_snapshot):
    84	    """快照必须由本脚本 --write 产出(禁手改的可核对痕迹)。"""
    85	    info = committed_snapshot.get("info", {})
    86	    assert info.get("x-generator") == drift.X_GENERATOR_NAME, (
    87	        f"x-generator={info.get('x-generator')!r} — 快照应由 check-openapi-drift.py "
    88	        "--write 生成; 手改或旧 export-openapi.py 产物不合规"
    89	    )
    90	    assert info.get("x-generated-at"), "快照缺 x-generated-at"
