    77	class Settings(BaseSettings):
    78	    """
    79	    Application settings loaded from environment variables.
    80	
    81	    ✅ Verified from Context7:/websites/fastapi_tiangolo (topic: settings BaseSettings)
    82	    Pattern: Pydantic v2 BaseSettings with model_config for .env file loading.
    83	
    84	    Attributes:
    85	        PROJECT_NAME: Application name displayed in API responses
    86	        PROJECT_DESCRIPTION: Application description for documentation
    87	        VERSION: Application version (semver format)
    88	        DEBUG: Enable debug mode (Swagger/ReDoc docs, detailed errors)
    89	        LOG_LEVEL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
    90	        CORS_ORIGINS: Allowed CORS origins as comma-separated string
