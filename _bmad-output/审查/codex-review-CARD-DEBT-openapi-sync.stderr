    39	def _load_drift_module():
    40	    """加载文件名带连字符的脚本(不能走普通 import)。"""
    41	    spec = importlib.util.spec_from_file_location("_check_openapi_drift", DRIFT_TOOL)
    42	    if spec is None or spec.loader is None:  # pragma: no cover — 路径错时立即失败
    43	        raise RuntimeError(f"无法加载 {DRIFT_TOOL}")
    44	    module = importlib.util.module_from_spec(spec)
    45	    previous = sys.dont_write_bytecode
    46	    sys.dont_write_bytecode = True  # 不往 scripts/spec-tools/ 落 __pycache__
    47	    try:
    48	        spec.loader.exec_module(module)
    49	    finally:
    50	        sys.dont_write_bytecode = previous
    51	    return module
    52	
    53	
    54	drift = _load_drift_module()
    55	
    56	
