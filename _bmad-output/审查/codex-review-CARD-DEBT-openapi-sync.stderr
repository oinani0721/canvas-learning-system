     1	# Canvas Learning System - Lefthook Configuration
     2	# Replaces hand-written .git/hooks/{pre-commit,post-commit,pre-push}
     3	#
     4	# Install: npx lefthook install
     5	# Test:    npx lefthook run pre-commit
     6	#
     7	# Architecture:
     8	#   pre-commit  → parallel checks (spec-sync, python-lint, python-typecheck, ghost-files)
     9	#   commit-msg  → commitlint + spec-reference
    10	#   post-commit → backup-push
    11	#   pre-push    → frontend-test + backend-smoke
    12	
    13	# ============================================================
    14	# Pre-commit: Parallel checks on staged files
    15	# ============================================================
    16	pre-commit:
    17	  parallel: true
    18	  commands:
    19	    # --- Spec Sync: Regenerate OpenAPI snapshot when backend API files change ---
    20	    # CARD-DEBT-openapi-sync [BATCH-2026-09-01-第八批] 把这个 hook 从"死了 4 个月
    21	    # 没人发现"改成"会出声"。原写法三处同时失效, 任何一处都足以让它静默空转:
    22	    #   1. 解析器是裸 `python` —— 本机与 CI 上都不是本仓 venv(甚至可能不存在),
    23	    #      对照同文件 readme-claims-lint 一直用 backend/.venv/bin/python;
    24	    #   2. `2>/dev/null` 把导出失败整个吞掉, 于是失败与成功外观完全相同;
    25	    #   3. 导出脚本默认落到 backend/openapi.json, 而这里 `[ -f openapi.json ]`
    26	    #      查的是**仓库根** —— 那个文件在本仓全部历史中都不存在, 所以永远
    27	    #      走不到 git add。快照 mtime 因此停在 5 月 3 日。
    28	    # 现在: venv 解析器 + 失败 exit 1 阻断 commit + 直接写并 stage backend 下的快照。
    29	    # 代价(已知): 每次改 backend/app/{api,models,schemas} 的 commit 会多花约 20s
    30	    # 导入 app.main 重生成快照, 且快照因 x-generated-at 恒变而必然出现在 diff 里。
    31	    spec-sync:
    32	      glob: "backend/app/{api,models,schemas}/**/*.py"
    33	      run: |
    34	        if [ -f "backend/.venv/bin/python" ]; then PY="backend/.venv/bin/python"; else PY="python3"; fi
    35	        echo "[Spec Sync] API changes detected, regenerating backend/openapi.json (via $PY)..."
    36	        if ! "$PY" scripts/spec-tools/check-openapi-drift.py --write backend/openapi.json; then
    37	          echo "[Spec Sync] FAILED — 快照未能重生成, 先修好再 commit(禁手改快照)。"
    38	          exit 1
    39	        fi
    40	        git add backend/openapi.json
    41	        echo "[Spec Sync] + backend/openapi.json staged"
    42	        if [ -d specs/data/generated ]; then
    43	          for schema in specs/data/generated/*.schema.json; do
    44	            if [ -f "$schema" ] && ! git diff --quiet "$schema" 2>/dev/null; then
    45	              git add "$schema"
    46	              echo "[Spec Sync] + $(basename $schema) added to commit"
    47	            fi
    48	          done
    49	        fi
    50	        echo "[Spec Sync] Done."
    51	
    52	    # --- Ghost Files: Detect untracked documentation ---
    53	    ghost-files:
    54	      run: |
    55	        GHOST_STORIES=$(git ls-files --others --exclude-standard -- "docs/stories/" 2>/dev/null || true)
    56	        GHOST_EPICS=$(git ls-files --others --exclude-standard -- "docs/epics/" 2>/dev/null || true)
    57	        GHOSTS=""
    58	        if [ -n "$GHOST_STORIES" ]; then GHOSTS="$GHOST_STORIES"; fi
    59	        if [ -n "$GHOST_EPICS" ]; then
    60	          if [ -n "$GHOSTS" ]; then GHOSTS="$GHOSTS
    61	        $GHOST_EPICS"; else GHOSTS="$GHOST_EPICS"; fi
    62	        fi
    63	        if [ -n "$GHOSTS" ]; then
    64	          COUNT=$(echo "$GHOSTS" | wc -l | tr -d ' ')
    65	          echo "[Ghost Files] WARNING: $COUNT untracked doc file(s):"
    66	          echo "$GHOSTS"
    67	          echo "[Ghost Files] To track: git add <file>"
    68	        else
    69	          echo "[Ghost Files] No untracked docs found."
    70	        fi
    71	          # presence of the allow-decorator anywhere in the file (file-level escape hatch).
    72	          BAD_LINES=$(echo "$ADDED_LINES" | grep -v 'group_id' || true)
    73	          if [ -n "$BAD_LINES" ] && [ "$FILE_HAS_ALLOW" -eq 0 ]; then
    74	            VIOLATIONS="${VIOLATIONS}${f}:
    75	        ${BAD_LINES}
    76	        "
    77	          fi
    78	        done
    79	        if [ -n "$VIOLATIONS" ]; then
    80	          echo ""
    81	          echo "[Cypher-Lint] ❌ Raw cypher without group_id filter in staged diff:"
    82	          echo "$VIOLATIONS"
    83	          echo "[Cypher-Lint] Fix one of:"
    84	          echo "  1. Use cypher_with_group_filter() from app.utils.cypher_helpers"
    85	          echo "  2. Mark the function with @allow_cross_vault(reason='...') if intentional"
    86	          echo "[Cypher-Lint] See backend/app/utils/cypher_helpers.py for backlog + rationale."
    87	          exit 1
    88	        fi
    89	        echo "[Cypher-Lint] OK (no new raw cypher without group_id)."
    90	
    91	    # --- README claims lint (CARD-G1-5, BATCH-2026-08-27-第四批) ---
    92	    # 仿 cypher-vault-filter-lint 的 staged-diff 模式: 只扫 staged **新增行**。
    93	    # 存量失实文案不阻断 commit (G1-4 诚实横幅先行, 防同波自打架);
