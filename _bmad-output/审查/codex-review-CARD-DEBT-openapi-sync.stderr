   220	def test_description_change_is_drift():
   221	    """归一化四条之外的一切差异原样暴露 — 连文案都算。"""
   222	    other = _mutated(lambda s: s["paths"]["/a"]["get"]["responses"]["200"].update({"description": "changed"}))
