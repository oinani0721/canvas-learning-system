   403	        return None, str(_e)
   404	    try:
   405	        _out = json.loads(_r.stdout) if _r.stdout.strip() else {}
   406	    except ValueError:
   407	        _out = {}
   408	    if _r.returncode == 2:
   409	        raise SystemExit(f"[quiz-answer] bridge 拒绝输入 (fail-closed): {_out.get('error') or _r.stderr[:200]}")
