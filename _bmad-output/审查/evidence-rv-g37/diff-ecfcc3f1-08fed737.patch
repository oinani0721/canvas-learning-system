+            (nodes_dir / f"{cid}.md").read_text(encoding="utf-8")
+            pytest.skip("当前用户可无视目录 chmod 000，无法构造不可见目录")
+        except OSError:
+            pass
+
+        fm = _read_frontmatter_fsrs(cid)
