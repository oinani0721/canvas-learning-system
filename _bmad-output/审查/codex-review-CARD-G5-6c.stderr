   449	def compute_inbox_stable_id(rel_path: str) -> str:
   450	    """收件箱条目身份键 = f(路径)。改内容/改 mtime 不换 ID；改名/移动才换。
   451	
   452	    编码纪律复用 `split_preview.compute_stable_id`（长度前缀载荷，对任意字节单射），
   453	    命名空间经 heading-path 槽位注入，返回值改挂自有前缀 —— 见文件头「身份空间
   454	    不可互换」。**不**把 mtime/size/内容进键：那样一改正文就换身份，diff 无意义。
   455	    """
   456	    raw = _SP.compute_stable_id(rel_path, [INBOX_ID_NAMESPACE], 1, INBOX_ID_BASIS)
   457	    return INBOX_ID_PREFIX + raw[len(_SP.STABLE_ID_PREFIX) :]
