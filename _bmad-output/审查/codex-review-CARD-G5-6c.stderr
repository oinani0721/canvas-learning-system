  1569	def build_preview(
  1570	    vault: Path,
  1571	    inbox: Path,
  1572	    inbox_exists: bool,
  1573	    now: datetime,
  1574	    batch_size: int,
  1575	    excluded_roots: list[str],
  1576	) -> dict:
  1577	    now_s = _epoch_s(now)
  1578	    items_raw, skipped = list_inbox(inbox, now_s) if inbox_exists else ([], [])
  1579	    total = len(items_raw)
  1580	    batch_raw = items_raw[:batch_size]
  1581	    deferred = [
  1582	        {
  1583	            "name": it["name"],
  1584	            "age_days": it["age_days"],
  1585	            "mtime_local": it["mtime_local"],
  1586	        }
  1587	        for it in items_raw[batch_size:]
  1588	    ]
  1589	
  1590	    dup_index, corpus_bodies, corpus_stats = scan_corpus(vault, excluded_roots)
  1591	    scan = {
  1592	        "ratio_threshold": NEAR_DUP_RATIO,
  1593	        "body_char_cap": NEAR_DUP_BODY_CHAR_CAP,
  1594	        "length_prefilter_ratio": NEAR_DUP_LEN_RATIO,
  1595	        "top_n_reported": NEAR_DUP_TOP_N,
  1596	        "compared_pairs": 0,
  1597	        "skipped_oversize": 0,
  1598	        "skipped_length_prefilter": 0,
  1599	        "note": "「跳过」≠「无重复」：跳过的对从未比对过，产物如实分列两个计数。",
  1600	    }
  1601	
  1602	    texts = {it["rel_path"]: read_text_or_none(Path(it["_path"])) for it in batch_raw}
  1603	    batch_body_counts: dict[str, int] = {}
  1604	    for it in batch_raw:
  1605	        t = texts[it["rel_path"]]
  1606	        if t is None:
  1607	            continue
  1608	        b = dup_body(t) if has_substantive_content(t) else ""
  1609	        if b:
  1610	            batch_body_counts[b] = batch_body_counts.get(b, 0) + 1
  1611	
  1612	    items: list[dict] = []
  1613	    for idx, it in enumerate(batch_raw, start=1):
  1614	        text = texts[it["rel_path"]]
  1615	        base = {k: v for k, v in it.items() if not k.startswith("_")}
  1616	        base["index"] = idx
  1617	        base["text_readable"] = text is not None
  1618	        items.append(
  1619	            nominate(base, text, dup_index, corpus_bodies, scan, batch_body_counts)
  1620	        )
  1621	
  1622	    data = {
  1623	        "schema_version": SCHEMA_VERSION,
  1624	        "generator": GENERATOR,
  1625	        "id_namespace": INBOX_ID_NAMESPACE,
  1626	        "id_stability": ID_STABILITY,
  1627	        "vault_fingerprint": "vf1-"
  1628	        + hashlib.sha256(os.path.realpath(vault).encode("utf-8")).hexdigest()[:16],
  1629	        "now": now.isoformat(),
  1630	        "now_utc": fmt_utc(now_s),
  1631	        "now_local": fmt_local(now_s),
  1632	        "inbox_dir": f"{inbox.name}/",
  1633	        "inbox_exists": inbox_exists,
  1634	        "label": inbox.name,
  1635	        "criteria_order": list(CRITERIA_ORDER),
  1636	        "verdict_vocabulary": VERDICT_VOCABULARY,
  1637	        "corpus": corpus_stats,
  1638	        "inventory": {
  1639	            "total": total,
  1640	            "batch_size": batch_size,
  1641	            "batch_max": BATCH_MAX,
  1642	            "batch_rule": "最旧优先（mtime 升序，同 mtime 按文件名升序），"
  1643	            f"单批上限 {BATCH_MAX} 件（D15 确认预算：一次性 >20 项完成率趋近 0）",
  1644	            "over_budget": total > batch_size,
  1645	            "deferred": deferred,
  1646	            "skipped": skipped,
  1647	        },
  1648	        "items": items,
  1649	        "sleeping": build_sleeping(inbox, now_s, inbox_exists),
  1650	        "near_dup_scan": scan,
  1651	        "last_cleanup": None,
  1652	        "last_cleanup_note": LAST_CLEANUP_NOTE,
  1653	        "not_executed_disclaimer": NOT_EXECUTED,
  1654	    }
  1655	    data["receipt"] = build_receipt(data)
  1656	    return data
