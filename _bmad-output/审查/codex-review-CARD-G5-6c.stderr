  1516	def test_ai_suspect_without_body_never_suggested_for_deletion(tmp_path):
  1517	    """⛔ round-4 BLOCKER-1: 边界规则拒掉的 AI 自述嫌疑 × 无正文 → 不得判 C3 建议删。
  1518	
  1519	    `generator: Generated by AI on March` 是肯定式生成断言, 但 ASCII 收尾标记
  1520	    的右边界(禁空白)把它拒了 —— 漏判本身方向安全, 可漏判后掉进 C3 就是把
  1521	    「引擎不敢确定的文件」当垃圾扔。护栏第 4 类信号: 裸子串在场即拦。"""
  1522	    vault, out = base_vault(tmp_path)
  1523	    mk(
  1524	        vault / "_待处理" / "英文断言仅头.md",
  1525	        "---\ngenerator: Generated by AI on March\n---\n",
  1526	        age_days=5,
  1527	    )
  1528	    # 正向对照: 无任何 AI 字样的纯空骨架 → 仍 C3 建议删 (护栏不得误伤存量判据)
  1529	    mk(vault / "_待处理" / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1530	
  1531	    assert run_cli(vault, out).returncode == 0
  1532	    data = load_json(out)
  1533	    it = item_by_name(data, "英文断言仅头.md")
  1534	    assert it["verdict"] != "建议删", f"AI 嫌疑件被建议删了: {it['basis']}"
  1535	    assert it["criterion"] == "C6_undecided"
  1536	    assert it["confident"] is False
  1537	    assert it["target_hint"] is None and it["nomination_type"] is None
  1538	    assert "Generated by AI" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1539	    skeleton = item_by_name(data, "纯空骨架.md")
  1540	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1541	    assert skeleton["verdict"] == "建议删"
