  1346	def _fill(
  1347	    item: dict,
  1348	    criterion: str,
  1349	    verdict: str,
  1350	    ntype: str | None,
  1351	    target: str | None,
  1352	    basis: str,
  1353	    confident: bool,
  1354	    *,
  1355	    uncertain_reason: str | None = None,
  1356	    ask: str | None = None,
  1357	    type_uncertain: bool = False,
  1358	    exact_of: str | None = None,
  1359	    exact_others: list[str] | None = None,
  1360	    near: list[dict] | None = None,
  1361	    conflicts: list[dict] | None = None,
  1362	) -> dict:
  1363	    out = dict(item)
  1364	    out.update(
  1365	        {
  1366	            "criterion": criterion,
  1367	            "verdict": verdict,
  1368	            "nomination_type": ntype,
  1369	            "target_hint": target,
  1370	            "basis": basis,
  1371	            "confident": confident,
  1372	            "type_uncertain": type_uncertain,
  1373	            "uncertain_reason": uncertain_reason,
  1374	            "ask": ask,
  1375	            "exact_duplicate_of": exact_of,
  1376	            "exact_duplicate_others": exact_others or [],
  1377	            "near_duplicates": near or [],
  1378	            "conflicts": conflicts or [],
  1379	        }
  1380	    )
  1381	    return out
  1382	
