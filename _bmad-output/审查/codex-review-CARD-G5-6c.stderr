   617	def test_near_dup_scan_counts_are_actually_exercised(tmp_path):
   618	    """⛔ LOW 回归: 「跳过 ≠ 无重复」的计数必须真的被算出来。
   619	    原测试只查键存在 —— 把两个计数永久写死成 0 它也照样通过。"""
