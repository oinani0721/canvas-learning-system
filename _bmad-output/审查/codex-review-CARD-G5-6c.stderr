  1846	def validate_label(label: str) -> None:
  1847	    if not label or _BAD_LABEL.search(label):
  1848	        raise SystemExit(
  1849	            f"✗ 收件箱目录名含非法字符或路径逃逸，拒绝用作产物名: {label!r}"
