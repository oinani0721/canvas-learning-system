   757	def test_reject_out_dir_inside_inbox(tmp_path):
   758	    """产物落进收件箱 → 第二跑会把上一次的产物当成待处理材料, 二跑不再逐字节相等。
   759	    这种不成立要跑两次才看得见, 所以在入口直接拒绝。"""
   760	    vault, _ = base_vault(tmp_path)
   761	    inside = vault / "_待处理" / "outputs"
   762	    r = run_cli(vault, inside)
   763	    assert r.returncode != 0
   764	    assert no_products(inside)
   765	    assert not inside.exists(), "拒绝路径不得在收件箱里建目录"
