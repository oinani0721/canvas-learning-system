   463	def parse_now(raw: str) -> datetime:
   464	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   465	    try:
   466	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   467	    except ValueError as e:
   468	        raise SystemExit(
   469	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   470	        ) from e
   471	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   472	
   473	
   474	def _epoch_s(dt: datetime) -> float:
   475	    return dt.timestamp()
   476	
   477	
   478	def days_between(now_s: float, then_s: float) -> int:
   479	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   480	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   481	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   482	    return int(round(now_s - then_s)) // 86400
   483	
   484	
   485	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   486	UNREPRESENTABLE = "unrepresentable"
   487	
   488	
   489	def _fmt(sec: float, tz, pattern: str) -> str:
   490	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   491	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   492	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   493	    **不**伪造一个看似正常的时间。"""
   494	    try:
   495	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   496	    except (OverflowError, OSError, ValueError):
   497	        return UNREPRESENTABLE
   498	
