   590	    assert r.returncode == 0, "读到 FIFO 挂住了"
   591	    data = load_json(out)
   592	    assert [i["name"] for i in data["items"]] == ["正常.md"]
   593	    assert any(x["name"] == "管道.md" for x in data["inventory"]["skipped"])
