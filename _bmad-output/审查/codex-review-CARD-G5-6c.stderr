   699	# ───────────────────────── C. 零写快照 ─────────────────────────
   700	
   701	
   702	def test_no_bytecode_cache_written_into_vault_skills(tmp_path):
   703	    """⛔ 零写侧的第一现场（Codex 审查实证）: importlib 加载兄弟模块默认会在
   704	    **board-split 目录**里写 `__pycache__/*.pyc` —— 既是往 vault 落文件, 也是
   705	    伸手进另一条车道的地盘。
   706	
   707	    (d) tmp 隔离重构 (CARD-G5-6b): 不再 rmtree checkout 里的 `__pycache__`
   708	    (裁判不该动被测 checkout 的任何目录项), 改为把两个脚本按**同一相对布局**
   709	    拷进 tmp (SCRIPT 的 `_SP_PATH` 由 `__file__` 推导, 布局一致副本才能定位
   710	    它自己的 split_preview 副本), 在副本上跑 CLI 与 importlib 加载, 断言副本树
   711	    下零 `__pycache__`。副本 sha256 必须等于 checkout 原件 —— 否则门测的是副本
   712	    不是被测物。CLI 子进程**显式剥掉 PYTHONDONTWRITEBYTECODE**: 裁判命令带着
   713	    它跑时, 子进程继承该变量会让 SCRIPT 内部的 dont_write_bytecode 保护永远
   714	    不被考验(门空转); 在副本树上剥掉它, 内部保护成为唯一防线, 删掉保护当场
   715	    在副本树留下缓存 → 门变红。
   716	    """
   717	    skills_copy = tmp_path / "skills"
   718	    for src in (SCRIPT, SPLIT_SCRIPT):
   719	        dst = skills_copy / src.relative_to(SKILLS)
   720	        dst.parent.mkdir(parents=True, exist_ok=True)
   721	        shutil.copy2(src, dst)
   722	        assert hashlib.sha256(dst.read_bytes()).hexdigest() == hashlib.sha256(src.read_bytes()).hexdigest(), (
   723	            f"副本与 checkout 原件不一致: {src}"
   724	        )
   725	    script_copy = skills_copy / SCRIPT.relative_to(SKILLS)
   726	
   727	    vault, out = base_vault(tmp_path)
   728	    env = {k: v for k, v in os.environ.items() if k != "PYTHONDONTWRITEBYTECODE"}
   729	    r = subprocess.run(
   730	        [
   731	            sys.executable,
   732	            str(script_copy),
   733	            "--vault",
   734	            str(vault),
   735	            "--out-dir",
   736	            str(out),
   737	            "--now",
   738	            NOW_ISO,
   739	        ],
   740	        capture_output=True,
   741	        text=True,
   742	        env=env,
   743	    )
   744	    assert r.returncode == 0, r.stderr[-300:]
   745	
   746	    spec = importlib.util.spec_from_file_location("inbox_preview_tmpcopy", script_copy)
   747	    mod = importlib.util.module_from_spec(spec)
   748	    _exec_no_bytecode(spec, mod)
   749	    assert mod._SP_PATH == skills_copy / SPLIT_SCRIPT.relative_to(SKILLS), (
   750	        "副本没有解析到副本树里的 split_preview —— 布局与 checkout 不一致"
   751	    )
   752	
   753	    caches = sorted(p.relative_to(skills_copy) for p in skills_copy.rglob("__pycache__"))
   754	    assert not caches, f"运行/导入在副本树落下了字节码缓存: {caches}"
   755	
