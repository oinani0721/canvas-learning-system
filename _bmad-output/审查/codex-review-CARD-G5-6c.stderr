   987	def test_extreme_now_degrades_without_crashing(tmp_path):
   988	    """极值 --now 不崩、不伪造: 人话时刻落占位串, 但整轮照常出产物。
   989	
   990	    ⛔ 早先版本在 parse_now 装了一道「入口拒绝」守卫 —— 实测 aware datetime 的
   991	    `.timestamp()` 对日历极值并不抛，那道守卫永远不会触发。装一道不会触发的守卫
   992	    等于给自己发一张假的安全证书, 故删掉, 改钉真实可达的降级行为。
   993	    这里选 +00:00 而不是 +14:00: 后者换到 Asia/Shanghai 仍是 9999 年内, 不触发降级。
   994	    """
   995	    vault, out = base_vault(tmp_path)
   996	    r = run_cli(vault, out, now="9999-12-31T23:59:59+00:00")
   997	    assert r.returncode == 0, r.stderr[-300:]
   998	    data = load_json(out)
   999	    assert data["now_utc"] == "9999-12-31T23:59:59Z"
  1000	    assert data["now_local"] == "unrepresentable", "+8h 溢出到 10000 年时必须落占位"
