   583	def test_non_regular_file_is_skipped_without_reading(tmp_path):
   584	    """⛔ MEDIUM 回归: FIFO 不得被 read_bytes —— 那会直接挂住整个进程。"""
   585	    vault, out = base_vault(tmp_path)
