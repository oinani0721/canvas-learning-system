   621	    long_body = "\n".join(f"第 {i} 行。" for i in range(1, 60)) + "\n"
   622	    mk(vault / "节点" / "长正本.md", long_body, age_days=40)
   623	    mk(vault / "节点" / "短文.md", "很短。\n第二行。\n", age_days=40)
   624	    mk(
   625	        vault / "_待处理" / "中等.md",
   626	        "# t\n\n" + "\n".join(f"第 {i} 行。" for i in range(1, 58)) + "\n",
   627	        age_days=2,
   628	    )
   629	
   630	    assert run_cli(vault, out).returncode == 0
   631	    scan = load_json(out)["near_dup_scan"]
   632	    assert scan["compared_pairs"] >= 1, "长度相近的一对必须真的比过"
   633	    assert scan["skipped_length_prefilter"] >= 1, "长度差悬殊的一对必须计入跳过"
