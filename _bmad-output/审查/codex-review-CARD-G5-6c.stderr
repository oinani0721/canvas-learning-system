   548	def test_within_batch_dup_does_not_block_c4_when_corpus_canonical_exists(tmp_path):
   549	    """⛔ MEDIUM 回归: 批内还有同稿, 不影响「库内已有一份」这条独立证据。
   550	    原实现无条件否决 C4, 两件都掉进 C6 —— 明明有依据却说没有。"""
