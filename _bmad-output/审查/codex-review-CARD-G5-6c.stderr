   561	    )
   562	    for it in items:
   563	        assert it["criterion"] == "C4_exact_duplicate"
   564	        assert it["exact_duplicate_of"] == "节点/库内正本.md"
   565	        assert any(c["kind"] == "duplicate_within_batch" for c in it["conflicts"])
