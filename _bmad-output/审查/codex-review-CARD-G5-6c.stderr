   720	
   721	def _norm_ai_line(ln: str) -> str:
   722	    """AI 标记匹配前的行归一：连续空白（含 NBSP 等一切 Unicode 空白）折叠为
   723	    单空格 + casefold。⛔ 大小写/空白变体曾穿透字面量表与裸子串护栏的双层 ——
   724	    `generated by ai`（全小写）、`GENERATED BY AI`、内部 NBSP 形态都曾在无正文
   725	    时掉进 C3 建议删（round-5 审查 BLOCKER-1）。归一化是确定性的，二跑逐字节
   726	    相等不受影响；basis 里的标记文本以归一化形态呈现，行号仍准确。"""
   727	    return " ".join(ln.split()).casefold()
   728	
   729	
   730	#: 归一化后的标记表（模块级算一次；全大写字母 ascii_ending 判定与原表一致）。
   731	_AI_MARKERS_NORM = tuple(" ".join(m.split()).casefold() for m in AI_MARKERS)
   732	
   733	#: ⛔ 护栏级 AI 信号（结构性，不依赖枚举表）：文本含独立「AI」字样即算嫌疑。
   734	#: 「独立」= 左右都**不是 ASCII 字母**（`\bAI\b` 在 CJK 邻接时无词边界 ——
   735	#: round-7 BLOCKER-1：`由AI系统生成` 曾穿透）。有限标记表无论怎么扩都追不上
   736	#: 自然语言的肯定式声明（round-6 BLOCKER-1：`This report was generated by an
   737	#: AI system` 不含任何表项，双层全盲，无正文时掉进 C3 建议删）。本信号只降
   738	#: C6 不裁决 —— C2 确定命中仍走有限表 + 边界规则（宽匹配会给话题提及发确定
   739	#: 归档，那是硬猜）。
   740	_AI_WORD_RE = re.compile(r"(?<![A-Za-z])AI(?![A-Za-z])", re.IGNORECASE)
   741	
   742	#: ⛔ 护栏级**生成断言结构**（round-8 BLOCKER-2）：`generator: 由 GPT-4 生成`
   743	#: 里既没有表项（表只收到 `由 GPT 生成`，`GPT-4` 差一个版本号）也没有独立词
   744	#: 「AI」，三层护栏全盲 → 无正文时掉进 C3 `建议删 + confident=true`。
   745	#: 修法按**声明骨架**而不是**枚举模型名**（卡文 §3 默认裁决）：模型名是开放
   746	#: 集合，`GPT-4` 之后还有 `GPT-4o`/`Claude 3.5`/`Gemini 2.5`/下个月发布的那个，
   747	#: 枚举永远追不上；「由 <某物> 生成」这个断言骨架是闭合的。
   748	#: ⚠️ 只作**未消化信号降 C6**，绝不进 C2：宽匹配给话题提及发确定归档就是硬猜
   749	#: （`由编译器生成`、`generated by hand` 都会命中本条 —— 它们降 C6，方向安全）。
   750	#: 中文：`由` 与 `生成` 之间 1-40 个非句读字符（句读收尾防跨句吞成假断言）。
   751	_GEN_CLAIM_CN_RE = re.compile(r"由[^。；！？\n]{1,40}?生成")
   752	#: 英文：在 `_norm_ai_line` 归一（连续空白折叠为单空格 + casefold）后的行上匹配，
   753	#: 故此处只写单空格。`generated by` 后必须有非空 token —— 光一句 `generated by`
   754	#: 没有主语，不构成生成断言。
   755	_GEN_CLAIM_EN_RE = re.compile(r"generated by \S")
   756	
   757	#: ⛔ 护栏级**生成器声明字段**（round-8 BLOCKER-2 的另一半）：键名本身就是声明。
   758	#: `generator: gpt-4`（值里没有「生成」二字）只有本条能接住，`本文由 GPT-4 生成`
   759	#: 写在正文里（无 frontmatter）只有 `_GEN_CLAIM_*` 能接住 —— 两条互补，都不冗余。
   760	#: 键名归一口径见 `_norm_fm_key`。
   761	_GENERATOR_DECL_KEYS = frozenset(
   762	    {"generator", "generated_by", "ai_generated", "model", "llm", "ai"}
   763	)
   764	
   765	#: ⛔ 来源声明键别名（round-8 HIGH）：`Source: DOI:10.1000/xyz` 的唯一来源标识
   766	#: 曾被当作不存在 —— `"source" in fm` 是**大小写敏感**的字面查找，取不到 `Source`；
   767	#: 而值不含 `http(s)://`，`url_bearing_keys` 也接不住。⚠️ 本别名集合只用于
   768	#: **护栏**：C1 仍只认字面小写 `source` 键（R8 稿约定），DOI 更不冒充 URL 或 C1
   769	#: （卡文 §3 默认裁决）—— 信号只把来源摆上台面降 C6，不给出「留原地/一手」提名。
   770	_SOURCE_DECL_KEYS = frozenset({"source", "sources"})
   771	
   772	#: DOI 形态（ISO 26324：`10.<registrant>/<suffix>`）。左界排除字母数字与点，
   773	#: 于是 `DOI:10.1000/xyz`、`doi: 10.1000/xyz`、裸 `10.1000/xyz` 都命中，而
   774	#: 版本号 `v10.1000/x` 之类不命中。⚠️ 只作来源信号，不解析、不解引用、不联网。
   775	_DOI_RE = re.compile(r"(?<![0-9A-Za-z.])10\.\d{4,9}/[^\s\"'<>]+")
   776	
   777	
   778	def _norm_fm_key(k: str) -> str:
   779	    """frontmatter 键名归一：casefold + `-`→`_`。
   780	
   781	    ⛔ 仅供**护栏**的键名比对（`Source`/`SOURCE`/`generated-by` 与
   782	    `source`/`generated_by` 同判）。判据侧（C1）刻意不走这里 —— 那会静默扩大
   783	    C1 的命中面，而 C1 命中意味着「一手来源 · 留原地 · confident=true」，
   784	    是有后果的提名，扩它必须是明写的决定而不是归一化的副作用。
   785	    """
   786	    return k.casefold().replace("-", "_")
   787	
   788	
   789	def _looks_like_doi_value(v: str) -> bool:
   790	    """值里含 DOI 形态的来源标识（⛔ substring 级，与 `_looks_like_source_value`
   791	    同口径）。非空才算 —— 卡文 (d) 要的是「**非空** DOI 来源阻止 C3 删除」。"""
   792	    return bool(v) and bool(_DOI_RE.search(v))
   793	
   794	
   795	def find_generation_claim(text: str) -> str | None:
   796	    """文头窗口内的**生成断言结构**片段（归一化匹配），无则 None。
   797	
   798	    ⛔ 只作 C3/C4 的「未消化信号」，不作 C2 判据 —— 见 `_GEN_CLAIM_CN_RE` 头注。
   799	    返回归一化后的命中片段（casefold + 空白折叠），供 uncertain_reason 展示；
   800	    ⚠️ 它是**归一形态**不是输入原文，措辞里如实这么说（round-8 §四对
   801	    「basis 带逐字片段」的证伪同源教训：写「逐字」就必须真的逐字）。
   802	    """
   803	    for _, ln in head_window(text):
   804	        norm = _norm_ai_line(ln)
   805	        for rx in (_GEN_CLAIM_CN_RE, _GEN_CLAIM_EN_RE):
   806	            m = rx.search(norm)
   807	            if m:
   808	                return m.group(0)
   809	    return None
   810	
   811	
   812	def _find_marker_pos(ln: str, marker: str) -> int:
   813	    """marker 在**已归一**的 ln 中第一个满足右边界规则的起点；无则 -1。
   814	
   815	    ⛔ 右边界 = 行尾、空白或 `_MARKER_BOUNDARY_PUNCT` 标点（round-2 H2）：裸子串
   816	    匹配曾把 `# 由 AI 生成内容的版权问题` 这类话题提及判成 AI 自述并给出确定的
   817	    归档去向。同一行里前一处命中不满足边界时继续向后找 —— 不因首处被拒就漏掉
   818	    行内更靠后的真命中。
   819	    ⛔ 以 ASCII 字母收尾的标记（`Generated by AI`）右边界**不含空白**：中英混排里
   820	    ASCII 词后天然是空格，放行空白等于边界规则对这些标记是空操作 ——
   821	    `Generated by AI Lab researchers` 会被误判成 AI 自述（round-3 自审 H2-1）。
   822	    只认行尾或标点；漏判方向落 C6，安全。"""
   823	    ascii_ending = marker[-1].isascii() and marker[-1].isalpha()
   824	    start = 0
   825	    while (i := ln.find(marker, start)) >= 0:
   826	        j = i + len(marker)
   827	        if j >= len(ln) or ln[j] in _MARKER_BOUNDARY_PUNCT:
   828	            return i
   829	        if not ascii_ending and ln[j].isspace():
   830	            return i
   831	        start = i + 1
   832	    return -1
   833	
   834	
   835	def find_ai_marker(text: str) -> tuple[int, str] | None:
   836	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
   837	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
   838	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
   839	    —— 行号准确，文本保真。"""
   840	    for lineno, ln in head_window(text):
   841	        norm = _norm_ai_line(ln)
   842	        hits = [
   843	            (pos, -len(nm), orig)
   844	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
   845	            if (pos := _find_marker_pos(norm, nm)) >= 0
   846	        ]
   847	        if hits:
   848	            _, _, marker = min(hits)
   849	            return lineno, marker
   850	    return None
   851	
   852	
   853	def raw_ai_marker(text: str) -> str | None:
   854	    """文头窗口内的**裸子串** AI 字样（归一化匹配，不做边界检查）—— 只用作
   855	    C3/C4 的「未消化信号」，不作 C2 判据。边界规则拒掉的命中（如 `Generated
   856	    by AI on March`）说明这行有 AI 自述嫌疑但引擎不敢确定；这样的文件若又
   857	    没有实质正文，判「空骨架建议删」就是把嫌疑当垃圾扔（round-4 BLOCKER-1）。
   858	    返回原表原文（uncertain_reason 展示用）。"""
   859	    for _, ln in head_window(text):
   860	        norm = _norm_ai_line(ln)
   861	        for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
   862	            if nm in norm:
   863	                return orig
   864	    return None
   865	
   866	
   867	def round_of(name: str) -> str | None:
   868	    m = _ROUND_RE.search(name)
   869	    return m.group(1) if m else None
   870	
   871	
   872	def round_type(name: str) -> str | None:
   873	    for pat, typ in ROUND_SUBPATTERNS:
   874	        if pat in name:
   875	            return typ
   876	    return None
