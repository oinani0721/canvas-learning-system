   508	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   509	
   510	
   511	def frontmatter_span(lines: list[str]) -> int:
   512	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   513	
   514	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   515	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   516	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   517	    行号是给人核对用的，偏了就等于没有。
   518	    """
   519	    if not lines or lines[0].strip() != "---":
   520	        return 0
   521	    end = None
   522	    for i in range(1, len(lines)):
   523	        if lines[i].strip() in ("---", "..."):
   524	            end = i
   525	            break
   526	    if end is None:
   527	        return 0  # 缺闭合 → 视为无 frontmatter
   528	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   529	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   530	    # 空文件的删除提名，比不提名坏得多。
   531	    for ln in lines[1:end]:
   532	        t = ln.strip()
   533	        if not t or t.startswith("#"):
   534	            continue  # 空行与 YAML 注释不作数
   535	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   536	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   537	
   538	
   539	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   540	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   541	    lines = text.splitlines()
   542	    n = frontmatter_span(lines)
   543	    return (lines[1 : n - 1] if n else []), lines[n:]
   544	
   545	
   546	def frontmatter_map(fm_lines: list[str]) -> dict:
   547	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。"""
   548	    out: dict[str, str] = {}
   549	    for ln in fm_lines:
   550	        m = _FM_KEY_RE.match(ln)
   551	        if not m:
   552	            continue
   553	        val = (m.group(2) or "").strip()
   554	        # 先剥行尾 YAML 注释再剥引号 —— 两步缺一不可，且顺序不能反：
   555	        # `source: "https://x" # 官方来源` 若先判引号会因末字符是「源」而走错分支，
   556	        # 值带着引号被 URL 判据拒掉，一手来源丢失（round-3 自审 H1-6）。
   557	        val = re.sub(r"\s+#.*$", "", val).strip()
   558	        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   559	            val = val[1:-1]
   560	        out.setdefault(m.group(1), val)
   561	    return out
   562	
   563	
   564	def _classify_lines_typed(text: str) -> tuple[list[tuple[str, str]], bool]:
   565	    """→ [((行, 种类), …), 是否结束于未闭合的 HTML 注释]。
   566	
   567	    种类三态：`"fence"`（围栏分隔行）/ `"code"`（围栏内容）/ `"text"`。
   568	    三态化是因为二态布尔回答不了「围栏**内容**里长得像围栏的行」——
   569	    Markdown 围栏语法速查（```` 里嵌 ``` 与 ~~~）曾被 `has_substantive_content`
   570	    用 `_FENCE_RE` 整体剔除 → 判成空骨架 → 建议删（round-3 自审 B3-3）。
   571	    分隔行由状态机精确标记，内容行一律是内容。
   572	
   573	    第二返回值供 C3 护栏（显式偏差 15）使用：`<!--` 没等到 `-->` 就到了 EOF
   574	    时，哪些内容被注释吞掉是引擎猜不了的 —— 这种文件不许被判「空骨架」。
   575	
   576	    ⛔ 围栏状态机是 Codex 两条 BLOCKER 的正解。原先没有它：
   577	      - `~~~` 被当成"纯结构行"删掉，围栏里的 `# comment` 又被当成 Markdown 标题删掉，
   578	        于是一份只有一段 shell 代码的文件被判成空骨架 → **建议删**；
   579	      - 而文件头明明声明着"代码块内容留在正文里"。声明与实现对不上就是掩饰。
   580	    注释剥离只作用于围栏外：代码里的 `<!-- -->` 是代码，不是说明。
   581	    """
   582	    _, rest = split_frontmatter(text)
   583	    rows: list[tuple[str, str]] = []
   584	    in_fence = False
   585	    fence_char = ""
   586	    fence_len = 0
   587	    in_comment = False
   588	    for ln in rest:
   589	        m = _FENCE_RE.match(ln)
   590	        if m and not in_comment:
   591	            tok = m.group(1)
   592	            # ⛔ CommonMark 4.4：反引号围栏的 info string **不得含反引号** ——
   593	            # ```foo`bar 不是合法开启行（round-6 BLOCKER-3：该行曾被当开启、
   594	            # 下一行被当关闭、正文再被标题剥掉 → 空骨架建议删）。tilde 围栏
   595	            # 的 info string 允许反引号，不受此限。
   596	            if not in_fence and not (tok[0] == "`" and "`" in ln[m.end() :]):
   597	                in_fence, fence_char, fence_len = True, tok[0], len(tok)
   598	                rows.append((ln, "fence"))
   599	                continue
   600	            # ⛔ 关闭围栏 = 同字符 **且长度 ≥ 开启长度、围栏后仅 ASCII 空白**
   601	            # （CommonMark 4.5）。只比字符曾让 ```` 里的 ``` 被当关闭、``` 后带
   602	            # info string 的行也被当关闭 —— 围栏内容 `# keep` 落到围栏外被剥，
   603	            # 整份文件被误判成空骨架 → 建议删（round-2 B3 实证）。
   604	            # ⛔ 「仅空白」必须逐字符限 ASCII 空格/制表符：`str.strip()` 接受一切
   605	            # Unicode 空白，行尾一个 U+00A0（网页复制常见）曾让该行被当成合法
   606	            # 关闭围栏 → 围栏提前闭合 → 建议删（round-3 Codex BLOCKER；NBSP 行
   607	            # 在 CommonMark 里是围栏内容）。
   608	            if (
   609	                tok[0] == fence_char
   610	                and len(tok) >= fence_len
   611	                and all(c in " \t" for c in ln[m.end() :])
   612	            ):
   613	                in_fence, fence_char, fence_len = False, "", 0
   614	                rows.append((ln, "fence"))
   615	                continue
   616	        if in_fence:
   617	            rows.append((ln, "code"))
   618	            continue
   619	        kept, rem = "", ln
   620	        while rem:
   621	            if in_comment:
   622	                i = rem.find("-->")
   623	                if i < 0:
   624	                    break
   625	                rem, in_comment = rem[i + 3 :], False
   626	            else:
   627	                i = rem.find("<!--")
   628	                if i < 0:
   629	                    kept += rem
   630	                    break
   631	                kept += rem[:i]
   632	                rem, in_comment = rem[i + 4 :], True
   633	        rows.append((kept, "text"))
   634	    return rows, in_comment
   635	
   636	
   637	def _classify_lines(text: str) -> list[tuple[str, bool]]:
   638	    """二态视图（该行是否属围栏区），供 `dup_body` 等逐字保真路径使用。
   639	    三态细节见 `_classify_lines_typed`。"""
   640	    return [(ln, kind != "text") for ln, kind in _classify_lines_typed(text)[0]]
   641	
   642	
   643	def dup_body(text: str) -> str:
   644	    """**逐字保真**的正文形态 —— C4「精确重复」的唯一比对依据。
   645	
   646	    只做无语义的归一：丢标题行（围栏外）、行尾空白 rstrip、丢空行、NFC。
   647	    ⛔ **不** `.strip()` 每行、**不**剥列表符号：那会抹掉代码缩进，让
   648	    `if ok:` + 缩进 `run()` 与 `if ok:` + 顶格 `run()` 判成"逐字相等"，
   649	    进而对一份语义完全不同的文件给出「建议删」（Codex BLOCKER 实证）。
   650	    有后果的提名，依据必须逐字。
   651	    ⛔ 标题不进比对：同一段材料被粘两份时标题常不同（R8 判据 4 说的是「正文高相似」）。
   652	    """
   653	    parts: list[str] = []
   654	    for ln, is_code in _classify_lines(text):
   655	        if not is_code and _HEADING_RE.match(ln):
   656	            continue
   657	        t = ln.rstrip()
   658	        if not t:
   659	            continue
   660	        parts.append(nfc(t))
   661	    return "\n".join(parts)
   662	
   663	
   664	def has_substantive_content(text: str) -> bool:
   665	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   666	
   667	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   668	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   669	    合用一个函数正是 Codex BLOCKER 的根因。
   670	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   671	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   672	    （round-3 自审 B3-3）。
   673	    """
   674	    for ln, kind in _classify_lines_typed(text)[0]:
   675	        if kind == "code":
   676	            if ln.strip():
   677	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   678	            continue
   679	        if kind == "fence":
   680	            continue
   681	        if _HEADING_RE.match(ln):
   682	            continue
   683	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   684	        if t and not _ONLY_STRUCT_RE.match(t):
   685	            return True
   686	    return False
   687	
   688	
   689	def skeleton_note(text: str, size: int) -> str:
   690	    """空/骨架的**逐项计数**依据 —— 不是「看起来是空的」而是数出来的。
   691	
   692	    ⛔ fences 只数围栏**分隔行**（三态视图），围栏内的空行归入句尾的
   693	    「其余皆空行」—— 原先 `sum(... if c)` 把围栏内空行也算进「代码围栏 N 行」，
   694	    与同一句里的「其余皆空行」不构成划分（round-3 自审 B3-5）。
   695	    """
   696	    if size == 0:
   697	        return "0 字节空文件"
   698	    rows = _classify_lines_typed(text)[0]
   699	    headings = sum(1 for ln, k in rows if k == "text" and _HEADING_RE.match(ln))
   700	    struct = sum(
   701	        1 for ln, k in rows if k == "text" and not _HEADING_RE.match(ln) and ln.strip()
   702	    )
   703	    fences = sum(1 for _, k in rows if k == "fence")
   704	    return (
   705	        f"剥离 frontmatter / HTML 注释后实质正文 0 字符"
   706	        f"（{size} 字节文件：标题 {headings} 行、纯结构行 {struct} 行、"
   707	        f"代码围栏 {fences} 行、其余皆空行或注释）"
   708	    )
   709	
   710	
   711	def head_window(text: str) -> list[tuple[int, str]]:
   712	    """C2 扫描窗口：frontmatter 行 + 其后前 HEAD_SCAN_LINES 行；返回 (1-based 行号, 原文)。"""
   713	    lines = text.splitlines()
   714	    n = frontmatter_span(lines)
   715	    win: list[tuple[int, str]] = [(i + 1, lines[i]) for i in range(min(n, len(lines)))]
   716	    for j, ln in enumerate(lines[n : n + HEAD_SCAN_LINES]):
   717	        win.append((n + j + 1, ln))
   718	    return win
