   127	+            ),
   128	+        ],
   129	+    ),
   130	+]
   131	+
   132	+
   133	+def sha(p: pathlib.Path) -> str:
   134	+    return hashlib.sha256(p.read_bytes()).hexdigest()
   135	+
   136	+
   137	+def run_suite() -> tuple[int, list[str], str]:
   138	+    r = subprocess.run(
   139	+        PYTEST,
   140	+        cwd=BACKEND,
   141	+        capture_output=True,
   142	+        text=True,
   143	+        env={
   144	+            "PATH": "/usr/bin:/bin",
   145	+            "PYTHONDONTWRITEBYTECODE": "1",
   146	+            "HOME": str(pathlib.Path.home()),
   147	+            "LC_ALL": "C.UTF-8",
   148	+        },
   149	+    )
   150	+    out = r.stdout + r.stderr
   151	+    failed = [
   152	+        ln.split("::")[1].split(" ")[0].strip()
   153	+        for ln in out.splitlines()
   154	+        if ln.startswith("FAILED ") and "::" in ln
   155	+    ]
   156	+    tail = [
   157	+        ln
   158	+        for ln in out.splitlines()
   159	+        if "passed" in ln or "failed" in ln or "error" in ln
   160	+    ]
   161	+    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   162	+
   163	+
   164	+original = SRC.read_bytes()
   165	+base_sha = sha(SRC)
   166	+print(f"源码基线 sha256 = {base_sha}\n")
   167	+
   168	+results: list[tuple[str, bool, str]] = []
   169	+try:
   170	+    for name, target_gate, layers in MUTATIONS:
   171	+        text = original.decode("utf-8")
   172	+        for old, new in layers:
   173	+            n = text.count(old)
   174	+            if n != 1:
   175	+                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   176	+            text = text.replace(old, new)
   177	+        SRC.write_text(text, encoding="utf-8")
   178	+        assert sha(SRC) != base_sha, f"[{name}] 变异没有真的改到字节"
   179	+
   180	+        rc, failed, summary = run_suite()
   181	+
   182	+        # 还原 + 逐字节比对（每条变异跑完立刻还原，串行不重叠）
   183	+        SRC.write_bytes(original)
   184	+        restored = sha(SRC)
   185	+
   186	+        killed = target_gate in failed
   187	+        ok = killed and rc not in (0, 5) and restored == base_sha
   188	+        detail = (
   189	+            f"rc={rc} | {summary} | 指定门{'已' if killed else '未'}被杀"
   190	+            f" | 连带红 {len(failed)} 门 | 还原 sha {'一致' if restored == base_sha else '⛔不一致'}"
   191	+        )
   192	+        results.append((name, ok, detail))
   193	+        print(
   194	+            f"{'✅' if ok else '❌'} {name}\n   目标门 {target_gate}\n   {detail}\n"
   195	+            f"   FAILED: {failed}\n"
   196	+        )
   197	+finally:
   198	+    SRC.write_bytes(original)
   199	+    final = sha(SRC)
   200	+    print(
   201	+        f"finally 还原后 sha256 = {final} "
   202	+        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   203	+    )
   204	+
   205	+print("\n" + "=" * 70)
   206	+allok = (
   207	+    all(ok for _, ok, _ in results)
   208	+    and sha(SRC) == base_sha
   209	+    and len(results) == len(MUTATIONS)
   210	+)
   211	+print(
   212	+    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   213	+    f"（{sum(1 for _, ok, _ in results if ok)}/{len(MUTATIONS)} 变异各由指定门杀死）"
   214	+)
   215	+sys.exit(0 if allok else 1)
