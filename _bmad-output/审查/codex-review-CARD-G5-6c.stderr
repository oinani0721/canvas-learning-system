  1140	def test_fence_close_requires_same_char_min_length_and_bare_fence(tmp_path):
  1141	    """⛔ B3 回归: 关闭围栏 = 同字符 且 长度 ≥ 开启长度 且 围栏后仅空白
  1142	    (CommonMark 4.5)。
  1143	
  1144	    原实现只比字符: ```` 里的 ``` 被当关闭、``` 后带 info string 的行也被当关闭,
  1145	    围栏内容 `# keep` 落到围栏外被 `_HEADING_RE` 剥掉 → 整份文件被误判成
  1146	    空骨架 → 建议删。
  1147	    """
  1148	    vault, out = base_vault(tmp_path)
  1149	    inbox = vault / "_待处理"
  1150	    mk(inbox / "四反引号.md", "````\n```\n# keep\n````\n", age_days=9)
  1151	    mk(inbox / "四波浪线.md", "~~~~\n~~~\n# keep\n~~~~\n", age_days=8)
  1152	    # CommonMark: 关闭围栏不得带 info string → ```python 是围栏内容, 不是关闭
  1153	    mk(inbox / "关闭带infostring.md", "```\n```python\n# keep\n```\n", age_days=7)
  1154	    # 同字符子句: ``` 围栏里的 ~~~ 行是内容, 不是关闭 (删掉同字符判断即翻红)
  1155	    mk(inbox / "混合字符.md", "```\n~~~\n# keep\n```\n", age_days=6)
  1156	    # 制表符缩进不构成围栏 (CommonMark: ≥4 列是缩进代码块); \t``` 不得提前关闭 ——
  1157	    # ⛔ 语料不得带正文行: 有正文行时「提前关闭」也杀不死断言, 变异会存活
  1158	    mk(inbox / "tab关闭围栏.md", "```\n\t```\n# 标题\n", age_days=5)
  1159	    # 围栏内容行哪怕每行都长得像围栏标记, 也是实质正文 (Markdown 围栏语法速查)
  1160	    mk(
  1161	        inbox / "围栏速查.md",
  1162	        "# Markdown 围栏语法速查\n\n## 空围栏怎么写\n\n````\n```\n```\n~~~\n~~~\n````\n",
  1163	        age_days=4,
  1164	    )
  1165	    # 正向对照: 只有围栏无内容 → 仍是空骨架; 正常围栏包着注释 → 仍非空骨架
  1166	    mk(inbox / "只有围栏.md", "````\n````\n", age_days=2)
  1167	    mk(inbox / "正常围栏.md", "```\n# keep\n```\n", age_days=1)
  1168	
  1169	    assert run_cli(vault, out).returncode == 0
  1170	    data = load_json(out)
  1171	    for name in (
  1172	        "四反引号.md",
  1173	        "四波浪线.md",
  1174	        "关闭带infostring.md",
  1175	        "混合字符.md",
  1176	        "tab关闭围栏.md",
  1177	        "围栏速查.md",
  1178	    ):
  1179	        it = item_by_name(data, name)
  1180	        assert it["criterion"] != "C3_empty_or_skeleton", f"{name} 的围栏内容被剥掉了"
  1181	        assert it["verdict"] != "建议删", name
  1182	    only = item_by_name(data, "只有围栏.md")
  1183	    assert only["criterion"] == "C3_empty_or_skeleton"
  1184	    assert only["verdict"] == "建议删"
  1185	    normal = item_by_name(data, "正常围栏.md")
  1186	    assert normal["criterion"] != "C3_empty_or_skeleton"
  1187	    assert normal["verdict"] != "建议删"
