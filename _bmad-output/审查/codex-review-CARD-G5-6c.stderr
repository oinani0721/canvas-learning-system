  1544	def test_unparsed_source_with_duplicate_body_is_not_suggested_for_deletion(tmp_path):
  1545	    """⛔ round-4 BLOCKER-2: 非标准 source × 正文与库内逐字重复 → 不得建议删。
  1546	
  1547	    C4 只证明「剥掉 frontmatter 后正文相等」, 不证明「整个文件多余」—— 这份
  1548	    还带着一个独有的来源声明(冒号后无空格, 键正则不认)。来源信息必须在建议里
  1549	    摆到台面上; 摆不出来就不许删。护栏拦在 C4 出口, 降 C6 且重复证据留痕。"""
  1550	    vault, out = base_vault(tmp_path)
  1551	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1552	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1553	    mk(
  1554	        vault / "_待处理" / "带来源重复.md",
  1555	        "---\ntitle: 剪藏\nsource:https://unique.example/a\n---\n" + body,
  1556	        age_days=3,
  1557	    )
  1558	    # 正向对照: 无 source 的重复件 → 仍 C4 建议删 (护栏不得误伤存量判据)
  1559	    mk(vault / "_待处理" / "无来源重复.md", body, age_days=2)
  1560	    # 带普通元数据键的重复件 → 仍 C4 建议删, 但元数据必须挂冲突留痕
  1561	    mk(
  1562	        vault / "_待处理" / "带标签重复.md",
  1563	        "---\ntags: [剪藏, 待整理]\n---\n" + body,
  1564	        age_days=1,
  1565	    )
  1566	
  1567	    assert run_cli(vault, out).returncode == 0
  1568	    data = load_json(out)
  1569	    it = item_by_name(data, "带来源重复.md")
  1570	    assert it["verdict"] != "建议删", f"带来源的重复件被建议删了: {it['basis']}"
  1571	    assert it["criterion"] == "C6_undecided"
  1572	    assert it["confident"] is False
  1573	    assert it["target_hint"] is None and it["nomination_type"] is None
  1574	    assert it["exact_duplicate_of"] == "节点/库内正本.md", "重复证据必须留痕"
  1575	    assert any(c["kind"] == "exact_duplicate_under_other_verdict" for c in it["conflicts"]), "重复证据必须挂冲突留痕"
  1576	    assert "unique.example" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1577	    dup = item_by_name(data, "无来源重复.md")
  1578	    assert dup["criterion"] == "C4_exact_duplicate"
  1579	    assert dup["verdict"] == "建议删"
  1580	    tagged = item_by_name(data, "带标签重复.md")
  1581	    assert tagged["criterion"] == "C4_exact_duplicate"
  1582	    assert tagged["verdict"] == "建议删"
  1583	    assert any(c["kind"] == "frontmatter_metadata_present" for c in tagged["conflicts"]), (
  1584	        "C4 删除前 frontmatter 元数据必须留痕"
  1585	    )
  1586	
