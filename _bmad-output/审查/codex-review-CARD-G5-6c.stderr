   602	    mk(vault / "节点" / "AI正本.md", ai_body, age_days=40)
   603	    mk(inbox / "AI副本.md", ai_body, age_days=5)
   604	    rnd_body = "轮次材料的正文。\n第二行。\n"
   605	    mk(vault / "节点" / "轮次正本.md", rnd_body, age_days=40)
