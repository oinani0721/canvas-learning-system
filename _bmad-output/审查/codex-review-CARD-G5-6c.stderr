  1190	def test_url_without_host_is_not_primary_record(tmp_path):
  1191	    """⛔ H1 回归: `https://:443/x`、`https://user@/x` 没有 host —— 能过纯正则,
  1192	    但 `urlsplit(...).hostname` 为空, 不构成「一手来源」的机械证据。"""
  1193	    vault, out = base_vault(tmp_path)
