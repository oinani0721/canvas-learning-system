   611	    assert ai["criterion"] == "C2_ai_self_declared", "C4 抢在了 C2 前面"
   612	    assert ai["exact_duplicate_of"] == "节点/AI正本.md"
   613	    rnd = item_by_name(data, "R77_副本.md")
   614	    assert rnd["criterion"] == "C4_exact_duplicate", "C5 抢在了 C4 前面"
