   995	) -> dict:
   996	    """对一件材料出提名。**次序即 CRITERIA_ORDER**，先命中者定 verdict；
   997	    后续判据的证据仍全量附上（conflicts / exact_duplicate_of / near_duplicates）。"""
   998	    name = item["name"]
   999	    conflicts: list[dict] = []
  1000	

