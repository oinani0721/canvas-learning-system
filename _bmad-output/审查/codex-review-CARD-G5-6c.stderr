   881	
   882	def read_text_or_none(p: Path) -> str | None:
   883	    try:
   884	        return p.read_bytes().decode("utf-8")
   885	    except (OSError, UnicodeDecodeError):
   886	        return None
   887	
   888	
   889	def scan_corpus(
   890	    vault: Path, excluded_roots: list[str]
   891	) -> tuple[dict[str, list[str]], list[tuple[str, str]], dict]:
   892	    """库内 .md 语料：→ (归一化正文 → [相对路径…], [(路径, 正文)…], 统计)。
   893	
   894	    排除：一切隐藏目录、`outputs/`、收件箱子树、产物目录子树。
   895	    ⛔ **空正文不进重复索引** —— 否则库内任意两个空骨架互为「正本」，会撑出一条
   896	    有后果的建议删，其证据是「两个都是空的」。C3 虽然先命中，但索引本身必须先干净：
   897	    门要防的是未来次序调整时的静默失效，不只是当下这一次。
   898	    """
   899	    by_body: dict[str, list[str]] = {}
   900	    bodies: list[tuple[str, str]] = []
   901	    stats = {
   902	        "files_scanned": 0,
   903	        "files_indexed": 0,
   904	        "skipped_empty_body": 0,
   905	        "skipped_symlink": 0,
   906	        "skipped_unreadable": 0,
   907	        "truncated": False,
   908	        "file_cap": CORPUS_FILE_CAP,
   909	    }
   910	    for dirpath, dirnames, filenames in os.walk(vault):
   911	        dirnames[:] = sorted(
   912	            d
   913	            for d in dirnames
   914	            if not d.startswith(".")
   915	            and d not in CORPUS_EXCLUDED_DIR_NAMES
   916	            and os.path.realpath(os.path.join(dirpath, d)) not in excluded_roots
   917	        )
   918	        for fn in sorted(filenames):
   919	            if not fn.endswith(".md"):
   920	                continue
   921	            if stats["files_scanned"] >= CORPUS_FILE_CAP:
   922	                # ⛔ 不在此处 return —— 早退会绕过下面的排序尾巴, 让"截断"与"未截断"
   923	                # 两条路径产出形态不同的索引。置位后跳出全部循环, 走同一个出口。
   924	                stats["truncated"] = True
   925	                dirnames.clear()
   926	                break
   927	            p = Path(dirpath) / fn
   928	            stats["files_scanned"] += 1
   929	            if p.is_symlink():
   930	                stats["skipped_symlink"] += 1
   931	                continue
   932	            text = read_text_or_none(p)
   933	            if text is None:
   934	                stats["skipped_unreadable"] += 1
   935	                continue
   936	            if not has_substantive_content(text):
   937	                stats["skipped_empty_body"] += 1
   938	                continue
   939	            body = dup_body(text)
   940	            if not body:
   941	                stats["skipped_empty_body"] += 1
   942	                continue
   943	            rel = p.relative_to(vault).as_posix()
   944	            by_body.setdefault(body, []).append(rel)
   945	            bodies.append((rel, body))
   946	            stats["files_indexed"] += 1
   947	        if stats["truncated"]:
   948	            break
   949	    for v in by_body.values():
   950	        v.sort()
   951	    bodies.sort()
   952	    return by_body, bodies, stats
   953	
   954	
   955	def near_duplicates(
   956	    body: str, corpus_bodies: list[tuple[str, str]], scan: dict
   957	) -> list[dict]:
   958	    """difflib 近似（按行比对）。⛔ 只标疑似，永不裁决 —— 见显式偏差 1。"""
   959	    if not body:
   960	        return []
   961	    a_lines = body.split("\n")
   962	    la = len(body)
   963	    hits: list[tuple[float, str]] = []
   964	    for rel, other in corpus_bodies:
   965	        if other == body:
   966	            continue  # 逐字相等归 C4，不重复计入疑似
   967	        lb = len(other)
   968	        if la > NEAR_DUP_BODY_CHAR_CAP or lb > NEAR_DUP_BODY_CHAR_CAP:
   969	            scan["skipped_oversize"] += 1
   970	            continue
   971	        if not (1 / NEAR_DUP_LEN_RATIO <= (lb / la if la else 0) <= NEAR_DUP_LEN_RATIO):
   972	            scan["skipped_length_prefilter"] += 1
   973	            continue
   974	        scan["compared_pairs"] += 1
   975	        sm = difflib.SequenceMatcher(None, a_lines, other.split("\n"), autojunk=False)
   976	        if sm.real_quick_ratio() < NEAR_DUP_RATIO or sm.quick_ratio() < NEAR_DUP_RATIO:
   977	            continue
   978	        r = sm.ratio()
   979	        if r >= NEAR_DUP_RATIO:
   980	            hits.append((r, rel))
   981	    hits.sort(key=lambda x: (-x[0], x[1]))
   982	    return [{"path": rel, "ratio": round(r, 4)} for r, rel in hits[:NEAR_DUP_TOP_N]]
   983	
   984	
   985	# ───────────────────────── 逐份提名（判据次序即本函数结构） ─────────────────────────
   986	
