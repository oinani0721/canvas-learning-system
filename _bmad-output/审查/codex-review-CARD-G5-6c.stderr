  1853	def validate_product_filename(label: str) -> None:
  1854	    """产物文件名长度预检 —— ⛔ 必须在 prepare_out_dir **之前**调用，
  1855	    否则会「先建好 out-dir、再在写入时 ENAMETOOLONG」：拒绝但已留空目录。"""
  1856	    for suffix in (".json", ".md"):
  1857	        n = len(f"inbox-preview-{label}{suffix}".encode("utf-8"))
  1858	        if n > MAX_FILENAME_BYTES:
  1859	            raise SystemExit(
  1860	                f"✗ 收件箱目录名过长，产物文件名 {n} 字节超出上限 {MAX_FILENAME_BYTES}: "
  1861	                f"inbox-preview-{label}{suffix}"
  1862	            )
  1863	
  1864	
  1865	def main() -> int:
  1866	    ap = argparse.ArgumentParser(
  1867	        description="待处理盘点提名 preview（只读, CARD-G5-6）"
  1868	    )
  1869	    ap.add_argument("--vault", required=True, help="vault 根目录")
  1870	    ap.add_argument(
  1871	        "--now", required=True, help="基准时刻 ISO-8601（裸时间按 Asia/Shanghai 解释）"
  1872	    )
  1873	    ap.add_argument(
  1874	        "--inbox-dir",
  1875	        default=None,
  1876	        help=f"收件箱目录（缺省 <vault>/{DEFAULT_INBOX_NAME}）。"
  1877	        "显式给定却不存在 = 拒绝；缺省路径不存在 = 空仓回执",
  1878	    )
  1879	    ap.add_argument(
  1880	        "--out-dir",
  1881	        default=None,
  1882	        help="产物目录（缺省 <vault>/outputs；父目录必须已存在）",
  1883	    )
  1884	    ap.add_argument(
  1885	        "--batch-size", type=int, default=BATCH_MAX, help=f"单批件数（1..{BATCH_MAX}）"
  1886	    )
  1887	    args = ap.parse_args()
  1888	
  1889	    # ⛔ 次序铁律：全部输入守卫跑完**再**碰 out-dir —— 拒绝路径必须零产物。
  1890	    if not (1 <= args.batch_size <= BATCH_MAX):
  1891	        raise SystemExit(
  1892	            f"✗ --batch-size 必须在 1..{BATCH_MAX}（D15 确认预算上限，不得突破）, 实得 {args.batch_size}"
  1893	        )
  1894	    now = parse_now(args.now)
  1895	
  1896	    vault = Path(args.vault)
  1897	    if vault.is_symlink():
  1898	        raise SystemExit(f"✗ vault 路径本身是 symlink, 拒绝越界读取: {vault}")
  1899	    if not vault.is_dir():
  1900	        raise SystemExit(f"✗ vault 不存在或不是目录: {vault}")
  1901	    vault = vault.resolve()
  1902	
  1903	    explicit = args.inbox_dir is not None
  1904	    inbox = Path(args.inbox_dir) if explicit else vault / DEFAULT_INBOX_NAME
  1905	    if inbox.is_symlink():
  1906	        raise SystemExit(f"✗ 收件箱目录本身是 symlink, 拒绝越界读取: {inbox}")
  1907	    inbox_exists = inbox.is_dir()
  1908	    if explicit and not inbox_exists:
  1909	        # 用户明确指了路径却找不到 = 写错了。绝不能报成「空仓」把 typo 掩盖掉。
  1910	        raise SystemExit(f"✗ --inbox-dir 指定的目录不存在: {inbox}")
  1911	
  1912	    validate_label(inbox.name)
  1913	    validate_product_filename(inbox.name)
  1914	
  1915	    out_dir_arg = Path(args.out_dir) if args.out_dir else vault / "outputs"
  1916	    inbox_real, out_real = os.path.realpath(inbox), os.path.realpath(out_dir_arg)
  1917	    if out_real == inbox_real or out_real.startswith(inbox_real + os.sep):
  1918	        # ⛔ 否则第一次跑落下的两份产物，第二次跑会被当成待处理材料盘点进来 ——
  1919	        # 「同输入二跑逐字节相等」当场不成立，而且是那种跑两次才看得见的不成立。
  1920	        raise SystemExit(
  1921	            f"✗ 产物目录不能位于收件箱内, 拒绝运行（二跑会把上一次的产物当成待处理材料）: {out_dir_arg}"
  1922	        )
  1923	    excluded = [inbox_real, out_real]
  1924	
  1925	    data = build_preview(vault, inbox, inbox_exists, now, args.batch_size, excluded)
  1926	    payload_json = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
  1927	    payload_md = render_md(data)
  1928	
  1929	    out_dir = _SP.prepare_out_dir(out_dir_arg)
  1930	    json_path = out_dir / f"inbox-preview-{inbox.name}.json"
  1931	    md_path = out_dir / f"inbox-preview-{inbox.name}.md"
  1932	    _SP.write_pair_atomically_checked(
  1933	        [(json_path, payload_json), (md_path, payload_md)]
  1934	    )
  1935	
  1936	    print(
  1937	        f"✓ preview 已生成（只读引擎, 未动 vault 任何既有文件）: {json_path} / {md_path}"
  1938	    )
  1939	    print(f"  {data['receipt']}")
  1940	    unsure = sum(1 for i in data["items"] if not i["confident"])
  1941	    print(
  1942	        f"  本批 {len(data['items'])} 件 · 拿不准 {unsure} 件 · "
  1943	        f"建议删 {sum(1 for i in data['items'] if i['verdict'] == V_DELETE)} 件"
  1944	    )
  1945	    return 0
  1946	
  1947	
  1948	if __name__ == "__main__":
  1949	    raise SystemExit(main())

