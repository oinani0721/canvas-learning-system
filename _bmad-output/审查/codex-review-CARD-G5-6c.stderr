  1387	def list_inbox(inbox: Path, now_s: float) -> tuple[list[dict], list[dict]]:
  1388	    """收件箱顶层盘点 → (条目, 跳过留痕)。Sleeping/ 另计台账，其余子目录声明跳过。"""
  1389	    items: list[dict] = []
  1390	    skipped: list[dict] = []
  1391	    with os.scandir(inbox) as it:
  1392	        entries = sorted(it, key=lambda e: e.name)
  1393	    for entry in entries:
  1394	        p = Path(entry.path)
  1395	        if entry.is_symlink():
  1396	            skipped.append(
  1397	                {
  1398	                    "name": entry.name,
  1399	                    "reason": "条目是 symlink，不跟随（可能指向 vault 外）",
  1400	                }
  1401	            )
  1402	            continue
  1403	        if entry.is_dir():
  1404	            if entry.name == SLEEPING_DIR_NAME:
  1405	                continue  # 走 Sleeping 台账
  1406	            skipped.append(
  1407	                {
  1408	                    "name": entry.name,
  1409	                    "reason": "子目录不在本卡盘点范围（只盘点顶层文件与 Sleeping/ 台账）",
  1410	                }
  1411	            )
  1412	            continue
  1413	        if not entry.is_file():
  1414	            # FIFO / 设备 / 套接字：read_bytes 可能直接阻塞，绝不碰
  1415	            skipped.append(
  1416	                {
  1417	                    "name": entry.name,
  1418	                    "reason": "不是普通文件（FIFO / 设备 / 套接字等），不读取",
  1419	                }
  1420	            )
  1421	            continue
  1422	        try:
  1423	            st = p.stat()
  1424	        except OSError as e:
  1425	            # 扫目录与取属性之间材料被移走 —— 跳过留痕, 不让一次竞态崩掉整份 preview
  1426	            skipped.append(
  1427	                {
  1428	                    "name": entry.name,
  1429	                    "reason": f"读取属性失败（可能已被移走）: {e.strerror}",
  1430	                }
  1431	            )
  1432	            continue
  1433	        items.append(
  1434	            {
  1435	                "stable_id": compute_inbox_stable_id(
  1436	                    f"{nfc(inbox.name)}/{nfc(entry.name)}"
  1437	                ),
  1438	                "name": entry.name,
  1439	                "rel_path": f"{inbox.name}/{entry.name}",
  1440	                "size_bytes": st.st_size,
  1441	                "mtime_utc": fmt_utc(st.st_mtime),
  1442	                "mtime_local": fmt_local(st.st_mtime),
  1443	                "age_days": days_between(now_s, st.st_mtime),
  1444	                # 排序用纳秒整数（float 秒会把相差 1ns 的两件折叠成相等，
  1445	                # 于是"最旧优先"退化成按文件名 —— Codex LOW 实证）
  1446	                "_mtime_ns": st.st_mtime_ns,
  1447	                "_path": str(p),
  1448	            }
  1449	        )
  1450	    # 最旧优先；同 mtime 按名字升序 —— 二跑同序的唯一保证
  1451	    items.sort(key=lambda d: (d["_mtime_ns"], d["name"]))
  1452	    return items, skipped
  1453	
  1454	
  1455	def build_sleeping(inbox: Path, now_s: float, exists: bool) -> dict:
  1456	    d = inbox / SLEEPING_DIR_NAME
  1457	    if not exists or not d.is_dir() or d.is_symlink():
  1458	        return {
  1459	            "dir": f"{inbox.name}/{SLEEPING_DIR_NAME}",
  1460	            "exists": False,
  1461	            "count": 0,
  1462	            "oldest_days": None,
  1463	            "over_30d_count": 0,
