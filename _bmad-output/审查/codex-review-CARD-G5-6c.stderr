  1876	def test_nbsp_after_hash_is_not_an_atx_heading(tmp_path):
  1877	    """⛔ round-8 BLOCKER-1: ATX 的**井号后分隔**也只认 ASCII 空格/制表符。
  1878	
  1879	    前置缩进在 round-7 已收窄为字面空格, 但 `#{1,6}` 后仍写着 `(?:\\s|$)` ——
  1880	    Python `re` 的 `\\s` 在 str 模式下是 Unicode 语义, `#\\xa0keep`
  1881	    (字节 23c2a06b6565700a) 被当标题剥掉 → 「标题 1 行、实质正文 0 字符」
  1882	    → `建议删 + confident=true`。同一条规则的两半只修一半, 等于没修。
  1883	    """
  1884	    mod = load_module()
  1885	    # 纯函数半边: CommonMark §4.2 = 空格 / 制表符 / 行尾
  1886	    assert mod._HEADING_RE.match("# x"), "ASCII 空格必须仍是合法分隔"
  1887	    assert mod._HEADING_RE.match("#\tx"), "制表符是 CommonMark 合法分隔, 不得连坐收窄"
  1888	    assert mod._HEADING_RE.match("#"), "行尾 ATX (空标题) 必须仍成立"
  1889	    assert mod._HEADING_RE.match("   ###### x"), "3 空格缩进 + 六级标题仍成立"
  1890	    assert not mod._HEADING_RE.match("#\u00a0x"), "NBSP 不是 ATX 分隔 (round-8 BLOCKER-1)"
  1891	    # ⛔ 验伪锚: 防「按反例特判 NBSP」的窄修 —— 全角/EM 空格是同族 Unicode 空白
  1892	    assert not mod._HEADING_RE.match("#\u2003x"), "EM SPACE 同属 Unicode 空白, 不得只排 NBSP"
  1893	    assert not mod._HEADING_RE.match("#\u3000x"), "IDEOGRAPHIC SPACE 同上"
  1894	    assert not mod._HEADING_RE.match("#x"), "井号后无分隔本就不是标题 (口径不得放宽)"
  1895	
  1896	    # 端到端半边: 真实 CLI
  1897	    vault, out = base_vault(tmp_path)
  1898	    inbox = vault / "_待处理"
  1899	    mk(inbox / "井号NBSP.md", "#\u00a0keep\n", age_days=6)
  1900	    # ⛔ 正向对照(验伪锚): 井号后制表符**是**标题 → 无正文仍 C3 建议删。
  1901	    # 若有人把修复写成只认空格 `(?:[ ]|$)`, 本条会红。
  1902	    mk(inbox / "井号TAB标题.md", "#\tonly heading\n", age_days=5)
  1903	    # 正向对照: 顶格空格标题 + 无正文 → 仍 C3 建议删
  1904	    mk(inbox / "顶格标题.md", "# 标题\n\n## 小节\n", age_days=4)
  1905	
  1906	    assert run_cli(vault, out).returncode == 0
  1907	    data = load_json(out)
  1908	    assert data["items"], "items 为空则本门恒真 = 假绿"
  1909	    it = item_by_name(data, "井号NBSP.md")
  1910	    assert it["verdict"] != "建议删", f"NBSP 井号行被建议删了: {it['basis']}"
  1911	    assert it["criterion"] == "C6_undecided", it["criterion"]
  1912	    assert it["confident"] is False
  1913	    assert it["target_hint"] is None and it["nomination_type"] is None
  1914	    for name in ("井号TAB标题.md", "顶格标题.md"):
  1915	        ctrl = item_by_name(data, name)
  1916	        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
  1917	        assert ctrl["verdict"] == "建议删", name
