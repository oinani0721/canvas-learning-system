   529	def test_multiple_canonical_candidates_are_declared_not_asserted(tmp_path):
   530	    """⛔ HIGH 回归: 库内有多份同正文时, 不得把字典序第一个**断言**为正本。
   531	    建议删仍成立（收件箱这份相对它们是多余的）, 但「哪份是正本」必须明说不可判。"""
   532	    vault, out = base_vault(tmp_path)
   533	    body = "同一段被存过两次的正文。\n第二行。\n"
   534	    mk(vault / "节点" / "甲本.md", body, age_days=40)
   535	    (vault / "归档").mkdir()
   536	    mk(vault / "归档" / "乙本.md", body, age_days=39)
   537	    mk(vault / "_待处理" / "第三份.md", body, age_days=2)
   538	
   539	    assert run_cli(vault, out).returncode == 0
   540	    it = load_json(out)["items"][0]
   541	    assert it["criterion"] == "C4_exact_duplicate"
   542	    assert it["verdict"] == "建议删"
   543	    assert len(it["exact_duplicate_others"]) == 1
   544	    assert any(c["kind"] == "multiple_canonical_candidates" for c in it["conflicts"])
   545	    assert "不可判" in it["basis"]
