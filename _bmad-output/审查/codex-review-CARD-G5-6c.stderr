   859	def test_reject_overlong_product_name(tmp_path):
   860	    """255B 预检必须先于 out-dir 创建 —— 否则「拒绝但已留空目录」。"""
   861	    vault, out = base_vault(tmp_path)
   862	    # 240 字节（80 个三字节汉字）——单组件在 APFS/ext4 上都建得出来, 但产物名
   863	    # `inbox-preview-` + 240 + `.json` = 259 字节越界。⛔ 原先用 540 字节的目录名,
   864	    # 在 ext4 那种 255 **字节**上限的文件系统上 mkdir 自己就会失败, 测试根本走不到
   865	    # 被测守卫（Codex MEDIUM 的可移植性问题；本机 APFS 按字符计所以侥幸能跑）。
   866	    long_dir = vault / ("超" * 80)
   867	    long_dir.mkdir()
   868	    r = run_cli(vault, out, "--inbox-dir", str(long_dir))
   869	    assert r.returncode != 0
   870	    assert no_products(out)
   871	    assert not out.exists(), "拒绝路径不得留下空的 out-dir"
