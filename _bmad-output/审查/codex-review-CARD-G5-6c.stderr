   639	def test_engine_never_emits_human_only_verdicts(tmp_path):
   640	    """「归入白板」「新建节点」需要语义判断 —— 引擎恒不产出, 且必须显式声明该边界。"""
   641	    vault, out = base_vault(tmp_path)
   642	    inbox = vault / "_待处理"
   643	    mk(inbox / "a.md", "# A\n\n正文内容一。\n正文内容二。\n", age_days=3)
   644	    mk(inbox / "b.md", "---\nsource: https://x.test/p\n---\n\n正文。\n正文二。\n", age_days=2)
   645	
   646	    assert run_cli(vault, out).returncode == 0
   647	    data = load_json(out)
   648	    vocab = data["verdict_vocabulary"]
   649	    assert set(vocab["human_only"]) == {"归入白板", "新建节点"}
   650	    assert vocab["human_only_note"]
   651	    reachable = set(vocab["reachable_by_engine"])
   652	    assert {it["name"] for it in data["items"]} == {"a.md", "b.md"}, (
   653	        "件数先锁死 —— 循环门在 items 为空/缺件时恒真 = 假绿 (round-8 §三)"
   654	    )
   655	    for it in data["items"]:
   656	        assert it["verdict"] in reachable
   657	        assert it["verdict"] not in set(vocab["human_only"])
