   596	def test_criteria_order_c4_does_not_outrank_c2_c5(tmp_path):
   597	    """⛔ MEDIUM 回归: 次序覆盖不能只有 C1+C4 一对。
   598	    这里构造 C2/C5 与 C4 的冲突 —— 把实现里的 C4 上移到任一条之前, 本条必红。"""
   599	    vault, out = base_vault(tmp_path)
