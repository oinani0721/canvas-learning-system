  1310	def test_bare_ai_markers_are_removed_from_table():
  1311	    """⛔ H2 回归(表锁): 裸词「AI 生成」「AI生成」是「由 AI 生成」「由AI生成」的
  1312	    严格子串; 截断形态「本文由 AI」「本报告由 AI」被「由 AI 生成」覆盖断言形态 ——
  1313	    从表中删除不丢任何带断言锚的命中, 只丢话题提及类误命中。"""
  1314	    mod = load_module()
  1315	    assert "AI 生成" not in mod.AI_MARKERS
  1316	    assert "AI生成" not in mod.AI_MARKERS
  1317	    assert "本文由 AI" not in mod.AI_MARKERS
  1318	    assert "本报告由 AI" not in mod.AI_MARKERS
  1319	    # ⛔ round-8 §三(真空通过): 全 `not in` 的表锁门在 `AI_MARKERS=()` 时照样绿 ——
  1320	    # 「什么都没有」满足一切否定断言。先锁住表里**必须还留着**的断言锚形态。
  1321	    for kept in ("由 AI 生成", "由AI生成", "Generated by AI", "由 Deep Research 生成"):
  1322	        assert kept in mod.AI_MARKERS, f"断言锚形态被删空/误删: {kept}"
  1323	    assert len(mod.AI_MARKERS) == len(set(mod.AI_MARKERS)), "表内不得有重复项"
