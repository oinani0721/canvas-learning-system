  1662	def render_md(d: dict) -> str:
  1663	    L: list[str] = []
  1664	    L.append(f"# 待处理盘点 preview · {d['label']}")
  1665	    L.append("")
  1666	    L.append(f"> {d['not_executed_disclaimer']}")
  1667	    L.append(
  1668	        f"> 基准时刻 `--now`：{d['now_local']}（Asia/Shanghai）· schema v{d['schema_version']}"
  1669	    )
  1670	    L.append("")
  1671	    L.append("## 一、回执")
  1672	    L.append("")
  1673	    L.append(d["receipt"])
  1674	    L.append("")
  1675	    L.append(f"- 上次清仓：**不可得** —— {d['last_cleanup_note']}")
  1676	    c = d["corpus"]
  1677	    L.append(
  1678	        f"- 语料库：扫描 {c['files_scanned']} 份 .md，进重复索引 {c['files_indexed']} 份"
  1679	        f"（空正文 {c['skipped_empty_body']} 份不进索引 · symlink {c['skipped_symlink']} · "
  1680	        f"不可读 {c['skipped_unreadable']}）"
  1681	        + (
  1682	            "　⚠️ **已达扫描上限被截断**，「无重复」仅代表已扫部分"
  1683	            if c["truncated"]
  1684	            else ""
  1685	        )
  1686	    )
  1687	    L.append("")
  1688	
  1689	    L.append(f"## 二、本批提名（{len(d['items'])} 件，最旧优先）")
  1690	    L.append("")
  1691	    if not d["items"]:
  1692	        L.append("_（本批无材料）_")
  1693	    else:
  1694	        L.append("| # | 文件 | 年龄 | 建议去向 | 提名类型 | 判据 | 依据 | 冲突 |")
  1695	        L.append("|---|---|---|---|---|---|---|---|")
  1696	        for it in d["items"]:
  1697	            conflict = (
  1698	                "；".join(f"{x['kind']}" for x in it["conflicts"])
  1699	                if it["conflicts"]
  1700	                else "—"
  1701	            )
  1702	            target = f"（→ {it['target_hint']}）" if it["target_hint"] else ""
  1703	            L.append(
  1704	                "| {i} | {n} | {a} 天 | {v}{t} | {ty} | {c} | {b} | {cf} |".format(
  1705	                    i=it["index"],
  1706	                    n=md_cell(it["name"]),
  1707	                    a=it["age_days"],
  1708	                    v=md_cell(it["verdict"]),
  1709	                    t=md_cell(target),
  1710	                    ty=md_cell(it["nomination_type"] or "—"),
  1711	                    c=md_cell(it["criterion"]),
  1712	                    b=md_cell(it["basis"]),
  1713	                    cf=md_cell(conflict),
  1714	                )
  1715	            )
  1716	    L.append("")
  1717	
  1718	    unsure = [it for it in d["items"] if not it["confident"]]
  1719	    L.append(f"## 三、拿不准（{len(unsure)} 件 · 需你一句话）")
  1720	    L.append("")
  1721	    if not unsure:
  1722	        L.append("_（本批无拿不准条目）_")
  1723	    else:
  1724	        for it in unsure:
  1725	            L.append(f"- **{it['index']}. {it['name']}** —— {it['uncertain_reason']}")
  1726	            L.append(f"  - 请回一句：{it['ask']}")
  1727	    L.append("")
  1728	
  1729	    dups = [
  1730	        it for it in d["items"] if it["exact_duplicate_of"] or it["near_duplicates"]
  1731	    ]
  1732	    L.append("## 四、重复线索")
  1733	    L.append("")
  1734	    if not dups:
  1735	        L.append("_（本批未发现逐字重复或疑似高相似）_")
  1736	    else:
  1737	        for it in dups:
  1738	            if it["exact_duplicate_of"]:
  1739	                if it["exact_duplicate_others"]:
  1740	                    # ⛔ basis 已声明「哪一份算正本不可判」—— 人读 MD 不得再钦定
  1741	                    # 「正本 `字典序首项`」（round-2 H4：JSON 与 MD 自相矛盾）。
  1742	                    # 路径**不加反引号**：路径本身含反引号时 code span 会错配吃掉
  1743	                    # 字符，渲染出一个不存在的文件名（round-3 自审 H4-1）。
  1744	                    all_dups = [
  1745	                        it["exact_duplicate_of"],
  1746	                        *it["exact_duplicate_others"],
  1747	                    ]
  1748	                    L.append(
  1749	                        f"- **{it['name']}** · 与库内 {len(all_dups)} 份文件"
  1750	                        "逐字相同："
  1751	                        + "、".join(p.replace("`", "\\`") for p in all_dups)
  1752	                        + " —— 哪一份是正本不可判"
  1753	                        "（exact_duplicate_of 仅为字典序代表）"
  1754	                    )
  1755	                else:
  1756	                    L.append(
  1757	                        f"- **{it['name']}** · 逐字相同 → 正本 "
  1758	                        f"`{it['exact_duplicate_of'].replace(chr(96), chr(92) + chr(96))}`"
  1759	                    )
  1760	            for n in it["near_duplicates"]:
  1761	                L.append(
  1762	                    f"- **{it['name']}** · 疑似（ratio {n['ratio']}）→ `{n['path']}`"
  1763	                    "　— 疑似不等于重复，**不建议删**，需你确认"
  1764	                )
  1765	    s = d["near_dup_scan"]
  1766	    L.append("")
  1767	    L.append(
  1768	        f"> 近似比对：阈值 {s['ratio_threshold']}，实比 {s['compared_pairs']} 对；"
  1769	        f"因体积跳过 {s['skipped_oversize']} 对、因长度差跳过 {s['skipped_length_prefilter']} 对。"
  1770	        f"{s['note']}"
  1771	    )
  1772	    L.append("")
  1773	
  1774	    sl = d["sleeping"]
  1775	    L.append(f"## 五、Sleeping 台账（{sl['count']} 件）")
  1776	    L.append("")
  1777	    if not sl["items"]:
  1778	        L.append("_（Sleeping/ 未建立或为空）_")
  1779	    else:
  1780	        L.append("| 文件 | 睡了几天 | 起算依据 | 满 30 天 |")
  1781	        L.append("|---|---|---|---|")
  1782	        for x in sl["items"]:
  1783	            L.append(
  1784	                f"| {md_cell(x['name'])} | {x['slept_days']} | {md_cell(x['slept_at_source'])} "
  1785	                f"| {'⚠️ 是' if x['over_30d'] else '否'} |"
  1786	            )
  1787	    L.append("")
  1788	
  1789	    dfr = d["inventory"]["deferred"]
  1790	    L.append(f"## 六、本批之外（{len(dfr)} 件，本次不提名）")
  1791	    L.append("")
  1792	    if not dfr:
  1793	        L.append("_（无积压）_")
  1794	    else:
  1795	        for x in dfr:
  1796	            L.append(f"- {x['name']}（{x['age_days']} 天 · {x['mtime_local']}）")
  1797	    skp = d["inventory"]["skipped"]
  1798	    if skp:
  1799	        L.append("")
  1800	        L.append("**跳过留痕**（不静默消失）：")
  1801	        for x in skp:
  1802	            L.append(f"- {x['name']} —— {x['reason']}")
  1803	    L.append("")
  1804	
  1805	    L.append("## 七、引擎边界（如实声明）")
  1806	    L.append("")
  1807	    v = d["verdict_vocabulary"]
  1808	    L.append(f"- 引擎可达去向：{'、'.join(v['reachable_by_engine'])}")
  1809	    L.append(f"- **恒不产出**：{'、'.join(v['human_only'])} —— {v['human_only_note']}")
  1810	    L.append(
  1811	        "- 近似重复（difflib）**永不**产出建议删：**在重复这条判据里**，只有"
  1812	        "归一化正文逐字相等才建议删（另一个建议删的出口是「空/空骨架」，"
  1813	        "它跟像不像别的文件无关）；库内只有一份同正文时给正本路径，多份同正文时"
