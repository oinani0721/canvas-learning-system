   309	def test_c4_near_duplicate_never_suggests_delete(tmp_path):
   310	    """C4 反例(卡片核心红线): 高相似但非逐字相等 → 只标疑似·拿不准, 绝不建议删。"""
   311	    vault, out = base_vault(tmp_path)
   312	    lines = [f"第 {i} 行完全相同的内容。" for i in range(1, 41)]
   313	    mk(vault / "节点" / "长文正本.md", "# 正本\n\n" + "\n".join(lines) + "\n", age_days=40)
   314	    mutated = list(lines)
   315	    mutated[7] = "第 8 行被我改写过, 因此不是逐字重复。"
   316	    mk(vault / "_待处理" / "长文疑似.md", "# 疑似\n\n" + "\n".join(mutated) + "\n", age_days=2)
   317	
   318	    assert run_cli(vault, out).returncode == 0
   319	    it = load_json(out)["items"][0]
   320	    assert it["verdict"] != "建议删"
   321	    assert it["exact_duplicate_of"] is None
   322	    assert it["confident"] is False
   323	    assert it["near_duplicates"], "近似重复必须被记录并呈现给用户"
   324	    assert it["near_duplicates"][0]["path"] == "节点/长文正本.md"
   325	    assert 0.9 <= it["near_duplicates"][0]["ratio"] < 1.0
   326	    assert "疑似" in (it["uncertain_reason"] or "")
