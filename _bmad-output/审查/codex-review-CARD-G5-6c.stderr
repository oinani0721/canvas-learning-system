  1655	def test_ai_case_and_whitespace_variants_are_undigested(tmp_path):
  1656	    """⛔ round-5 BLOCKER-1: AI 声明的大小写/Unicode 空白变体不得穿透字面量表
  1657	    与裸子串护栏 —— `generated by ai`(全小写)、`GENERATED BY AI`(全大写)、
  1658	    内部 NBSP 形态都曾在无正文时掉进 C3 建议删 confident=true。C2 匹配与
  1659	    护栏信号共用归一化(casefold + 空白折叠)。"""
  1660	    vault, out = base_vault(tmp_path)
  1661	    inbox = vault / "_待处理"
  1662	    mk(inbox / "全小写AI声明.md", "---\ngenerator: generated by ai\n---\n", age_days=7)
  1663	    mk(inbox / "全大写AI声明.md", "---\ngenerator: GENERATED BY AI\n---\n", age_days=6)
  1664	    mk(inbox / "nbspAI声明.md", "---\ngenerator: Generated\xa0\xa0by\xa0AI\n---\n", age_days=5)
  1665	    # 正向对照: 无 AI 字样纯空骨架 → 仍 C3; 边界规则仍拒「生成」后挂字话题
  1666	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1667	    mk(
  1668	        inbox / "话题提及.md",
  1669	        "# 标题\n\n由 AI 生成内容的版权讨论。\n话题正文一。\n话题正文二。\n",
  1670	        age_days=3,
  1671	    )
  1672	
  1673	    assert run_cli(vault, out).returncode == 0
  1674	    data = load_json(out)
  1675	    for name in ("全小写AI声明.md", "全大写AI声明.md", "nbspAI声明.md"):
  1676	        it = item_by_name(data, name)
  1677	        # 归一化后这些行尾变体被 C2 **确定命中**（行尾满足 ASCII 边界）——
  1678	        # 比护栏 C6 更强且正确；关键是绝不再落 C3 建议删
  1679	        assert it["criterion"] == "C2_ai_self_declared", f"{name}: {it['basis']}"
  1680	        assert it["verdict"] == "归档", name
  1681	        assert "AI" in it["basis"], it["basis"]
  1682	    skeleton = item_by_name(data, "纯空骨架.md")
  1683	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1684	    assert skeleton["verdict"] == "建议删"
  1685	    topic = item_by_name(data, "话题提及.md")
  1686	    assert topic["criterion"] != "C2_ai_self_declared", "归一化不得扩 C2 到话题提及"
  1687	
