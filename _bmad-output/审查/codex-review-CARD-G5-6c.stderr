  1543	def build_receipt(data: dict) -> str:
  1544	    inv, sl = data["inventory"], data["sleeping"]
  1545	    if not data["inbox_exists"]:
  1546	        head = f"{data['inbox_dir']} 尚未创建（等同空仓，该 vault 还没开始用收件箱）。"
  1547	    elif inv["total"] == 0:
  1548	        head = f"{data['inbox_dir']} 已空，没有待处理材料。"
  1549	    else:
  1550	        head = f"{data['inbox_dir']} 共 {inv['total']} 件" + (
  1551	            f"，本批取最旧的 {len(data['items'])} 件（其余 {len(inv['deferred'])} 件留待下次）。"
  1552	            if inv["over_budget"]
  1553	            else f"，本批全取（{len(data['items'])} 件）。"
  1554	        )
  1555	    if not sl["exists"]:
  1556	        tail = "Sleeping/ 未建立，无睡眠台账。"
  1557	    elif sl["count"] == 0:
  1558	        tail = "Sleeping/ 是空的。"
  1559	    else:
  1560	        tail = f"Sleeping 睡着 {sl['count']} 件（最久 {sl['oldest_days']} 天"
  1561	        tail += (
  1562	            f"，其中 {sl['over_30d_count']} 件已睡满 {SLEEP_ALERT_DAYS} 天 ⚠️）。"
  1563	            if sl["over_30d_count"]
  1564	            else "）。"
  1565	        )
  1566	    return head + " " + tail
