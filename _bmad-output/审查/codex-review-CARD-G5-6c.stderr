  1689	def test_damaged_url_alias_is_undigested(tmp_path):
  1690	    """⛔ round-5 BLOCKER-2: 损坏 URL 的来源键别名不得穿透护栏 —— 信号③b 原
  1691	    要求「值过合法 URL 判定」，`Source: https://:443/x`(损坏) 因此被当不存在
  1692	    而建议删。URL 前缀形态即算来源声明(与 source 键的 fail-closed 同口径)。"""
  1693	    vault, out = base_vault(tmp_path)
  1694	    inbox = vault / "_待处理"
  1695	    mk(inbox / "坏Source别名.md", "---\nSource: https://:443/x\n---\n", age_days=6)
  1696	    body = "别名键重复件的正文。\n第二行。\n"
  1697	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1698	    mk(
  1699	        vault / "_待处理" / "坏url别名重复.md",
  1700	        "---\nurl: https://:443/broken\n---\n" + body,
  1701	        age_days=5,
  1702	    )
  1703	    # 正向对照: 值不是 URL 的别名键 → 不触发 → 纯空骨架仍 C3
  1704	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1705	
  1706	    assert run_cli(vault, out).returncode == 0
  1707	    data = load_json(out)
  1708	    for name in ("坏Source别名.md", "坏url别名重复.md"):
  1709	        it = item_by_name(data, name)
  1710	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1711	        assert it["criterion"] == "C6_undecided", name
  1712	        assert ":443" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
  1713	    skeleton = item_by_name(data, "纯空骨架.md")
  1714	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1715	    assert skeleton["verdict"] == "建议删"
