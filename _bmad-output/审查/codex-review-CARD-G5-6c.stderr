  1627	def test_slept_at_is_undigested_signal(tmp_path):
  1628	    """⛔ round-5 自审 F3 (MEDIUM): slept_at 是引擎自己在 Sleeping 台账解析的
  1629	    账本状态键 —— 收件箱文件带它意味着「从 Sleeping 移回、正待处置」。
  1630	    带 slept_at 的重复件/骨架件曾被建议删且起睡时间戳零留痕。"""
  1631	    vault, out = base_vault(tmp_path)
  1632	    body = "从 Sleeping 移回来的正文。\n第二行。\n"
  1633	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1634	    mk(
  1635	        vault / "_待处理" / "移回重复件.md",
  1636	        "---\ntitle: 移回\nslept_at: 2026-08-01\n---\n" + body,
  1637	        age_days=5,
  1638	    )
  1639	    mk(vault / "_待处理" / "移回骨架.md", "---\nslept_at: 2026-07-01\n---\n\n# 只有标题\n", age_days=4)
  1640	    # 正向对照: 无 slept_at 的重复件 → 仍 C4 建议删
  1641	    mk(vault / "_待处理" / "普通重复件.md", body, age_days=3)
  1642	
  1643	    assert run_cli(vault, out).returncode == 0
  1644	    data = load_json(out)
  1645	    for name in ("移回重复件.md", "移回骨架.md"):
  1646	        it = item_by_name(data, name)
  1647	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1648	        assert it["criterion"] == "C6_undecided", name
  1649	        assert "slept_at" in (it["uncertain_reason"] or ""), name
  1650	    dup = item_by_name(data, "普通重复件.md")
  1651	    assert dup["criterion"] == "C4_exact_duplicate"
  1652	    assert dup["verdict"] == "建议删"
