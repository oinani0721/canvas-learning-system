     1	#!/usr/bin/env python3
     2	"""CARD-G5-6c 负控：三条回退变异，各须由**指定的那道门**杀死。
     3	
     4	判据（逐条硬门，缺一即 FAIL）：
     5	  1. 指定 nodeid 必须出现在 FAILED 列表里 —— 「某处有失败」不算，
     6	     必须是那道门红（reference_gate_design_pitfalls）。
     7	  2. rc=5（no tests collected）不算红 —— 那是没跑，不是抓到了。
     8	  3. 每条变异串行执行，跑完立刻还原并**逐字节**比对 sha256
     9	     （reference_mutation_script_serial_only + temp_file_swap_needs_exit_trap）。
    10	  4. 每条变异回退**该缺陷的全部防线层**，不只一层 ——
    11	     只改一层会被纵深兜住，误判门不承重（reference_mutation_must_disable_all_layers）。
    12	
    13	⛔ 本脚本原地修改 checkout 源码，必须串行、必须独占运行。
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import hashlib
    19	import pathlib
    20	import subprocess
    21	import sys
    22	
    23	ROOT = pathlib.Path(sys.argv[1]).resolve()
    24	SRC = ROOT / "canvas-vault/.claude/skills/clear-inbox/scripts/inbox_preview.py"
    25	TESTFILE = "tests/skills/test_g5_6_clear_inbox.py"
    26	BACKEND = ROOT / "backend"
    27	PYTEST = [str(BACKEND / ".venv/bin/pytest"), TESTFILE, "-q", "-p", "no:cacheprovider"]
    28	
    29	# ── 三条变异：(名字, 指定必杀门, [(old, new), ...] 全部防线层) ──
    30	MUTATIONS = [
    31	    (
    32	        "M-NBSP  井号后分隔回退到 Unicode \\s",
    33	        "test_nbsp_after_hash_is_not_an_atx_heading",
    34	        [
    35	            (
    36	                r'_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:[ \t]|$)")',
    37	                r'_HEADING_RE = re.compile(r"^ {0,3}#{1,6}(?:\s|$)")',
    38	            )
    39	        ],
    40	    ),
    41	    (
    42	        "M-AI    生成断言结构 + 生成器键两层全回退",
    43	        "test_model_version_generation_claim_is_undigested_signal",
    44	        [
    45	            ("    gen_claim = find_generation_claim(text)\n", "    gen_claim = None\n"),
    46	            (
    47	                "    generator_keys = [k for k in fm if _norm_fm_key(k) in _GENERATOR_DECL_KEYS]\n",
    48	                "    generator_keys = []\n",
    49	            ),
    50	        ],
    51	    ),
    52	    (
    53	        "M-DOI   来源键名归一 + DOI 值形态两层全回退",
    54	        "test_doi_source_identifier_blocks_deletion",
    55	        [
    56	            (
    57	                "    source_alias_keys = [k for k in fm if _norm_fm_key(k) in _SOURCE_DECL_KEYS]\n",
    58	                '    source_alias_keys = [k for k in fm if k == "source"]\n',
    59	            ),
    60	            (
    61	                "    doi_bearing_keys = [k for k, v in fm.items() if _looks_like_doi_value(v)]\n",
    62	                "    doi_bearing_keys = []\n",
    63	            ),
    64	        ],
    65	    ),
    66	]
    67	
    68	
    69	def sha(p: pathlib.Path) -> str:
    70	    return hashlib.sha256(p.read_bytes()).hexdigest()
    71	
    72	
    73	def run_suite() -> tuple[int, list[str], str]:
    74	    r = subprocess.run(
    75	        PYTEST,
    76	        cwd=BACKEND,
    77	        capture_output=True,
    78	        text=True,
    79	        env={
    80	            "PATH": "/usr/bin:/bin",
    81	            "PYTHONDONTWRITEBYTECODE": "1",
    82	            "HOME": str(pathlib.Path.home()),
    83	            "LC_ALL": "C.UTF-8",
    84	        },
    85	    )
    86	    out = r.stdout + r.stderr
    87	    failed = [
    88	        ln.split("::")[1].split(" ")[0].strip()
    89	        for ln in out.splitlines()
    90	        if ln.startswith("FAILED ") and "::" in ln
    91	    ]
    92	    tail = [
    93	        ln
    94	        for ln in out.splitlines()
    95	        if "passed" in ln or "failed" in ln or "error" in ln
    96	    ]
    97	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
    98	
    99	
   100	original = SRC.read_bytes()
   101	base_sha = sha(SRC)
   102	print(f"源码基线 sha256 = {base_sha}\n")
   103	
   104	results: list[tuple[str, bool, str]] = []
   105	try:
   106	    for name, target_gate, layers in MUTATIONS:
   107	        text = original.decode("utf-8")
   108	        for old, new in layers:
   109	            n = text.count(old)
   110	            if n != 1:
   111	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   112	            text = text.replace(old, new)
   113	        SRC.write_text(text, encoding="utf-8")
   114	        assert sha(SRC) != base_sha, f"[{name}] 变异没有真的改到字节"
   115	
   116	        rc, failed, summary = run_suite()
   117	
   118	        # 还原 + 逐字节比对（每条变异跑完立刻还原，串行不重叠）
   119	        SRC.write_bytes(original)
   120	        restored = sha(SRC)
   121	
   122	        killed = target_gate in failed
   123	        ok = killed and rc not in (0, 5) and restored == base_sha
   124	        detail = (
   125	            f"rc={rc} | {summary} | 指定门{'已' if killed else '未'}被杀"
   126	            f" | 连带红 {len(failed)} 门 | 还原 sha {'一致' if restored == base_sha else '⛔不一致'}"
   127	        )
   128	        results.append((name, ok, detail))
   129	        print(
   130	            f"{'✅' if ok else '❌'} {name}\n   目标门 {target_gate}\n   {detail}\n"
   131	            f"   FAILED: {failed}\n"
   132	        )
   133	finally:
   134	    SRC.write_bytes(original)
   135	    final = sha(SRC)
   136	    print(
   137	        f"finally 还原后 sha256 = {final} "
   138	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   139	    )
   140	
   141	print("\n" + "=" * 70)
   142	allok = (
   143	    all(ok for _, ok, _ in results)
   144	    and sha(SRC) == base_sha
   145	    and len(results) == len(MUTATIONS)
   146	)
   147	print(
   148	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   149	    f"（{sum(1 for _, ok, _ in results if ok)}/{len(MUTATIONS)} 变异各由指定门杀死）"
   150	)
   151	sys.exit(0 if allok else 1)

