  1529	def _parse_slept_at(raw: str) -> datetime | None:
  1530	    if not raw:
  1531	        return None
  1532	    try:
  1533	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  1534	    except ValueError:
  1535	        try:
  1536	            d = date.fromisoformat(raw)
  1537	        except ValueError:
  1538	            return None
  1539	        dt = datetime(d.year, d.month, d.day)
  1540	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
