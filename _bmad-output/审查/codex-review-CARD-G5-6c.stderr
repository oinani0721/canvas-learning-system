   577	+# ───── I. round-8 定向整改回归门 (CARD-G5-6c: NBSP 标题 / 模型声明 / DOI 来源) ─────
   578	+
   579	+
   580	+def test_nbsp_after_hash_is_not_an_atx_heading(tmp_path):
   581	+    """⛔ round-8 BLOCKER-1: ATX 的**井号后分隔**也只认 ASCII 空格/制表符。
   582	+
   583	+    前置缩进在 round-7 已收窄为字面空格, 但 `#{1,6}` 后仍写着 `(?:\\s|$)` ——
   584	+    Python `re` 的 `\\s` 在 str 模式下是 Unicode 语义, `#\\xa0keep`
   585	+    (字节 23c2a06b6565700a) 被当标题剥掉 → 「标题 1 行、实质正文 0 字符」
   586	+    → `建议删 + confident=true`。同一条规则的两半只修一半, 等于没修。
   587	+    """
   588	+    mod = load_module()
   589	+    # 纯函数半边: CommonMark §4.2 = 空格 / 制表符 / 行尾
   590	+    assert mod._HEADING_RE.match("# x"), "ASCII 空格必须仍是合法分隔"
   591	+    assert mod._HEADING_RE.match("#\tx"), "制表符是 CommonMark 合法分隔, 不得连坐收窄"
   592	+    assert mod._HEADING_RE.match("#"), "行尾 ATX (空标题) 必须仍成立"
   593	+    assert mod._HEADING_RE.match("   ###### x"), "3 空格缩进 + 六级标题仍成立"
   594	+    assert not mod._HEADING_RE.match("#\u00a0x"), "NBSP 不是 ATX 分隔 (round-8 BLOCKER-1)"
   595	+    # ⛔ 验伪锚: 防「按反例特判 NBSP」的窄修 —— 全角/EM 空格是同族 Unicode 空白
   596	+    assert not mod._HEADING_RE.match("#\u2003x"), "EM SPACE 同属 Unicode 空白, 不得只排 NBSP"
   597	+    assert not mod._HEADING_RE.match("#\u3000x"), "IDEOGRAPHIC SPACE 同上"
   598	+    assert not mod._HEADING_RE.match("#x"), "井号后无分隔本就不是标题 (口径不得放宽)"
   599	+
   600	+    # 端到端半边: 真实 CLI
   601	+    vault, out = base_vault(tmp_path)
   602	+    inbox = vault / "_待处理"
   603	+    mk(inbox / "井号NBSP.md", "#\u00a0keep\n", age_days=6)
   604	+    # ⛔ 正向对照(验伪锚): 井号后制表符**是**标题 → 无正文仍 C3 建议删。
   605	+    # 若有人把修复写成只认空格 `(?:[ ]|$)`, 本条会红。
   606	+    mk(inbox / "井号TAB标题.md", "#\tonly heading\n", age_days=5)
   607	+    # 正向对照: 顶格空格标题 + 无正文 → 仍 C3 建议删
   608	+    mk(inbox / "顶格标题.md", "# 标题\n\n## 小节\n", age_days=4)
   609	+
   610	+    assert run_cli(vault, out).returncode == 0
   611	+    data = load_json(out)
   612	+    assert data["items"], "items 为空则本门恒真 = 假绿"
   613	+    it = item_by_name(data, "井号NBSP.md")
   614	+    assert it["verdict"] != "建议删", f"NBSP 井号行被建议删了: {it['basis']}"
   615	+    assert it["criterion"] == "C6_undecided", it["criterion"]
   616	+    assert it["confident"] is False
   617	+    assert it["target_hint"] is None and it["nomination_type"] is None
   618	+    for name in ("井号TAB标题.md", "顶格标题.md"):
   619	+        ctrl = item_by_name(data, name)
   620	+        assert ctrl["criterion"] == "C3_empty_or_skeleton", f"{name}: {ctrl['basis']}"
   621	+        assert ctrl["verdict"] == "建议删", name
   622	+
   623	+
   624	+def test_model_version_generation_claim_is_undigested_signal(tmp_path):
   625	+    """⛔ round-8 BLOCKER-2: 带模型版本的真实生成声明穿透三层护栏。
   626	+
   627	+    `generator: 由 GPT-4 生成` 既不在有限表 (表只到 `由 GPT 生成`, 差一个版本号),
   628	+    也没有独立词「AI」 → 无正文时 `建议删 + confident=true`。
   629	+    修法按**声明骨架**而非**枚举模型名** (卡文 §3 默认裁决): 模型名是开放集合,
   630	+    `由 <某物> 生成` / `generated by <某物>` 这个断言骨架是闭合的。
   631	+    ⚠️ 只降 C6, 绝不进 C2 —— 宽匹配给话题提及发确定归档就是硬猜。
   632	+    """
   633	+    vault, out = base_vault(tmp_path)
   634	+    inbox = vault / "_待处理"
   635	+    # round-8 反例原样
   636	+    mk(inbox / "GPT4声明.md", "---\ngenerator: 由 GPT-4 生成\n---\n", age_days=9)
   637	+    # ⛔ 同族(不得靠枚举): 换任意模型名/版本号都必须接住
   638	+    mk(inbox / "Gemini声明.md", "---\nnote: 本文由 Gemini 2.5 Pro 生成\n---\n", age_days=8)
   639	+    mk(inbox / "英文声明.md", "---\nnote: Generated by Llama-4-Maverick\n---\n", age_days=7)
   640	+    # 字段半边: 值里根本没有「生成」二字, 只有键名在声明
   641	+    mk(inbox / "仅键名声明.md", "---\ngenerator: claude-opus-4\n---\n", age_days=6)
   642	+    # C4 出口也必须拦(护栏是路径属性, 不能只拦 C3)
   643	+    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
   644	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   645	+    mk(inbox / "声明重复件.md", "---\ngenerator: 由 GPT-4o 生成\n---\n" + body, age_days=5)
   646	+    # 正向对照: 无任何生成声明的纯空骨架 → 仍 C3 建议删
   647	+    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
   648	+
   649	+    assert run_cli(vault, out).returncode == 0
   650	+    data = load_json(out)
   651	+    assert data["items"], "items 为空则本门恒真 = 假绿"
   652	+    for name in ("GPT4声明.md", "Gemini声明.md", "英文声明.md"):
   653	+        it = item_by_name(data, name)
   654	+        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
   655	+        assert it["criterion"] == "C6_undecided", name
   656	+        assert it["confident"] is False, name
   657	+        assert it["target_hint"] is None and it["nomination_type"] is None, name
   658	+        assert "生成断言结构" in (it["uncertain_reason"] or ""), it["uncertain_reason"]
   659	+    key_only = item_by_name(data, "仅键名声明.md")
   660	+    assert key_only["verdict"] != "建议删", key_only["basis"]
   661	+    assert key_only["criterion"] == "C6_undecided"
   662	+    assert "生成器声明键" in (key_only["uncertain_reason"] or ""), key_only["uncertain_reason"]
   663	+    dup = item_by_name(data, "声明重复件.md")
   664	+    assert dup["verdict"] != "建议删", f"带生成声明的重复件被建议删了: {dup['basis']}"
   665	+    assert dup["criterion"] == "C6_undecided"
   666	+    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
   667	+    # ⛔ 信号只降级, 不扩大 C2: 这些文件不得被判成「AI 自述 → 确定归档」
   668	+    for name in ("GPT4声明.md", "Gemini声明.md", "英文声明.md", "仅键名声明.md"):
   669	+        assert item_by_name(data, name)["criterion"] != "C2_ai_self_declared", name
   670	+    skeleton = item_by_name(data, "纯空骨架.md")
   671	+    assert skeleton["criterion"] == "C3_empty_or_skeleton"
   672	+    assert skeleton["verdict"] == "建议删"
   673	+
   674	+
   675	+def test_doi_source_identifier_blocks_deletion(tmp_path):
   676	+    """⛔ round-8 HIGH: `Source: DOI:10.1000/xyz` 的唯一来源标识被当作不存在。
   677	+
   678	+    两处缺口: `"source" in fm` 是**大小写敏感**的字面查找(取不到 `Source`),
   679	+    而值不含 `http(s)://` 时 `url_bearing_keys` 也接不住 → C3 `建议删 +
   680	+    confident=true`。护栏两侧都补: 键名归一(大小写/连字符) + DOI 值形态。
   681	+    ⚠️ DOI **不冒充 URL 也不升 C1**(卡文 §3): 只把来源摆上台面降 C6。
   682	+    """
   683	+    vault, out = base_vault(tmp_path)
   684	+    inbox = vault / "_待处理"
   685	+    # round-8 反例原样
   686	+    mk(inbox / "DOI来源.md", "---\nSource: DOI:10.1000/xyz\n---\n", age_days=9)
   687	+    # 键名归一半边: 值不是 URL 也不是 DOI, 靠键名接住
   688	+    mk(inbox / "大写SOURCE手抄.md", "---\nSOURCE: 手抄自 2019 年讲义 P37\n---\n", age_days=8)
   689	+    # 值形态半边: 键名不在别名表, 靠 DOI 形态接住
   690	+    mk(inbox / "identifier键DOI.md", "---\nidentifier: 10.1145/3292500.3330701\n---\n", age_days=7)
   691	+    # C4 出口也必须拦
   692	+    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
   693	+    mk(vault / "节点" / "库内正本.md", body, age_days=40)
   694	+    mk(inbox / "DOI重复件.md", "---\ndoi: 10.1000/dup-only\n---\n" + body, age_days=6)
   695	+    # 正向对照 1: 无来源声明的纯空骨架 → 仍 C3 建议删
   696	+    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=5)
   697	+    # 正向对照 2: 合法 source URL → 仍 C1(护栏不得扩大也不得挤掉判据)
   698	+    mk(inbox / "正常剪藏.md", "---\nsource: https://ok.test/clip\n---\n", age_days=4)
   699	+
   700	+    assert run_cli(vault, out).returncode == 0
   701	+    data = load_json(out)
   702	+    assert data["items"], "items 为空则本门恒真 = 假绿"
   703	+    for name, frag in (
   704	+        ("DOI来源.md", "DOI:10.1000/xyz"),
   705	+        ("大写SOURCE手抄.md", "讲义 P37"),
   706	+        ("identifier键DOI.md", "10.1145/3292500.3330701"),
   707	+    ):
   708	+        it = item_by_name(data, name)
   709	+        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
   710	+        assert it["criterion"] == "C6_undecided", name
   711	+        assert it["confident"] is False, name
   712	+        assert it["target_hint"] is None and it["nomination_type"] is None, name
   713	+        # ⛔ 来源标识必须逐字留痕 —— 否则「拦住了」等于把线索一起吞掉
   714	+        assert frag in (it["uncertain_reason"] or ""), it["uncertain_reason"]
   715	+    # ⛔ DOI 不冒充 URL / 不升 C1
   716	+    doi_item = item_by_name(data, "DOI来源.md")
   717	+    assert doi_item["criterion"] != "C1_source_url", "DOI 不得被判成一手 URL"
   718	+    assert "DOI" in (doi_item["uncertain_reason"] or "")
   719	+    dup = item_by_name(data, "DOI重复件.md")
   720	+    assert dup["verdict"] != "建议删", f"带 DOI 的重复件被建议删了: {dup['basis']}"
   721	+    assert dup["criterion"] == "C6_undecided"
   722	+    assert dup["exact_duplicate_of"] == "节点/库内正本.md", "重复证据仍须留痕"
   723	+    skeleton = item_by_name(data, "纯空骨架.md")
   724	+    assert skeleton["criterion"] == "C3_empty_or_skeleton"
   725	+    assert skeleton["verdict"] == "建议删"
   726	+    primary = item_by_name(data, "正常剪藏.md")
   727	+    assert primary["criterion"] == "C1_source_url"
   728	+    assert primary["verdict"] == "留原地"

