  .name=="ADV-重复DOI-C3.md" or
  .name=="ADV-重复DOI-C4.md" or
  .name=="ADV-重复URL.md"
)|{name,criterion,verdict,confident,exact_duplicate_of,uncertain_reason,basis}' \
  "$B/adversarial/out/inbox-preview-_待处理.json"
```

