   249	+#!/usr/bin/env python3
   250	+"""CARD-G5-6c round-8 三条新反例的 tmp fixture 落盘 + 字节自证。
   251	+
   252	+不可见字符一律走 \\uXXXX 转义写，禁止在源码里直接敲 —— 编辑器/工具链
   253	+会把 NBSP 与普通空格互换，肉眼与 diff 都看不出来。
   254	+"""
   255	+
   256	+import pathlib
   257	+import sys
   258	+
   259	+REPRO = pathlib.Path(sys.argv[1])
   260	+
   261	+CASES = {
   262	+    # round-8 BLOCKER-1：`#` + U+00A0 + `keep` + 换行，权威字节 23c2a06b6565700a
   263	+    "NEW_HEADING": ("hash-NBSP.md", "#\u00a0keep\n"),
   264	+    # round-8 BLOCKER-2：带模型版本的真实生成声明
   265	+    "NEW_AI": ("GPT4声明.md", "---\ngenerator: 由 GPT-4 生成\n---\n"),
   266	+    # round-8 HIGH：大写 Source 键 + DOI 来源标识
   267	+    "NEW_SOURCE": ("DOI来源.md", "---\nSource: DOI:10.1000/xyz\n---\n"),
   268	+}
   269	+
   270	+EXPECTED_HEX = {"NEW_HEADING": "23c2a06b6565700a"}
   271	+
   272	+for key, (name, body) in CASES.items():
   273	+    p = REPRO / key / "vault" / "_待处理" / name
   274	+    raw = body.encode("utf-8")
   275	+    p.write_bytes(raw)
   276	+    print(f"{key:12s} {name:16s} {len(raw):3d} bytes  hex={raw.hex()}")
   277	+    want = EXPECTED_HEX.get(key)
   278	+    if want is not None and raw.hex() != want:
   279	+        raise SystemExit(f"字节不符权威取证值：{key} 期望 {want} 实得 {raw.hex()}")
