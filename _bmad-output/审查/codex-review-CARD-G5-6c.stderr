  1588	def test_source_like_keys_are_undigested_signals(tmp_path):
  1589	    """⛔ round-5 自审 F2 (BLOCKER): 来源声明信号不能只认字面 source 键 ——
  1590	    `url:`/`URL:`/`Source:` 等剪藏工具常见键名曾穿透全部信号: 无正文判 C3 建议删、
  1591	    带独有 URL 的重复件判 C4 建议删且 URL 零留痕。任意键的值为合法 URL 形态
  1592	    即为来源声明信号(降 C6); C1 仍只认 source 键(R8 稿约定), 信号只降级不扩大。"""
  1593	    vault, out = base_vault(tmp_path)
  1594	    inbox = vault / "_待处理"
  1595	    mk(inbox / "url键书签.md", "---\nurl: https://clip.example/article-42\n---\n", age_days=7)
  1596	    mk(inbox / "大写Source键.md", "---\nSource: https://clip.example/other\n---\n", age_days=6)
  1597	    body = "这份正文和库里那份一字不差。\n第二行也相同。\n"
  1598	    mk(vault / "节点" / "库内正本.md", body, age_days=40)
  1599	    mk(
  1600	        inbox / "url键重复件.md",
  1601	        "---\nurl: https://unique-source.example/a\n---\n" + body,
  1602	        age_days=5,
  1603	    )
  1604	    # 正向对照 1: 值不是 URL 的键不触发信号 → 纯空骨架仍 C3
  1605	    mk(inbox / "纯空骨架.md", "---\ntitle: t\n---\n\n# 只有标题\n", age_days=4)
  1606	    # 正向对照 2: source 键 + 合法 URL → 仍 C1 (信号不扩大 C1)
  1607	    mk(inbox / "source键书签.md", "---\nsource: https://ok.test/x\n---\n", age_days=3)
  1608	
  1609	    assert run_cli(vault, out).returncode == 0
  1610	    data = load_json(out)
  1611	    for name in ("url键书签.md", "大写Source键.md"):
  1612	        it = item_by_name(data, name)
  1613	        assert it["verdict"] != "建议删", f"{name} 被建议删了: {it['basis']}"
  1614	        assert it["criterion"] == "C6_undecided", name
  1615	        assert "clip.example" in (it["uncertain_reason"] or ""), name
  1616	    dup = item_by_name(data, "url键重复件.md")
  1617	    assert dup["verdict"] != "建议删", f"URL 重复件被建议删了: {dup['basis']}"
  1618	    assert dup["exact_duplicate_of"] == "节点/库内正本.md"
  1619	    assert "unique-source.example" in (dup["uncertain_reason"] or "")
  1620	    skeleton = item_by_name(data, "纯空骨架.md")
  1621	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  1622	    assert skeleton["verdict"] == "建议删"
  1623	    primary = item_by_name(data, "source键书签.md")
  1624	    assert primary["criterion"] == "C1_source_url"
  1625	
