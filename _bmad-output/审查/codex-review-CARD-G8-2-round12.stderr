    77	def get_wikilinks(filepath: Path, *,
    78	                  exclude_canvas: bool = True) -> list[str]:
    79	    """Get ALL wikilinks from a md file.
    80	    The links' order of appearance in the file IS preserved in the output.
    81	
    82	    This accounts for:
    83	    - Aliases / alt text, so [[Lorem ipsum|L.I.]]
    84	    will be represented as 'Lorem ipsum'.
    85	    - Header text links, so [[Lorem ipsum#Dummy text]]
    86	    will be represented as 'Lorem ipsum'.
    87	
    88	    The links' order of appearance in the file IS preserved in the output.
    89	
    90	    Args:
    91	        filepath (pathlib Path): Path object representing the file from
    92	            which info will be extracted.
    93	        exclude_canvas (bool): Defaults to True. Exclude canvas files from
    94	            the list of wikilinks.
    95	
    96	    Returns:
    97	        list of strings
    98	    """
    99	    src_txt = get_source_text_from_md_file(filepath, remove_code=True)
   100	
   101	    wikilinks = _get_all_wikilinks_from_source_text(
   102	        src_txt, remove_aliases=True,
   103	        exclude_canvas=exclude_canvas)
   104	    return wikilinks
