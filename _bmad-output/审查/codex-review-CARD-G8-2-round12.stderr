+def _raw_wikilink_targets_in_lines(src_lines: list[str], line_lo: int, line_hi: int) -> set[str]:
+    """原文行区间 [line_lo, line_hi) 内、**未被反斜杠转义**的裸 wikilink target 集合
+    （已归一）。转义判定含反斜杠奇偶（`` \\\\[[A]] `` 的成对反斜杠后是真链接）。"""
+    targets: set[str] = set()
+    for i in range(line_lo, min(line_hi, len(src_lines))):
+        line = src_lines[i]
+        for m in _WIKILINK.finditer(line):
+            backslashes = 0
+            k = m.start() - 1
+            while k >= 0 and line[k] == "\\":
+                backslashes += 1
+                k -= 1
+            if backslashes % 2 == 1:
+                continue  # 被转义的 [[ 不是链接起点
+            inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
+            inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
+            if inner:
+                targets.add(_norm_key(inner))
+    return targets
+
+
+def _wikilink_targets(body: str) -> tuple[set[str], list[str]]:
