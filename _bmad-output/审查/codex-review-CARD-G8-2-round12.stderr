   414	def _raw_wikilink_targets_in_lines(src_lines: list[str], line_lo: int, line_hi: int) -> set[str]:
   415	    """原文行区间 [line_lo, line_hi) 内、**未被反斜杠转义**的裸 wikilink target 集合
   416	    （已归一）。转义判定含反斜杠奇偶（`` \\\\[[A]] `` 的成对反斜杠后是真链接）。"""
   417	    targets: set[str] = set()
   418	    for i in range(line_lo, min(line_hi, len(src_lines))):
   419	        line = src_lines[i]
   420	        for m in _WIKILINK.finditer(line):
   421	            backslashes = 0
   422	            k = m.start() - 1
   423	            while k >= 0 and line[k] == "\\":
   424	                backslashes += 1
   425	                k -= 1
   426	            if backslashes % 2 == 1:
   427	                continue  # 被转义的 [[ 不是链接起点
   428	            inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   429	            inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   430	            if inner:
   431	                targets.add(_norm_key(inner))
   432	    return targets
   433	
   434	
   435	def _wikilink_targets(body: str) -> tuple[set[str], list[str]]:
   436	    """正文里全部 wikilink 的 basename 集合（已归一）+ AUTO 段结构异常清单 —— **token 流法**。
   437	
   438	    ⛔ round-7 终局重构（r9 H1/H2/H3 再修）：rounds 2-7 手写的 Markdown 剥除/区间解析
   439	      （正则反向引用 → maximal run 配对 → 字符偏移区间 → AUTO 切分逐段解析）每轮
   440	      修复都开新洞。重演 G8-1 的核心教训「不重新实现解析」：
   441	      - `_blind_auto_lines` 先把 AUTO 哨兵段盲化为**保留缩进与 fence 标记行**的等行数
   442	        注释行（Markdown 连续性与容器上下文不破坏），返回 AUTO 原文行号集合；
   443	      - 整文喂 **markdown-it-py**（venv 既有依赖 4.0.0, 各轮审查的对照裁判）：
   444	        block 级 fence/code_block/html_block 整块不扫；inline 级只扫 `text` children；
   445	        closer 等长 / 转义反引号 / maximal run / 跨段落 / 容器嵌套全部库内正确处理；
   446	      - ⛔ r9 H3：decoded match 逐个绑定**原文裸 target 集合**——inline token 的
   447	        `map` 原文行区间内, `_raw_wikilink_targets_in_lines` 收集的裸 target（含反斜杠
   448	        奇偶转义判定）必须包含该 decoded target 才采纳。解码形态（实体/转义/混合）
   449	        在原文无对应裸链接时一律拒绝, 且**逐 match 绑定**而非整 token 放行。
   450	
   451	    ⛔ orphan 权威口径（r8 M4, 待用户裁决）：本检查按 **markdown-it-py 4.0.0 的可渲染
   452	      文本**裁判 wikilink; 生产图（`wikilink_graph_service.Vault.connect()`）与 Obsidian
   453	      实际渲染的口径可能不同（如 HTML 标签内 wikilink）—— 差异为已声明口径边界。
   454	
   455	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   456	    （`_WIKILINK` + `wikilink_basename`）与 `board_manifest_service.py:132`
   457	    （`resolve_node_id`）—— 三者本就同规则。
   458	
   459	    ⛔ **复制而非 import** sync 脚本本身, 理由是零写铁律: 它位于 **live vault 内**
   460	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   461	       `__pycache__` (MEMORY `reference_importlib_pycache_writes_into_vault`)。
   462	       复制的代价 = 会漂; 行为等价由 `test_wikilink_targets_matches_sync_board_concepts`
   463	       同源锁测试绑定（live sync 脚本可读时逐字对照）。
   464	
   465	    覆盖形态（各有测试用例）：`[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` /
   466	    `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`（含 `.MD` 大写）。**不**覆盖：AUTO 哨兵段
   467	    （含未闭合到 EOF 与嵌套 BEGIN）、fenced/indented code、行内 code、HTML 注释/块、
   468	    blockquote/list 容器内的 code、转义反引号、跨行 `[[..]]`、空 `[[]]`、`\\[\\[` 转义
   469	    方括号（含奇偶判定）、HTML 实体形式的 `[[`、**decoded target 在原文无裸对应**的
   470	    一切形态。
   471	    """
   472	    blinded, auto_line_indices, auto_anomalies = _blind_auto_lines(body)
   473	    src_lines = body.split("\n")
   474	    md = _md_parser()
   475	    out: set[str] = set()
   476	    for token in md.parse(blinded):
   477	        if token.type != "inline" or not token.children:
   478	            continue  # fence/code_block/html_block 等 block 级: 整块不扫
   479	        token_map = token.map or [0, 1]
   480	        # ⛔ r9 H3: 原文裸 target 集合（token 所在原文行区间, 含转义奇偶判定）——
   481	        # decoded match 逐个绑定: 只有原文确实存在的裸链接才采纳。
   482	        raw_targets = _raw_wikilink_targets_in_lines(src_lines, token_map[0], token_map[1])
   483	        if not raw_targets:
   484	            continue
   485	        for child in token.children:
   486	            if child.type != "text" or "[[" not in child.content:
   487	                continue  # code_inline/html_inline/softbreak 等: 不扫
   488	            for m in _WIKILINK.finditer(child.content):
   489	                inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   490	                inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   491	                if not inner:
   492	                    continue
   493	                key = _norm_key(inner)
   494	                if key in raw_targets:
   495	                    out.add(key)
   496	    return out, auto_anomalies
   497	
   498	
   499	def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
   500	    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
   501	
   502	    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
   503	    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
   504	    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
   505	    文件级检查), 再补两层本检查需要的:
   506	      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
   507	      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
   508	    """
   509	    if not root.is_dir():
   510	        return [], {}
   570	        for rel, why in src_blind.items():
   571	            blind[f"{src_dir}/{rel}"] = why
   572	        if src_dir == NODE_DIR:
   573	            nodes = srcs
   574	        for src in srcs:
   575	            blocked = _scan_block_reason(vault, src)
   576	            if blocked:
   577	                blind[src.relative_to(vault).as_posix()] = blocked
   578	                continue
   579	            text = _read_text(src)
   580	            if text is None:
   581	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   582	                continue
   583	            _fm, body = _split_frontmatter(text)
   584	            # ⛔ 物理路径作来源键 (Codex round-3 H1b): `原白板 -> 节点/` 目录别名下,
   585	            #    同一物理文件以别名路径贡献入链 —— 相对路径键会让它绕过自身排除。
   586	            src_phys = os.path.realpath(src)
   587	            targets, auto_anomalies = _wikilink_targets(body)
   588	            for anomaly in auto_anomalies:
   589	                # r11: 同文件多条 anomaly 不得同 key last-write-wins —— key 唯一化
   590	                blind[f"AUTO 异常 [{src_dir}/{src.name}] {anomaly}"] = (
   591	                    f"AUTO 段结构异常: {anomaly} (该段已盲化, 内容不参与判定)"
   592	                )
   593	            for target in targets:
   594	                inbound.setdefault(target, set()).add(src_phys)
   595	
   596	    findings: list[Finding] = []
   597	    for node in nodes:
   598	        own = node.relative_to(vault).as_posix()
   599	        blocked = _scan_block_reason(vault, node)
   600	        if blocked:
   601	            blind[own] = blocked
   602	            continue
   603	        # ⛔ 检查时排除**自身**贡献, 按物理路径比对 (Codex round-2 MEDIUM-1a +
   604	        #    round-3 H1b): d1/A 链 [[d2/a]] 时 target "a" 的来源是 d1/A 自己 (不豁免
   605	        #    A, 豁免 d2/a); 目录别名 (原白板->节点/) 下同一物理文件的别名路径也按

