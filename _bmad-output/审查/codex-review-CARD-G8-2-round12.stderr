+    _node(root, "A")
+    _board(root, "板", "`x``[[A]]`\n")
+    res = vl.check_orphan_nodes(root)
+    subjects = [f.subject for f in res.findings]
+    assert subjects == ["节点/A.md"], f"双反引号被误当 closer, [[A]] 逃出 span: {subjects}"
+
