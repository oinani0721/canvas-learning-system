    21	def _get_plaintext_from_html(html: str) -> str:
    22	    """html -> ASCII plaintext, via HTML2Text."""
    23	    txt_maker = _get_html2text_obj_with_config()
    24	    doc = txt_maker.handle(html)
    25	    return doc
