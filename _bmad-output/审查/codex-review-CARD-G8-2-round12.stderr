     1	#!/bin/bash
     2	# CARD-G8-2 (BATCH-2026-09-01-第八批) — 变异负验证 (串行, 还原逐字节比对)
     3	# 判据 (Codex round-1 HIGH-7 收紧): rc==1 **且** 输出里出现指定门的 FAILED 行。
     4	#   rc∈{2,3,4} (usage/collection/internal error) = 指定门根本没跑 = 不算 KILLED;
     5	#   rc=5 (收集为空) 也不算。每轮输出存 transcript 进 evidence, 不再只有自报。
     6	# 教训锚 (MEMORY): 变异脚本必须串行; str.replace 不命中不报错 → 每处替换断言命中数;
     7	#                  EXIT trap 还原; bash 是 PIPESTATUS; argv 里的 \n 是字面两字符;
     8	#                  判据是"指定门红"不是"某处有失败"。
     9	set -u
    10	cd "$(dirname "$0")/../../.." || exit 9   # → LANE 根
    11	LANE="$PWD"
    12	SCRIPT="backend/scripts/vault_lint.py"
    13	TRANS_DIR="_bmad-output/审查/evidence-g82/mutation-transcripts"
    14	mkdir -p "$TRANS_DIR"
    15	PYTHONDONTWRITEBYTECODE=1
    16	export PYTHONDONTWRITEBYTECODE
    17	
    18	mutate_and_test() {
    19	  # $1=变异名 $2=python替换表达式(old|||new, \n 字面量) $3=pytest -k 表达式(指定门)
    20	  local name="$1" repl="$2" gate="$3" rc out
    21	  out="$TRANS_DIR/$name.txt"
    22	  cp "$SCRIPT" "$SCRIPT.bak-g82"
    23	  trap 'cp "$SCRIPT.bak-g82" "$SCRIPT" 2>/dev/null; rm -f "$SCRIPT.bak-g82"' EXIT INT TERM
    24	
    25	  python3 - "$repl" <<'PYEOF'
    26	import sys
    27	repl = sys.argv[1]
    28	def _conv(s):
    29	    return s.replace("\\n", "\n")  # (r11: \\Q 占位分支已删——当前锚无 \\Q)
    30	old, new = (_conv(s) for s in repl.split("|||"))
    31	p = "backend/scripts/vault_lint.py"
    32	src = open(p, encoding="utf-8").read()
    33	n = src.count(old)
    34	assert n == 1, f"替换锚必须恰命中 1 次, 实际 {n}: {old!r}"
    35	open(p, "w", encoding="utf-8").write(src.replace(old, new))
    36	PYEOF
    37	  if [ $? -ne 0 ]; then
    38	    echo "MUTANT $name: REPLACE-FAILED (锚不唯一/不命中) — 脚本缺陷, 不算通过"
    39	    cp "$SCRIPT.bak-g82" "$SCRIPT"; rm -f "$SCRIPT.bak-g82"
    40	    exit 9
    41	  fi
    42	
    43	  ( cd backend && .venv/bin/pytest tests/unit/test_vault_lint.py -q -p no:cacheprovider -k "$gate" ) > "$out" 2>&1
    44	  rc=$?
    45	  # 还原 + 逐字节比对 (先还原再判定, 防中途退出留毒)
    46	  cp "$SCRIPT.bak-g82" "$SCRIPT"
    47	  if ! cmp -s "$SCRIPT" "$SCRIPT.bak-g82"; then echo "MUTANT $name: RESTORE-MISMATCH"; exit 9; fi
    48	  rm -f "$SCRIPT.bak-g82"
    49	
    50	  # 判据: rc==1 且 **指定的那道门** 出现在 FAILED 行里 (HIGH-7: 光 rc!=0 不算)
    51	  if [ "$rc" -eq 1 ] && grep -q "FAILED tests/unit/test_vault_lint.py::.*${gate%% and *}" "$out"; then
    52	    echo "MUTANT $name: KILLED (rc=1, 指定门 [$gate] 的 FAILED 行在 transcript) ✓"
    53	  elif [ "$rc" -eq 0 ]; then
    54	    echo "MUTANT $name: SURVIVED (rc=0 — 指定门 [$gate] 没抓住) ❌"
