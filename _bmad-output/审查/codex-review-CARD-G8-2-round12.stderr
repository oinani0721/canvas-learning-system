+        token_map = token.map or [0, 1]
+        # ⛔ r9 H3: 原文裸 target 集合（token 所在原文行区间, 含转义奇偶判定）——
+        # decoded match 逐个绑定: 只有原文确实存在的裸链接才采纳。
+        raw_targets = _raw_wikilink_targets_in_lines(src_lines, token_map[0], token_map[1])
+        if not raw_targets:
+            continue
+        for child in token.children:
+            if child.type != "text" or "[[" not in child.content:
+                continue  # code_inline/html_inline/softbreak 等: 不扫
+            for m in _WIKILINK.finditer(child.content):
+                inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
+                inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
+                if not inner:
+                    continue
+                key = _norm_key(inner)
+                if key in raw_targets:
+                    out.add(key)
+    return out, auto_anomalies
