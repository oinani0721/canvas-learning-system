+# ---------------------------------------------------------------------------
+# 3h. round-9 整改 —— AUTO 容器上下文 / 嵌套深度 / 逐 match 原文绑定
+# ---------------------------------------------------------------------------
+def test_auto_blinding_preserves_list_container(tmp_path):
+    """Codex round-9 H1: list 容器内的 AUTO 段 —— 盲化行必须保留原行前导空白
+    （列 0 注释会终止 list, fence 退化 code_block, [[A]] 泄漏为入链）。"""
