+def _walk_md(root: Path) -> tuple[list[Path], dict[str, str]]:
+    """枚举 root 下全部 md 候选 + 枚举层盲区 (Codex round-3 H1a/H2 整改)。
+
+    ⛔ 不再用 `rglob`: 它会**静默吞掉**不可读子树 (chmod 000 整棵消失) 与嵌套目录
+    symlink 的后代 —— "0 节点 0 盲区" 是"没看见"。改复用 G8-1 已审查的
+    `cvr._walk_vault` (os.walk(onerror=...) + dangling/非dir非file 单列 + os.access
+    文件级检查), 再补两层本检查需要的:
+      - 目录 symlink (os.walk followlinks=False 不深入 → 后代整棵不在扫描面) 记盲区;
+      - 过滤出 `.md` (suffix.lower(), 与 cvr G3 同口径)。
+    """
+    if not root.is_dir():
+        return [], {}
+    blind: dict[str, str] = {}
+    dirs, files, cvr_blind = cvr._walk_vault(root)
+    for rel, why in cvr_blind:
+        blind[rel] = f"枚举盲区: {why}"
+    for d in dirs:
+        if d.is_symlink():
+            blind[d.relative_to(root).as_posix()] = "symlink-dir: os.walk 不深入, 其后代整棵不在扫描面内"
+    mds = sorted(f for f in files if f.suffix.lower() == ".md")
+    return mds, blind
 
 
