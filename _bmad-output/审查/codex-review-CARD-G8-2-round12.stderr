   351	def _blind_auto_lines(body: str) -> tuple[str, set[int], list[str]]:
   352	    """AUTO-GENERATED 哨兵段内的行盲化为注释行（**保留原行前导空白与纯 fence 标记行**），
   353	    其余行原样；返回（盲化文本, AUTO 行号集合, **结构异常清单**）。
   354	
   355	    ⛔ r10 终局语义（r8/r9 各轮教训累积后收敛）：AUTO 段是 sync_board_concepts.py
   356	      写入的**固定四段结构**（BEGIN/NOTE/成员/END，probe-F 实测 6 块板全部同构）。
   357	      r7-r10 各轮对抗反例（段内 fence 开合、嵌套 BEGIN、畸形 END、info string
   358	      反引号）在真实生成器输出中**不可达** —— 本函数不再试图正确解析这些形态：
   359	      - 按现行规则盲化（纯 fence 标记行原样保留维持开合、其余行盲化、嵌套深度计数）；
   360	      - **检测**到结构异常（段内 fence 标记行 / 嵌套 BEGIN / EOF 未闭合）时记入
   361	        anomalies 返回——调用方转为**显式盲区警告**, 把对抗形态从静默假绿变成可见信号。
   362	    """
   363	    out_lines: list[str] = []
   364	    auto_line_indices: set[int] = set()
   365	    anomalies: list[str] = []
   366	    depth = 0
   367	    # ⛔ 行模型与 mdit map 一致: 仅按 \n 分割 (r9 M5 —— splitlines 会把 VT/FF/NEL 等
   368	    #    也当行界, 导致盲化行号与 token.map 错位)。末行无 \n 时不补。
   369	    raw_lines = body.split("\n")
   370	    line_count = len(raw_lines)
   371	    for idx in range(line_count):
   372	        line = raw_lines[idx] + ("\n" if idx < line_count - 1 else "")
   373	        stripped = line.strip()
   374	        if depth > 0:
   375	            auto_line_indices.add(idx)
   376	            if _AUTO_BEGIN_RE.match(stripped):
   377	                # r9 H2: 嵌套 BEGIN —— 深度 +1 (真实生成器单层; 嵌套 = 结构异常, 显式记录)
   378	                depth += 1
   379	                anomalies.append(f"行 {idx + 1}: AUTO 段内嵌套 BEGIN (深度 {depth})")
   380	                indent = line[: len(line) - len(line.lstrip())]
   381	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   382	                continue
   383	            if _AUTO_END_RE.match(stripped):
   384	                depth -= 1
   385	                indent = line[: len(line) - len(line.lstrip())]
   386	                out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   387	                if depth > 0:
   388	                    anomalies.append(f"行 {idx + 1}: END 后残余深度 {depth} (嵌套段未闭合)")
   389	                continue
   390	            if re.fullmatch(r"(`{3,}|~{3,})[^`]*", stripped):
   391	                # 纯 fence 标记行原样保留, 维持开合状态 (r10 H1b: info 含反引号的行
   392	                # 不是纯 fence 标记, 落入下方盲化分支随段盲)
   393	                out_lines.append(line)
   394	                anomalies.append(f"行 {idx + 1}: AUTO 段内出现 fence 标记行 (生成器不产出, 按保留处理)")
   395	                continue
   396	            if re.match(r"(`{3,}|~{3,})", stripped):
   397	                # 非纯标记但以 fence 字符开头 (如 info 含反引号) —— 也显式记录
   398	                anomalies.append(f"行 {idx + 1}: AUTO 段内出现疑似 fence 标记行 (info 异常, 已随段盲化)")
   399	            indent = line[: len(line) - len(line.lstrip())]
   400	            out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   401	            continue
   402	        if _AUTO_BEGIN_RE.match(stripped):
   403	            depth += 1
   404	            auto_line_indices.add(idx)
   405	            indent = line[: len(line) - len(line.lstrip())]
   406	            out_lines.append(f"{indent}<!--x-->\n" if idx < line_count - 1 else f"{indent}<!--x-->")
   407	            continue
   408	        out_lines.append(line)
   409	    if depth > 0:
   410	        anomalies.append(f"EOF: AUTO 段未闭合 (残余深度 {depth}), 已盲化至文件尾")
   411	    return "".join(out_lines), auto_line_indices, anomalies
