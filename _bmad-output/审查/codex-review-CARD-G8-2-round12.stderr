     6	def _get_html2text_obj_with_config() -> HTML2Text:
     7	    """Get HTML2Text object with config set."""
     8	    txt_maker = HTML2Text()
     9	
    10	    # some settings to avoid newline problems with links
    11	    txt_maker.ignore_links = False
    12	    txt_maker.body_width = 0
    13	    txt_maker.protect_links = True
    14	    txt_maker.wrap_links = False
    15	
    16	    # table settings:
    17	    txt_maker.ignore_tables = True  # keep row content
    18	    return txt_maker
