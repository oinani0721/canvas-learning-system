+def test_code_span_removal_leaves_placeholder_not_concatenation(tmp_path):
+    """Codex round-5 HIGH-2: 剥除 span 后必须**空格占位** —— 空串拼接会把
+    "[`x`[A]]" 拼成原文不存在的 "[[A]]" 伪入链, 反向隐藏真孤儿 A。"""
