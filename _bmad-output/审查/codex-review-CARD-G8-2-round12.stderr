+def test_decoded_match_binds_to_raw_target(tmp_path):
+    """Codex round-9 H3 逐 match 绑定: 同一 inline token 内 [[B]]（真）与
+    \\[\\[A\\]\\]（转义假）并存时, 只有 B 采纳; A 的 decoded target 必须在原文
+    裸 target 集合中有对应, 否则拒绝 → A 报孤儿。"""
