    28	def _remove_code(html: str) -> str:
    29	    # exclude 'code' tags from link output:
    30	    soup = BeautifulSoup(html, 'lxml')
    31	    soup = _remove_code_via_soup(soup)
    32	    html_str = str(soup)
    33	    return html_str
    34	
    35	
    36	def _remove_code_via_soup(soup):
    37	    for s in soup.select('code'):
    38	        s.extract()
    39	    return soup
    40	
    41	
    42	def _remove_del_text(html: str) -> str:
    43	    soup = BeautifulSoup(html, 'lxml')
    44	    soup = _remove_del_text_via_soup(soup)
    45	    html_str = str(soup)
    46	    return html_str
    47	
    48	
    49	def _remove_del_text_via_soup(soup):
    50	    for s in soup.select('del'):
    51	        s.extract()
    52	    return soup
