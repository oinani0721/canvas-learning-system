    23	def get_md_relpaths_from_dir(dir_path: Path) -> list[Path]:
    24	    """Get list of relative paths for markdown files in a given directory,
    25	    including any subdirectories.
    26	
    27	    Thus if the vault directory is the argument, then the function returns
    28	    a list of all the md files found in the vault.
    29	
    30	    Args:
    31	        dir_path (pathlib Path): Path object representing the directory
    32	            to search.
    33	
    34	    Returns:
    35	        list of Path objects
    36	    """
    37	    return get_relpaths_from_dir(dir_path, extension='md')
    38	
    39	
    40	def get_md_relpaths_matching_subdirs(dir_path: Path, *,
    41	                                     include_subdirs: list = None,
    42	                                     include_root: bool = True) -> list[Path]:
    43	    """Get list of relative paths for markdown files in a given directory,
    44	    filtered to include specified subdirectories (with include_subdirs
    45	    kwarg).  The default arguments align with get_md_relpaths_from_dir
    46	    function, but this function enables more flexibility.
    47	
    48	    For example, if you had a vault with folders named by category, and
    49	    filter them like this in Obsidian:
    50	        path:Category1/ OR path:Category2/ OR path:Category4/
    51	    then you can use the include_subdirs kwarg to do that with this function:
    52	        include_subdirs = ['Category1', 'Category2', 'Category4']
    53	
    54	    You can also specify deeper levels to filter on, e.g.:
    55	        include_subdirs = ['Category1/TopicA', 'Category1/TopicB']
    56	
    57	    Args:
    58	        dir_path (pathlib Path): Path object representing the directory
    59	            to search.
    60	        include_subdirs (list, optional): list of string paths to include
    61	            in the filtered list of md files (e.g. ['p1', 'p2', 'p3/sp1']).
    62	            If no list is specified, then no filtering is done on paths.
    63	            Defaults to None.
    64	        include_root (bool, optional): include files that are directly in
    65	            the dir_path (root dir).  Defaults to True.
    66	
    67	    Returns:
    68	        list of Path objects
    69	    """
    70	    return get_relpaths_matching_subdirs(
    71	        dir_path,
    72	        extension='md',
    73	        include_subdirs=include_subdirs,
    74	        include_root=include_root)
