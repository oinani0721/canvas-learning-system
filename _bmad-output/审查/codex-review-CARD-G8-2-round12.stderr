    74	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
    75	    if not matches:
    76	        return None
    77	    v = matches[-1].strip()
    78	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
    79	        v = re.sub(r"\s+#.*$", "", v)  # 行内注释 (引号包裹的值里 # 不算注释)
    80	    v = v.strip().strip('"').strip("'")
    81	    return v or None
    82	
    83	
    84	def fm_num(fm: str, key: str) -> float | None:
    85	    raw = fm_scalar(fm, key)
    86	    if raw is None:
    87	        return None
    88	    try:
    89	        return float(raw)
    90	    except ValueError:
    91	        return None
    92	
    93	
    94	def first_relationship_target(fm: str) -> str | None:
    95	    """relationships[] 首项的 target (只认第一项, 与 manifest _node_relation 同规则)。"""
    96	    lines = fm.splitlines()
    97	    start = next((i for i, ln in enumerate(lines) if re.match(r"^relationships:\s*$", ln)), None)
    98	    if start is None:
    99	        return None
   100	    seen_item = False
   101	    for ln in lines[start + 1 :]:
   102	        if ln.strip() and not ln[0].isspace():
   103	            break  # 回到顶层缩进 → relationships 块结束
   104	        if re.match(r"^\s*-\s", ln):
   105	            if seen_item:
   106	                break  # 第二项开始 → 只认首项
   107	            seen_item = True
   108	        # ⛔ 必须锚在 key 位置 (行首缩进后 / `- ` 之后), 不能裸 `(?:^|\s)target:`:
   109	        # 审查 H3 实测 —— 批注文本 `description: 我不懂 target: 到底指什么…`
   110	        # 会被当成 key, 把用户私密批注切片当成 target 抠出来写进白板。
   111	        m = re.match(r"^\s*(?:-\s+)?target:\s*(.+)$", ln)
   112	        if m:
   113	            return m.group(1).strip()
   114	    return None
   115	
   116	
   117	def basename(raw: str | None) -> str:
   118	    """'[[节点/x|别名]]' / '[[x#小节]]' / 'x.md' → basename (对齐 resolve_node_id)。"""
   119	    text = str(raw or "")
   120	    m = _WIKILINK.search(text)
   121	    inner = m.group(1) if m else text
   122	    return inner.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip().removesuffix(".md")
   123	
   124	
   125	def wikilink_basename(raw: str | None) -> str | None:
   126	    """**只认真正的 wikilink**, 否则返回 None (审查 H3 泄漏面封堵)。
   127	
   128	    `basename()` 对非 wikilink 输入会退化成「整串 strip」—— 于是
   129	    `derived-from: 老师说我这块基础差，要重学第三章` 会被整句写进白板 md,
   130	    而白板正是 start-exam-board 读的那张面 (信息隔离铁律的直接对手)。
   131	    派生来源只有形如 `[[...]]` 才可信, 拿不到就显示成中性的「派生」。
   132	    """
   133	    m = _WIKILINK.search(str(raw or ""))
   134	    if not m:
   135	        return None
   136	    return m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip().removesuffix(".md") or None
   137	
   138	
   139	# ── 成员建模 ──
   140	
   141	
   142	class Member:
   143	    __slots__ = ("node_id", "role", "derived_from", "mastery", "attempts", "is_stub")
   144	
   145	    def __init__(self, node_id: str, fm: str, body: str) -> None:
   146	        self.node_id = node_id
   147	        rel_target = first_relationship_target(fm)
   148	        derived_raw = rel_target or fm_scalar(fm, "derived-from") or fm_scalar(fm, "derived_from")
   149	        # ⛔ `relationships:` 判**真值**不判存在 (审查 H4): `relationships: []` 与
   150	        # `relationships:`(null) 在后端 _node_role 里是 falsy → seed, 脚本靠
   151	        # `re.search(r"^relationships:")` 判存在会说成 derived, 两把锁口径分叉。
   152	        has_rel = bool(rel_target) or bool(re.search(r"^relationships:\s*\n\s+\S", fm, re.M))
   153	        self.role = (
   154	            "derived"
   155	            if (derived_raw or has_rel or fm_scalar(fm, "created_from") == "ai_linked_doc")
   156	            else "seed"
   157	        )
   158	        # ⛔ 只认真正的 wikilink (审查 H3): 非 wikilink 一律显示中性的「派生」,
   159	        # 绝不把 frontmatter 自由文本原样写进白板 md。
   160	        self.derived_from = wikilink_basename(derived_raw)
   161	        self.mastery = self._mastery(fm)
   162	        attempts = fm_num(fm, "attempt_count")
   163	        self.attempts = int(attempts) if attempts is not None else 0
   164	        self.is_stub = PLACEHOLDER in body
   165	
   166	    @staticmethod
   167	    def _mastery(fm: str) -> float | None:
   168	        """掌握度点估计 — 与 backend board_manifest _normalize_mastery **逐字同语义**。
   169	
   170	        beta 档显式 mastery_score 优先于 μ (两把锁的口径必须一致, 否则
   171	        --check 与 dual_source_gap 会各说各话)。
   172	
   173	        ⚠️ 用 μ 而非 pick_score: μ 在闲置折旧下**严格不变** (effective 同比
   174	        缩放 a,b), 所以行内掌握度不会因为「久没考」而过期 —— 唯一会改动它的
   175	        是 quiz-answer 写分, 而写分后会立即触发一次本同步 (在唯一会变的时刻同步)。
   176	        """
   177	        a, b = fm_num(fm, "mastery_a"), fm_num(fm, "mastery_b")
   178	        explicit = fm_num(fm, "mastery_score")
   179	        if a is not None and b is not None:
   180	            # ⛔ a/b 齐即 beta 档, 非正**不再回落 legacy** (审查 H4): 后端把
   181	            # `mastery_a: 0` 判成「数据损坏」→ score=None + parse_errors, 脚本
   182	            # 若悄悄改用 mastery_level 就会显示一个后端根本不认的数字。
   183	            if a <= 0 or b <= 0:
   184	                return None
   185	            return explicit if explicit is not None else _beta_mu(a, b)
   186	        for key in ("mastery_score", "mastery", "mastery_level"):
   187	            v = fm_num(fm, key)
   188	            if v is not None:
   189	                return v
   190	        return None

