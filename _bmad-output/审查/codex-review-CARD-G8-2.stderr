   352	# ---------------------------------------------------------------------------
   353	# 4. freshness 同源锁 —— 活 oracle 比对 + 实测快照锚
   354	# ---------------------------------------------------------------------------
   355	#: probe-B 2026-09-01 对真实 _vault_entry 的实测矩阵 (today=2026-08-31)。
   356	#: 机制列来自逐条归因: DATE_COMPARE / REGEX_REJECT / ASTIMEZONE_RAISE(OverflowError) /
   357	#: SUMMARIZE_TYPE_REJECT —— stale 一档盖 3 种机制, 只锁 status 对机制层变异是盲的,
   358	#: 故 h2/h3 (唯二触达 OverflowError 兜底的用例) 必须在场。
   359	FRESHNESS_MATRIX = [
   360	    # (generated_at, 期望 oracle status, 机制)
   361	    ("2026-08-31T09:05:05+08:00", "ok", "DATE_COMPARE"),
   362	    ("2026-08-30T09:05:05+08:00", "stale", "DATE_COMPARE 昨日"),
   363	    ("2026-08-31T01:05:05Z", "ok", "DATE_COMPARE Z 后缀"),
   364	    ("2026-08-30T23:00:00Z", "ok", "DATE_COMPARE 跨午夜: UTC 昨日 23:00 = 上海今日"),
   365	    ("2026-08-31T00:30:00+08:00", "ok", "DATE_COMPARE 上海今日凌晨"),
