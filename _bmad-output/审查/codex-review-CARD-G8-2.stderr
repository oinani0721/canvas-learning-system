   146	def validate_path_component(component: str) -> str:
   147	    """board_id/node_id 输入护栏: 拒 /、\\、..、NUL (计划 T1 路径穿越校验)。"""
   148	    if not component or "/" in component or "\\" in component or ".." in component or "\x00" in component:
   149	        raise ValueError(f"非法路径成分: {component!r}")
   150	    return component
   151	
   152	
   153	def _aware_dt(value: Any) -> datetime | None:
   154	    """str/datetime/date → tz-aware datetime; 解析失败返回 None (调用方上报)。"""
   155	    if value is None:
   156	        return None
   157	    if isinstance(value, datetime):
   158	        return value if value.tzinfo else value.replace(tzinfo=timezone.utc)
   159	    try:
   160	        dt = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))

