   133	def _run_cli(vault: Path, *extra: str) -> subprocess.CompletedProcess:
   134	    env = dict(os.environ)
   135	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   136	    return subprocess.run(
   137	        [sys.executable, str(SCRIPT), "--vault", str(vault), *extra],
   138	        capture_output=True,
   139	        text=True,
   140	        env=env,
   141	        timeout=120,
   142	    )
