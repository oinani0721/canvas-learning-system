   378	def load_rules(yaml_path: Path = ROLES_YAML, *, verify_sha: bool = True) -> dict[str, Any]:
   379	    if not yaml_path.is_file():
   380	        raise ConfigError(f"台账文件不存在: {yaml_path}")
   381	    raw = yaml_path.read_bytes()
   382	    actual_sha = hashlib.sha256(raw).hexdigest()
   383	    if verify_sha and actual_sha != ROLES_SHA256:
   384	        raise ConfigError(
   385	            f"台账指纹不匹配 (双文件契约): {yaml_path.name}\n"
   386	            f"  期望 (脚本 ROLES_SHA256): {ROLES_SHA256}\n"
   387	            f"  实际:                     {actual_sha}\n"
   388	            f"  改台账必须同 commit 更新脚本常量。刷新: "
   389	            f"python3 {Path(__file__).name} --print-roles-sha"
   390	        )
   391	    try:
   392	        import yaml  # noqa: PLC0415  (延迟导入: --print-roles-sha 不需要它)
   393	    except ImportError as exc:  # pragma: no cover - 环境缺依赖
   394	        raise ConfigError(f"缺少 PyYAML: {exc}") from exc
   395	    try:
   396	        text = raw.decode("utf-8")
   397	    except UnicodeDecodeError as exc:
   398	        # round-8: 非法 UTF-8 此前在 decode 处抛出, 越过 CLI 的 ConfigError-only 捕获
   399	        raise ConfigError(f"台账不是合法 UTF-8: {exc}") from exc
   400	    try:
   401	        data = yaml.safe_load(text)
   402	    except yaml.YAMLError as exc:
   403	        raise ConfigError(f"台账 YAML 解析失败: {exc}") from exc
   404	    if not isinstance(data, dict):
   405	        raise ConfigError("台账根节点必须是 mapping")
   406	    # round-7 MEDIUM: 契约校验此前不是总函数 —— 畸形 glob/pattern 会抛
   407	    # TypeError/AttributeError, 而 CLI 只捕 ConfigError → 用户看到的是 traceback
   408	    # 而不是"配置错误, 退出 2"。这里统一收口。
   409	    try:
   410	        _verify_contract(data)
   411	    except ConfigError:
