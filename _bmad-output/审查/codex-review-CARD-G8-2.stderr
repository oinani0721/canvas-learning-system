   145	def _vault_digest(vault: Path) -> list[tuple[str, str]]:
   146	    return sorted(
   147	        (p.relative_to(vault).as_posix(), hashlib.sha256(p.read_bytes()).hexdigest())
   148	        for p in vault.rglob("*")
   149	        if p.is_file()
   150	    )
