   256	def locate_section(lines: list[str]) -> tuple[int, int] | None:
   257	    """`## Concepts` 段 → (首行索引, 结束索引 exclusive)，不含标题行本身。"""
   258	    start = next((i for i, ln in enumerate(lines) if _CONCEPTS_HEADING.match(ln)), None)
   259	    if start is None:
   260	        return None
   261	    end = next((j for j in range(start + 1, len(lines)) if _NEXT_HEADING.match(lines[j])), len(lines))
   262	    return start + 1, end
