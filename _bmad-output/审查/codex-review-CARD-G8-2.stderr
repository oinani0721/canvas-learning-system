   786	def read_frontmatter_type(path: Path, *, parser: Any = _UNSET) -> str:
   787	    """读 frontmatter 的 `type`, 语义与写侧**逐字相同**。无 frontmatter / 无 type → `(none)`。
   788	
   789	    默认直接调用写侧 `LanceDBClient._parse_frontmatter`; 取值规则同 `lancedb_client.py:2740`
   790	    的 `str(frontmatter.get("type", "") or "").lower().strip()` (精确小写 key、值 lower/strip、
   791	    解析失败返回 {} → 视为无 type)。
   792	    如实声明的建模边界: 写侧另有 `exam_question_id` 推断 `exam_board`、路径启发推断
   793	    `video_transcript` 两条**非 frontmatter**来源, 本函数只建模 frontmatter 直通面。
   794	    """
   795	    try:
   796	        # ⛔ 严格 UTF-8, 与写侧一致 (round-4 相邻 HIGH): 写侧 `lancedb_client.py:1979`
   797	        #    用严格解码并在失败时**整条跳过该文件** (不索引)。此前这里用
   798	        #    errors="replace" 硬读, 对非法 UTF-8 文件会得出一个写侧根本不会产生的
   799	        #    doc_type。解码失败 → 该文件写侧不入库 → 无 doc_type → (none)。
   800	        content = path.read_text(encoding="utf-8")
   801	    except UnicodeDecodeError:
   802	        return NO_TYPE
   803	    except OSError:
   804	        return NO_TYPE
   805	
   806	    # parser 显式传 None = 明确要求走回落 (降级档); 不传 = 自行取写侧解析器
   807	    fn = _writer_frontmatter_parser() if parser is _UNSET else parser
   808	    if fn is not None:
   809	        try:
   810	            fm, _body = fn(content)
   811	        except Exception:  # noqa: BLE001 - 写侧自己会吞异常返回 {}, 这里同样不中断扫描
   812	            return NO_TYPE
   813	        if isinstance(fm, dict):
   814	            return str(fm.get("type", "") or "").lower().strip() or NO_TYPE
   815	        return NO_TYPE
   816	
   817	    return _fallback_frontmatter_type(content)
   818	
   819	
   820	def _fallback_frontmatter_type(content: str) -> str:
   821	    """写侧解析器不可用时的保守回落 (仅 --no-probe / 无 venv 路径会走到)。
   822	
   823	    刻意保守: 只认首行恰为 `---`(允许尾随空白)、以 `---`/`...` 结束的块, 交给 PyYAML;
   824	    解析不了就当无 type。与写侧可能有细微差异, 故 scan() 会在 info 里如实标注。
   825	    """
   826	    lines = content.splitlines()
   827	    if not lines or lines[0].strip() != "---":
   828	        return NO_TYPE
   829	    block: list[str] = []
   830	    for line in lines[1:]:
   831	        if line.strip() in ("---", "..."):
   832	            break
   833	        block.append(line)
   834	    if not block:
   835	        return NO_TYPE
   836	    try:
   837	        import yaml  # noqa: PLC0415
   838	
   839	        parsed = yaml.safe_load("\n".join(block))
   840	    except Exception:  # noqa: BLE001
   841	        return NO_TYPE
   842	    if not isinstance(parsed, dict):
   843	        return NO_TYPE
   844	    return str(parsed.get("type", "") or "").lower().strip() or NO_TYPE
   845	
