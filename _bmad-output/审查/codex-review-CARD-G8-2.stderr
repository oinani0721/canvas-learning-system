   321	def test_orphan_exclusions(tmp_path):
   322	    """不判定面: frontmatter 链 / 自链 / 代码块外的其它目录来源。"""
   323	    # frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链 —— 否则
   324	    # source_board 豁免条件变冗余, 两个条件各自不可证伪
   325	    root = tmp_path / "fm-only"
   326	    _node(root, "A", extra_fm='source_note: "[[某板]]"\nup: "[[B]]"\n')
   327	    res = vl.check_orphan_nodes(root)
   328	    assert [f.subject for f in res.findings] == ["节点/A.md"]
   329	
   330	    # 自链不算 (节点 A 正文里的 [[A]])
   331	    root = tmp_path / "self"
   332	    _node(root, "A", body="- [[A]]\n")
   333	    res = vl.check_orphan_nodes(root)
   334	    assert [f.subject for f in res.findings] == ["节点/A.md"]
   335	
   336	    # 检验白板正文也算入链源 (⚠️ live 上该支零正样本, 见 probe-F 2026-09-01;
   337	    # 本 fixture 是它唯一的正样本 —— 不造这个用例, "三处入链源" 声明比证据宽)
   338	    root = tmp_path / "exam"
   339	    _node(root, "被链")
   340	    _exam(root, "考卷", "- [[节点/被链]]\n")
   341	    res = vl.check_orphan_nodes(root)
   342	    assert res.findings == []
