    88	def _node(root: Path, name: str, body: str = "正文\n", extra_fm: str = "") -> None:
    89	    """frontmatter = `---\\ntype: concept\\n{extra_fm}---\\n` —— extra_fm 的字段
    90	    必须在闭合 `---` 之前 (曾有拼接 bug 把 source_board 拼成正文, 4 用例假红)。"""
    91	    p = root / "节点" / f"{name}.md"
    92	    p.parent.mkdir(parents=True, exist_ok=True)
    93	    p.write_text(NODE_FM + extra_fm + "---\n" + body, encoding="utf-8")
    94	
    95	
    96	def _board(root: Path, name: str, body: str) -> None:
    97	    p = root / "原白板" / f"{name}.md"
    98	    p.parent.mkdir(parents=True, exist_ok=True)
    99	    p.write_text("---\ntype: whiteboard\n---\n" + body, encoding="utf-8")
   100	
   101	
   102	def _exam(root: Path, name: str, body: str) -> None:
   103	    p = root / "检验白板" / f"{name}.md"
   104	    p.parent.mkdir(parents=True, exist_ok=True)
   105	    p.write_text("---\ntype: exam_board\n---\n" + body, encoding="utf-8")
   106	
   107	
   108	def _projection(root: Path, generated_at: object) -> None:
   109	    """最小合法 v3 投影 (probe-B 实测: 不带 boards/buckets 即可通过 _summarize)。"""
   110	    payload = {
   111	        "schema_version": 3,
   112	        "generated_at": generated_at,
   113	        "stats": {"due_nodes": 0},
   114	        "top_boards": [],
   115	        "upcoming": [],
   116	        "due_nodes": [],
   117	        "ineligible": {"placeholder": []},
   118	    }
   119	    d = root / "outputs"
   120	    d.mkdir(parents=True, exist_ok=True)
   121	    (d / "今日复习.json").write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
   122	
   123	
   124	def _clean_vault(root: Path) -> Path:
   125	    """全部检查 ok 的最小 vault: 1 节点有 source_board + 1 节点被板链 + 今日投影。"""
   126	    _node(root, "有源", extra_fm='source_board: "[[原白板/板]]"\n')
   127	    _node(root, "被链")
   128	    _board(root, "板", "- [[节点/被链]]\n")
   129	    _projection(root, "2026-08-31T09:05:05+08:00")
   130	    return root
   131	
   132	
   133	def _run_cli(vault: Path, *extra: str) -> subprocess.CompletedProcess:
   134	    env = dict(os.environ)
   135	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   136	    return subprocess.run(
   137	        [sys.executable, str(SCRIPT), "--vault", str(vault), *extra],
   138	        capture_output=True,
   139	        text=True,
   140	        env=env,
   141	        timeout=120,
   142	    )
   143	
   144	
   145	def _vault_digest(vault: Path) -> list[tuple[str, str]]:
   146	    return sorted(
   147	        (p.relative_to(vault).as_posix(), hashlib.sha256(p.read_bytes()).hexdigest())
   148	        for p in vault.rglob("*")
   149	        if p.is_file()
   150	    )
