   254	def test_config_error_from_ledger_wiring(tmp_path, monkeypatch):
   255	    """台账 ConfigError → LintConfigError (→ 退出码 3) 的接线。
   256	
   257	    注入的是**异常**而非假数据 —— 测的是 vault_lint 的错误路径接线, 不是用 mock 顶替实现。
   258	    (台账 SHA 单边篡改的行为门在 test_vault_doc_roles.py, 那边退出 2。)
   259	    """
   260	    def boom(*a, **k):
   261	        raise vl.cvr.ConfigError("指纹不符 (模拟单边改 yaml)")
   262	
   263	    monkeypatch.setattr(vl.cvr, "load_rules", boom)
   264	    with pytest.raises(vl.LintConfigError):
   265	        vl.run_checks(tmp_path, TODAY)
