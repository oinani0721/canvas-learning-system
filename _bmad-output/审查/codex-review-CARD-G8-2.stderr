   132	def resolve_node_id(raw: Any) -> str:
   133	    """'[[节点/x]]' / '[[y|别名]]' / '[[x#小节]]' / 'x.md' → basename。
   134	
   135	    对齐 canvas_projection_sync._resolve_node_id, 另剥 Obsidian #heading/#^block
   136	    锚点 (Code-Review M6: 带锚点的 source_board 不得判成假孤儿)。
   137	    """
   138	    text = str(raw or "")
   139	    m = _WIKILINK_RE.search(text)
   140	    inner = m.group(1) if m else text
   141	    inner = inner.split("|", 1)[0]
   142	    inner = inner.split("#", 1)[0]
   143	    return inner.split("/")[-1].strip().removesuffix(".md")
