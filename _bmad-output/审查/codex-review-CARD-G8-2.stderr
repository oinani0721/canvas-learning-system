   269	# 3. orphan 形态表 —— 逐类「判定/不判定」(验收单「不比什么」表的数据源)
   270	# ---------------------------------------------------------------------------
   271	def test_orphan_link_forms(tmp_path):
   272	    """每类 wikilink 形态的判定结论。meta = (形态说明, 是否判定为入链)。"""
   273	    cases = [
   274	        # (链接写法, 是否判定为入链)
   275	        ("[[被链]]", True),                          # 基本形
   276	        ("[[被链|别名]]", True),                      # 别名 —— 判定
   277	        ("[[节点/被链]]", True),                      # 子路径 —— 判定
   278	        ("![[被链]]", True),                          # embed —— 判定 (! 在捕获组外)
   279	        ("[[被链#小节]]", True),                      # heading 锚 —— 判定
   280	        ("[[被链#^blockid]]", True),                  # block 锚 —— 判定
   281	        ("[[被链.md]]", True),                        # 带扩展名 —— 判定
   282	        ("[[别的节点]]", False),                      # 链向别处 —— 不判定
   283	        ("", False),                                  # 无正文链 —— 不判定
   284	    ]
   285	    for link, expected_inbound in cases:
   286	        root = tmp_path / f"c{abs(hash(link))}"
   287	        _node(root, "被链")
   288	        _board(root, "板", f"- {link}\n")
   289	        res = vl.check_orphan_nodes(root)
   290	        subjects = [f.subject for f in res.findings]
   291	        assert ("节点/被链.md" in subjects) != expected_inbound, (
   292	            f"形态 {link!r}: 期望{'入链' if expected_inbound else '不判定'}, 实得 findings={subjects}"
   293	        )
   294	
