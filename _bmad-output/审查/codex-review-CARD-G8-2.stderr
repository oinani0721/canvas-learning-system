   653	            raise ValueError(f"ineligible.placeholder[{j}] 应为字符串, 实为 {type(p).__name__}")
   654	    # top_boards 全量元素门禁 (CARD-D1: 行序依赖每个元素的 board) —
   655	    # [0] 额外保留 top_node/pending 门禁 (汇总行消费)
   656	    prio: dict[str, int] = {}
