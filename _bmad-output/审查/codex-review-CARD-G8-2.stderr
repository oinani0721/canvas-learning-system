   274	def _wikilink_targets(body: str) -> set[str]:
   275	    """正文里全部 wikilink 的 basename 集合 (已归一)。
   276	
   277	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   278	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   279	    (`resolve_node_id`) —— 三者本就同规则。
   280	
   281	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   282	       (`canvas-vault/.claude/scripts/`), import 它会在 `PYTHONDONTWRITEBYTECODE` 缺失时
   283	       往 **live vault 里**写 `__pycache__` —— 一个只读审计器绝不该改被审对象。
   284	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   285	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   286	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   287	
   288	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   289	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`。
   290	    """
   291	    out: set[str] = set()
   292	    for raw in _WIKILINK.findall(body):
   293	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip().removesuffix(".md")
   294	        if inner:
   295	            out.add(_norm_key(inner))
   296	    return out
   297	
   298	
   299	def _iter_md(root: Path) -> list[Path]:
   300	    """目录下全部 .md (排序稳定)。root 不存在 → 空列表 (调用方负责如实声明)。"""
   301	    if not root.is_dir():
   302	        return []
   303	    return sorted(p for p in root.rglob("*.md") if p.is_file())
   304	
   305	
   306	# ---------------------------------------------------------------------------
   307	# 检查 1 — orphan_nodes
   308	# ---------------------------------------------------------------------------
   309	def check_orphan_nodes(vault: Path) -> CheckResult:
   310	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   311	
   312	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   313	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   314	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   315	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   316	
   317	    自链不算: 节点 A 正文里的 `[[A]]` 不构成"有人引用 A"。
   318	
   319	    ⛔ 本检查判 warn 不判 fail: 孤儿是**待人处理的治理信号**, 不是系统故障。判 fail 会让
   320	       lint 在真实 vault 上恒红, 门就失去意义 (恒红与恒绿同样是死门)。**待用户裁决**。
   321	    """
   322	    node_root = vault / NODE_DIR
   323	    notes: list[str] = []
   324	    unreadable: list[str] = []
   325	
   326	    nodes = _iter_md(node_root)
   327	    if not node_root.is_dir():
   328	        notes.append(f"`{NODE_DIR}/` 不存在 —— 本检查无对象可查 (不是「零孤儿」)")
   329	
   330	    # 入链索引: 三处正文的 wikilink basename 全集, 按来源文件记账 (自链排除要用)
   331	    inbound: dict[str, set[str]] = {}
   332	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   333	        for src in _iter_md(vault / src_dir):
   334	            text = _read_text(src)
   335	            if text is None:
   336	                unreadable.append(src.relative_to(vault).as_posix())
   337	                continue
   338	            _fm, body = _split_frontmatter(text)
   339	            src_key = _norm_key(src.stem)
   340	            for target in _wikilink_targets(body):
   341	                if src_dir == NODE_DIR and target == src_key:
   342	                    continue  # 自链
   343	                inbound.setdefault(target, set()).add(src.relative_to(vault).as_posix())
   344	
   345	    findings: list[Finding] = []
   346	    for node in nodes:
   347	        key = _norm_key(node.stem)
   348	        if key in inbound:
   349	            continue
   350	        text = _read_text(node)
   351	        if text is None:
   352	            unreadable.append(node.relative_to(vault).as_posix())
   353	            continue
   354	        fm, _body = _split_frontmatter(text)
   355	        if _fm_scalar(fm, "source_board"):
   356	            continue
   357	        findings.append(
   358	            Finding(
   359	                node.relative_to(vault).as_posix(),
   360	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链, "
   361	                f"且 frontmatter 无 source_board",
   362	            )
   363	        )
   364	
   365	    if unreadable:
   366	        notes.append(
   367	            f"扫描盲区: {len(unreadable)} 个文件读不出 (非 UTF-8 / 权限), 未参与判定: "
   368	            + ", ".join(sorted(unreadable)[:5])
   369	        )
   370	    notes.append(
   371	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   372	        "自链不算; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   373	        "目录 symlink 的后代不被 rglob 递归, 不在扫描面内"
   374	    )
   375	    return CheckResult(
   376	        name="orphan_nodes",
   377	        status=WARN if findings else OK,
   378	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿",
   379	        findings=findings,
   380	        notes=notes,
   381	        details={"nodes_scanned": len(nodes), "inbound_targets": len(inbound)},
   382	    )
   383	
   384	
   385	# ---------------------------------------------------------------------------
   386	# 检查 2 — raw_derived_confusion
   387	# ---------------------------------------------------------------------------
   388	def check_raw_derived(vault: Path) -> CheckResult:
   389	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   390	
   391	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   392	
   393	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   394	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   395	      G2 未登记根级文件    同上, 根级面
   396	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   397	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   398	                          正是"raw-derived 混淆"的机械定义
   399	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   400	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   401	
   402	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   403	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   404	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   405	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   406	                 **本次未验证**, 报告逐次声明
   407	
   408	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   409	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。
   410	    """
   411	    try:
   412	        data = cvr.load_rules()
   413	    except cvr.ConfigError as exc:
   414	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   415	    try:
   416	        res = cvr.scan(data, vault, with_probe=False)
   417	    except cvr.ConfigError as exc:
   418	        raise LintConfigError(str(exc)) from exc
   419	
   420	    findings = [
   421	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   422	        for fd in res.findings
   423	        if fd.code in CONFUSION_CODES and fd.blocking
   424	    ]
   425	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   426	
   427	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   428	    recap_bad = 0
   429	    for md in _iter_md(vault):
   430	        if not md.name.startswith(RECAP_PREFIX):
   431	            continue
   432	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   433	        ftype = cvr.read_frontmatter_type(md, parser=None)
   434	        if ftype != "recap":
   435	            recap_bad += 1
   436	            findings.append(
   437	                Finding(
   438	                    md.relative_to(vault).as_posix(),
   439	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   440	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   441	                )
   442	            )
   443	
   444	    notes: list[str] = [
   445	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   446	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   447	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   448	    ]
   449	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   450	    if blind:
   451	        notes.append(
   452	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   453	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   454	        )
   455	    if exempted:
   456	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   457	    for msg in res.info:
   458	        notes.append(f"台账扫描 info: {msg}")
   459	
   460	    return CheckResult(
   461	        name="raw_derived_confusion",
   462	        status=WARN if findings else OK,
   463	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   464	        findings=findings,
   465	        notes=notes,
   466	        details={
   467	            "files_seen": res.files_seen,
   468	            "dirs_seen": res.dirs_seen,
   469	            "codes_counted": list(CONFUSION_CODES),
   470	            "recap_missing_type": recap_bad,
   471	            "blind_spots": len(blind),
   472	            "probe_skipped": res.probe_skipped,
   473	        },
   474	    )
   475	
   476	
   477	# ---------------------------------------------------------------------------
   478	# 检查 3 — projection_freshness
   479	# ---------------------------------------------------------------------------
   480	def _is_stale(generated_at: Any, today: date) -> bool:
   481	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   482	
   483	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   484	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   485	    都按 stale 降级, 绝不逃逸成异常。
   486	    """
   487	    stale = True
   488	    try:
   489	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   490	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   491	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   492	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   493	        stale = True
   494	    return stale
   495	
   496	
   497	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   498	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   499	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。
   500	
   501	    ⛔ corrupt 面**比 oracle 窄**, 如实声明: oracle 在 stale 判定之前还要过
   502	       `_summarize()` 的严格 v3 形状门禁 (schema_version==3 / 五个容器形状 /
   503	       boards·buckets 对账 / 非有限数拒收…), 任何不符即 corrupt。本函数**不复制**
   504	       那几百行 (复制必漂, 且 W6 独占该文件), 只覆盖四类:
   505	       读不出 / 不是 JSON object / 缺 generated_at 键 / generated_at 非字符串
   506	       (最后这类的同语义是实测钉的: int 20260831 → oracle=corrupt, 不是 stale)。
   507	       故同源锁只在**合法 v3 投影**上成立; 其余形状垃圾面两侧可能分歧
   508	       (oracle=corrupt, 本函数可能=stale/ok) —— 验收单「不比什么」表登记。
   509	    """
   510	    proj = vault.joinpath(*_PROJECTION_REL)
   511	    raw = _read_text(proj)
   512	    if raw is None:
   513	        if not proj.exists():
   514	            return "no_projection", None, None
   515	        return "corrupt", "读取失败 (非 UTF-8 / 权限)", None
   516	    try:
   517	        payload = json.loads(raw)
   518	    except (ValueError, RecursionError) as e:
   519	        return "corrupt", f"{type(e).__name__}: {str(e)[:200]}", None
   520	    if not isinstance(payload, dict):
   521	        return "corrupt", "投影根节点不是 JSON object", None
   522	    if "generated_at" not in payload:
   523	        return "corrupt", "投影缺 generated_at 字段", None
   524	    gen = payload["generated_at"]
   525	    # oracle 的 `_summarize` (:678-680) 对非字符串 generated_at 抛 ValueError → corrupt
   526	    # (实测: int 20260831 → oracle=corrupt 而非 stale)。必须同语义, 否则同源锁在此分叉。
   527	    if not isinstance(gen, str):
   528	        return "corrupt", f"generated_at 应为字符串, 实为 {type(gen).__name__}", None
   529	    return ("stale" if _is_stale(gen, today) else "ok"), None, gen
   530	
   531	
   532	def check_projection_freshness(vault: Path, today: date) -> CheckResult:
   533	    """`outputs/今日复习.json` 的 generated_at 是否是上海本地的今日。
   534	
   535	    状态分级 (**待用户裁决**):
   536	      ok            → ok
   537	      stale         → warn  (只是今天还没跑推送, 不是坏)
   538	      no_projection → warn  (该 vault 从没跑过推送 —— 新 vault 的正常初态)
   539	      corrupt       → fail  (投影文件坏了, 下游 Web UI / 推送会拿不到数据 = 真故障)
   540	    """
   541	    status, error, gen = _projection_status(vault, today)
   542	    mapped = {"ok": OK, "stale": WARN, "no_projection": WARN, "corrupt": FAIL}[status]
   543	    detail = {
   544	        "ok": f"generated_at={gen!r} 是 {today} 的投影",
   545	        "stale": f"generated_at={gen!r} 不是 {today} ({_DISPLAY_TZ_NAME}) 的投影",
   546	        "no_projection": f"{'/'.join(_PROJECTION_REL)} 不存在 —— 该 vault 尚未跑过推送",
   547	        "corrupt": f"投影不可用: {error}",
   548	    }[status]
   549	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   550	    return CheckResult(
   551	        name="projection_freshness",
   552	        status=mapped,
   553	        summary=f"projection_status={status}",
   554	        findings=findings,
   555	        notes=[
   556	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   557	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   558	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   559	            "只判 读不出/非 object/缺 generated_at",
   560	        ],
   561	        details={"projection_status": status, "generated_at": gen, "error": error},
   562	    )
   563	
   564	
   565	# ---------------------------------------------------------------------------
   566	# runner
   567	# ---------------------------------------------------------------------------
   568	#: 检查注册表 —— name → (说明, 是否需要 today)
   569	CHECKS: dict[str, str] = {
   570	    "orphan_nodes": "节点/ 下既无入链、又无 source_board 的 md",
   571	    "raw_derived_confusion": "派生物混入 raw/wiki 区 (读 G8-1 台账) + 回顾-*.md 缺 recap frontmatter",
   572	    "projection_freshness": "outputs/今日复习.json 的 generated_at 是否过期",
   573	}
   574	
   575	
   576	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   577	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   578	    if not vault.is_dir():
   579	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   580	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   581	    checks: list[CheckResult] = []
   582	    for name in selected:
   583	        if name == "orphan_nodes":
   584	            checks.append(check_orphan_nodes(vault))
   585	        elif name == "raw_derived_confusion":
   586	            checks.append(check_raw_derived(vault))
   587	        elif name == "projection_freshness":
   588	            checks.append(check_projection_freshness(vault, today))
   589	    return LintReport(
   590	        vault=str(vault),
   591	        today=today.isoformat(),
   592	        checks=checks,
   593	        skipped=[n for n in CHECKS if n not in selected],
   594	    )
   595	
   596	
   597	def resolve_today(now: str | None) -> date:
   598	    """`--now` → 上海本地日。
   599	
   600	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   601	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   602	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   603	    """
   604	    if now is None:
   605	        return datetime.now(timezone.utc).astimezone(_TZ_SHANGHAI).date()
   606	    try:
   607	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   608	    except ValueError as exc:
   609	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   610	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   611	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   612	    try:
   613	        return dt.astimezone(_TZ_SHANGHAI).date()
   614	    except (OverflowError, OSError) as exc:
   615	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   616	
   617	
   618	_EPILOG = f"""
   619	检查项:
   620	  orphan_nodes            {CHECKS['orphan_nodes']}
   621	  raw_derived_confusion   {CHECKS['raw_derived_confusion']}
   622	  projection_freshness    {CHECKS['projection_freshness']}
   623	
   624	退出码:
   625	  0  全部检查 ok
   626	  2  有 warn、无 fail
   627	  1  有 fail
   628	  3  配置/环境错误 —— lint 自己没跑成 (vault 路径不存在 / 台账 SHA 不符 / --now 非法)
   629	
   630	⚠️ 3 号码是本脚本对卡文 (只规定 0/1/2) 的显式扩展, 待用户裁决:
   631	   同目录 check_vault_doc_roles.py / check_readme_claims.py 都用 2 = 配置/环境错误,
   632	   而本卡把 2 定义成"有 warn"。若把配置错压进 1 或 2, 调用方就无法区分
   633	   "vault 有问题" 与 "lint 没跑成"。
   634	
   635	只读: 本脚本对 vault 只有读取, 无 --fix / --write。
   636	"""
   637	
   638	
   639	def main(argv: list[str] | None = None) -> int:
   640	    ap = argparse.ArgumentParser(
   641	        prog="vault_lint.py",
   642	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   643	        epilog=_EPILOG,
   644	        formatter_class=argparse.RawDescriptionHelpFormatter,
   645	    )
   646	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   647	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   648	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   649	    ap.add_argument(
   650	        "--only",
   651	        action="append",
   652	        choices=sorted(CHECKS),
   653	        default=None,
   654	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   655	    )
   656	    args = ap.parse_args(argv)
   657	
   658	    try:
   659	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   660	    except LintConfigError as exc:
   661	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   662	        return EXIT_CONFIG
   663	
   664	    if args.json:
   665	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   666	    else:
   667	        print(render_text(report, color=sys.stdout.isatty()))
   668	    return exit_code(report)
   669	
   670	
   671	if __name__ == "__main__":
   672	    sys.exit(main())

