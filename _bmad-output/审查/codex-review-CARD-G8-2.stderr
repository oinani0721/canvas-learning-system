  1110	def _resolves_inside_vault(vault_root: Path, rel: str) -> bool:
  1111	    """`rel` 解析后是否仍落在 vault 内 (含 vault 根自身)。"""
  1112	    try:
  1113	        base = os.path.realpath(str(vault_root))
  1114	        actual = os.path.realpath(os.path.join(str(vault_root), rel))
  1115	    except OSError:
  1116	        return False
  1117	    return actual == base or actual.startswith(base + os.sep)
