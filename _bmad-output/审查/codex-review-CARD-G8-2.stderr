   321	def test_orphan_exclusions(tmp_path):
   322	    """不判定面: frontmatter 链 / 自链 / 代码块外的其它目录来源。"""
   323	    # frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链 —— 否则
   324	    # source_board 豁免条件变冗余, 两个条件各自不可证伪
   325	    root = tmp_path / "fm-only"
   326	    _node(root, "A", extra_fm='source_note: "[[某板]]"\nup: "[[B]]"\n')
   327	    res = vl.check_orphan_nodes(root)
