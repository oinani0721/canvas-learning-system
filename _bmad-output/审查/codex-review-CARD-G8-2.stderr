   212	def test_exit_code_mapping():
   213	    def report(*statuses: str) -> vl.LintReport:
   214	        return vl.LintReport(
   215	            vault="v",
   216	            today="2026-08-31",
   217	            checks=[vl.CheckResult(name=f"c{i}", status=s, summary="") for i, s in enumerate(statuses)],
   218	        )
   219	
   220	    assert vl.exit_code(report(vl.OK, vl.OK)) == 0
   221	    assert vl.exit_code(report(vl.OK, vl.WARN)) == 2
   222	    assert vl.exit_code(report(vl.WARN, vl.WARN)) == 2
   223	    assert vl.exit_code(report(vl.OK, vl.FAIL)) == 1
   224	    assert vl.exit_code(report(vl.WARN, vl.FAIL)) == 1  # fail 压过 warn
   225	
