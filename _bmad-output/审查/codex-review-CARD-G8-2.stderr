   530	def test_help_lists_checks_and_exit_semantics():
   531	    env = dict(os.environ)
   532	    env["PYTHONDONTWRITEBYTECODE"] = "1"
   533	    proc = subprocess.run(
   534	        [sys.executable, str(SCRIPT), "--help"], capture_output=True, text=True, env=env, timeout=60
   535	    )
   536	    assert proc.returncode == 0
   537	    out = proc.stdout
   538	    for name in vl.CHECKS:
   539	        assert name in out, f"--help 缺检查名 {name}"
   540	    for token in ("0", "2", "1", "3"):
   541	        assert token in out
   542	    assert "warn" in out and "fail" in out and "配置/环境错误" in out
   543	    # --vault 是必填: 没给 vault 时报错退出码为 argparse 的 2
   544	    bad = subprocess.run([sys.executable, str(SCRIPT)], capture_output=True, text=True, env=env, timeout=60)
   545	    assert bad.returncode == 2 and "--vault" in bad.stderr
