   429	def test_json_and_text_are_same_source(tmp_path):
   430	    root = tmp_path / "v"
   431	    _node(root, "孤儿")
   432	    _projection(root, "2026-08-30T09:05:05+08:00")  # stale
   433	    proc = _run_cli(root, "--now", NOW_ARG)
   434	    assert proc.returncode == 2
   435	    text_rows = dict(_TEXT_STATUS_RE.findall(proc.stdout))
   436	    payload = json.loads(_run_cli(root, "--now", NOW_ARG, "--json").stdout)
   437	
   438	    json_rows = {c["name"]: c["status"] for c in payload["checks"]}
   439	    assert text_rows == json_rows, "文本与 JSON 的 per-check status 必须逐项相等 (同源)"
   440	    assert proc.returncode == payload["summary"]["exit_code"]
   441	    assert payload["summary"]["checks_skipped"] == []
