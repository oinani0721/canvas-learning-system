   227	def test_cli_exit_codes_match_report(tmp_path):
   228	    clean = _run_cli(_clean_vault(tmp_path / "clean"), "--now", NOW_ARG, "--json")
   229	    assert clean.returncode == 0, clean.stderr
   230	
   231	    orphan = tmp_path / "orphan"
   232	    _node(orphan, "孤儿")
   233	    _projection(orphan, "2026-08-31T09:05:05+08:00")
   234	    r = _run_cli(orphan, "--now", NOW_ARG)
   235	    assert r.returncode == 2, (r.returncode, r.stdout, r.stderr)
   236	
   237	    corrupt = tmp_path / "corrupt"
   238	    (corrupt / "outputs").mkdir(parents=True)
   239	    (corrupt / "outputs" / "今日复习.json").write_text("break", encoding="utf-8")
   240	    r = _run_cli(corrupt, "--now", NOW_ARG)
   241	    assert r.returncode == 1
   242	
   243	    r = _run_cli(tmp_path / "不存在", "--now", NOW_ARG)
   244	    assert r.returncode == 3, "vault 不存在必须是配置错误 3, 不是 1"
   245	    assert "配置/环境错误" in r.stderr
   246	
