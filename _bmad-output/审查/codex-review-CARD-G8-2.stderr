   847	# ---------------------------------------------------------------------------
   848	# 真实准入函数 (不重新实现 —— 台账双列必须对真实代码可证伪)
   849	# ---------------------------------------------------------------------------
   850	def load_admission_fns(vault_root: Path):
   851	    """返回 (should_index, check_vault_path) 两个真实函数的 (rel)->bool 包装。"""
   852	    backend_root = Path(__file__).resolve().parent.parent
   853	    for p in (str(backend_root), str(backend_root / "lib")):
   854	        if p not in sys.path:
   855	            sys.path.insert(0, p)
   856	    try:
   857	        from app.core.vault_admission import check_vault_path
   858	        from app.services.vault_index_orchestrator import VaultIndexOrchestrator
   859	    except Exception as exc:  # pragma: no cover - 环境缺依赖 / 无可写临时目录
   860	        raise ConfigError(
   861	            f"无法导入真实准入函数 (需 backend venv): {exc}\n"
   862	            f"  提示: import 链含 jieba.initialize(), 需要可写的系统临时目录。"
   863	            f"严格只读环境请改用 --no-probe (只做 schema/登记面检查, 零 import 副作用)。"
   864	        ) from exc
   865	
   866	    # __init__ 只做属性赋值 (已核源码: _pending_file 仅构造 Path 不落盘,
   867	    # LanceDB 连接在 _get_client() 里, 本脚本从不调用) → 零写入。
   868	    orch = VaultIndexOrchestrator(str(vault_root))
   869	
   870	    def rag(rel: str) -> tuple[bool, str]:
   871	        return orch.should_index(rel)
   872	
   873	    def mem(rel: str) -> tuple[bool, str]:
   874	        return check_vault_path(rel, vault_root)
   875	
   876	    # ⛔ 预热 (round-2 HIGH-5): 两个函数内部都有**惰性 import**
   877	    # (should_index → lancedb_client → jieba.initialize())。不预热的话, 严格只读
   878	    # 环境下异常会在扫描中途的首次调用抛出, 绕过本函数的 try → 退出码变成 1 而不是
   879	    # 契约声明的 2。在这里先各调一次, 把惰性 import 的失败收进同一个捕获面。
   880	    try:
   881	        rag("__admission_warmup__.md")
   882	        mem("__admission_warmup__.md")
   883	    except Exception as exc:  # pragma: no cover - 严格只读环境
   884	        raise ConfigError(
   885	            f"真实准入函数首次调用失败 (惰性 import 需要可写临时目录): {exc}\n"
   886	            f"  严格只读环境请用 --no-probe --allow-degraded (只做 schema/登记面检查)。"
   887	        ) from exc
   888	
   889	    return rag, mem
