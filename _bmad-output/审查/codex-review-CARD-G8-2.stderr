   206	def scan_members(vault: Path) -> tuple[dict[str, list[Member]], list[str]]:
   207	    """节点池 → ({board_id: [Member]}, 告警行)。board_id 大小写不敏感归一。
   208	
   209	    ⛔ 返回告警而不是静默 (审查 M11/M12): 孤儿节点 (source_board 拼错 / 指向
   210	    不存在的板 / NFC-NFD 不一致) 原来零输出就被剔出白板、doc_count 同步下调;
   211	    节点名含 `[]|#^` 则会生成断链 wikilink —— 那正好打脸选方案 B 的头号理由
   212	    「保 Graph View 正向边」。两者都必须让 --check 红。
   213	    """
   214	    boards_ci: dict[str, str] = {}
   215	    warnings: list[str] = []
   216	    for p in sorted((vault / BOARD_DIR).glob("*.md")):
   217	        key = p.stem.casefold()
   218	        if key in boards_ci:  # 审查 L15: casefold 碰撞会让后写者吞掉前一块板
   219	            warnings.append(f"白板名 casefold 碰撞: {boards_ci[key]!r} vs {p.stem!r} — 后者的节点会被误归")
   220	        boards_ci[key] = p.stem
   221	    grouped: dict[str, list[Member]] = {stem: [] for stem in boards_ci.values()}
   222	
   223	    for path in sorted((vault / NODE_DIR).glob("*.md")):
   224	        try:
   225	            fm, body = split_frontmatter(path.read_text(encoding="utf-8"))
   226	        except (OSError, UnicodeDecodeError) as e:
   227	            warnings.append(f"节点读取失败, 已跳过: {path.name} ({type(e).__name__})")
   228	            continue
   229	        raw_board = fm_scalar(fm, "source_board")
   230	        board = boards_ci.get(basename(raw_board).casefold()) if raw_board else None
   231	        if board is None:
   232	            warnings.append(
   233	                f"孤儿节点 {path.stem!r}: "
   234	                + ("无 source_board" if not raw_board else "source_board 指向不存在的白板")
   235	            )
   236	            continue
   237	        if any(c in path.stem for c in _WIKILINK_HOSTILE):
   238	            warnings.append(f"节点名含 wikilink 敏感字符 {_WIKILINK_HOSTILE!r}, 生成的双链会断: {path.stem!r}")
   239	        # ⛔ 状态量必须伴随显式分 (节点关系图审查后加的防线): 唯一写分路径
   240	        # quiz-answer 的原子替换保证 mastery_a/b 与 mastery_score 同时写入,
   241	        # 只有手工编辑才会造出「有状态量没显式分」的节点 — 那会让部分只读
   242	        # mastery_score 的旧消费者显示「—」而权威口径显示 μ, 同屏打架。
   243	        a, b = fm_num(fm, "mastery_a"), fm_num(fm, "mastery_b")
   244	        if a is not None and b is not None and a > 0 and b > 0 and fm_num(fm, "mastery_score") is None:
   245	            warnings.append(f"{path.stem!r}: 有 mastery_a/b 状态量但缺 mastery_score 显式分 (疑似手工编辑)")
   246	        grouped[board].append(Member(path.stem, fm, body))
   247	
   248	    for members in grouped.values():
   249	        members.sort(key=lambda m: m.node_id)  # 与 manifest nodes[] 同序 (文件名序)
   250	    return grouped, warnings
