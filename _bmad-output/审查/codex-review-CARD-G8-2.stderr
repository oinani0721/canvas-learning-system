   923	    diverging_entry_ids = {e["id"] for e in iter_entries(data) if e["rag_index"] != e["memory_write"]}
   924	    entries_with_live_files: set[str] = set()
   925	    entries_with_live_divergence: set[str] = set()
   926	    observed_types: dict[str, set[str]] = {}
   927	
   928	    def add(code: str, subject: str, detail: str) -> None:
   929	        res.findings.append(Finding(code, subject, detail, _gap_exemption(data, code, subject)))
   930	
   900	            return str(gap.get("id", ""))
   901	    return ""
