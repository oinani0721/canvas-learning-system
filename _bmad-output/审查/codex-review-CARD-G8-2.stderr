   105	def _beta_effective(a: float, b: float, days_idle: float) -> tuple[float, float]:
   106	    a, b = float(a), float(b)
   107	    if a <= 0.0 or b <= 0.0:
   108	        raise ValueError(f"Beta 参数必须为正: a={a}, b={b}")
   109	    f = GAMMA_DAILY ** max(0.0, float(days_idle))
   110	    f = max(f, 1e-150)
   111	    return a * f, b * f
