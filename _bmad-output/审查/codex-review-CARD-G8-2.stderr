   296	def test_orphan_nfc_nfd_and_casefold(tmp_path):
   297	    # ⛔ 纯 CJK 无分解序列 (NFC=NFD 同字节), 必须用带组合标记的字符构造两种形态;
   298	    #   live 节点/ 实测 14/14 全 NFC 存储 (2026-09-01 unicodedata 实查)
   299	    nfc = "café"  # U+00E9
   300	    nfd = unicodedata.normalize("NFD", nfc)  # e + U+0301
   301	    assert nfc != nfd, "测试前提: 两种归一形态字节不同"
   302	
   303	    # 文件名以 NFD 存盘 (macOS APFS 保留原字节), 正文用 NFC 链接 → 判定为入链
   304	    root = tmp_path / "nfd-file"
   305	    p = root / "节点" / f"{nfd}.md"
   306	    p.parent.mkdir(parents=True)
   307	    p.write_text(NODE_FM + "正文\n", encoding="utf-8")
   308	    _board(root, "板", f"- [[{nfc}]]\n")
   309	    assert (p.stem != nfc) and (unicodedata.normalize("NFC", p.stem) == nfc)
   310	    res = vl.check_orphan_nodes(root)
   311	    assert res.findings == [], f"NFD 文件名 + NFC 链接应为入链, 实报 {res.findings}"
   312	
   313	    # 大小写: 链接大写、文件小写 (Obsidian/APFS 均不敏感) → 判定为入链
   314	    root = tmp_path / "case"
   315	    _node(root, "agent")
   316	    _board(root, "板", "- [[Agent]]\n")
   317	    res = vl.check_orphan_nodes(root)
   318	    assert res.findings == [], f"大小写差异应为入链, 实报 {res.findings}"
