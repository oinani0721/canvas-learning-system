   174	    return {
   175	        "vault": report.vault,
   176	        "today": report.today,
   177	        "summary": {
   178	            "exit_code": exit_code(report),
   179	            "checks_run": [c.name for c in report.checks],
   180	            "checks_skipped": list(report.skipped),
   181	            "status_counts": {
   182	                s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)
   183	            },
   184	        },
   185	        "checks": [
   186	            {
   187	                "name": c.name,
   188	                "status": c.status,
   189	                "summary": c.summary,
   190	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   191	                "notes": list(c.notes),
   192	                "details": dict(c.details),
   193	            }
   194	            for c in report.checks
   195	        ],
   196	    }
