   125	_WIKILINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
   126	#: ## Concepts 窄解析: 只认行首 `- [[...]]` (计划 T1: ≤30 行窄解析器)
   127	_CONCEPT_LINE_RE = re.compile(r"^\s*-\s*\[\[([^\]]+)\]\]", re.M)
