   127	# 报告数据结构 —— 文本与 JSON 的**唯一**真相源
   128	# ---------------------------------------------------------------------------
   129	@dataclass(frozen=True)
   130	class Finding:
   131	    subject: str  #: 出问题的 vault 相对路径 / 主体
   132	    detail: str
   133	
   134	
   135	@dataclass
   136	class CheckResult:
   137	    """单个检查的结论。
   138	
   139	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   140	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   141	    """
   142	
   143	    name: str
   144	    status: str  #: ok | warn | fail
   145	    summary: str
   146	    findings: list[Finding] = field(default_factory=list)
   147	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   148	    notes: list[str] = field(default_factory=list)
   149	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   150	    details: dict[str, Any] = field(default_factory=dict)
   151	
   152	
   153	@dataclass
   154	class LintReport:
   155	    vault: str
   156	    today: str
   157	    checks: list[CheckResult]
   158	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   159	    skipped: list[str] = field(default_factory=list)
   160	
   161	
   162	def exit_code(report: LintReport) -> int:
   163	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   164	    statuses = {c.status for c in report.checks}
   165	    if FAIL in statuses:
   166	        return EXIT_FAIL
   167	    if WARN in statuses:
   168	        return EXIT_WARN
   169	    return EXIT_OK
   170	
   171	
   172	def report_to_json(report: LintReport) -> dict[str, Any]:
   173	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   174	    return {
   175	        "vault": report.vault,
   176	        "today": report.today,
   177	        "summary": {
   178	            "exit_code": exit_code(report),
   179	            "checks_run": [c.name for c in report.checks],
   180	            "checks_skipped": list(report.skipped),
   181	            "status_counts": {
   182	                s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)
   183	            },
   184	        },
   185	        "checks": [
   186	            {
   187	                "name": c.name,
   188	                "status": c.status,
   189	                "summary": c.summary,
   190	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   191	                "notes": list(c.notes),
   192	                "details": dict(c.details),
   193	            }
   194	            for c in report.checks
   195	        ],
   196	    }
   197	
   198	
   199	def render_text(report: LintReport, *, color: bool = True) -> str:
   200	    """文本视图 —— 只读 `report`, 与 `report_to_json` 同源。
   201	
   202	    每个检查恰一行机读状态行 `{TAG} <name> status=<status> ...`, 同源门据此解析比对。
   203	    """
   204	
   205	    def c(code: str, s: str) -> str:
   206	        return f"{code}{s}{RESET}" if color else s
   207	
   208	    hue = {OK: GREEN, WARN: YELLOW, FAIL: RED}
   209	    out: list[str] = [
   210	        f"{c(DIM, 'vault')} {report.vault}",
   211	        f"{c(DIM, 'today')} {report.today} ({_DISPLAY_TZ_NAME})",
   212	    ]
   213	    for chk in report.checks:
   214	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   215	        for note in chk.notes:
   216	            out.append(f"    {c(DIM, 'note  ' + note)}")
   217	        for fd in chk.findings:
   218	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   219	    for name in report.skipped:
   220	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   221	    rc = exit_code(report)
   222	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   223	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   224	    return "\n".join(out)
   225	
   226	
   227	# ---------------------------------------------------------------------------
   228	# 共用只读 helpers
   229	# ---------------------------------------------------------------------------
   230	def _read_text(path: Path) -> str | None:
   231	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。"""
   232	    try:
   233	        return path.read_text(encoding="utf-8")
   234	    except (OSError, UnicodeDecodeError, ValueError):
   235	        return None
   236	
   237	
   238	def _split_frontmatter(text: str) -> tuple[str, str]:
   239	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   240	    m = _FRONTMATTER.match(text)
   241	    return (m.group(1), m.group(2)) if m else ("", text)
   242	
   243	
   244	def _fm_scalar(fm: str, key: str) -> str | None:
   245	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   246	
   247	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   248	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   249	    """
   250	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   251	    if not matches:
   252	        return None
   253	    v = matches[-1].strip()
   254	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   255	        v = re.sub(r"\s+#.*$", "", v)
   256	    v = v.strip().strip('"').strip("'")
   257	    return v or None
   258	
   259	
   260	def _norm_key(name: str) -> str:
   261	    """入链匹配键: NFC 归一 + casefold。
   262	
   263	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   264	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   265	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   266	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   267	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   268	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   269	    (假阴)。该权衡进验收单「不比什么」表。
   270	    """
   271	    return unicodedata.normalize("NFC", name).casefold().strip()
   272	
   273	
   274	def _wikilink_targets(body: str) -> set[str]:
   275	    """正文里全部 wikilink 的 basename 集合 (已归一)。
   276	
   277	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   278	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   279	    (`resolve_node_id`) —— 三者本就同规则。
   280	
   281	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   282	       (`canvas-vault/.claude/scripts/`), import 它会在 `PYTHONDONTWRITEBYTECODE` 缺失时
   283	       往 **live vault 里**写 `__pycache__` —— 一个只读审计器绝不该改被审对象。
   284	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   285	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   286	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   287	
   288	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   289	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]`。
   290	    """
   291	    out: set[str] = set()
   292	    for raw in _WIKILINK.findall(body):
   293	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip().removesuffix(".md")
   294	        if inner:
   295	            out.add(_norm_key(inner))
   296	    return out
   297	
   298	
   299	def _iter_md(root: Path) -> list[Path]:
   300	    """目录下全部 .md (排序稳定)。root 不存在 → 空列表 (调用方负责如实声明)。"""
   301	    if not root.is_dir():
   302	        return []
   303	    return sorted(p for p in root.rglob("*.md") if p.is_file())
   304	
   305	
   306	# ---------------------------------------------------------------------------
   307	# 检查 1 — orphan_nodes
   308	# ---------------------------------------------------------------------------
   309	def check_orphan_nodes(vault: Path) -> CheckResult:
   310	    """`节点/` 下既无入链、又无 frontmatter `source_board` 的 md。
   311	
   312	    入链源 = `原白板/` + `检验白板/` + `节点/` 三处的**正文** (frontmatter 之外)。
   313	    刻意不扫 frontmatter: `source_note` / `up` / `derived-from` 都是 frontmatter 里的
   314	    wikilink, 把它们算作入链会让 `source_board` 豁免条件变成冗余 —— 两个条件必须各自
   315	    可证伪, 否则去掉其中一个的变异杀不死任何门。
   316	
   317	    自链不算: 节点 A 正文里的 `[[A]]` 不构成"有人引用 A"。
   318	
   319	    ⛔ 本检查判 warn 不判 fail: 孤儿是**待人处理的治理信号**, 不是系统故障。判 fail 会让
   320	       lint 在真实 vault 上恒红, 门就失去意义 (恒红与恒绿同样是死门)。**待用户裁决**。
   321	    """
   322	    node_root = vault / NODE_DIR
   323	    notes: list[str] = []
   324	    unreadable: list[str] = []
   325	
   326	    nodes = _iter_md(node_root)
   327	    if not node_root.is_dir():
   328	        notes.append(f"`{NODE_DIR}/` 不存在 —— 本检查无对象可查 (不是「零孤儿」)")
   329	
   330	    # 入链索引: 三处正文的 wikilink basename 全集, 按来源文件记账 (自链排除要用)
   331	    inbound: dict[str, set[str]] = {}
   332	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   333	        for src in _iter_md(vault / src_dir):
   334	            text = _read_text(src)
   335	            if text is None:
   336	                unreadable.append(src.relative_to(vault).as_posix())
   337	                continue
   338	            _fm, body = _split_frontmatter(text)
   339	            src_key = _norm_key(src.stem)
   340	            for target in _wikilink_targets(body):
   341	                if src_dir == NODE_DIR and target == src_key:
   342	                    continue  # 自链
   343	                inbound.setdefault(target, set()).add(src.relative_to(vault).as_posix())
   344	
   345	    findings: list[Finding] = []
   346	    for node in nodes:
   347	        key = _norm_key(node.stem)
   348	        if key in inbound:
   349	            continue
   350	        text = _read_text(node)
   351	        if text is None:
   352	            unreadable.append(node.relative_to(vault).as_posix())
   353	            continue
   354	        fm, _body = _split_frontmatter(text)
   355	        if _fm_scalar(fm, "source_board"):
   356	            continue
   357	        findings.append(
   358	            Finding(
   359	                node.relative_to(vault).as_posix(),
   360	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链, "
   361	                f"且 frontmatter 无 source_board",
   362	            )
   363	        )
   364	
   365	    if unreadable:
   366	        notes.append(
   367	            f"扫描盲区: {len(unreadable)} 个文件读不出 (非 UTF-8 / 权限), 未参与判定: "
   368	            + ", ".join(sorted(unreadable)[:5])
   369	        )
   370	    notes.append(
   371	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   372	        "自链不算; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   373	        "目录 symlink 的后代不被 rglob 递归, 不在扫描面内"
   374	    )
   375	    return CheckResult(
   376	        name="orphan_nodes",
   377	        status=WARN if findings else OK,
   378	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿",
   379	        findings=findings,
   380	        notes=notes,

