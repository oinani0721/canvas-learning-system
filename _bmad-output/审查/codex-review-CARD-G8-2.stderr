   642	        isinstance(top_boards, list)
   643	        and isinstance(upcoming, list)
   644	        and isinstance(due_nodes, list)
   645	        and isinstance(ineligible, dict)
   646	    ):
   647	        raise ValueError("top_boards/upcoming/due_nodes/ineligible 容器形状不符 v3")
   648	    placeholder = ineligible.get("placeholder")
