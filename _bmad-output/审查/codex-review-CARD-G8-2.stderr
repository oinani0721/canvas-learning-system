   895	def _gap_exemption(data: dict[str, Any], code: str, subject: str) -> str:
   896	    if code not in GAP_EXEMPTIBLE:
   897	        return ""
   898	    for gap in data.get("known_gaps") or []:
   899	        if code in (gap.get("finding_codes") or []) and gap.get("literal") == subject:
   900	            return str(gap.get("id", ""))
   901	    return ""
