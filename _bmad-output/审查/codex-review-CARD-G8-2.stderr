     1	#!/bin/bash
     2	# CARD-G8-2 (BATCH-2026-09-01-第八批) — 变异负验证 (串行, 还原逐字节比对)
     3	# 判据: **指定的那道门**必须变红 (rc!=0 且非 rc=5 收集为空); 还原后逐字节相同。
     4	# 教训锚 (MEMORY): 变异脚本必须串行; str.replace 不命中不报错 → 每处替换断言命中数;
     5	#                  EXIT trap 还原; bash 是 PIPESTATUS 不是 zsh 的 pipestatus;
     6	#                  argv 里的 \n 是字面两字符, 必须显式转真换行再 replace;
     7	#                  判据是"指定门红"不是"某处有失败", rc=5 (收集为空) 不算红。
     8	set -u
     9	cd "$(dirname "$0")/../../.." || exit 9   # → LANE 根
    10	LANE="$PWD"
    11	SCRIPT="backend/scripts/vault_lint.py"
    12	PYTHONDONTWRITEBYTECODE=1
    13	export PYTHONDONTWRITEBYTECODE
    14	
    15	mutate_and_test() {
    16	  # $1=变异名 $2=python替换表达式(old|||new, \n 字面量) $3=pytest -k 表达式
    17	  local name="$1" repl="$2" gate="$3" rc
    18	  cp "$SCRIPT" "$SCRIPT.bak-g82"
    19	  trap 'cp "$SCRIPT.bak-g82" "$SCRIPT" 2>/dev/null; rm -f "$SCRIPT.bak-g82"' EXIT INT TERM
    20	
    21	  python3 - "$repl" <<'PYEOF'
    22	import sys
    23	repl = sys.argv[1]
    24	old, new = (s.replace("\\n", "\n") for s in repl.split("|||"))
    25	p = "backend/scripts/vault_lint.py"
    26	src = open(p, encoding="utf-8").read()
    27	n = src.count(old)
    28	assert n == 1, f"替换锚必须恰命中 1 次, 实际 {n}: {old!r}"
    29	open(p, "w", encoding="utf-8").write(src.replace(old, new))
    30	PYEOF
    31	  if [ $? -ne 0 ]; then
    32	    echo "MUTANT $name: REPLACE-FAILED (锚不唯一/不命中) — 脚本缺陷, 不算通过"
    33	    cp "$SCRIPT.bak-g82" "$SCRIPT"; rm -f "$SCRIPT.bak-g82"
    34	    exit 9
    35	  fi
    36	
    37	  ( cd backend && .venv/bin/pytest tests/unit/test_vault_lint.py -q -p no:cacheprovider -k "$gate" > /tmp/g82_mut_out.$$ 2>&1 )
    38	  rc=$?
    39	  tail -2 /tmp/g82_mut_out.$$
    40	  rm -f /tmp/g82_mut_out.$$
    41	
    42	  # 还原 + 逐字节比对 (先还原再判定, 防中途退出留毒)
    43	  cp "$SCRIPT.bak-g82" "$SCRIPT"
    44	  if ! cmp -s "$SCRIPT" "$SCRIPT.bak-g82"; then echo "MUTANT $name: RESTORE-MISMATCH"; exit 9; fi
    45	  rm -f "$SCRIPT.bak-g82"
    46	
    47	  if [ "$rc" -eq 0 ] || [ "$rc" -eq 5 ]; then
    48	    echo "MUTANT $name: SURVIVED (rc=$rc — 指定门 [$gate] 没抓住/收集为空) ❌"
    49	    FAILED="$FAILED $name"
    50	  else
    51	    echo "MUTANT $name: KILLED (rc=$rc, 指定门 [$gate] 变红) ✓"
    52	  fi
    53	}
    54	
    55	FAILED=""
    56	echo "== CARD-G8-2 变异负验证 (串行; 判据 = 指定门变红) =="
    57	
