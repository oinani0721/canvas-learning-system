   161	
   162	def exit_code(report: LintReport) -> int:
   163	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   164	    statuses = {c.status for c in report.checks}
   165	    if FAIL in statuses:
   166	        return EXIT_FAIL
   167	    if WARN in statuses:
   168	        return EXIT_WARN
   169	    return EXIT_OK
