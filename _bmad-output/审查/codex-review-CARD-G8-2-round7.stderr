   305	def _norm_key(name: str) -> str:
   306	    """入链匹配键: NFC 归一 + casefold。
   307	
   308	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   309	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   310	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   311	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   312	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   313	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   314	    (假阴)。该权衡进验收单「不比什么」表。
   315	    """
   316	    return unicodedata.normalize("NFC", name).casefold().strip()
   317	
   318	
   319	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   320	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   321	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   322	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   323	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   324	
   325	
   326	def _code_span_intervals(text: str) -> list[tuple[int, int]]:
   327	    """CommonMark code span 的字符区间 (Codex round-4 H3 + round-5 H1 + round-6 M1/M2)。
   328	
   329	    算法 (CommonMark 0.31.2 §6.1):
   330	      - delimiter run 是**极大**的 (`` `+ `` 不可只取一部分);
   331	      - opener 之后的第一个**长度严格相等**的 run 才是 closer ("≥" 是 fenced 的规则);
   332	      - **转义**的反引号 (奇数个连续反斜杠前缀) 不是 delimiter;
   333	      - span **不跨段落** (opener 与 closer 之间出现空行即两个 block, 不配对)。
   334	    """
   335	    runs: list[tuple[int, int, int]] = []
   336	    for m in re.finditer(r"`+", text):
   337	        backslashes = 0
   338	        k = m.start() - 1
   339	        while k >= 0 and text[k] == "\\":
   340	            backslashes += 1
   341	            k -= 1
   342	        if backslashes % 2 == 1:
   343	            continue  # 被转义的反引号不是 delimiter
   344	        runs.append((m.start(), m.end(), len(m.group())))
   345	    consumed: list[tuple[int, int]] = []
   346	    i = 0
   347	    while i < len(runs):
   348	        j = i + 1
   349	        while j < len(runs) and (runs[j][2] != runs[i][2] or "\n\n" in text[runs[i][1] : runs[j][0]]):
   350	            j += 1
   351	        if j < len(runs):
