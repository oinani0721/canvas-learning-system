   441	    for m in _WIKILINK.finditer(body):
   442	        if _blinded(m.start()):
   443	            continue
   444	        inner = m.group(1).split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   445	        inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   446	        if inner:
   447	            out.add(_norm_key(inner))
   448	    return out
