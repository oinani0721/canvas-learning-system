  1042	def test_code_span_closer_must_equal_opener(tmp_path):
  1043	    """Codex round-5 HIGH-1 (MarkdownIt 对照): `` `x``[[A]]` `` 的 opener/closer
  1044	    均为单反引号 (content 含双反引号) —— "≥ opener" 是 fenced 的规则不是 span 的,
  1045	    双反引号不得充当单反引号 span 的 closer; [[A]] 在 span 内必须被剥, A 报孤儿。
  1046	    变异对照: M16 (closer 退回 >= 语义) 指定杀本用例。"""
  1047	    root = tmp_path / "v"
  1048	    _node(root, "A")
  1049	    _board(root, "板", "`x``[[A]]`\n")
  1050	    res = vl.check_orphan_nodes(root)
  1051	    subjects = [f.subject for f in res.findings]
  1052	    assert subjects == ["节点/A.md"], f"双反引号被误当 closer, [[A]] 逃出 span: {subjects}"
  1053	
  1054	
  1055	def test_code_span_removal_leaves_placeholder_not_concatenation(tmp_path):
  1056	    """Codex round-5 HIGH-2: 剥除 span 后必须**空格占位** —— 空串拼接会把
  1057	    "[`x`[A]]" 拼成原文不存在的 "[[A]]" 伪入链, 反向隐藏真孤儿 A。"""
  1058	    root = tmp_path / "v"
  1059	    _node(root, "A")
  1060	    _board(root, "板", "[`x`[A]]\n")
  1061	    res = vl.check_orphan_nodes(root)
  1062	    subjects = [f.subject for f in res.findings]
  1063	    assert subjects == ["节点/A.md"], f"空串拼接制造伪入链 [[A]]: {subjects}"
  1064	
  1065	
  1066	# ---------------------------------------------------------------------------
  1067	# 3f. round-6 整改 —— 区间盲区法 (结构上不可能制造伪链) + 转义/跨 block
  1068	# ---------------------------------------------------------------------------
  1069	def test_code_span_inside_wikilink_does_not_create_link(tmp_path):
  1070	    """Codex round-6 HIGH-1: `` [[A`x`]] `` 的 MarkdownIt 解析 = text("[[A") +
  1071	    code_span("x") + text("]]") —— 原文没有指向 A 的链接 (target 是 "A`x`" 这个
  1072	    不存在的文件)。区间法在原文上扫描, 不得把 span 剥除后的 "[[A ]]" 当成 A 的入链。"""
  1073	    root = tmp_path / "v"
  1074	    _node(root, "A")
  1075	    _board(root, "板", "[[A`x`]]\n")
  1076	    res = vl.check_orphan_nodes(root)
  1077	    subjects = [f.subject for f in res.findings]
  1078	    assert "节点/A.md" in subjects, f"span 剥除制造了 A 的伪入链: {res.findings}"
  1079	
  1080	
  1081	def test_html_comment_inside_bracket_does_not_create_link(tmp_path):
  1082	    """Codex round-6 HIGH-2: "[<!--x-->[A]]" 原文没有 [[..]] —— 注释空串删除后
  1083	    拼接出的 "[[A]]" 是伪入链。区间法在原文上扫描, A 必须仍报孤儿。"""
  1084	    root = tmp_path / "v"
  1085	    _node(root, "A")
  1086	    _board(root, "板", "[<!--x-->[A]]\n")
  1087	    res = vl.check_orphan_nodes(root)
  1088	    subjects = [f.subject for f in res.findings]
  1089	    assert "节点/A.md" in subjects, f"注释删除拼接出伪入链 [[A]]: {res.findings}"
  1090	
  1091	
  1092	def test_escaped_backtick_is_not_delimiter(tmp_path):
  1093	    """Codex round-6 M1 (CommonMark backslash escapes): 反引号被转义后是普通文本 ——
  1094	    [[A]] 是**真入链**, 不得被剥掉并把 A 误报成孤儿 (旧行为的 fail-open)。"""
  1095	    root = tmp_path / "v"
  1096	    _node(root, "A")
  1097	    _board(root, "板", "\\`x [[A]]\\`\n")
  1098	    res = vl.check_orphan_nodes(root)
  1099	    assert res.findings == [], f"转义反引号后的真入链被剥掉, A 被误报: {res.findings}"
  1100	
  1101	
  1102	def test_code_span_does_not_span_blank_line(tmp_path):
  1103	    """Codex round-6 M2 (CommonMark: code span 不跨段落): "`x\\n\\n[[A]]`" 是两个
  1104	    text block, [[A]] 是**真入链** —— 跨空行配对会把它剥掉并误报孤儿。"""
  1105	    root = tmp_path / "v"
  1106	    _node(root, "A")
  1107	    _board(root, "板", "`x\n\n[[A]]`\n")
  1108	    res = vl.check_orphan_nodes(root)
  1109	    assert res.findings == [], f"span 跨空行配对剥掉了真入链, A 被误报: {res.findings}"

