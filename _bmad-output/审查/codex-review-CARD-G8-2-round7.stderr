   359	def _semantic_blind_intervals(body: str) -> list[tuple[int, int]]:
   360	    """正文里**非语义**区间的字符偏移列表 —— wikilink 起点落在任一区间内即不采纳
   361	    (Codex round-6 HIGH-1/HIGH-2 整改: 「先剥除再扫描」无论空串还是空格占位, 都可能
   362	    改写/拼接出**原文不存在**的 wikilink (`` [[A`x`]] `` → "[[A ]]"、"[<!--x-->[A]]" →
   363	    "[[A]]"); 区间法在**原始文本**上扫描 wikilink, 结构上不可能制造伪链)。
   364	
   365	    区间来源:
   366	      - AUTO-GENERATED 哨兵段 (BEGIN 行 → END 行整段, 含成员列表; BEGIN 无 -->、
   367	        NOTE 行以 --> 结尾 —— 成员行夹在两行注释之间, 必须段级处理);
   368	      - fenced code (closing fence 同字符且长度 ≥ opener, 四反引号栏内三反引号不关);
   369	      - code span (见 `_code_span_intervals`);
   370	      - HTML 注释 (跨行; 未闭合按 CommonMark 剥到 EOF)。
   371	    区间取并集: AUTO 段与围栏交叉的对抗构造 (round-2 登记的剩余缝隙) 下两段都盲,
   372	    该缝隙由此闭合。
   373	    """
   374	    intervals: list[tuple[int, int]] = []
   375	    # 行级结构: AUTO 段 + fenced code (keepends 保持偏移对齐原文)
   376	    fence_re: re.Pattern[str] | None = None
   377	    in_auto = False
   378	    offset = 0
   379	    for line in body.splitlines(keepends=True):
   380	        stripped = line.strip()
   381	        start, end = offset, offset + len(line)
   382	        offset = end
   383	        if in_auto:
   384	            if _AUTO_END_RE.match(stripped):
   385	                in_auto = False
   386	            intervals.append((start, end))
   387	            continue
   388	        if _AUTO_BEGIN_RE.match(stripped):
   389	            in_auto = True
   390	            intervals.append((start, end))
   391	            continue
   392	        if fence_re is not None:
   393	            if fence_re.fullmatch(stripped):
   394	                fence_re = None
   395	            intervals.append((start, end))
   396	            continue
   397	        m = re.match(r"^(`{3,}|~{3,})", stripped)
   398	        if m:
   399	            fence_re = re.compile(re.escape(m.group(1)[0]) + "{%d,}" % len(m.group(1)))
   400	            intervals.append((start, end))
   401	            continue
   402	    # 文本级: code span + HTML 注释
   403	    intervals.extend(_code_span_intervals(body))
   404	    for m in re.finditer(r"<!--.*?-->|<!--.*\Z", body, flags=re.S):
   405	        intervals.append(m.span())
   406	    return intervals
   407	
