   395	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   396	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   397	
   398	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   399	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   400	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   401	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   402	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   403	    要求"确实收集到用例"且"确实有失败"才算变红。
   404	    """
   405	    r = subprocess.run(
   406	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   407	        cwd=ROOT / "backend",
   408	        capture_output=True,
   409	        text=True,
   410	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   411	        timeout=600,
   412	    )
   413	    out = r.stdout
   414	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   415	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   416	    return r.returncode, out[-400:], passed + failed, failed
   417	
   418	
   419	def main() -> int:
   420	    try:
   421	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   422	    except FileExistsError:
   423	        print(
   424	            f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。"
   425	        )
   426	        return 2
   427	    try:
   428	        original = TARGET.read_bytes()
   429	        backup_sha = hashlib.sha256(original).hexdigest()
   430	
   431	        rc0, out0, n0, f0 = run_suite("domain_")
   432	        if rc0 != 0 or f0 or n0 == 0:
   433	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   434	            return 2
   435	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   436	
   437	        failures = 0
   438	        for name, subs, keyword in MUTANTS:
   439	            text = original.decode("utf-8")
   440	            for old, new in subs:
   441	                if old not in text:
   442	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   443	                    failures += 1
   444	                    text = None
   445	                    break
   446	                text = text.replace(old, new, 1)
   447	            if text is None:
   448	                continue
   449	            TARGET.write_text(text, encoding="utf-8")
   450	            try:
   451	                rc, out, n, f = run_suite(keyword)
   452	            finally:
   453	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   454	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   455	            assert got == backup_sha, (
   456	                f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   457	            )
   458	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   459	            if n == 0:
   460	                print(
   461	                    f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红"
   462	                )
   463	                failures += 1
   464	            elif f == 0:
   465	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   466	                failures += 1
   467	            else:
   468	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   469	
   470	        print(
   471	            f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）"
   472	        )
   473	        return 1 if failures else 0
   474	    finally:
