  2190	def _verify_report(path: str) -> int:
  2191	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2192	
  2193	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2194	    """
  2195	    try:
  2196	        text_raw = Path(path).read_text(encoding="utf-8")
  2197	    except (OSError, UnicodeDecodeError) as e:
  2198	        print(f"✗ 报告不可读: {type(e).__name__}")
  2199	        return 1
  2200	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2201	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2202	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2203	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2204	    if not fm_m:
  2205	        print("✗ 报告缺 frontmatter 块")

