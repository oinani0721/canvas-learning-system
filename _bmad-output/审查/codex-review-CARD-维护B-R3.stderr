  2458	def _verify_fallback_derive_numbers(text: str, scan: dict, problems: list[str]) -> None:
  2459	    """CARD-维护B-R2 round-3 (Codex HIGH-4/5b/6): fallback 允许式的**数字出处**绑定。
  2460	
  2461	    措辞白名单 ``_FALLBACK_DERIVE_ALLOW`` (在 _verify_report) 只管「这句话允许说」,
  2462	    这里管「说出来的数字必须有据」——白名单匹配与值绑定分属两处, 缺一即漏:
  2463	      · HIGH-4 (round-4 补: ③段限定移出 data_mode 条件——manifest 报告的附录
  2464	        伪信号实测同样放行): 「无来源结论」信号行只许出现在**③段** ——
  2465	        ③段外 (附录/自造段) 的同形行不受信号绑定保护;
  2466	      · HIGH-5b: ⑦『N 个派生角色成员缺来源锚点』的前置 N 必须全等
  2467	        ``signals.unsourced_conclusions.value`` (无据档不容许前置 N);
  2468	      · HIGH-6: 允许式 #2 (段落标题) 与 #5 (关系类型分布行) 行内出现的任何
  2469	        数字都必须在 scan 数值池 —— `#### 派生子女 987654 个的说明` /
  2470	        `- 关系类型分布：无 987654` 实测曾放行。
  2471	    """
  2472	    # HIGH-4 (round-4: 对 manifest 模式同样生效)
  2473	    s3 = "\n".join(
  2474	        re.findall(r"^### ③.*?(?=^#{2,3}(?:[^\S\n]|$)|\Z)", text, re.M | re.S)
  2475	    )
  2476	    rest = text.replace(s3, "", 1) if s3 else text
  2477	    if "无来源结论" in rest:
  2478	        problems.append(
  2479	            "数字终核: 「无来源结论」信号行只许出现在③段 "
  2480	            "(段外同形行不受信号绑定保护, 附录伪信号实测曾放行)"
  2481	        )
  2482	    if scan.get("data_mode") != "fallback_local":
