  2552	def _verify_report(path: str) -> int:
  2553	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2554	
  2555	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2556	    """
  2557	    try:
  2558	        text_raw = Path(path).read_text(encoding="utf-8")
  2559	    except (OSError, UnicodeDecodeError) as e:
  2560	        print(f"✗ 报告不可读: {type(e).__name__}")
  2561	        return 1
  2562	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2563	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2564	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2565	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2566	    if not fm_m:
  2567	        print("✗ 报告缺 frontmatter 块")
  2568	        return 1
  2569	    fm = fm_m.group(1)
  2570	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2571	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2572	    if "<!--" in fm or "-->" in fm:
  2573	        print("✗ frontmatter 块内含 HTML 注释标记")
  2574	        return 1
  2575	    problems: list[str] = []
  2576	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2577	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  2578	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  2579	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  2580	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  2581	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  2582	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  2583	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  2584	    if "<!--" in text_raw or "-->" in text_raw:
  2585	        problems.append(
  2586	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2587	        )
  2588	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  2589	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  2590	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
  2591	    # round-4: 零宽/双向控制字符 — 渲染不可见但能改变正则匹配与阅读顺序,
  2592	    # 是"看起来合规、实际另一回事"的通用载体。合法报告没有理由出现它们。
  2593	    # ⛔ R3 round-15 (冻结审查): 这里原先**手抄**了一份不可见字符集, 只到 U+2064,
  2594	    #    而 _INVISIBLE_ONE 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  2595	    #    又一处「同一原则两处定义」。改为共用 _INVISIBLE_ONE。
  2596	    if re.search(_INVISIBLE_ONE, text):
  2597	        problems.append("正文含零宽/双向控制字符 (不可见字符, 报告禁用)")
  2598	    _verify_numbers(fm, text, Path(path), problems)
  2599	    if not re.search(r"^type:\s*recap\s*$", fm, re.M):
  2600	        problems.append("frontmatter 缺 type: recap")
  2601	    if "规模自陈" not in text:
  2602	        problems.append("缺 规模自陈 callout")
  2603	    # 六轮防御③: 必需段落唯一 — 重复段(第一段合规第二段夹私货)不放行。
  2604	    # ⛔ round-6 BLOCKER 同源修复: 根因是**存在性检查与下游定位口径不一致**
  2605	    # —— 存在性用前缀匹配 (`^## AI 侧对账`), 下游 tips 绑定/动作段白名单却用
  2606	    # 整行正则定位, 于是 `## AI 侧对账（本轮）` 两头讨好: 算"段落在场"、
  2607	    # 却让下游整块校验静默跳过。模板里 `## 台账（种子/派生）` 这类**设计内的
  2608	    # 括号补充**又必须放行, 所以不能一刀切整行精确。
  2609	    # 统一口径 = `_SECTION_RE`: 段名之后只允许「行尾」或「全角括号补充」,
  2610	    # 存在性检查与下游定位共用它, 缝隙消失。
  2611	    for s in _VERIFY_SECTIONS:
  2612	        n = len(re.findall(_SECTION_RE(s), text, re.M))
  2613	        if n == 0:
  2614	            problems.append(f"缺段落 {s} (标题须为段名本身或段名+（补充）)")
  2615	        elif n > 1:
  2616	            problems.append(f"段落重复 {n} 次(只许一个): {s}")
  2617	    msha = re.search(r'^board_sha256:\s*"?([0-9a-f]+)"?', fm, re.M)
  2618	    if not msha or len(msha.group(1)) != 64:
  2619	        problems.append("board_sha256 必须完整 64 hex (在 frontmatter 内)")
  2620	    for w in _VERIFY_GLOBAL_FORBIDDEN:
  2621	        if w in text:
  2622	            problems.append(f"HARD-R4 禁词命中: {w}")
  2623	    for w in _VERIFY_PLACEHOLDERS:
  2624	        if w in text:
  2625	            problems.append(f"占位符残留: {w}")
  2626	    for w in _VERIFY_BLAME:
  2627	        if w in text:
  2628	            problems.append(f"白名单外动作/甩锅词: {w}")
  2629	    s3_all = re.findall(r"^### ③.*?(?=^### |\Z)", text, re.M | re.S)
  2630	    if not s3_all:
