   520	
   521	def _looks_like_crash(out: str) -> bool:
   522	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   523	
   524	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   525	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   526	    """
   527	    exc_lines = re.findall(r"^E\s+([A-Za-z_][\w.]*(?:[Ee]rror|Exception))\b", out, re.M)
   528	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   529	    return bool(
   530	        any(e != "AssertionError" for e in exc_lines)
   531	        or "Traceback (most recent call last):" in out
   532	        or "INTERNALERROR" in out
   533	        or errors > 0
   534	    )
   535	
   536	
   537	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   538	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   539	
   540	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   541	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   542	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   543	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   544	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   545	    要求"确实收集到用例"且"确实有失败"才算变红。
   546	    """
   547	    r = subprocess.run(
   548	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   549	        cwd=ROOT / "backend",
   550	        capture_output=True,
   551	        text=True,
   552	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   553	        timeout=600,
   554	    )
   555	    out = r.stdout
   556	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   557	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   558	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   559	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   560	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   561	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   562	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   563	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   564	    # 的形式混进证据, 且永远不会有人去查。
   565	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   566	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   567	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   568	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   569	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   570	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   571	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   572	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   573	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   574	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   575	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   576	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   577	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   578	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   579	    crash = _looks_like_crash(out)
   580	    return r.returncode, out[-400:], passed + failed, failed, crash
   581	
   582	
   583	def main() -> int:
   584	    try:
   585	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   586	    except FileExistsError:
   587	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   588	        return 2
   589	    try:
   590	        original = TARGET.read_bytes()
   591	        backup_sha = hashlib.sha256(original).hexdigest()
   592	
   593	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   594	        if rc0 != 0 or f0 or n0 == 0:
   595	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   596	            return 2
   597	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   598	
   599	        failures = 0
   600	        for name, subs, keyword in MUTANTS:
   601	            text = original.decode("utf-8")
   602	            for old, new in subs:
   603	                if old not in text:
   604	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   605	                    failures += 1
   606	                    text = None
   607	                    break
   608	                text = text.replace(old, new, 1)
   609	            if text is None:
   610	                continue
   611	            TARGET.write_text(text, encoding="utf-8")
   612	            try:
   613	                rc, out, n, f, crash = run_suite(keyword)
   614	            finally:
   615	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   616	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   617	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   618	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   619	            if n == 0:
   620	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   621	                failures += 1
   622	            elif rc != 1:
   623	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   624	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   625	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   626	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   627	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   628	                failures += 1
   629	            elif crash:
   630	                print(
   631	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   632	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   633	                )
   634	                failures += 1
   635	            elif f == 0:
   636	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   637	                failures += 1
   638	            else:
   639	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   640	
   641	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   642	        return 1 if failures else 0
   643	    finally:
   644	        LOCK.rmdir()
   645	
   646	
   647	if __name__ == "__main__":
   648	    sys.exit(main())

