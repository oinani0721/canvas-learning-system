   614	def _crash_text(stdout: str, stderr: str | None) -> str:
   615	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   616	
   617	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   618	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   619	    """
   620	    return stdout + "\n" + (stderr or "")
   621	
   622	
   623	def _looks_like_crash(out: str) -> bool:
   624	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   625	
   626	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   627	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   628	
   629	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   630	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   631	        标记出现即判崩溃 —— 不依赖任何渲染格式；
   632	      · **启发式**的那一半：解析外层 pytest 渲染（缩进上界 + assert 白名单），
   633	        绑定 `backend/pytest.ini` 当前的 `--tb=short`。它**会**漏（内层无
   634	        traceback 的崩溃、致命信号）**也会**误报（正文偶然含 traceback 字样）。
   635	        它只是补充，不是判据的主干。
   636	    """
   637	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   638	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   639	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   640	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   641	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   642	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   643	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   644	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   645	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   646	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   647	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   648	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   649	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   650	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   651	    # ⛔ round-21（冻结审查 v3）：上一版号称"可靠二分"，**那个说法不成立**，如实收回。
   652	    #    审查方点名的三条都对：
   653	    #      · 内层 CLI 的无 traceback 崩溃（`SyntaxError` / 致命信号）在外层只剩
   654	    #        一个 `AssertionError` ⇒ 假阴；
   655	    #      · 正文偶然含 `Traceback…` / `N error(s)` ⇒ 假阳；
   656	    #      · 缩进上界是**当前 formatter 的启发式** —— 而且我此前注释说"跑的是
   657	    #        `-q` 默认 tb"是**事实错误**：`backend/pytest.ini` 的 addopts 强制
   658	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   659	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   660	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   661	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   662	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   663	    if CHILD_CRASH_MARK in out:
   664	        return True
   665	    LEGIT_RED = {"assert", "AssertionError"}

