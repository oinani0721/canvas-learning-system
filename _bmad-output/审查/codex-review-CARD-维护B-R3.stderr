   497	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   498	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   499	
   500	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   501	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   502	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   503	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   504	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   505	    要求"确实收集到用例"且"确实有失败"才算变红。
   506	    """
   507	    r = subprocess.run(
   508	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   509	        cwd=ROOT / "backend",
   510	        capture_output=True,
   511	        text=True,
   512	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   513	        timeout=600,
   514	    )
   515	    out = r.stdout
   516	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   517	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   518	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   519	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   520	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   521	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   522	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   523	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   524	    # 的形式混进证据, 且永远不会有人去查。
   525	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   526	    crash = bool(
   527	        re.search(
   528	            r"\b(re\.error|SyntaxError|NameError|AttributeError|TypeError)\b", out
   529	        )
   530	    )
   531	    return r.returncode, out[-400:], passed + failed, failed, crash
