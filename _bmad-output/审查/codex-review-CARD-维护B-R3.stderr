   652	
   653	def _looks_like_crash(out: str) -> bool:
   654	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   655	
   656	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   657	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   658	
   659	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   660	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   661	        标记出现即判崩溃 —— 不依赖任何渲染格式；
   662	      · **启发式**的那一半：解析外层 pytest 渲染（缩进上界 + assert 白名单），
   663	        绑定 `backend/pytest.ini` 当前的 `--tb=short`。它**会**漏（内层无
   664	        traceback 的崩溃、致命信号）**也会**误报（正文偶然含 traceback 字样）。
   665	        它只是补充，不是判据的主干。
   666	    """
   667	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   668	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   669	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   670	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   671	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   672	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   673	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   674	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   675	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   676	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   677	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   678	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   679	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   680	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   681	    # ⛔ round-21（冻结审查 v3）：上一版号称"可靠二分"，**那个说法不成立**，如实收回。
   682	    #    审查方点名的三条都对：
   683	    #      · 内层 CLI 的无 traceback 崩溃（`SyntaxError` / 致命信号）在外层只剩
   684	    #        一个 `AssertionError` ⇒ 假阴；
   685	    #      · 正文偶然含 `Traceback…` / `N error(s)` ⇒ 假阳；
   686	    #      · 缩进上界是**当前 formatter 的启发式** —— 而且我此前注释说"跑的是
   687	    #        `-q` 默认 tb"是**事实错误**：`backend/pytest.ini` 的 addopts 强制
   688	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   689	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   690	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   691	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   692	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   693	    if CHILD_CRASH_MARK in out:
   694	        return True
   695	    LEGIT_RED = {"assert", "AssertionError"}
   696	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   697	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   698	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   699	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   700	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   701	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   702	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   703	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   704	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   705	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   706	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   707	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   708	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   709	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   710	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   711	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   712	    return bool(
   713	        any(name not in LEGIT_RED for name in exc_names)
   714	        or "Traceback (most recent call last):" in out
   715	        or "INTERNALERROR" in out
   716	        or errors > 0
   717	    )
   718	
   719	
   720	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   721	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   722	
   723	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   724	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   725	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   726	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   727	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   728	    要求"确实收集到用例"且"确实有失败"才算变红。
   729	    """
   730	    r = subprocess.run(
   731	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   732	        cwd=ROOT / "backend",
   733	        capture_output=True,
   734	        text=True,
   735	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   736	        timeout=600,
   737	    )
   738	    out = r.stdout
   739	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   740	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   741	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   742	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   743	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   744	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   745	    both = _crash_text(out, r.stderr)
   746	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   747	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   748	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   749	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   750	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   751	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   752	    # 的形式混进证据, 且永远不会有人去查。
   753	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   754	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   755	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   756	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   757	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   758	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   759	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   760	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   761	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   762	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   763	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   764	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   765	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   766	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   767	    crash = _looks_like_crash(both)
   768	    return r.returncode, out[-400:], passed + failed, failed, crash
