  1751	def _normalize_number_seps(line: str) -> str:
  1752	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1753	
  1754	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1755	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1756	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1757	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1758	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1759	    """
  1760	    # ⛔ R3 round-6: 解 HTML 实体已上移到 _visible_text() —— 两个消费点都在最前面
  1761	    # 跑它, 此处再解一次是**冗余**（且 `&amp;#46;` 会被双重解码成 `.`, 反而错）。
  1762	    # 一个性质只应有一个实现位置; 留在这里就是死代码。
  1763	    # ⛔ R3 round-5 (Codex round-4 HIGH-3): 逗号两侧也可能夹连接字符 ——
  1764	    # `987654<b>,</b>000个` 渲染成 `987654,000个`, 原式(要求逗号紧邻数字)不命中。
  1765	    return re.sub(
  1766	        rf"([0-9]){_D2_JOIN_ONE}*[,，'’]{_D2_JOIN_ONE}*(?=[0-9]{{3}}(?![0-9]))",
  1767	        r"\1",
  1768	        line,
  1769	    )
  1770	
