   995	def _strip_code_blocks(text: str) -> str:
   996	    """剔除**围栏**代码块 (```/~~~), 含引用块内的围栏 (round-4 M3 → round-5)。
   997	
   998	    代码块里的内容渲染为字面文本, 不是报告的陈述 —— 把信号行藏进去曾让
   999	    verifier 认为"信号行在场"。行数保持不变 (整行替空), 以免影响其他基于
  1000	    行的校验。
  1001	
  1002	    round-5 两项修正:
  1003	      · 引用前缀 (``> ``) 内的围栏此前不被识别 (``> ``` `` 逃逸) → 先剥
  1004	        引用前缀再判围栏;
  1005	      · **不再剥四空格缩进块** —— 合法的三级嵌套列表 (四空格缩进) 会被误删,
  1006	        实测导致"③段缺信号行"误报。缩进块里的信号行改由信号行自身的
  1007	        严格模板拒绝 (模板行首只允许 ``> ``/``- ``/空白, 不允许四空格缩进)。
  1008	
  1009	    ⛔ 维护卡 B · E1 (round-6 实证反例 `four-fence-short-close`): 原实现只存
  1010	    ``bare[:3]`` 并用 ``startswith`` 判闭合 —— 四反引号开栏、三反引号"闭合"后,
  1011	    后续内容被当成**块外正文**, 于是藏在 ``<pre><code>`` 里的信号行仍被 verifier
  1012	    当成在场陈述 (实测 exit 0)。CommonMark 的规则是: 闭合围栏必须**同字符**且
  1013	    **不短于**开栏。这里按规则记录开栏的完整标记再比长度。
  1014	    """
  1015	    out: list[str] = []
  1016	    fence: str | None = None  # 开栏的完整标记, 如 "````"
  1017	    # ⛔ Codex round-1 BLOCKER-1: 只比字符与长度**仍不是** CommonMark ——
  1018	    # 闭栏行在标记之后**只能有空白**(`` ````not-a-valid-close `` 不是闭栏),
  1019	    # 且围栏行缩进最多三格 (四格起是缩进代码块)。少这两条时,
  1020	    # ````text 后跟一个带 info string 的伪闭栏就能让后续信号行"看起来在块外",
  1021	    # 而 CommonMark 渲染里它们全在 <pre><code> 内 —— 实测 exit 0。
  1022	    open_re = re.compile(r"^(?P<ind> {0,3})(?P<fence>`{3,}|~{3,})")
  1023	    close_re = re.compile(r"^ {0,3}(?P<fence>`{3,}|~{3,})[^\S\n]*$")
  1024	    for ln in text.splitlines():
  1025	        # 剥任意层引用前缀后再判围栏。
  1026	        # ⛔ CARD-维护B-R2 round-2 线索（Codex 被截断前的中途发现, 本车道独立复现）:
  1027	        # 只剥 `>`/空白不剥**列表标记**时, `> - ``` ` (列表项内围栏, Obsidian 渲染为
  1028	        # 列表项内的代码块) 不被识别为开栏 —— 藏进里面的信号行被当成在场陈述,
  1029	        # 整篇 VERIFY PASS (实测 A/A2 两形态 exit 0)。剥列表符只影响**围栏判定**
  1030	        # (非围栏行 out.append 原样保留), 标记后须有空白 (`- ``` 是列表项围栏,
  1031	        # `---` 是 thematic break 不是列表)。
  1032	        # ⛔ CARD-维护B-R2 round-3: 无序 marker 之外**有序 marker** (`1. `) 与
  1033	        # **多层 marker** (`- - `) 同样是列表容器 (渲染为列表项内围栏), 一并剥。
  1034	        # ⛔ R3 round-26（冻结审查 v7）：原式的 `[>\s]` 会**吃掉任意前导空白**，
  1035	        #    于是 open_re 的 ` {0,3}` 形同虚设 —— 顶层缩进四格的 ``` 被当成开栏
  1036	        #    （CommonMark 里那是 indented code block，不是围栏），其后用户
  1037	        #    **看得见**的「本板共有 N 个…」会被当成围栏内内容整段免检。
  1038	        #    ⇒ 只剥**容器前缀**（引用 `>` / 列表 marker，各自最多 3 格缩进），
  1039	        #      无 marker 时**不动**前导空白，让 ` {0,3}` 真正生效。
  1040	        bare = re.sub(
  1041	            r"^(?: {0,3}(?:>|(?:[-*+]|\d{1,9}[.)])[^\S\n]+)[^\S\n]*)*", "", ln
  1042	        )
  1043	        if fence is None:
  1044	            m = open_re.match(bare)
  1045	            # 反引号围栏的 info string 不得含反引号 (CommonMark);
  1046	            # 波浪线围栏无此限制。
  1047	            if m and not (m.group("fence")[0] == "`" and "`" in bare[m.end() :]):
  1048	                fence = m.group("fence")
  1049	                # ⛔ round-3 BLOCKER-1 (Codex 实证 + 车道独立复现): 列表项内围栏
  1050	                # 的内容行**绝对内容列必须 ≥ 开栏行剥到围栏标记的绝对列** ——
  1051	                # 缩进不足的非空行会结束容器, 围栏随之结束, 该行渲染为
  1052	                # **可见正文** (三个 sibling <li> 的中间项)。不跟踪这一点时,
  1053	                # 可见伪计数被误当围栏内容剥掉, D2 漏拦 (实测
  1054	                # `- ``` / - 本板共有 987654 个… / - ``` ` exit 0)。
  1055	                # ⛔ 口径 = **绝对列** (round-5 LOW 更正: 原注释写「相对口径」与
  1056	                # 实现矛盾)——开栏列 = 本行剥掉的前缀长度; 内容行绝对列 =
  1057	                # _quote_width + _indent_after_quotes (引用系前缀 + 其后缩进,
  1058	                # 前导空白计入引用系)。无列表容器 (纯引用/缩进) 时无边界,
  1059	                # 行为不变。
  1060	                fence_list_col = None
  1061	                if re.search(r"(?:[-*+]|\d{1,9}[.)])[^\S\n]", ln):
  1062	                    fence_list_col = len(ln) - len(bare)
  1063	                out.append("")
  1064	                continue
  1065	        else:
  1066	            mc = close_re.match(bare)
  1067	            # 闭合: 同字符 + 长度 ≥ 开栏 + 其后只有空白
  1068	            if (
  1069	                mc
  1070	                and mc.group("fence")[0] == fence[0]
  1071	                and len(mc.group("fence")) >= len(fence)
  1072	            ):
  1073	                fence = None
  1074	                out.append("")
  1075	                continue
  1076	            if fence_list_col is not None and ln.strip():
  1077	                # 缩进不足 (相对引用系) 的非空行 → 容器结束, 围栏随之结束:
  1078	                # 该行按普通正文保留, 交回 D2/信号行校验。
  1079	                if _quote_width(ln) + _indent_after_quotes(ln) < fence_list_col:
  1080	                    fence = None
  1081	                    out.append(ln)
  1082	                    continue
  1083	            out.append("")
  1084	            continue
  1085	        out.append(ln)
  1086	    return "\n".join(out)
