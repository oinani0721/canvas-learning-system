  1487	@pytest.mark.parametrize(
  1488	    "ch,expected,why",
  1489	    [
  1490	        ("\x1f", True, "U+001F 是 C0 末位 — 原判据 ord<0x20 的上边界内"),
  1491	        (" ", False, "U+0020 空格 — 边界外, 合法板名常有"),
  1492	        ("~", False, "U+007E — DEL 的前一位, 必须放行"),
  1493	        ("\x7f", True, "U+007F DEL — 实测致 PyYAML ReaderError"),
  1494	        ("\x80", True, "U+0080 — C1 首位"),
  1495	        ("\x85", True, "U+0085 NEL — 实测致 exam_history.board_id=null"),
  1496	        ("\x9f", True, "U+009F — C1 末位"),
  1497	        ("\xa0", False, "U+00A0 NBSP — C1 的后一位, 是合法可打印空白必须放行"),
  1498	        ("\u2028", True, "U+2028 行分隔符 — splitlines 会在此断行"),
  1499	        ("\u2029", True, "U+2029 段分隔符"),
  1500	        ("\u200b", False, "U+200B 零宽空格 — 不属本判据（verifier 另有正文零宽检查）"),
  1501	        ("中", False, "CJK"),
  1502	        ("①", False, "带圈数字"),
  1503	        ("é", False, "带音标拉丁字母"),
  1504	        ("🎯", False, "emoji（星平面字符）"),
  1505	    ],
  1506	    ids=lambda v: None,
  1507	)
  1508	def test_m7_unsafe_name_chars_boundaries(ch, expected, why):
  1509	    """拒绝集的正反双向边界锁 — 每个「拒」的紧邻位都配了一个「放」。"""
  1510	    rs = _load_recap_scan()
  1511	    got = bool(rs.unsafe_name_chars(f"板{ch}名"))
  1512	    assert got is expected, f"{why}: 期望{'拒绝' if expected else '放行'}, 实际{'拒绝' if got else '放行'}"
