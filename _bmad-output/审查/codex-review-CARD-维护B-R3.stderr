  1716	
  1717	def _visible_text(line: str) -> str:
  1718	    """源码行 → **读者在 Obsidian 里看到的文本**（本域收敛器，非完整渲染器）。
  1719	
  1720	    顺序有讲究（每一步都对应前几轮的一条实测 HIGH）：
  1721	      1. **先解 HTML 实体**再做全角转换 —— 反过来会让 `&#xff19;` 解出 `９`
  1722	         之后再没有机会转成 ASCII（round-5 HIGH-3 实测）;
  1723	      2. 剥 HTML 标签 —— `<b>` 长度不限, 原先只有 ≤22 字符的短标签算连接字符;
  1724	      3. wikilink 取**显示文本** —— 有别名取别名, 无别名取目标本身
  1725	         （原实现把无别名链接的目标挖空, 而那正是读者看到的字, round-5 HIGH-8）;
  1726	      3b. link 三形态按 **inline → reference → shortcut** 顺序剥 —— shortcut 式
  1727	         方括号最宽, 放最后才不会把 inline/reference 的显示文本先吃掉留下裸 url;
  1728	      4. 去零宽/双向控制字符;
  1729	      5. 去强调标记 `*_` 与成对 `~~` —— ⚠️ 未配对时渲染**可见**, 去掉它们是一个
  1730	         **已知 fail-open 面**而非安全边界（`1\\*5个` 按 15 入池，池含 15 并不能
  1731	         证明读者看到的 `1*5` 有出处）。此前写的「安全向、不构成虚构通道」**已被
  1732	         证伪**，round-13 的试修亦实测无收益并已回退。如实登记，不再声称安全。
  1733	
  1734	    ⚠️ **不碰 inline code**: `` `…` `` 的内容在本域是**有意豁免**的字段值
  1735	    （E2, 见 _blank_inline_code），不是"被隐藏的计数"。这是**声明过的设计选择**,
  1736	    不是遗漏 —— 如实登记在验收单, 不在这里悄悄改语义。
  1737	    """
  1738	    line = html.unescape(line)
  1739	    line = line.translate(_FULLWIDTH_DIGITS)
  1740	    line = _VIS_TAG_RE.sub("", line)
  1741	    line = _VIS_WIKILINK_ALIAS_RE.sub(r"\1", line)
  1742	    line = _VIS_WIKILINK_PLAIN_RE.sub(r"\1", line)
  1743	    line = _VIS_MDLINK_RE.sub(r"\1", line)
  1744	    line = _VIS_REFLINK_RE.sub(r"\1", line)
  1745	    line = _VIS_SHORTCUT_LINK_RE.sub(r"\1", line)
  1746	    line = _VIS_INVISIBLE_RE.sub("", line)
  1747	    line = _VIS_STRIKE_RE.sub("", line)
  1748	    return _VIS_EMPHASIS_RE.sub("", line)
  1749	
