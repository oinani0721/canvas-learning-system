  1768	def _visible_block(text: str) -> str:
  1769	    """整块文本的**渲染后**形态：逐行过 `_visible_text` 再拼回去。
  1770	
  1771	    ⛔ 这个模式在本卡出现了**四次**（③段信号行选行 / 五元组 / 台账种子行的
  1772	    值绑定与形状门），每次都是"某处判据还在源码文本上做，而同一条内容的另一道
  1773	    检查已经在渲染文本上做"。⇒ 提为**单一应用点**，新增消费方直接用它。
  1774	
  1775	    ⚠️ 逐行归一后拼接，**行数与顺序不变** —— 依赖 `^...$` 多行锚点的正则
  1776	    （段落抓取、整行 fullmatch）可以直接换用它而不改语义。
  1777	    """
  1778	    return "\n".join(_visible_text(ln) for ln in text.splitlines())
