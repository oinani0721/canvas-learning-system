  1445	def _scan_number_pool(obj, pool: set[int]) -> None:
  1446	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1447	
  1448	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1449	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1450	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1451	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1452	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1453	    """
  1454	    if isinstance(obj, bool):
  1455	        return
  1456	    if isinstance(obj, int):
  1457	        pool.add(obj)
  1458	    elif isinstance(obj, float):
  1459	        if obj.is_integer():
