  4868	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4869	        report.write_text(text, encoding="utf-8")
  4870	        return run_verify(report)
  4871	
  4872	    HIDE = "- 本板共有987654个子节点。【实测】"
  4873	    assert 987654 not in rs._derived_number_pool(scan), "前提：987654 必须在池外"
  4874	
  4875	    # ① 四空格不是围栏 ⇒ 藏在里面的可见计数必须受检
  4876	    r = in3(f"    ```\n{HIDE}\n    ```")
  4877	    assert r.returncode != 0, "四空格伪围栏让可见计数整段免检"
  4878	    assert _one_problem_has(r.stdout, "987654"), f"诊断未指向 987654:\n{r.stdout}"
  4879	
  4880	    # ② 对照：真围栏（0-3 格）与列表项内围栏仍豁免（否则是误伤）
  4881	    for block, why in (
  4882	        (f"```\n{HIDE}\n```", "顶层真围栏"),
  4883	        (f"   ```\n{HIDE}\n   ```", "三格缩进真围栏"),
  4884	        (f"- ```\n  {HIDE}\n- ```", "列表项内围栏（round-2 修过的形态）"),
  4885	    ):
