   623	def _crash_text(stdout: str, stderr: str | None) -> str:
   624	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   625	
   626	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   627	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   628	    """
   629	    return stdout + "\n" + (stderr or "")
   630	
   631	
   632	def _looks_like_crash(out: str) -> bool:
   633	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   634	
   635	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   636	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   637	
   638	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   639	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   640	        标记出现即判崩溃 —— 不依赖任何渲染格式；
   641	      · **启发式**的那一半：解析外层 pytest 渲染（缩进上界 + assert 白名单），
   642	        绑定 `backend/pytest.ini` 当前的 `--tb=short`。它**会**漏（内层无
   643	        traceback 的崩溃、致命信号）**也会**误报（正文偶然含 traceback 字样）。
   644	        它只是补充，不是判据的主干。
   645	    """
   646	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   647	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   648	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   649	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   650	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   651	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   652	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   653	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   654	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   655	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   656	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   657	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   658	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   659	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   660	    # ⛔ round-21（冻结审查 v3）：上一版号称"可靠二分"，**那个说法不成立**，如实收回。
   661	    #    审查方点名的三条都对：
   662	    #      · 内层 CLI 的无 traceback 崩溃（`SyntaxError` / 致命信号）在外层只剩
   663	    #        一个 `AssertionError` ⇒ 假阴；
   664	    #      · 正文偶然含 `Traceback…` / `N error(s)` ⇒ 假阳；
   665	    #      · 缩进上界是**当前 formatter 的启发式** —— 而且我此前注释说"跑的是
   666	    #        `-q` 默认 tb"是**事实错误**：`backend/pytest.ini` 的 addopts 强制
   667	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   668	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   669	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   670	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   671	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   672	    if CHILD_CRASH_MARK in out:
   673	        return True
   674	    LEGIT_RED = {"assert", "AssertionError"}
   675	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   676	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   677	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   678	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   679	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   680	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   681	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   682	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   683	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   684	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   685	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   686	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   687	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   688	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   689	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   690	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   691	    return bool(
   692	        any(name not in LEGIT_RED for name in exc_names)
   693	        or "Traceback (most recent call last):" in out
   694	        or "INTERNALERROR" in out
   695	        or errors > 0
   696	    )
   697	
   698	
   699	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   700	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   701	
   702	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   703	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   704	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   705	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   706	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   707	    要求"确实收集到用例"且"确实有失败"才算变红。
   708	    """
   709	    r = subprocess.run(
   710	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   711	        cwd=ROOT / "backend",
   712	        capture_output=True,
   713	        text=True,
   714	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   715	        timeout=600,
   716	    )
   717	    out = r.stdout
   718	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   719	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   720	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   721	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   722	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   723	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   724	    both = _crash_text(out, r.stderr)
   725	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   726	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   727	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   728	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   729	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   730	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   731	    # 的形式混进证据, 且永远不会有人去查。
   732	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   733	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   734	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   735	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   736	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   737	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   738	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   739	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   740	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   741	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   742	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   743	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   744	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   745	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   746	    crash = _looks_like_crash(both)
   747	    return r.returncode, out[-400:], passed + failed, failed, crash
   748	
   749	
   750	def main() -> int:
   751	    try:
   752	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   753	    except FileExistsError:
   754	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   755	        return 2
   756	    try:
   757	        original = TARGET.read_bytes()
   758	        backup_sha = hashlib.sha256(original).hexdigest()
   759	
   760	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   761	        if rc0 != 0 or f0 or n0 == 0:
   762	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   763	            return 2
   764	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   765	
   766	        failures = 0
   767	        for name, subs, keyword in MUTANTS:
   768	            text = original.decode("utf-8")
   769	            for old, new in subs:
   770	                if old not in text:
   771	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   772	                    failures += 1
   773	                    text = None
   774	                    break
   775	                text = text.replace(old, new, 1)
   776	            if text is None:
   777	                continue
   778	            # ⛔ R3 round-23（冻结审查 v4）：写入原先在 `try` **之前** —— 写到一半抛异常
   779	            #    （磁盘满 / 权限 / 编码）就落不进 finally，变异体留在生产文件里。
   780	            #    把写入挪进 try：从"文件可能已被改动"的第一刻起就有还原兜底。
   781	            #    ⚠️ 如实声明**兜底不到**的情况：SIGKILL / 解释器崩溃 / 断电 ——
   782	            #    Python 层的 finally 对它们无能为力，前后 hash 自检也覆盖不了
   783	            #    （进程都没了）。真正的根治是"改副本不改原件"，属重做设计，未做。
   784	            #    残留检测靠外部锚点：见 MEMORY `reference_mutation_restore_must_be_unconditional`
   785	            #    （grep MUTANT + sha 对比），本脚本自身证明不了这件事。
   786	            try:
   787	                TARGET.write_text(text, encoding="utf-8")
   788	                rc, out, n, f, crash = run_suite(keyword)
   789	            finally:
   790	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   791	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   792	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   793	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   794	            if n == 0:
   795	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   796	                failures += 1
   797	            elif rc != 1:
   798	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   799	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   800	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   801	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   802	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   803	                failures += 1
   804	            elif crash:
   805	                print(
   806	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   807	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   808	                )
   809	                failures += 1
   810	            elif f == 0:
   811	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   812	                failures += 1
   813	            else:
   814	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   815	
   816	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   817	        return 1 if failures else 0
   818	    finally:
   819	        LOCK.rmdir()
   820	
   821	
   822	if __name__ == "__main__":
   823	    sys.exit(main())

