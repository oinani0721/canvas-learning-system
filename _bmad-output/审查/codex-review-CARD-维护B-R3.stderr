   689	
   690	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   691	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   692	
   693	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   694	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   695	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   696	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   697	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   698	    要求"确实收集到用例"且"确实有失败"才算变红。
   699	    """
   700	    r = subprocess.run(
   701	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   702	        cwd=ROOT / "backend",
   703	        capture_output=True,
   704	        text=True,
   705	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   706	        timeout=600,
   707	    )
   708	    out = r.stdout
   709	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   710	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   711	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   712	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   713	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   714	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   715	    both = _crash_text(out, r.stderr)
   716	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   717	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   718	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   719	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   720	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   721	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   722	    # 的形式混进证据, 且永远不会有人去查。
   723	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   724	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   725	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   726	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   727	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   728	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   729	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   730	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   731	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   732	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   733	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   734	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   735	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   736	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   737	    crash = _looks_like_crash(both)
   738	    return r.returncode, out[-400:], passed + failed, failed, crash
   739	
   740	
   741	def main() -> int:
   742	    try:
   743	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   744	    except FileExistsError:
   745	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   746	        return 2
   747	    try:
   748	        original = TARGET.read_bytes()
   749	        backup_sha = hashlib.sha256(original).hexdigest()
   750	
   751	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   752	        if rc0 != 0 or f0 or n0 == 0:
   753	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   754	            return 2
   755	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   756	
   757	        failures = 0
   758	        for name, subs, keyword in MUTANTS:
   759	            text = original.decode("utf-8")
   760	            for old, new in subs:
   761	                if old not in text:
   762	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   763	                    failures += 1
   764	                    text = None
   765	                    break
   766	                text = text.replace(old, new, 1)
   767	            if text is None:
   768	                continue
   769	            TARGET.write_text(text, encoding="utf-8")
   770	            try:
   771	                rc, out, n, f, crash = run_suite(keyword)
   772	            finally:
   773	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   774	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   775	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   776	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   777	            if n == 0:
   778	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   779	                failures += 1
   780	            elif rc != 1:
   781	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   782	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   783	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   784	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   785	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   786	                failures += 1
   787	            elif crash:
   788	                print(
   789	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   790	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   791	                )
   792	                failures += 1
   793	            elif f == 0:
   794	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   795	                failures += 1
   796	            else:
   797	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   798	
   799	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   800	        return 1 if failures else 0
   801	    finally:
   802	        LOCK.rmdir()
   803	
   804	
   805	if __name__ == "__main__":
   806	    sys.exit(main())

