   847	            return 2
   848	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   849	
   850	        failures = 0
   851	        for name, subs, keyword in MUTANTS:
   852	            text = original.decode("utf-8")
   853	            for old, new in subs:
   854	                if old not in text:
   855	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   856	                    failures += 1
   857	                    text = None
   858	                    break
   859	                text = text.replace(old, new, 1)
   860	            if text is None:
   861	                continue
   862	            # ⛔ R3 round-23（冻结审查 v4）：写入原先在 `try` **之前** —— 写到一半抛异常
   863	            #    （磁盘满 / 权限 / 编码）就落不进 finally，变异体留在生产文件里。
   864	            #    把写入挪进 try：从"文件可能已被改动"的第一刻起就有还原兜底。
   865	            #    ⚠️ 如实声明**兜底不到**的情况：SIGKILL / 解释器崩溃 / 断电 ——
   866	            #    Python 层的 finally 对它们无能为力，前后 hash 自检也覆盖不了
   867	            #    （进程都没了）。真正的根治是"改副本不改原件"，属重做设计，未做。
   868	            #    残留检测靠外部锚点：见 MEMORY `reference_mutation_restore_must_be_unconditional`
   869	            #    （grep MUTANT + sha 对比），本脚本自身证明不了这件事。
   870	            try:
   871	                TARGET.write_text(text, encoding="utf-8")
   872	                rc, out, n, f, crash = run_suite(keyword)
   873	            finally:
   874	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   875	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   876	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   877	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   878	            if n == 0:
   879	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   880	                failures += 1
   881	            elif rc != 1:
   882	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   883	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   884	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   885	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   886	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   887	                failures += 1
