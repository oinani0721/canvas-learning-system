  3290	    """round-4 C: 允许式行内的**中文数词**也必须入池比对。
  3291	
  3292	    `#### 派生子女 九十八万个 的说明`——`\\d+` 抓不到中文数字，实测放行
  3293	    （Codex round-4 探针 C）。
  3294	    ⛔ round-5 定向复核 HIGH 整改: 多字数词**不再交给 _cjk_to_int**——提取
  3295	    字符集与映射表同集导致「解析失败」分支静态不可达，且连续数字字只留末位
  3296	    （「五四」得 4）可能按错值查池。现只认**单字**数词（值=映射，绝对确定），
  3297	    多字串一律「无法验证」fail-closed（模板/合成语料无多字合法用例，零误伤）。
  3298	    """
  3299	    # 多字数词 → 无法验证（round-5 HIGH 锁: 不许按错值查池后放行）
  3300	    for name, inject in (
  3301	        ("九十八万", "\n#### 派生子女 九十八万个 的说明\n"),
  3302	        ("五四_末位陷阱", "\n#### 派生子女 五四 个 的说明\n"),
  3303	    ):
  3304	        r = _mutate_report(
  3305	            tmp_path / name,
  3306	            lambda t, s, e=inject: t.replace("方向叙述：", f"{e}\n方向叙述：", 1),
  3307	        )
  3308	        assert r.returncode != 0, f"{name}: 中文数词绕过被放行:\n{r.stdout}"
  3309	        assert "无法验证" in r.stdout, (
  3310	            f"{name}: 应走「无法验证」fail-closed（不许按解析值查池）:\n{r.stdout}"
  3311	        )
