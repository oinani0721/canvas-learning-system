   961	
   962	
   963	def _quote_width(line: str) -> int:
   964	    """行首到引用内容起点的宽度: 前导空白 + 逐层 `>`(+至多一空白)。
   965	
   966	    `> > - x` → 4; ` > - x` → 3 (⛔ round-4 抢救探针 A: 引用标记**前**的
   967	    前导空白计入——它是引用层的一部分); 无引用 (`- x` / `    x`) → 0。
   968	    """
   969	    pos, n = 0, len(line)
   970	    while pos < n and line[pos] in " \t":
   971	        pos += 1
   972	    w = pos
   973	    saw = False
   974	    while pos < n:
   975	        ch = line[pos]
   976	        if ch == ">":
   977	            saw = True
   978	            pos += 2 if pos + 1 < n and line[pos + 1] in " \t" else 1
   979	            w = pos
   980	        elif ch in " \t" and pos + 1 < n and line[pos + 1] == ">":
   981	            pos += 1
   982	            w = pos
   983	        else:
   984	            break
   985	    return w if saw else 0
   986	
   987	
   988	def _indent_after_quotes(line: str) -> int:
   989	    """引用系前缀之后的剩余缩进 (与 _quote_width 相加 = 内容的绝对列)。"""
   990	    w = _quote_width(line)
   991	    rest = line[w:]
   992	    return len(rest) - len(rest.lstrip(" \t"))
   993	
   994	
   995	def _strip_code_blocks(text: str) -> str:
   996	    """剔除**围栏**代码块 (```/~~~), 含引用块内的围栏 (round-4 M3 → round-5)。
   997	
   998	    代码块里的内容渲染为字面文本, 不是报告的陈述 —— 把信号行藏进去曾让
   999	    verifier 认为"信号行在场"。行数保持不变 (整行替空), 以免影响其他基于
  1000	    行的校验。
  1001	
  1002	    round-5 两项修正:
  1003	      · 引用前缀 (``> ``) 内的围栏此前不被识别 (``> ``` `` 逃逸) → 先剥
  1004	        引用前缀再判围栏;
  1005	      · **不再剥四空格缩进块** —— 合法的三级嵌套列表 (四空格缩进) 会被误删,
  1006	        实测导致"③段缺信号行"误报。缩进块里的信号行改由信号行自身的
  1007	        严格模板拒绝 (模板行首只允许 ``> ``/``- ``/空白, 不允许四空格缩进)。
  1008	
  1009	    ⛔ 维护卡 B · E1 (round-6 实证反例 `four-fence-short-close`): 原实现只存
  1010	    ``bare[:3]`` 并用 ``startswith`` 判闭合 —— 四反引号开栏、三反引号"闭合"后,
  1011	    后续内容被当成**块外正文**, 于是藏在 ``<pre><code>`` 里的信号行仍被 verifier
  1012	    当成在场陈述 (实测 exit 0)。CommonMark 的规则是: 闭合围栏必须**同字符**且
  1013	    **不短于**开栏。这里按规则记录开栏的完整标记再比长度。
  1014	    """
  1015	    out: list[str] = []
  1016	    fence: str | None = None  # 开栏的完整标记, 如 "````"
  1017	    # ⛔ Codex round-1 BLOCKER-1: 只比字符与长度**仍不是** CommonMark ——
  1018	    # 闭栏行在标记之后**只能有空白**(`` ````not-a-valid-close `` 不是闭栏),
  1019	    # 且围栏行缩进最多三格 (四格起是缩进代码块)。少这两条时,
  1020	    # ````text 后跟一个带 info string 的伪闭栏就能让后续信号行"看起来在块外",
  1021	    # 而 CommonMark 渲染里它们全在 <pre><code> 内 —— 实测 exit 0。
  1022	    open_re = re.compile(r"^(?P<ind> {0,3})(?P<fence>`{3,}|~{3,})")
  1023	    close_re = re.compile(r"^ {0,3}(?P<fence>`{3,}|~{3,})[^\S\n]*$")
  1024	    for ln in text.splitlines():
  1025	        # 剥任意层引用前缀后再判围栏。
  1026	        # ⛔ CARD-维护B-R2 round-2 线索（Codex 被截断前的中途发现, 本车道独立复现）:
  1027	        # 只剥 `>`/空白不剥**列表标记**时, `> - ``` ` (列表项内围栏, Obsidian 渲染为
  1028	        # 列表项内的代码块) 不被识别为开栏 —— 藏进里面的信号行被当成在场陈述,
  1029	        # 整篇 VERIFY PASS (实测 A/A2 两形态 exit 0)。剥列表符只影响**围栏判定**
  1030	        # (非围栏行 out.append 原样保留), 标记后须有空白 (`- ``` 是列表项围栏,
  1031	        # `---` 是 thematic break 不是列表)。
  1032	        # ⛔ CARD-维护B-R2 round-3: 无序 marker 之外**有序 marker** (`1. `) 与
  1033	        # **多层 marker** (`- - `) 同样是列表容器 (渲染为列表项内围栏), 一并剥。
  1034	        bare = re.sub(r"^(?:[>\s]|(?:[-*+]|\d{1,9}[.)])[^\S\n]+)*", "", ln)
  1035	        if fence is None:
  1036	            m = open_re.match(bare)
  1037	            # 反引号围栏的 info string 不得含反引号 (CommonMark);
  1038	            # 波浪线围栏无此限制。
  1039	            if m and not (m.group("fence")[0] == "`" and "`" in bare[m.end() :]):
  1040	                fence = m.group("fence")
  1041	                # ⛔ round-3 BLOCKER-1 (Codex 实证 + 车道独立复现): 列表项内围栏
  1042	                # 的内容行**绝对内容列必须 ≥ 开栏行剥到围栏标记的绝对列** ——
  1043	                # 缩进不足的非空行会结束容器, 围栏随之结束, 该行渲染为
  1044	                # **可见正文** (三个 sibling <li> 的中间项)。不跟踪这一点时,
  1045	                # 可见伪计数被误当围栏内容剥掉, D2 漏拦 (实测
  1046	                # `- ``` / - 本板共有 987654 个… / - ``` ` exit 0)。
  1047	                # ⛔ 口径 = **绝对列** (round-5 LOW 更正: 原注释写「相对口径」与
  1048	                # 实现矛盾)——开栏列 = 本行剥掉的前缀长度; 内容行绝对列 =
  1049	                # _quote_width + _indent_after_quotes (引用系前缀 + 其后缩进,
  1050	                # 前导空白计入引用系)。无列表容器 (纯引用/缩进) 时无边界,
  1051	                # 行为不变。
  1052	                fence_list_col = None
  1053	                if re.search(r"(?:[-*+]|\d{1,9}[.)])[^\S\n]", ln):
  1054	                    fence_list_col = len(ln) - len(bare)
  1055	                out.append("")
  1056	                continue
  1057	        else:
  1058	            mc = close_re.match(bare)
  1059	            # 闭合: 同字符 + 长度 ≥ 开栏 + 其后只有空白
  1060	            if (
  1061	                mc
  1062	                and mc.group("fence")[0] == fence[0]
  1063	                and len(mc.group("fence")) >= len(fence)
  1064	            ):
  1065	                fence = None
  1066	                out.append("")
  1067	                continue
  1068	            if fence_list_col is not None and ln.strip():
  1069	                # 缩进不足 (相对引用系) 的非空行 → 容器结束, 围栏随之结束:
  1070	                # 该行按普通正文保留, 交回 D2/信号行校验。

