   731	def write_report(vault: Path, scan: dict) -> Path:
   732	    outputs = vault / "outputs"
   733	    (outputs / f".recap-scan-{BOARD}.json").write_text(json.dumps(scan, ensure_ascii=False), encoding="utf-8")
   734	    report = outputs / f"回顾-{BOARD}-{scan['recap_date']}.md"
   735	    report.write_text(render_report(scan), encoding="utf-8")

