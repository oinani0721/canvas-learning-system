  1675	def _count_token_value(token: str) -> int | None:
  1676	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1677	
  1678	    只两种情形给值:
  1679	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1680	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1681	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1682	    """
  1683	    if not token:
  1684	        return None
  1685	    if token.isascii() and token.isdigit():
  1686	        return int(token)
  1687	    return _cjk_single_to_int(token)
