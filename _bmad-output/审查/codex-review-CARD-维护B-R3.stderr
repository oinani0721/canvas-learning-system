   601	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   602	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   603	
   604	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   605	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   606	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   607	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   608	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   609	    要求"确实收集到用例"且"确实有失败"才算变红。
   610	    """
   611	    r = subprocess.run(
   612	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   613	        cwd=ROOT / "backend",
   614	        capture_output=True,
   615	        text=True,
   616	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   617	        timeout=600,
   618	    )
   619	    out = r.stdout
   620	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   621	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   622	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   623	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   624	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   625	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   626	    both = _crash_text(out, r.stderr)
   627	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   628	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   629	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   630	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   631	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   632	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   633	    # 的形式混进证据, 且永远不会有人去查。
   634	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   635	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
