    88	def _ts(days: int) -> str:
    89	    """N 天 + 2h 前的 ISO 时间戳 → collect 时 floor 年龄恰 N 天。"""
    90	    return (datetime.now(timezone.utc) - timedelta(days=days, hours=2)).strftime("%Y-%m-%dT%H:%M:%SZ")
    91	
    92	
    93	def run_collect(vault: Path, board: str = BOARD, *extra: str) -> subprocess.CompletedProcess:
    94	    if not SCRIPT.exists():  # 防「脚本不存在 → 非零退出 → 拒绝类断言假绿」
    95	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
    96	    return subprocess.run(
    97	        [sys.executable, str(SCRIPT), "--vault", str(vault), "--board", board, *extra],
    98	        capture_output=True,
    99	        text=True,
   100	        timeout=60,
   101	    )
   102	
   103	
   104	# 子进程崩溃的确定性标记（见 _surface_child_stderr / negverify._looks_like_crash）。
   105	# 刻意选一个不会在正常报告或诊断里出现的串。
   106	CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   107	
   108	
   109	def _surface_child_stderr(r: subprocess.CompletedProcess) -> None:
   110	    """把**被测 CLI 子进程**的 stderr 抬到测试自己的 stdout 上。
   111	
   112	    ⛔ round-20（冻结审查 v2 §四.4）：本域大量门是跑 CLI 子进程再核 stdout 的，
   113	    子进程以 `capture_output=True` 执行，断言里只带 `r.stdout` ⇒ 内层 traceback
   114	    若只落在 `r.stderr`，**外层 pytest 的两路输出里根本不会出现它**，
   115	    `recap_domain_negverify` 的崩溃识别就永远看不见内层崩溃。
   116	    pytest 会在失败时展示 "Captured stdout call"，所以 print 到这里即接通。
   117	    """
   118	    if not (r.stderr and r.stderr.strip()):
   119	        return
   120	    # ⛔ round-21（冻结审查 v3）：外层判据原先只能**解析 pytest 的渲染**去猜
   121	    # "这次红是崩溃还是判错"，那是随 formatter 变的启发式。这里改为在源头打一个
   122	    # **确定性标记**：子进程 stderr 里出现 traceback = 被测 CLI 崩了，事实明确，
   123	    # 不需要下游再猜。标记串刻意选得不会在正常输出里出现。
   124	    if "Traceback (most recent call last):" in r.stderr:
   125	        print(f"{CHILD_CRASH_MARK} rc={r.returncode}")
   126	    print(f"[child stderr]\n{r.stderr}")
   127	
   128	
   129	def run_verify(report: Path) -> subprocess.CompletedProcess:
   130	    if not SCRIPT.exists():
   131	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
   132	    r = subprocess.run(
   133	        [sys.executable, str(SCRIPT), "--verify", str(report)],
   134	        capture_output=True,
   135	        text=True,
   136	        timeout=60,
   137	    )
   138	    _surface_child_stderr(r)
   139	    return r
   140	
