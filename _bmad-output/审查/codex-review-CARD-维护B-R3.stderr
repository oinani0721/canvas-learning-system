  2582	            json.dumps(
  2583	                {"error": f"vault 不可用: {board_dir} 不存在"}, ensure_ascii=False
  2584	            )
  2585	        )
  2586	        return 2
  2587	    # B2 二轮: 目录级 symlink 守卫 — 原白板/节点/outputs 任一被换成指向
  2588	    # vault 外 (如 sibling vault) 的目录 symlink, 一切 containment 都会被
  2589	    # 架空 → 环境不可用, 拒绝扫描。
  2590	    vault_resolved = vault.resolve()
