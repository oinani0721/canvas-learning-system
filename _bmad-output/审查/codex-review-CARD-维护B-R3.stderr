  2103	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  2104	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  2105	
  2106	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  2107	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  2108	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  2109	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  2110	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  2111	    """
  2112	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  2113	    if not mb:
  2114	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  2115	        return
  2116	    board_id = mb.group(1).strip()
  2117	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  2118	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  2119	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  2120	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
  2121	    if not mname:
  2122	        problems.append(f"报告文件名不符 `回顾-<板>-<日期>.md`: {report_path.name}")
  2123	    elif mname.group(1) != board_id:
  2124	        problems.append(
  2125	            f"数字终核: frontmatter board={board_id!r} 与文件名的板 "
  2126	            f"{mname.group(1)!r} 不一致 (不得绑定另一块板的 scan JSON)"
  2127	        )
  2128	    scan_path = report_path.parent / f".recap-scan-{board_id}.json"
  2129	    try:
  2130	        scan = json.loads(scan_path.read_text(encoding="utf-8"))
