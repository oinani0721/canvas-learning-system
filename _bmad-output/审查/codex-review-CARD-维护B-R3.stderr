  2041	    # 跳过** (信号行可整体删除/随意改数/谎标无据仍 PASS)。这是五轮信号防线
  2042	    # 的总开关。现在: 缺段落 → 记 problem 并**继续**跑 signals 绑定, 绝不
  2043	    # 静默 return; 段落标题的整行锚定另在 _verify_report 收口。
  2044	    recon = re.search(
  2045	        _SECTION_RE("## AI 侧对账") + r"(.*?)(?=^#{2}(?:[^\S\n]|$)|\Z)",
  2046	        text,
  2047	        re.M | re.S,
  2048	    )
  2049	    if not recon:
  2050	        problems.append(
  2051	            "数字终核: 未找到『## AI 侧对账』段 (标题须为段名本身或段名+（补充）) "
  2052	            "— tips 两数无法绑定"
  2053	        )
  2054	        _verify_signals_if_present(text, scan, problems)
  2055	        return
  2056	    # 两行均为必需 (五轮 H5 残余: 缺行不许静默豁免 — 改写成非模板措辞
  2057	    # 即逃逸绑定, 必须 fail-closed)。
  2058	    # ⛔ round-6 终裁复核: 原用 re.search 只绑**首个**匹配, 段内第二条同形句
  2059	    # 与段外同一句都不受检 → 改为**全文逐条**校验且段内必须各恰好一条。
  2060	    for pat, ckey, name in (
  2061	        (r"tips 批注共\s*(\d+)\s*条", "tips_total", "tips 总数"),
  2062	        (r"其中理解度未闭环\s*(\d+)\s*条", "tips_understanding_open", "tips 未闭环"),
  2063	    ):
  2064	        in_sec = re.findall(pat, recon.group(1))
  2065	        all_hits = re.findall(pat, text)
  2066	        want_v = counts.get(ckey, -1)
  2067	        if not in_sec:
  2068	            problems.append(f"数字终核: AI 侧对账缺『{name}』标准计数行")
  2069	        elif len(in_sec) > 1:
