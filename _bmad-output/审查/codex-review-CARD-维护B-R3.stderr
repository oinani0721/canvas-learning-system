  1802	def _count_token_value(token: str) -> int | None:
  1803	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1804	
  1805	    只两种情形给值:
  1806	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1807	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1808	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1809	    """
  1810	    if not token:
  1811	        return None
  1812	    if token.isascii() and token.isdigit():
  1813	        return int(token)
  1814	    return _cjk_single_to_int(token)
