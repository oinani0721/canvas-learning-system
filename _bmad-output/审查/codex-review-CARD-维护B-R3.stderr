  4767	def test_domain_r21_seed_node_identity_same_space():
  4768	    """R3 round-23（冻结审查 v4）：种子行的**节点身份**必须在同一文本空间比较。
  4769	
  4770	    ⛔ 这是我 round-22 修复时**自己引入**的语义范围泄漏（审查方在我请它专门
  4771	    留意"范围超出意图的改动"后抓到）：把整个小节交给 `_visible_block` 之后，
  4772	    行里取到的节点名已是**归一后**的，却仍拿去对 **raw** `node_id` ——
  4773	    而 `_visible_text` 无条件删 `_` / `*`，节点名规则并不禁它们。
  4774	
  4775	    实测 `Seed_A` 归一成 `SeedA`，两个后果，**第二个更坏**：
  4776	      ① 合法报告被误拒（报「节点不在 ledger 里」）；
  4777	      ② **值绑定被整条跳过** —— 写错的批注数反而不再报数字错。
  4778	
  4779	    **它证明什么**：先精确匹配 raw id，不中再退到归一空间；归一后**撞车**
  4780	    （两个不同 raw id 归一成同一个）时 fail-closed 不猜；诊断报 **raw** 名。
  4781	    **它不证明什么**：不证明 `_visible_text` 的归一集合与节点名字符规则不再有
  4782	    任何交集 —— 那是两张表的关系，本门只锁"身份比较必须同空间"。
  4783	    """
  4784	    rs = _load_recap_scan()
  4785	
  4786	    def run(node_id: str, line_node: str, tips_count: int, n_in_line: int):
  4787	        text = f"## 台账\n\n### 种子\n\n- {line_node} — 批注 {n_in_line} 条\n\n## 下一段\n"
  4788	        scan = {"ledger": {"seeds": [{"node_id": node_id, "tips_count": tips_count}]}}
  4789	        problems: list[str] = []
  4790	        rs._verify_seed_ledger_counts(text, scan, problems)
  4791	        return problems
  4792	
  4793	    # 前提：归一确实会吃掉下划线（否则本门测的是空气）
  4794	    assert rs._visible_text("Seed_A") == "SeedA", "前提不成立：_visible_text 不再删下划线"
  4795	
  4796	    for nid, n_line, why in (
  4797	        ("SeedA", 2, "对照：普通名 + 数字一致"),
  4798	        ("Seed_A", 2, "下划线名 + 数字一致 —— 不得误拒"),
  4799	    ):
  4800	        assert run(nid, nid, 2, n_line) == [], f"{why}：合法报告被拒"
  4801	
  4802	    for nid, why in (("SeedA", "对照：普通名"), ("Seed_A", "下划线名")):
  4803	        ps = run(nid, nid, 2, 999)
  4804	        assert ps, f"{why}：数字写错却没报"
  4805	        joined = " ".join(ps)
  4806	        assert "不在 scan JSON" not in joined, f"{why}：报成了「不在 ledger」而不是数字不符"
  4807	        assert "999" in joined and nid in joined, f"{why}：诊断必须报**raw** 节点名与写错的数：{ps!r}"
  4808	
  4809	    # 归一撞车 ⇒ fail-closed，不猜
  4810	    text = "## 台账\n\n### 种子\n\n- SeedA — 批注 999 条\n\n## 下一段\n"
  4811	    scan = {
  4812	        "ledger": {
  4813	            "seeds": [
  4814	                {"node_id": "Seed_A", "tips_count": 2},
  4815	                {"node_id": "Se_edA", "tips_count": 7},
  4816	            ]
  4817	        }
  4818	    }
  4819	    problems: list[str] = []
  4820	    rs._verify_seed_ledger_counts(text, scan, problems)
  4821	    assert any("无法确定" in p for p in problems), (
  4822	        f"两个 raw id 归一撞车时必须 fail-closed，不得随便绑一个：{problems!r}"
  4823	    )

