  1546	def _blank_inline_code(mm: "re.Match[str]") -> str:
  1547	    """字段值 span 整段挖空; 可见计数 span **只挖掉反引号**, 内容留给数值门。
  1548	
  1549	    ⚠️ 只挖反引号（而不是原样保留）: 反引号**在**连接字符集 `_D2_NOISE_ONE` 里,
  1550	    所以量词锚本身不会因它失效 —— 原注释称"反引号不在连接集"是**事实错误**
  1551	    (round-20 冻结审查 v2 指出)。保留这个做法的真实理由是**语义**: 判定为可见
  1552	    计数的 span, 其反引号只是排版, 读者看到的就是里面的数; 挖掉它让后续所有
  1553	    判据面对的文本与读者一致, 不必依赖"反引号恰好也算连接字符"这个巧合。
  1554	    等长替换, 行内偏移不变。
  1555	    """
  1556	    span = mm.group(0)
  1557	    if _codespan_is_visible_count(span[1:-1]):
  1558	        return " " + span[1:-1] + " "
