  3316	def test_domain_r5_noise_split_number_run_cli(tmp_path):
  3317	    """R3 round-2 行为门：排版噪声/不可见字符**不得**成为数串的断点。
  3318	
  3319	    `- 本板共有九十八万**五**个子节点。【实测】` 在 Obsidian 里渲染成
  3320	    「本板共有九十八万五个子节点」（粗体的五），而验证器原先只抓到尾片 `五`，
  3321	    `_cjk_single_to_int('五')==5` 且 5 在池内 ⇒ 纯虚构的 980005 **exit 0 放行**。
  3322	    ASCII 侧同形：`980 005个`（空格千分位）只查到 `005`。
  3323	
  3324	    **它证明什么**：数串跨连接字符（排版标记 / `&nbsp;` / 空白 / 短 HTML 标签与
  3325	    注释 / 零宽与双向控制）整体抓取并剥噪声后再判 —— D2 侧覆盖 CJK 与 ASCII，
  3326	    fallback 侧本门只覆盖 CJK；合法的单字/池内数值不受影响。
  3327	    ⚠️ 措辞收窄（Codex round-2 属实指出）：本门原写「CJK 与 ASCII × D2 与
  3328	    fallback 全覆盖」，但矩阵里 fallback 只喂了 CJK——而当时 fallback 的 ASCII
  3329	    侧**确实还是** ``re.findall(r"\\d+")`` 的碎片取数。该缺口由
  3330	    `test_domain_r6_cross_class_and_offtable_numeral_cli` 闭合并配门。
  3331	    **它不证明什么**：连接集是**封闭表**（与量词表同口径）。表外字符仍能切断数串
  3332	    （`九十八万x五个` / `九十八万、五个` / `[[x|]]` 的残留 `|]]`）——那些断点
  3333	    **渲染后可见**，读者不会读成一个连续的数；表外的**不可见**载体（如超长 HTML
  3334	    注释）是真残余，登记在验收单 §五之三，本门不宣称覆盖。
  3335	    """
  3336	    vault = standard_vault(tmp_path)
  3337	    scan = collect_json(vault)
  3338	    pool = _load_recap_scan()._derived_number_pool(scan)
  3339	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3340	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3341	    report = write_report(vault, scan)
  3342	    base_text = report.read_text(encoding="utf-8")
