  1447	def _join_free(s: str) -> str:
  1448	    """剥掉数串内部的排版噪声/不可见字符, 还原成**不被排版切断**的数串。
  1449	
  1450	    ⚠️ 措辞收窄 (Codex round-2 属实指出): 原写"还原读者**看到**的那个数"过宽 ——
  1451	    连接集里未配对的 `*`/`_`/`~`、`<br>` 这类短标签、修饰字 `[多余来几约近超]`
  1452	    渲染后是**可见**的, 拼起来并不等于读者看到的数 (`1*0个` 会被当成 10)。
  1453	    ⛔⛔ **这里曾写「那是安全向的过度拼接: 查到的值 ⊇ 读者看到的数」—— 已被
  1454	    Codex round-7 证伪, 车道实测确认**: `本板共有1\\*5个子节点` 渲染出来是可见的
  1455	    `1*5个`, 而实现先删 `*`、再把反斜线当连接字符剥掉, 最终把 **15** 送进池;
  1456	    15 恰好在池内 ⇒ **放行**。池含 15 并不能证明读者看到的 `1*5` 或其中任何一个
  1457	    数有出处。同理 `5多个` 是近似计数, 却按**精确 5** 入池。
  1458	    ⇒ 过度拼接**不是保值关系**, 它是一个**已知的 fail-open 面**, 不是安全边界。
  1459	    本卡未改变该行为(改成 fail-closed 会波及大量当前合法形态, 需单独裁决),
  1460	    **但不再声称它安全** —— 如实登记在验收单 §五之三。
  1461	    """
  1462	    return _D2_JOIN_RE.sub("", s)
