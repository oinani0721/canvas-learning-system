   988	def _indent_after_quotes(line: str) -> int:
   989	    """引用系前缀之后的剩余缩进 (与 _quote_width 相加 = 内容的绝对列)。"""
   990	    w = _quote_width(line)
   991	    rest = line[w:]
   992	    return len(rest) - len(rest.lstrip(" \t"))
