  2372	def _wrap_signals_in_fence(text: str, prefix: str) -> str:
  2373	    """把四条信号行整体包进 `<prefix>``` … <prefix>``` `，信号行同层前缀。"""
  2374	    lines = text.splitlines()
  2375	    idx = [i for i, ln in enumerate(lines) if any(lb in ln for lb in SIGNAL_LABELS)]
  2376	    start, end = idx[0], idx[-1]
  2377	    body = [prefix + re.sub(r"^[>\s]*", "", lines[i]) for i in range(start, end + 1)]
  2378	    out = lines[:start] + [prefix + "```"] + body + [prefix + "```"] + lines[end + 1 :]
  2379	    return "\n".join(out)
  2380	
