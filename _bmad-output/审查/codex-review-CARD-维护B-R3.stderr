   275	def vault_snapshot(vault: Path) -> dict[str, tuple[str, int]]:
   276	    out: dict[str, tuple[str, int]] = {}
   277	    for p in sorted(vault.rglob("*")):
   278	        if p.is_file():
   279	            st = p.stat()
   280	            out[str(p.relative_to(vault))] = (
   281	                hashlib.sha256(p.read_bytes()).hexdigest(),
   282	                st.st_mtime_ns,
   283	            )
   284	    return out
