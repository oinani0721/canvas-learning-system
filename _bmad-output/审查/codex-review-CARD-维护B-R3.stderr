  1632	def _derived_number_pool(scan: dict) -> set[int]:
  1633	    """scan 数值池 (排除 scale_gate 常量, 含一阶和差) — D2 与 fallback
  1634	    允许式数字绑定 (round-3 HIGH-6) 共用的「有出处」判据。
  1635	
  1636	    ⛔ 池必须排除**与板内容无关的源码常量** (scale_gate 的 30/100/10) 与
  1637	    字符串污染; 「有出处」≠「字面出现」: 池含一阶和与差 (合法算术, 如
  1638	    「7 个派生点中仅 2 个带 derived_at……其余 5 个无据」的 5=7−2)。
  1639	    代价如实记: 池变大 ⇒ 对小数值拦截力下降 (罕见大数仍拦得住)。
  1640	    """
  1641	    scan_for_pool = {k: v for k, v in scan.items() if k != "scale_gate"}
  1642	    base: set[int] = set()
  1643	    _scan_number_pool(scan_for_pool, base)
  1644	    pool = set(base)
  1645	    ordered = sorted(base)
  1646	    for i, a in enumerate(ordered):
  1647	        for b in ordered[i:]:
  1648	            pool.add(a + b)
  1649	            pool.add(abs(a - b))
  1650	    return pool
