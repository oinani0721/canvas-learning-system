  4441	def test_domain_r16_clause7_n_binding_is_visible_text_cli(tmp_path):
  4442	    """R3 round-19（冻结审查 §一.3）：⑦『派生角色成员』前置 N 的绑定口径分叉。
  4443	
  4444	    实测反例（修前 exit 0，三条）：措辞白名单（`_FALLBACK_DERIVE_ALLOW`，:2437）
  4445	    早已改在 `_visible_text` 上判，而同一条叙述的 **N 绑定** 仍在 **raw** 行上
  4446	    `m7.match(ln)` ⇒ 出现「白名单放行、N 绑定跳过」的夹缝：
  4447	
  4448	      · `999 个派**生**角色成员缺来源锚点。`
  4449	      · `999 个派<b>生</b>角色成员缺来源锚点。`
  4450	      · `999<b></b> 个派生角色成员缺来源锚点。`
  4451	
  4452	    渲染后都是明确的 `999 个…`，而 `signals.unsourced_conclusions.value == 0`。
  4453	
  4454	    **它证明什么**：同一条叙述的**白名单**与**值绑定**必须同口径（都在渲染后
  4455	    文本上）——口径分叉本身就是漏洞，不需要任何一侧写错。
  4456	    **它不证明什么**：`_visible_text` 仍不是完整 renderer；台账种子行仍是 raw
  4457	    绑定（实测其形状偏离会撞模板白名单，四条攻击均 fail-closed，故本轮不改）。
  4458	    """
  4459	    vault = standard_vault(tmp_path)
  4460	    scan = collect_json(vault)
  4461	    assert scan.get("data_mode") == "fallback_local", "前提：本门测 fallback 路径"
  4462	    sig = (scan.get("signals") or {}).get("unsourced_conclusions") or {}
  4463	    assert sig.get("value") == 0, f"前提：value 必须是 0，否则 999 的对照没有意义: {sig}"
  4464	
  4465	    report = write_report(vault, scan)
  4466	    base = report.read_text(encoding="utf-8")
  4467	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4468	    anchor = "方向叙述："
  4469	    assert anchor in base, "前提：模板必须含方向叙述锚点"
  4470	
  4471	    def inject(line: str):
  4472	        text = base.replace(anchor, f"\n{line}\n\n{anchor}", 1)
  4473	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4474	        report.write_text(text, encoding="utf-8")
  4475	        return run_verify(report)
  4476	
  4477	    for line, why in (
  4478	        ("999 个派生角色成员缺来源锚点。", "对照：裸前置 N"),
  4479	        ("999 个派**生**角色成员缺来源锚点。", "谓语被强调标记切开"),
  4480	        ("999 个派<b>生</b>角色成员缺来源锚点。", "谓语被 HTML 标签切开"),
  4481	        ("999<b></b> 个派生角色成员缺来源锚点。", "N 与量词之间插空标签"),
  4482	    ):
  4483	        assert inject(line).returncode != 0, f"{why}：前置 N 未被绑定 —— {line!r}"
  4484	
  4485	    # ⚠️ round-21 更正：下面注入的锚点 `方向叙述：` **仍在③段内**，所以这两条
  4486	    #    测的是「③段内的伪信号行」，**不是**真正的段外路径（冻结审查 v3 指出
  4487	    #    原措辞过宽）。段外路径由 `_verify_signals_if_present` 的 rest 判定负责，
  4488	    #    本门不覆盖 —— 如实登记。
  4489	    for line, why in (
  4490	        ("> - 无来源结论：99/2 派生角色成员缺来源锚点【推定】", "③段内裸伪信号行"),
  4491	        ("> - 无**来源**结论：99/2 派生角色成员缺来源锚点【推定】", "③段内伪信号行被切开"),
  4492	    ):
  4493	        assert inject(line).returncode != 0, f"{why}：伪信号行被放行 —— {line!r}"
