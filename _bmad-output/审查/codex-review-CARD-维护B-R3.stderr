  2048	def _verify_seed_ledger_counts(text: str, scan: dict, problems: list[str]) -> None:
  2049	    """台账『种子』行的批注数必须绑到 scan JSON 里**该节点的** tips_count。
  2050	
  2051	    ⛔ 维护卡 B · H-2 后半 (round-6 实证): 原实现只有整行**形状**白名单
  2052	    (``- <节点> — 批注 N 条``), 不绑值 —— 把真实的「批注 2 条」改成
  2053	    「批注 999 条」形状照样合法, 实测 exit 0。白名单管住了句式, 没管住数字的出处。
  2054	
  2055	    scan JSON 的 ``ledger`` 是**按角色分组的 dict** (seeds/derived/unknown) 而非扁平
  2056	    列表 —— 我第一版直接迭代它, 拿到的是键字符串, verifier 当场抛 NameError/AttributeError,
  2057	    stdout 全空 exit 1, 症状伪装成"报告不合规"。这里显式摊平并容两种形态。
  2058	    """
  2059	    # ⛔ R3 round-22（冻结审查 v3）：段抓取与行匹配原先都在 **raw** 文本上做 ——
  2060	    #    留一条正确的种子行、再加一条**渲染等价但源码不命中**的冲突行
  2061	    #    （`- SeedA — 批**注** 999 条` / `批<b>注</b>`），后者匹配不上就静默
  2062	    #    continue，绑定被跳过。**fallback 模式**下有形状门兜底（这正是我上一轮
  2063	    #    『未复现』的原因），但 **manifest 模式没有那层门** —— 两条实测 exit 0。
  2064	    #    与③段信号行、五元组的双行逃逸完全同型，第三次。
  2065	    text = _visible_block(text)
  2066	    mseed = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", text, re.M | re.S)
  2067	    if not mseed:
  2068	        return
  2069	    groups = scan.get("ledger")
  2070	    rows: list[dict] = []
  2071	    if isinstance(groups, dict):
  2072	        for grp in groups.values():
  2073	            if isinstance(grp, list):
  2074	                rows.extend(x for x in grp if isinstance(x, dict))
  2075	    elif isinstance(groups, list):
  2076	        rows = [x for x in groups if isinstance(x, dict)]
  2077	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  2078	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  2079	        return
  2080	    tips_by_node = {str(r.get("node_id")): r.get("tips_count") for r in rows}
  2081	    for ln in mseed.group(1).splitlines():
  2082	        if not ln.strip():
  2083	            continue
  2084	        ms = _SEED_LEDGER_LINE_RE.match(ln)
  2085	        if not ms:
  2086	            continue  # 形状问题由 _verify_report 的模板白名单报, 此处不重复
  2087	        node = ms.group("node").strip()
  2088	        if node not in tips_by_node:
  2089	            problems.append(
  2090	                f"数字终核: 台账『种子』行的节点 {node!r} 不在 scan JSON 的 ledger 里 "
  2091	                "(台账不得列出未扫描到的节点)"
  2092	            )
  2093	            continue
  2094	        want = tips_by_node[node]
  2095	        got = 0 if ms.group("none") else int(ms.group("n"))
  2096	        if got != want:
  2097	            problems.append(
  2098	                f"数字终核: 台账『种子』行 {node} 报批注 {got} 条, "
  2099	                f"scan JSON 的 tips_count 是 {want} (形状对不等于数字有据)"
  2100	            )
