  1534	    if isinstance(obj, int):
  1535	        pool.add(obj)
  1536	    elif isinstance(obj, float):
  1537	        if obj.is_integer():
  1538	            pool.add(int(obj))
  1539	    elif isinstance(obj, dict):
  1540	        for v in obj.values():
  1541	            _scan_number_pool(v, pool)
  1542	    elif isinstance(obj, list):
