  1516	def _scan_number_pool(obj, pool: set[int]) -> None:
  1517	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1518	
  1519	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1520	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1521	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1522	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1523	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1524	    """
  1525	    if isinstance(obj, bool):
  1526	        return
  1527	    if isinstance(obj, int):
  1528	        pool.add(obj)
  1529	    elif isinstance(obj, float):
  1530	        if obj.is_integer():
  1531	            pool.add(int(obj))
  1532	    elif isinstance(obj, dict):
  1533	        for v in obj.values():
  1534	            _scan_number_pool(v, pool)
  1535	    elif isinstance(obj, list):
  1536	        for v in obj:
  1537	            _scan_number_pool(v, pool)
  1538	
