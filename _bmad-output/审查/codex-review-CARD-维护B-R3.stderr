   144	
   145	def write_node(
   146	    vault: Path,
   147	    name: str,
   148	    *,
   149	    source_note: str | None = None,
   150	    derived_from: str | None = None,
   151	    tips: list[dict] | None = None,
   152	    stub: bool = False,
   153	) -> None:
   154	    fm = ["---", "type: concept", f'source_board: "[[原白板/{BOARD}]]"']
   155	    if source_note:
   156	        fm.append(f'source_note: "{source_note}"')
   157	    if derived_from:
   158	        fm.append(f'derived-from: "{derived_from}"')
   159	    if tips:
   160	        fm.append("tips:")
   161	        for t in tips:
   162	            fm.append(f"  - text: {t['text']}")
   163	            if t.get("added_at"):
   164	                fm.append(f"    added_at: {t['added_at']}")
   165	            if t.get("understanding"):
   166	                fm.append(f"    understanding: {t['understanding']}")
   167	    fm.append("---")
   168	    body = f"# {name}\n\n## 核心概念\n\n"
   169	    body += "（你的 1-2 句精准定义。）\n" if stub else "已有正文。\n"
   170	    (vault / "节点" / f"{name}.md").write_text("\n".join(fm) + "\n" + body, encoding="utf-8")
   171	
   172	
   173	def build_vault(tmp_path: Path, members: list[str]) -> Path:
   174	    vault = tmp_path / "vault"
   175	    for sub in ("原白板", "节点", "outputs"):

