  4211	    pats = [p for p, _ in rs._FALLBACK_DERIVE_ALLOW if "缺来源锚点" in p.pattern or "集中在" in p.pattern]
  4212	    assert len(pats) == 2, f"⑦⑧允许式应恰有两条: {len(pats)}"
  4213	    p7, p8 = pats
  4214	    missing = set()
  4215	    for ch in rs._NUMERAL_LIKE_CHARS:
  4216	        if p7.match(f"2 个派生角色成员缺来源锚点{ch}。"):
  4217	            missing.add(ch)
  4218	        if p8.match(f"集中在派生角色成员{ch}。"):
  4219	            missing.add(ch)
  4220	    assert not missing, (
  4221	        f"⑦⑧的手抄数词禁集与定界集已分叉，未禁: {''.join(sorted(missing))}\n"
  4222	        "⇒ 这些字符写进③段固定句式的尾段可绕过数字禁令"
  4223	    )
