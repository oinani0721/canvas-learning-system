  2512	def _verify_report(path: str) -> int:
  2513	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2514	
  2515	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2516	    """
  2517	    try:
  2518	        text_raw = Path(path).read_text(encoding="utf-8")
  2519	    except (OSError, UnicodeDecodeError) as e:
  2520	        print(f"✗ 报告不可读: {type(e).__name__}")
  2521	        return 1
  2522	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2523	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2524	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2525	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2526	    if not fm_m:
  2527	        print("✗ 报告缺 frontmatter 块")
  2528	        return 1
  2529	    fm = fm_m.group(1)
  2530	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2531	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2532	    if "<!--" in fm or "-->" in fm:
  2533	        print("✗ frontmatter 块内含 HTML 注释标记")
  2534	        return 1
  2535	    problems: list[str] = []
  2536	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2537	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  2538	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  2539	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  2540	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  2541	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  2542	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  2543	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  2544	    if "<!--" in text_raw or "-->" in text_raw:
  2545	        problems.append(
  2546	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2547	        )
  2548	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  2549	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  2550	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
  2551	    # round-4: 零宽/双向控制字符 — 渲染不可见但能改变正则匹配与阅读顺序,
  2552	    # 是"看起来合规、实际另一回事"的通用载体。合法报告没有理由出现它们。
  2553	    # ⛔ R3 round-15 (冻结审查): 这里原先**手抄**了一份不可见字符集, 只到 U+2064,
  2554	    #    而 _INVISIBLE_ONE 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  2555	    #    又一处「同一原则两处定义」。改为共用 _INVISIBLE_ONE。
  2556	    if re.search(_INVISIBLE_ONE, text):
