  3315	def test_domain_r5_noise_split_number_run_cli(tmp_path):
  3316	    """R3 round-2 行为门：排版噪声/不可见字符**不得**成为数串的断点。
  3317	
  3318	    `- 本板共有九十八万**五**个子节点。【实测】` 在 Obsidian 里渲染成
  3319	    「本板共有九十八万五个子节点」（粗体的五），而验证器原先只抓到尾片 `五`，
  3320	    `_cjk_single_to_int('五')==5` 且 5 在池内 ⇒ 纯虚构的 980005 **exit 0 放行**。
  3321	    ASCII 侧同形：`980 005个`（空格千分位）只查到 `005`。
  3322	
  3323	    **它证明什么**：数串跨连接字符（排版标记 / `&nbsp;` / 空白 / 短 HTML 标签与
  3324	    注释 / 零宽与双向控制）整体抓取并剥噪声后再判 —— D2 侧覆盖 CJK 与 ASCII，
  3325	    fallback 侧本门只覆盖 CJK；合法的单字/池内数值不受影响。
  3326	    ⚠️ 措辞收窄（Codex round-2 属实指出）：本门原写「CJK 与 ASCII × D2 与
  3327	    fallback 全覆盖」，但矩阵里 fallback 只喂了 CJK——而当时 fallback 的 ASCII
  3328	    侧**确实还是** ``re.findall(r"\\d+")`` 的碎片取数。该缺口由
  3329	    `test_domain_r6_cross_class_and_offtable_numeral_cli` 闭合并配门。
  3330	    **它不证明什么**：连接集是**封闭表**（与量词表同口径）。表外字符仍能切断数串
  3331	    （`九十八万x五个` / `九十八万、五个` / `[[x|]]` 的残留 `|]]`）——那些断点
  3332	    **渲染后可见**，读者不会读成一个连续的数；表外的**不可见**载体（如超长 HTML
  3333	    注释）是真残余，登记在验收单 §五之三，本门不宣称覆盖。
  3334	    """
  3335	    vault = standard_vault(tmp_path)
  3336	    scan = collect_json(vault)
  3337	    pool = _load_recap_scan()._derived_number_pool(scan)
  3338	    # 前提实测：尾片值必须真的在池里，这条门才是在测「按尾片查池会放行」。
  3339	    assert {0, 4, 5} <= pool, f"前提失效（尾片值不在池）: {sorted(pool)}"
  3340	    report = write_report(vault, scan)
  3341	    base_text = report.read_text(encoding="utf-8")
  3342	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3343	
  3344	    def verify(anchor: str, injected: str):
  3345	        text = base_text.replace(anchor, injected, 1)
  3346	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3347	        report.write_text(text, encoding="utf-8")
  3348	        return run_verify(report)
  3349	
  3350	    def d2(line: str):
  3351	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3352	
  3353	    # ── 拦截面：渲染后连续、源码被切断 ──
  3354	    for name, line in (
  3355	        ("粗体", "- 本板共有九十八万**五**个子节点。【实测】"),
  3356	        ("空白", "- 本板共有九十八万 五个子节点。【实测】"),
  3357	        ("nbsp", "- 本板共有九十八万&nbsp;五个子节点。【实测】"),
  3358	        ("空标签", "- 本板共有九十八万<span></span>五个子节点。【实测】"),
  3359	        ("修饰字余", "- 本板共有九十八万余五个子节点。【实测】"),
  3360	        ("行内代码", "- 本板共有九十八万`x`五个子节点。【实测】"),
  3361	    ):
  3362	        r = d2(name and line)
  3363	        assert r.returncode != 0, f"CJK {name}切断被放行:\n{r.stdout}"
  3364	        assert _one_problem_has(r.stdout, "无法解析", "九十八万五"), (
  3365	            f"CJK {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3366	        )
  3367	    for name, line, whole in (
  3368	        ("空格千分位", "- 本板共有980 005个子节点。【实测】", "980005"),
  3369	        ("粗体", "- 本板共有98765**4**个子节点。【实测】", "987654"),
  3370	        # ⛔ 与「前导零归一化」的交互：行级剥零会把 `1 000`(渲染=1000, SI 千分位)
  3371	        # 先剥成 `1 0` 再拼成 `10` 落进池内 ⇒ 放行。归一化必须作用在拼接后的
  3372	        # token 上（车道实测，本卡修复时自己踩出来的洞）。
  3373	        ("SI千分位+前导零", "- 本板共有1 000个子节点。【实测】", "1000"),
  3374	    ):
  3375	        r = d2(line)
  3376	        assert r.returncode != 0, f"ASCII {name}切断被放行:\n{r.stdout}"
  3377	        assert _one_problem_has(r.stdout, "找不到同值来源", whole), (
  3378	            f"ASCII {name}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3379	        )
  3380	    # fallback 允许式侧同根（碎片逐片查池全部命中 ⇒ 整体虚构值放行）
  3381	    for tok, joined in (("九**五**", "九五"), ("九十八万**五**", "九十八万五")):
  3382	        r = verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3383	        assert r.returncode != 0, f"fallback {tok} 碎片被放行:\n{r.stdout}"
  3384	        assert _one_problem_has(r.stdout, "无法验证", joined), (
  3385	            f"fallback {tok}: 诊断类别与完整数串未绑在同一条 problem:\n{r.stdout}"
  3386	        )
  3387	
  3388	    # ── 放行面（同权重）：合法形态不得被这道收紧反噬 ──
  3389	    for name, line in (
  3390	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3391	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
  3392	        ("ASCII 在池 22", "- 本板共有22个子节点。【实测】"),
  3393	        ("前导零 016=16 在池", "- 本板共有016个子节点。【实测】"),
  3394	        ("round-5 原始误伤 十分", "- 说明十分清楚。【实测】"),
  3395	        ("round-5 原始误伤 一致", "- 统计口径尚未一致。【实测】"),
  3396	    ):
  3397	        r = d2(line)
  3398	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
