  2360	def _verify_report(path: str) -> int:
  2361	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2362	
  2363	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2364	    """
  2365	    try:
  2366	        text_raw = Path(path).read_text(encoding="utf-8")
  2367	    except (OSError, UnicodeDecodeError) as e:
  2368	        print(f"✗ 报告不可读: {type(e).__name__}")
  2369	        return 1
  2370	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2506	    elif not re.search(r"^data_mode:\s*manifest", fm, re.M):
  2507	        problems.append("frontmatter 缺 data_mode: manifest|fallback_local")
  2508	    # round-6: 与存在性检查共用 _SECTION_RE 口径 — 原整行正则让
  2509	    # `## 你现在可以做的（本轮）` 定位失败, 动作段白名单被整块跳过
  2510	    acts = re.search(
  2511	        _SECTION_RE("## 你现在可以做的") + r"(.*?)(?=^#{2}(?:[^\S\n]|$)|\Z)",
  2512	        text,
  2513	        re.M | re.S,
  2514	    )
  2515	    if acts:
  2516	        # 续行止于空行 (五轮 M7 逃逸: 贪婪续行会把空行后的散文吸进编号项,
  2517	        # 让越界正文搭编号项的白名单便车)
  2518	        items = re.findall(
  2519	            r"^\d+\.\s.*(?:\n(?!\d+\.\s|##|\s*$).*)*", acts.group(1), re.M
  2520	        )
  2521	        if not items:
  2522	            problems.append("「你现在可以做的」没有编号动作项")
  2523	        for it in items:
  2524	            if not any(v in it for v in _VERIFY_ACTION_VERBS):
  2525	                problems.append(
  2526	                    f"动作项缺白名单动词(无动作的信号移去 AI 侧对账): {it.strip()[:40]}"
  2527	                )
  2528	        # M7 五轮: 结构性拦截 — 动作段只许编号项, 任何编号项之外的正文行
  2529	        # (无论措辞, 同义改写也一样) 都是越界内容, 词表补丁竞赛到此为止。
  2530	        leftover = acts.group(1)
  2531	        for it in items:
  2532	            leftover = leftover.replace(it, "")
  2533	        stray = [ln.strip() for ln in leftover.splitlines() if ln.strip()]
  2534	        if stray:
  2535	            problems.append(
  2536	                f"动作段含编号项之外的正文行(移去对应段落): {stray[0][:40]}"
  2537	            )
  2538	    for p in problems:
  2539	        print(f"✗ {p}")
  2540	    if problems:
  2541	        print(f"VERIFY FAIL ({len(problems)} 项) — 改写报告后重跑本命令")
  2542	        return 1
  2543	    print("VERIFY PASS — 可以发回执")
  2544	    return 0
