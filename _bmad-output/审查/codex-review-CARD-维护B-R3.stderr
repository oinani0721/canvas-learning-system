  2128	            ms = _SEED_LEDGER_LINE_RE.match(ln)
  2129	            if not ms and not raw_ms:
  2130	                # ⛔ R3 round-25（冻结审查 v6）：原先静默 `continue`，理由是"形状问题
  2131	                #    由 _verify_report 的模板白名单报" —— 但那道白名单**只在 fallback
  2132	                #    路径**上跑，**manifest 模式没有兜底**，于是种子小节里任何不匹配
  2133	                #    模板的行（含 `批注 999 条&#10;x` 这种尾巴）整条免检。
  2134	                #    ⇒ 本函数自己 fail-closed：小节内的非空行必须是标准模板行。
  2135	                problems.append(
  2136	                    f"数字终核: 台账『种子』小节出现非模板行 (每行须为 "
  2137	                    f"`- <节点> — 批注 N 条` 或 `- <节点> — 无批注`): {ln.strip()[:60]}"
  2138	                )
  2139	                continue
  2140	            if not ms:
  2141	                ms = raw_ms
  2142	            if raw_ms:
  2143	                node = raw_ms.group("node").strip()
  2144	                if node in tips_by_node:
  2145	                    key = node
  2146	                    got = 0 if raw_ms.group("none") else int(raw_ms.group("n"))
  2147	                    want = tips_by_node[key]
  2148	                    if got != want:
  2149	                        problems.append(
  2150	                            f"数字终核: 台账『种子』行 {key} 报批注 {got} 条, "
  2151	                            f"scan JSON 的 tips_count 是 {want} (形状对不等于数字有据)"
  2152	                        )
  2153	                    continue
  2154	                # ⛔ round-25: raw 精确未命中**不等于**身份非法 —— ledger id 为 `A&B`
  2155	                #    而报告合法写成 `A&amp;B` 时，读者看到的是同一个名字。原实现
  2156	                #    在这里直接报错，不再尝试唯一的归一候选 ⇒ 合法用法误伤。
  2157	                #    改为**继续往下**走归一候选（唯一才绑，撞车仍 fail-closed）。
  2158	            node = ms.group("node").strip()
  2159	            cands = vis_index.get(node) or []
  2160	            if len(cands) > 1:
  2161	                problems.append(
  2162	                    f"数字终核: 台账『种子』行的节点 {node!r} 归一后同时对应 "
  2163	                    f"{sorted(cands)!r} —— 无法确定是哪一个, 不猜 (fail-closed)"
  2164	                )
  2165	                continue
  2166	            if not cands:
