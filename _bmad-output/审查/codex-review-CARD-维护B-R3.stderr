  4782	def test_domain_r21_seed_node_identity_same_space():
  4783	    """R3 round-24（冻结审查 v5）：种子行身份取自**还能解析的最原始形态**。
  4784	
  4785	    ⛔ 三轮演化，两次都是我错、审查方对：
  4786	      · round-22：把整个小节交给 `_visible_block` ⇒ 节点名归一成 `SeedA`，
  4787	        却仍去对 raw `node_id` `Seed_A` ⇒ 误拒 + **值绑定被整条跳过**；
  4788	      · round-23：我加了「先精确匹配 raw id」—— 但 `node` 本身**已经是归一后的**，
  4789	        这一段对含 `_` 的名字**永远不可能命中**，是个自相矛盾的前提。后果一漏一伤：
  4790	          - ledger 同时有 `SeedA` 与 `Seed_A` 时，报告里的 raw `Seed_A` 归一成
  4791	            `SeedA` ⇒ **错绑到另一个节点**，撞车检查被跳过，错的数放行；
  4792	          - ledger 有 `Seed_A` 与 `Se_edA` 时，报告里**精确正确**的 `Seed_A`
  4793	            归一后撞车 ⇒ 合法身份被拒。
  4794	      · round-24（本轮）：raw 与 visible **逐行并列**（`_visible_block` 保证行数
  4795	        与顺序不变）。raw 行解析得出 = 身份精确，直接用，不进归一空间；只有 raw
  4796	        行解析不出（被排版切开的冲突行）才退到归一行，那时才谈撞车。
  4797	
  4798	    **它证明什么**：七种形态的行为（见下），含两种碰撞、两种双行逃逸。
  4799	    **它不证明什么**：不证明 `_visible_text` 的归一集合与节点名字符规则无交集；
  4800	    也不覆盖 raw 段与 visible 段行数不齐的极端情形（代码里按下标越界安全退化）。
  4801	    """
  4802	    rs = _load_recap_scan()
  4803	    assert rs._visible_text("Seed_A") == "SeedA", "前提不成立：_visible_text 不再删下划线"
  4804	
  4805	    def run(lines: str, ledger: list[dict]) -> list[str]:
  4806	        text = f"## 台账\n\n### 种子\n\n{lines}\n\n## 下一段\n"
  4807	        problems: list[str] = []
  4808	        rs._verify_seed_ledger_counts(text, {"ledger": {"seeds": ledger}}, problems)
  4809	        return problems
  4810	
  4811	    A_AND_UA = [{"node_id": "SeedA", "tips_count": 9}, {"node_id": "Seed_A", "tips_count": 2}]
  4812	    TWO_UA = [{"node_id": "Seed_A", "tips_count": 2}, {"node_id": "Se_edA", "tips_count": 7}]
  4813	    ONLY_A = [{"node_id": "SeedA", "tips_count": 2}]
  4814	
  4815	    for lines, ledger, want, why in (
  4816	        ("- Seed_A — 批注 2 条", A_AND_UA, None, "遮蔽碰撞：精确身份 + 数字对 ⇒ 放行"),
  4817	        ("- Seed_A — 批注 999 条", A_AND_UA, "999", "遮蔽碰撞：数字错 ⇒ 必须报数字不符，不得错绑到 SeedA"),
  4818	        ("- Seed_A — 批注 2 条", TWO_UA, None, "误伤面：精确身份不得被归一撞车拒掉"),
  4819	        (
  4820	            "- Seed**A** — 批注 999 条",
  4821	            TWO_UA,
  4822	            "无法确定",
  4823	            "节点名被切开：raw 精确未命中后**继续**走归一候选，撞车 ⇒ fail-closed",
  4824	        ),
  4825	        (
  4826	            "- SeedA — 批注 2 条\n- Seed**A** — 批注 999 条",
  4827	            ONLY_A,
  4828	            "999",
  4829	            "双行逃逸（节点名被切开）⇒ 退归一候选后报数字不符",
  4830	        ),
  4831	        ("- SeedA — 批注 2 条\n- SeedA — 批**注** 999 条", ONLY_A, "999", "双行逃逸（谓语被切开 ⇒ 走归一路径）"),
  4832	        ("- SeedA — 批**注** 999 条", TWO_UA, "无法确定", "真归一撞车 ⇒ fail-closed 不猜"),
  4833	    ):
  4834	        ps = run(lines, ledger)
  4835	        if want is None:
  4836	            assert ps == [], f"{why}：合法输入被拒 —— {ps!r}"
  4837	        else:
  4838	            assert ps, f"{why}：应报错却放行了"
  4839	            assert any(want in x for x in ps), f"{why}：诊断未含 {want!r} —— {ps!r}"

