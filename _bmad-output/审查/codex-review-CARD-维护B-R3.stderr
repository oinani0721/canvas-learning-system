   866	MUTANT_COUNT_EXPECTED = 61
   867	"""变体数的**独立**期望值。
   868	
   869	⛔ 冻结审查 v6：脚本原先只在结尾动态打印「共 N 条」—— 误删一个变体仍会成功退出。
   870	期望值必须来自**另一个来源**才能验伪（本卡反复吃过"期望抄自被测物"的亏）。
   871	改这个数 = 明确声明"我知道自己在增删变体"。
   872	"""
   873	
   874	
   875	def preflight() -> list[str]:
   876	    """开跑前的**锚点预检**（秒级）—— 失败即停，不进 40 分钟长流程。
   877	
   878	    ⛔ 「性质一搬家、旧锚点静默失效」在本卡发生了 **6 次**，每次代价固定：
   879	    改实现 → 跑满一轮 → 跑到那一条才报「未命中」→ 重锚 → 再跑一轮。
   880	    **发现成本远高于修复成本，且发现得越晚越贵。**
   881	
   882	    ⚠️ 能力边界（round-25 声明，round-26 按冻结审查 v7 收紧措辞）：
   883	      · 「恰好命中一次」只证明**文本定位唯一**；
   884	      · 「整组替换后源码确实变化」证明**替换非空**（round-26 新增，此前只比
   885	        `old != new`，而成功消息却宣布了"替换非空" —— 措辞比证据宽）；
   886	      · **不**证明该位置**可达**、或确实**禁掉了目标防线**（行为非空）——
   887	        「锚点仍命中但变异已为空」在本卡真实发生过（见 铁律 4 / 铁律 5）。
   888	      · 它是**必要非充分**条件：能挡住**锚点漂移**与**文本级**空变异，
   889	        挡不住**行为级**空变异（改到了活代码，却没禁掉那条防线）。
   890	      ⚠️ 归因edge：`survivor-7` 那次是被 `hits != 1` 抓到的，**不是**被新增的
   891	        「整组替换后源码确实变化」抓到的 —— 我此前把功劳记给了后者，过宽。
   892	    """
   893	    bad: list[str] = []
   894	    if len(MUTANTS) != MUTANT_COUNT_EXPECTED:
   895	        bad.append(f"变体数 {len(MUTANTS)} ≠ 期望 {MUTANT_COUNT_EXPECTED}（增删变体须同步改期望值）")
   896	    ids = [n.split()[0] for n, _s, _k in MUTANTS]
   897	    if len(set(ids)) != len(ids):
   898	        dup = sorted({i for i in ids if ids.count(i) > 1})
   899	        bad.append(f"变体 ID 重复: {dup}")
   900	    src = TARGET.read_text(encoding="utf-8")
   901	    for idx, (name, subs, _kw) in enumerate(MUTANTS):
   902	        sid = ids[idx]
   903	        if not subs:
   904	            bad.append(f"{sid}: subs 为空 = 什么都不改")
   905	            continue
   906	        # ⛔ round-26（冻结审查 v7）：原先逐条只比 `old != new`，成功消息却宣布
   907	        #    「替换非空」—— **措辞比证据宽**。改为**按真实顺序模拟整组替换**，
   908	        #    要求最终源码确实变化：这才配得上那句话。
   909	        mutated = src
   910	        for old, new in subs:
   911	            hits = mutated.count(old)
   912	            if hits != 1:
   913	                bad.append(f"{sid}: 锚点命中 {hits} 次（须恰好 1）")
   914	                mutated = None
   915	                break
   916	            mutated = mutated.replace(old, new, 1)
   917	        if mutated is not None and mutated == src:
   918	            bad.append(f"{sid}: 整组替换后源码与原文逐字节相同 = 空变异")
   919	    return bad
