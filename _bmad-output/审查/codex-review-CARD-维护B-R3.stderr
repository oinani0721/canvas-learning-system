  2146	            continue
  2147	        if not cands:
  2148	            problems.append(
  2149	                f"数字终核: 台账『种子』行的节点 {node!r} 不在 scan JSON 的 ledger 里 "
  2150	                "(台账不得列出未扫描到的节点)"
  2151	            )
  2152	            continue
  2153	        key = cands[0]
  2154	        want = tips_by_node[key]
  2155	        got = 0 if ms.group("none") else int(ms.group("n"))
  2156	        if got != want:
  2157	            problems.append(
  2158	                f"数字终核: 台账『种子』行 {key} 报批注 {got} 条, "
