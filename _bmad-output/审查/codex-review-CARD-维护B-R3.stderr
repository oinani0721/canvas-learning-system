   644	def _crash_text(stdout: str, stderr: str | None) -> str:
   645	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   646	
   647	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   648	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   649	    """
   650	    return stdout + "\n" + (stderr or "")
