  1545	def _codespan_is_visible_count(inner: str) -> bool:
  1546	    """code span 的**渲染后**内容是不是一串可见计数（而非字段值）。
  1547	
  1548	    要求至少含一个数词样字符 —— 否则 `` `-` `` / `` `.` `` 这种纯符号 span
  1549	    会被当成计数, 白白失去 E2 豁免。
  1550	    """
  1551	    norm = _normalize_number_seps(_visible_text(inner)).strip()
  1552	    if not norm:
  1553	        return False
  1554	    if not all(
  1555	        ch in _D2_COUNTISH_CHARS or ch in _D2_COUNTISH_EXTRA or ch.isspace()
  1556	        for ch in norm
  1557	    ):
  1558	        return False
  1559	    # ⚠️ 至少要有一个"数词样字符或量词" —— 纯符号 span（`` `-` `` / `` `.` ``）
  1560	    #    不是计数, 白白失去 E2 豁免。但**纯量词**（`` `个` ``）必须算:
  1561	    #    挖掉单独成 span 的量词会让它前面的数字失锚（round-11 修过的缺陷,
  1562	    #    第一版这里写成"至少一个 _NUMERAL_LIKE_CHARS"当场把它重新引入, 被 r12 门抓住）。
  1563	    return any(ch in _D2_COUNTISH_CHARS for ch in norm)
