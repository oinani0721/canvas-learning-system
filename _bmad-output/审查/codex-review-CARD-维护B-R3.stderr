  1464	# ══════════════════ CARD-M11M7 · M7 板名/节点名字符拒绝集 ══════════════════
  1465	# unsafe_name_chars() 是 _contained_md 的字符判据（一处判定），拒绝集从 C0 扩到
  1466	# DEL + C1 + 行分隔符。⛔ 边界最容易写错（<0x20 / <=0x9F 任一端 off-by-one 都会
  1467	# 让实现悄悄放行或误伤），所以这里逐个边界字符正反双向锁。
  1468	
  1469	
  1470	def _load_recap_scan():
  1471	    """按被测脚本自身的零写侧约定导入它（不落 __pycache__）。"""
  1472	    import importlib.util
  1473	
  1474	    if not SCRIPT.exists():
  1475	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
  1476	    prev = sys.dont_write_bytecode
  1477	    sys.dont_write_bytecode = True
  1478	    try:
  1479	        spec = importlib.util.spec_from_file_location("recap_scan_ut", SCRIPT)
  1480	        mod = importlib.util.module_from_spec(spec)
  1481	        spec.loader.exec_module(mod)
  1482	    finally:
  1483	        sys.dont_write_bytecode = prev
  1484	    return mod
