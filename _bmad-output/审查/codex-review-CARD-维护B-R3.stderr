  4496	def test_domain_r17_freeze_v2_bounded_highs_cli(tmp_path):
  4497	    """R3 round-20（冻结审查 v2 的五组有界 HIGH）：六条实测反例 + 一处被推翻的判断。
  4498	
  4499	    修前实测放行：
  4500	      · 区间首端**无整数部分**的小数 —— `.2~3个` / `．二~三个` / `点二~三个`
  4501	        （守卫原先要求小数点前必须有数词样字符）；
  4502	      · code span 里的**可见区间**与 **NBSP** —— `` `999~999个` `` / `` `999 个` ``
  4503	        （NBSP）：`_D2_COUNTISH_EXTRA` 与区间主表分叉、空白域只列了空格与 tab，
  4504	        于是整段被当字段值挖空，区间门与数字门**都不可达**；
  4505	      · 五元组**双行逃逸** —— 保留一条正确五元组，再加一条渲染等价但源码不命中的
  4506	        冲突行（`999 成**员**（…）` / `999 成<b>员</b>（…）`），后者既不计入
  4507	        「恰好一处」也不被逐条校验。
  4508	
  4509	    ⛔ 最后一条推翻了我上一轮「三处 raw 绑定实测不成立」的判断：我当时只测了
  4510	    「改坏那条唯一正确行」（形状一坏就 fail-closed），**没把「留一条好的 + 加一条
  4511	    冲突的」这个已经在 ③段信号行上验证过的形态迁移过来**。
  4512	
  4513	    **它证明什么**：区间首端守卫覆盖无整数部分的小数；code span 的字符域与区间
  4514	    主表同源、空白按 `str.isspace()` 判；五元组逐行归一后匹配。
  4515	    **它不证明什么**：`_visible_text` 仍不是完整 renderer；台账种子行与 tips
  4516	    的同型双行攻击我**未能复现**（不等于安全，如实登记）。
  4517	    """
  4518	    rs = _load_recap_scan()
  4519	    vault = standard_vault(tmp_path)
  4520	    scan = collect_json(vault)
  4521	    pool = rs._derived_number_pool(scan)
  4522	    assert {2, 3} <= pool and 999 not in pool, f"前提：2/3 在池、999 不在池: {sorted(pool)[:8]}"
  4523	
  4524	    report = write_report(vault, scan)
  4525	    base = report.read_text(encoding="utf-8")
  4526	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4527	
  4528	    def verify(text: str):
  4529	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4530	        report.write_text(text, encoding="utf-8")
  4531	        return run_verify(report)
  4532	
  4533	    def in3(line: str):
  4534	        return verify(base.replace("## 三维审查", f"## 三维审查\n\n{line}", 1))
  4535	
  4536	    # ① 区间首端：无整数部分的小数（三种写法）
  4537	    for line, why in (
  4538	        ("- 本板共有.2~3个子节点。【实测】", "半角小数点开头"),
  4539	        ("- 本板共有．二~三个子节点。【实测】", "全角小数点 + 中文数词"),
  4540	        ("- 本板共有点二~三个子节点。【实测】", "『点』开头"),
  4541	    ):
  4542	        assert in3(line).returncode != 0, f"{why}：区间从小数点后重锚仍被放行 —— {line!r}"
  4543	
  4544	    # ② code span：可见区间与 NBSP 都必须进入受检面
  4545	    assert in3("- 本板共有`999~999个`子节点。【实测】").returncode != 0, "code span 里的池外区间被当字段值整段挖空"
  4546	    assert in3("- 本板共有`999\u00a0个`子节点。【实测】").returncode != 0, (
  4547	        "code span 里的 NBSP 让整段被豁免（主连接集用 \\s，这里原先只列空格与 tab）"
  4548	    )
  4549	    # 反面：池内区间照常放行（受检 ≠ 一律拒）
  4550	    assert in3("- 本板共有`2~3个`子节点。【实测】").returncode == 0, (
  4551	        "池内区间被误伤 —— 目标是让它**进入检查**，不是一律拒"
  4552	    )
  4553	
  4554	    # ③ 五元组双行逃逸
  4555	    scale = next((ln for ln in base.splitlines() if re.search(r"\d+\s*成员（", ln)), None)
  4556	    assert scale, "前提：报告必须含五元组行"
  4557	    for repl, why in (
  4558	        ("999 成**员**", "强调标记切开"),
  4559	        ("999 成<b>员</b>", "HTML 标签切开"),
  4560	    ):
  4561	        conflict = re.sub(r"(\d+)\s*成员", repl, scale, count=1)
  4562	        assert verify(base.replace(scale, scale + "\n" + conflict, 1)).returncode != 0, (
  4563	            f"五元组双行逃逸（{why}）：冲突行既不计数也不校验"
  4564	        )
  4565	
  4566	    # ④ 字符域必须与区间主表同源（漂移即被抓）
  4567	    # ⛔ round-23：此前只枚举 5 个，漏掉六种横线；且区间正则当时**手抄了第二份表**，
  4568	    #    所谓「同源」并不成立。现从 `_D2_RANGE_SEPS` 逐字符双向锁：两个消费面都必须覆盖。
  4569	    assert len(rs._D2_RANGE_SEPS) >= 11, f"分隔表被缩水: {rs._D2_RANGE_SEPS!r}"
  4570	    for ch in rs._D2_RANGE_SEPS:
  4571	        assert rs._codespan_is_visible_count(f"2{ch}3个"), (
  4572	            f"区间分隔符 {ch!r} 不在 code span 字符域里 ⇒ 可见区间被整段豁免"
  4573	        )
  4574	        assert rs._D2_RANGE_RE.search(f"2{ch}3个"), f"区间分隔符 {ch!r} 不被区间正则识别 ⇒ 两侧分隔表已分叉"
  4575	    for ch in ("\u00a0", "\u3000"):
  4576	        assert rs._codespan_is_visible_count(f"999{ch}个"), (
  4577	            f"空白 U+{ord(ch):04X} 不被接受 ⇒ 整段被豁免（主连接集用 \\s）"
  4578	        )
