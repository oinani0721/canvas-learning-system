  4618	def test_domain_r19_child_stderr_transport_is_real(capsys):
  4619	    """R3 round-20：`_surface_child_stderr` 必须**真的**把子进程 stderr 打出来。
  4620	
  4621	    ⛔ 冻结审查 v2 的 ⚠️ 判词：「stderr 行为门只是把合成 traceback 手工传给
  4622	    helper，没有验证真实接线」—— 那条批评成立。这里补上：直接调用接线函数，
  4623	    用 capsys 断言它**确实**写到了测试自己的 stdout（pytest 失败时展示它，
  4624	    外层的崩溃识别才看得见内层 traceback）。
  4625	
  4626	    另有一次**端到端实测**（不放在门里，因为它要临时改生产文件）：给
  4627	    `_visible_text` 注入 `RecursionError` 后跑 r14 门，外层 stdout 里出现了
  4628	    `[child stderr]` 与 `Traceback (most recent call last):`；修复前这两样都不会
  4629	    出现，外层只剩一个 `AssertionError` ⇒ 生产崩溃被当成正常判错变红。
  4630	    证据：`_bmad-output/审查/evidence-maintb-r3/x-crash-transport-measured.txt`。
  4631	
  4632	    **它证明什么**：接线函数本身有效，且只在 stderr 非空时才输出。
  4633	    **它不证明什么**：不证明每一条门都会触发它（那取决于被测 CLI 是否真的崩）。
  4634	    """
  4635	    import subprocess as _sp
  4636	
  4637	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=1, stdout="", stderr=""))
  4638	    assert capsys.readouterr().out == "", "stderr 为空时不得产生噪声"
  4639	
  4640	    _surface_child_stderr(
  4641	        _sp.CompletedProcess(
  4642	            args=["x"],
  4643	            returncode=1,
  4644	            stdout="",
  4645	            stderr="Traceback (most recent call last):\n  RecursionError: x\n",
  4646	        )
  4647	    )
  4648	    out = capsys.readouterr().out
  4649	    assert "[child stderr]" in out, "子进程 stderr 未被抬到测试 stdout"
  4650	    assert "Traceback (most recent call last):" in out, "traceback 内容丢失"

