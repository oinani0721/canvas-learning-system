  4281	        _spec = _ilu.spec_from_file_location(
  4282	            "negverify_ut", pathlib.Path(__file__).with_name("recap_domain_negverify.py")
  4283	        )
  4284	        _nv = _ilu.module_from_spec(_spec)
  4285	        _spec.loader.exec_module(_nv)
  4286	    finally:
  4287	        sys.dont_write_bytecode = _prev
  4288	
  4289	    for out, want, why in (
  4290	        ("E   AssertionError: 期望 FAIL", False, "断言失败=判错，正是我们要的红"),
  4291	        ("E   assert 0 == 1", False, "裸 assert 同上"),
  4292	        ("1 failed, 260 passed", False, "纯失败摘要"),
  4293	        ("E   re.error: invalid group reference", True, "round-10 原案"),
  4294	        ("E   ValueError: too many values", True, "旧版枚举之外 ⇒ 假阴"),
  4295	        ("E   KeyError: 3", True, "旧版枚举之外 ⇒ 假阴"),
  4296	        (
  4297	            "  Traceback (most recent call last):\n    File 'x'",
  4298	            True,
  4299	            "CLI 子进程崩溃，外层无异常名 ⇒ 旧版假阴",
  4300	        ),
  4301	        ("INTERNALERROR> boom", True, "pytest 内部错"),
  4302	        ("1 error, 260 passed", True, "收集期 error"),
  4303	        # ⛔ round-17（冻结审查 §一.4）：上一版号称"从名单改形态"，其实只是把名单
  4304	        # 从**全名**换成了**后缀** `(?:[Ee]rror|Exception)` —— 仍是我手写的闭表。
  4305	        # 下面三个都不以 Error/Exception 结尾，旧判据全部漏掉。
  4306	        ("E   SystemExit: 2", True, "不以 Error/Exception 结尾 ⇒ 旧后缀表假阴"),
  4307	        ("E   subprocess.TimeoutExpired: t", True, "同上，且是点分名"),
  4308	        ("E   RecursionError: deep", True, "枚举五名单之外"),
  4309	        ("E   Failed: 被测脚本不存在", True, "pytest.fail = 夹具坏了，不是判错"),
  4310	        # ⛔ round-20 二修（冻结审查 v2）：**无消息异常**没有冒号 ——
  4311	        # 要求"紧跟冒号"会漏掉整整一类崩溃。承重的条件是**缩进上界**，不是冒号。
  4312	        ("E   RecursionError", True, "无消息异常（无冒号）⇒ 冒号规则会假阴"),
  4313	        ("E   SystemExit", True, "同上"),
  4314	        # ⛔ round-20：下列样例的缩进是**实测**的 —— 让被测 CLI 真的抛
  4315	        # RecursionError 跑一遍，外层 pytest 打出来的顶层行是 `E` + **3 空格**
  4316	        # （续行 4-5 格）。此前这批样例写的是 7 空格，是我**凭想象**编的形状，
  4317	        # round-20 给判据加缩进上界后当场全红 —— 门的 fixture 本身就不真实。
  4318	        # ⛔ round-17 二修（实测 39/44 假阳）：第一版把判据放宽成「行首是个标识符」，
  4319	        # 但 pytest 给失败详情的**每一行**都加 `E ` 前缀 ⇒ 断言消息的**续行**被
  4320	        # 当成异常类型。**修严引入松、修松引入严** —— 两个方向必须同时锁。
  4321	        ("E     VERIFY FAIL (1 项) — 改写报告后重跑本命令", False, "断言消息续行，不是异常"),
  4322	        ("E     VERIFY PASS — 可以发回执", False, "同上"),
  4323	        ("E    +  where 0 = CompletedProcess(args=[...])", False, "assert 重写的 where 行"),
  4324	        ("E   AssertionError: 四反引号短闭合仍被放行:", False, "消息自己以冒号结尾，仍是断言"),
  4325	        ("E     E1 围栏闭合: 少一个反引号", False, "续行首词恰好像类名 ⇒ 必须靠缩进外的冒号规则排除"),
  4326	    ):
  4327	        assert _nv._looks_like_crash(out) is want, f"崩溃判据判错: {why} | {out!r}"
  4328	
  4329	    # ④ transport：崩溃分析必须同时看 stderr。本域大量门跑 CLI 子进程，
  4330	    #    子进程 traceback 只落 stderr 时，外层只剩一个 AssertionError。
  4331	    assert not _nv._looks_like_crash("1 failed, 260 passed"), "前提：单看 stdout 不算崩溃"
  4332	    assert _nv._looks_like_crash(_nv._crash_text("1 failed, 260 passed", "Traceback (most recent call last):")), (
  4333	        "stderr 里的 traceback 被丢弃 ⇒ 生产崩溃会被当成正常判错变红"
  4334	    )
  4335	    assert _nv._crash_text("a", None) == "a\n", "stderr 为 None 时不得抛"
