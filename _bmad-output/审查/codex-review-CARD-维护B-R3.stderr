  3243	def test_domain_r5_derive_allow_cjk_pool_collision_cli(tmp_path):
  3244	    """R3 行为门①: fallback 允许式行内多字数词一律 fail-closed，单字不误伤。
  3245	
  3246	    **它证明什么**: 走完整 CLI（`--verify`）时，`一零`/`五四`（局部值**实测在池**，
  3247	    即碰撞前提成立）与 `九十八万`/`十` 全部 exit 1 且诊断为「无法验证」，
  3248	    诊断里不出现任何池比对结论；值在池的单字 `五` 放行。
  3249	    **它不证明什么**: 不证明「单字带自身值查池」——本 fixture 池覆盖 0-9，
  3250	    该性质由 test_domain_r5_derive_allow_single_char_value_enters_pool 证明。
  3251	    """
  3252	    rs = _load_recap_scan()
  3253	    vault = standard_vault(tmp_path)
  3254	    scan = collect_json(vault)
  3255	    pool = rs._derived_number_pool(scan)
  3256	    # ⛔ 碰撞前提必须**实测**: 局部值真的在池里，这条门才是在测「按错值查池会放行」；
  3257	    # 前提不成立时它只是在测别的东西（MEMORY `reference_gate_design_pitfalls`）。
  3258	    assert {0, 4, 5} <= pool, f"碰撞前提失效（局部值不在池）: {sorted(pool)}"
  3259	    report = write_report(vault, scan)
