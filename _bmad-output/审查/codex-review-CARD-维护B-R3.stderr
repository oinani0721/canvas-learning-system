  2573	def _verify_report(path: str) -> int:
  2574	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2575	
  2576	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2577	    """
  2578	    try:
  2579	        text_raw = Path(path).read_text(encoding="utf-8")
  2580	    except (OSError, UnicodeDecodeError) as e:
  2581	        print(f"✗ 报告不可读: {type(e).__name__}")
  2582	        return 1
  2583	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2584	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2585	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2586	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2587	    if not fm_m:
  2588	        print("✗ 报告缺 frontmatter 块")

