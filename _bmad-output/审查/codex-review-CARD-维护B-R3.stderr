  2183	                #    ⇒ 本函数自己 fail-closed：小节内的非空行必须是标准模板行。
  2184	                problems.append(
  2185	                    f"数字终核: 台账『种子』小节出现非模板行 (每行须为 "
  2186	                    f"`- <节点> — 批注 N 条` 或 `- <节点> — 无批注`): {ln.strip()[:60]}"
  2187	                )
  2188	                continue
  2189	            if not ms:
  2190	                ms = raw_ms
  2191	            if raw_ms:
  2192	                node = raw_ms.group("node").strip()
  2193	                if node in tips_by_node:
