  1615	def test_domain_block_four_fence_short_close(tmp_path):
  1616	    """E1: 四反引号开栏 + 三反引号「短闭合」后塞信号行 —— round-6 实测 exit 0。
  1617	
  1618	    CommonMark 规定闭合围栏须同字符且**不短于**开栏；原实现只存 `bare[:3]` 并用
  1619	    startswith 判闭合，于是块被误判为已结束，藏在 <pre><code> 里的信号行仍被
  1620	    verifier 当成在场陈述。
  1621	    """
  1622	
  1623	    def m(text, scan):
  1624	        sig = _sig_line(text)
  1625	        return text.replace(sig, f"````\n```\n{sig}", 1)
  1626	
  1627	    r = _mutate_report(tmp_path, m)
  1628	    assert r.returncode != 0, f"四反引号短闭合仍被放行:\n{r.stdout}"
  1629	
  1630	
  1631	def test_domain_block_blockquote_indented_code(tmp_path):
  1632	    """E1 邻域: 引用内缩进代码形态的信号行不得被当成合法在场。
  1633	
  1634	    ⚠️ 如实记录：round-6 报告称此例 exit 0，本卡开工前**实测为 exit 1**
  1635	    （被信号行模板的整行匹配拦下）。构造差异或代码已变，两说；
  1636	    本用例锁的是**结果面**——这种形态不得被当成合法信号行。
  1637	    """
  1638	
  1639	    def m(text, scan):
  1640	        sig = _sig_line(text)
  1641	        return text.replace(sig, f">     {sig.lstrip('> ').lstrip()}", 1)
  1642	
  1643	    r = _mutate_report(tmp_path, m)
  1644	    assert r.returncode != 0, f"引用内缩进代码形态被当成合法信号行:\n{r.stdout}"
  1645	

