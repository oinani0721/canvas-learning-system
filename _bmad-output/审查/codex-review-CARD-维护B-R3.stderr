   598	def _crash_text(stdout: str, stderr: str | None) -> str:
   599	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   600	
   601	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   602	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   603	    """
   604	    return stdout + "\n" + (stderr or "")
   605	
   606	
   607	def _looks_like_crash(out: str) -> bool:
   608	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   609	
   610	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   611	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   612	    """
   613	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   614	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   615	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   616	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   617	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   618	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   619	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   620	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   621	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   622	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   623	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   624	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   625	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   626	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   627	    LEGIT_RED = {"assert", "AssertionError"}
   628	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   629	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   630	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   631	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   632	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   633	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   634	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   635	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   636	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   637	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   638	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   639	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   640	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   641	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   642	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   643	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   644	    return bool(
   645	        any(name not in LEGIT_RED for name in exc_names)
   646	        or "Traceback (most recent call last):" in out
   647	        or "INTERNALERROR" in out
   648	        or errors > 0
   649	    )
   650	
   651	
   652	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   653	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   654	
   655	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   656	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   657	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   658	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   659	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   660	    要求"确实收集到用例"且"确实有失败"才算变红。
   661	    """
   662	    r = subprocess.run(
   663	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   664	        cwd=ROOT / "backend",
   665	        capture_output=True,
   666	        text=True,
   667	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   668	        timeout=600,
   669	    )
   670	    out = r.stdout
   671	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   672	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   673	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   674	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   675	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   676	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   677	    both = _crash_text(out, r.stderr)
   678	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   679	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   680	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   681	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   682	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   683	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   684	    # 的形式混进证据, 且永远不会有人去查。
   685	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   686	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   687	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   688	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   689	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   690	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   691	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   692	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   693	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   694	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   695	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   696	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   697	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   698	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   699	    crash = _looks_like_crash(both)
   700	    return r.returncode, out[-400:], passed + failed, failed, crash
   701	
   702	
   703	def main() -> int:
   704	    try:
   705	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   706	    except FileExistsError:
   707	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   708	        return 2
   709	    try:
   710	        original = TARGET.read_bytes()
   711	        backup_sha = hashlib.sha256(original).hexdigest()
   712	
   713	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   714	        if rc0 != 0 or f0 or n0 == 0:
   715	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   716	            return 2
   717	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   718	
   719	        failures = 0
   720	        for name, subs, keyword in MUTANTS:
   721	            text = original.decode("utf-8")
   722	            for old, new in subs:
   723	                if old not in text:
   724	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   725	                    failures += 1
   726	                    text = None
   727	                    break
   728	                text = text.replace(old, new, 1)
   729	            if text is None:
   730	                continue
   731	            TARGET.write_text(text, encoding="utf-8")
   732	            try:
   733	                rc, out, n, f, crash = run_suite(keyword)
   734	            finally:
   735	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   736	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   737	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   738	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   739	            if n == 0:
   740	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   741	                failures += 1
   742	            elif rc != 1:
   743	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   744	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   745	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   746	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   747	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   748	                failures += 1
   749	            elif crash:
   750	                print(
   751	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   752	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   753	                )
   754	                failures += 1
   755	            elif f == 0:
   756	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   757	                failures += 1
   758	            else:
   759	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   760	
   761	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   762	        return 1 if failures else 0
   763	    finally:
   764	        LOCK.rmdir()
   765	
   766	
   767	if __name__ == "__main__":
   768	    sys.exit(main())

