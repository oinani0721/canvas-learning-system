  2511	
  2512	def _verify_report(path: str) -> int:
  2513	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2514	
  2515	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2516	    """
  2517	    try:
  2518	        text_raw = Path(path).read_text(encoding="utf-8")
  2519	    except (OSError, UnicodeDecodeError) as e:
  2520	        print(f"✗ 报告不可读: {type(e).__name__}")
  2521	        return 1
  2522	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2523	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2524	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2525	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2526	    if not fm_m:
  2527	        print("✗ 报告缺 frontmatter 块")
  2528	        return 1
  2529	    fm = fm_m.group(1)
  2530	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2531	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2532	    if "<!--" in fm or "-->" in fm:
  2533	        print("✗ frontmatter 块内含 HTML 注释标记")
  2534	        return 1
  2535	    problems: list[str] = []
  2536	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2537	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  2538	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  2539	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  2540	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  2541	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  2542	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  2543	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  2544	    if "<!--" in text_raw or "-->" in text_raw:
  2545	        problems.append(
  2546	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2547	        )
  2548	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  2549	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  2550	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
  2551	    # round-4: 零宽/双向控制字符 — 渲染不可见但能改变正则匹配与阅读顺序,
  2552	    # 是"看起来合规、实际另一回事"的通用载体。合法报告没有理由出现它们。
  2553	    # ⛔ R3 round-15 (冻结审查): 这里原先**手抄**了一份不可见字符集, 只到 U+2064,
  2554	    #    而 _INVISIBLE_ONE 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  2555	    #    又一处「同一原则两处定义」。改为共用 _INVISIBLE_ONE。
  2556	    if re.search(_INVISIBLE_ONE, text):
  2557	        problems.append("正文含零宽/双向控制字符 (不可见字符, 报告禁用)")
  2558	    _verify_numbers(fm, text, Path(path), problems)
  2559	    if not re.search(r"^type:\s*recap\s*$", fm, re.M):
  2560	        problems.append("frontmatter 缺 type: recap")
  2561	    if "规模自陈" not in text:
  2562	        problems.append("缺 规模自陈 callout")
  2563	    # 六轮防御③: 必需段落唯一 — 重复段(第一段合规第二段夹私货)不放行。
  2564	    # ⛔ round-6 BLOCKER 同源修复: 根因是**存在性检查与下游定位口径不一致**
  2565	    # —— 存在性用前缀匹配 (`^## AI 侧对账`), 下游 tips 绑定/动作段白名单却用
  2566	    # 整行正则定位, 于是 `## AI 侧对账（本轮）` 两头讨好: 算"段落在场"、
  2567	    # 却让下游整块校验静默跳过。模板里 `## 台账（种子/派生）` 这类**设计内的
  2568	    # 括号补充**又必须放行, 所以不能一刀切整行精确。
  2569	    # 统一口径 = `_SECTION_RE`: 段名之后只允许「行尾」或「全角括号补充」,
  2570	    # 存在性检查与下游定位共用它, 缝隙消失。
  2571	    for s in _VERIFY_SECTIONS:
  2572	        n = len(re.findall(_SECTION_RE(s), text, re.M))
  2573	        if n == 0:
  2574	            problems.append(f"缺段落 {s} (标题须为段名本身或段名+（补充）)")
  2575	        elif n > 1:
  2576	            problems.append(f"段落重复 {n} 次(只许一个): {s}")
  2577	    msha = re.search(r'^board_sha256:\s*"?([0-9a-f]+)"?', fm, re.M)
  2578	    if not msha or len(msha.group(1)) != 64:
  2579	        problems.append("board_sha256 必须完整 64 hex (在 frontmatter 内)")
  2580	    for w in _VERIFY_GLOBAL_FORBIDDEN:
  2581	        if w in text:
  2582	            problems.append(f"HARD-R4 禁词命中: {w}")
  2583	    for w in _VERIFY_PLACEHOLDERS:
  2584	        if w in text:
  2585	            problems.append(f"占位符残留: {w}")
  2586	    for w in _VERIFY_BLAME:
  2587	        if w in text:
  2588	            problems.append(f"白名单外动作/甩锅词: {w}")
  2589	    s3_all = re.findall(r"^### ③.*?(?=^### |\Z)", text, re.M | re.S)
  2590	    if not s3_all:
  2591	        problems.append("缺 ### ③ 方向段")
  2592	    for s3 in s3_all:  # 逐个检查 — 重复③段同样全查
  2593	        for w in _VERIFY_S3_FORBIDDEN:
  2594	            if w in s3:
  2595	                problems.append(f"③段用户主语: {w}")
  2596	    is_fallback = bool(re.search(r"^data_mode:\s*fallback_local", fm, re.M))
  2597	    if is_fallback:
  2598	        if "FALLBACK" not in text:
  2599	            problems.append("fallback 报告缺 FALLBACK 声明")
  2600	        for w in _VERIFY_FALLBACK_DERIVE:
  2601	            if w in text:
  2602	                problems.append(f"fallback 派生断言(无据不得断言): {w}")
  2603	        # H4 (round-4 真结构级): 词表与"整段禁某词"都能被同义改写绕过
  2604	        # (「派生数量为零」→「后代节点数量为零」实测曾 PASS)。fallback 下
  2605	        # 派生**子女数**恒无据, 这类断言只可能出现在台账「种子」小节 —— 故
  2606	        # 改为**整行白名单**: 该小节每一行要么空, 要么必须整行匹配
  2607	        #   `- <node_id> — 批注 N 条`  /  `- <node_id> — 无批注`
  2608	        # 模板 (数字由 ledger 的 tips_count 支持)。任何自由叙述一律 FAIL,
  2609	        # 不再判断它"是不是在说派生"。
  2610	        # ⛔ round-22：形状门同样要在渲染文本上做，否则「源码不命中 ⇒
  2611	        #    整行白名单也不管」，两道门一起被同一条冲突行绕过。
  2612	        # ⚠️ 必须用**局部变量**，不能重绑 `text` —— 第一版写成 `text = _visible_block(text)`,
  2613	        #    它落在 `_verify_report` 的函数体作用域里, 于是**其后所有检查**（含全文
