  4585	def test_domain_r18_crash_judge_indent_and_child_stderr():
  4586	    """R3 round-20（冻结审查 v2 §四.4）：崩溃判据的假阳面 + 内层 stderr 接线。
  4587	
  4588	    两条判词都成立：
  4589	      · 只要「紧跟冒号」仍假阳 —— 断言消息的续行 `E       Expected: 3` 同样是
  4590	        「标识符+冒号」。实测 pytest 语法：顶层行是 `E` + **3 个空格**，
  4591	        续行缩进更深（`E     VERIFY…` 5 格 / `E    +  where` 4 格）；
  4592	      · 内层 CLI 以 `capture_output=True` 执行、断言只带 `r.stdout` ⇒
  4593	        子进程 traceback 若只在 stderr，**外层两路输出里根本不会出现**。
  4594	
  4595	    **它证明什么**：缩进上界（`E` + 1-3 格）+ `assert`/`AssertionError` 白名单判异常 ——
  4596	    「紧跟冒号」这个条件已在 round-20 二修**删除**（它既多余又漏掉无消息异常）；
  4597	    此处文案 round-23 才更正，此前与实现矛盾；
  4598	    `run_verify` 已把子进程 stderr 打到测试 stdout（pytest 失败时展示）。
  4599	    **它不证明什么**：这套解析**不是可靠二分**（round-21 如实收回该说法）——
  4600	    pytest 的缩进随 tb 风格而变，本仓 `backend/pytest.ini` 的 addopts 强制
  4601	    `--tb=short`（我此前注释写的『-q 默认 tb』是**事实错误**）。内层无
  4602	    traceback 的崩溃仍会假阴、正文偶含 traceback 字样仍会假阳。
  4603	    确定性的那一半由 `[[CHILD-CRASH]]` 标记承担，解析只是补充。
  4604	    """
  4605	    import importlib.util as _ilu
  4606	
  4607	    _prev = sys.dont_write_bytecode
  4608	    sys.dont_write_bytecode = True
  4609	    try:
  4610	        _spec = _ilu.spec_from_file_location(
  4611	            "negverify_ut2", pathlib.Path(__file__).with_name("recap_domain_negverify.py")
  4612	        )
  4613	        _nv = _ilu.module_from_spec(_spec)
  4614	        _spec.loader.exec_module(_nv)
  4615	    finally:
  4616	        sys.dont_write_bytecode = _prev
  4617	
  4618	    for out, want, why in (
  4619	        ("E   AssertionError: x", False, "顶层断言异常"),
  4620	        ("E   assert 0 != 0", False, "顶层裸 assert"),
  4621	        ("E     VERIFY FAIL (1 项)", False, "续行（5 格）"),
  4622	        ("E    +  where 0 = C(", False, "assert 重写的 where 行（4 格）"),
  4623	        ("E       Expected: 3", False, "续行里的『标识符+冒号』—— 只靠冒号会假阳"),
  4624	        ("E       Actual: 4", False, "同上"),
  4625	        ("E   re.error: bad", True, "顶层异常"),
  4626	        ("E   SystemExit: 2", True, "不以 Error/Exception 结尾"),
  4627	        ("E   subprocess.TimeoutExpired: t", True, "点分名"),
  4628	        ("E   Exception: boom", True, "裸 Exception"),
  4629	        ("E   Failed: 夹具坏", True, "pytest.fail = 夹具坏了"),
  4630	        ("E   RecursionError", True, "无消息异常：没有冒号，靠缩进上界识别"),
  4631	        # 缩进上界实现接受 1-3 格；实测形态是 3 格（本仓 pytest.ini 强制 --tb=short）。
  4632	        # 1/2 格没有实测样本，但判为异常是**保守方向**，这里显式锁住行为。
  4633	        ("E ValueError: x", True, "1 格缩进（无实测样本，保守判为异常）"),
  4634	        ("E  KeyError: x", True, "2 格缩进（同上）"),
  4635	        # 确定性标记优先于一切启发式
  4636	        ("[[CHILD-CRASH]] rc=1", True, "子进程崩溃的确定性标记"),
  4637	        ("1 passed", False, "对照：没有标记也没有异常行"),
  4638	        ("  Traceback (most recent call last):", True, "任意位置的 traceback"),
  4639	        ("INTERNALERROR> x", True, "pytest 内部错"),
  4640	        ("1 error, 260 passed", True, "收集期 error"),
  4641	        ("1 failed, 260 passed", False, "纯失败摘要"),
  4642	    ):
  4643	        assert _nv._looks_like_crash(out) is want, f"崩溃判据判错: {why} | {out!r}"
  4644	
