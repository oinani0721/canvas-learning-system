  2494	    """
  2495	    try:
  2496	        text_raw = Path(path).read_text(encoding="utf-8")
  2497	    except (OSError, UnicodeDecodeError) as e:
  2498	        print(f"✗ 报告不可读: {type(e).__name__}")
  2499	        return 1
  2500	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2501	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2502	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2503	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2504	    if not fm_m:
  2505	        print("✗ 报告缺 frontmatter 块")
  2506	        return 1
  2507	    fm = fm_m.group(1)
  2508	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2509	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2510	    if "<!--" in fm or "-->" in fm:

