  2387	def _verify_report(path: str) -> int:
  2388	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2389	
  2390	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2391	    """
  2392	    try:
  2393	        text_raw = Path(path).read_text(encoding="utf-8")
  2394	    except (OSError, UnicodeDecodeError) as e:
  2395	        print(f"✗ 报告不可读: {type(e).__name__}")
  2396	        return 1
  2397	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2398	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2399	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2400	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2401	    if not fm_m:
  2402	        print("✗ 报告缺 frontmatter 块")
  2403	        return 1
  2404	    fm = fm_m.group(1)
  2405	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2406	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2407	    if "<!--" in fm or "-->" in fm:
  2408	        print("✗ frontmatter 块内含 HTML 注释标记")
  2409	        return 1
  2410	    problems: list[str] = []

