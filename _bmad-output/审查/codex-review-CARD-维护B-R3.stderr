  1481	def _derived_number_pool(scan: dict) -> set[int]:
  1482	    """scan 数值池 (排除 scale_gate 常量, 含一阶和差) — D2 与 fallback
  1483	    允许式数字绑定 (round-3 HIGH-6) 共用的「有出处」判据。
  1484	
  1485	    ⛔ 池必须排除**与板内容无关的源码常量** (scale_gate 的 30/100/10) 与
  1486	    字符串污染; 「有出处」≠「字面出现」: 池含一阶和与差 (合法算术, 如
  1487	    「7 个派生点中仅 2 个带 derived_at……其余 5 个无据」的 5=7−2)。
  1488	    代价如实记: 池变大 ⇒ 对小数值拦截力下降 (罕见大数仍拦得住)。
  1489	    """
  1490	    scan_for_pool = {k: v for k, v in scan.items() if k != "scale_gate"}
  1491	    base: set[int] = set()
  1492	    _scan_number_pool(scan_for_pool, base)
  1493	    pool = set(base)
  1494	    ordered = sorted(base)
  1495	    for i, a in enumerate(ordered):
  1496	        for b in ordered[i:]:
  1497	            pool.add(a + b)
  1498	            pool.add(abs(a - b))
  1499	    return pool
