   706	                failures += 1
   707	            else:
   708	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   709	
   710	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   711	        return 1 if failures else 0
