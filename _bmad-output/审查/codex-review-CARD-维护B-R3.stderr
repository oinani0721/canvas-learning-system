   730	    # 信号4 · 重复堆积 — tips 文本归一化 (空白折叠+casefold) 全等分组,
   731	    # value = Σ(组内条数-1) 即冗余条数; 不做语义相似判定 (零编造)
   732	    norm_map: dict[str, list[str]] = {}
