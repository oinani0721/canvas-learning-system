  1536	def _blank_inline_code(mm: "re.Match[str]") -> str:
  1537	    """字段值 span 整段挖空; 可见计数 span **只挖掉反引号**, 内容留给数值门。
  1538	
  1539	    ⚠️ 只挖反引号（而不是原样保留）是必须的: 反引号不在连接字符集里,
  1540	    `` `-5`个 `` 原样留下时 `5` 与量词 `个` 被反引号隔开, 量词锚失效。
  1541	    等长替换, 行内偏移不变。
  1542	    """
  1543	    span = mm.group(0)
  1544	    if _codespan_is_visible_count(span[1:-1]):
  1545	        return " " + span[1:-1] + " "
  1546	    return " " * len(span)
