  2035	def _verify_seed_ledger_counts(text: str, scan: dict, problems: list[str]) -> None:
  2036	    """台账『种子』行的批注数必须绑到 scan JSON 里**该节点的** tips_count。
  2037	
  2038	    ⛔ 维护卡 B · H-2 后半 (round-6 实证): 原实现只有整行**形状**白名单
  2039	    (``- <节点> — 批注 N 条``), 不绑值 —— 把真实的「批注 2 条」改成
  2040	    「批注 999 条」形状照样合法, 实测 exit 0。白名单管住了句式, 没管住数字的出处。
  2041	
  2042	    scan JSON 的 ``ledger`` 是**按角色分组的 dict** (seeds/derived/unknown) 而非扁平
  2043	    列表 —— 我第一版直接迭代它, 拿到的是键字符串, verifier 当场抛 NameError/AttributeError,
  2044	    stdout 全空 exit 1, 症状伪装成"报告不合规"。这里显式摊平并容两种形态。
  2045	    """
  2046	    mseed = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", text, re.M | re.S)
  2047	    if not mseed:
  2048	        return
  2049	    groups = scan.get("ledger")
  2050	    rows: list[dict] = []
  2051	    if isinstance(groups, dict):
  2052	        for grp in groups.values():
  2053	            if isinstance(grp, list):
  2054	                rows.extend(x for x in grp if isinstance(x, dict))
  2055	    elif isinstance(groups, list):
  2056	        rows = [x for x in groups if isinstance(x, dict)]
  2057	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  2058	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  2059	        return
  2060	    tips_by_node = {str(r.get("node_id")): r.get("tips_count") for r in rows}
  2061	    for ln in mseed.group(1).splitlines():
  2062	        if not ln.strip():
  2063	            continue
  2064	        ms = _SEED_LEDGER_LINE_RE.match(ln)
  2065	        if not ms:
  2066	            continue  # 形状问题由 _verify_report 的模板白名单报, 此处不重复
  2067	        node = ms.group("node").strip()
  2068	        if node not in tips_by_node:
  2069	            problems.append(
  2070	                f"数字终核: 台账『种子』行的节点 {node!r} 不在 scan JSON 的 ledger 里 "
  2071	                "(台账不得列出未扫描到的节点)"
  2072	            )
  2073	            continue
  2074	        want = tips_by_node[node]
  2075	        got = 0 if ms.group("none") else int(ms.group("n"))
  2076	        if got != want:
  2077	            problems.append(
  2078	                f"数字终核: 台账『种子』行 {node} 报批注 {got} 条, "
  2079	                f"scan JSON 的 tips_count 是 {want} (形状对不等于数字有据)"
  2080	            )
