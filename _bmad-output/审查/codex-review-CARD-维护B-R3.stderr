   963	def _quote_width(line: str) -> int:
   964	    """行首到引用内容起点的宽度: 前导空白 + 逐层 `>`(+至多一空白)。
   965	
   966	    `> > - x` → 4; ` > - x` → 3 (⛔ round-4 抢救探针 A: 引用标记**前**的
   967	    前导空白计入——它是引用层的一部分); 无引用 (`- x` / `    x`) → 0。
   968	    """
   969	    pos, n = 0, len(line)
   970	    while pos < n and line[pos] in " \t":
   971	        pos += 1
   972	    w = pos
   973	    saw = False
   974	    while pos < n:
   975	        ch = line[pos]
   976	        if ch == ">":
   977	            saw = True
   978	            pos += 2 if pos + 1 < n and line[pos + 1] in " \t" else 1
   979	            w = pos
   980	        elif ch in " \t" and pos + 1 < n and line[pos + 1] == ">":
   981	            pos += 1
   982	            w = pos
   983	        else:
   984	            break
   985	    return w if saw else 0
