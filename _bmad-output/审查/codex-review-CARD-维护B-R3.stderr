  3594	def test_domain_r5_prose_single_char_value_enters_pool():
  3595	    """R3 round-2 单元门：D2 侧单字数词同样必须**带自身值**进池比对。
  3596	
  3597	    ⚠️ 与 fallback 侧同因：标准 fixture 池 `[0..16,22]` 覆盖 `_CJK_NUM` 全部值
  3598	    （0-9），CLI 层构造不出「单字且值不在池」的用例，于是「值不在池」这条分支
  3599	    在 D2 侧**零门覆盖**（车道对抗审查实测：摘掉该分支 253 用例仍全绿）。
  3600	    合成 scan 把池收窄到 `[0,1,2]`，`九` 才能证明 9 确实进了池比对。
  3601	
  3602	    **它证明什么**：D2 段内单字 → 按自身值查池（九→找不到同值来源 / 二→放行）；
  3603	    多字与被切断的数串 → 走「无法解析」，且诊断里出现的是**剥噪声后的完整数串**。
  3604	    **它不证明什么**：不证明段切分、豁免跨度剥离与句式门——那是 CLI 门的事。
  3605	    """
  3606	    rs = _load_recap_scan()
  3607	    synth = {"data_mode": "fallback_local", "counts": {"members": 1, "seeds": 1}}
  3608	    assert rs._derived_number_pool(synth) == {0, 1, 2}, "合成池漂移，判别前提失效"
  3609	
  3610	    def probs(tok: str) -> list[str]:
  3611	        out: list[str] = []
  3612	        rs._verify_prose_counts(
  3613	            f"## 三维审查\n\n- 本板共有{tok}个子节点。【实测】\n", synth, out
  3614	        )
  3615	        return out
  3616	
  3617	    got = probs("九")
  3618	    assert any("九(9)" in p and "找不到同值来源" in p for p in got), (
  3619	        f"单字未按自身值查池: {got}"
  3620	    )
  3621	    assert probs("二") == [], "值在池的单字被误伤"
  3622	    for tok, joined in (("一零", "一零"), ("九十八万**五", "九十八万五")):
  3623	        got = probs(tok)
  3624	        assert any("无法解析" in p and joined in p for p in got), (
  3625	            f"{tok}: 诊断类别与完整数串未绑在同一条 problem: {got}"
  3626	        )
  3627	        assert not any("找不到同值来源" in p for p in got), (
  3628	            f"{tok}: 仍按局部值查池: {got}"
  3629	        )
  3630	
  3631	
  3632	# ── R3 round-3：Codex round-2 报的 4 条 HIGH（车道逐条实测复现后闭合）──────────
  3633	# 根因是同一个结构病：取数按字符类分成 CJK / ASCII 两条循环，于是**跨类**或
  3634	# **表外**的数词字成了断点，匹配重锚到尾片。已合并为一条规则（宽集合定界 →
  3635	# 剥连接字符 → 只有「全 ASCII 数字」或「表内单字」给值，其余 fail-closed）。
  3636	# ⚠️ Codex 同轮还报了 `980,005个` 被切断——**实测不成立**（逗号归一化已覆盖，
  3637	# 按 980005 查池），本卡如实驳回，见验收单 §五。
  3638	
  3639	
  3640	def _one_problem_has(stdout: str, *needles: str) -> bool:
  3641	    """同一条诊断行里同时出现全部 needle。
  3642	
  3643	    ⛔ Codex round-2 的测试批评（属实）：`assert "无法解析" in out` 与
  3644	    `assert "九十八万五" in out` 两条独立 `any`，理论上可由**两条不同的**
  3645	    problem 分别满足 —— 断言没有把「诊断类别」与「完整 token」绑在一起。
  3646	    """
  3647	    return any(all(n in ln for n in needles) for ln in stdout.splitlines())
  3648	
  3649	
  3650	def test_domain_r6_cross_class_and_offtable_numeral_cli(tmp_path):
  3651	    """R3 round-3 行为门：跨类 / 表外数词字 / CJK 小数都不得按尾片查池。
  3652	
  3653	    四条实测反例（修前全部 exit 0）：
  3654	      · `本板共有九十八万5个子节点` —— CJK run 停在 `万`，ASCII 只取 `5`
  3655	      · `本板共有廿五个子节点` —— `廿` 表外，从 `五` 重锚按 5 查池（读者读 25）
  3656	      · `本板共有壹佰个子节点` —— 两字全表外，一个 token 都抽不出
  3657	      · `本板共有五点五个 / 5点5个` —— `点` 在量词表里，被拆成两个 5 分别碰池
  3658	      · fallback `#### 派生子女 1 000 个` —— `\\d+` 拆成碎片逐片碰池
  3659	
  3660	    **它证明什么**：D2 与 fallback、CJK 与 ASCII 走**同一条**取数规则；
  3661	    诊断类别与还原后的完整 token 出现在**同一条** problem 里；
  3662	    合法形态（含 `3点建议` 里 `点` 的正当量词用法）不被反噬。
  3663	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 仍是**封闭表**（廿卅卌 + 大写金融
  3664	    数字 + 异体），表外的其它数词写法仍可能重锚；量词表同样封闭。见 §五之三。
  3665	    """
  3666	    vault = standard_vault(tmp_path)
  3667	    scan = collect_json(vault)
  3668	    pool = _load_recap_scan()._derived_number_pool(scan)
  3669	    assert {5, 3, 16, 22} <= pool, f"放行面前提失效: {sorted(pool)}"
  3670	    report = write_report(vault, scan)
  3671	    base_text = report.read_text(encoding="utf-8")
  3672	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3673	
  3674	    def verify(anchor: str, injected: str):
  3675	        text = base_text.replace(anchor, injected, 1)
  3676	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3677	        report.write_text(text, encoding="utf-8")
  3678	        return run_verify(report)
  3679	
  3680	    def d2(line: str):
  3681	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3682	
  3683	    def fb(tok: str):
  3684	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3685	
  3686	    # 拦截面：诊断必须同时点名「无法解析」与**还原后的完整 token**
  3687	    for name, line, token in (
  3688	        ("跨类混写", "- 本板共有九十八万5个子节点。【实测】", "九十八万5"),
  3689	        ("表外廿", "- 本板共有廿五个子节点。【实测】", "廿五"),
  3690	        ("表外大写金融数字", "- 本板共有壹佰个子节点。【实测】", "壹佰"),
  3691	        ("多字+切断", "- 本板共有九十八万**五**个子节点。【实测】", "九十八万五"),
  3692	    ):
  3693	        r = d2(line)
  3694	        assert r.returncode != 0, f"D2 {name} 被放行:\n{r.stdout}"
  3695	        assert _one_problem_has(r.stdout, "无法解析", token), (
  3696	            f"D2 {name}: 诊断类别与完整 token 未绑在同一条 problem:\n{r.stdout}"
  3697	        )
  3698	    # CJK/混写小数：与 ASCII 小数同口径恒 FAIL
  3699	    for name, line, token in (
  3700	        ("CJK 小数", "- 本板共有五点五个子节点。【实测】", "五点五"),
  3701	        ("混写小数", "- 本板共有5点5个子节点。【实测】", "5点5"),
  3702	    ):
  3703	        r = d2(line)
  3704	        assert r.returncode != 0, f"D2 {name} 被放行:\n{r.stdout}"
  3705	        assert _one_problem_has(r.stdout, "小数形态", token), (
  3706	            f"D2 {name}: 未按小数形态点名:\n{r.stdout}"
  3707	        )
  3708	    # fallback 侧 ASCII 也必须整串取（round-2 只补了 CJK 侧，是本轮 HIGH 之一）
  3709	    for name, tok, token in (
  3710	        ("ASCII SI千分位", "1 000", "1000"),
  3711	        ("ASCII 标记切断", "9**5", "95"),
  3712	    ):
  3713	        r = fb(tok)
  3714	        assert r.returncode != 0, f"fallback {name} 被放行:\n{r.stdout}"
  3715	        assert _one_problem_has(r.stdout, "无出处", token), (
  3716	            f"fallback {name}: 未按整串值点名:\n{r.stdout}"
  3717	        )
  3718	    r = fb("廿五")
  3719	    assert r.returncode != 0 and _one_problem_has(r.stdout, "无法验证", "廿五"), (
  3720	        f"fallback 表外数词未 fail-closed:\n{r.stdout}"
  3721	    )
  3722	
  3723	    # 放行面（同权重）
  3724	    for name, line in (
  3725	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3726	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
  3727	        ("前导零 016=16", "- 本板共有016个子节点。【实测】"),
  3728	        ("池内 22", "- 本板共有22个子节点。【实测】"),
  3729	        ("`点` 的正当量词用法", "- 本板共有3点建议。【实测】"),
  3730	        ("round-5 原始误伤 十分", "- 说明十分清楚。【实测】"),
  3731	        ("round-5 原始误伤 一致", "- 统计口径尚未一致。【实测】"),
  3732	    ):
  3733	        r = d2(line)
  3734	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
  3735	    for name, tok in (("fallback 单字在池", "五"), ("fallback ASCII 在池", "3")):
  3736	        r = fb(tok)
  3737	        assert r.returncode == 0, f"合法形态被误伤（{name}）:\n{r.stdout}"
  3738	
  3739	    # Codex round-2 报的第五条：`980,005个` 声称被逗号切断 —— **实测不成立**，
  3740	    # 逗号归一化先于取数生效，按 980005 查池。这条门把「不成立」也钉住，
  3741	    # 防止后人照抄该判词去"修"一个不存在的问题。
  3742	    r = d2("- 本板共有980,005个子节点。【实测】")
  3743	    assert r.returncode != 0 and _one_problem_has(
  3744	        r.stdout, "找不到同值来源", "980005"
  3745	    ), (
  3746	        # ⛔ 必须同时绑「找不到同值来源」——只断言出现 980005 的话，
  3747	        # 实现改成「无法解析 980005」这条门照样绿，就证不出"按 980005 **查池**"
  3748	        # 这件事（Codex round-3 属实指出）。
  3749	        f"千分位逗号形态应按完整量级 980005 **查池**:\n{r.stdout}"
  3750	    )
  3751	
  3752	
  3753	# ── R3 round-4：Codex round-3 报的 3 条 HIGH（车道逐条实测复现后闭合）──────────
  3754	# ⚠️ 轮次口径：round-1 被内容过滤器截断、**无终裁**（卡文判 UNVERIFIABLE），
  3755	# 故产出终裁的是 round-2 / round-3 两轮，本轮整改后仍有一轮送审额度。
