  4161	    # 一半，于是 `` `九十八万个` ``/`` `987654 个` `` 这类**完整可见计数**写进
  4162	    # code span 会被整体挖空、整域免检。现数字部分也派生自定界集。
  4163	    for span in ("987654 个", "九十八万个", "987654", "廿五个"):
  4164	        assert rs._codespan_is_visible_count(span), f"纯计数 code span `{span}` 被当字段值挖空 ⇒ 可见计数整域免检"
