  2119	            continue  # 形状问题由 _verify_report 的模板白名单报, 此处不重复
  2120	        if raw_ms:
  2121	            # raw 行本身就解析得出 ⇒ 身份精确，不进归一空间（也就不会被归一撞车误伤）
  2122	            node = raw_ms.group("node").strip()
  2123	            if node in tips_by_node:
  2124	                key = node
  2125	                want = tips_by_node[key]
  2126	                got = 0 if raw_ms.group("none") else int(raw_ms.group("n"))
  2127	                if got != want:
  2128	                    problems.append(
  2129	                        f"数字终核: 台账『种子』行 {key} 报批注 {got} 条, "
  2130	                        f"scan JSON 的 tips_count 是 {want} (形状对不等于数字有据)"
  2131	                    )
  2132	                continue
  2133	            problems.append(
  2134	                f"数字终核: 台账『种子』行的节点 {node!r} 不在 scan JSON 的 ledger 里 "
  2135	                "(台账不得列出未扫描到的节点)"
  2136	            )
  2137	            continue
  2138	        # 走到这里 = raw 行解析不出（被排版切开的行）⇒ 只能在归一空间找身份
  2139	        node = ms.group("node").strip()
  2140	        cands = vis_index.get(node) or []
  2141	        if len(cands) > 1:
  2142	            problems.append(
  2143	                f"数字终核: 台账『种子』行的节点 {node!r} 归一后同时对应 "
  2144	                f"{sorted(cands)!r} —— 无法确定是哪一个, 不猜 (fail-closed)"
