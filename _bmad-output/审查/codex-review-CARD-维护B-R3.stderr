  1081	def _verify_signal_lines(text: str, signals: dict, problems: list[str]) -> None:
  1082	    """G5-4 信号绑定 (fail-closed): scan JSON 含 signals 键才进本函数。
  1083	
  1084	    ③段必须逐信号给**独占一行**的标准行, 行内数字与 availability 档与
  1085	    signals.* 全等 — 篡改任一数字 / 档位 / 缺行 / 无据错标 / 合并行 → FAIL。
  1086	    旧 scan JSON (无 signals 键) 由调用方跳过 (兼容)。同 label 行若出现
  1087	    多条, 逐条全查 — 防"一条合规一条私货"的双行逃逸。
  1088	    """
  1089	    # M3 (round-2 → round-4): ③ 段止于下一个 ## / ###。历轮收紧:
  1090	    #   round-2 只认 ###（"## 附录"可越界）→ round-3 认 tab 分隔（"##\t附录"）
  1091	    #   → round-4 认**空标题** `##`（行尾即止，无标题文字也是合法标题）。
  1092	    # 另: 信号行**不得藏在代码块里** — fenced (```/~~~) 与四空格缩进块在渲染
  1093	    # 时是字面文本, 与"报告在说什么"分叉, 故校验前整体剔除。
  1094	    scan_text = _strip_code_blocks(text)
  1095	    # ⛔ round-6 终裁复核: 剔除代码块是**双向**的 — 它挡住"把必需行藏进围栏",
  1096	    # 却放行"在合规行之外再往围栏里追加一组造假信号行"(围栏内容在 Obsidian
  1097	    # 里照常渲染为可见文本, 读者会看到与 scan JSON 冲突的第二组数字)。
  1098	    # 故: 被剔除的那部分文本里**不得出现任何信号 label**。
  1099	    # ⛔ CARD-维护B-R2 round-3 HIGH-3: 原 zip() 在行数不等时静默截断 ——
  1100	    # EOF 未闭合围栏把尾部行全部剥空后, splitlines() 行数差让**最后一行原文
  1101	    # 不参与比较**, 藏在里面的伪信号逃过本检查。改 zip_longest 对齐。
  1102	    stripped_only = "\n".join(
  1103	        a
  1104	        for a, b in zip_longest(text.splitlines(), scan_text.splitlines(), fillvalue="")
  1105	        if a != b
  1106	    )
  1107	    for _, lb in _SIGNAL_SPECS:
  1108	        if lb in stripped_only:
  1109	            problems.append(
  1110	                f"代码块内出现信号名 {lb} (围栏内容仍会渲染给读者, "
  1111	                "不得放置第二组信号数字)"
  1112	            )
  1113	    s3 = "\n".join(
  1114	        re.findall(r"^### ③.*?(?=^#{2,3}(?:[^\S\n]|$)|\Z)", scan_text, re.M | re.S)
  1115	    )
  1116	    if not s3:
  1117	        problems.append("数字终核: scan JSON 含 signals 但报告缺 ③ 段可绑定信号行")
  1118	        return
  1119	    all_labels = [lb for _, lb in _SIGNAL_SPECS]
  1120	    for key, label in _SIGNAL_SPECS:
  1121	        sig = signals.get(key)
  1122	        if not _verify_signal_schema(key, sig, problems):
  1123	            continue
  1124	        # ⛔ R3 round-18 (冻结审查 §一.3 raw 专用绑定): 原实现在 **raw** 行上
  1125	        # 找 label 选行 ⇒ 保留一条合规行, 再加一条**渲染等价但 label 被
  1126	        # 切开**的冲突行 (`来源**覆盖**率：99/3…` / `来源<b>覆盖</b>率：99/3…`),
  1127	        # 后者根本进不了「逐条全查」—— 两条实测 exit 0 放行。
  1128	        # 零宽切开的形态被全文零宽门拦下, 但排版标记/HTML 标签没有那道门。
  1129	        # ⇒ 选行与后续校验全部改在 _visible_text() 上: **读者看到的那一行**
  1130	        #   才是判据对象 —— 与 D2/fallback 两条主链同一个文本空间。
  1131	        lines = [v for v in (_visible_text(ln) for ln in s3.splitlines()) if label in v]
  1132	        if not lines:
  1133	            problems.append(f"数字终核: ③段缺信号行 {label}")
  1134	            continue
  1135	        avail = sig.get("availability")

