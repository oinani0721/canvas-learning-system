  2098	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  2099	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  2100	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
  2101	    if not mname:
  2102	        problems.append(f"报告文件名不符 `回顾-<板>-<日期>.md`: {report_path.name}")
  2103	    elif mname.group(1) != board_id:
  2104	        problems.append(
  2105	            f"数字终核: frontmatter board={board_id!r} 与文件名的板 "
  2106	            f"{mname.group(1)!r} 不一致 (不得绑定另一块板的 scan JSON)"
  2107	        )
  2108	    scan_path = report_path.parent / f".recap-scan-{board_id}.json"
