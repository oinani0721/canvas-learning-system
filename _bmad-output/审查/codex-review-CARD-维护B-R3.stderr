   828	def run_suite(keyword: str) -> tuple[int, str, int, int, bool]:
   829	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数, 是否崩溃)。
   830	
   831	    ⛔ round-27（冻结审查 v8）：注解与 docstring 原写**四元组**，实际返回五元组
   832	    （`crash` 是 round-10 加的）—— 又一处「说的与做的不符」。
   833	
   834	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   835	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   836	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   837	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   838	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   839	    要求"确实收集到用例"且"确实有失败"才算变红。
   840	    """
   841	    r = subprocess.run(
   842	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   843	        cwd=ROOT / "backend",
   844	        capture_output=True,
   845	        text=True,
   846	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   847	        timeout=600,
   848	    )
   849	    out = r.stdout
   850	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   851	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   852	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   853	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   854	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   855	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   856	    both = _crash_text(out, r.stderr)
   857	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   858	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   859	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   860	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   861	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   862	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   863	    # 的形式混进证据, 且永远不会有人去查。
   864	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   865	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   866	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   867	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   868	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   869	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   870	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   871	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   872	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   873	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   874	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
