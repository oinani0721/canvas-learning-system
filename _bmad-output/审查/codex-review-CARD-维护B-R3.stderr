   632	def signal_lines(sig: dict) -> str:
   633	    lines = []
   634	    a = sig["unanswered_question_age"]
   635	    if a["availability"] == "无据":
   636	        lines.append("> - 未答问题年龄：无据（无带时间戳批注）")
   637	    else:
   638	        pr = a["percentile_ref"]
   639	        lines.append(
   640	            f"> - 未答问题年龄：最老 {a['value']} 天（参与统计 {a['denominator']} 条，"
   641	            f"p25/p50/p75 = {pr['p25_days']}/{pr['p50_days']}/{pr['p75_days']} 天）【{a['availability']}】"
   642	        )
   643	    for key, label, tail in (
   644	        ("source_coverage", "来源覆盖率", "成员含来源锚点"),
   645	        ("unsourced_conclusions", "无来源结论", "派生角色成员缺来源锚点"),
   646	        ("duplicate_accumulation", "重复堆积", "条批注为重复条目"),
   647	    ):
   648	        s = sig[key]
   649	        if s["availability"] == "无据":
   650	            lines.append(f"> - {label}：无据（分母为零）")
   651	        else:
   652	            lines.append(f"> - {label}：{s['value']}/{s['denominator']} {tail}【{s['availability']}】")
   653	    return "\n".join(lines)
