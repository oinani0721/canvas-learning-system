  2073	def _tail_conflict(mm: "re.Match[str]", key: str, problems: list[str]) -> None:
  2074	    """种子行尾巴里若再出现**同一字段**的计数，与已绑定的首数矛盾 ⇒ fail-closed。
  2075	
  2076	    ⛔ R3 round-26（冻结审查 v7 直接回答了我提的问题）：round-25 放宽尾巴起始
  2077	    字符集，让真实报告的 `（理解度未闭环 3 条）；…` 进入首数绑定 —— 这是**覆盖
  2078	    扩大**；但相对于同轮新增的 fail-closed 形状门，它**也确实放松了接受集**。
  2079	    审查方判词是「两者兼有」，我原来只说了扩大那一半 —— 措辞比证据宽。
  2080	
  2081	    ⚠️ 能力边界：尾巴里的**其它**字段（`理解度未闭环 N 条` / `已派生 N 点`）
  2082	    在 scan JSON 里没有对应的逐节点字段可绑，**本函数不管**，如实登记。
  2083	    这里只堵一种明确矛盾：尾巴里又写了一个 `批注 N 条`。
  2084	    """
  2085	    rest = mm.groupdict().get("rest") or ""
  2086	    for _n in re.findall(r"批注\s*(\d+)\s*条", rest):
  2087	        problems.append(
  2088	            f"数字终核: 台账『种子』行 {key} 的尾巴里又出现『批注 {_n} 条』——"
  2089	            "同一字段两处计数, 无法确定以哪个为准 (fail-closed)"
  2090	        )
  2091	
