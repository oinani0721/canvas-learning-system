  4578	        assert rs._D2_RANGE_RE.search(f"2{ch}3个"), f"区间分隔符 {ch!r} 不被区间正则识别 ⇒ 两侧分隔表已分叉"
  4579	    for ch in ("\u00a0", "\u3000"):
