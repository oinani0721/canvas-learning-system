  5080	def test_domain_r25_section_criterion_unified_cli(tmp_path):
  5081	    """R3 round-29（冻结审查 v10）：段落标题**唯一口径** + 围栏内假标题不截断小节。
  5082	
  5083	    ⛔ `_SECTION_RE` 的 docstring 明写：「存在性检查与下游定位**必须共用本函数** ——
  5084	    两处口径一旦不同，就会出现『算在场却定位不到』的缝隙」。round-28 我在种子扫描里
  5085	    **自己写了两式**，正好犯了它警告的那件事：
  5086	
  5087	      · `## 台账（x`（未闭合括号）—— 必需段门认在场，我的式子不认 ⇒ 种子校验器
  5088	        拿到零个 section 直接返回，`999` **完全不绑定**；
  5089	      · 反向，我新接受的 `   ## 台账` / `## 台账 ###` 又会被必需段门拒绝。
  5090	
  5091	    ⇒ 改回共用 `_SECTION_RE`。缩进标题与 ATX 闭合井号两侧**一致地不接受**：
  5092	    写成那样的报告会被必需段门直接判 FAIL（本门第 ④ 段端到端验证），整体 fail-closed。
  5093	    要放宽就得改 `_SECTION_RE` 本体让两侧同时动 —— 不在本轮范围。
  5094	
  5095	    **它证明什么**：口径分叉的两个方向都堵上；围栏内假标题不再截断小节；
  5096	    「不接受缩进标题」在 CLI 全链路上是 fail-closed 而非漏网。
  5097	    **它不证明什么**：不证明 `_SECTION_RE` 的接受集与 CommonMark 一致
  5098	    （它**不**接受合法的 0-3 格缩进与 ATX 闭合序列）—— 那是**声明过的统一口径**，
  5099	    要改需连同全部消费方一起改，如实登记。
  5100	    """
  5101	    rs = _load_recap_scan()
  5102	    S = {"ledger": {"seeds": [{"node_id": "SeedA", "tips_count": 2}]}}
  5103	
  5104	    def run(text: str) -> list[str]:
  5105	        ps: list[str] = []
  5106	        rs._verify_seed_ledger_counts(text, S, ps)
  5107	        return ps
  5108	
  5109	    # ① 口径分叉的正向：必需段门认在场的形态，种子绑定也必须认
  5110	    ps = run("## 台账（x\n### 种子\n- SeedA — 批注 999 条\n\n## 末\n")
  5111	    assert any("999" in p for p in ps), f"`## 台账（x` 下的冲突行未绑定：{ps!r}"
  5112	    # 与全局口径同源（漂移即被抓）
  5113	    import re as _re
  5114	
  5115	    assert _re.match(rs._SECTION_RE("## 台账"), "## 台账（x"), "前提：必需段门确实接受该形态"
  5116	
  5117	    # ② 围栏内的假标题不得截断小节
  5118	    ps = run("## 台账\n\n### 种子\n\n```\n## 假标题\n```\n\n- SeedA — 批注 999 条\n\n## 末\n")
  5119	    assert any("999" in p for p in ps), f"围栏内假标题截断了小节：{ps!r}"
  5120	
  5121	    # ③ 一致地不接受（两侧同口径）
  5122	    for text, why, want in (
