  4562	def test_domain_r18_crash_judge_indent_and_child_stderr():
  4563	    """R3 round-20（冻结审查 v2 §四.4）：崩溃判据的假阳面 + 内层 stderr 接线。
  4564	
  4565	    两条判词都成立：
  4566	      · 只要「紧跟冒号」仍假阳 —— 断言消息的续行 `E       Expected: 3` 同样是
  4567	        「标识符+冒号」。实测 pytest 语法：顶层行是 `E` + **3 个空格**，
  4568	        续行缩进更深（`E     VERIFY…` 5 格 / `E    +  where` 4 格）；
  4569	      · 内层 CLI 以 `capture_output=True` 执行、断言只带 `r.stdout` ⇒
  4570	        子进程 traceback 若只在 stderr，**外层两路输出里根本不会出现**。
  4571	
  4572	    **它证明什么**：缩进上界 3 格 + 紧跟冒号两条件同时成立才判异常；
  4573	    `run_verify` 已把子进程 stderr 打到测试 stdout（pytest 失败时展示）。
  4574	    **它不证明什么**：pytest 的缩进约定随 tb 风格而变；本判据绑定的是
  4575	    **本套件实际使用的那条命令**（`-q` 默认 tb）的实测输出。
  4576	    """
  4577	    import importlib.util as _ilu
  4578	
  4579	    _prev = sys.dont_write_bytecode
  4580	    sys.dont_write_bytecode = True
  4581	    try:
  4582	        _spec = _ilu.spec_from_file_location(
  4583	            "negverify_ut2", pathlib.Path(__file__).with_name("recap_domain_negverify.py")
  4584	        )
  4585	        _nv = _ilu.module_from_spec(_spec)
  4586	        _spec.loader.exec_module(_nv)
  4587	    finally:
  4588	        sys.dont_write_bytecode = _prev
  4589	
  4590	    for out, want, why in (
  4591	        ("E   AssertionError: x", False, "顶层断言异常"),
  4592	        ("E   assert 0 != 0", False, "顶层裸 assert"),
  4593	        ("E     VERIFY FAIL (1 项)", False, "续行（5 格）"),
  4594	        ("E    +  where 0 = C(", False, "assert 重写的 where 行（4 格）"),
  4595	        ("E       Expected: 3", False, "续行里的『标识符+冒号』—— 只靠冒号会假阳"),
  4596	        ("E       Actual: 4", False, "同上"),
  4597	        ("E   re.error: bad", True, "顶层异常"),
  4598	        ("E   SystemExit: 2", True, "不以 Error/Exception 结尾"),
  4599	        ("E   subprocess.TimeoutExpired: t", True, "点分名"),
  4600	        ("E   Exception: boom", True, "裸 Exception"),
  4601	        ("E   Failed: 夹具坏", True, "pytest.fail = 夹具坏了"),
  4602	        ("E   RecursionError", True, "无消息异常：没有冒号，靠缩进上界识别"),
  4603	        ("  Traceback (most recent call last):", True, "任意位置的 traceback"),
  4604	        ("INTERNALERROR> x", True, "pytest 内部错"),
  4605	        ("1 error, 260 passed", True, "收集期 error"),
  4606	        ("1 failed, 260 passed", False, "纯失败摘要"),
  4607	    ):
  4608	        assert _nv._looks_like_crash(out) is want, f"崩溃判据判错: {why} | {out!r}"
  4609	
  4610	    # transport：内层 CLI 的 stderr 必须被抬到测试 stdout（否则外层永远看不到）
  4611	    src = pathlib.Path(__file__).read_text(encoding="utf-8")
  4612	    assert "_surface_child_stderr(r)" in src, "run_verify 未接线子进程 stderr"
  4613	    assert _nv._looks_like_crash(_nv._crash_text("1 failed, 260 passed", "Traceback (most recent call last):")), (
  4614	        "外层 stderr 仍被丢弃"
  4615	    )
  4616	
