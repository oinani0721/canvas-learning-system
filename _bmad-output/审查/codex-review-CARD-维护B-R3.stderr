  4425	    for extra, why in (
  4426	        ("> - 来源覆盖率：99/3 成员含来源锚点【文件】", "对照：裸 label 冲突行"),
  4427	        ("> - 来源**覆盖**率：99/3 成员含来源锚点【文件】", "label 被强调标记切开"),
  4428	        ("> - 来源<b>覆盖</b>率：99/3 成员含来源锚点【文件】", "label 被 HTML 标签切开"),
  4429	        ("> - 来源\u200b覆盖率：99/3 成员含来源锚点【文件】", "label 被零宽切开（全文门兜底）"),
  4430	    ):
  4431	        assert with_extra(extra).returncode != 0, f"{why}：冲突信号行被放行 —— {extra!r}"
  4432	
  4433	    # 不得误伤：把合规行本身写成渲染等价的强调形态，仍须通过
  4434	    report.write_text(
  4435	        base.replace(good, "> - 来源**覆盖**率：2/3 成员含来源锚点【文件】", 1),
  4436	        encoding="utf-8",
  4437	    )
  4438	    assert run_verify(report).returncode == 0, "渲染等价的合规行被误判"
