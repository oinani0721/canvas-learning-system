  4132	    守卫自动跟上，`` `例` `` 不再被当普通 code span 挖空）；② ⑦⑧允许式的数词禁集
  4133	    覆盖定界集全集，任一方漂移都会被这道门抓住。
  4134	    **它不证明什么**：⑦⑧ 的副本**仍然存在**（只是不能再静默分叉）；
  4135	    三张主表本身**仍是封闭表**，本门不宣称覆盖表外形态。
  4136	    """
  4137	    rs = _load_recap_scan()
  4138	    quant = set(rs._D2_QUANT.strip("[]"))
  4139	
  4140	    # ① inline-code 守卫必须与主量词表同步（派生 ⇒ 逐字覆盖）
  4141	    for ch in sorted(quant):
  4142	        assert not rs._D2_INLINE_CODE_RE.fullmatch(f"`{ch}`"), (
  4143	            f"量词 {ch!r} 单独写成 code span 时被挖空 ⇒ 前面的数字失去锚点；inline-code 守卫与 _D2_QUANT 已分叉"
  4144	        )
  4145	    # ⛔ round-14（冻结审查）：数字部分原先仍手写 `[0-9]+` ——「副本已消除」只对了
  4146	    # 一半，于是 `` `九十八万个` ``/`` `987654 个` `` 这类**完整可见计数**写进
  4147	    # code span 会被整体挖空、整域免检。现数字部分也派生自定界集。
  4148	    for span in ("`987654 个`", "`九十八万个`", "`987654`", "`廿五个`"):
  4149	        assert not rs._D2_INLINE_CODE_RE.fullmatch(span), f"纯计数 code span {span} 被当字段值挖空 ⇒ 可见计数整域免检"
  4150	    # 负号集必须是**单一常量**（原先 D2/fallback 手抄两次）
  4151	    assert hasattr(rs, "_NEG_SIGN"), "负号集应提为单一常量，避免第三处副本"
  4152	    # ⛔ round-15（冻结审查）：全文零宽门原先**手抄**一份只到 U+2064 的集合，
  4153	    # 而 `_INVISIBLE_ONE` 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  4154	    # 又一处「同一原则两处定义」。现两处共用同一常量 —— 逐字符验证一致性。
  4155	    import re as _re
  4156	
  4157	    _inv = _re.compile(rs._INVISIBLE_ONE)
  4158	    # 全文零宽门与归一集必须是**同一个**集合：逐字符比对两者判定。
  4159	    _globals_src = pathlib.Path(rs.__file__).read_text(encoding="utf-8")
  4160	    assert "if re.search(_INVISIBLE_ONE, text):" in _globals_src, (
  4161	        "全文零宽门未共用 _INVISIBLE_ONE —— 手抄副本会与归一集分叉"
  4162	    )
  4163	    for _cp in (0x2065, 0x2066, 0x2067, 0x2068, 0x2069):
  4164	        assert _inv.match(chr(_cp)), f"U+{_cp:04X} (bidi isolate) 不在不可见集内 —— 它能切断数串却过全局门"
  4165	    # 反面：非量词的 code span 仍应被挖空（否则豁免整个失效）
  4166	    assert rs._D2_INLINE_CODE_RE.fullmatch("`abc`"), "普通 code span 应仍被豁免"
  4167	
  4168	    # ② ⑦⑧允许式的手抄数词禁集必须覆盖定界集全集（漂移即被抓）
  4169	    # ⚠️ 必须**按行为**检测，不能拿字符去子串匹配 pattern 源码 ——
  4170	    # `0-9` 在字符类里是**区间**，`"1" in pattern` 恒 False，会给出大批假阳性
  4171	    # （第一版就这么写的，当场报出 60+ 个"缺失"，其中 1-8 是假的）。
  4172	    pats = [p for p, _ in rs._FALLBACK_DERIVE_ALLOW if "缺来源锚点" in p.pattern or "集中在" in p.pattern]
  4173	    assert len(pats) == 2, f"⑦⑧允许式应恰有两条: {len(pats)}"
  4174	    p7, p8 = pats
  4175	    missing = set()
  4176	    for ch in rs._NUMERAL_LIKE_CHARS:
