  3654	def _one_problem_has(stdout: str, *needles: str) -> bool:
  3655	    """同一条诊断行里同时出现全部 needle。
  3656	
  3657	    ⛔ Codex round-2 的测试批评（属实）：`assert "无法解析" in out` 与
  3658	    `assert "九十八万五" in out` 两条独立 `any`，理论上可由**两条不同的**
  3659	    problem 分别满足 —— 断言没有把「诊断类别」与「完整 token」绑在一起。
  3660	    """
  3661	    return any(all(n in ln for n in needles) for ln in stdout.splitlines())
