  4016	def test_domain_r11_fulltext_gate_and_visible_numerals_cli(tmp_path):
  4017	    """R3 round-9：全文『派生』门先归一 + 可见数字/量词/中文负号的闭表补漏。
  4018	
  4019	    四条实测反例（修前 exit 0）：
  4020	      · `- 派**生**出 987654 个新节点` —— **全文**白名单门仍在**源码行**上判
  4021	        「含派生」；round-8 只把**局部**数字函数改成先归一，这道门漏了 ⇒ 整行
  4022	        既不进局部循环、也绕过全文门（**同一个顺序耦合，修了一处漏了另一处**）；
  4023	      · `本板共有⑤个子节点` —— 带圈数字不在定界集 ⇒ **一个 token 都抽不出**，
  4024	        整句零校验（比尾片重锚更彻底）；
  4025	      · `本板共有987654例记录` —— `例` 不在量词表 ⇒ 整句零校验；
  4026	      · `本板共有负五个子节点` —— 符号守卫只认五个西文符号，漏中文「负」。
  4027	
  4028	    **它证明什么**：两道 fallback 门（全文/局部）**同口径**先归一；可见数字与
  4029	    常用量词进表后对应形态被拦；中文负号与西文负号同等对待。
  4030	    **它不证明什么**：三张表**仍是封闭表**——本轮补的是"已知可见形态"，不是全集。
  4031	    Unicode 里还有大量可渲染成数字的字符未纳入，见 §五之三。
  4032	    """
  4033	    rs = _load_recap_scan()
  4034	    assert rs._count_token_value("⑤") is None, "带圈数字应进定界面但**不赋值**"
