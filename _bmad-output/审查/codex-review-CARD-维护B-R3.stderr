  4481	def test_domain_r17_freeze_v2_bounded_highs_cli(tmp_path):
  4482	    """R3 round-20（冻结审查 v2 的五组有界 HIGH）：六条实测反例 + 一处被推翻的判断。
  4483	
  4484	    修前实测放行：
  4485	      · 区间首端**无整数部分**的小数 —— `.2~3个` / `．二~三个` / `点二~三个`
  4486	        （守卫原先要求小数点前必须有数词样字符）；
  4487	      · code span 里的**可见区间**与 **NBSP** —— `` `999~999个` `` / `` `999 个` ``
  4488	        （NBSP）：`_D2_COUNTISH_EXTRA` 与区间主表分叉、空白域只列了空格与 tab，
  4489	        于是整段被当字段值挖空，区间门与数字门**都不可达**；
  4490	      · 五元组**双行逃逸** —— 保留一条正确五元组，再加一条渲染等价但源码不命中的
  4491	        冲突行（`999 成**员**（…）` / `999 成<b>员</b>（…）`），后者既不计入
  4492	        「恰好一处」也不被逐条校验。
  4493	
  4494	    ⛔ 最后一条推翻了我上一轮「三处 raw 绑定实测不成立」的判断：我当时只测了
  4495	    「改坏那条唯一正确行」（形状一坏就 fail-closed），**没把「留一条好的 + 加一条
  4496	    冲突的」这个已经在 ③段信号行上验证过的形态迁移过来**。
  4497	
  4498	    **它证明什么**：区间首端守卫覆盖无整数部分的小数；code span 的字符域与区间
  4499	    主表同源、空白按 `str.isspace()` 判；五元组逐行归一后匹配。
  4500	    **它不证明什么**：`_visible_text` 仍不是完整 renderer；台账种子行与 tips
  4501	    的同型双行攻击我**未能复现**（不等于安全，如实登记）。
  4502	    """
  4503	    rs = _load_recap_scan()
  4504	    vault = standard_vault(tmp_path)
  4505	    scan = collect_json(vault)
  4506	    pool = rs._derived_number_pool(scan)
  4507	    assert {2, 3} <= pool and 999 not in pool, f"前提：2/3 在池、999 不在池: {sorted(pool)[:8]}"
  4508	
  4509	    report = write_report(vault, scan)
  4510	    base = report.read_text(encoding="utf-8")
  4511	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4512	
  4513	    def verify(text: str):
  4514	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4515	        report.write_text(text, encoding="utf-8")
  4516	        return run_verify(report)
  4517	
  4518	    def in3(line: str):
  4519	        return verify(base.replace("## 三维审查", f"## 三维审查\n\n{line}", 1))
  4520	
  4521	    # ① 区间首端：无整数部分的小数（三种写法）
  4522	    for line, why in (
  4523	        ("- 本板共有.2~3个子节点。【实测】", "半角小数点开头"),
  4524	        ("- 本板共有．二~三个子节点。【实测】", "全角小数点 + 中文数词"),
