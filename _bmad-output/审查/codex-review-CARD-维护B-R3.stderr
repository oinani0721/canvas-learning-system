  3585	        report.write_text(text, encoding="utf-8")
  3586	        return run_verify(report)
  3587	
  3588	    def d2(line: str):
  3589	        return verify("## 三维审查", f"## 三维审查\n\n{line}")
  3590	
  3591	    def fb(tok: str):
  3592	        return verify("方向叙述：", f"\n#### 派生子女 {tok} 个 的说明\n\n方向叙述：")
  3593	
  3594	    # 区间：大数在左（本轮新反例）与在右（既有方向）都必须被点名
  3595	    for name, line in (
  3596	        ("大数在左", "- 本板共有987654-0个子节点。【实测】"),
  3597	        ("大数在右", "- 本板共有0-987654个子节点。【实测】"),
