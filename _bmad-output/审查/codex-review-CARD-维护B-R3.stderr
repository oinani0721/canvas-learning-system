   310	def test_zero_threshold_no_judgement_keys(tmp_path):
   311	    """(b) 0 阈值: signals 块任何层级不得出现判定/合格线类键名。"""
   312	    sig = collect_json(standard_vault(tmp_path))["signals"]
   313	    # 注意避免误伤: source_coverage 含子串 over → 只列判定语义明确的词根
   314	    banned = (
   315	        "threshold",
   316	        "exceed",
   317	        "warn",
   318	        "verdict",
   319	        "judg",
   320	        "grade",
   321	        "breach",
   322	        "violat",
   323	    )
   324	
   325	    def walk(obj, path=""):
   326	        if isinstance(obj, dict):
   327	            for k, v in obj.items():
   328	                if k != "policy":  # policy 值声明 zero_threshold, 键名本身中性
   329	                    assert not any(b in k.lower() for b in banned), f"判定类键: {path}.{k}"
   330	                walk(v, f"{path}.{k}")
   331	        elif isinstance(obj, list):
   332	            for i, v in enumerate(obj):
   333	                walk(v, f"{path}[{i}]")
   334	
   335	    walk(sig)
