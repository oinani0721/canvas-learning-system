   662	    fresh = (
   663	        "**⚠ FALLBACK：manifest 不可用（未提供 --manifest），本报告基于本地只读扫描，role/掌握度均为推定**\n"
   664	        if fallback
   665	        else ""
   666	    )
   667	    recon_tail = (
   668	        "- 待定纠错候选 0 条 · 孤儿/双源差集/检验历史：无据（fallback）"
   669	        if fallback
   670	        else "- 待定纠错候选 0 条 · 孤儿 0 · 双源差集 无 · 检验历史 0 板"
   671	    )
   672	    # ⛔ 维护卡 B: 这里原本**硬编码** `- SeedA — 批注 2 条`，不随 scan 变——
   673	    # 在 standard_vault 下恰好等于真值所以一直没露馅，在空 tips 板上就是一条
   674	    # 「形状合法、数字无据」的行。新增的种子行绑值门第一次跑就把它抓了出来
   675	    # （这正是本卡要的效果：形状对不等于数字有据）。改为按 scan 的 ledger 渲染。
   676	    ledger_seed = "\n".join(
   677	        f"- {r['node_id']} — " + (f"批注 {r['tips_count']} 条" if r.get("tips_count") else "无批注")
   678	        for r in (scan.get("ledger") or {}).get("seeds", [])
   679	    )
   680	    ledger_derived = "- DerivedB — 占位 · mastery 未记录 · tips 未闭环 2 条\n- DerivedC — 已剖析 · mastery 未记录"
   681	    return f"""---
   682	type: recap
