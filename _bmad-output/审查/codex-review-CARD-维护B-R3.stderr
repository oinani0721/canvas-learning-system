  2233	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  2234	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  2235	
  2236	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  2237	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  2238	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  2239	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  2240	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  2241	    """
  2242	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  2243	    if not mb:
  2244	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  2245	        return
  2246	    board_id = mb.group(1).strip()
  2247	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  2248	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名
  2249	    # 形如 `回顾-<board>-<date>.md`, 与 frontmatter board 必须一致。
  2250	    mname = re.match(r"^回顾-(.+)-(\d{4}-\d{2}-\d{2})\.md$", report_path.name)
  2251	    if not mname:
  2252	        problems.append(f"报告文件名不符 `回顾-<板>-<日期>.md`: {report_path.name}")
  2253	    elif mname.group(1) != board_id:
  2254	        problems.append(
  2255	            f"数字终核: frontmatter board={board_id!r} 与文件名的板 "
  2256	            f"{mname.group(1)!r} 不一致 (不得绑定另一块板的 scan JSON)"
  2257	        )
  2258	    scan_path = report_path.parent / f".recap-scan-{board_id}.json"
  2259	    try:
  2260	        scan = json.loads(scan_path.read_text(encoding="utf-8"))
  2261	    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
  2262	        problems.append(
  2263	            f"数字终核 fail-closed: scan JSON 缺失或损坏 ({scan_path.name})"
  2264	        )
  2265	        return

