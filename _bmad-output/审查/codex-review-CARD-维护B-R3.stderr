  4155	def test_domain_r12_no_silent_table_copies():
  4156	    """R3 round-11：闭表副本要么派生，要么可检测。
  4157	
  4158	    **它证明什么**：① inline-code 的量词守卫确实从 `_D2_QUANT` 派生（给主表加字，
  4159	    守卫自动跟上，`` `例` `` 不再被当普通 code span 挖空）；② ⑦⑧允许式的数词禁集
  4160	    覆盖定界集全集，任一方漂移都会被这道门抓住。
  4161	    **它不证明什么**：⑦⑧ 的副本**仍然存在**（只是不能再静默分叉）；
  4162	    三张主表本身**仍是封闭表**，本门不宣称覆盖表外形态。
  4163	    """
  4164	    rs = _load_recap_scan()
  4165	    quant = set(rs._D2_QUANT.strip("[]"))
  4166	
  4167	    # ① inline-code 守卫必须与主量词表同步（派生 ⇒ 逐字覆盖）
  4168	    for ch in sorted(quant):
  4169	        assert rs._codespan_is_visible_count(ch), (
  4170	            f"量词 {ch!r} 单独写成 code span 时被挖空 ⇒ 前面的数字失去锚点；inline-code 守卫与 _D2_QUANT 已分叉"
  4171	        )
  4172	    # ⛔ round-14（冻结审查）：数字部分原先仍手写 `[0-9]+` ——「副本已消除」只对了
  4173	    # 一半，于是 `` `九十八万个` ``/`` `987654 个` `` 这类**完整可见计数**写进
  4174	    # code span 会被整体挖空、整域免检。现数字部分也派生自定界集。
  4175	    for span in ("987654 个", "九十八万个", "987654", "廿五个"):
  4176	        assert rs._codespan_is_visible_count(span), f"纯计数 code span `{span}` 被当字段值挖空 ⇒ 可见计数整域免检"
  4177	    # ⛔ round-17（冻结审查 §一.2）：判据从 raw 正则前瞻改为**先归一再判**的函数，
  4178	    # 符号/小数点/千分位/全角数字不再让守卫失效。
  4179	    for span in ("-5", "5.5个", "1,005个", "５５个"):
  4180	        assert rs._codespan_is_visible_count(span), f"可见计数 `{span}` 仍被当字段值挖空"
  4181	    for span in ("-", ".", " "):
  4182	        assert not rs._codespan_is_visible_count(span), f"纯符号 `{span}` 不该算计数（白丢 E2 豁免）"
  4183	    # 可见计数 span **只挖反引号**：反引号不在连接集里，原样留下会让量词锚失效。
  4184	    assert rs._D2_CODE_SPAN_RE.sub(rs._blank_inline_code, "共有`-5`个") == "共有 -5 个"
  4185	    # 字段值 span 整段挖空，且**等长**（行内偏移不能乱）——期望值算出来，不手数空格
  4186	    assert (
  4187	        rs._D2_CODE_SPAN_RE.sub(rs._blank_inline_code, "项 `mastery` 已改") == "项 " + " " * len("`mastery`") + " 已改"
  4188	    )
  4189	    # 负号集必须是**单一常量**（原先 D2/fallback 手抄两次）
  4190	    assert hasattr(rs, "_NEG_SIGN"), "负号集应提为单一常量，避免第三处副本"
  4191	    # ⛔ round-15（冻结审查）：全文零宽门原先**手抄**一份只到 U+2064 的集合，
  4192	    # 而 `_INVISIBLE_ONE` 覆盖到 U+2069 ⇒ bidi isolate U+2065-2069 能过全局门。
  4193	    # 又一处「同一原则两处定义」。现两处共用同一常量 —— 逐字符验证一致性。
  4194	    import re as _re
  4195	
  4196	    _inv = _re.compile(rs._INVISIBLE_ONE)
  4197	    # 全文零宽门与归一集必须是**同一个**集合：逐字符比对两者判定。
  4198	    _globals_src = pathlib.Path(rs.__file__).read_text(encoding="utf-8")
  4199	    assert "if re.search(_INVISIBLE_ONE, text):" in _globals_src, (
  4200	        "全文零宽门未共用 _INVISIBLE_ONE —— 手抄副本会与归一集分叉"
  4201	    )
  4202	    for _cp in (0x2065, 0x2066, 0x2067, 0x2068, 0x2069):
  4203	        assert _inv.match(chr(_cp)), f"U+{_cp:04X} (bidi isolate) 不在不可见集内 —— 它能切断数串却过全局门"
  4204	    # 反面：非量词的 code span 仍应被挖空（否则豁免整个失效）
  4205	    assert not rs._codespan_is_visible_count("abc"), "普通 code span 应仍被豁免（字段值）"
  4206	
  4207	    # ② ⑦⑧允许式的手抄数词禁集必须覆盖定界集全集（漂移即被抓）
  4208	    # ⚠️ 必须**按行为**检测，不能拿字符去子串匹配 pattern 源码 ——
  4209	    # `0-9` 在字符类里是**区间**，`"1" in pattern` 恒 False，会给出大批假阳性
  4210	    # （第一版就这么写的，当场报出 60+ 个"缺失"，其中 1-8 是假的）。
  4211	    pats = [p for p, _ in rs._FALLBACK_DERIVE_ALLOW if "缺来源锚点" in p.pattern or "集中在" in p.pattern]
  4212	    assert len(pats) == 2, f"⑦⑧允许式应恰有两条: {len(pats)}"
  4213	    p7, p8 = pats
  4214	    missing = set()
  4215	    for ch in rs._NUMERAL_LIKE_CHARS:
  4216	        if p7.match(f"2 个派生角色成员缺来源锚点{ch}。"):
