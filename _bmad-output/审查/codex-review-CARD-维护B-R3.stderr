   745	def run_suite(keyword: str) -> tuple[int, str, int, int, bool]:
   746	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数, 是否崩溃)。
   747	
   748	    ⛔ round-27（冻结审查 v8）：注解与 docstring 原写**四元组**，实际返回五元组
   749	    （`crash` 是 round-10 加的）—— 又一处「说的与做的不符」。
   750	
   751	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   752	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   753	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   754	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   755	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   756	    要求"确实收集到用例"且"确实有失败"才算变红。
   757	    """
   758	    r = subprocess.run(
   759	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   760	        cwd=ROOT / "backend",
   761	        capture_output=True,
   762	        text=True,
   763	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   764	        timeout=600,
   765	    )
   766	    out = r.stdout
   767	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   768	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   769	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   770	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   771	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   772	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   773	    both = _crash_text(out, r.stderr)
   774	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   775	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   776	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   777	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   778	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   779	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   780	    # 的形式混进证据, 且永远不会有人去查。
   781	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   782	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   783	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   784	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   785	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   786	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   787	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   788	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   789	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   790	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   791	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   792	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   793	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   794	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   795	    crash = _looks_like_crash(both)
   796	    return r.returncode, out[-400:], passed + failed, failed, crash
   797	
   798	
   799	MUTANT_COUNT_EXPECTED = 56
   800	"""变体数的**独立**期望值。
   801	
   802	⛔ 冻结审查 v6：脚本原先只在结尾动态打印「共 N 条」—— 误删一个变体仍会成功退出。
   803	期望值必须来自**另一个来源**才能验伪（本卡反复吃过"期望抄自被测物"的亏）。
   804	改这个数 = 明确声明"我知道自己在增删变体"。
   805	"""
   806	
   807	
   808	def preflight() -> list[str]:
   809	    """开跑前的**锚点预检**（秒级）—— 失败即停，不进 40 分钟长流程。
   810	
   811	    ⛔ 「性质一搬家、旧锚点静默失效」在本卡发生了 **6 次**，每次代价固定：
   812	    改实现 → 跑满一轮 → 跑到那一条才报「未命中」→ 重锚 → 再跑一轮。
   813	    **发现成本远高于修复成本，且发现得越晚越贵。**
   814	
   815	    ⚠️ 能力边界（round-25 声明，round-26 按冻结审查 v7 收紧措辞）：
   816	      · 「恰好命中一次」只证明**文本定位唯一**；
   817	      · 「整组替换后源码确实变化」证明**替换非空**（round-26 新增，此前只比
   818	        `old != new`，而成功消息却宣布了"替换非空" —— 措辞比证据宽）；
   819	      · **不**证明该位置**可达**、或确实**禁掉了目标防线**（行为非空）——
   820	        「锚点仍命中但变异已为空」在本卡真实发生过（见 铁律 4 / 铁律 5）。
   821	      · 它是**必要非充分**条件：能挡住**锚点漂移**与**文本级**空变异，
   822	        挡不住**行为级**空变异（改到了活代码，却没禁掉那条防线）。
   823	      ⚠️ 归因edge：`survivor-7` 那次是被 `hits != 1` 抓到的，**不是**被新增的
   824	        「整组替换后源码确实变化」抓到的 —— 我此前把功劳记给了后者，过宽。
   825	    """
   826	    bad: list[str] = []
   827	    if len(MUTANTS) != MUTANT_COUNT_EXPECTED:
   828	        bad.append(f"变体数 {len(MUTANTS)} ≠ 期望 {MUTANT_COUNT_EXPECTED}（增删变体须同步改期望值）")
   829	    ids = [n.split()[0] for n, _s, _k in MUTANTS]
   830	    if len(set(ids)) != len(ids):
   831	        dup = sorted({i for i in ids if ids.count(i) > 1})
   832	        bad.append(f"变体 ID 重复: {dup}")
   833	    src = TARGET.read_text(encoding="utf-8")
   834	    for idx, (name, subs, _kw) in enumerate(MUTANTS):
   835	        sid = ids[idx]
   836	        if not subs:
   837	            bad.append(f"{sid}: subs 为空 = 什么都不改")
   838	            continue
   839	        # ⛔ round-26（冻结审查 v7）：原先逐条只比 `old != new`，成功消息却宣布
   840	        #    「替换非空」—— **措辞比证据宽**。改为**按真实顺序模拟整组替换**，
   841	        #    要求最终源码确实变化：这才配得上那句话。
   842	        mutated = src
   843	        for old, new in subs:
   844	            hits = mutated.count(old)
   845	            if hits != 1:
   846	                bad.append(f"{sid}: 锚点命中 {hits} 次（须恰好 1）")
   847	                mutated = None
   848	                break
   849	            mutated = mutated.replace(old, new, 1)
   850	        if mutated is not None and mutated == src:
   851	            bad.append(f"{sid}: 整组替换后源码与原文逐字节相同 = 空变异")
   852	    return bad
   853	
   854	
   855	def main() -> int:
   856	    try:
   857	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   858	    except FileExistsError:
   859	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   860	        return 2
   861	    try:
   862	        _bad = preflight()
   863	        if _bad:
   864	            print("⛔ 锚点预检失败（不跑长流程）：")
   865	            for _b in _bad:
   866	                print("   -", _b)
   867	            return 2
   868	        print(
   869	            f"✅ 锚点预检通过：{len(MUTANTS)} 条变体 —— 锚点均恰好命中一次，"
   870	            "整组替换后源码确实变化（**不**证明该处可达或真禁掉了目标防线）\n"
   871	        )
   872	        original = TARGET.read_bytes()
   873	        backup_sha = hashlib.sha256(original).hexdigest()
   874	
   875	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   876	        if rc0 != 0 or f0 or n0 == 0:
   877	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   878	            return 2
   879	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   880	
   881	        failures = 0
   882	        for name, subs, keyword in MUTANTS:
   883	            text = original.decode("utf-8")
   884	            for old, new in subs:
   885	                if old not in text:
   886	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   887	                    failures += 1
   888	                    text = None
   889	                    break
   890	                text = text.replace(old, new, 1)
   891	            if text is None:
   892	                continue
   893	            # ⛔ R3 round-23（冻结审查 v4）：写入原先在 `try` **之前** —— 写到一半抛异常
   894	            #    （磁盘满 / 权限 / 编码）就落不进 finally，变异体留在生产文件里。
   895	            #    把写入挪进 try：从"文件可能已被改动"的第一刻起就有还原兜底。
   896	            #    ⚠️ 如实声明**兜底不到**的情况：SIGKILL / 解释器崩溃 / 断电 ——
   897	            #    Python 层的 finally 对它们无能为力，前后 hash 自检也覆盖不了
   898	            #    （进程都没了）。真正的根治是"改副本不改原件"，属重做设计，未做。
   899	            #    残留检测靠外部锚点：见 MEMORY `reference_mutation_restore_must_be_unconditional`
   900	            #    （grep MUTANT + sha 对比），本脚本自身证明不了这件事。
   901	            try:
   902	                TARGET.write_text(text, encoding="utf-8")
   903	                rc, out, n, f, crash = run_suite(keyword)
   904	            finally:
   905	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   906	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   907	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   908	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   909	            if n == 0:
   910	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   911	                failures += 1
   912	            elif rc != 1:
   913	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   914	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   915	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   916	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   917	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   918	                failures += 1
   919	            elif crash:
   920	                print(
   921	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   922	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   923	                )
   924	                failures += 1
   925	            elif f == 0:
