  4997	def test_domain_r24_fence_closer_atx_and_tail_prefix():
  4998	    """R3 round-28（冻结审查 v9）：顶层围栏闭合 / ATX 缩进与闭合序列 / 尾巴前缀。
  4999	
  5000	    审查方给的反例与我的处置：
  5001	      · **顶层**围栏内的 `- ``` ` 被当成闭栏、下一行重新开栏 ⇒ 用户可见正文被剥到
  5002	        EOF。CommonMark 里闭栏必须在**同一容器**内。⇒ 判闭栏时引用前缀恒剥，
  5003	        **列表 marker 只在开栏本身就在列表项内时才剥**。
  5004	        ⚠️ 第一版我不分容器一律禁列表 marker，当场打红 `strip_code_blocks` 单元
  5005	        契约门（列表项内围栏本来就由下一个 `- ``` ` 闭合）；
  5006	      · round-27 的 `(?<![\u4e00-\u9fff])批注` 排除了**所有**汉字前缀 ⇒
  5007	        `累计/共/已批注 999 条` 全部放过。⇒ 只排除**否定前缀**「未」；
  5008	      · ATX 标题的合法 0-3 格缩进不识别；`### 种子###`（闭合井号前无空白）误认；
  5009	      · `seeds` 缺失/非 list 时**静默回落**到摊平全部角色 —— 那正是本轮要堵的洞。
  5010	
  5011	    **它证明什么**：八种形态的行为（含三种前缀、两种标题、fail-closed、小节内围栏）。
  5012	    **它不证明什么**：**列表 continuation 未建模**（`- item` 之后的相对内容列），
  5013	    审查方判为需重做设计；`_strip_code_blocks` 的行数前提准确表述是
  5014	    **索引映射保持、尾项由越界兜底补偿**（末尾空项会丢），不是无条件行数恒等。
  5015	    """
  5016	    rs = _load_recap_scan()
  5017	
  5018	    # 顶层围栏内的列表 marker 行不是闭栏 ⇒ 其后的可见正文必须留下
  5019	    assert "本板共有987654个子节点" in rs._strip_code_blocks("```\n- ```\n```\n本板共有987654个子节点"), (
  5020	        "顶层围栏内的 `- ```` 被误当闭栏，可见正文被剥到 EOF"
  5021	    )
  5022	    # 列表项内围栏仍由下一个 `- ```` 闭合（round-2 固化形态，不得回归）
  5023	    assert rs._strip_code_blocks("- ```\n  x：无据\n- ```").strip() == "", "列表项内围栏未整块剥空"
  5024	
  5025	    SEEDS = {
  5026	        "ledger": {
  5027	            "seeds": [{"node_id": "SeedA", "tips_count": 2}],
  5028	            "derived": [{"node_id": "DerivedX", "tips_count": 5}],
  5029	        }
  5030	    }
  5031	
  5032	    def run(text: str, scan=None) -> list[str]:
  5033	        ps: list[str] = []
  5034	        rs._verify_seed_ledger_counts(text, scan or SEEDS, ps)
  5035	        return ps
  5036	
  5037	    def L(row: str) -> str:
  5038	        return f"## 台账\n\n### 种子\n\n{row}\n\n## 末\n"
  5039	
  5040	    for text, want, why, scan in (
  5041	        (L("- SeedA — 批注 2 条（累计批注 999 条）"), "尾巴里又出现", "尾巴 `累计批注`", None),
  5042	        (L("- SeedA — 批注 2 条（共批注 999 条）"), "尾巴里又出现", "尾巴 `共批注`", None),
  5043	        (L("- SeedA — 批注 2 条（已批注 999 条）"), "尾巴里又出现", "尾巴 `已批注`", None),
  5044	        (L("- SeedA — 批注 2 条（未批注 999 条）"), None, "反向：`未批注` 不得误伤", None),
  5045	        # ⛔ round-29：同上 —— `_SECTION_RE` 不接受前导缩进，两侧一致地不接受。
  5046	        (
  5047	            "   ## 台账\n\n   ### 种子\n\n- SeedA — 批注 999 条\n\n## 末\n",
  5048	            None,
  5049	            "缩进 ATX 标题与全局口径一致地不接受（整体由必需段门 fail-closed）",
  5050	            None,
  5051	        ),
  5052	        # ⛔ round-30：同上，H3 不合口径不再静默跳过。
  5053	        (
  5054	            "## 台账\n\n### 种子###\n\n- SeedA — 批注 999 条\n\n## 末\n",
  5055	            "找不到可绑定",
  5056	            "`### 种子###` 不合口径 ⇒ fail-closed（H3 无全局门兜底）",
  5057	            None,
  5058	        ),
  5059	        (
  5060	            L("- DerivedX — 批注 5 条"),
  5061	            "缺少可用的 seeds",
  5062	            "分组 ledger 缺 seeds ⇒ fail-closed，不回落到其它角色",
  5063	            {"ledger": {"derived": [{"node_id": "DerivedX", "tips_count": 5}]}},
  5064	        ),
  5065	        (
  5066	            "## 台账\n\n### 种子\n\n- SeedA — 批注 2 条\n\n```\n- SeedA — 批注 999 条\n```\n\n## 末\n",
  5067	            None,
  5068	            "小节内围栏中的字面行不得被当台账行",
  5069	            None,
  5070	        ),
  5071	    ):
  5072	        ps = run(text, scan)
  5073	        if want is None:
  5074	            assert ps == [], f"{why}：误伤 —— {ps!r}"
  5075	        else:
  5076	            assert ps, f"{why}：应报错却放行"
  5077	            assert any(want in p for p in ps), f"{why}：诊断未含 {want!r} —— {ps!r}"
