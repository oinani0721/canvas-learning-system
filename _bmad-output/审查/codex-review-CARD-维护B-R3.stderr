  1626	def _visible_text(line: str) -> str:
  1627	    """源码行 → **读者在 Obsidian 里看到的文本**（本域收敛器，非完整渲染器）。
  1628	
  1629	    顺序有讲究（每一步都对应前几轮的一条实测 HIGH）：
  1630	      1. **先解 HTML 实体**再做全角转换 —— 反过来会让 `&#xff19;` 解出 `９`
  1631	         之后再没有机会转成 ASCII（round-5 HIGH-3 实测）;
  1632	      2. 剥 HTML 标签 —— `<b>` 长度不限, 原先只有 ≤22 字符的短标签算连接字符;
  1633	      3. wikilink 取**显示文本** —— 有别名取别名, 无别名取目标本身
  1634	         （原实现把无别名链接的目标挖空, 而那正是读者看到的字, round-5 HIGH-8）;
  1635	      4. 去零宽/双向控制字符;
  1636	      5. 去强调标记 `*_~` —— 未配对时渲染可见, 这里一并去掉是**安全向**的过度
  1637	         归一（查到的值 ⊇ 读者看到的数, 不构成虚构通道）。
  1638	
  1639	    ⚠️ **不碰 inline code**: `` `…` `` 的内容在本域是**有意豁免**的字段值
  1640	    （E2, 见 _D2_INLINE_CODE_RE），不是"被隐藏的计数"。这是**声明过的设计选择**,
  1641	    不是遗漏 —— 如实登记在验收单, 不在这里悄悄改语义。
  1642	    """
  1643	    line = html.unescape(line)
  1644	    line = line.translate(_FULLWIDTH_DIGITS)
  1645	    line = _VIS_TAG_RE.sub("", line)
  1646	    line = _VIS_WIKILINK_ALIAS_RE.sub(r"\1", line)
  1647	    line = _VIS_WIKILINK_PLAIN_RE.sub(r"\1", line)
  1648	    line = _VIS_MDLINK_RE.sub(r"\1", line)
  1649	    line = _VIS_INVISIBLE_RE.sub("", line)
  1650	    line = _VIS_STRIKE_RE.sub("", line)
  1651	    return _VIS_EMPHASIS_RE.sub("", line)
  1652	
  1653	
  1654	def _normalize_number_seps(line: str) -> str:
  1655	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1656	
  1657	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1658	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1659	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1660	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1661	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1662	    """
  1663	    # ⛔ R3 round-6: 解 HTML 实体已上移到 _visible_text() —— 两个消费点都在最前面
  1664	    # 跑它, 此处再解一次是**冗余**（且 `&amp;#46;` 会被双重解码成 `.`, 反而错）。
  1665	    # 一个性质只应有一个实现位置; 留在这里就是死代码。
  1666	    # ⛔ R3 round-5 (Codex round-4 HIGH-3): 逗号两侧也可能夹连接字符 ——
  1667	    # `987654<b>,</b>000个` 渲染成 `987654,000个`, 原式(要求逗号紧邻数字)不命中。
  1668	    return re.sub(
  1669	        rf"([0-9]){_D2_JOIN_ONE}*[,，'’]{_D2_JOIN_ONE}*(?=[0-9]{{3}}(?![0-9]))",
  1670	        r"\1",
  1671	        line,
  1672	    )
