  2077	    #    留一条正确的种子行、再加一条**渲染等价但源码不命中**的冲突行
  2078	    #    （`- SeedA — 批**注** 999 条` / `批<b>注</b>`），后者匹配不上就静默
  2079	    #    continue，绑定被跳过。**fallback 模式**下有形状门兜底（这正是我上一轮
  2080	    #    『未复现』的原因），但 **manifest 模式没有那层门** —— 两条实测 exit 0。
  2081	    #    与③段信号行、五元组的双行逃逸完全同型，第三次。
  2082	    # ⛔ R3 round-25（冻结审查 v6）：round-24 用**两次独立 re.search** 分别在 raw
  2083	    #    与 visible 上取段，再按下标配对 —— 未验证两边选中的是**同一小节**；且
  2084	    #    `_visible_block` 的拼接依赖「行数不变」这个当时**并不成立**的不变式
  2085	    #    （`&#10;` 解出换行）。另外只处理**首个** `### 种子`，一个正确的诱饵小节
  2086	    #    就能遮住后面的冲突小节。
  2087	    #    ⇒ 改为：**一次切行**，raw 与 visible 是同一份 list 的逐行映射（下标即同源
  2088	    #      行，不可能错配）；小节按 visible 标题识别（兼容被排版切开的标题）并
  2089	    #      **逐个**处理，不再只取第一个。
  2090	    raw_lines = text.splitlines()
  2091	    vis_lines = [_visible_text(_ln) for _ln in raw_lines]
  2092	    sections: list[tuple[int, int]] = []
  2093	    _i = 0
  2094	    while _i < len(vis_lines):
  2095	        if re.match(r"^###\s*种子\s*$", vis_lines[_i]):
  2096	            _j = _i + 1
  2097	            while _j < len(vis_lines) and not re.match(r"^#{2,3}\s", vis_lines[_j]):
  2098	                _j += 1
  2099	            sections.append((_i + 1, _j))
  2100	            _i = _j
  2101	        else:
  2102	            _i += 1
  2103	    if not sections:
  2104	        return
  2105	    groups = scan.get("ledger")
  2106	    rows: list[dict] = []
  2107	    if isinstance(groups, dict):
  2108	        for grp in groups.values():
  2109	            if isinstance(grp, list):
  2110	                rows.extend(x for x in grp if isinstance(x, dict))
  2111	    elif isinstance(groups, list):
  2112	        rows = [x for x in groups if isinstance(x, dict)]
  2113	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  2114	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  2115	        return
  2116	    tips_by_node = {str(r.get("node_id")): r.get("tips_count") for r in rows}
  2117	    # 归一空间的候选索引：只在 raw 行解析不出时才用（round-25）
  2118	    vis_index: dict[str, list[str]] = {}
  2119	    for _raw_id in tips_by_node:
  2120	        vis_index.setdefault(_visible_text(_raw_id), []).append(_raw_id)
