   569	def _looks_like_crash(out: str) -> bool:
   570	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   571	
   572	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   573	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   574	    """
   575	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   576	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   577	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   578	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   579	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   580	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   581	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   582	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   583	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   584	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   585	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   586	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   587	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   588	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   589	    LEGIT_RED = {"assert", "AssertionError"}
