  1847	        for i, h in enumerate(heads):
  1848	            end = heads[i + 1].start() if i + 1 < len(heads) else len(text)
  1849	            parts.append((h.group(0).lstrip("# ").strip(), text[h.end() : end]))
  1850	    else:
  1851	        parts.append(("（全文）", text))
  1852	    for sec, body in parts:
  1853	        # ⛔ 出域判定必须**前缀锚定**, 不能用子串 `ex in sec`:
  1854	        # 子串匹配下 `## 附录（数据来源与新鲜度）` 也算出域 —— 把豁免段名塞进任意标题
  1855	        # 的非开头位置就能整段免检, 而报告别处的重复段检查是前缀锚定的, 两者错位。
