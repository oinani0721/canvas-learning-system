  1709	# 是从符号/小数点之后**重新起锚**的碎片, 不是一个完整的数 (round-17)。
  1710	_RANGE_LEFT_BAD_RE = re.compile(
  1711	    rf"(?:{_NEG_SIGN}|[{_NUMERAL_LIKE_CHARS}]{_D2_JOIN_ONE}*[.．点]){_D2_JOIN_ONE}*$"
  1712	)
  1713	_VIS_STRIKE_RE = re.compile(r"~~")
  1714	_VIS_EMPHASIS_RE = re.compile(r"[*_]")
