  1482	def _load_recap_scan():
  1483	    """按被测脚本自身的零写侧约定导入它（不落 __pycache__）。"""
  1484	    import importlib.util
  1485	
  1486	    if not SCRIPT.exists():
  1487	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
  1488	    prev = sys.dont_write_bytecode
  1489	    sys.dont_write_bytecode = True
  1490	    try:
  1491	        spec = importlib.util.spec_from_file_location("recap_scan_ut", SCRIPT)
  1492	        mod = importlib.util.module_from_spec(spec)
  1493	        spec.loader.exec_module(mod)
  1494	    finally:
  1495	        sys.dont_write_bytecode = prev
  1496	    return mod
