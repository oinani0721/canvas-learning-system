  4253	        ("1 failed, 260 passed", False, "纯失败摘要"),
  4254	        ("E       re.error: invalid group reference", True, "round-10 原案"),
  4255	        ("E       ValueError: too many values", True, "旧版枚举之外 ⇒ 假阴"),
  4256	        ("E       KeyError: 3", True, "旧版枚举之外 ⇒ 假阴"),
  4257	        (
