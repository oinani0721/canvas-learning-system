  2169	                    "(台账不得列出未扫描到的节点)"
  2170	                )
  2171	                continue
  2172	            key = cands[0]
  2173	            want = tips_by_node[key]
  2174	            got = 0 if ms.group("none") else int(ms.group("n"))
  2175	            if got != want:
  2176	                problems.append(
  2177	                    f"数字终核: 台账『种子』行 {key} 报批注 {got} 条, "
  2178	                    f"scan JSON 的 tips_count 是 {want} (形状对不等于数字有据)"
  2179	                )
