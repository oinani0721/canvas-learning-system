  1585	def _scan_number_pool(obj, pool: set[int]) -> None:
  1586	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1587	
  1588	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1589	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1590	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1591	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1592	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1593	    """
  1594	    if isinstance(obj, bool):
  1595	        return
  1596	    if isinstance(obj, int):
  1597	        pool.add(obj)
  1598	    elif isinstance(obj, float):
  1599	        if obj.is_integer():
  1600	            pool.add(int(obj))
  1601	    elif isinstance(obj, dict):
  1602	        for v in obj.values():
  1603	            _scan_number_pool(v, pool)
  1604	    elif isinstance(obj, list):
  1605	        for v in obj:
  1606	            _scan_number_pool(v, pool)
