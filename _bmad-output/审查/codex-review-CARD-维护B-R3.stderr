   658	    try:
   659	        original = TARGET.read_bytes()
   660	        backup_sha = hashlib.sha256(original).hexdigest()
   661	
   662	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   663	        if rc0 != 0 or f0 or n0 == 0:
   664	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   665	            return 2
   666	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   667	
   668	        failures = 0
   669	        for name, subs, keyword in MUTANTS:
   670	            text = original.decode("utf-8")
   671	            for old, new in subs:
   672	                if old not in text:
   673	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   674	                    failures += 1
   675	                    text = None
   676	                    break
   677	                text = text.replace(old, new, 1)
   678	            if text is None:
   679	                continue
   680	            TARGET.write_text(text, encoding="utf-8")
   681	            try:
   682	                rc, out, n, f, crash = run_suite(keyword)
   683	            finally:
   684	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   685	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   686	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   687	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   688	            if n == 0:
   689	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   690	                failures += 1
   691	            elif rc != 1:
   692	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   693	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   694	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   695	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   696	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   697	                failures += 1
   698	            elif crash:
   699	                print(
   700	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   701	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   702	                )
