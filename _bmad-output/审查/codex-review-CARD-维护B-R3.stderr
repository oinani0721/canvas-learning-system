   831	def preflight() -> list[str]:
   832	    """开跑前的**锚点预检**（秒级）—— 失败即停，不进 40 分钟长流程。
   833	
   834	    ⛔ 「性质一搬家、旧锚点静默失效」在本卡发生了 **6 次**，每次代价固定：
   835	    改实现 → 跑满一轮 → 跑到那一条才报「未命中」→ 重锚 → 再跑一轮。
   836	    **发现成本远高于修复成本，且发现得越晚越贵。**
   837	
   838	    ⚠️ 能力边界（round-25 声明，round-26 按冻结审查 v7 收紧措辞）：
   839	      · 「恰好命中一次」只证明**文本定位唯一**；
   840	      · 「整组替换后源码确实变化」证明**替换非空**（round-26 新增，此前只比
   841	        `old != new`，而成功消息却宣布了"替换非空" —— 措辞比证据宽）；
   842	      · **不**证明该位置**可达**、或确实**禁掉了目标防线**（行为非空）——
   843	        「锚点仍命中但变异已为空」在本卡真实发生过（见 铁律 4 / 铁律 5）。
   844	      · 它是**必要非充分**条件：能挡住**锚点漂移**与**文本级**空变异，
   845	        挡不住**行为级**空变异（改到了活代码，却没禁掉那条防线）。
   846	      ⚠️ 归因edge：`survivor-7` 那次是被 `hits != 1` 抓到的，**不是**被新增的
   847	        「整组替换后源码确实变化」抓到的 —— 我此前把功劳记给了后者，过宽。
   848	    """
   849	    bad: list[str] = []
   850	    if len(MUTANTS) != MUTANT_COUNT_EXPECTED:
   851	        bad.append(f"变体数 {len(MUTANTS)} ≠ 期望 {MUTANT_COUNT_EXPECTED}（增删变体须同步改期望值）")
   852	    ids = [n.split()[0] for n, _s, _k in MUTANTS]
   853	    if len(set(ids)) != len(ids):
   854	        dup = sorted({i for i in ids if ids.count(i) > 1})
   855	        bad.append(f"变体 ID 重复: {dup}")
   856	    src = TARGET.read_text(encoding="utf-8")
   857	    for idx, (name, subs, _kw) in enumerate(MUTANTS):
   858	        sid = ids[idx]
   859	        if not subs:
   860	            bad.append(f"{sid}: subs 为空 = 什么都不改")

