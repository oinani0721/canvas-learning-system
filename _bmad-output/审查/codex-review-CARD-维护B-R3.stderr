  1819	def _count_token_value(token: str) -> int | None:
  1820	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1821	
  1822	    只两种情形给值:
  1823	      · 全 ASCII 数字 —— `int()` 本就按十进制解析 (前导零无害);
  1824	      · 表内**单字**中文数词 —— 值 = 映射, 绝对确定 (见 _cjk_single_to_int)。
  1825	    其余 (多字中文数词 / 混写 / 含表外数词字) 一律 None, 调用方 fail-closed。
  1826	    """
  1827	    if not token:
  1828	        return None
  1829	    if token.isascii() and token.isdigit():
  1830	        return int(token)
  1831	    return _cjk_single_to_int(token)
