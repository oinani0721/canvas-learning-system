  3508	        )
  3509	        assert "找不到同值来源" not in r.stdout, f"{tok}: 仍按局部值查池:\n{r.stdout}"
  3510	    r = _mutate_report(tmp_path / "d2-五", prose_case("五"))
  3511	    assert r.returncode == 0, f"值在池的单字自陈被误伤:\n{r.stdout}"
