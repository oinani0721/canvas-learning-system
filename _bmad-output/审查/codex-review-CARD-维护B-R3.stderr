   290	def test_v1_keys_regression_and_signals_shape(tmp_path):
   291	    scan = collect_json(standard_vault(tmp_path))
   292	    assert V1_TOP_KEYS <= set(scan), f"v1 顶层键缺失: {V1_TOP_KEYS - set(scan)}"
   293	    assert set(scan["counts"]) == V1_COUNTS_KEYS, "counts 键面变化 (须加性且本卡未加)"
   294	    assert "signals" in scan, "signals 块缺失"
   295	    sig = scan["signals"]
   296	    assert sig["signals_version"] == 1
   297	    assert sig["policy"] == "zero_threshold"
   298	    assert SIGNAL_KEYS <= set(sig)
   299	    for key in SIGNAL_KEYS:
   300	        missing = SIGNAL_REQUIRED_FIELDS - set(sig[key])
   301	        assert not missing, f"signals.{key} 缺必备字段: {missing}"
   302	        assert sig[key]["asof"] == scan["source_revision"]["scan_at_utc"]
   303	    # ledger 行加性 source_note (fallback 从 frontmatter 抄录并归一 stem)
   304	    rows = {r["node_id"]: r for r in scan["ledger"]["seeds"] + scan["ledger"]["derived"]}
   305	    assert rows["DerivedB"]["source_note"] == "SeedA"  # [[节点/SeedA|别名]] → stem
   306	    assert rows["SeedA"]["source_note"] is None
   307	    assert rows["DerivedC"]["source_note"] is None
