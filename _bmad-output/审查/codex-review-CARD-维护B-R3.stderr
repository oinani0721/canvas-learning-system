  3664	def test_domain_r6_cross_class_and_offtable_numeral_cli(tmp_path):
  3665	    """R3 round-3 行为门：跨类 / 表外数词字 / CJK 小数都不得按尾片查池。
  3666	
  3667	    四条实测反例（修前全部 exit 0）：
  3668	      · `本板共有九十八万5个子节点` —— CJK run 停在 `万`，ASCII 只取 `5`
  3669	      · `本板共有廿五个子节点` —— `廿` 表外，从 `五` 重锚按 5 查池（读者读 25）
  3670	      · `本板共有壹佰个子节点` —— 两字全表外，一个 token 都抽不出
  3671	      · `本板共有五点五个 / 5点5个` —— `点` 在量词表里，被拆成两个 5 分别碰池
  3672	      · fallback `#### 派生子女 1 000 个` —— `\\d+` 拆成碎片逐片碰池
  3673	
  3674	    **它证明什么**：D2 与 fallback、CJK 与 ASCII 走**同一条**取数规则；
  3675	    诊断类别与还原后的完整 token 出现在**同一条** problem 里；
  3676	    合法形态（含 `3点建议` 里 `点` 的正当量词用法）不被反噬。
  3677	    **它不证明什么**：`_NUMERAL_LIKE_CHARS` 仍是**封闭表**（廿卅卌 + 大写金融
  3678	    数字 + 异体），表外的其它数词写法仍可能重锚；量词表同样封闭。见 §五之三。
  3679	    """
  3680	    vault = standard_vault(tmp_path)
  3681	    scan = collect_json(vault)
  3682	    pool = _load_recap_scan()._derived_number_pool(scan)
  3683	    assert {5, 3, 16, 22} <= pool, f"放行面前提失效: {sorted(pool)}"
  3684	    report = write_report(vault, scan)
  3685	    base_text = report.read_text(encoding="utf-8")
  3686	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  3687	
  3688	    def verify(anchor: str, injected: str):
  3689	        text = base_text.replace(anchor, injected, 1)
  3690	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3691	        report.write_text(text, encoding="utf-8")
  3692	        return run_verify(report)
  3693	
  3694	    def d2(line: str):
