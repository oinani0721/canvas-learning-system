  2071	                f"数字终核: AI 侧对账段内出现 {len(in_sec)} 条『{name}』(只许一条)"
  2072	            )
  2073	        for got in all_hits:  # 段外同形句同样绑定, 不留"第二处说法"
  2074	            if int(got) != want_v:
  2075	                problems.append(f"数字终核: {name} {got} ≠ scan JSON {want_v}")
  2076	    _verify_seed_ledger_counts(text, scan, problems)
  2077	    _verify_prose_counts(text, scan, problems)
  2078	    _verify_signals_if_present(text, scan, problems)
  2079	    _verify_fallback_derive_numbers(text, scan, problems)
