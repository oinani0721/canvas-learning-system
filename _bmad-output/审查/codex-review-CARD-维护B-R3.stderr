  4842	def test_domain_r22_fence_indent_and_seed_scope_cli(tmp_path):
  4843	    """R3 round-26（冻结审查 v7）：四空格伪围栏 + 种子小节范围 + 尾巴同名字段。
  4844	
  4845	    三条实测：
  4846	      · **四空格缩进的 ``` 不是围栏**（CommonMark 里那是 indented code block）。
  4847	        原实现先用 `[>\\s]` 吃掉**任意**前导空白，`open_re` 的 ` {0,3}` 形同虚设
  4848	        ⇒ 顶层 `    ```` 被当成开栏，其后读者**看得见**的自陈句整段免检（实测放行）；
  4849	      · round-25 的「逐个处理全部种子小节」**范围超出意图** —— 搜全篇任意
  4850	        `### 种子`，未限定父级 `## 台账`、未排除围栏 ⇒ 附录里的同名小节被强制
  4851	        套台账模板（本轮误伤面，审查方指出）；
  4852	      · 尾巴里再写一个**同名字段**的计数（`批注 N 条`）与已绑定的首数矛盾。
  4853	
  4854	    **它证明什么**：容器前缀（引用/列表）仍被正确剥离，但无 marker 时不动缩进；
  4855	    种子小节只在「台账」H2 之下且不在围栏内才生效；同字段两处计数 fail-closed。
  4856	    **它不证明什么**：尾巴里**其它**字段（`理解度未闭环 N 条`/`已派生 N 点`）
  4857	    在 scan JSON 无逐节点对应字段，**不绑定**，如实登记。
  4858	    """
  4859	    rs = _load_recap_scan()
  4860	    vault = standard_vault(tmp_path)
  4861	    scan = collect_json(vault)
  4862	    report = write_report(vault, scan)
  4863	    base = report.read_text(encoding="utf-8")
  4864	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4865	
  4866	    def in3(block: str):
  4867	        text = base.replace("## 三维审查", f"## 三维审查\n\n{block}", 1)
  4868	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4869	        report.write_text(text, encoding="utf-8")
  4870	        return run_verify(report)
  4871	
  4872	    HIDE = "- 本板共有987654个子节点。【实测】"
  4873	    assert 987654 not in rs._derived_number_pool(scan), "前提：987654 必须在池外"
  4874	
  4875	    # ① 四空格不是围栏 ⇒ 藏在里面的可见计数必须受检
  4876	    r = in3(f"    ```\n{HIDE}\n    ```")
  4877	    assert r.returncode != 0, "四空格伪围栏让可见计数整段免检"
  4878	    assert _one_problem_has(r.stdout, "987654"), f"诊断未指向 987654:\n{r.stdout}"
  4879	
  4880	    # ② 对照：真围栏（0-3 格）与列表项内围栏仍豁免（否则是误伤）
  4881	    for block, why in (
  4882	        (f"```\n{HIDE}\n```", "顶层真围栏"),
  4883	        (f"   ```\n{HIDE}\n   ```", "三格缩进真围栏"),
  4884	        (f"- ```\n  {HIDE}\n- ```", "列表项内围栏（round-2 修过的形态）"),
  4885	    ):
  4886	        assert in3(block).returncode == 0, f"{why}被误判为非围栏"
  4887	
  4888	    # ③ 种子小节范围：`## 台账` 之外的同名小节不得被强制套模板
  4889	    text = base.replace(
  4890	        "## 三维审查",
  4891	        "## 附录\n\n### 种子\n\n这里是自由叙述，不是台账行。\n\n## 三维审查",
  4892	        1,
  4893	    )
  4894	    assert text != base, "注入未命中"
  4895	    report.write_text(text, encoding="utf-8")
  4896	    assert run_verify(report).returncode == 0, "非『台账』下的同名小节被强制套台账模板 —— 范围超出意图"
  4897	
  4898	    # ④ 尾巴里同名字段的第二个数 ⇒ fail-closed（函数级，最小可控）
  4899	    problems: list[str] = []
  4900	    rs._verify_seed_ledger_counts(
  4901	        "## 台账\n\n### 种子\n\n- SeedA — 批注 2 条（批注 999 条）\n\n## 末\n",
  4902	        {"ledger": {"seeds": [{"node_id": "SeedA", "tips_count": 2}]}},
  4903	        problems,
  4904	    )
  4905	    assert any("尾巴里又出现" in p for p in problems), f"同字段两处计数未 fail-closed：{problems!r}"
  4906	    # 反面：真实报告的尾巴（其它字段）不得误伤
  4907	    problems2: list[str] = []
  4908	    rs._verify_seed_ledger_counts(
  4909	        "## 台账\n\n### 种子\n\n- SeedA — 批注 2 条（理解度未闭环 2 条）；已派生 3 点\n\n## 末\n",
  4910	        {"ledger": {"seeds": [{"node_id": "SeedA", "tips_count": 2}]}},
  4911	        problems2,
  4912	    )
  4913	    assert problems2 == [], f"真实报告的尾巴被误伤：{problems2!r}"
  4914	
