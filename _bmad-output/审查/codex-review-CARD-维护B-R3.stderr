  4231	    report.write_text(text, encoding="utf-8")
  4232	    r = run_verify(report)
  4233	    assert r.returncode != 0, "shortcut link 藏起来的可见计数被放行"
  4234	    assert _one_problem_has(r.stdout, "987654"), f"诊断未指向完整数串 987654:\n{r.stdout}"
  4235	
  4236	    # ③ 崩溃判据：两个已知假阴面各一条正例 + 断言失败不得误判
  4237	    import importlib.util as _ilu
  4238	
  4239	    _prev = sys.dont_write_bytecode
  4240	    sys.dont_write_bytecode = True
  4241	    try:
  4242	        _spec = _ilu.spec_from_file_location(
