  4706	def test_domain_r20_seed_ledger_visible_in_manifest_cli(tmp_path):
  4707	    """R3 round-22（冻结审查 v3）：台账种子行的 raw/visible 夹缝 —— **manifest 模式**。
  4708	
  4709	    ⛔ 这条推翻了我 round-19 的「实测不成立」。当时我在 **fallback** 模式下测，
  4710	    冲突行会撞上那里的整行形状门 ⇒ 看起来 fail-closed。审查方指出
  4711	    **manifest 模式没有那层门** —— 实测两条 exit 0 放行：
  4712	
  4713	      · `- SeedA — 批**注** 999 条`
  4714	      · `- SeedA — 批<b>注</b> 999 条`
  4715	
  4716	    形态与 ③段信号行、五元组的双行逃逸**完全相同**（留一条正确行 + 加一条渲染
  4717	    等价但源码不命中的冲突行）。这是同一形态在本卡的**第三次**命中。
  4718	
  4719	    **它证明什么**：种子行的段抓取与行匹配都在渲染文本上做；两个消费方
  4720	    （`_verify_seed_ledger_counts` 的值绑定 + fallback 的整行形状门）同口径。
  4721	    **它不证明什么**：`_visible_block` 仍不是完整 renderer；③标题与 tips 的
  4722	    同型攻击在两种模式下都未复现（**未复现 ≠ 安全**，如实登记）。
  4723	    """
  4724	    vault = standard_vault(tmp_path)
  4725	    mpath = make_manifest(vault)
  4726	    scan = collect_json(vault, "--manifest", str(mpath))
  4727	    assert scan.get("data_mode") == "manifest", "前提：本门测的是 manifest 路径"
  4728	
  4729	    report = write_report(vault, scan)
  4730	    base = report.read_text(encoding="utf-8")
  4731	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4732	
  4733	    ms = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", base, re.M | re.S)
  4734	    assert ms, "前提：报告必须含『### 种子』小节"
  4735	    seed = [ln for ln in ms.group(1).splitlines() if ln.strip() and "批注" in ln]
  4736	    assert seed, "前提：种子小节必须含带批注数的行"
  4737	    good = seed[0]
  4738	    n = re.search(r"批注\s*(\d+)\s*条", good)
  4739	    assert n, f"前提：种子行必须含批注数: {good!r}"
  4740	
  4741	    def with_conflict(broken: str):
  4742	        conflict = good.replace("批注", broken, 1).replace(f"{n.group(1)} 条", "999 条")
  4743	        text = base.replace(good, good + "\n" + conflict, 1)
  4744	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4745	        report.write_text(text, encoding="utf-8")
  4746	        return run_verify(report), conflict
  4747	
  4748	    for broken, why in (("批**注**", "强调标记切开"), ("批<b>注</b>", "HTML 标签切开")):
  4749	        r, conflict = with_conflict(broken)
  4750	        assert r.returncode != 0, f"种子行双行逃逸（{why}）被放行 —— {conflict!r}"
  4751	
  4752	    # 不得误伤：把**正确行本身**写成渲染等价的强调形态，仍须通过
  4753	    report.write_text(base.replace(good, good.replace("批注", "批**注**", 1), 1), encoding="utf-8")
  4754	    assert run_verify(report).returncode == 0, "渲染等价的合规种子行被误判"
  4755	
  4756	    # 单一应用点：四处消费方必须都走 _visible_block（漂移即被抓）
  4757	    rs = _load_recap_scan()
  4758	    assert callable(getattr(rs, "_visible_block", None)), "共用 helper 不存在 ⇒ 又会各自 join 一遍"
  4759	    assert rs._visible_block("a**b**\n<c>d</c>") == "ab\nd", "helper 行为不符（行数/顺序必须不变）"
  4760	    # ⚠️ round-23：上一版这句「四处消费方都走 helper」**当时不成立**（③段信号行
  4761	    #    还在逐行 `_visible_text`）。生产已统一，这里按**调用点计数**锁住，
  4762	    #    漂移（有人又写回内联 join）即被抓。
  4763	    _src = pathlib.Path(rs.__file__).read_text(encoding="utf-8")
  4764	    # ⛔ round-25（冻结审查 v6）：原判据 `>=5` 会假绿 —— 文本共出现 6 次
  4765	    #    （定义 1 + 真实调用 4 + 注释 1），删掉任一真实调用仍剩 5，门继续绿。
  4766	    #    改为**按调用形态计数**：排除定义行与注释行后，真实调用须恰好 4 处。
  4767	    _call_lines = [
  4768	        _l
  4769	        for _l in _src.splitlines()
  4770	        if "_visible_block(" in _l and not _l.lstrip().startswith("#") and not _l.lstrip().startswith("def ")
  4771	    ]
  4772	    # ⚠️ round-25：seed 的值绑定改用**逐行数组**（比整块 join 更强：下标即同源行），
