  1455	def _load_recap_scan():
  1456	    """按被测脚本自身的零写侧约定导入它（不落 __pycache__）。"""
  1457	    import importlib.util
  1458	
  1459	    if not SCRIPT.exists():
  1460	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
  1461	    prev = sys.dont_write_bytecode
  1462	    sys.dont_write_bytecode = True
  1463	    try:
  1464	        spec = importlib.util.spec_from_file_location("recap_scan_ut", SCRIPT)
  1465	        mod = importlib.util.module_from_spec(spec)
  1466	        spec.loader.exec_module(mod)
  1467	    finally:
  1468	        sys.dont_write_bytecode = prev
  1469	    return mod
