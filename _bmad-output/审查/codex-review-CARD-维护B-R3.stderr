  1572	def _scan_number_pool(obj, pool: set[int]) -> None:
  1573	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1574	
  1575	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1576	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1577	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1578	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1579	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1580	    """
  1581	    if isinstance(obj, bool):
  1582	        return
  1583	    if isinstance(obj, int):
  1584	        pool.add(obj)
  1585	    elif isinstance(obj, float):
  1586	        if obj.is_integer():
  1587	            pool.add(int(obj))
  1588	    elif isinstance(obj, dict):
  1589	        for v in obj.values():
  1590	            _scan_number_pool(v, pool)
  1591	    elif isinstance(obj, list):
  1592	        for v in obj:
  1593	            _scan_number_pool(v, pool)
  1594	
