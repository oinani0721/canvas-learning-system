  4226	def test_domain_r13_shortcut_link_and_crash_classifier(tmp_path):
  4227	    """R3 round-16（冻结审查 HIGH ×2）：shortcut link 渲染面 + 崩溃判据的假阴面。
  4228	
  4229	    两条实测反例（修前）：
  4230	      · `总[计]987654个子节点` —— link 三形态只覆盖了 inline `[t](url)` 与
  4231	        reference `[t][r]`/`[t][]`，**shortcut** `[t]` 未覆盖；渲染后读者看到
  4232	        `总计987654个`，源码里 `总`/`计` 被方括号隔开，句式门失锚 ⇒ exit 0；
  4233	      · negverify 的崩溃判据**枚举**五个异常名、且只扫外层 pytest stdout ⇒
  4234	        `ValueError`/`KeyError` 崩溃、以及 **CLI 子进程**里的 traceback 全部
  4235	        记成「✅ 如期变红」。崩溃伪红是四种假绿里**唯一伪装成成功**的一种。
  4236	
  4237	    **它证明什么**：shortcut link 的显示文本进入受检面且不误伤 callout/脚注；
  4238	    崩溃判据按**形态**（`E <Exc>` 非 AssertionError / traceback / INTERNALERROR /
  4239	    收集期 error）而非**名单**识别，两个已知假阴面各有一条正例。
  4240	    **它不证明什么**：`_visible_text` 仍不是完整 renderer（highlight/math/脚注
  4241	    未覆盖）；崩溃判据取的是「宁可误报不漏报」方向，可能把**故意**断言 traceback
  4242	    文本的门误判为崩溃（当前目标套件无此形态）。
  4243	    """
  4244	    rs = _load_recap_scan()
  4245	
  4246	    # ① 渲染面：shortcut 取显示文本，且不吃掉 callout / 脚注
  4247	    assert rs._visible_text("总[计]987654个") == "总计987654个"
  4248	    assert rs._visible_text("总[计](http://x)987654个") == "总计987654个", (
  4249	        "inline 形态必须先于 shortcut 剥，否则只剩裸 url"
  4250	    )
  4251	    assert rs._visible_text("总[计][r]987654个") == "总计987654个"
  4252	    assert rs._visible_text("> [!question]+ 提问") == "> [!question]+ 提问", (
  4253	        "Obsidian callout 头不是链接语法，剥掉会改变段落语义"
  4254	    )
  4255	    assert rs._visible_text("脚注[^1]在此") == "脚注[^1]在此"
  4256	
  4257	    # ② CLI：shortcut link 藏起来的可见计数必须被拦
  4258	    vault = standard_vault(tmp_path)
  4259	    scan = collect_json(vault)
  4260	    assert 987654 not in rs._derived_number_pool(scan)
  4261	    report = write_report(vault, scan)
  4262	    base_text = report.read_text(encoding="utf-8")
  4263	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4264	    text = base_text.replace(
  4265	        "## 三维审查",
  4266	        "## 三维审查\n\n- 本板总[计]987654个子节点。【实测】",
  4267	        1,
  4268	    )
  4269	    assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  4270	    report.write_text(text, encoding="utf-8")
  4271	    r = run_verify(report)
  4272	    assert r.returncode != 0, "shortcut link 藏起来的可见计数被放行"
  4273	    assert _one_problem_has(r.stdout, "987654"), f"诊断未指向完整数串 987654:\n{r.stdout}"
  4274	
  4275	    # ③ 崩溃判据：两个已知假阴面各一条正例 + 断言失败不得误判
  4276	    import importlib.util as _ilu
  4277	
  4278	    _prev = sys.dont_write_bytecode
  4279	    sys.dont_write_bytecode = True
  4280	    try:
  4281	        _spec = _ilu.spec_from_file_location(
  4282	            "negverify_ut", pathlib.Path(__file__).with_name("recap_domain_negverify.py")
  4283	        )
  4284	        _nv = _ilu.module_from_spec(_spec)
  4285	        _spec.loader.exec_module(_nv)
  4286	    finally:
  4287	        sys.dont_write_bytecode = _prev
