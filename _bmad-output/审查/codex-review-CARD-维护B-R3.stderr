  2420	def _verify_report(path: str) -> int:
  2421	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  2422	
  2423	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  2424	    """
  2425	    try:
  2426	        text_raw = Path(path).read_text(encoding="utf-8")
  2427	    except (OSError, UnicodeDecodeError) as e:
  2428	        print(f"✗ 报告不可读: {type(e).__name__}")
  2429	        return 1
  2430	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  2431	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  2432	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  2433	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  2434	    if not fm_m:
  2435	        print("✗ 报告缺 frontmatter 块")
  2436	        return 1
  2437	    fm = fm_m.group(1)
  2438	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  2439	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。
  2440	    if "<!--" in fm or "-->" in fm:
  2441	        print("✗ frontmatter 块内含 HTML 注释标记")
  2442	        return 1
  2443	    problems: list[str] = []
  2444	    # ⛔ 顺序必须是**先检后剥** (对抗审查实测的 BLOCKER):
  2445	    # 原实现先无条件 `re.sub` 剥掉闭合注释, 再用 `if "<!--" in text` 查残留 ——
  2446	    # 两个标记都被吃掉了, 于是这道检查恒不触发。后果远不止 D2:
  2447	    # 把标记包成 code span (`` `<!--` `` … `` `-->` ``), 在 Obsidian 里它渲染成
  2448	    # **字面可见的正文**, 而 verifier 先把整段删掉 ⇒ 该段落对**全部**基于 text 的
  2449	    # 检查隐身 —— 实测连 HARD-R4 禁词「偏离」都能这样藏进去并 VERIFY PASS。
  2450	    # 报告本就禁写任何 HTML 注释 (F2 已有此口径), 所以在**原始文本**上一次判死,
  2451	    # 不区分闭合与否、也不管标记是否落在代码跨度内。
  2452	    if "<!--" in text_raw or "-->" in text_raw:
  2453	        problems.append(
  2454	            "正文含 HTML 注释标记 (渲染隐藏面/可见文本与校验文本分叉, 报告禁写注释)"
  2455	        )
  2456	    # 六轮影子字段防御: 正文校验前剥 HTML 注释 — "注释里藏正确模板行、
  2457	    # 可见文本撒谎"的形态失效, 可见文本必须独立过全部校验。
  2458	    text = re.sub(r"<!--.*?-->", "", text_raw, flags=re.S)
