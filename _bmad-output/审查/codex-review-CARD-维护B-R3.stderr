   152	def _contained_md(base: Path, name: str) -> Path | None:
   153	    """路径 containment (B2): name 必须是纯文件名 stem, 解析后仍在 base 内。
   154	
   155	    含 / \\ 或 .. 组件、以 . 开头、resolve 后逃出 base → None (按不存在/
   156	    非法处理, 越界读一律拒绝)。
   157	    """
   158	    if not name or name.startswith("."):
   159	        return None
   160	    if "/" in name or "\\" in name or "\x00" in name:
   161	        return None
   162	    if name in ("..", "."):
   163	        return None
   164	    # shell 元字符与控制字符 (B2 补): 板名/节点名会出现在 Bash 单引号参数里,
   165	    # 单引号本身会破坏引用; ` $ " 与控制字符没有任何合法板名需要 → 一律拒绝。
