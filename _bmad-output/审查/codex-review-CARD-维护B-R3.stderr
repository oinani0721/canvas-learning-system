    88	def _ts(days: int) -> str:
    89	    """N 天 + 2h 前的 ISO 时间戳 → collect 时 floor 年龄恰 N 天。"""
    90	    return (datetime.now(timezone.utc) - timedelta(days=days, hours=2)).strftime("%Y-%m-%dT%H:%M:%SZ")
    91	
    92	
    93	def run_collect(vault: Path, board: str = BOARD, *extra: str) -> subprocess.CompletedProcess:
    94	    if not SCRIPT.exists():  # 防「脚本不存在 → 非零退出 → 拒绝类断言假绿」
    95	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
    96	    return subprocess.run(
    97	        [sys.executable, str(SCRIPT), "--vault", str(vault), "--board", board, *extra],
    98	        capture_output=True,
    99	        text=True,
   100	        timeout=60,
   101	    )
   102	
   103	
   104	def _surface_child_stderr(r: subprocess.CompletedProcess) -> None:
   105	    """把**被测 CLI 子进程**的 stderr 抬到测试自己的 stdout 上。
   106	
   107	    ⛔ round-20（冻结审查 v2 §四.4）：本域大量门是跑 CLI 子进程再核 stdout 的，
   108	    子进程以 `capture_output=True` 执行，断言里只带 `r.stdout` ⇒ 内层 traceback
   109	    若只落在 `r.stderr`，**外层 pytest 的两路输出里根本不会出现它**，
   110	    `recap_domain_negverify` 的崩溃识别就永远看不见内层崩溃。
   111	    pytest 会在失败时展示 "Captured stdout call"，所以 print 到这里即接通。
   112	    """
   113	    if r.stderr and r.stderr.strip():
   114	        print(f"[child stderr]\n{r.stderr}")
   115	
   116	
   117	def run_verify(report: Path) -> subprocess.CompletedProcess:
   118	    if not SCRIPT.exists():
   119	        pytest.fail(f"被测脚本不存在: {SCRIPT}")
   120	    r = subprocess.run(
   121	        [sys.executable, str(SCRIPT), "--verify", str(report)],
   122	        capture_output=True,
   123	        text=True,
   124	        timeout=60,
   125	    )
   126	    _surface_child_stderr(r)
   127	    return r
   128	
