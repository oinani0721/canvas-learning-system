  2295	def _verify_numbers(fm: str, text: str, report_path: Path, problems: list[str]) -> None:
  2296	    """H5 数字绑定 (四轮+六轮): 报告核心计数必须与同目录 scan JSON 快照全等。
  2297	
  2298	    scan JSON = 报告同目录 ``.recap-scan-<board>.json`` (SKILL Step 2 落盘)。
  2299	    缺失 = 无法终核 → fail-closed 直接 FAIL; 存在则绑定:
  2300	    board_sha256 / data_mode / recap_date / 规模自陈五元组 / AI 侧对账 tips 两数。
  2301	    六轮影子字段防御: frontmatter 键只在真 frontmatter 块 (fm) 里认 —
  2302	    把三行搬进正文冒充不算数; text 已在上游剥掉 HTML 注释。
  2303	    """
  2304	    mb = re.search(r'^board:\s*"?([^"\n]+)"?\s*$', fm, re.M)
  2305	    if not mb:
  2306	        problems.append("frontmatter 缺 board 字段 (数字终核无法定位 scan JSON)")
  2307	        return
  2308	    board_id = mb.group(1).strip()
  2309	    # ⛔ round-6 终裁复核: 绑定对象此前完全由报告自己的 frontmatter 指定 —
  2310	    # 报告可以指向**另一块板**的 scan JSON 来匹配自己的数字。报告文件名

