   680	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   681	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   682	    return bool(
   683	        any(name not in LEGIT_RED for name in exc_names)
   684	        or "Traceback (most recent call last):" in out
   685	        or "INTERNALERROR" in out
   686	        or errors > 0
   687	    )
