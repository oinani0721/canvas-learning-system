  1773	def _visible_text(line: str) -> str:
  1774	    """源码行 → **读者在 Obsidian 里看到的文本**（本域收敛器，非完整渲染器）。
  1775	
  1776	    顺序有讲究（每一步都对应前几轮的一条实测 HIGH）：
  1777	      1. **先解 HTML 实体**再做全角转换 —— 反过来会让 `&#xff19;` 解出 `９`
  1778	         之后再没有机会转成 ASCII（round-5 HIGH-3 实测）;
  1779	      2. 剥 HTML 标签 —— `<b>` 长度不限, 原先只有 ≤22 字符的短标签算连接字符;
  1780	      3. wikilink 取**显示文本** —— 有别名取别名, 无别名取目标本身
  1781	         （原实现把无别名链接的目标挖空, 而那正是读者看到的字, round-5 HIGH-8）;
  1782	      3b. link 三形态按 **inline → reference → shortcut** 顺序剥 —— shortcut 式
  1783	         方括号最宽, 放最后才不会把 inline/reference 的显示文本先吃掉留下裸 url;
  1784	      4. 去零宽/双向控制字符;
  1785	      5. 去强调标记 `*_` 与成对 `~~` —— ⚠️ 未配对时渲染**可见**, 去掉它们是一个
  1786	         **已知 fail-open 面**而非安全边界（`1\\*5个` 按 15 入池，池含 15 并不能
  1787	         证明读者看到的 `1*5` 有出处）。此前写的「安全向、不构成虚构通道」**已被
  1788	         证伪**，round-13 的试修亦实测无收益并已回退。如实登记，不再声称安全。
  1789	
  1790	    ⚠️ **不碰 inline code**: `` `…` `` 的内容在本域是**有意豁免**的字段值
  1791	    （E2, 见 _blank_inline_code），不是"被隐藏的计数"。这是**声明过的设计选择**,
  1792	    不是遗漏 —— 如实登记在验收单, 不在这里悄悄改语义。
  1793	    """
  1794	    line = html.unescape(line)
  1795	    # ⛔ R3 round-25（冻结审查 v6）：`html.unescape` 会把 `&#10;` / `&#13;` /
  1796	    #    `&NewLine;` 解成**真换行** ⇒ 一行变多行，`_visible_block` 号称的
  1797	    #    「行数与顺序不变」当场失效，而 seed 的 raw/visible **按下标配对**
  1798	    #    正依赖这个不变式。⇒ 行内解出的换行一律折成空格：单行的渲染结果
  1799	    #    仍是单行，不变式才是真的。
  1800	    line = line.replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
  1801	    line = line.translate(_FULLWIDTH_DIGITS)
  1802	    line = _VIS_TAG_RE.sub("", line)
  1803	    line = _VIS_WIKILINK_ALIAS_RE.sub(r"\1", line)
  1804	    line = _VIS_WIKILINK_PLAIN_RE.sub(r"\1", line)
  1805	    line = _VIS_MDLINK_RE.sub(r"\1", line)
  1806	    line = _VIS_REFLINK_RE.sub(r"\1", line)
  1807	    line = _VIS_SHORTCUT_LINK_RE.sub(r"\1", line)
  1808	    line = _VIS_INVISIBLE_RE.sub("", line)
  1809	    line = _VIS_STRIKE_RE.sub("", line)
  1810	    return _VIS_EMPHASIS_RE.sub("", line)
  1811	
