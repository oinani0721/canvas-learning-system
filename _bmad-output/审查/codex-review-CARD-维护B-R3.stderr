  2415	    """round-2 线索门 + round-3 BLOCKER-1/2 修复门: 列表容器内的围栏。
  2416	
  2417	    渲染语义（CommonMark，round-3 与 Codex 双向确认）:
  2418	      · `- ``` ` 开栏 + **缩进 ≥ 内容列** 的内容行 → 内容渲染在代码块内（灰底），
  2419	        verifier 必须剥 ⇒ 藏信号 = 缺行/代码块内信号名;
  2420	      · `- ``` ` 开栏后 **marker 行**（缩进不足的同级 `- 内容`）→ 是**新的 sibling
  2421	        列表项，渲染为可见正文** ⇒ verifier 必须保留 ⇒ 可见伪计数由 D2 拦
  2422	        （round-3 BLOCKER-1: 无容器边界跟踪时它被误剥成代码内容，D2 漏拦）;
  2423	      · **有序 marker** `1. ``` `（round-3 BLOCKER-2）与无序同语义。
  2424	
  2425	    先红证据: `evidence-maintb-r2/codex-hint-repro.txt`（round-2 形态）、
  2426	    `round3-repro.txt`（BLOCKER-1 实测 exit 0）、`round3-v2-probe4.txt`（整改后 19 项行为矩阵）。
  2427	
  2428	    **它证明什么**: 上述三形态的「剥/留」判定与下游拦截各就各位。
  2429	    **它不证明什么**: 不证明所有 CommonMark 容器嵌套（引用内列表内列表等）都覆盖
  2430	    ——以「模板允许的前缀形态 + 常见列表容器」为封闭集。
  2431	    """
  2432	    vault = standard_vault(tmp_path)
  2433	    scan = collect_json(vault)
  2434	    report = write_report(vault, scan)
  2435	    base = run_verify(report)
  2436	    assert base.returncode == 0, f"基线报告本身就不过 verifier:\n{base.stdout}"
  2437	    text = report.read_text(encoding="utf-8")
  2438	    lines = text.splitlines()
  2439	    idx = [i for i, ln in enumerate(lines) if any(lb in ln for lb in SIGNAL_LABELS)]
  2440	    start, end = idx[0], idx[-1]
  2441	
  2442	    # ① 列表项围栏 + 缩进内容（真代码）→ 剥 → 拦
  2443	    body = ["> - ```"] + [">   " + re.sub(r"^[>\s]*-\s*", "", lines[i]) for i in range(start, end + 1)] + [">   ```"]
  2444	    out = lines[:start] + body + lines[end + 1 :]
  2445	    report.write_text("\n".join(out) + "\n", encoding="utf-8")
  2446	    r = run_verify(report)
  2447	    assert r.returncode != 0, f"列表项围栏(缩进内容)仍被放行:\n{r.stdout}"
  2448	    assert "代码块内出现信号名" in r.stdout or "缺信号行" in r.stdout, f"拦截理由与围栏无关:\n{r.stdout}"
  2449	
  2450	    # ② 有序列表围栏 + 缩进内容（round-3 BLOCKER-2）→ 剥 → 拦
  2451	    body = ["1. ```"] + ["   " + re.sub(r"^[>\s]*-\s*", "", lines[i]) for i in range(start, end + 1)] + ["1. ```"]
  2452	    out = lines[:start] + body + lines[end + 1 :]
  2453	    report.write_text("\n".join(out) + "\n", encoding="utf-8")
  2454	    r = run_verify(report)
  2455	    assert r.returncode != 0, f"有序列表围栏仍被放行:\n{r.stdout}"
  2456	    assert "代码块内出现信号名" in r.stdout or "缺信号行" in r.stdout, f"拦截理由与围栏无关:\n{r.stdout}"
  2457	
  2458	    # ③ sibling marker 行 = 可见正文（round-3 BLOCKER-1）→ 保留 → D2 拦伪计数
  2459	    r = _mutate_report(
  2460	        tmp_path / "sibling",
  2461	        lambda t, s: t.replace(
  2462	            "## 三维审查",
  2463	            "## 三维审查\n\n- ```\n- 本板共有 987654 个子节点\n- ```\n",
  2464	            1,
  2465	        ),
  2466	    )
  2467	    assert r.returncode != 0, f"sibling 列表项可见伪计数被放行:\n{r.stdout}"
  2468	    assert "找不到同值来源" in r.stdout, f"拦截理由不是 D2:\n{r.stdout}"
  2469	
  2470	    # ④ sibling marker 行放合规信号 = 可见且合规 → 放行（渲染语义锁，防过剥）
  2471	    r = _mutate_report(
  2472	        tmp_path / "sibling_ok",
  2473	        lambda t, s: t.replace(
  2474	            "## 三维审查",
  2475	            "## 三维审查\n\n- ```\n- 本报告信号与数据快照一致\n- ```\n",
  2476	            1,
  2477	        ),
  2478	    )
  2479	    assert r.returncode == 0, f"sibling 列表项可见正文被误伤:\n{r.stdout}"
