  3554	def test_domain_r7_range_endpoints_and_fallback_seps_cli(tmp_path):
  3555	    """R3 round-4 行为门：区间两端都终核；fallback 也有小数/千分位防线。
  3556	
  3557	    三条实测反例（修前全部 exit 0）：
  3558	      · `本板共有987654-0个子节点` —— 某端无出处时区间不挖空，而后面的循环只取
  3559	        **紧邻量词**的右端 `0`；任一非空池都由 `abs(a-a)` 生成 0 ⇒ 放行。
  3560	        既有门只测了反方向 `1-987654`（大数在右）。
  3561	      · fallback `#### 派生子女 0.0 个` / `零点零` / `1,005` —— 千分位归一与小数
  3562	        防线原先**只在 D2 路径**，fallback 直接对原行 findall 逐片入池。
  3563	      · `本板共有987654<b>.</b>0个子节点` —— 渲染成 `987654.0`，但小数式原要求
  3564	        数串与 `.` 直接相邻，两道防线全不命中；`987654，000个` 的全角逗号同理。
  3565	
  3566	    **它证明什么**：区间两端都进池比对且**只在规模自陈句式内**报（非自陈句
  3567	    `建议覆盖 2~3 个节点` 不受伤——第一版把报错放在句式门之前，当场误伤）；
  3568	    千分位与小数防线在 D2 与 fallback **两侧都在**，且认全角逗号与被标签包住的
  3569	    小数点。
  3570	    **它不证明什么**：分隔符集合（`,`/`，`）与小数分隔符集合（`.`/`．`/`点`）
  3571	    仍是**封闭表**；其它千分位写法（空格已由连接集覆盖，撇号 `'` 等未覆盖）
  3572	    未验证。见验收单 §五之三。
  3573	    """
  3574	    vault = standard_vault(tmp_path)
  3575	    scan = collect_json(vault)
  3576	    pool = _load_recap_scan()._derived_number_pool(scan)
  3577	    assert 0 in pool and 987654 not in pool, f"前提失效: {sorted(pool)}"
  3578	    report = write_report(vault, scan)
  3579	    base_text = report.read_text(encoding="utf-8")
