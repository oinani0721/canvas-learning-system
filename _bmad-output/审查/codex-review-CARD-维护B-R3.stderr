  3581	    # ── 放行面（同权重）：合法形态不得被这道收紧反噬 ──
  3582	    for name, line in (
  3583	        ("单字在池", "- 本板共有五个子节点。【实测】"),
  3584	        ("ASCII 在池", "- 本板共有3个子节点。【实测】"),
  3585	        ("ASCII 在池 22", "- 本板共有22个子节点。【实测】"),
  3586	        ("前导零 016=16 在池", "- 本板共有016个子节点。【实测】"),
  3587	        ("round-5 原始误伤 十分", "- 说明十分清楚。【实测】"),
