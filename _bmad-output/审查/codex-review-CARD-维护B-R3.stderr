  3357	    UNITS = {"十": 10, "百": 100, "千": 1000, "万": 10000, "亿": 100000000}
  3358	    assert rs._CJK_NUM == EXPECT, f"单字数词表被改动: {rs._CJK_NUM}"
  3359	    assert rs._CJK_UNIT == UNITS, f"量词表被改动: {rs._CJK_UNIT}"
  3360	    for ch, want in EXPECT.items():
  3361	        assert rs._cjk_single_to_int(ch) == want, f"单字数词 {ch} 取值错"
  3362	    for ch in UNITS:  # 十百千万亿 不在 _CJK_NUM ⇒ 单字量词同样无法确定
  3363	        assert rs._cjk_single_to_int(ch) is None, f"单字量词 {ch} 必须 fail-closed"
  3364	    for s in ("一零", "五四", "九十八万", "零一", "十二", "两三", "", "甲", "五个"):
  3365	        assert rs._cjk_single_to_int(s) is None, f"{s!r} 必须判「无法确定」（不猜）"
  3366	
  3367	    # 提取面必须覆盖判据面: **抓得到才拒得掉**。提取面漏字 ⇒ 该字组成的串落到
  3368	    # 检查面之外 = 漏拦（不是 fail-closed）。
  3369	    assert set(rs._CJK_NUM_CHARS) == set(EXPECT) | set(UNITS)
  3370	    # ⛔ R3 round-3: 取数用的是**宽集合**（数词样字符），它只用于**定界**、不赋值。
  3371	    # 表外数词字（廿卅/大写金融数字）必须进得来——进不来 ⇒ `廿五个` 会从 `五`
  3372	    # 重锚按 5 查池而放行（Codex round-2 HIGH，车道实测 rc=0）。
  3373	    # ⛔ 精确相等而非子集包含（Codex round-3 属实指出：子集断言锁不住声明里的
  3374	    # `卌` 与各种异体，表少一个字就意味着那类写法会从尾片重锚）。
  3375	    assert set(rs._NUMERAL_LIKE_CHARS) == (
  3376	        set(rs._CJK_NUM_CHARS)
  3377	        | set("0123456789")
  3378	        | set(
  3379	            "廿卅卌壹贰貳叁參参肆伍陆陸柒捌玖拾佰仟萬亿億两兩兆京垓秭穰仨俩①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳〡〢〣〤〥〦〧〨〩〸〹〺"
  3380	        )
  3381	    ), f"定界集漂移: {rs._NUMERAL_LIKE_CHARS}"
  3382	    # 宽集合只定界不赋值：表外字符进来只会让整串"无法确定"，不会被猜成某个数。
  3383	    for s in ("廿五", "壹佰", "九十八万5", "五四", "一零"):
  3384	        assert rs._count_token_value(s) is None, f"{s!r} 不得被赋值"
  3385	    for s, want in (("980005", 980005), ("016", 16), ("五", 5), ("0", 0)):
  3386	        assert rs._count_token_value(s) == want, f"{s!r} 取值错"
  3387	    m = rs._NUM_RUN_RE.match("九十八万")
  3388	    assert m and m.group(0) == "九十八万", "提取面抓不到连续多字串 = 漏拦"
  3389	    # ⛔ 且必须**跨排版噪声/不可见字符**整体抓 —— 断开就只剩尾片，判据再「绝对
  3390	    # 确定」也没用（拿到的 token 不是那句话里的数）。这一条是 R3 round-2 的
  3391	    # BLOCKER：`九十八万**五**个` 渲染出来就是「九十八万五个」，实测曾 exit 0。
  3392	    for name, s in (
  3393	        ("粗体", "九十八万**五"),
  3394	        ("空白", "九十八万 五"),
  3395	        ("nbsp", "九十八万&nbsp;五"),
  3396	        ("零宽", "九十八万\u200b五"),
  3397	        ("空标签", "九十八万<span></span>五"),
  3398	        ("HTML注释", "九十八万<!--x-->五"),
  3399	    ):
  3400	        m = rs._NUM_RUN_RE.match(s)
  3401	        assert m and m.group(0) == s, f"{name}切断: 提取面只抓到 {m and m.group(0)!r}"
  3402	        assert rs._join_free(m.group(0)) == "九十八万五", f"{name}: 剥噪声后不是原数"
  3403	        assert rs._cjk_single_to_int(rs._join_free(m.group(0))) is None
