4295:        ("E   KeyError: 3", True, "旧版枚举之外 ⇒ 假阴"),
4299:            "CLI 子进程崩溃，外层无异常名 ⇒ 旧版假阴",
4304:        # 从**全名**换成了**后缀** `(?:[Ee]rror|Exception)` —— 仍是我手写的闭表。
4305:        # 下面三个都不以 Error/Exception 结尾，旧判据全部漏掉。
4306:        ("E   SystemExit: 2", True, "不以 Error/Exception 结尾 ⇒ 旧后缀表假阴"),
4307:        ("E   subprocess.TimeoutExpired: t", True, "同上，且是点分名"),
4308:        ("E   RecursionError: deep", True, "枚举五名单之外"),
4309:        ("E   Failed: 被测脚本不存在", True, "pytest.fail = 夹具坏了，不是判错"),
4311:        # 要求"紧跟冒号"会漏掉整整一类崩溃。承重的条件是**缩进上界**，不是冒号。
4312:        ("E   RecursionError", True, "无消息异常（无冒号）⇒ 冒号规则会假阴"),
4313:        ("E   SystemExit", True, "同上"),
4321:        ("E     VERIFY FAIL (1 项) — 改写报告后重跑本命令", False, "断言消息续行，不是异常"),
4322:        ("E     VERIFY PASS — 可以发回执", False, "同上"),
4323:        ("E    +  where 0 = CompletedProcess(args=[...])", False, "assert 重写的 where 行"),
4324:        ("E   AssertionError: 四反引号短闭合仍被放行:", False, "消息自己以冒号结尾，仍是断言"),
4325:        ("E     E1 围栏闭合: 少一个反引号", False, "续行首词恰好像类名 ⇒ 必须靠缩进外的冒号规则排除"),
4327:        assert _nv._looks_like_crash(out) is want, f"崩溃判据判错: {why} | {out!r}"
4329:    # ④ transport：崩溃分析必须同时看 stderr。本域大量门跑 CLI 子进程，
4330:    #    子进程 traceback 只落 stderr 时，外层只剩一个 AssertionError。
4331:    assert not _nv._looks_like_crash("1 failed, 260 passed"), "前提：单看 stdout 不算崩溃"
4332:    assert _nv._looks_like_crash(_nv._crash_text("1 failed, 260 passed", "Traceback (most recent call last):")), (
4333:        "stderr 里的 traceback 被丢弃 ⇒ 生产崩溃会被当成正常判错变红"
