   173	def build_vault(tmp_path: Path, members: list[str]) -> Path:
   174	    vault = tmp_path / "vault"
   175	    for sub in ("原白板", "节点", "outputs"):
   176	        (vault / sub).mkdir(parents=True)
   177	    links = "\n".join(f"- [[节点/{m}]]" for m in members)
   178	    (vault / "原白板" / f"{BOARD}.md").write_text(
   179	        f"---\ntype: whiteboard\nboard_name: {BOARD}\n---\n\n# {BOARD}\n\n## Concepts\n\n{links}\n",
   180	        encoding="utf-8",
   181	    )
   182	    return vault
