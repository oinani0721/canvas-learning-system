    88	def _ts(days: int) -> str:
    89	    """N 天 + 2h 前的 ISO 时间戳 → collect 时 floor 年龄恰 N 天。"""
    90	    return (datetime.now(timezone.utc) - timedelta(days=days, hours=2)).strftime("%Y-%m-%dT%H:%M:%SZ")
