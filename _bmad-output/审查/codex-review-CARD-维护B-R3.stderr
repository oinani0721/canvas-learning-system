  4694	def test_domain_r20_seed_ledger_visible_in_manifest_cli(tmp_path):
  4695	    """R3 round-22（冻结审查 v3）：台账种子行的 raw/visible 夹缝 —— **manifest 模式**。
  4696	
  4697	    ⛔ 这条推翻了我 round-19 的「实测不成立」。当时我在 **fallback** 模式下测，
  4698	    冲突行会撞上那里的整行形状门 ⇒ 看起来 fail-closed。审查方指出
  4699	    **manifest 模式没有那层门** —— 实测两条 exit 0 放行：
  4700	
  4701	      · `- SeedA — 批**注** 999 条`
  4702	      · `- SeedA — 批<b>注</b> 999 条`
  4703	
  4704	    形态与 ③段信号行、五元组的双行逃逸**完全相同**（留一条正确行 + 加一条渲染
  4705	    等价但源码不命中的冲突行）。这是同一形态在本卡的**第三次**命中。
  4706	
  4707	    **它证明什么**：种子行的段抓取与行匹配都在渲染文本上做；两个消费方
  4708	    （`_verify_seed_ledger_counts` 的值绑定 + fallback 的整行形状门）同口径。
  4709	    **它不证明什么**：`_visible_block` 仍不是完整 renderer；③标题与 tips 的
  4710	    同型攻击在两种模式下都未复现（**未复现 ≠ 安全**，如实登记）。
  4711	    """
  4712	    vault = standard_vault(tmp_path)
  4713	    mpath = make_manifest(vault)
  4714	    scan = collect_json(vault, "--manifest", str(mpath))
  4715	    assert scan.get("data_mode") == "manifest", "前提：本门测的是 manifest 路径"
  4716	
  4717	    report = write_report(vault, scan)
  4718	    base = report.read_text(encoding="utf-8")
  4719	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4720	
  4721	    ms = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", base, re.M | re.S)
  4722	    assert ms, "前提：报告必须含『### 种子』小节"
  4723	    seed = [ln for ln in ms.group(1).splitlines() if ln.strip() and "批注" in ln]
  4724	    assert seed, "前提：种子小节必须含带批注数的行"
  4725	    good = seed[0]
  4726	    n = re.search(r"批注\s*(\d+)\s*条", good)
  4727	    assert n, f"前提：种子行必须含批注数: {good!r}"
  4728	
  4729	    def with_conflict(broken: str):
  4730	        conflict = good.replace("批注", broken, 1).replace(f"{n.group(1)} 条", "999 条")
  4731	        text = base.replace(good, good + "\n" + conflict, 1)
  4732	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4733	        report.write_text(text, encoding="utf-8")
  4734	        return run_verify(report), conflict
  4735	
  4736	    for broken, why in (("批**注**", "强调标记切开"), ("批<b>注</b>", "HTML 标签切开")):
  4737	        r, conflict = with_conflict(broken)
  4738	        assert r.returncode != 0, f"种子行双行逃逸（{why}）被放行 —— {conflict!r}"
  4739	
  4740	    # 不得误伤：把**正确行本身**写成渲染等价的强调形态，仍须通过
  4741	    report.write_text(base.replace(good, good.replace("批注", "批**注**", 1), 1), encoding="utf-8")
  4742	    assert run_verify(report).returncode == 0, "渲染等价的合规种子行被误判"
  4743	
  4744	    # 单一应用点：四处消费方必须都走 _visible_block（漂移即被抓）
  4745	    rs = _load_recap_scan()
  4746	    assert callable(getattr(rs, "_visible_block", None)), "共用 helper 不存在 ⇒ 又会各自 join 一遍"
  4747	    assert rs._visible_block("a**b**\n<c>d</c>") == "ab\nd", "helper 行为不符（行数/顺序必须不变）"

