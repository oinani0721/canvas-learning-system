  1079	            #   剥引用前缀恒做；**列表 marker 只在开栏本身就在列表项内时才剥** ——
  1080	            #   顶层围栏里的 `- ``` ` 是字面内容（审查方反例），列表项内围栏
  1081	            #   则本来就由下一个 `- ``` ` 闭合（round-2 固化形态）。
  1082	            if fence_list_col is None:
  1083	                bare_close = re.sub(r"^(?: {0,3}>[^\S\n]?)*", "", ln)
  1084	            else:
  1085	                bare_close = bare
  1086	            mc = close_re.match(bare_close)
  1087	            # 闭合: 同字符 + 长度 ≥ 开栏 + 其后只有空白
  1088	            if (
  1089	                mc
  1090	                and mc.group("fence")[0] == fence[0]
  1091	                and len(mc.group("fence")) >= len(fence)
  1092	            ):
  1093	                fence = None
  1094	                out.append("")
  1095	                continue
  1096	            if fence_list_col is not None and ln.strip():
  1097	                # 缩进不足 (相对引用系) 的非空行 → 容器结束, 围栏随之结束:
  1098	                # 该行按普通正文保留, 交回 D2/信号行校验。
  1099	                if _quote_width(ln) + _indent_after_quotes(ln) < fence_list_col:
  1100	                    fence = None
  1101	                    out.append(ln)
  1102	                    continue
  1103	            out.append("")
  1104	            continue
  1105	        out.append(ln)
  1106	    return "\n".join(out)
