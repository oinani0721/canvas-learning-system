   683	def render_report(scan: dict) -> str:
   684	    """按 SKILL.md Step 5 模板渲染最小合规报告 (两模式通用)。"""
   685	    c = scan["counts"]
   686	    fallback = scan["data_mode"] == "fallback_local"
   687	    sha = scan["source_revision"]["board_sha256"]
   688	    header_mode = "⚠ FALLBACK 本地扫描" if fallback else "manifest（1 次调用）"
   689	    fresh = (
   690	        "**⚠ FALLBACK：manifest 不可用（未提供 --manifest），本报告基于本地只读扫描，role/掌握度均为推定**\n"
   691	        if fallback
   692	        else ""
   693	    )
   694	    recon_tail = (
   695	        "- 待定纠错候选 0 条 · 孤儿/双源差集/检验历史：无据（fallback）"
   696	        if fallback
   697	        else "- 待定纠错候选 0 条 · 孤儿 0 · 双源差集 无 · 检验历史 0 板"
   698	    )
   699	    # ⛔ 维护卡 B: 这里原本**硬编码** `- SeedA — 批注 2 条`，不随 scan 变——
   700	    # 在 standard_vault 下恰好等于真值所以一直没露馅，在空 tips 板上就是一条
   701	    # 「形状合法、数字无据」的行。新增的种子行绑值门第一次跑就把它抓了出来
   702	    # （这正是本卡要的效果：形状对不等于数字有据）。改为按 scan 的 ledger 渲染。
   703	    ledger_seed = "\n".join(
   704	        f"- {r['node_id']} — " + (f"批注 {r['tips_count']} 条" if r.get("tips_count") else "无批注")
   705	        for r in (scan.get("ledger") or {}).get("seeds", [])
   706	    )
   707	    ledger_derived = "- DerivedB — 占位 · mastery 未记录 · tips 未闭环 2 条\n- DerivedC — 已剖析 · mastery 未记录"
   708	    return f"""---
   709	type: recap
   710	board: "{scan["board_stem"]}"
   711	board_name: "{scan["board_name"]}"
   712	recap_date: {scan["recap_date"]}
   713	data_mode: {scan["data_mode"]}
   714	board_sha256: "{sha}"
   715	generated_by: board-recap v1.1-signals
   716	---
   717	
   718	# 回顾 · {scan["board_name"]} · {scan["recap_date"]}
   719	
   720	> [!info]+ 规模自陈
   721	> {c["members"]} 成员（{c["seeds"]} 种子 + {c["derived"]} 派生，{c["stubs"]} 占位）/ {c["annotations"]} 批注 /
   722	> 数据面：{header_mode} / 无截断
   723	
   724	## 数据来源与新鲜度
   725	{fresh}- 板文件 SHA-256：`{sha[:12]}…` · 板文件 mtime：{scan["source_revision"]["board_mtime_utc"]}
   726	- manifest：无
   727	- 扫描时刻：{scan["source_revision"]["scan_at_utc"]}
   728	
   729	## 本段新增（上次回顾 → 现在）
   730	首次回顾，无对照基线。
   731	
   732	## 你现在可以做的
   733	1. 板上批注 {c["tips_total"]} 条【文件】——再跑一次 /board-recap {scan["board_stem"]}（数据更新后复盘）
   734	
   735	## 台账（种子/派生）
   736	### 种子
   737	{ledger_seed}
   738	### 派生
   739	{ledger_derived}
   740	
   741	## AI 侧对账
   742	- tips 批注共 {c["tips_total"]} 条【未确认-无法判定已答】，其中理解度未闭环 {c["tips_understanding_open"]} 条
   743	- 最老 3 条原话（added_at = 最后变更时间，非首次批注）：略
   744	{recon_tail}
   745	
   746	## 三维审查
   747	### ① 有没有漏掉的
   748	批注为零的成员共 1 个。
   749	### ② 靠不靠谱
   750	数据为本地文件抄录，角色为推定档。
   751	### ③ 方向（与推定基准的距离，仅供参考）
   752	{signal_lines(scan["signals"])}
   753	
   754	方向叙述：来源锚点缺失集中在派生角色成员，关联声明以既有数据为准。
   755	"""
   756	
   757	
   758	def write_report(vault: Path, scan: dict) -> Path:
   759	    outputs = vault / "outputs"
   760	    (outputs / f".recap-scan-{BOARD}.json").write_text(json.dumps(scan, ensure_ascii=False), encoding="utf-8")
   761	    report = outputs / f"回顾-{BOARD}-{scan['recap_date']}.md"
   762	    report.write_text(render_report(scan), encoding="utf-8")
   763	    return report
   764	
   765	
   766	def test_verify_pass_fallback_wording_survives(tmp_path):
   767	    """(c) fallback 全量报告 (含信号行) 过自家 verifier — 派生词禁令/「偏离」禁词零命中。"""
   768	    vault = standard_vault(tmp_path)
   769	    scan = collect_json(vault)
   770	    assert scan["data_mode"] == "fallback_local"
   771	    report = write_report(vault, scan)
   772	    r = run_verify(report)
   773	    assert r.returncode == 0, f"fallback 报告未过 verifier:\n{r.stdout}"
   774	    assert "VERIFY PASS" in r.stdout
   775	
   776	
   777	def test_verify_pass_manifest_wording(tmp_path):
   778	    """(c) manifest 模式同款措辞同样通杀。"""
   779	    vault = standard_vault(tmp_path)
   780	    scan = collect_json(vault, "--manifest", str(make_manifest(vault)))
   781	    assert scan["data_mode"] == "manifest"
   782	    report = write_report(vault, scan)
   783	    r = run_verify(report)
   784	    assert r.returncode == 0, f"manifest 报告未过 verifier:\n{r.stdout}"
   785	

