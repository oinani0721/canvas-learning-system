  2053	def _verify_seed_ledger_counts(text: str, scan: dict, problems: list[str]) -> None:
  2054	    """台账『种子』行的批注数必须绑到 scan JSON 里**该节点的** tips_count。
  2055	
  2056	    ⛔ 维护卡 B · H-2 后半 (round-6 实证): 原实现只有整行**形状**白名单
  2057	    (``- <节点> — 批注 N 条``), 不绑值 —— 把真实的「批注 2 条」改成
  2058	    「批注 999 条」形状照样合法, 实测 exit 0。白名单管住了句式, 没管住数字的出处。
  2059	
  2060	    scan JSON 的 ``ledger`` 是**按角色分组的 dict** (seeds/derived/unknown) 而非扁平
  2061	    列表 —— 我第一版直接迭代它, 拿到的是键字符串, verifier 当场抛 NameError/AttributeError,
  2062	    stdout 全空 exit 1, 症状伪装成"报告不合规"。这里显式摊平并容两种形态。
  2063	    """
  2064	    # ⛔ R3 round-22（冻结审查 v3）：段抓取与行匹配原先都在 **raw** 文本上做 ——
  2065	    #    留一条正确的种子行、再加一条**渲染等价但源码不命中**的冲突行
  2066	    #    （`- SeedA — 批**注** 999 条` / `批<b>注</b>`），后者匹配不上就静默
  2067	    #    continue，绑定被跳过。**fallback 模式**下有形状门兜底（这正是我上一轮
  2068	    #    『未复现』的原因），但 **manifest 模式没有那层门** —— 两条实测 exit 0。
  2069	    #    与③段信号行、五元组的双行逃逸完全同型，第三次。
  2070	    # ⛔ R3 round-24（冻结审查 v5）：round-23 的「先精确匹配 raw id」是个**自相矛盾
  2071	    #    的前提** —— `node` 取自已归一的行, 对含 `_`/`*` 的名字**永远不可能**命中
  2072	    #    raw 表。审查方给出两个后果, 一漏一误伤:
  2073	    #      · ledger 同时有 `SeedA` 与 `Seed_A` 时, 报告里的 raw `Seed_A` 归一成
  2074	    #        `SeedA` ⇒ **直接错绑到另一个节点**, 撞车检查被跳过, 错的批注数放行;
  2075	    #      · ledger 有 `Seed_A` 与 `Se_edA` 时, 报告里**精确正确**的 `Seed_A`
  2076	    #        归一后撞车 ⇒ 合法身份被拒。
  2077	    #    ⇒ 正解: **身份取自还能解析的最原始形态**。raw 与 visible 逐行并列
  2078	    #      (`_visible_block` 保证行数与顺序不变), 先用 raw 行解析; raw 行解析得出
  2079	    #      = 身份精确, 直接用; 只有 raw 行解析不出(被排版切开的冲突行)才退到归一行,
  2080	    #      那时才谈归一撞车。
  2081	    seed_raw = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", text, re.M | re.S)
  2082	    vis_text = _visible_block(text)
  2083	    mseed = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", vis_text, re.M | re.S)
  2084	    if not mseed:
  2085	        return
  2086	    raw_lines = seed_raw.group(1).splitlines() if seed_raw else []
  2087	    groups = scan.get("ledger")
  2088	    rows: list[dict] = []
  2089	    if isinstance(groups, dict):
  2090	        for grp in groups.values():
  2091	            if isinstance(grp, list):
  2092	                rows.extend(x for x in grp if isinstance(x, dict))
  2093	    elif isinstance(groups, list):
  2094	        rows = [x for x in groups if isinstance(x, dict)]
  2095	    if not rows:  # 无 ledger 可绑 = 无法终核, 不静默放行
  2096	        problems.append("数字终核: scan JSON 无可用 ledger, 台账『种子』行无法绑定")
  2097	        return
  2098	    tips_by_node = {str(r.get("node_id")): r.get("tips_count") for r in rows}
