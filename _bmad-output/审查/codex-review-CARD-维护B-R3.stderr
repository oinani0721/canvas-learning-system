  4338	def test_domain_r14_range_left_edge_and_codespan_order_cli(tmp_path):
  4339	    """R3 round-17（冻结审查 §一.1/§一.2）：两处**顺序耦合**，六条实测反例。
  4340	
  4341	    修前全部 exit 0：
  4342	      · `-2~3个` —— 区间端点用的 `_NUM_RUN_PAT` **不含符号**，匹配从负号之后
  4343	        重新起锚成 `2~3`；两端都在池 ⇒ 整段挖空，负号守卫再也看不到它；
  4344	      · `2.2~3个` —— 同理从小数点之后起锚；
  4345	      · `` `-5`个 `` / `` `5.5个` `` / `` `1,005个` `` / `` `５５个` `` ——
  4346	        inline-code 的「纯计数」豁免判据作用在 **raw** span 上，而它跑在
  4347	        `_visible_text` / `_normalize_number_seps` **之前**，于是符号/小数点/
  4348	        千分位/全角数字都不在 `_D2_COUNTISH_CHARS` 里 ⇒ 前瞻失败 ⇒ 整段按
  4349	        「字段值」挖空，后续所有数值门都看不见。
  4350	
  4351	    **它证明什么**：区间首端紧邻负号/小数点时 fail-closed；code span 的豁免
  4352	    判据看的是**渲染后**内容，且可见计数只挖反引号（保住量词锚）。
  4353	    **它不证明什么**：`_D2_RANGE_RE` 的分隔符仍是**闭表**；「可见计数」判据
  4354	    仍依赖 `_D2_COUNTISH_CHARS` 这张闭表 —— 两者都如实登记在验收单 §五之三。
  4355	    """
  4356	    rs = _load_recap_scan()
  4357	    vault = standard_vault(tmp_path)
  4358	    scan = collect_json(vault)
  4359	    pool = rs._derived_number_pool(scan)
  4360	    assert {2, 3, 5} <= pool, "前提：2/3/5 必须在池内，否则下面测的是别的东西"
  4361	    assert 55 not in pool and 1005 not in pool, "前提：55/1005 必须在池外"
  4362	
  4363	    report = write_report(vault, scan)
  4364	    base_text = report.read_text(encoding="utf-8")
  4365	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4366	
  4367	    def verify(injected: str):
  4368	        text = base_text.replace("## 三维审查", f"## 三维审查\n\n{injected}", 1)
  4369	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  4370	        report.write_text(text, encoding="utf-8")
  4371	        return run_verify(report)
  4372	
  4373	    # ① 必须拦：六条实测反例
  4374	    for line, needle, why in (
  4375	        ("- 本板共有-2~3个子节点。【实测】", "-2~3", "区间首端负号"),
  4376	        ("- 本板共有2.2~3个子节点。【实测】", "2.2~3", "区间首端小数"),
  4377	        ("- 本板共有`-5`个子节点。【实测】", "5", "负号在 code span 外"),
  4378	        ("- 本板共有`5.5个`子节点。【实测】", "5.5", "小数整体在 code span"),
  4379	        ("- 本板共有`1,005个`子节点。【实测】", "1005", "千分位整体在 code span"),
  4380	        ("- 本板共有`５５个`子节点。【实测】", "55", "全角数字在 code span（池外 55）"),
  4381	    ):
  4382	        r = verify(line)
  4383	        assert r.returncode != 0, f"{why}：放行了 —— {line!r}"
  4384	        assert _one_problem_has(r.stdout, needle), f"{why}：诊断未指向完整数串 {needle}\n{r.stdout}"
  4385	
  4386	    # ② 不得误伤：E2 字段值豁免仍在，池内值与合法区间照常放行
  4387	    for line, why in (
  4388	        ("- 配置项 `mastery_score` 已更新。【实测】", "普通字段值 code span 仍豁免"),
  4389	        ("- 本板共有`５个`子节点。【实测】", "全角 ５=5 在池内，应放行"),
  4390	        ("- 建议覆盖2~3个节点。", "合法区间不受伤"),
  4391	    ):
  4392	        assert verify(line).returncode == 0, f"误伤：{why} —— {line!r}"
