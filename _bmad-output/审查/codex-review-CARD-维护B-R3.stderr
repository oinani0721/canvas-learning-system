  2211	def _verify_fallback_derive_numbers(text: str, scan: dict, problems: list[str]) -> None:
  2212	    """CARD-维护B-R2 round-3 (Codex HIGH-4/5b/6): fallback 允许式的**数字出处**绑定。
  2213	
  2214	    措辞白名单 ``_FALLBACK_DERIVE_ALLOW`` (在 _verify_report) 只管「这句话允许说」,
  2215	    这里管「说出来的数字必须有据」——白名单匹配与值绑定分属两处, 缺一即漏:
  2216	      · HIGH-4 (round-4 补: ③段限定移出 data_mode 条件——manifest 报告的附录
  2217	        伪信号实测同样放行): 「无来源结论」信号行只许出现在**③段** ——
  2218	        ③段外 (附录/自造段) 的同形行不受信号绑定保护;
  2219	      · HIGH-5b: ⑦『N 个派生角色成员缺来源锚点』的前置 N 必须全等
  2220	        ``signals.unsourced_conclusions.value`` (无据档不容许前置 N);
  2221	      · HIGH-6: 允许式 #2 (段落标题) 与 #5 (关系类型分布行) 行内出现的任何
  2222	        数字都必须在 scan 数值池 —— `#### 派生子女 987654 个的说明` /
  2223	        `- 关系类型分布：无 987654` 实测曾放行。
  2224	    """
  2225	    # HIGH-4 (round-4: 对 manifest 模式同样生效)
  2226	    s3 = "\n".join(
  2227	        re.findall(r"^### ③.*?(?=^#{2,3}(?:[^\S\n]|$)|\Z)", text, re.M | re.S)
  2228	    )
  2229	    rest = text.replace(s3, "", 1) if s3 else text
  2230	    if "无来源结论" in rest:
  2231	        problems.append(
  2232	            "数字终核: 「无来源结论」信号行只许出现在③段 "
  2233	            "(段外同形行不受信号绑定保护, 附录伪信号实测曾放行)"
  2234	        )
  2235	    if scan.get("data_mode") != "fallback_local":
  2236	        return
  2237	    # HIGH-5b: ⑦ 前置 N 与 signals.unsourced_conclusions.value 全等
  2238	    sig = (scan.get("signals") or {}).get("unsourced_conclusions") or {}
  2239	    m7 = re.compile(r"^[>\s]*(?:(?P<n>\d+)\s*个)?派生角色成员缺来源锚点")
  2240	    for ln in text.splitlines():
  2241	        # ⛔ R3 round-19 (冻结审查 §一.3): 这里原先在 **raw** 行上匹配, 而同一条
  2242	        # 叙述的措辞白名单 (:2437) 早已改在 _visible_text 上判 —— 两侧口径分叉 ⇒
  2243	        # 「白名单放行、N 绑定跳过」的夹缝: 三条实测 exit 0
  2244	        #   · `999 个派**生**角色成员缺来源锚点。`
  2245	        #   · `999 个派<b>生</b>角色成员缺来源锚点。`
  2246	        #   · `999<b></b> 个派生角色成员缺来源锚点。`
