  4683	    # ② 函数本体：空 stderr 不出声；有 traceback 时打确定性标记
  4684	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=1, stdout="", stderr=""))
  4685	    assert capsys.readouterr().out == "", "stderr 为空时不得产生噪声"
  4686	
  4687	    _surface_child_stderr(
  4688	        _sp.CompletedProcess(
  4689	            args=["x"],
  4690	            returncode=1,
  4691	            stdout="",
  4692	            stderr="Traceback (most recent call last):\n  RecursionError: x\n",
  4693	        )
  4694	    )
