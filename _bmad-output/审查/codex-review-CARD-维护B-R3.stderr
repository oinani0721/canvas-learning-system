  4842	def test_domain_r22_fence_indent_and_seed_scope_cli(tmp_path):
  4843	    """R3 round-26（冻结审查 v7）：四空格伪围栏 + 种子小节范围 + 尾巴同名字段。
  4844	
  4845	    三条实测：
  4846	      · **四空格缩进的 ``` 不是围栏**（CommonMark 里那是 indented code block）。
  4847	        原实现先用 `[>\s]` 吃掉**任意**前导空白，`open_re` 的 ` {0,3}` 形同虚设
  4848	        ⇒ 顶层 `    ```` 被当成开栏，其后读者**看得见**的自陈句整段免检（实测放行）；
  4849	      · round-25 的「逐个处理全部种子小节」**范围超出意图** —— 搜全篇任意
  4850	        `### 种子`，未限定父级 `## 台账`、未排除围栏 ⇒ 附录里的同名小节被强制
  4851	        套台账模板（本轮误伤面，审查方指出）；
  4852	      · 尾巴里再写一个**同名字段**的计数（`批注 N 条`）与已绑定的首数矛盾。
  4853	
  4854	    **它证明什么**：容器前缀（引用/列表）仍被正确剥离，但无 marker 时不动缩进；
  4855	    种子小节只在「台账」H2 之下且不在围栏内才生效；同字段两处计数 fail-closed。
  4856	    **它不证明什么**：尾巴里**其它**字段（`理解度未闭环 N 条`/`已派生 N 点`）
  4857	    在 scan JSON 无逐节点对应字段，**不绑定**，如实登记。
  4858	    """
  4859	    rs = _load_recap_scan()
  4860	    vault = standard_vault(tmp_path)
  4861	    scan = collect_json(vault)
  4862	    report = write_report(vault, scan)
  4863	    base = report.read_text(encoding="utf-8")
  4864	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4865	
