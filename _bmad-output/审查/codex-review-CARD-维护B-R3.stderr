  2482	def test_domain_strip_code_blocks_unit_contract():
  2483	    """c2 · S3 承重门②「`_strip_code_blocks` 单元契约门」: 直接调函数验双向行为。
  2484	
  2485	    行为门（c1/列表围栏门）走整条 verifier，误伤面与拦截面都可能被别的规则掩盖；
  2486	    这道单元门把契约钉在函数本身（round-3 重写为渲染语义三分类）:
  2487	      · **剥空**（真代码内容，渲染为灰底）: 任意层引用围栏 / 列表项围栏 +
  2488	        缩进达内容列的内容 / 有序列表围栏；
  2489	      · **保留**（sibling marker 行 = 可见正文，round-3 BLOCKER-1 的语义反转）:
  2490	        `- ``` ` 开栏后缩进不足的同级 `- 内容` 行——围栏行剥空但内容行原样；
  2491	      · **零改动**: 合法列表 / thematic break / 无围栏结构。
  2492	
  2493	    **它证明什么**: 上述三分类的逐形态行为。
  2494	    **它不证明什么**: 不证明调用方（`_verify_signal_lines` / `_verify_prose_counts`）
  2495	    正确使用了它——那是行为门的事；也不穷尽 CommonMark 容器嵌套。
  2496	    """
  2497	    rs = _load_recap_scan()
  2498	
  2499	    def mid_kept(got: str, src: str) -> bool:
  2500	        """围栏行剥空 + **内容行**（第 2 行）原样保留 = sibling 可见正文语义。"""
  2501	        g, s = got.split("\n"), src.split("\n")
  2502	        return len(g) == len(s) and g[1] == s[1] and not g[0].strip() and not g[2].strip()
  2503	
  2504	    # ── 剥空（真代码内容）──
  2505	    for name, src in (
  2506	        ("两层引用围栏", "> > ```\n> > x\n> > ```"),
  2507	        (
  2508	            "列表围栏+缩进内容",
  2509	            "> - ```\n>   未答问题年龄：无据（无带时间戳批注）\n>   ```",
  2510	        ),
  2511	        (
  2512	            "无引用列表围栏+缩进内容",
  2513	            "- ```\n  未答问题年龄：无据（无带时间戳批注）\n- ```",
  2514	        ),
  2515	        (
  2516	            "有序列表围栏+缩进内容",
  2517	            "1. ```\n   > - 来源覆盖率：0/3 成员含来源锚点【实测】\n1. ```",
  2518	        ),
  2519	        ("普通围栏", "```\n本板共有 987654 个子节点\n```"),
  2520	    ):
  2521	        got = rs._strip_code_blocks(src)
  2522	        # ⚠️ 必须用 split("\n") 不能用 splitlines(): 三行全空时结果是 "\n\n",
  2523	        # splitlines() 只给两项——第一次写就踩了，如实留注。
  2524	        assert all(not x.strip() for x in got.split("\n")), f"{name} 未整块剥空: {src!r} → {got!r}"
  2525	
  2526	    # ── 保留（sibling marker 行 = 可见正文）──
  2527	    for name, src in (
  2528	        (
  2529	            "引用内 sibling",
  2530	            "> - ```\n> - 未答问题年龄：无据（无带时间戳批注）\n> - ```",
  2531	        ),
  2532	        ("无引用 sibling", "- ```\n- 本板共有 987654 个子节点\n- ```"),
  2533	    ):
  2534	        got = rs._strip_code_blocks(src)
  2535	        assert mid_kept(got, src), f"{name}: 内容行应保留（可见正文）却被剥: {got!r}"
  2536	
  2537	    # ── 零改动 ──
  2538	    for name, legit in (
  2539	        ("thematic break", "---\n正文\n---"),
  2540	        ("合法二级引用列表", "> > - 合法二级引用列表"),
  2541	        (
  2542	            "合法三级列表",
  2543	            "- 一级\n  - 二级\n    - 三级列表（四空格缩进，合法 Markdown）",
  2544	        ),
  2545	    ):
  2546	        assert rs._strip_code_blocks(legit) == legit, f"{name} 被误剥: {legit!r}"
  2547	    # 三层引用围栏仍剥空
  2548	    p = "> > > "
  2549	    got = rs._strip_code_blocks(f"{p}```\n{p}藏起来的正文\n{p}```")
