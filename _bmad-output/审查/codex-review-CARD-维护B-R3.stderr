   994	                failures += 1
   995	            else:
   996	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   997	
   998	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
