   771	MUTANT_COUNT_EXPECTED = 54
   772	"""变体数的**独立**期望值。
   773	
   774	⛔ 冻结审查 v6：脚本原先只在结尾动态打印「共 N 条」—— 误删一个变体仍会成功退出。
   775	期望值必须来自**另一个来源**才能验伪（本卡反复吃过"期望抄自被测物"的亏）。
   776	改这个数 = 明确声明"我知道自己在增删变体"。
   777	"""
   778	
   779	
   780	def preflight() -> list[str]:
   781	    """开跑前的**锚点预检**（秒级）—— 失败即停，不进 40 分钟长流程。
   782	
   783	    ⛔ 「性质一搬家、旧锚点静默失效」在本卡发生了 **6 次**，每次代价固定：
   784	    改实现 → 跑满一轮 → 跑到那一条才报「未命中」→ 重锚 → 再跑一轮。
   785	    **发现成本远高于修复成本，且发现得越晚越贵。**
   786	
   787	    ⚠️ 能力边界（round-25 声明，round-26 按冻结审查 v7 收紧措辞）：
   788	      · 「恰好命中一次」只证明**文本定位唯一**；
   789	      · 「整组替换后源码确实变化」证明**替换非空**（round-26 新增，此前只比
   790	        `old != new`，而成功消息却宣布了"替换非空" —— 措辞比证据宽）；
   791	      · **不**证明该位置可达、替换非空、或确实禁掉了目标防线 ——
   792	        「锚点仍命中但变异已为空」在本卡真实发生过（见 铁律 4 / 铁律 5）。
   793	      · 它是**必要非充分**条件：能挡住漂移，挡不住空变异。
   794	    """
   795	    bad: list[str] = []
   796	    if len(MUTANTS) != MUTANT_COUNT_EXPECTED:
   797	        bad.append(f"变体数 {len(MUTANTS)} ≠ 期望 {MUTANT_COUNT_EXPECTED}（增删变体须同步改期望值）")
   798	    ids = [n.split()[0] for n, _s, _k in MUTANTS]
   799	    if len(set(ids)) != len(ids):
   800	        dup = sorted({i for i in ids if ids.count(i) > 1})
   801	        bad.append(f"变体 ID 重复: {dup}")
   802	    src = TARGET.read_text(encoding="utf-8")
   803	    for idx, (name, subs, _kw) in enumerate(MUTANTS):
   804	        sid = ids[idx]
   805	        if not subs:
   806	            bad.append(f"{sid}: subs 为空 = 什么都不改")
   807	            continue
   808	        # ⛔ round-26（冻结审查 v7）：原先逐条只比 `old != new`，成功消息却宣布
   809	        #    「替换非空」—— **措辞比证据宽**。改为**按真实顺序模拟整组替换**，
   810	        #    要求最终源码确实变化：这才配得上那句话。
   811	        mutated = src
   812	        for old, new in subs:
   813	            hits = mutated.count(old)
   814	            if hits != 1:
   815	                bad.append(f"{sid}: 锚点命中 {hits} 次（须恰好 1）")
   816	                mutated = None
   817	                break
   818	            mutated = mutated.replace(old, new, 1)
   819	        if mutated is not None and mutated == src:
   820	            bad.append(f"{sid}: 整组替换后源码与原文逐字节相同 = 空变异")
   821	    return bad
   822	
   823	
   824	def main() -> int:
   825	    try:
   826	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   827	    except FileExistsError:
   828	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   829	        return 2
   830	    try:
   831	        _bad = preflight()
   832	        if _bad:
   833	            print("⛔ 锚点预检失败（不跑长流程）：")
   834	            for _b in _bad:
   835	                print("   -", _b)
   836	            return 2
   837	        print(
   838	            f"✅ 锚点预检通过：{len(MUTANTS)} 条变体 —— 锚点均恰好命中一次，"
   839	            "整组替换后源码确实变化（**不**证明该处可达或真禁掉了目标防线）\n"
   840	        )
   841	        original = TARGET.read_bytes()
   842	        backup_sha = hashlib.sha256(original).hexdigest()
   843	
   844	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
