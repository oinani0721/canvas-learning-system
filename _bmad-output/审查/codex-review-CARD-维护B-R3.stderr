  1657	    _scan_number_pool(scan_for_pool, base)
  1658	    pool = set(base)
  1659	    ordered = sorted(base)
  1660	    for i, a in enumerate(ordered):
  1661	        for b in ordered[i:]:
  1662	            pool.add(a + b)
  1663	            pool.add(abs(a - b))
  1664	    return pool
