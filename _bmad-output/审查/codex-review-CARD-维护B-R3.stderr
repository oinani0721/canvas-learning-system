   625	
   626	
   627	def _crash_text(stdout: str, stderr: str | None) -> str:
   628	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   629	
   630	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   631	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   632	    """
   633	    return stdout + "\n" + (stderr or "")
   634	
   635	
   636	def _looks_like_crash(out: str) -> bool:
   637	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   638	
   639	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   640	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   641	
   642	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   643	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   644	        标记出现即判崩溃 —— 不依赖任何渲染格式；
   645	      · **启发式**的那一半：解析外层 pytest 渲染（缩进上界 + assert 白名单），
   646	        绑定 `backend/pytest.ini` 当前的 `--tb=short`。它**会**漏（内层无
   647	        traceback 的崩溃、致命信号）**也会**误报（正文偶然含 traceback 字样）。
   648	        它只是补充，不是判据的主干。
   649	    """
   650	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   651	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   652	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   653	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   654	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   655	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   656	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   657	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   658	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   659	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   660	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   661	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   662	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   663	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   664	    # ⛔ round-21（冻结审查 v3）：上一版号称"可靠二分"，**那个说法不成立**，如实收回。
   665	    #    审查方点名的三条都对：
   666	    #      · 内层 CLI 的无 traceback 崩溃（`SyntaxError` / 致命信号）在外层只剩
   667	    #        一个 `AssertionError` ⇒ 假阴；
   668	    #      · 正文偶然含 `Traceback…` / `N error(s)` ⇒ 假阳；
   669	    #      · 缩进上界是**当前 formatter 的启发式** —— 而且我此前注释说"跑的是
   670	    #        `-q` 默认 tb"是**事实错误**：`backend/pytest.ini` 的 addopts 强制
   671	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   672	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   673	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   674	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   675	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   676	    if CHILD_CRASH_MARK in out:
   677	        return True
   678	    LEGIT_RED = {"assert", "AssertionError"}
   679	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   680	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   681	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   682	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   683	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   684	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   685	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   686	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   687	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   688	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   689	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   690	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   691	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   692	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   693	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   694	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   695	    return bool(
   696	        any(name not in LEGIT_RED for name in exc_names)
   697	        or "Traceback (most recent call last):" in out
   698	        or "INTERNALERROR" in out
   699	        or errors > 0
   700	    )
   701	
   702	
   703	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   704	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   705	
   706	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   707	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   708	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   709	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   710	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   711	    要求"确实收集到用例"且"确实有失败"才算变红。
   712	    """
   713	    r = subprocess.run(
   714	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   715	        cwd=ROOT / "backend",
   716	        capture_output=True,
   717	        text=True,
   718	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   719	        timeout=600,
   720	    )
   721	    out = r.stdout
   722	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   723	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   724	    # ⛔ R3 round-17 (冻结审查 §一.4): 崩溃分析必须看 **stdout + stderr**。
   725	    # 上一版只分析 stdout ⇒ 本域大量门是**跑 CLI 子进程**再核输出的, 子进程的
   726	    # traceback 若只落在 stderr, 外层就只剩一个 AssertionError,
   727	    # 生产崩溃被当成正常"判错变红"。计数仍只从 stdout 取(摘要行在那儿)。
   728	    both = _crash_text(out, r.stderr)
   729	    # ⛔ 铁律 5 (CARD-维护B-R3 round-10, Codex round-8 HIGH-7 实证):
   730	    # 变异必须让被测物**产生错误的判断**, 而不是让它**崩溃**。
   731	    # survivor-20 原版把千分位 pattern 换成无捕获组 lookaround, 却保留生产代码的
   732	    # `r"\1"` replacement ⇒ 一调用就 `re.error: invalid group reference`。
   733	    # 测试确实变红了 —— 但那是**因崩溃变红**, 不是因漏拦变红, 而脚本把任何
   734	    # failure 都记成"承重"。**异常伪红比不变红更坏**: 它会以「✅ 如期变红」
   735	    # 的形式混进证据, 且永远不会有人去查。
   736	    # ⇒ 这里显式识别"变异让生产代码抛异常"的形态并单独报出。
   737	    # ⛔ R3 round-16 (冻结审查 HIGH: 「崩溃假阴存在」): 上一版**枚举**五个异常名,
   738	    # 且只扫**外层 pytest** 的 stdout —— 两个假阴面:
   739	    #   ① 枚举之外的异常 (ValueError / KeyError / IndexError / RecursionError …)
   740	    #      让生产代码崩溃时, 脚本照旧记「✅ 如期变红」;
   741	    #   ② 本域大量门是**跑 CLI 子进程**再核 stdout 的, 子进程里的 traceback
   742	    #      被捕获进断言详情, 外层不出现任何异常名 ⇒ 崩溃完全隐形。
   743	    # ⇒ 改为按**形态**识别, 不再枚举名字:
   744	    #   · pytest 失败详情行 `E   <Exc>: …` —— 除 AssertionError 外一律算崩溃
   745	    #     (断言失败才是「判错」, 其余异常都是「崩坏」);
   746	    #   · 任何位置出现 `Traceback (most recent call last):` —— 覆盖子进程崩溃;
   747	    #   · pytest 自身的 INTERNALERROR / 收集期 error 计数。
   748	    # 假阳边界如实声明: 若某条门**故意**断言输出里含 traceback 文本, 会被误判为
   749	    # 崩溃 —— 那是「宁可误报也不漏报」的方向选择, 且当前目标套件无此形态。
   750	    crash = _looks_like_crash(both)
   751	    return r.returncode, out[-400:], passed + failed, failed, crash
   752	
   753	
   754	MUTANT_COUNT_EXPECTED = 52
   755	"""变体数的**独立**期望值。
   756	
   757	⛔ 冻结审查 v6：脚本原先只在结尾动态打印「共 N 条」—— 误删一个变体仍会成功退出。
   758	期望值必须来自**另一个来源**才能验伪（本卡反复吃过"期望抄自被测物"的亏）。
   759	改这个数 = 明确声明"我知道自己在增删变体"。
   760	"""
   761	
   762	
   763	def preflight() -> list[str]:
   764	    """开跑前的**锚点预检**（秒级）—— 失败即停，不进 40 分钟长流程。
   765	
   766	    ⛔ 「性质一搬家、旧锚点静默失效」在本卡发生了 **6 次**，每次代价固定：
   767	    改实现 → 跑满一轮 → 跑到那一条才报「未命中」→ 重锚 → 再跑一轮。
   768	    **发现成本远高于修复成本，且发现得越晚越贵。**
   769	
   770	    ⚠️ 能力边界（round-25 如实声明，冻结审查 v6 指出）：
   771	      · 「恰好命中一次」只证明**文本定位唯一**；
   772	      · **不**证明该位置可达、替换非空、或确实禁掉了目标防线 ——
   773	        「锚点仍命中但变异已为空」在本卡真实发生过（见 铁律 4 / 铁律 5）。
   774	      · 它是**必要非充分**条件：能挡住漂移，挡不住空变异。
   775	    """
   776	    bad: list[str] = []
   777	    if len(MUTANTS) != MUTANT_COUNT_EXPECTED:
   778	        bad.append(f"变体数 {len(MUTANTS)} ≠ 期望 {MUTANT_COUNT_EXPECTED}（增删变体须同步改期望值）")
   779	    ids = [n.split()[0] for n, _s, _k in MUTANTS]
   780	    if len(set(ids)) != len(ids):
   781	        dup = sorted({i for i in ids if ids.count(i) > 1})
   782	        bad.append(f"变体 ID 重复: {dup}")
   783	    src = TARGET.read_text(encoding="utf-8")
   784	    for name, subs, _kw in MUTANTS:
   785	        for old, new in subs:
   786	            hits = src.count(old)
   787	            if hits != 1:
   788	                bad.append(f"{ids[[n for n, _s, _k in MUTANTS].index(name)]}: 锚点命中 {hits} 次（须恰好 1）")
   789	            elif old == new:
   790	                bad.append(f"{ids[[n for n, _s, _k in MUTANTS].index(name)]}: 替换前后相同 = 空变异")
   791	    return bad
   792	
   793	
   794	def main() -> int:
   795	    try:
   796	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   797	    except FileExistsError:
   798	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   799	        return 2
   800	    try:
   801	        _bad = preflight()
   802	        if _bad:
   803	            print("⛔ 锚点预检失败（不跑长流程）：")
   804	            for _b in _bad:
   805	                print("   -", _b)
   806	            return 2
   807	        print(f"✅ 锚点预检通过：{len(MUTANTS)} 条变体，锚点均恰好命中一次且替换非空\n")
   808	        original = TARGET.read_bytes()
   809	        backup_sha = hashlib.sha256(original).hexdigest()
   810	
   811	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   812	        if rc0 != 0 or f0 or n0 == 0:
   813	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   814	            return 2
   815	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   816	
   817	        failures = 0
   818	        for name, subs, keyword in MUTANTS:
   819	            text = original.decode("utf-8")
   820	            for old, new in subs:
   821	                if old not in text:
   822	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   823	                    failures += 1
   824	                    text = None
   825	                    break
   826	                text = text.replace(old, new, 1)
   827	            if text is None:
   828	                continue
   829	            # ⛔ R3 round-23（冻结审查 v4）：写入原先在 `try` **之前** —— 写到一半抛异常
   830	            #    （磁盘满 / 权限 / 编码）就落不进 finally，变异体留在生产文件里。
   831	            #    把写入挪进 try：从"文件可能已被改动"的第一刻起就有还原兜底。
   832	            #    ⚠️ 如实声明**兜底不到**的情况：SIGKILL / 解释器崩溃 / 断电 ——
   833	            #    Python 层的 finally 对它们无能为力，前后 hash 自检也覆盖不了
   834	            #    （进程都没了）。真正的根治是"改副本不改原件"，属重做设计，未做。
   835	            #    残留检测靠外部锚点：见 MEMORY `reference_mutation_restore_must_be_unconditional`
   836	            #    （grep MUTANT + sha 对比），本脚本自身证明不了这件事。
   837	            try:
   838	                TARGET.write_text(text, encoding="utf-8")
   839	                rc, out, n, f, crash = run_suite(keyword)
   840	            finally:
   841	                TARGET.write_bytes(original)  # 立刻还原，异常也还原
   842	            got = hashlib.sha256(TARGET.read_bytes()).hexdigest()
   843	            assert got == backup_sha, f"还原后字节与备份不同！{got[:12]} != {backup_sha[:12]}"
   844	            # ⛔ 必须是"收集到用例 且 确实有失败"，不能只看 rc != 0
   845	            if n == 0:
   846	                print(f"❌ {name}: `-k {keyword}` 一个用例都没匹配到（rc={rc}）——这不是变红")
   847	                failures += 1
   848	            elif rc != 1:
   849	                # ⛔ R3 round-16 (冻结审查 HIGH): 上一版只要「收集到 且 有失败」就算承重,
   850	                # **不看 rc**。pytest 只有 rc=1 才是「测试失败」; 2=中断 3=内部错
   851	                # 4=用法错 5=没收集到。收集到用例的同时 rc=2/3 (如中途 KeyboardInterrupt
   852	                # 或插件炸) 会让一次**残缺运行**冒充「如期变红」。
   853	                print(f"❌ {name}: rc={rc}（只有 rc=1 才是「测试失败」）——不算变红")
   854	                failures += 1
   855	            elif crash:
   856	                print(
   857	                    f"❌ {name}: 变异让生产代码**抛异常**（输出含 re.error/NameError 等）"
   858	                    f"——这是**因崩溃变红**, 不是因漏拦变红, 不算承重\n{out}"
   859	                )
   860	                failures += 1
   861	            elif f == 0:
   862	                print(f"❌ {name}: 变异后 {n} 个用例仍全绿 = 该门不承重\n{out}")
   863	                failures += 1
   864	            else:
   865	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   866	
   867	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   868	        return 1 if failures else 0
   869	    finally:
   870	        LOCK.rmdir()
   871	
   872	
   873	if __name__ == "__main__":
   874	    sys.exit(main())

