   133	def write_node(
   134	    vault: Path,
   135	    name: str,
   136	    *,
   137	    source_note: str | None = None,
   138	    derived_from: str | None = None,
   139	    tips: list[dict] | None = None,
   140	    stub: bool = False,
   141	) -> None:
   142	    fm = ["---", "type: concept", f'source_board: "[[原白板/{BOARD}]]"']
   143	    if source_note:
   144	        fm.append(f'source_note: "{source_note}"')
   145	    if derived_from:
   146	        fm.append(f'derived-from: "{derived_from}"')
   147	    if tips:
   148	        fm.append("tips:")
   149	        for t in tips:
   150	            fm.append(f"  - text: {t['text']}")
   151	            if t.get("added_at"):
   152	                fm.append(f"    added_at: {t['added_at']}")
   153	            if t.get("understanding"):
   154	                fm.append(f"    understanding: {t['understanding']}")
   155	    fm.append("---")
   156	    body = f"# {name}\n\n## 核心概念\n\n"
   157	    body += "（你的 1-2 句精准定义。）\n" if stub else "已有正文。\n"
   158	    (vault / "节点" / f"{name}.md").write_text("\n".join(fm) + "\n" + body, encoding="utf-8")
   159	
   160	
   161	def build_vault(tmp_path: Path, members: list[str]) -> Path:
   162	    vault = tmp_path / "vault"
   163	    for sub in ("原白板", "节点", "outputs"):
   164	        (vault / sub).mkdir(parents=True)
   165	    links = "\n".join(f"- [[节点/{m}]]" for m in members)
   166	    (vault / "原白板" / f"{BOARD}.md").write_text(
   167	        f"---\ntype: whiteboard\nboard_name: {BOARD}\n---\n\n# {BOARD}\n\n## Concepts\n\n{links}\n",
   168	        encoding="utf-8",
   169	    )
   170	    return vault
   171	
   172	
   173	def standard_vault(tmp_path: Path) -> Path:
   174	    """3 成员: 种子无 provenance + 派生带 source_note + 派生缺 source_note。"""
   175	    vault = build_vault(tmp_path, ["SeedA", "DerivedB", "DerivedC"])
   176	    write_node(
   177	        vault,
   178	        "SeedA",
   179	        tips=[
   180	            {"text": "What is X", "added_at": _ts(11)},

