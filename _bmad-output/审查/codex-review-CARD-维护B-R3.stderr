  1598	
  1599	def _scan_number_pool(obj, pool: set[int]) -> None:
  1600	    """递归收集 scan JSON 里的**数值型**整数 —— D2 的「有出处」判据。
  1601	
  1602	    ⛔ Codex round-1 HIGH: 原实现**也从字符串里抽整数**, 于是池被哈希与用户原话
  1603	    污染 —— 实测「544 个子节点」通过 (544 只来自 board_sha256 的片段)、
  1604	    「111 个子节点」通过 (111 只来自用户作答原话)。池越脏, "有出处"越没意义。
  1605	    现在只收 JSON 的**数值类型**; 字符串里真正该被绑定的量 (日期/哈希/原话)
  1606	    要么由 E1-E6 豁免, 要么本来就不该被当成本报告的计数陈述。
  1607	    """
  1608	    if isinstance(obj, bool):
  1609	        return
  1610	    if isinstance(obj, int):
  1611	        pool.add(obj)
  1612	    elif isinstance(obj, float):
  1613	        if obj.is_integer():
  1614	            pool.add(int(obj))
  1615	    elif isinstance(obj, dict):
  1616	        for v in obj.values():
  1617	            _scan_number_pool(v, pool)
  1618	    elif isinstance(obj, list):
  1619	        for v in obj:
  1620	            _scan_number_pool(v, pool)
  1621	
