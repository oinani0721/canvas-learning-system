  1745	def _visible_text(line: str) -> str:
  1746	    """源码行 → **读者在 Obsidian 里看到的文本**（本域收敛器，非完整渲染器）。
  1747	
  1748	    顺序有讲究（每一步都对应前几轮的一条实测 HIGH）：
  1749	      1. **先解 HTML 实体**再做全角转换 —— 反过来会让 `&#xff19;` 解出 `９`
  1750	         之后再没有机会转成 ASCII（round-5 HIGH-3 实测）;
  1751	      2. 剥 HTML 标签 —— `<b>` 长度不限, 原先只有 ≤22 字符的短标签算连接字符;
  1752	      3. wikilink 取**显示文本** —— 有别名取别名, 无别名取目标本身
  1753	         （原实现把无别名链接的目标挖空, 而那正是读者看到的字, round-5 HIGH-8）;
  1754	      3b. link 三形态按 **inline → reference → shortcut** 顺序剥 —— shortcut 式
  1755	         方括号最宽, 放最后才不会把 inline/reference 的显示文本先吃掉留下裸 url;
  1756	      4. 去零宽/双向控制字符;
  1757	      5. 去强调标记 `*_` 与成对 `~~` —— ⚠️ 未配对时渲染**可见**, 去掉它们是一个
  1758	         **已知 fail-open 面**而非安全边界（`1\\*5个` 按 15 入池，池含 15 并不能
  1759	         证明读者看到的 `1*5` 有出处）。此前写的「安全向、不构成虚构通道」**已被
  1760	         证伪**，round-13 的试修亦实测无收益并已回退。如实登记，不再声称安全。
  1761	
  1762	    ⚠️ **不碰 inline code**: `` `…` `` 的内容在本域是**有意豁免**的字段值
  1763	    （E2, 见 _blank_inline_code），不是"被隐藏的计数"。这是**声明过的设计选择**,
  1764	    不是遗漏 —— 如实登记在验收单, 不在这里悄悄改语义。
  1765	    """
  1766	    line = html.unescape(line)
  1767	    # ⛔ R3 round-25（冻结审查 v6）：`html.unescape` 会把 `&#10;` / `&#13;` /
  1768	    #    `&NewLine;` 解成**真换行** ⇒ 一行变多行，`_visible_block` 号称的
  1769	    #    「行数与顺序不变」当场失效，而 seed 的 raw/visible **按下标配对**
  1770	    #    正依赖这个不变式。⇒ 行内解出的换行一律折成空格：单行的渲染结果
  1771	    #    仍是单行，不变式才是真的。
  1772	    line = line.replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
  1773	    line = line.translate(_FULLWIDTH_DIGITS)
  1774	    line = _VIS_TAG_RE.sub("", line)
  1775	    line = _VIS_WIKILINK_ALIAS_RE.sub(r"\1", line)
  1776	    line = _VIS_WIKILINK_PLAIN_RE.sub(r"\1", line)
  1777	    line = _VIS_MDLINK_RE.sub(r"\1", line)
  1778	    line = _VIS_REFLINK_RE.sub(r"\1", line)
  1779	    line = _VIS_SHORTCUT_LINK_RE.sub(r"\1", line)
  1780	    line = _VIS_INVISIBLE_RE.sub("", line)
  1781	    line = _VIS_STRIKE_RE.sub("", line)
  1782	    return _VIS_EMPHASIS_RE.sub("", line)
  1783	
  1784	
  1785	def _visible_block(text: str) -> str:
  1786	    """整块文本的**渲染后**形态：逐行过 `_visible_text` 再拼回去。
  1787	
  1788	    ⛔ 这个模式在本卡出现了**四次**（③段信号行选行 / 五元组 / 台账种子行的
  1789	    值绑定与形状门），每次都是"某处判据还在源码文本上做，而同一条内容的另一道
  1790	    检查已经在渲染文本上做"。⇒ 提为**单一应用点**，新增消费方直接用它。
  1791	
  1792	    ⚠️ 逐行归一后拼接，**行数与顺序不变** —— 依赖 `^...$` 多行锚点的正则
  1793	    （段落抓取、整行 fullmatch）可以直接换用它而不改语义。
  1794	    """
  1795	    return "\n".join(_visible_text(ln) for ln in text.splitlines())
  1796	
  1797	
  1798	def _normalize_number_seps(line: str) -> str:
  1799	    """千分位分隔符归一 —— **D2 与 fallback 共用**。
  1800	
  1801	    ⛔ R3 round-4: 原先只在 D2 路径做, 且只认半角 `,` ——
  1802	    `987654，000个`(全角逗号) 在 D2 侧只被取到 `000`;
  1803	    `#### 派生子女 1,005 个` 在 fallback 侧被拆成 [1, 5] 逐片碰池 (实测 exit 0)。
  1804	    ⚠️ 必须**删掉**分隔符而不是换成空格: 换成空格会让它落进连接集,
  1805	    虽然仍能拼回, 但诊断里会出现带空格的原串, 与"读者看到的数"错位。
  1806	    """
  1807	    # ⛔ R3 round-6: 解 HTML 实体已上移到 _visible_text() —— 两个消费点都在最前面
  1808	    # 跑它, 此处再解一次是**冗余**（且 `&amp;#46;` 会被双重解码成 `.`, 反而错）。
  1809	    # 一个性质只应有一个实现位置; 留在这里就是死代码。
  1810	    # ⛔ R3 round-5 (Codex round-4 HIGH-3): 逗号两侧也可能夹连接字符 ——
  1811	    # `987654<b>,</b>000个` 渲染成 `987654,000个`, 原式(要求逗号紧邻数字)不命中。
  1812	    return re.sub(
  1813	        rf"([0-9]){_D2_JOIN_ONE}*[,，'’]{_D2_JOIN_ONE}*(?=[0-9]{{3}}(?![0-9]))",
  1814	        r"\1",
  1815	        line,
  1816	    )
  1817	
  1818	
  1819	def _count_token_value(token: str) -> int | None:
  1820	    """剥过连接字符的计数 token → int; **无法确定就 None**(不猜)。
  1821	
  1822	    只两种情形给值:
