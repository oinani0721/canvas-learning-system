  4214	        "Obsidian callout 头不是链接语法，剥掉会改变段落语义"
  4215	    )
  4216	    assert rs._visible_text("脚注[^1]在此") == "脚注[^1]在此"
  4217	
  4218	    # ② CLI：shortcut link 藏起来的可见计数必须被拦
  4219	    vault = standard_vault(tmp_path)
  4220	    scan = collect_json(vault)
  4221	    assert 987654 not in rs._derived_number_pool(scan)
  4222	    report = write_report(vault, scan)
  4223	    base_text = report.read_text(encoding="utf-8")
  4224	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4225	    text = base_text.replace(
  4226	        "## 三维审查",
  4227	        "## 三维审查\n\n- 本板总[计]987654个子节点。【实测】",
  4228	        1,
  4229	    )
