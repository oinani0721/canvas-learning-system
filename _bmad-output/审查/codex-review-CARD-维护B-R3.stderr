  4577	def test_domain_r18_crash_judge_indent_and_child_stderr():
  4578	    """R3 round-20（冻结审查 v2 §四.4）：崩溃判据的假阳面 + 内层 stderr 接线。
  4579	
  4580	    两条判词都成立：
  4581	      · 只要「紧跟冒号」仍假阳 —— 断言消息的续行 `E       Expected: 3` 同样是
  4582	        「标识符+冒号」。实测 pytest 语法：顶层行是 `E` + **3 个空格**，
  4583	        续行缩进更深（`E     VERIFY…` 5 格 / `E    +  where` 4 格）；
  4584	      · 内层 CLI 以 `capture_output=True` 执行、断言只带 `r.stdout` ⇒
  4585	        子进程 traceback 若只在 stderr，**外层两路输出里根本不会出现**。
  4586	
  4587	    **它证明什么**：缩进上界 3 格 + 紧跟冒号两条件同时成立才判异常；
  4588	    `run_verify` 已把子进程 stderr 打到测试 stdout（pytest 失败时展示）。
  4589	    **它不证明什么**：这套解析**不是可靠二分**（round-21 如实收回该说法）——
  4590	    pytest 的缩进随 tb 风格而变，本仓 `backend/pytest.ini` 的 addopts 强制
  4591	    `--tb=short`（我此前注释写的『-q 默认 tb』是**事实错误**）。内层无
  4592	    traceback 的崩溃仍会假阴、正文偶含 traceback 字样仍会假阳。
  4593	    确定性的那一半由 `[[CHILD-CRASH]]` 标记承担，解析只是补充。
  4594	    """
  4595	    import importlib.util as _ilu
  4596	
  4597	    _prev = sys.dont_write_bytecode
  4598	    sys.dont_write_bytecode = True
  4599	    try:
  4600	        _spec = _ilu.spec_from_file_location(
  4601	            "negverify_ut2", pathlib.Path(__file__).with_name("recap_domain_negverify.py")
  4602	        )
  4603	        _nv = _ilu.module_from_spec(_spec)
  4604	        _spec.loader.exec_module(_nv)
  4605	    finally:
  4606	        sys.dont_write_bytecode = _prev
  4607	
  4608	    for out, want, why in (
  4609	        ("E   AssertionError: x", False, "顶层断言异常"),
  4610	        ("E   assert 0 != 0", False, "顶层裸 assert"),
  4611	        ("E     VERIFY FAIL (1 项)", False, "续行（5 格）"),
  4612	        ("E    +  where 0 = C(", False, "assert 重写的 where 行（4 格）"),
  4613	        ("E       Expected: 3", False, "续行里的『标识符+冒号』—— 只靠冒号会假阳"),
  4614	        ("E       Actual: 4", False, "同上"),
  4615	        ("E   re.error: bad", True, "顶层异常"),
  4616	        ("E   SystemExit: 2", True, "不以 Error/Exception 结尾"),
  4617	        ("E   subprocess.TimeoutExpired: t", True, "点分名"),
  4618	        ("E   Exception: boom", True, "裸 Exception"),
  4619	        ("E   Failed: 夹具坏", True, "pytest.fail = 夹具坏了"),
  4620	        ("E   RecursionError", True, "无消息异常：没有冒号，靠缩进上界识别"),
  4621	        # 缩进上界实现接受 1-3 格；实测形态是 3 格（本仓 pytest.ini 强制 --tb=short）。
  4622	        # 1/2 格没有实测样本，但判为异常是**保守方向**，这里显式锁住行为。
  4623	        ("E ValueError: x", True, "1 格缩进（无实测样本，保守判为异常）"),
  4624	        ("E  KeyError: x", True, "2 格缩进（同上）"),
  4625	        # 确定性标记优先于一切启发式
  4626	        ("[[CHILD-CRASH]] rc=1", True, "子进程崩溃的确定性标记"),
  4627	        ("1 passed", False, "对照：没有标记也没有异常行"),
  4628	        ("  Traceback (most recent call last):", True, "任意位置的 traceback"),
  4629	        ("INTERNALERROR> x", True, "pytest 内部错"),
  4630	        ("1 error, 260 passed", True, "收集期 error"),
  4631	        ("1 failed, 260 passed", False, "纯失败摘要"),
  4632	    ):
  4633	        assert _nv._looks_like_crash(out) is want, f"崩溃判据判错: {why} | {out!r}"
  4634	
  4635	    # transport：外层 stderr 不得被丢弃（合成输入，只测 helper 本身）
  4636	    assert _nv._looks_like_crash(_nv._crash_text("1 failed, 260 passed", "Traceback (most recent call last):")), (
  4637	        "外层 stderr 仍被丢弃"
  4638	    )
  4639	    # ⛔ 真实接线由 r19 用 monkeypatch 哨兵验证 —— 这里**不再**读自己的源码查字符串。
  4640	    #    那种写法是恒真的（要找的串就在断言那一行里），round-21 实测：删掉
  4641	    #    run_verify 里真正的调用点，门仍 2 passed。本卡第三次踩同款。
  4642	
  4643	
  4644	def test_domain_r19_child_stderr_transport_is_real(capsys, monkeypatch, tmp_path):
  4645	    """R3 round-21：`run_verify` 必须**真的**调用 `_surface_child_stderr`。
  4646	
  4647	    ⛔ round-20 这里写的是 `assert "_surface_child_stderr(r)" in <本文件源码>` ——
  4648	    **恒真**：要找的字符串就在断言那一行里。round-21 实测验伪：把 `run_verify`
  4649	    里真正的调用点删掉，门仍 **2 passed**。这是本卡**第三次**踩同一款
  4650	    （#23 自抄期望 / round-15 自比常量 / 本条自读源码）。
  4651	    ⇒ 改为 monkeypatch 哨兵：替换掉接线函数本体，跑一次真实 `run_verify`，
  4652	    断言哨兵**被调用过**且拿到的是那个 CompletedProcess。删掉调用点 = 门变红。
  4653	
  4654	    **它证明什么**：接线真实存在；且 stderr 非空时会打出 `[child stderr]`，
  4655	    出现 traceback 时额外打确定性标记 `[[CHILD-CRASH]]`。
  4656	    **它不证明什么**：不证明每条门都会触发它（取决于被测 CLI 是否真的崩）。
  4657	    """
  4658	    import subprocess as _sp
  4659	
  4660	    # ① 接线：run_verify 必须调用它（哨兵，不是读源码字符串）
  4661	    called: list = []
  4662	    monkeypatch.setattr(sys.modules[__name__], "_surface_child_stderr", lambda r: called.append(r))
  4663	    vault = standard_vault(tmp_path)
  4664	    scan = collect_json(vault)
  4665	    report = write_report(vault, scan)
  4666	    run_verify(report)
  4667	    assert len(called) == 1, "run_verify 未调用 _surface_child_stderr（接线断了）"
  4668	    assert isinstance(called[0], _sp.CompletedProcess), "哨兵拿到的不是子进程结果"
  4669	    monkeypatch.undo()
  4670	
  4671	    # ② 函数本体：空 stderr 不出声；有 traceback 时打确定性标记
  4672	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=1, stdout="", stderr=""))
  4673	    assert capsys.readouterr().out == "", "stderr 为空时不得产生噪声"
  4674	
  4675	    _surface_child_stderr(
  4676	        _sp.CompletedProcess(
  4677	            args=["x"],
  4678	            returncode=1,
  4679	            stdout="",
  4680	            stderr="Traceback (most recent call last):\n  RecursionError: x\n",
  4681	        )
  4682	    )
  4683	    out = capsys.readouterr().out
  4684	    assert CHILD_CRASH_MARK in out, "子进程崩溃未打确定性标记 ⇒ 下游只能靠解析渲染猜"
  4685	    assert "[child stderr]" in out, "子进程 stderr 未被抬到测试 stdout"
  4686	
  4687	    # ③ 无 traceback 的 stderr（如告警）不得误打崩溃标记
  4688	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=0, stdout="", stderr="DeprecationWarning: x\n"))
  4689	    out2 = capsys.readouterr().out
  4690	    assert CHILD_CRASH_MARK not in out2, "普通 stderr 被误标成崩溃"
  4691	    assert "[child stderr]" in out2
