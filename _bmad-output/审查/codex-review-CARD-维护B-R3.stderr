  2172	    # 静默 return; 段落标题的整行锚定另在 _verify_report 收口。
  2173	    recon = re.search(
  2174	        _SECTION_RE("## AI 侧对账") + r"(.*?)(?=^#{2}(?:[^\S\n]|$)|\Z)",
  2175	        text,
  2176	        re.M | re.S,
  2177	    )
  2178	    if not recon:
  2179	        problems.append(
  2180	            "数字终核: 未找到『## AI 侧对账』段 (标题须为段名本身或段名+（补充）) "
  2181	            "— tips 两数无法绑定"
