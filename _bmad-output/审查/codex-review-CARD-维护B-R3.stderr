  2294	            problems.append(f"数字终核: AI 侧对账缺『{name}』标准计数行")
  2295	        elif len(in_sec) > 1:
  2296	            problems.append(
  2297	                f"数字终核: AI 侧对账段内出现 {len(in_sec)} 条『{name}』(只许一条)"
