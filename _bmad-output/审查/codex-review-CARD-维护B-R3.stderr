   477	
   478	def run_suite(keyword: str) -> tuple[int, str, int, int]:
   479	    """跑目标用例，返回 (rc, 输出尾部, 收集到的用例数, 失败数)。
   480	
   481	    ⛔ Codex round-1 HIGH: 原实现只看 `rc != 0` 就判「如期变红」——
   482	    pytest 的 rc=5 是**一个用例都没匹配到**（`-k` 写错就会这样），
   483	    rc=2/3/4 是用法错误/内部错误。把它们当成"门变红了"正是
   484	    MEMORY `reference_gate_design_pitfalls` 的头号形态：
   485	    **把「没有发生」当成「验证通过」**。现在解析出真实的 passed/failed 计数，
   486	    要求"确实收集到用例"且"确实有失败"才算变红。
   487	    """
   488	    r = subprocess.run(
   489	        [str(PYTEST), SUITE, "-q", "-p", "no:cacheprovider", "-k", keyword],
   490	        cwd=ROOT / "backend",
   491	        capture_output=True,
   492	        text=True,
   493	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   494	        timeout=600,
   495	    )
   496	    out = r.stdout
   497	    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
   498	    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
   499	    return r.returncode, out[-400:], passed + failed, failed
   500	

