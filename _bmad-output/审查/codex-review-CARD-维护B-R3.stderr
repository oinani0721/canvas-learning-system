   922	def main() -> int:
   923	    try:
   924	        LOCK.mkdir()  # 原子互斥: 已存在即抛
   925	    except FileExistsError:
   926	        print(f"⛔ 另一个负验证进程正在跑（锁: {LOCK}）。变异脚本必须串行——见脚本 docstring。")
   927	        return 2
   928	    try:
   929	        _bad = preflight()
   930	        if _bad:
   931	            print("⛔ 锚点预检失败（不跑长流程）：")
   932	            for _b in _bad:
   933	                print("   -", _b)
   934	            return 2
   935	        print(
   936	            f"✅ 锚点预检通过：{len(MUTANTS)} 条变体 —— 锚点均恰好命中一次，"
   937	            "整组替换后源码确实变化（**不**证明该处可达或真禁掉了目标防线）\n"
   938	        )
   939	        original = TARGET.read_bytes()
   940	        backup_sha = hashlib.sha256(original).hexdigest()
   941	
   942	        rc0, out0, n0, f0, _c0 = run_suite("domain_")
   943	        if rc0 != 0 or f0 or n0 == 0:
   944	            print(f"⛔ 基线不可信（rc={rc0} 收集={n0} 失败={f0}）:\n{out0}")
   945	            return 2
   946	        print(f"基线: 双向门全绿 · 被测文件 sha256={backup_sha[:12]}…\n")
   947	
   948	        failures = 0
   949	        for name, subs, keyword in MUTANTS:
   950	            text = original.decode("utf-8")
   951	            for old, new in subs:
   952	                if old not in text:
   953	                    print(f"❌ {name}: 变异点未命中（实现已变？）——按失败计")
   954	                    failures += 1
