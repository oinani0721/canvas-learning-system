  3346	        text = base_text.replace(anchor, injected, 1)
  3347	        assert text != base_text, "变异未命中：报告一字未改，这条门测的是空气"
  3348	        report.write_text(text, encoding="utf-8")
  3349	        return run_verify(report)
  3350	
  3351	    def d2(line: str):
