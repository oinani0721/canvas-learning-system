   927	                failures += 1
   928	            else:
   929	                print(f"✅ {name}: 如期变红（{f}/{n} 失败）")
   930	
   931	        print(f"\n{'全部承重' if not failures else f'{failures} 条未承重'}（共 {len(MUTANTS)} 条变体）")
   932	        return 1 if failures else 0
   933	    finally:
   934	        LOCK.rmdir()
