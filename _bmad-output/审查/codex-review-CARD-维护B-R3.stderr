  2615	        #    survivor-35 变成**空变异**（那道门自己的 `_visible_text(ln)` 成了冗余）。
  2616	        seed_vis = _visible_block(text)
  2617	        mseed = re.search(
  2618	            r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", seed_vis, re.M | re.S
  2619	        )
  2620	        if mseed:
