  4669	
  4670	    # ① 接线：run_verify 必须调用它（哨兵，不是读源码字符串）
  4671	    called: list = []
  4672	    monkeypatch.setattr(sys.modules[__name__], "_surface_child_stderr", lambda r: called.append(r))
  4673	    vault = standard_vault(tmp_path)
  4674	    scan = collect_json(vault)
  4675	    report = write_report(vault, scan)
  4676	    returned = run_verify(report)
