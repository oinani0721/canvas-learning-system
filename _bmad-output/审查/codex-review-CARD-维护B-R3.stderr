  2335	    sig = (scan.get("signals") or {}).get("unsourced_conclusions") or {}
  2336	    m7 = re.compile(r"^[>\s]*(?:(?P<n>\d+)\s*个)?派生角色成员缺来源锚点")
  2337	    for ln in text.splitlines():
  2338	        # ⛔ R3 round-19 (冻结审查 §一.3): 这里原先在 **raw** 行上匹配, 而同一条
  2339	        # 叙述的措辞白名单 (:2437) 早已改在 _visible_text 上判 —— 两侧口径分叉 ⇒
  2340	        # 「白名单放行、N 绑定跳过」的夹缝: 三条实测 exit 0
  2341	        #   · `999 个派**生**角色成员缺来源锚点。`
  2342	        #   · `999 个派<b>生</b>角色成员缺来源锚点。`
