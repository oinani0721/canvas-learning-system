   623	def _crash_text(stdout: str, stderr: str | None) -> str:
   624	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   625	
   626	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   627	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   628	    """
   629	    return stdout + "\n" + (stderr or "")
   630	
   631	
   632	def _looks_like_crash(out: str) -> bool:
   633	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   634	
   635	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   636	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   637	
   638	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   639	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   640	        标记出现即判崩溃 —— 不依赖任何渲染格式；

