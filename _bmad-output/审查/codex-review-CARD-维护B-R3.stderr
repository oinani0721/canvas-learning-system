  4654	def test_domain_r19_child_stderr_transport_is_real(capsys, monkeypatch, tmp_path):
  4655	    """R3 round-21：`run_verify` 必须**真的**调用 `_surface_child_stderr`。
  4656	
  4657	    ⛔ round-20 这里写的是 `assert "_surface_child_stderr(r)" in <本文件源码>` ——
  4658	    **恒真**：要找的字符串就在断言那一行里。round-21 实测验伪：把 `run_verify`
  4659	    里真正的调用点删掉，门仍 **2 passed**。这是本卡**第三次**踩同一款
  4660	    （#23 自抄期望 / round-15 自比常量 / 本条自读源码）。
  4661	    ⇒ 改为 monkeypatch 哨兵：替换掉接线函数本体，跑一次真实 `run_verify`，
  4662	    断言哨兵**被调用过**且拿到的是那个 CompletedProcess。删掉调用点 = 门变红。
  4663	
  4664	    **它证明什么**：接线真实存在；且 stderr 非空时会打出 `[child stderr]`，
  4665	    出现 traceback 时额外打确定性标记 `[[CHILD-CRASH]]`。
  4666	    **它不证明什么**：不证明每条门都会触发它（取决于被测 CLI 是否真的崩）。
  4667	    """
  4668	    import subprocess as _sp
  4669	
  4670	    # ① 接线：run_verify 必须调用它（哨兵，不是读源码字符串）
  4671	    called: list = []
  4672	    monkeypatch.setattr(sys.modules[__name__], "_surface_child_stderr", lambda r: called.append(r))
  4673	    vault = standard_vault(tmp_path)
  4674	    scan = collect_json(vault)
  4675	    report = write_report(vault, scan)
  4676	    returned = run_verify(report)
  4677	    assert len(called) == 1, "run_verify 未调用 _surface_child_stderr（接线断了）"
  4678	    # ⚠️ round-23：必须断言**同一个对象**。原先只验「是某个 CompletedProcess」，
  4679	    #    那不能排除接线接到了另一次调用的结果上（措辞比证据宽）。
  4680	    assert called[0] is returned, "哨兵拿到的不是 run_verify 返回的那个子进程结果"
  4681	    monkeypatch.undo()
  4682	
  4683	    # ② 函数本体：空 stderr 不出声；有 traceback 时打确定性标记
  4684	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=1, stdout="", stderr=""))
  4685	    assert capsys.readouterr().out == "", "stderr 为空时不得产生噪声"
  4686	
  4687	    _surface_child_stderr(
  4688	        _sp.CompletedProcess(
  4689	            args=["x"],
  4690	            returncode=1,
  4691	            stdout="",
  4692	            stderr="Traceback (most recent call last):\n  RecursionError: x\n",
  4693	        )
  4694	    )
  4695	    out = capsys.readouterr().out
  4696	    assert CHILD_CRASH_MARK in out, "子进程崩溃未打确定性标记 ⇒ 下游只能靠解析渲染猜"
  4697	    assert "[child stderr]" in out, "子进程 stderr 未被抬到测试 stdout"
  4698	
  4699	    # ③ 无 traceback 的 stderr（如告警）不得误打崩溃标记
  4700	    _surface_child_stderr(_sp.CompletedProcess(args=["x"], returncode=0, stdout="", stderr="DeprecationWarning: x\n"))
  4701	    out2 = capsys.readouterr().out
  4702	    assert CHILD_CRASH_MARK not in out2, "普通 stderr 被误标成崩溃"
  4703	    assert "[child stderr]" in out2
  4704	
