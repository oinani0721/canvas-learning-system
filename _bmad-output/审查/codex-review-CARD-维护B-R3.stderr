   784	    )
   785	    candidates = []
   786	    outputs_resolved = outputs.resolve()
   787	    for p in outputs.iterdir():
   788	        m = pattern.match(p.name)
   789	        if not m:
   790	            continue
   791	        date = m.group(1)
   792	        if _parse_dt(date) is None or date > today:
   793	            continue
   794	        # B2 二轮: 文件级 symlink 越界候选不参选 (跨 vault 读 previous recap)
   795	        try:
   796	            if not p.resolve().is_relative_to(outputs_resolved):
