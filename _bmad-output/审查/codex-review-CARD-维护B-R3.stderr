  1601	        return
  1602	    if isinstance(obj, int):
  1603	        pool.add(obj)
  1604	    elif isinstance(obj, float):
  1605	        if obj.is_integer():
  1606	            pool.add(int(obj))
  1607	    elif isinstance(obj, dict):
  1608	        for v in obj.values():
  1609	            _scan_number_pool(v, pool)
  1610	    elif isinstance(obj, list):
  1611	        for v in obj:
  1612	            _scan_number_pool(v, pool)
