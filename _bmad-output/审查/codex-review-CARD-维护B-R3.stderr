   669	def _crash_text(stdout: str, stderr: str | None) -> str:
   670	    """崩溃分析的**输入面**: stdout + stderr 一起看。
   671	
   672	    提成纯函数是为了让"有没有把 stderr 丢掉"能被行为门直接测 ——
   673	    藏在 run_suite 里就只能靠读源码, 而 transport 缺失**不会**让任何测试变红。
   674	    """
   675	    return stdout + "\n" + (stderr or "")
   676	
   677	
   678	def _looks_like_crash(out: str) -> bool:
   679	    """pytest 输出 → 这次「变红」是不是**崩溃**造成的（而非判错）。
   680	
   681	    提成纯函数是为了能被 `test_recap_scan_signals.py` 逐形态单测 ——
   682	    藏在 `run_suite` 里就只能靠肉眼，而崩溃伪红**唯一的症状就是显示 ✅**。
   683	
   684	    ⚠️ **能力边界（round-21 如实声明，不再自称可靠二分）**：
   685	      · **确定性**的那一半：子进程崩溃由测试侧在源头打 `[[CHILD-CRASH]]` 标记，
   686	        标记出现即判崩溃 —— 不依赖任何渲染格式；
   687	      · **启发式**的那一半：解析外层 pytest 渲染（缩进上界 + assert 白名单），
   688	        绑定 `backend/pytest.ini` 当前的 `--tb=short`。它**会**漏（内层无
   689	        traceback 的崩溃、致命信号）**也会**误报（正文偶然含 traceback 字样）。
   690	        它只是补充，不是判据的主干。
   691	    """
   692	    # ⛔ R3 round-17 (冻结审查 §一.4): 上一版号称「从名单改形态」, 其实只是把名单
   693	    # 从**全名**换成了**后缀** —— `(?:[Ee]rror|Exception)` 仍是一张我手写的闭表,
   694	    # 漏掉 `SystemExit` / `subprocess.TimeoutExpired` / 裸 `Exception` 以外的一切
   695	    # 不以 Error/Exception 结尾的异常。这是本项目记账过的「枚举 vs 结构」第四次。
   696	    # ⇒ 判据反过来写: 枚举的不是**异常空间**(开放), 而是 **pytest 自己的"判错"
   697	    #   词汇表**(封闭, 由 pytest API 定义): 断言失败只会以 `assert` / `AssertionError`
   698	    #   开头。除此之外任何出现在 `E ` 详情行首的标识符都是"崩坏"。
   699	    # ⛔ R3 round-17 二修（实测 39/44 假阳）: 上一版写成 `^E\s+<标识符>`, 以为那是
   700	    # 「异常行」—— 其实 pytest 给失败详情的**每一行**都加 `E ` 前缀, 于是断言消息
   701	    # 的续行 `E     VERIFY FAIL (1 项) …` 被当成异常 `VERIFY`, 44 条变体里 39 条
   702	    # 被误判成崩溃。**修严引入松、修松引入严**, 两次的病根都是没去读 pytest 的
   703	    # 真实输出语法。实测语法: 异常行是 `E   <类名>: <消息>` —— 标识符后**紧跟冒号**;
   704	    # 断言是 `E   assert …` 或 `E   AssertionError: …`; 续行则是缩进的自由文本。
   705	    # ⇒ 加上"紧跟冒号"这一条, 两个方向同时收敛(负控见 r13 门的 16 条形态)。
   706	    # ⛔ round-21（冻结审查 v3）：上一版号称"可靠二分"，**那个说法不成立**，如实收回。
   707	    #    审查方点名的三条都对：
   708	    #      · 内层 CLI 的无 traceback 崩溃（`SyntaxError` / 致命信号）在外层只剩
   709	    #        一个 `AssertionError` ⇒ 假阴；
   710	    #      · 正文偶然含 `Traceback…` / `N error(s)` ⇒ 假阳；
   711	    #      · 缩进上界是**当前 formatter 的启发式** —— 而且我此前注释说"跑的是
   712	    #        `-q` 默认 tb"是**事实错误**：`backend/pytest.ini` 的 addopts 强制
   713	    #        `--tb=short`。实测的 3 格是**那个配置下**的形态，不是普适规律。
   714	    #    ⇒ 结构调整：**子进程崩溃改由源头打确定性标记**（见 test 侧
   715	    #      `CHILD_CRASH_MARK`），标记出现即权威判定；下面这套解析 pytest 渲染的
   716	    #      规则**降级为补充启发式**，只用于捕捉外层自身抛出的异常。
   717	    CHILD_CRASH_MARK = "[[CHILD-CRASH]]"
   718	    if CHILD_CRASH_MARK in out:
   719	        return True
   720	    LEGIT_RED = {"assert", "AssertionError"}
   721	    # ⛔ round-20 (冻结审查 v2 §四.4): 只要"紧跟冒号"仍会假阳 —— 断言消息的
   722	    #    续行 `E       Expected: …` 同样是"标识符+冒号"。实测 pytest 语法:
   723	    #    顶层行是 `E` + **3 个空格** + 内容(异常行与 `assert` 行都是),
   724	    #    续行则缩进**更深**(`E     VERIFY…` 5 格 / `E    +  where` 4 格)。
   725	    #    ⇒ 缩进上界 3 格 + 紧跟冒号, 两个条件一起才是异常行。
   726	    #    这条规则的规格书是 pytest 的真实输出, 不是我对它的印象 —— 本判据
   727	    #    已在这个方向上错过两次(枚举后缀=假阴, 任意标识符=假阳 39/44)。
   728	    # ⛔ round-20 二修（变异 C 存活 + 冻结审查 v2 的第三条判词）:
   729	    #    加了缩进上界之后, "紧跟冒号"这个条件**既多余又有害** ——
   730	    #    · 多余: 续行缩进 ≥4 格, 上界已经把它们排除, 冒号不再承担区分职责
   731	    #      (实测: 去掉冒号后 mutC 不再让任何门变红 ⇒ 那条变异已不承重);
   732	    #    · 有害: **无消息异常**打出来是 `E   RecursionError`(没有冒号),
   733	    #      要求冒号 = 漏掉整整一类崩溃(假阴)。
   734	    #    ⇒ 只留缩进上界 + LEGIT_RED 白名单。判据的两个条件里, 承重的是缩进。
   735	    exc_names = re.findall(r"^E {1,3}([A-Za-z_][\w.]*)\b", out, re.M)
   736	    errors = sum(int(m) for m in re.findall(r"(\d+) error(?:s)?\b", out))
   737	    return bool(
   738	        any(name not in LEGIT_RED for name in exc_names)
   739	        or "Traceback (most recent call last):" in out
   740	        or "INTERNALERROR" in out
   741	        or errors > 0
   742	    )
   743	
