  4702	def test_domain_r20_seed_ledger_visible_in_manifest_cli(tmp_path):
  4703	    """R3 round-22（冻结审查 v3）：台账种子行的 raw/visible 夹缝 —— **manifest 模式**。
  4704	
  4705	    ⛔ 这条推翻了我 round-19 的「实测不成立」。当时我在 **fallback** 模式下测，
  4706	    冲突行会撞上那里的整行形状门 ⇒ 看起来 fail-closed。审查方指出
  4707	    **manifest 模式没有那层门** —— 实测两条 exit 0 放行：
  4708	
  4709	      · `- SeedA — 批**注** 999 条`
  4710	      · `- SeedA — 批<b>注</b> 999 条`
  4711	
  4712	    形态与 ③段信号行、五元组的双行逃逸**完全相同**（留一条正确行 + 加一条渲染
  4713	    等价但源码不命中的冲突行）。这是同一形态在本卡的**第三次**命中。
  4714	
  4715	    **它证明什么**：种子行的段抓取与行匹配都在渲染文本上做；两个消费方
  4716	    （`_verify_seed_ledger_counts` 的值绑定 + fallback 的整行形状门）同口径。
  4717	    **它不证明什么**：`_visible_block` 仍不是完整 renderer；③标题与 tips 的
  4718	    同型攻击在两种模式下都未复现（**未复现 ≠ 安全**，如实登记）。
  4719	    """
  4720	    vault = standard_vault(tmp_path)
  4721	    mpath = make_manifest(vault)
  4722	    scan = collect_json(vault, "--manifest", str(mpath))
  4723	    assert scan.get("data_mode") == "manifest", "前提：本门测的是 manifest 路径"
  4724	
  4725	    report = write_report(vault, scan)
  4726	    base = report.read_text(encoding="utf-8")
  4727	    assert run_verify(report).returncode == 0, "基线报告本身就不过 verifier"
  4728	
  4729	    ms = re.search(r"^### 种子\s*$(.*?)(?=^#{2,3}[^\S\n]|\Z)", base, re.M | re.S)
  4730	    assert ms, "前提：报告必须含『### 种子』小节"
  4731	    seed = [ln for ln in ms.group(1).splitlines() if ln.strip() and "批注" in ln]
  4732	    assert seed, "前提：种子小节必须含带批注数的行"
  4733	    good = seed[0]
  4734	    n = re.search(r"批注\s*(\d+)\s*条", good)
  4735	    assert n, f"前提：种子行必须含批注数: {good!r}"
  4736	
  4737	    def with_conflict(broken: str):
  4738	        conflict = good.replace("批注", broken, 1).replace(f"{n.group(1)} 条", "999 条")
  4739	        text = base.replace(good, good + "\n" + conflict, 1)
  4740	        assert text != base, "注入未命中：报告一字未改，这条门测的是空气"
  4741	        report.write_text(text, encoding="utf-8")
  4742	        return run_verify(report), conflict
  4743	
  4744	    for broken, why in (("批**注**", "强调标记切开"), ("批<b>注</b>", "HTML 标签切开")):
  4745	        r, conflict = with_conflict(broken)
  4746	        assert r.returncode != 0, f"种子行双行逃逸（{why}）被放行 —— {conflict!r}"
  4747	
  4748	    # 不得误伤：把**正确行本身**写成渲染等价的强调形态，仍须通过
  4749	    report.write_text(base.replace(good, good.replace("批注", "批**注**", 1), 1), encoding="utf-8")
  4750	    assert run_verify(report).returncode == 0, "渲染等价的合规种子行被误判"
  4751	
  4752	    # 单一应用点：四处消费方必须都走 _visible_block（漂移即被抓）
  4753	    rs = _load_recap_scan()
  4754	    assert callable(getattr(rs, "_visible_block", None)), "共用 helper 不存在 ⇒ 又会各自 join 一遍"
  4755	    assert rs._visible_block("a**b**\n<c>d</c>") == "ab\nd", "helper 行为不符（行数/顺序必须不变）"
  4756	    # ⚠️ round-23：上一版这句「四处消费方都走 helper」**当时不成立**（③段信号行
  4757	    #    还在逐行 `_visible_text`）。生产已统一，这里按**调用点计数**锁住，
  4758	    #    漂移（有人又写回内联 join）即被抓。
  4759	    _src = pathlib.Path(rs.__file__).read_text(encoding="utf-8")
  4760	    assert _src.count("_visible_block(") >= 5, "_visible_block 的消费方少于预期（定义 1 + 消费 4）⇒ 有人写回了内联 join"
  4761	    # ⚠️ 判据必须**计数**，不能靠「删掉函数名再查子串」—— 删名字不删函数体，
