  2050	        "--board", help="原白板文件名 stem (非显示名; 禁路径分隔符; 收集模式必填)"
  2051	    )
  2052	    ap.add_argument(
  2053	        "--manifest",
  2054	        default=None,
  2055	        help="get_board_manifest 返回体: '-' 从 stdin 读, 或 JSON 文件路径; 缺省 = fallback 本地扫描",
  2056	    )
  2057	    ap.add_argument(
  2058	        "--date",
  2059	        default=None,
  2060	        help="回顾日期 YYYY-MM-DD (缺省 = 本机今日), 用于幂等检测与报告文件名",
  2061	    )
  2062	    ap.add_argument(
  2063	        "--verify",
  2064	        default=None,
  2065	        metavar="REPORT_MD",
  2066	        help="Step 5.5 机械自检: 校验已写好的报告, 全过 exit 0; 与收集模式互斥",
  2067	    )
  2068	    args = ap.parse_args()
  2069	
  2070	    if args.verify:
  2071	        return _verify_report(args.verify)
  2072	    if not args.vault or not args.board:
  2073	        ap.error("收集模式需要 --vault 与 --board (或改用 --verify <report.md>)")
  2074	
  2075	    vault = Path(args.vault)
  2076	    board_dir = vault / "原白板"
  2077	    if not board_dir.is_dir():
  2078	        print(
  2079	            json.dumps(
  2080	                {"error": f"vault 不可用: {board_dir} 不存在"}, ensure_ascii=False
  2081	            )
  2082	        )
  2083	        return 2
  2084	    # B2 二轮: 目录级 symlink 守卫 — 原白板/节点/outputs 任一被换成指向
  2085	    # vault 外 (如 sibling vault) 的目录 symlink, 一切 containment 都会被
  2086	    # 架空 → 环境不可用, 拒绝扫描。
  2087	    vault_resolved = vault.resolve()
  2088	    for sub in ("原白板", "节点", "outputs"):
  2089	        d = vault / sub
