  1876	def _verify_report(path: str) -> int:
  1877	    """Step 5.5 机械自检 (确定性 verifier — LLM 自检不可靠, 命令输出才算数)。
  1878	
  1879	    ✗ 任一条 → exit 1, skill 必须改写报告重跑本命令; 全 ✓ → exit 0 才许发回执。
  1880	    """
  1881	    try:
  1882	        text_raw = Path(path).read_text(encoding="utf-8")
  1883	    except (OSError, UnicodeDecodeError) as e:
  1884	        print(f"✗ 报告不可读: {type(e).__name__}")
  1885	        return 1
  1886	    # 八轮顺序修正: 栅栏在**原始文本**上判定 — 先剥注释会把
  1887	    # "---<!--x-->" 这类非法闭合行洗成合法 "---" (清洗旁路)。
  1888	    # 闭合栅栏必须是整行 --- (行尾至多空白, 七轮), 无合法闭合 = 缺块。
  1889	    fm_m = re.match(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", text_raw, re.S)
  1890	    if not fm_m:
  1891	        print("✗ 报告缺 frontmatter 块")
  1892	        return 1
  1893	    fm = fm_m.group(1)
  1894	    # frontmatter 块内禁 HTML 注释标记 — 注释跨栅栏/贴栅栏正是清洗旁路的
  1895	    # 载体, 合法报告的 frontmatter 里没有任何理由出现它。

