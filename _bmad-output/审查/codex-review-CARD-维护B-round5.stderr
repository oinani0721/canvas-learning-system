  2044	def main() -> int:
  2045	    ap = argparse.ArgumentParser(
  2046	        description="board-recap 确定性收集器 + 报告 verifier (只读, 输出 JSON / 校验行)"
  2047	    )
  2048	    ap.add_argument("--vault", help="vault 根目录绝对路径 (收集模式必填)")
