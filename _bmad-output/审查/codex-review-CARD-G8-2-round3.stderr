   867	def test_no_duplicate_test_names():
   868	    """⛔ 防回归门 (round-2 收官自审发现): 同名测试函数后定义覆盖前定义 ——
   869	    pytest 收集只报一个, 被覆盖的判别力静默消失 (三变异 SURVIVED 的真凶)。
   870	    本文件任何 test_* 重名 = 直接红。"""
   871	    import ast as _ast
   872	
   873	    tree = _ast.parse(Path(__file__).read_text(encoding="utf-8"))
   874	    names = [
   875	        n.name
   876	        for node in _ast.walk(tree)
   877	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef))
   878	        for n in [node]
   879	        if n.name.startswith("test_")
   880	    ]
   881	    dupes = sorted({n for n in names if names.count(n) > 1})
   882	    assert dupes == [], f"存在重名测试 (后定义静默覆盖前定义): {dupes}"

