   536	# ---------------------------------------------------------------------------
   537	# 检查 2 — raw_derived_confusion
   538	# ---------------------------------------------------------------------------
   539	def check_raw_derived(vault: Path) -> CheckResult:
   540	    """派生物混入 raw/wiki 区 (读 G8-1 台账) + `回顾-*.md` 缺 recap frontmatter。
   541	
   542	    数据来自 `check_vault_doc_roles.scan(..., with_probe=False)` —— **不重新实现**台账语义。
   543	
   544	    采信的 finding 子集 `CONFUSION_CODES` 与理由:
   545	      G1 未登记目录        新目录未被任何 dir_glob 命中 = 新的一类文档混进 vault, role 未定
   546	      G2 未登记根级文件    同上, 根级面
   547	      G3 frontmatter type 不在其归属条目白名单内 —— **本子集的核心**: `节点/`(role=wiki)
   548	                          的白名单是 concept/(none), 一个 `type: recap` 的派生物混进去
   549	                          正是"raw-derived 混淆"的机械定义
   550	      G4 doc_type 野值     type 落在 rag_index 覆盖面下却不在白名单 = 野值入库面
   551	      G9 未登记根级 md     落到兜底行但未逐个登记 —— 兜底行断不了 owner/role/retention
   552	
   553	    **不**计入的 code 与理由 (不是漏掉, 是语义不同, 但仍在 notes 里报出):
   554	      G8/G10/G11 是**扫描面**问题 (symlink 子树未递归 / 枚举失败 / 越界), 不是混淆;
   555	                 但绝不能不报 —— 否则 "0 finding" 是"没看见"而不是"没问题"
   556	      G5/G6/G7   需要真实准入函数求值 (probe 档), 本脚本因零写铁律走 with_probe=False,
   557	                 **本次未验证**, 报告逐次声明
   558	
   559	    ⛔ 判 fail 的只有一种情况: 台账契约本身坏了 (load_rules 抛 ConfigError) —— 那时
   560	       抛 `LintConfigError` 走退出码 3, 不在本函数里伪装成一条 finding。
   561	    """
   562	    try:
   563	        data = cvr.load_rules()
   564	    except cvr.ConfigError as exc:
   565	        raise LintConfigError(f"G8-1 台账不可用 ({exc}) —— raw_derived 检查无法进行") from exc
   566	    try:
   567	        res = cvr.scan(data, vault, with_probe=False)
   568	    except cvr.ConfigError as exc:
   569	        raise LintConfigError(str(exc)) from exc
   570	
   571	    findings = [
   572	        Finding(fd.subject, f"[{fd.code}] {fd.detail}")
   573	        for fd in res.findings
   574	        if fd.code in CONFUSION_CODES and fd.blocking
   575	    ]
   576	    exempted = sum(1 for fd in res.findings if fd.code in CONFUSION_CODES and not fd.blocking)
   577	
   578	    # 回顾报告的 recap frontmatter (台账管不到的一条: 文件名前缀 → 期望 type)
   579	    recap_bad = 0
   580	    recap_blind: dict[str, str] = {}
   581	    for md in _iter_md(vault):
   582	        if not md.name.startswith(RECAP_PREFIX):
   583	            continue
   584	        # ⛔ 与 orphan 同一条边界守卫 (Codex round-2 HIGH-1 第三旁路):
   585	        #    指向 vault 外的 回顾-* symlink 会被 read_frontmatter_type 跟随读取 ——
   586	        #    先拦截记盲区, 不读不判 (越界细节由 G8-1 的 G10/G11 判红)。
   587	        blocked = _scan_block_reason(vault, md)
   588	        if blocked:
   589	            recap_blind[md.relative_to(vault).as_posix()] = blocked
   590	            continue
   591	        # parser=None: 强制走 cvr 的保守回落解析, 不 import 写侧 (jieba 会写临时缓存)
   592	        ftype = cvr.read_frontmatter_type(md, parser=None)
   593	        if ftype != "recap":
   594	            recap_bad += 1
   595	            findings.append(
   596	                Finding(
   597	                    md.relative_to(vault).as_posix(),
   598	                    f"`{RECAP_PREFIX}*` 回顾报告的 frontmatter type={ftype!r}, 期望 'recap' "
   599	                    f"—— 派生报告不带派生标记, 会被当成用户 wiki 内容",
   600	                )
   601	            )
   602	    notes: list[str] = [
   603	        f"采信 finding 子集: {'/'.join(CONFUSION_CODES)}; 台账 = {cvr.ROLES_YAML.name} (SHA 契约已校验)",
   604	        "本次**未验证** G5/G6/G7 (台账双列与真实准入函数是否一致) —— 需 probe 档, "
   605	        "而 probe 的 import 链会写系统临时缓存, 与本卡零写铁律冲突",
   606	    ]
   607	    if recap_blind:
   608	        notes.append(
   609	            "recap 扫描盲区 (未读未判): "
   610	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(recap_blind.items())[:5])
   611	        )
   612	    blind = [fd for fd in res.findings if fd.code in BLIND_SPOT_CODES]
   613	    if blind:
   614	        notes.append(
   615	            f"扫描面问题 {len(blind)} 条 (不计入 finding, 但结论按此打折): "
   616	            + "; ".join(f"[{fd.code}] {fd.subject}" for fd in blind[:5])
   617	        )
   618	    if exempted:
   619	        notes.append(f"另有 {exempted} 条命中子集但被台账 known_gaps 豁免, 未计入")
   620	    for msg in res.info:
   621	        notes.append(f"台账扫描 info: {msg}")
   622	
   623	    return CheckResult(
   624	        name="raw_derived_confusion",
   625	        status=WARN if findings else OK,
   626	        summary=f"{res.files_seen} 文件 / {res.dirs_seen} 目录, {len(findings)} 条混淆 (含 {recap_bad} 条 recap 标记缺失)",
   627	        findings=findings,
   628	        notes=notes,
   629	        details={
   630	            "files_seen": res.files_seen,
   631	            "dirs_seen": res.dirs_seen,
   632	            "codes_counted": list(CONFUSION_CODES),
   633	            "recap_missing_type": recap_bad,
   634	            "recap_blind": dict(sorted(recap_blind.items())),
   635	            "blind_spots": len(blind),
   636	            "probe_skipped": res.probe_skipped,
   637	        },
   638	    )
   639	
   640	
   641	# ---------------------------------------------------------------------------
   642	# 检查 3 — projection_freshness
   643	# ---------------------------------------------------------------------------
   644	def _is_stale(generated_at: Any, today: date) -> bool:
   645	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   646	
   647	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   648	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   649	    都按 stale 降级, 绝不逃逸成异常。
   650	    """
   651	    stale = True
   652	    try:
   653	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   654	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   655	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   656	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   657	        stale = True
   658	    return stale
   659	
   660	

 succeeded in 0ms:
   221	        f"{c(DIM, 'today')} {report.today} ({_DISPLAY_TZ_NAME})",
   222	    ]
   223	    for chk in report.checks:
   224	        out.append(f"{TAG} {chk.name} status={c(hue[chk.status], chk.status)} {chk.summary}")
   225	        for note in chk.notes:
   226	            out.append(f"    {c(DIM, 'note  ' + note)}")
   227	        for fd in chk.findings:
   228	            out.append(f"    - {fd.subject}\n      {fd.detail}")
   229	    for name in report.skipped:
   230	        out.append(f"{TAG} {name} status=skipped (--only 未选中; **未跑, 非 ok**)")
   231	    rc = exit_code(report)
   232	    tail = {EXIT_OK: (GREEN, "全部检查 ok"), EXIT_WARN: (YELLOW, "有 warn"), EXIT_FAIL: (RED, "有 fail")}[rc]
   233	    out.append(f"{TAG} exit={rc} {c(tail[0], tail[1])}")
   234	    return "\n".join(out)
