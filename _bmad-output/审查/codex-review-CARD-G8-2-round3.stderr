   661	def _projection_status(vault: Path, today: date) -> tuple[str, str | None, Any]:
   662	    """→ (status, error, generated_at)。status 词汇与 oracle `_vault_entry` **完全一致**:
   663	    `no_projection` / `corrupt` / `stale` / `ok` —— 同源锁据此逐字比对。
   664	
   665	    ⛔ corrupt 面**比 oracle 窄**, 如实声明: oracle 在 stale 判定之前还要过
   666	       `_summarize()` 的严格 v3 形状门禁 (schema_version==3 / 五个容器形状 /
   667	       boards·buckets 对账 / 非有限数拒收…), 任何不符即 corrupt。本函数**不复制**
   668	       那几百行 (复制必漂, 且 W6 独占该文件), 只覆盖四类:
   669	       读不出 / 不是 JSON object / 缺 generated_at 键 / generated_at 非字符串
   670	       (最后这类的同语义是实测钉的: int 20260831 → oracle=corrupt, 不是 stale)。
   671	       故同源锁只在**合法 v3 投影**上成立; 其余形状垃圾面两侧可能分歧
   672	       (oracle=corrupt, 本函数可能=stale/ok) —— 验收单「不比什么」表登记。
   673	    """
   674	    proj = vault.joinpath(*_PROJECTION_REL)
   675	    raw = _read_text(proj)
   676	    if raw is None:
   677	        if not proj.exists():
   678	            return "no_projection", None, None
   679	        return "corrupt", "读取失败 (非 UTF-8 / 权限)", None
   680	    try:
   681	        payload = json.loads(raw)
   682	    except (ValueError, RecursionError) as e:
   683	        return "corrupt", f"{type(e).__name__}: {str(e)[:200]}", None
   684	    if not isinstance(payload, dict):
   685	        return "corrupt", "投影根节点不是 JSON object", None
   686	    if "generated_at" not in payload:
   687	        return "corrupt", "投影缺 generated_at 字段", None
   688	    gen = payload["generated_at"]
   689	    # oracle 的 `_summarize` (:678-680) 对非字符串 generated_at 抛 ValueError → corrupt
   690	    # (实测: int 20260831 → oracle=corrupt 而非 stale)。必须同语义, 否则同源锁在此分叉。
   691	    if not isinstance(gen, str):
   692	        return "corrupt", f"generated_at 应为字符串, 实为 {type(gen).__name__}", None
   693	    return ("stale" if _is_stale(gen, today) else "ok"), None, gen
