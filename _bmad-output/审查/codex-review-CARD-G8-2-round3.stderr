   861	    assert vl.exit_code(report) == vl.report_to_json(report)["summary"]["exit_code"]
   862	    # orphan 检查的如实性: 节点数必须与 live 实况一致 (probe-F 实测 14)
   863	    orphan = next(c for c in report.checks if c.name == "orphan_nodes")
