   402	def _iter_md(root: Path) -> list[Path]:
   403	    """目录下全部 md 候选 (排序稳定, 扩展名大小写不敏感, symlink 含 dangling 保留在列)。
   404	
   405	    - suffix.lower() == ".md" 与 check_vault_doc_roles.py:1001 同口径 —— 本卡 round-2
   406	      前用 rglob("*.md"), 对 `.MD` 文件两边存在性判定不一致 (Codex round-1 MEDIUM-1a)。
   407	    - `is_file() or is_symlink()`: dangling symlink 的 is_file()==False, 只用 is_file()
   408	      会把它**静默滤掉** → "0 盲区" 是"没看见" (Codex round-2 HIGH-1 第二旁路)。
   409	      保留在列后由调用方的 `_scan_block_reason` 拦截并记盲区。
   410	    ⛔ rglob 会跟随**目录** symlink 递归 —— 其后代不是 symlink 却越界, 必须由调用方
   411	      对每个文件跑 `_scan_block_reason` (Codex round-2 HIGH-1 第一旁路)。
   412	    """
   413	    if not root.is_dir():
   414	        return []
   415	    return sorted(
   416	        p for p in root.rglob("*")
   417	        if (p.is_file() or p.is_symlink()) and p.suffix.lower() == ".md"
   418	    )
