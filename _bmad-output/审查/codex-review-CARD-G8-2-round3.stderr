   462	
   463	def render_block(members: list[Member], synced: str) -> list[str]:
   464	    body = [m.render() for m in members] if members else [_EMPTY_HINT]
   465	    return [
   466	        _SENTINEL_BEGIN,
   467	        _SENTINEL_NOTE,
   468	        *body,
   469	        f"<!-- /AUTO-GENERATED n={len(members)} · synced {synced} -->",
   470	    ]
   471	
   472	
   473	def _strip_stamp(lines: list[str]) -> list[str]:
   474	    """比对用视图: 把 `<!-- /AUTO-GENERATED ... -->` 尾行归一掉时间戳。
   475	
   476	    ⛔ 尾行含 synced 时间戳, 参与比对会让 --check 永远报漂移 (幂等锁失效)。
   477	    内容没变就整个不写盘 → 时间戳自然保持不动, 「有变更才刷戳」。
   478	    """
