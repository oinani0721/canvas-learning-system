   118	_WIKILINK = re.compile(r"\[\[([^\]\n]+)\]\]")
   119	_FRONTMATTER = re.compile(r"^﻿?---\r?\n(.*?)\r?\n---[ \t]*\r?\n?(.*)$", re.S)
   120	
   121	NODE_DIR = "节点"
   122	BOARD_DIR = "原白板"
   123	EXAM_DIR = "检验白板"
   124	RECAP_PREFIX = "回顾-"
   125	
   126	#: raw-derived 混淆采信的 G8-1 finding code 子集 (选取理由见 `check_raw_derived`)
   127	CONFUSION_CODES = ("G1", "G2", "G3", "G4", "G9")
   128	#: 报出但**不计入** finding 的扫描面 code —— "0 finding" 必须能与 "没看见" 区分开
   129	BLIND_SPOT_CODES = ("G8", "G10", "G11")
   130	
   131	
   132	class LintConfigError(RuntimeError):
   133	    """配置或环境错误 → 退出码 3 (lint 自己没跑成, 不是 vault 有问题)。"""
   134	
