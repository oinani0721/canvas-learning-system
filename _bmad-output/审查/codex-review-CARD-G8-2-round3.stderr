   740	def run_checks(vault: Path, today: date, *, only: list[str] | None = None) -> LintReport:
   741	    """跑选中的检查。`only=None` = 全跑。未跑的检查进 `skipped`, **不伪造 ok**。"""
   742	    if not vault.is_dir():
   743	        raise LintConfigError(f"vault 根目录不存在: {vault}")
   744	    selected = list(CHECKS) if not only else [n for n in CHECKS if n in only]
   745	    checks: list[CheckResult] = []
   746	    for name in selected:
   747	        if name == "orphan_nodes":
   748	            checks.append(check_orphan_nodes(vault))
   749	        elif name == "raw_derived_confusion":
   750	            checks.append(check_raw_derived(vault))
   751	        elif name == "projection_freshness":
   752	            checks.append(check_projection_freshness(vault, today))
   753	    return LintReport(
   754	        vault=str(vault),
   755	        today=today.isoformat(),
   756	        checks=checks,
   757	        skipped=[n for n in CHECKS if n not in selected],
   758	    )
