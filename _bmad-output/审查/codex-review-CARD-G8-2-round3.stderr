   578	def test_resolve_today_default_is_shanghai_not_host_local(monkeypatch):
   579	    """Codex round-1 MEDIUM-2 + round-2 MEDIUM-2: 环境无关地锁死默认分支的时区语义。
   580	
   581	    手法: 把 vl 命名空间的 datetime 类整个换成固定钟 (不读系统钟), 并把
   582	    _TZ_SHANGHAI 换成 New York (UTC-5) —— 判别锚 = **时区对象本身**, 与宿主
   583	    TZ/当前日期无关:
   584	      - `astimezone(宿主本地)` mutant → NY 语义丢失 → 得 UTC 日 → 红;
   585	      - `_utcnow().date()` mutant → 完全绕过时区 → 得 UTC 日 → 红;
   586	      - `date.today()` mutant → 读系统真实钟 (宿主 +08 的今天) ≠ NY 日 → 红。
   587	    """
   588	    from datetime import datetime as real_datetime
   589	    from zoneinfo import ZoneInfo
   590	
   591	    class _FrozenDT(real_datetime):
   592	        @classmethod
   593	        def now(cls, tz=None):  # noqa: ARG003
   594	            return cls(2026, 8, 31, 23, 0, tzinfo=timezone.utc)  # UTC 23:00 → NY 18:00 同日
   595	
   596	    ny = ZoneInfo("America/New_York")
   597	    monkeypatch.setattr(vl, "datetime", _FrozenDT)
   598	    monkeypatch.setattr(vl, "_TZ_SHANGHAI", ny)
   599	    assert vl.resolve_today(None) == date(2026, 8, 31), (
   600	        "默认分支必须按 _TZ_SHANGHAI (此处=NY) 换算: UTC 23:00 = NY 18:00 = 08-31; "
   601	        "宿主本地/UTC 直取/date.today() 等变异会给出不同结果"
   602	    )
   603	
