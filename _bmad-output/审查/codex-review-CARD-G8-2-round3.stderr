   237	# ---------------------------------------------------------------------------
   238	# 共用只读 helpers
   239	# ---------------------------------------------------------------------------
   240	def _scan_block_reason(vault: Path, path: Path) -> str | None:
   241	    """扫描读取的统一边界守卫: 返回拦截原因; None = 可以读。
   242	
   243	    覆盖 (Codex round-2 HIGH-1 的三条旁路, 复用 G8-1 的 G11 判据 `cvr.
   244	    _resolves_inside_vault` —— realpath 展开整条 symlink 链):
   245	      - 文件自身是 symlink (无论指内指外, 保守拒读);
   246	      - **祖先链上有 symlink** (目录 symlink 指向 vault 外时, 其后代文件自身
   247	        is_symlink()==False, 只有整链 realpath 才能识破);
   248	      - 解析后越出 vault (含 `..` 穿越、dangling 指外)。
   249	    dangling 指内的文件 resolve 在内但读不了 → 由 `_read_text` 的 OSError 分支记盲区。
   250	    """
   251	    if path.is_symlink():
   252	        return "symlink"
   253	    try:
   254	        rel = path.relative_to(vault).as_posix()
   255	    except ValueError:
   256	        return "outside-vault"
   257	    if not cvr._resolves_inside_vault(vault, rel):
   258	        return "resolves-outside-vault"
   259	    return None
   260	
   261	
   262	def _read_text(path: Path) -> str | None:
   263	    """严格 UTF-8 只读。读不了返回 None (调用方登记为扫描盲区, 不静默当空)。
   264	
   265	    ⛔ symlink 一律拒绝读 (Codex round-1 HIGH-1): 文件 symlink 会被 is_file() 接纳并
   266	    跟随到 vault 外 —— 外部内容里的 wikilink 能藏住真孤儿。指 vault 内的 symlink
   267	    同样拒读 (保守, 方向 = 报盲区不假绿)。祖先链/越界由 `_scan_block_reason` 在
   268	    调用方先行拦截并记盲区 —— 本函数只是最后一道。
   269	    """
   270	    if path.is_symlink():
   271	        return None
   272	    try:
   273	        return path.read_text(encoding="utf-8")
   274	    except (OSError, UnicodeDecodeError, ValueError):
   275	        return None
   276	
   277	
   278	def _split_frontmatter(text: str) -> tuple[str, str]:
   279	    """→ (frontmatter 块, 正文)。复制 sync_board_concepts.py:51/:62-64 的窄解析。"""
   280	    m = _FRONTMATTER.match(text)
   281	    return (m.group(1), m.group(2)) if m else ("", text)
   282	
   283	
   284	def _fm_scalar(fm: str, key: str) -> str | None:
   285	    """顶层标量取值。复制 sync_board_concepts.py:67-86 的语义。
   286	
   287	    `^key:` 不容前导空白 → 天然排除嵌套同名键; 取**最后一个**同名 key (YAML 后者胜);
   288	    剥行内注释 (引号包裹的值里 `#` 不算注释)。
   289	    ⛔ YAML null 语义 (Codex round-1 MEDIUM-1b + round-2 MEDIUM-1): 只认**裸** null 字面
   290	    (null/Null/NULL/~), 且必须在剥引号**之前**判 —— `source_board: "null"` 是字面
   291	    字符串 "null" (YAML 引号 = 强制字符串), 不是 null。不含 "none": PyYAML 把
   292	    `none` 解析为普通字符串, 吞掉它 = 比 YAML 更宽 = 会误豁免真的叫 "none" 的值。
   293	    """
   294	    matches = re.findall(rf"^{re.escape(key)}:[ \t]*(.*)$", fm, re.M)
   295	    if not matches:
   296	        return None
   297	    v = matches[-1].strip()
   298	    if v in ("null", "Null", "NULL", "~"):
   299	        return None  # 裸 null 字面 (先于剥引号 —— 引号包裹的是字符串, 不是 null)
   300	    if not (v.startswith(('"', "'")) and v.endswith(('"', "'"))):
   301	        v = re.sub(r"\s+#.*$", "", v)
   302	    v = v.strip().strip('"').strip("'")
   303	    return v or None
   304	
   305	
   306	def _norm_key(name: str) -> str:
   307	    """入链匹配键: NFC 归一 + casefold。
   308	
   309	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   310	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   311	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   312	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   313	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   314	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   315	    (假阴)。该权衡进验收单「不比什么」表。
   316	    """
   317	    return unicodedata.normalize("NFC", name).casefold().strip()
   318	
   319	
   320	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   321	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   322	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   323	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   324	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   325	
   326	
   327	def _strip_nonsemantic(body: str) -> str:
   328	    """剥离正文里**非语义**的 wikilink 载体 (Codex round-1 HIGH-2/HIGH-4 +
   329	    round-2 HIGH-4 整改)。
   330	
   331	    两段式 (round-2 教训: 行级剥 span 会把跨行 span 的**另一半**留在别行,
   332	    拼回后已无反引号对可配 —— 剥不到):
   333	      1. 行级状态机只管**按行判定的**结构: AUTO-GENERATED 哨兵段 (BEGIN→END 整段)
   334	         与 fenced code (CommonMark: closing fence 同字符且长度 ≥ opener ——
   335	         四反引号栏内的三反引号不关闭围栏), 命中行整行丢弃;
   336	      2. 拼回后文件级剥 code span (`+...`+ 可跨行) 与 HTML 注释
   337	         (<!-- --> 跨行; **未闭合**按 CommonMark 剥到 EOF)。
   338	
   339	    live 复算 (Codex round-1): 14 个节点的入链全部同时来自 source_board 与自动
   340	    成员块, 去掉 AUTO 后 3 个节点没有其他入链 —— 陈旧自动块绝不能豁免孤儿。
   341	
   342	    ⛔ 如实登记的剩余缝隙 (Codex round-2 HIGH-4 末项, 不处理): AUTO 段与围栏**交叉**
   343	    的对抗构造 (手改哨兵块再夹围栏) —— 真实生成器不产出此形态, 哨兵块明写"⛔ 请勿
   344	    手改", 解析按 AUTO 段优先; 该构造性前提登记进验收单「不比什么」。
   345	    """
   346	    out_lines: list[str] = []
   347	    fence_re: re.Pattern[str] | None = None  # closing fence 全文匹配 (同字符 ≥ opener 长)
   348	    in_auto = False
   349	    for line in body.splitlines():
   350	        stripped = line.strip()
   351	        if in_auto:
   352	            if _AUTO_END_RE.match(stripped):
   353	                in_auto = False
   354	            continue  # 哨兵段内整行丢弃 (含 BEGIN/END 行本身)
   355	        if _AUTO_BEGIN_RE.match(stripped):
   356	            in_auto = True
   357	            continue
   358	        if fence_re is not None:
   359	            if fence_re.fullmatch(stripped):
   360	                fence_re = None
   361	            continue  # 围栏内整行丢弃
   362	        m = re.match(r"^(`{3,}|~{3,})", stripped)
   363	        if m:
   364	            fence_re = re.compile(re.escape(m.group(1)[0]) + "{%d,}" % len(m.group(1)))
   365	            continue
   366	        out_lines.append(line)
   367	    text = "\n".join(out_lines)
   368	    # 文件级: code span (可跨行) + HTML 注释 (跨行; 未闭合剥到 EOF)
   369	    text = re.sub(r"<!--.*?-->|<!--.*\Z", "", text, flags=re.S)
   370	    text = re.sub(r"`+[^`]*`+", " ", text, flags=re.S)
   371	    return text
   372	
   373	
   374	def _wikilink_targets(body: str) -> set[str]:
   375	    """正文里全部 wikilink 的 basename 集合 (已归一)。先经 `_strip_nonsemantic`。
   376	
   377	    解析规则复制自 `canvas-vault/.claude/scripts/sync_board_concepts.py:49/:125`
   378	    (`_WIKILINK` + `wikilink_basename`) 与 `board_manifest_service.py:132`
   379	    (`resolve_node_id`) —— 三者本就同规则。
   380	
   381	    ⛔ **复制而非 import**, 理由是零写铁律: `sync_board_concepts.py` 位于 **live vault 内**
   382	       (`canvas-vault/.claude/scripts/`), import 它会在缺省时往 **live vault 里**写
   383	       `__pycache__` —— 一个只读审计器绝不该改被审对象。
   384	       (MEMORY `reference_importlib_pycache_writes_into_vault` 记的就是这个坑。)
   385	       复制的代价 = 会漂; 故 `test_vault_lint.py` 有**同源锁**: 对同一批输入断言
   386	       本函数的 basename 与真实 `wikilink_basename` / `resolve_node_id` 逐字相等。
   387	
   388	    覆盖形态 (各有测试用例): `[[x]]` / `[[x|别名]]` / `[[节点/x]]` / `![[x]]` (embed —
   389	    `!` 在捕获组外, 天然命中) / `[[x#小节]]` / `[[x#^块]]` / `[[x.md]]` (含 `.MD` 大写,
   390	    Codex round-1 MEDIUM-1a)。**不**覆盖: 围栏/行内 code、HTML 注释 (含 AUTO 哨兵块)、
   391	    跨行 `[[..]]`、空 `[[]]` —— 全部判定为非入链。
   392	    """
   393	    out: set[str] = set()
   394	    for raw in _WIKILINK.findall(_strip_nonsemantic(body)):
   395	        inner = raw.split("|", 1)[0].split("#", 1)[0].split("/")[-1].strip()
   396	        inner = re.sub(r"\.md\Z", "", inner, flags=re.IGNORECASE)
   397	        if inner:
   398	            out.add(_norm_key(inner))
   399	    return out
   400	
