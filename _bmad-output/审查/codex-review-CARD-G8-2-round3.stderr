   853	def test_live_vault_readonly_and_runs():
   854	    if not _LIVE_VAULT.is_dir():
   855	        pytest.skip(f"live vault 不可达: {_LIVE_VAULT}")
   856	    before = _vault_digest(_LIVE_VAULT)
