   696	def check_projection_freshness(vault: Path, today: date) -> CheckResult:
   697	    """`outputs/今日复习.json` 的 generated_at 是否是上海本地的今日。
   698	
   699	    状态分级 (**待用户裁决**):
   700	      ok            → ok
   701	      stale         → warn  (只是今天还没跑推送, 不是坏)
   702	      no_projection → warn  (该 vault 从没跑过推送 —— 新 vault 的正常初态)
   703	      corrupt       → fail  (投影文件坏了, 下游 Web UI / 推送会拿不到数据 = 真故障)
   704	    """
   705	    status, error, gen = _projection_status(vault, today)
   706	    mapped = {"ok": OK, "stale": WARN, "no_projection": WARN, "corrupt": FAIL}[status]
   707	    detail = {
   708	        "ok": f"generated_at={gen!r} 是 {today} 的投影",
   709	        "stale": f"generated_at={gen!r} 不是 {today} ({_DISPLAY_TZ_NAME}) 的投影",
   710	        "no_projection": f"{'/'.join(_PROJECTION_REL)} 不存在 —— 该 vault 尚未跑过推送",
   711	        "corrupt": f"投影不可用: {error}",
   712	    }[status]
   713	    findings = [] if status == "ok" else [Finding("/".join(_PROJECTION_REL), detail)]
   714	    return CheckResult(
   715	        name="projection_freshness",
   716	        status=mapped,
   717	        summary=f"projection_status={status}",
   718	        findings=findings,
   719	        notes=[
   720	            "口径复制自 review_overview.py:845-860 (`_vault_entry` 内联逻辑, 无可 import 的函数; "
   721	            "该文件 W6 独占禁改), 由 test_vault_lint.py 的同源锁绑定",
   722	            "不比: corrupt 面比 oracle 窄 —— 本检查不复现 `_summarize()` 的 v3 形状门禁, "
   723	            "只判 读不出/非 object/缺 generated_at",
   724	        ],
   725	        details={"projection_status": status, "generated_at": gen, "error": error},
   726	    )
