   605	def test_cli_help_writes_no_pyc_without_env(tmp_path):
   606	    """Codex round-1 BLOCKER-1 的行为门 + round-2 MEDIUM-4:
   607	    无 PYTHONDONTWRITEBYTECODE 时 CLI 直跑 --help 也不得写任何 .pyc
   608	    (隔离副本上实测, 生产 guard 行被删时本门必红)。
   609	    副本三件套 (vault_lint + cvr + yaml) 同目录 —— vault_lint 以自身所在目录
   610	    为 import 根, 拆开复制会 ModuleNotFoundError。"""
   611	    import shutil
   612	
   613	    for name in ("vault_lint.py", "check_vault_doc_roles.py", "vault_doc_roles.yaml"):
   614	        shutil.copyfile(_SCRIPTS_DIR / name, tmp_path / name)
   615	    env = {k: v for k, v in os.environ.items() if k not in ("PYTHONDONTWRITEBYTECODE", "PYTHONPYCACHEPREFIX")}
   616	    proc = subprocess.run(
   617	        [sys.executable, str(tmp_path / "vault_lint.py"), "--help"],
   618	        capture_output=True,
   619	        text=True,
   620	        env=env,
   621	        timeout=60,
   622	    )
   623	    assert proc.returncode == 0, proc.stderr
   624	    pycs = list(tmp_path.rglob("*.pyc"))
   625	    assert pycs == [], f"无环境变量跑 --help 产生了字节码: {pycs}"
