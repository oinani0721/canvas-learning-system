   136	# ---------------------------------------------------------------------------
   137	# 报告数据结构 —— 文本与 JSON 的**唯一**真相源
   138	# ---------------------------------------------------------------------------
   139	@dataclass(frozen=True)
   140	class Finding:
   141	    subject: str  #: 出问题的 vault 相对路径 / 主体
   142	    detail: str
   143	
   144	
   145	@dataclass
   146	class CheckResult:
   147	    """单个检查的结论。
   148	
   149	    ⛔ 文本渲染与 JSON 序列化**都只读本对象**, 谁也不重新遍历一次原始数据 ——
   150	    那样会变成两份逻辑, 卡文的「--json 与文本同源」门就测不出分叉。
   151	    """
   152	
   153	    name: str
   154	    status: str  #: ok | warn | fail
   155	    summary: str
   156	    findings: list[Finding] = field(default_factory=list)
   157	    #: 结论强度的如实限定 (未跑的子检查、扫描盲区、不比什么) —— 两种输出都必须带上
   158	    notes: list[str] = field(default_factory=list)
   159	    #: 检查专属的机读字段 (如 freshness 的 projection_status)
   160	    details: dict[str, Any] = field(default_factory=dict)
   161	
   162	
   163	@dataclass
   164	class LintReport:
   165	    vault: str
   166	    today: str
   167	    checks: list[CheckResult]
   168	    #: 被 --only 跳过的检查名 —— **不伪造 ok**, 显式列出"没跑"
   169	    skipped: list[str] = field(default_factory=list)
   170	
   171	
   172	def exit_code(report: LintReport) -> int:
   173	    """0=全 ok / 2=有 warn 无 fail / 1=有 fail。跳过的检查不参与聚合。"""
   174	    statuses = {c.status for c in report.checks}
   175	    if FAIL in statuses:
   176	        return EXIT_FAIL
   177	    if WARN in statuses:
   178	        return EXIT_WARN
   179	    return EXIT_OK
   180	
   181	
   182	def report_to_json(report: LintReport) -> dict[str, Any]:
   183	    """JSON 视图 —— 只读 `report`, 与 `render_text` 同源。"""
   184	    return {
   185	        "vault": report.vault,
   186	        "today": report.today,
   187	        "summary": {
   188	            "exit_code": exit_code(report),
   189	            "checks_run": [c.name for c in report.checks],
   190	            "checks_skipped": list(report.skipped),
   191	            "status_counts": {
   192	                s: sum(1 for c in report.checks if c.status == s) for s in (OK, WARN, FAIL)
   193	            },
   194	        },
   195	        "checks": [
   196	            {
   197	                "name": c.name,
   198	                "status": c.status,
   199	                "summary": c.summary,
   200	                "findings": [{"subject": f.subject, "detail": f.detail} for f in c.findings],
   201	                "notes": list(c.notes),
   202	                "details": dict(c.details),
   203	            }
   204	            for c in report.checks
   205	        ],
   206	    }
   207	
   208	
   209	def render_text(report: LintReport, *, color: bool = True) -> str:
   210	    """文本视图 —— 只读 `report`, 与 `report_to_json` 同源。
   211	
   212	    每个检查恰一行机读状态行 `{TAG} <name> status=<status> ...`, 同源门据此解析比对。
   213	    """
   214	
   215	    def c(code: str, s: str) -> str:
   216	        return f"{code}{s}{RESET}" if color else s
   217	
   218	    hue = {OK: GREEN, WARN: YELLOW, FAIL: RED}
   219	    out: list[str] = [
   220	        f"{c(DIM, 'vault')} {report.vault}",

 succeeded in 0ms:
   441	    node_root = vault / NODE_DIR
   442	    notes: list[str] = []
   443	    blind: dict[str, str] = {}  # rel -> 拦截原因 (去重 + 带原因)
   444	
   445	    nodes = _iter_md(node_root)
   446	    if not node_root.is_dir():
   447	        return CheckResult(
   448	            name="orphan_nodes",
   449	            status=FAIL,
   450	            summary=f"`{NODE_DIR}/` 不存在 —— 检查无对象可查 (不是「零孤儿」)",
   451	            findings=[
   452	                Finding(f"{NODE_DIR}/", f"目录不存在, orphan 检查无法进行 —— 这不是「零孤儿」, 是「没查成」")
   453	            ],
   454	            notes=[f"以 `{NODE_DIR}/` 为判定对象的检查在缺该目录的 vault 上必须显性失败"],
   455	            details={"nodes_scanned": 0, "inbound_targets": 0},
   456	        )
   457	
   458	    # 入链索引: 三处正文的 wikilink basename → 来源文件集合。
   459	    # ⛔ 每个文件先过 `_scan_block_reason` (Codex round-2 HIGH-1): 文件 symlink /
   460	    #    symlink 祖先 / 越界解析, 一律拒读并记盲区 —— rglob 会跟随目录 symlink 递归,
   461	    #    外部文件的后代自身不是 symlink, 只有整链 realpath 能识破。
   462	    inbound: dict[str, set[str]] = {}
   463	    for src_dir in (BOARD_DIR, EXAM_DIR, NODE_DIR):
   464	        for src in _iter_md(vault / src_dir):
   465	            blocked = _scan_block_reason(vault, src)
   466	            if blocked:
   467	                blind[src.relative_to(vault).as_posix()] = blocked
   468	                continue
   469	            text = _read_text(src)
   470	            if text is None:
   471	                blind[src.relative_to(vault).as_posix()] = "unreadable"
   472	                continue
   473	            _fm, body = _split_frontmatter(text)
   474	            src_rel = src.relative_to(vault).as_posix()
   475	            for target in _wikilink_targets(body):
   476	                inbound.setdefault(target, set()).add(src_rel)
   477	
   478	    findings: list[Finding] = []
   479	    for node in nodes:
   480	        own = node.relative_to(vault).as_posix()
   481	        blocked = _scan_block_reason(vault, node)
   482	        if blocked:
   483	            blind[own] = blocked
   484	            continue
   485	        # ⛔ 检查时排除**自身**贡献 (Codex round-2 MEDIUM-1a): d1/A 链 [[d2/a]] 时,
   486	        #    target "a" 的来源集合是 {d1/A.md} —— 对 A 自己这是自贡献, 不构成豁免;
   487	        #    对 d2/a.md 才是有效入链。顶层裸自链 [[A]] 与子目录同名跨链由此**统一**处理,
   488	        #    不再需要"仅顶层适用"的特判。
   489	        sources = inbound.get(_norm_key(node.stem), set()) - {own}
   490	        if sources:
   491	            continue
   492	        text = _read_text(node)
   493	        if text is None:
   494	            blind[own] = "unreadable"
   495	            continue
   496	        fm, _body = _split_frontmatter(text)
   497	        if _fm_scalar(fm, "source_board"):
   498	            continue
   499	        findings.append(
   500	            Finding(
   501	                own,
   502	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   503	                f"(自身出链不计), 且 frontmatter 无 source_board",
   504	            )
   505	        )
   506	
   507	    if blind:
   508	        notes.append(
   509	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   510	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   511	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   512	        )
   513	    notes.append(
   514	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   515	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   516	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   517	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   518	    )
   519	    status = WARN if (findings or blind) else OK
   520	    return CheckResult(
   521	        name="orphan_nodes",
   522	        status=status,
   523	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿"
   524	        + (f", {len(blind)} 个盲区" if blind else ""),
   525	        findings=findings,
   526	        notes=notes,
   527	        details={
   528	            "nodes_scanned": len(nodes),
   529	            "inbound_targets": len(inbound),
   530	            "blind_spots": len(blind),
   531	            "blind_detail": dict(sorted(blind.items())),
   532	        },
   533	    )
