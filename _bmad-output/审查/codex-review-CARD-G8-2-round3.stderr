   811	def test_bytecode_guard_is_armed():
   812	    """元门: 本进程的 .pyc 写入开关必须是关的 (oracle exec 与被测模块 import 都依赖它)。
   813	
   814	    probe-B 实测: 缺了它, oracle 的 import 闭包会往 backend/app/、app/core/、app/utils/
   815	    三处写 8 个 .pyc —— 光看 endpoints/ 会假绿。
   816	    """
   817	    assert sys.dont_write_bytecode is True
   818	    assert os.environ.get("PYTHONDONTWRITEBYTECODE") == "1", (
