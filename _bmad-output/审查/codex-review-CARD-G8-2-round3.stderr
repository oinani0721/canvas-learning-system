   813	只读: 本脚本对 vault 只有读取, 无 --fix / --write; 不写 __pycache__ (模块级
   814	sys.dont_write_bytecode 兜底, 不依赖调用方环境变量)。
   815	"""
   816	
   817	
   818	class _LintArgumentParser(argparse.ArgumentParser):
   819	    """argparse 默认 error() 走 sys.exit(2) —— 与"有 warn"的 2 撞码
   820	    (Codex round-1 HIGH-6)。用法错误 = "lint 没跑成" = 配置/环境错误族, 统一退 3。"""
   821	
   822	    def error(self, message: str):  # type: ignore[override]
   823	        self.print_usage(sys.stderr)
   824	        print(f"{RED}{TAG} 用法错误: {message}{RESET}", file=sys.stderr)
   825	        raise SystemExit(EXIT_CONFIG)
   826	
   827	
   828	def main(argv: list[str] | None = None) -> int:
   829	    ap = _LintArgumentParser(
   830	        prog="vault_lint.py",
   831	        description="CARD-G8-2 统一 vault lint (live vault 只读, 三检查)",
   832	        epilog=_EPILOG,
   833	        formatter_class=argparse.RawDescriptionHelpFormatter,
   834	    )
   835	    ap.add_argument("--vault", type=Path, required=True, help="vault 根目录 (含 节点/ 原白板/ outputs/)")
   836	    ap.add_argument("--json", action="store_true", help="以 JSON 输出 (stdout 纯 JSON, 与文本同源)")
   837	    ap.add_argument("--now", default=None, help="注入'现在' (ISO-8601); 缺省取当前 Asia/Shanghai 日")
   838	    ap.add_argument(
   839	        "--only",
   840	        action="append",
   841	        choices=sorted(CHECKS),
   842	        default=None,
   843	        help="只跑指定检查 (可重复)。未选中的显式记为 skipped, 不算 ok",
   844	    )
   845	    args = ap.parse_args(argv)
   846	
   847	    try:
   848	        report = run_checks(args.vault.expanduser(), resolve_today(args.now), only=args.only)
   849	    except LintConfigError as exc:
   850	        print(f"{RED}{TAG} 配置/环境错误: {exc}{RESET}", file=sys.stderr)
   851	        return EXIT_CONFIG
   852	
   853	    if args.json:
   854	        print(json.dumps(report_to_json(report), ensure_ascii=False, indent=2))
   855	    else:
   856	        print(render_text(report, color=sys.stdout.isatty()))
   857	    return exit_code(report)
   858	
   859	
   860	if __name__ == "__main__":
   861	    sys.exit(main())

