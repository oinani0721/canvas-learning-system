   385	def test_orphan_symlink_never_read(tmp_path):
   386	    """Codex round-1 HIGH-1 + round-2 HIGH-1 三旁路: 文件 symlink / 源目录本身是
   387	    symlink / dangling symlink 都不能豁免真孤儿, 且全部显式记盲区。
   388	    判别锚 = **blind 原因** (blind_detail): 各层防线各有专属原因, 拆任何一层
   389	    都会让对应段红 —— 纵深防御不再吞掉判别力 (round-2 变异 M8/M12a/M12b
   390	    首跑 SURVIVED 的教训: 每段 fixture 都有另一层兜底 = 无判别)。"""
   391	    outside = tmp_path / "outside.md"
   392	    outside.write_text("- [[被链]]\n", encoding="utf-8")
   393	    root = tmp_path / "v"
   394	    _node(root, "被链")
   395	
   396	    # 旁路甲: 普通文件 symlink → vault 外 —— is_symlink 层在前, 原因必为 "symlink"
   397	    # (M12a 拆该层后 falls through 到越界层, 原因变 resolves-outside-vault → 本断言红)
   398	    link = root / "原白板" / "external.md"
   399	    link.parent.mkdir(parents=True)
   400	    link.symlink_to(outside)
   401	    res = vl.check_orphan_nodes(root)
   402	    subjects = [f.subject for f in res.findings]
   403	    assert "节点/被链.md" in subjects, f"vault 外 symlink 内容豁免了真孤儿: {res.findings}"
   404	    assert res.details["blind_detail"]["原白板/external.md"] == "symlink"
   405	    assert res.status == vl.WARN
   406	
   407	    # 旁路乙: **原白板 本身**是 symlink 指外 —— 实测 py3.14 rglob 不递归子目录
   408	    # symlink, 但 root.is_dir() 跟随, 以外部目录为根枚举出的文件自身非 symlink:
   409	    # 越界层是唯一防线 (round-2 HIGH-1 的原始形态)
   410	    outside_dir = tmp_path / "outside-dir"
   411	    outside_dir.mkdir()
   412	    (outside_dir / "external2.md").write_text("- [[被链]]\n", encoding="utf-8")
   413	    root2 = tmp_path / "v2"
   414	    _node(root2, "被链")
   415	    (root2 / "原白板").symlink_to(outside_dir, target_is_directory=True)
   416	    res2 = vl.check_orphan_nodes(root2)
   417	    subjects2 = [f.subject for f in res2.findings]
   418	    assert "节点/被链.md" in subjects2, f"源目录 symlink 后代豁免了真孤儿: {res2.findings}"
   419	    assert res2.details["blind_detail"]["原白板/external2.md"] == "resolves-outside-vault"
   420	
   421	    # 旁路丙: dangling symlink —— is_file()==False 不得静默消失
   422	    root3 = tmp_path / "v3"
   423	    _node(root3, "被链")
   424	    (root3 / "原白板").mkdir()
   425	    (root3 / "原白板" / "lost.md").symlink_to(tmp_path / "no-such-target.md")
   426	    res3 = vl.check_orphan_nodes(root3)
   427	    assert "节点/被链.md" in [f.subject for f in res3.findings]
   428	    assert res3.details["blind_detail"]["原白板/lost.md"] == "symlink"
   429	
   430	    # 段丁 (is_symlink 层专属判别): 指 vault **内**的文件 symlink —— 越界层放行,
   431	    # 只有 is_symlink 层拦截; 断言拦截原因 == "symlink"
   432	    root4 = tmp_path / "v4"
   433	    _node(root4, "被链")
   434	    _node(root4, "真身")
   435	    (root4 / "原白板").mkdir()
   436	    (root4 / "原白板" / "alias.md").symlink_to(root4 / "节点" / "真身.md")
   437	    res4 = vl.check_orphan_nodes(root4)
   438	    assert res4.details["blind_detail"]["原白板/alias.md"] == "symlink", (
   439	        f"指内 symlink 应由 is_symlink 层拦截并记原因: {res4.details}"
   440	    )
