   305	def _norm_key(name: str) -> str:
   306	    """入链匹配键: NFC 归一 + casefold。
   307	
   308	    ⛔ 两条都是**刻意放宽**, 方向一律是"少报孤儿":
   309	      - NFC: macOS 文件名可能以 NFD 存储 (`é` = e + U+0301), 而 md 正文里用户打的是 NFC。
   310	        不归一 → 同一个名字两种字节串 → 真有链的节点被判成孤儿 (假阳)。
   311	      - casefold: Obsidian 的 wikilink 解析与 APFS 默认都大小写不敏感, `[[Agent]]` 确实
   312	        能打开 `agent.md`。判定若大小写敏感, 会产出用户在 Obsidian 里根本复现不了的假阳。
   313	    代价: 真实存在两个仅差大小写/归一形态的不同节点时, 一个的入链会被算到另一个头上
   314	    (假阴)。该权衡进验收单「不比什么」表。
   315	    """
   316	    return unicodedata.normalize("NFC", name).casefold().strip()
   317	
   318	
   319	#: sync_board_concepts.py 的哨兵块边界 (同源锁先例: 复制正则 + 测试对齐; 该文件
   320	#: 位于 live vault 内禁 import)。成员行夹在 BEGIN/END 两行注释**之间**, 不是注释
   321	#: 内容 —— 必须段级剥离, 单剥 HTML 注释够不着它 (Codex round-1 HIGH-2)。
   322	_AUTO_BEGIN_RE = re.compile(r"^<!--\s*AUTO-GENERATED by \.claude/scripts/sync_board_concepts\.py")
   323	_AUTO_END_RE = re.compile(r"^<!--\s*/AUTO-GENERATED")
   324	
   325	
   326	def _strip_code_spans(text: str) -> str:
   327	    """按 CommonMark 语义剥除 code span (Codex round-4 HIGH-2 + round-5 HIGH-1/2)。
   328	
   329	    ⛔ 不能用单条正则 `(`+)[^`]*\\1`: 反向引用能匹配**更长** closing run 的前缀, 且
   330	       `(`+)` 可回溯成较短 opener —— `` ``[[A]] ` foo`` `` 会被错拆成「空 span +
   331	       一个包住 ` foo` 的单反引号 span」, [[A]] 逃出剥除面 (Codex round-4 实测)。
   332	    ⛔ closer 必须与 opener **严格等长** (round-5 HIGH-1): "≥ opener" 是 fenced code
   333	       的规则; `` `x``[[A]]` `` 的 MarkdownIt 解析是 opener/closer 均单反引号、
   334	       content 含双反引号 —— "≥" 语义会把双反引号误当 closer, [[A]] 逃出。
   335	    ⛔ 剥除后用**空格占位**而非空串拼接 (round-5 HIGH-2): "[`x`[A]]" 删 span 后空串
   336	       拼接会造出原文不存在的 "[[A]]" 伪入链; 空格占位保持相邻字符不相邻。
   337	    """
   338	    runs = [(m.start(), m.end(), len(m.group())) for m in re.finditer(r"`+", text)]
   339	    consumed: list[tuple[int, int]] = []
   340	    i = 0
   341	    while i < len(runs):
   342	        j = i + 1
   343	        while j < len(runs) and runs[j][2] != runs[i][2]:
   344	            j += 1
   345	        if j < len(runs):
   346	            consumed.append((runs[i][0], runs[j][1]))
   347	            i = j + 1
   348	        else:
   349	            i += 1
   350	    out: list[str] = []
   351	    prev = 0
   352	    for s, e in consumed:
   353	        out.append(text[prev:s] + " ")  # 空格占位: 剥除不得拼接出新的相邻字符
   354	        prev = e
   355	    out.append(text[prev:])
   356	    return "".join(out)
   357	
   358	
   359	def _strip_nonsemantic(body: str) -> str:
   360	    """剥离正文里**非语义**的 wikilink 载体 (Codex round-1 HIGH-2/HIGH-4 +
   361	    round-2 HIGH-4 整改)。
   362	
   363	    两段式 (round-2 教训: 行级剥 span 会把跨行 span 的**另一半**留在别行,
   364	    拼回后已无反引号对可配 —— 剥不到):
   365	      1. 行级状态机只管**按行判定的**结构: AUTO-GENERATED 哨兵段 (BEGIN→END 整段)
   366	         与 fenced code (CommonMark: closing fence 同字符且长度 ≥ opener ——
   367	         四反引号栏内的三反引号不关闭围栏), 命中行整行丢弃;
   368	      2. 拼回后文件级剥 code span (`+...`+ 可跨行) 与 HTML 注释
   369	         (<!-- --> 跨行; **未闭合**按 CommonMark 剥到 EOF)。
   370	
   371	    live 复算 (Codex round-1): 14 个节点的入链全部同时来自 source_board 与自动
   372	    成员块, 去掉 AUTO 后 3 个节点没有其他入链 —— 陈旧自动块绝不能豁免孤儿。
   373	
   374	    ⛔ 如实登记的剩余缝隙 (Codex round-2 HIGH-4 末项, 不处理): AUTO 段与围栏**交叉**
