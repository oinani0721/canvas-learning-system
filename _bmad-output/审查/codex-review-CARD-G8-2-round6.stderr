  1034	# ---------------------------------------------------------------------------
  1035	# 3e. round-5 整改 —— code span closer 严格等长 / 剥除空格占位
  1036	# ---------------------------------------------------------------------------
  1037	def test_code_span_closer_must_equal_opener(tmp_path):
  1038	    """Codex round-5 HIGH-1 (MarkdownIt 对照): `` `x``[[A]]` `` 的 opener/closer
  1039	    均为单反引号 (content 含双反引号) —— "≥ opener" 是 fenced 的规则不是 span 的,
  1040	    双反引号不得充当单反引号 span 的 closer; [[A]] 在 span 内必须被剥, A 报孤儿。
  1041	    变异对照: M16 (closer 退回 >= 语义) 指定杀本用例。"""
  1042	    root = tmp_path / "v"
  1043	    _node(root, "A")
  1044	    _board(root, "板", "`x``[[A]]`\n")
  1045	    res = vl.check_orphan_nodes(root)
  1046	    subjects = [f.subject for f in res.findings]
  1047	    assert subjects == ["节点/A.md"], f"双反引号被误当 closer, [[A]] 逃出 span: {subjects}"
  1048	
  1049	
  1050	def test_code_span_removal_leaves_placeholder_not_concatenation(tmp_path):
  1051	    """Codex round-5 HIGH-2: 剥除 span 后必须**空格占位** —— 空串拼接会把
  1052	    "[`x`[A]]" 拼成原文不存在的 "[[A]]" 伪入链, 反向隐藏真孤儿 A。"""
  1053	    root = tmp_path / "v"
  1054	    _node(root, "A")
  1055	    _board(root, "板", "[`x`[A]]\n")
  1056	    res = vl.check_orphan_nodes(root)
  1057	    subjects = [f.subject for f in res.findings]
  1058	    assert subjects == ["节点/A.md"], f"空串拼接制造伪入链 [[A]]: {subjects}"

