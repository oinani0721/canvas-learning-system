   694	def _is_stale(generated_at: Any, today: date) -> bool:
   695	    """⛔ 逐字复制 `review_overview.py:849-857` 的 stale 判定。
   696	
   697	    只认 A2 生产器的确切形态 (带时区秒级); 数字串/纯日期/无时区值不许冒充今日;
   698	    解析中的任何异常 (含 fromisoformat 通过但 astimezone 溢出的 OverflowError)
   699	    都按 stale 降级, 绝不逃逸成异常。
   700	    """
   701	    stale = True
   702	    try:
   703	        if isinstance(generated_at, str) and _GENERATED_AT_RE.fullmatch(generated_at):
   704	            gen = datetime.fromisoformat(generated_at.replace("Z", "+00:00"))
   705	            stale = gen.astimezone(_TZ_SHANGHAI).date() != today
   706	    except Exception:  # noqa: BLE001 — 畸形时间按 stale, 不装新鲜也不炸
   707	        stale = True
   708	    return stale
   709	
   710	
   820	    「无 --now 的默认分支走上海日, 不是宿主本地日 / date.today()」。"""
   821	    return datetime.now(timezone.utc)
   822	
   823	
   824	def resolve_today(now: str | None) -> date:
   825	    """`--now` → 上海本地日。
   826	
   827	    ⛔ 不用 `date.today()`: 那是**进程本地日**。MEMORY 记过一条真实缺陷 —— 容器 TZ 为空时
   828	       写侧产出了"昨天"的日期。今日口径必须显式绑定 Asia/Shanghai, 与
   829	       review_overview.py:855 的 `astimezone(_TZ_SHANGHAI).date()` 同一条规则。
   830	    """
   831	    if now is None:
   832	        return _utcnow().astimezone(_TZ_SHANGHAI).date()
   833	    try:
   834	        dt = datetime.fromisoformat(now.replace("Z", "+00:00"))
   835	    except ValueError as exc:
   836	        raise LintConfigError(f"--now 不是合法 ISO-8601 时间: {now!r} ({exc})") from exc
   837	    if dt.tzinfo is None:  # 无时区 → 按上海本地时间解释 (与显示时区一致, 不引入第二种默认)
   838	        dt = dt.replace(tzinfo=_TZ_SHANGHAI)
   839	    try:
   840	        return dt.astimezone(_TZ_SHANGHAI).date()
   841	    except (OverflowError, OSError) as exc:
   842	        raise LintConfigError(f"--now 时间超出可表示范围: {now!r} ({exc})") from exc
   843	
   844	
   845	_EPILOG = f"""
   846	检查项与状态分级 (ok/warn/fail 的判定规则, Codex round-1 MEDIUM-4 要求写进 --help):
   847	  orphan_nodes            {CHECKS["orphan_nodes"]}
