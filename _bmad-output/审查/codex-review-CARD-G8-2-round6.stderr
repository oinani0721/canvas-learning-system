   536	        #    realpath 归并, 不得绕过自身排除。
   537	        own_phys = os.path.realpath(node)
   538	        sources = inbound.get(_norm_key(node.stem), set()) - {own_phys}
   539	        if sources:
   540	            continue
   541	        text = _read_text(node)
   542	        if text is None:
   543	            blind[own] = "unreadable"
   544	            continue
   545	        fm, _body = _split_frontmatter(text)
   546	        if _fm_scalar(fm, "source_board"):
   547	            continue
   548	        findings.append(
   549	            Finding(
   550	                own,
   551	                f"无来自 {BOARD_DIR}/ {EXAM_DIR}/ {NODE_DIR}/ 正文的 wikilink 入链 "
   552	                f"(自身出链不计), 且 frontmatter 无 source_board",
   553	            )
   554	        )
   555	
   556	    if blind:
   557	        notes.append(
   558	            f"扫描盲区: {len(blind)} 个文件未参与判定 (原因见前缀), "
   559	            + ", ".join(f"{rel}[{why}]" for rel, why in sorted(blind.items())[:5])
   560	            + " —— 这些文件可能是孤儿也可能不是, 结论按此打折"
   561	        )
   562	    notes.append(
   563	        "不比: frontmatter 里的 wikilink (source_note/up/derived-from) 不算入链; "
   564	        "自身出链不豁免自己 (含顶层裸自链); 围栏/行内 code、HTML 注释 (含 AUTO-GENERATED "
   565	        "哨兵段)、跨行 [[..]] 不算入链; 大小写与 NFC/NFD 归一后匹配 (方向=少报孤儿); "
   566	        "symlink 文件、symlink 目录的后代、解析越界文件拒读并记盲区"
   567	    )
   568	    status = WARN if (findings or blind) else OK
   569	    return CheckResult(
   570	        name="orphan_nodes",
   571	        status=status,
   572	        summary=f"{len(nodes)} 个节点, {len(findings)} 个孤儿" + (f", {len(blind)} 个盲区" if blind else ""),
   573	        findings=findings,
   574	        notes=notes,
   575	        details={
   576	            "nodes_scanned": len(nodes),
   577	            "inbound_targets": len(inbound),
   578	            "blind_spots": len(blind),
   579	            "blind_detail": dict(sorted(blind.items())),
   580	        },

