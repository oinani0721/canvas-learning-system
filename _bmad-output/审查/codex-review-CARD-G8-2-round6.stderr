    18	mutate_and_test() {
    19	  # $1=变异名 $2=python替换表达式(old|||new, \n 字面量) $3=pytest -k 表达式(指定门)
    20	  local name="$1" repl="$2" gate="$3" rc out
    21	  out="$TRANS_DIR/$name.txt"
    22	  cp "$SCRIPT" "$SCRIPT.bak-g82"
    23	  trap 'cp "$SCRIPT.bak-g82" "$SCRIPT" 2>/dev/null; rm -f "$SCRIPT.bak-g82"' EXIT INT TERM
    24	
    25	  python3 - "$repl" <<'PYEOF'
    26	import sys
    27	repl = sys.argv[1]
    28	old, new = (s.replace("\\n", "\n") for s in repl.split("|||"))
    29	p = "backend/scripts/vault_lint.py"
    30	src = open(p, encoding="utf-8").read()
    31	n = src.count(old)
    32	assert n == 1, f"替换锚必须恰命中 1 次, 实际 {n}: {old!r}"
    33	open(p, "w", encoding="utf-8").write(src.replace(old, new))
    34	PYEOF
    35	  if [ $? -ne 0 ]; then
    36	    echo "MUTANT $name: REPLACE-FAILED (锚不唯一/不命中) — 脚本缺陷, 不算通过"
    37	    cp "$SCRIPT.bak-g82" "$SCRIPT"; rm -f "$SCRIPT.bak-g82"
    38	    exit 9
    39	  fi
    40	
    41	  ( cd backend && .venv/bin/pytest tests/unit/test_vault_lint.py -q -p no:cacheprovider -k "$gate" ) > "$out" 2>&1
    42	  rc=$?
    43	  # 还原 + 逐字节比对 (先还原再判定, 防中途退出留毒)
    44	  cp "$SCRIPT.bak-g82" "$SCRIPT"
    45	  if ! cmp -s "$SCRIPT" "$SCRIPT.bak-g82"; then echo "MUTANT $name: RESTORE-MISMATCH"; exit 9; fi
    46	  rm -f "$SCRIPT.bak-g82"
    47	
    48	  # 判据: rc==1 且 **指定的那道门** 出现在 FAILED 行里 (HIGH-7: 光 rc!=0 不算)
    49	  if [ "$rc" -eq 1 ] && grep -q "FAILED tests/unit/test_vault_lint.py::.*${gate%% and *}" "$out"; then
    50	    echo "MUTANT $name: KILLED (rc=1, 指定门 [$gate] 的 FAILED 行在 transcript) ✓"
    51	  elif [ "$rc" -eq 0 ]; then
    52	    echo "MUTANT $name: SURVIVED (rc=0 — 指定门 [$gate] 没抓住) ❌"
    53	    FAILED="$FAILED $name"
    54	  else
    55	    echo "MUTANT $name: NOT-KILLED-BY-GATE (rc=$rc, 指定门 [$gate] 无 FAILED 行 — 收集错/别的错, 不算杀) ❌"
    56	    FAILED="$FAILED $name"
    57	  fi
    58	  tail -1 "$out"
    59	}
