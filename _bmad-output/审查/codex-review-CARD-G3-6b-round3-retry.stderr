  1164	def test_g36b_template_covers_every_branch():
  1165	    """S4 模板 6 组分支逐条锁定 (纯函数直测, 不经 vault)。
  1166	
  1167	    含两条「没有 vs 算不出」的区分: due_scheduled==0 时整个紧迫段消失 (全新卡
  1168	    的板没有"逾期"可言); due_scheduled>0 而 overdue_days is None 时如实说
  1169	    "超出可显示范围", 不假装 0 天。"""
  1170	    base = {
  1171	        "due_total": 1,
  1172	        "due_new": 0,
  1173	        "due_scheduled": 1,
  1174	        "due_malformed": 0,
  1175	        "overdue_days": 5,
  1176	        "idle_days": 3,
  1177	        "never_recommended": False,
  1178	        "recommend_gap_days": 2,
  1179	    }
  1180	
  1181	    def why(**over):
  1182	        return picker.why_this_board({**base, **over})
  1183	
  1184	    assert why() == "1 个节点到期 · 最早的已逾期 5 天 · 最该考的已闲置 3 天 · 距上次推荐 2 天"
  1185	    assert why(due_total=4, due_new=2).startswith("4 个节点到期（其中 2 张新卡）")
  1186	    assert "最早的今天到期" in why(overdue_days=0)
  1187	    assert "最早到期时刻超出可显示范围" in why(overdue_days=None)
  1188	    no_sched = why(due_scheduled=0, overdue_days=None)
  1189	    assert "逾期" not in no_sched and "到期时刻" not in no_sched, "无已排期节点则紧迫段整段省略"
  1190	    assert "含 2 个到期时间无法解析的节点" in why(due_malformed=2)
  1191	    assert "最该考的从未考察" in why(idle_days=None)
  1192	    assert "这块板从未被推荐过" in why(never_recommended=True)
  1193	    assert "今天已推荐过" in why(recommend_gap_days=0)
  1194	    assert "上次推荐日期无法解析" in why(recommend_gap_days=None)
  1195	    assert "上次推荐日期晚于今天" in why(recommend_gap_days=-3), "记录晚于今天必须说异常, 不许 clamp 成 0"
