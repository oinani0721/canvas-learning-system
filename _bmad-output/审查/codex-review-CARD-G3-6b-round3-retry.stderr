   649	    该变), 上限与因子序/取整精度取代码常量, 分钟取 manifest 生效值,
   650	    implementation_sha256 摘本文件字节 (round-2 HIGH: 取值绑定无法全部
   651	    数据化, 实现指纹兜住「改代码规则而指纹不动」的整类攻击)。
   652	    """
   653	    return {
   654	        "version": version,
   655	        "ranking_factors": list(TIE_FACTOR_KEYS),
   656	        "tie_pick_round_digits": int(TIE_PICK_ROUND_DIGITS),
   657	        "estimated_minutes": {k: int(minutes[k]) for k in sorted(minutes)},
   658	        "limits": {"top_boards": TOP_BOARDS_LIMIT, "upcoming": UPCOMING_LIMIT},
   659	        "decay_beta_constants": {k: getattr(decay, k, None) for k in DECAY_CONSTANT_NAMES},
   660	        "implementation_sha256": _implementation_sha(),
   661	    }
   662	
   663	
   664	def build_rank_manifest(decay, version, minutes: dict, recorded: dict) -> dict:
   665	    """S5 payload.rank_manifest = {version, sha256}; 顺带发漂移告警。"""
   666	    effective = effective_rank_config(decay, version, minutes)
   667	    _warn_recorded_drift(recorded, effective)
   668	    blob = json.dumps(effective, sort_keys=True, ensure_ascii=False, allow_nan=False)
   669	    return {"version": version, "sha256": hashlib.sha256(blob.encode("utf-8")).hexdigest()}
   670	
   671	
   672	def _board_factors(board: str, due: list, top: dict, today_sh, board_last_recommended: dict) -> dict:
   673	    """S4 因子提取: 全部是投影内已有数据的确定性派生 —— 不虚构、不估算。
   674	
   675	    overdue_days 只看板内"已排期且已到期"的最早 fsrs_due (与 rollup 的
   676	    earliest_overdue 同源同判据)。None 有两个来源, 靠 due_scheduled 区分:
   677	    为 0 = 板内压根没有已排期到期节点; 非 0 = 该时刻不可表示 (年份极值)。
   678	    """
   679	    scheduled = [n["fsrs_due"] for n in due if n["fsrs_due"]]
   680	    overdue_days = None
   681	    if scheduled:
   682	        earliest_sh = _sh_local(min(scheduled))
   683	        if earliest_sh is not None:
   684	            # delta > 0 不可达 (到期判定是 UTC 词法 <= now, 上海日差不会为正);
   685	            # 仍夹到 0 —— 真出现时按"今天到期"说, 不吐负数天。
   686	            overdue_days = max(0, (today_sh - earliest_sh.date()).days)
   687	
   688	    rec = board_last_recommended.get(board, "")
   689	    gap = None
   690	    if rec:
   691	        try:
   692	            # 不夹负值 (Codex round-1 MEDIUM): 记录晚于今天属异常状态, 如实
   693	            # 上抛负数让模板走诚实分支 —— clamp 成 0 会把「记录异常」伪装成
   694	            # 「今天刚推荐过」, 违反 S4 不虚构。
   695	            gap = (today_sh - date.fromisoformat(rec)).days
   696	        except (ValueError, TypeError):
   697	            # state 里的日期串损坏: 如实说"算不出", 不当作从未推荐 (那会让
   698	            # 一块刚推过的板伪装成冷板, 拿到不该有的解释)
   699	            gap = None
   700	    return {
   730	    if f["due_malformed"]:
   731	        parts.append(f"含 {int(f['due_malformed'])} 个到期时间无法解析的节点")
   732	    parts.append("最该考的从未考察" if f["idle_days"] is None
   733	                 else f"最该考的已闲置 {int(f['idle_days'])} 天")
   734	    if f["never_recommended"]:
   735	        parts.append("这块板从未被推荐过")
   736	    elif f["recommend_gap_days"] is None:
   737	        parts.append("上次推荐日期无法解析")
   738	    elif f["recommend_gap_days"] < 0:
   739	        # 记录晚于今天 (时钟回拨/时区错乱/手滑改了 state) — 如实说异常,
   740	        # 不 clamp 成 0 伪装成"今天刚推荐过" (Codex round-1 MEDIUM)
   741	        parts.append("上次推荐日期晚于今天")
   742	    elif f["recommend_gap_days"] == 0:
   743	        parts.append("今天已推荐过")
   744	    else:
   745	        parts.append(f"距上次推荐 {int(f['recommend_gap_days'])} 天")
   746	    return " · ".join(parts)
   747	
   748	
   749	def estimated_minutes(f: dict, minutes: dict) -> int:
   750	    """S5 板级预计工作量: 新卡按 per_new_node, 其余到期按 per_due_node。
   751	
   752	    三分互斥完备 (S4), 故 new + scheduled + malformed 恰好覆盖 due_total。
   753	    常量归 manifest 的 authoritative 节 —— 用户改了下一轮立刻生效。
   754	    """
   755	    other = int(f["due_scheduled"]) + int(f["due_malformed"])
   756	    return int(f["due_new"]) * int(minutes["per_new_node"]) + other * int(minutes["per_due_node"])
   757	
   758	
   759	def rank_boards(nodes, board_last_recommended: dict, now: datetime, minutes: dict | None = None):
   760	    """板级聚合: priority = min(pick), 终审 A3 tie-break。
   761	
   762	    CARD-G3-6b 加性 (S4): 行尾追加 why_this_board / estimated_minutes /
   763	    factors 三个字段 —— 排序键 (_tie) 与既有七字段一个不动, 行内新字段
   764	    排在旧字段之后 (落盘键序稳定)。now/minutes 是新增入参: 前者供逾期与
   765	    冷却天数换算 (此前本函数不需要时间), 后者是 manifest 生效的分钟常量。
   766	    """
   767	    minutes = minutes or DEFAULT_MINUTES
   768	    today_sh = _today_sh(now)
   769	    boards: dict[str, list] = {}
   770	    unassigned = []
   771	    for n in nodes:
   772	        if not n["board"]:
   773	            unassigned.append(n["node"])
   774	            continue
   775	        boards.setdefault(n["board"], []).append(n)
   776	
   777	    ranked, upcoming = [], []
   778	    for board, members in boards.items():
   779	        due = [n for n in members if n["due_now"]]
   780	        if not due:
   781	            # WHEN: 全员未到期 → 不进推荐榜, 记最近的未来到期 (F1 放假语义)
   782	            nxt = min(members, key=lambda n: n["fsrs_due"])
   783	            upcoming.append({"board": board, "next_due": nxt["fsrs_due"], "node": nxt["node"]})
   784	            continue
   785	        top = min(due, key=lambda n: n["pick"])   # WHAT: 到期集合内衰减 Beta 排序
   786	        factors = _board_factors(board, due, top, today_sh, board_last_recommended)
   787	        # 排序键由 TIE_FACTOR_KEYS 逐键派生 (单一真相源, 见常量处裁定) ——
   788	        # 各键取值与 HEAD 的字面 _tie 元组逐位相同, 初始顺序下排序行为零变化
   789	        tie_parts = {
   790	            "priority_pick": round(top["pick"], TIE_PICK_ROUND_DIGITS),
   791	            "board_last_recommended": board_last_recommended.get(board, ""),  # 空串 = 从未被推荐, 排最前
   792	            "min_last_examined": min(n["last_examined"] for n in due),        # 空串 = 有从未考节点, 排最前
   793	            "board": board,
   794	        }
   795	        ranked.append({
   796	            "board": board,
   797	            "top_node": top["node"],
   798	            "priority": round(top["pick"], 4),
   799	            "pending": len(due),                   # 到期即待复习 (Decision-FSRS-2)
   800	            "idle_days": (None if top["idle_days"] is None else int(top["idle_days"])),
   801	            "difficulty": top["difficulty"],
   802	            "next_due": min((n["fsrs_due"] for n in members if not n["due_now"]), default=""),
   803	            # CARD-G3-6b 加性 (S4): 板级解释三件套 — why 由 factors 单向复算,
   804	            # factors 同时落盘让消费方能自证那句话没跑偏 (禁 UI 再算)
   805	            "why_this_board": why_this_board(factors),
   806	            "estimated_minutes": estimated_minutes(factors, minutes),
   807	            "factors": factors,
   808	            "_tie": tuple(tie_parts[k] for k in TIE_FACTOR_KEYS),
   809	        })
   810	    ranked.sort(key=lambda r: r["_tie"])
   811	    for r in ranked:
   812	        del r["_tie"]
   813	    upcoming.sort(key=lambda u: u["next_due"])
   814	    return ranked, upcoming, unassigned
