  1836	    assert cfg["implementation_sha256"] == picker._implementation_sha(), "与真文件自洽"
  1837	    # 同一实现的指纹可由任意路径副本复算 (摘的是字节不是身份)
  1838	    twin = tmp_path / "twin_pick.py"
  1839	    twin.write_bytes((WT / "scripts" / "daily_review_pick.py").read_bytes())
  1840	    assert picker._implementation_sha(twin) == cfg["implementation_sha256"]
  1841	    twin.write_bytes(b"# changed\n")
  1842	    assert picker._implementation_sha(twin) != cfg["implementation_sha256"], "内容变指纹必变"
