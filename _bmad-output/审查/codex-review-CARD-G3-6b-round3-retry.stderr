   613	def _warn_recorded_drift(recorded: dict, effective: dict):
   614	    """S5: recorded 是快照不是配置 —— 与实际生效值不符时逐项出声, 以实际为准。
   615	
   616	    这是"配置断裂会说话"的最小形态: 有人改了 decay_beta 的系数 / 改了榜长
   617	    却没更新登记, 下一轮生成就有一行 stderr 指出来, 而不是让快照悄悄过期。
   618	    """
   619	    for label, claimed, actual in (
   620	        ("ranking_factors.order",
   621	         _recorded_claim(recorded, "ranking_factors", "order"), list(effective["ranking_factors"])),
   622	        ("limits", _recorded_claim(recorded, "limits"), effective["limits"]),
   623	        ("decay_beta_constants",
   624	         _recorded_claim(recorded, "decay_beta_constants"), effective["decay_beta_constants"]),
   625	    ):
   626	        if claimed is not None and claimed != actual:
   627	            print(f"[pick] 系数清单 recorded.{label} 与实际生效值不符 "
   628	                  f"(登记={claimed!r} 实际={actual!r}); 以实际为准", file=sys.stderr)
   629	
   630	
   631	def _implementation_sha(path=None) -> str:
   632	    """S5 本生成器源码的实现指纹 (Codex round-2 HIGH)。
   633	
   634	    因子清单/精度常量只能覆盖「登记过的配置面」, 覆不完取值绑定这类字面
   635	    代码 —— 把 pick.py 自身字节也摘进指纹, 任何排序规则改动 (精度/绑定/
   636	    方向/新因子) 必然变 sha。粒度因此从「系数」变粗为「实现+系数」: 改
   637	    注释也会变指纹, 属预期内的保守取舍 (宁可指纹变多, 不可规则变更漏网)。
   638	    """
   639	    p = Path(path) if path is not None else Path(__file__).resolve()
   640	    return hashlib.sha256(p.read_bytes()).hexdigest()
