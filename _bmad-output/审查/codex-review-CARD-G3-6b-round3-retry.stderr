  1292	    _, _, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1293	    claimed = picker._recorded_claim(recorded, "decay_beta_constants")
  1294	    actual = {k: getattr(decay, k) for k in picker.DECAY_CONSTANT_NAMES}
  1295	    assert claimed == actual, "manifest 登记的 decay 常量与 decay_beta.py 实际值不符"
