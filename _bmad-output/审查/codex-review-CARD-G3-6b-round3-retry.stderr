  1237	def test_g36b_sha_changes_for_every_single_coefficient(monkeypatch):
  1238	    """S5 逐项变异: 任何一个系数变了, 指纹必须变 —— 一项都不能漏。
  1239	
  1240	    漏掉任何一项 = 那个系数被改了而版本化毫无察觉, 版本化就成了摆设。"""
  1241	    baseline = _sha_of()
  1242	    assert _sha_of(version=2) != baseline, "version"
  1243	    assert _sha_of(minutes={"per_due_node": 4, "per_new_node": 5}) != baseline, "per_due_node"
  1244	    assert _sha_of(minutes={"per_due_node": 3, "per_new_node": 6}) != baseline, "per_new_node"
  1245	    for name in picker.DECAY_CONSTANT_NAMES:
  1246	        assert _sha_of(decay=_fake_decay(**{name: 12.5})) != baseline, f"decay 常量 {name} 变了指纹却没动"
  1247	
  1248	    class _Missing:  # 模块被删了五个常量 —— 缺了也是变了
  1249	        PRIOR_A = 0.9
  1250	
  1251	    assert _sha_of(decay=_Missing()) != baseline, "decay 常量缺失"
  1252	
  1253	    # Codex round-2 HIGH: 可执行取值规则 (精度/因子序) 也必须进指纹
  1254	    monkeypatch.setattr(picker, "TIE_PICK_ROUND_DIGITS", 7)
  1255	    assert _sha_of() != baseline, "pick 取整精度变了指纹却没动"
  1256	    monkeypatch.setattr(
  1257	        picker, "TIE_FACTOR_KEYS", ("priority_pick", "board", "min_last_examined", "board_last_recommended")
  1258	    )
  1259	    assert _sha_of() != baseline, "因子序变了指纹却没动"
  1260	
