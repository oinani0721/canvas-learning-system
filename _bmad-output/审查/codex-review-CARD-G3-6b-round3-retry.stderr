   830	def build_payload(vault: Path, now: datetime, board_last_recommended: dict, decay,
   831	                  manifest_path=None):
   832	    """CARD-G3-6b: 新增可选 manifest_path (缺省 = 本脚本同目录的系数清单)。
   833	
   834	    runner 侧调用形态不变 (daily_review_run:159-160 传四个位置参数) —— 新
   835	    参数是加性关键字, 消费面零变化。
   836	    """
   837	    version, minutes, recorded = load_rank_manifest(manifest_path)
   838	    rank_manifest = build_rank_manifest(decay, version, minutes, recorded)
   839	    nodes, stats, ineligible, placeholder_boards = scan_nodes(vault, now, decay)
   840	    ranked, upcoming, unassigned = rank_boards(nodes, board_last_recommended, now, minutes)
   841	    stats["unassigned"] = len(unassigned)
   842	    # CARD-G3-6a S1: 级联判桶 + why_due 一次算好, due_nodes 行与 buckets 分组
   843	    # 同源引用同一对值 (禁两处各算一遍 → 禁口径分裂)。划分域 = 已归板。
