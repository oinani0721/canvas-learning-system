  1798	            "A1": _node(board="A板", extra="mastery_a: 2.0\nmastery_b: 3.0\n"),
  1799	            "B1": _node(board="B板", extra="mastery_a: 2.0\nmastery_b: 3.0\n"),
  1800	        },
  1801	    )
  1802	    decay = picker.load_decay(vault)
  1803	    _, minutes, _ = picker.load_rank_manifest(_REAL_MANIFEST)
