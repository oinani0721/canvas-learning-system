  1262	def test_g36b_sha_digests_effective_values_not_file_bytes(tmp_path):
  1263	    """S5 本卡最容易做假的一条, 正反双向验:
  1264	
  1265	    正向 — 一个字节都不碰 manifest 文件, 只改 decay 模块的系数 → sha 必须变。
  1266	           (「对 manifest 文件取 hash」的实现在这里恒绿 —— 那正是本门的靶子。)
  1267	    反向 — 只改文件里的说明文字, 生效值一个没变 → sha 必须不变。
  1268	           (「把整个文件塞进摘要」的实现在这里会红。)
  1269	    """
  1270	    real = json.loads(_REAL_MANIFEST.read_text(encoding="utf-8"))
  1271	    v, minutes, recorded = picker.load_rank_manifest(_REAL_MANIFEST)
  1272	    baseline = picker.build_rank_manifest(_fake_decay(), v, minutes, recorded)["sha256"]
  1273	
  1274	    moved = picker.build_rank_manifest(_fake_decay(GAMMA=0.5), v, minutes, recorded)["sha256"]
  1275	    assert moved != baseline, "改 decay 系数(不碰文件) 指纹必须变"
  1276	
  1277	    chatty = json.loads(json.dumps(real))
  1278	    chatty["_说明"] = "改一段与生效值无关的说明文字"
  1279	    chatty["recorded"]["_说明"] = "同上"
  1280	    v2, m2, r2 = picker.load_rank_manifest(_write_manifest(tmp_path, chatty))
  1281	    same = picker.build_rank_manifest(_fake_decay(), v2, m2, r2)["sha256"]
  1282	    assert same == baseline, "只改说明文字, 生效值没变, 指纹不该变"
  1283	
