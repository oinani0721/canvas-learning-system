   866	            # 与 why_due 的闲置片段同源同值 (都出自 scan_nodes 的 idle_days),
   867	            # 下游要按闲置排序时不必再从人话串里抠数字。None = 从未考察。
   868	            "idle_days": (None if n["idle_days"] is None else int(n["idle_days"])),
   869	        }
   870	        for n in nodes if n["board"] and n["due_now"]
   900	    # CARD-G3-6a 加性: 顶层 buckets 五桶节点级分组 — 划分的权威表达。
   901	    # 五键恒在 (空 vault 亦为五个空数组, 与 ineligible 同风格, 消费方不做
   902	    # 存在性分支); 桶内按扫描序 (= due_nodes 行序) 稳定。行只带消费方渲染
