   846	            n["bucket"], n["why_due"] = assign_bucket(n, now)
   847	    # v3 (CARD-A2): due_nodes 明细与 stats 数字同源派生 — 自洽靠构造保证,
   848	    # 本投影是全系统到期口径唯一裁判 (Dashboard 只消费不重算)
   849	    due_rows = [
   850	        {
   851	            "node": n["node"],
   852	            "board": n["board"],
   853	            "state": n["state"],
   854	            "pick": round(n["pick"], 4),
   855	            "fsrs_due": n["fsrs_due"],           # 空串 = 新卡即刻到期
   856	            # Codex-A2 M1: 消费方须能区分真新卡与 fail-open 的脏日期卡
   857	            "due_reason": ("malformed" if n["due_fail_open"]
   858	                           else ("scheduled" if n["fsrs_due"] else "new")),
   859	            "last_examined": n["last_examined"],
   860	            "difficulty": n["difficulty"],
   861	            # CARD-G3-6a 加性 (S2 加标签不搬移): 行仍在 due_nodes 内, 只多两
   862	            # 个字段 — 到期三桶之一 + 人话理由。旧字段一个不改。
   863	            "bucket": n["bucket"],
   864	            "why_due": n["why_due"],
