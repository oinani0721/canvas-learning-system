   941	            "upcoming": len(upcoming) > UPCOMING_LIMIT,
   942	        },
   943	    }
   944	    day_id = f"canvas-review-{payload['date']}"
   945	    if ranked:
   946	        payload["notification"] = {
   947	            "title": _title(ranked[0]["board"]),
   948	            "body": _body(ranked[0]),
