  1808	    cfg7 = picker.effective_rank_config(decay, 1, minutes)
  1809	    assert cfg7["tie_pick_round_digits"] == 7
  1810	    import hashlib
  1811	
  1812	    sha8 = hashlib.sha256(
  1813	        json.dumps({**cfg, "tie_pick_round_digits": 8}, sort_keys=True, ensure_ascii=False, allow_nan=False).encode(
  1814	            "utf-8"
  1815	        )
  1816	    ).hexdigest()
  1817	    sha7 = hashlib.sha256(
  1818	        json.dumps(cfg7, sort_keys=True, ensure_ascii=False, allow_nan=False).encode("utf-8")
  1819	    ).hexdigest()
  1820	    assert sha7 != sha8, "精度变了指纹必须变"
