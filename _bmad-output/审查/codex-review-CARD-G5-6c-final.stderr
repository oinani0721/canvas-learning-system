   486	# ───────────────────────────── 时间 ─────────────────────────────
   487	
   488	
   489	def parse_now(raw: str) -> datetime:
   490	    """--now → aware datetime。裸时间按 Asia/Shanghai 解释（显式偏差 5）。"""
   491	    try:
   492	        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
   493	    except ValueError as e:
   494	        raise SystemExit(
   495	            f"✗ --now 不是合法 ISO-8601 时刻: {raw!r}（例: 2026-08-31T00:00:00+08:00）"
   496	        ) from e
   497	    return dt if dt.tzinfo else dt.replace(tzinfo=_TZ_SHANGHAI)
   498	
   499	
   500	def _epoch_s(dt: datetime) -> float:
   501	    return dt.timestamp()
   502	
   503	
   504	def days_between(now_s: float, then_s: float) -> int:
   505	    """整日年龄。⛔ 先把秒差取**最近整秒**再整除 86400 —— 见显式偏差 6。
   506	    用的是 Python `round`（ties-to-even，不是"半数远离零"）；此处只用于吸收
   507	    文件系统纳秒往返的亚微秒抖动，恰好落在 .5 的秒差在真实 mtime 上不会出现。"""
   508	    return int(round(now_s - then_s)) // 86400
   509	
   510	
   511	#: 时刻不可表示时的占位（不是"没有时间"，是"这个 mtime 超出日历可表示范围"）。
   512	UNREPRESENTABLE = "unrepresentable"
   513	
   514	
   515	def _fmt(sec: float, tz, pattern: str) -> str:
   516	    """⛔ 极值 mtime（如被置成 9999 年末，+8h 后溢出到 10000 年）会让
   517	    `datetime.fromtimestamp` 抛 OverflowError —— 一个畸形 mtime 不该炸掉整份 preview。
   518	    与 `scripts/daily_review_pick.py::_sh_local` 同款诚实降级：返回占位串，
   519	    **不**伪造一个看似正常的时间。"""
   520	    try:
   521	        return datetime.fromtimestamp(sec, tz=tz).strftime(pattern)
   522	    except (OverflowError, OSError, ValueError):
   523	        return UNREPRESENTABLE
   524	
   525	
   526	def fmt_utc(sec: float) -> str:
   527	    return _fmt(sec, timezone.utc, "%Y-%m-%dT%H:%M:%SZ")
   528	
   529	
   530	def fmt_local(sec: float) -> str:
   531	    return _fmt(sec, _TZ_SHANGHAI, "%Y-%m-%d %H:%M")
   532	
   533	
   534	# ───────────────────────── 文本解析（确定性） ─────────────────────────
   535	
   536	
   537	def frontmatter_span(lines: list[str]) -> int:
   538	    """frontmatter 块**占用的行数**（含首尾两条分隔线）；无 / 缺闭合时为 0。
   539	
   540	    ⛔ 单独抽出来是因为 `head_window` 需要的是「跳过几行」而不是「里面有几个键」。
   541	    早先版本用 `len(fm) + 2` 反推，遇到**空 frontmatter**（`---` 紧接 `---`）时
   542	    `fm == []` 被当成「没有 frontmatter」，报出的行号就整体偏 2 行 —— 依据里的
   543	    行号是给人核对用的，偏了就等于没有。
   544	    """
   545	    if not lines or lines[0].strip() != "---":
   546	        return 0
   547	    end = None
   548	    for i in range(1, len(lines)):
   549	        if lines[i].strip() in ("---", "..."):
   550	            end = i
   551	            break
   552	    if end is None:
   553	        return 0  # 缺闭合 → 视为无 frontmatter
   554	    # ⛔ 还要**真的像** frontmatter（Codex HIGH 实证）：`---\n这是唯一正文\n---`
   555	    # 原先被整段当 frontmatter 吞掉 → 正文为空 → 输出「建议删」。把用户正文误判成
   556	    # 空文件的删除提名，比不提名坏得多。
   557	    for ln in lines[1:end]:
   558	        t = ln.strip()
   559	        if not t or t.startswith("#"):
   560	            continue  # 空行与 YAML 注释不作数
   561	        return end + 1 if _FM_LOOKS_LIKE_KEY_RE.match(ln) else 0
   562	    return end + 1  # 空 frontmatter（`---` 紧接 `---`）
   563	
   564	
   565	def split_frontmatter(text: str) -> tuple[list[str], list[str]]:
   566	    """→ (frontmatter 行, 其余行)。只认文件头的 `---` 对；缺闭合视为无 frontmatter。"""
   567	    lines = text.splitlines()
   568	    n = frontmatter_span(lines)
   569	    return (lines[1 : n - 1] if n else []), lines[n:]
   570	
   571	
   572	def _clean_fm_value(raw: str) -> str:
   573	    """frontmatter 值清洗：剥行尾 YAML 注释 → 剥成对引号。
   574	
   575	    ⛔ 两步缺一不可，且顺序不能反：`source: "https://x" # 官方来源` 若先判引号，
   576	    会因末字符是「源」而走错分支，值带着引号被 URL 判据拒掉，一手来源丢失
   577	    （round-3 自审 H1-6）。
   578	    """
   579	    val = (raw or "").strip()
   580	    val = re.sub(r"\s+#.*$", "", val).strip()
   581	    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
   582	        val = val[1:-1]
   583	    return val
   584	
   585	
   586	def frontmatter_pairs(fm_lines: list[str]) -> list[tuple[str, str]]:
   587	    """全部 `key: value` 对，**按出现顺序、不折叠重名键**。
   588	
   589	    ⛔ round-2 审查 BLOCKER 的修法：`frontmatter_map` 用 `setdefault` 只留首值，
   590	    于是
   591	
   592	        ---
   593	        doi:
   594	        doi: 10.1000/hidden
   595	        ---
   596	
   597	    折叠后只剩一个**空**值，所有基于 `fm.items()` 的护栏信号全都扫不到那个 DOI，
   598	    文件被判空骨架确定删除（同形 `url:` 反例同时穿透 C3 与 C4 两个出口）。
   599	    护栏必须看**全部**写下来的行 —— 引擎丢弃了的信息，正是「未消化」的定义。
   600	    ⚠️ 判据侧（C1 取 `fm["source"]`）仍走 `frontmatter_map` 的首值语义，不动：
   601	    改判据取值是有后果的行为变更，不能作为一次护栏加宽的副作用。
   602	    """
   603	    out: list[tuple[str, str]] = []
   604	    for ln in fm_lines:
   605	        m = _FM_KEY_RE.match(ln)
   606	        if m:
   607	            out.append((m.group(1), _clean_fm_value(m.group(2) or "")))
   608	    return out
   609	
   610	
   611	def frontmatter_map(fm_lines: list[str]) -> dict:
   612	    """顶层 `key: value` 扫描（不引 YAML 依赖；嵌套/列表值不解析，本卡不需要）。
   613	    ⚠️ 重名键取**首值**（既有语义，判据侧依赖它）；护栏侧要看全量请用
   614	    `frontmatter_pairs`。"""
   615	    out: dict[str, str] = {}
   616	    for k, v in frontmatter_pairs(fm_lines):
   617	        out.setdefault(k, v)
   618	    return out
   619	
   620	

