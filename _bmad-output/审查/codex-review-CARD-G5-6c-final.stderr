  2239	def test_schema_v1_full_key_sets_are_frozen(tmp_path):
  2240	    """⛔ round-2 审查 MEDIUM: `test_schema_version_frozen_at_one` 只锁
  2241	    `schema_version`/`id_namespace`/disclaimer —— 删改大多数 top/item/nested 键
  2242	    仍能保持它绿。schema v1 是**冻结**契约，键集合必须整体上锁。
  2243	
  2244	    期望值取自 round-2 审查报告 §二.3 实测清单（独立来源，不是从本次输出反抄
  2245	    —— 自抄期望值等于让门给自己签字，见 reference_gate_design_pitfalls）。
  2246	    """
  2247	    vault, out = base_vault(tmp_path)
  2248	    inbox = vault / "_待处理"
  2249	    mk(inbox / "a.md", "# A\n\n正文内容一。\n正文内容二。\n", age_days=3)
  2250	    mk(inbox / "b.md", "---\nsource: https://x.test/p\n---\n\n正文。\n正文二。\n", age_days=2)
  2251	    # ⛔ round-3 审查 MEDIUM: 原先建在 `vault/Sleeping`，而生产读的是
  2252	    # `<收件箱>/Sleeping` —— fixture 建错位置 ⇒ sleeping.items 恒空 ⇒ 那一层的
