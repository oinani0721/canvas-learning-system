  1900	def test_nbsp_after_hash_is_not_an_atx_heading(tmp_path):
  1901	    """⛔ round-8 BLOCKER-1: ATX 的**井号后分隔**也只认 ASCII 空格/制表符。
  1902	
  1903	    前置缩进在 round-7 已收窄为字面空格, 但 `#{1,6}` 后仍写着 `(?:\\s|$)` ——
  1904	    Python `re` 的 `\\s` 在 str 模式下是 Unicode 语义, `#\\xa0keep`
  1905	    (字节 23c2a06b6565700a) 被当标题剥掉 → 「标题 1 行、实质正文 0 字符」
  1906	    → `建议删 + confident=true`。同一条规则的两半只修一半, 等于没修。
  1907	    """
  1908	    mod = load_module()
  1909	    # 纯函数半边: CommonMark §4.2 = 空格 / 制表符 / 行尾
  1910	    assert mod._HEADING_RE.match("# x"), "ASCII 空格必须仍是合法分隔"
  1911	    assert mod._HEADING_RE.match("#\tx"), "制表符是 CommonMark 合法分隔, 不得连坐收窄"
  1912	    assert mod._HEADING_RE.match("#"), "行尾 ATX (空标题) 必须仍成立"
  1913	    assert mod._HEADING_RE.match("   ###### x"), "3 空格缩进 + 六级标题仍成立"
  1914	    assert not mod._HEADING_RE.match("#\u00a0x"), "NBSP 不是 ATX 分隔 (round-8 BLOCKER-1)"
  1915	    # ⛔ 验伪锚: 防「按反例特判 NBSP」的窄修 —— 全角/EM 空格是同族 Unicode 空白
  1916	    assert not mod._HEADING_RE.match("#\u2003x"), "EM SPACE 同属 Unicode 空白, 不得只排 NBSP"
  1917	    assert not mod._HEADING_RE.match("#\u3000x"), "IDEOGRAPHIC SPACE 同上"
  1918	    assert not mod._HEADING_RE.match("#x"), "井号后无分隔本就不是标题 (口径不得放宽)"
