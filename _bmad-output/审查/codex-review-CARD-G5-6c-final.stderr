  2403	def test_zero_width_split_marker_still_reads_as_ai_suspect(tmp_path):
  2404	    """⛔ round-2 负控 M-ZEROWIDTH 照出的**不承重层**，本门是它唯一的裁判。
  2405	
  2406	    回退 `_norm_guard_line` 后套件一门都不红 —— 因为 `Generated by<ZWSP>GPT-4`
  2407	    在旧归一下**已经**命中生成骨架（骨架里的非词字符段/非句读字符类都吃零宽），
  2408	    一条修法顺手覆盖了另一条。`_norm_guard_line` 真正承重的只有 `raw_ai_marker`:
  2409	    零宽插在**标记表项中间**时（`Generated by<ZWSP>AI Lab`），不剥零宽就匹配不到
  2410	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
  2411	
  2412	    ⚠\ufe0f 如实声明本门测的是**理由质量**不是安全: 两种情况材料都不会被删，
  2413	    差别只在 uncertain_reason 说的是「疑似 AI 自述」还是「生成断言结构」。
  2414	    留着这一层是因为前者对人更有用 —— 但不写成安全防线，也就不能假装它是。
  2415	    """
  2416	    mod = load_module()
  2417	    zw = "\u200b"
  2418	
  2419	    # 纯函数半边: 零宽切断表项时，只有护栏归一能还原出表项
  2420	    def _raw_hit(line, norm_fn):
  2421	        n = norm_fn(line)
  2422	        return next((o for nm, o in zip(mod._AI_MARKERS_NORM, mod.AI_MARKERS) if nm in n), None)
  2423	
  2424	    line = f"note: Generated by{zw}AI Lab"
  2425	    assert _raw_hit(line, mod._norm_ai_line) is None, "旧归一本就认不出（这是本门的前提）"
  2426	    assert _raw_hit(line, mod._norm_guard_line) == "Generated by AI"
  2427	
  2428	    # ⛔ round-3 审查 BLOCKER: 零宽换空格只对**词间**插入成立；插在**词内部**时
  2429	    # 反而把关键词拆开（`Genera<ZWSP>ted` → `genera ted`），骨架与标记表一起失效
  2430	    # —— 比不处理更糟。故两种还原都要试：换空格还原词间，直接删还原词内。
  2431	    spaced, stripped = mod._guard_variants(f"title: Genera{zw}ted by GPT-4")
  2432	    assert "genera ted" in spaced, "换空格版必然拆词（这是需要第二个变体的理由）"
  2433	    assert mod._GEN_CLAIM_EN_RE.search(spaced) is None, "拆词后骨架认不出（前提）"
  2434	    assert mod._GEN_CLAIM_EN_RE.search(stripped), "直接删版必须还原出 generated by"
  2435	    # 反向：词间插入靠换空格版，直接删会把 by 与 GPT 粘成 bygpt
  2436	    sp2, st2 = mod._guard_variants(f"title: Generated by{zw}GPT-4")
  2437	    assert mod._GEN_CLAIM_EN_RE.search(sp2), "换空格版必须还原词间分隔"
  2438	    assert "bygpt" in st2, "直接删版会粘连（这是需要第一个变体的理由）"
  2439	    # C2 判据不得被这一层带宽：确定归档面必须原地不动
  2440	    assert mod.find_ai_marker(line) is None, "护栏加宽不得顺带扩大 C2 确定提名面"
  2441	
  2442	    vault, out = base_vault(tmp_path)
  2443	    inbox = vault / "_待处理"
  2444	    mk(inbox / "零宽切断表项.md", f"---\nnote: Generated by{zw}AI Lab\n---\n", age_days=6)
  2445	    mk(inbox / "纯空骨架.md", "# \n\n## \n", age_days=5)
  2446	
  2447	    assert run_cli(vault, out).returncode == 0
  2448	    data = load_json(out)
  2449	    assert data["items"], "items 为空则本门恒真 = 假绿"
  2450	    it = item_by_name(data, "零宽切断表项.md")
  2451	    assert it["verdict"] != "建议删", it["basis"]
  2452	    assert it["criterion"] == "C6_undecided"
  2453	    assert it["confident"] is False
  2454	    # ⛔ 信号归属就是本门的全部判别力: 回退护栏归一后这里会变成「生成断言结构」
  2455	    r = it["uncertain_reason"] or ""
  2456	    assert "疑似 AI 生成自述" in r, f"未由 ai_suspect 接住（护栏归一没起作用）: {r}"
  2457	    skeleton = item_by_name(data, "纯空骨架.md")
  2458	    assert skeleton["criterion"] == "C3_empty_or_skeleton"
  2459	    assert skeleton["verdict"] == "建议删"
