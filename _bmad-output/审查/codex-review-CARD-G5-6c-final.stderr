  1068	    for _, ln in head_window(text):
  1069	        for norm in _guard_variants(ln):
  1070	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS):
  1071	                if nm in norm:
  1072	                    return orig
  1073	    return None
