  1042	
  1043	def find_ai_marker(text: str) -> tuple[int, str] | None:
  1044	    """文头窗口内的 AI 标记（归一化匹配：大小写/空白变体不漏，round-5 BLOCKER-1；
  1045	    右边界规则见 `_find_marker_pos`）。同行多命中时取「最靠前、同位置取最长」。
  1046	    ⛔ 返回的 marker 是**原表原文**（供 basis 逐字展示），匹配在归一化形态上做
  1047	    —— 行号准确，文本保真。"""
