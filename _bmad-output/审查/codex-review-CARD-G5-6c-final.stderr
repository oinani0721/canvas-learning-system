  2511	def test_invisible_chars_are_detected_by_category_not_enumeration(tmp_path):
  2512	    """⛔ round-3 审查 BLOCKER: 零宽字符此前是**六个码点的有限表**, U+2063 等
  2513	    9 个同族 (U+200E/200F/061C/034F/FE0F/2062/180E/202E) 全部穿透, C3/C4 双出口都中。
  2514	
  2515	    与模型名那条是同一个教训: **不可见字符不是一张能数完的表**, 判它得按
  2516	    Unicode 类别 (Cf 格式字符 / Mn 非间距标记 / Cc 控制字符) 而不是按名单。
  2517	    """
  2518	    mod = load_module()
  2519	    # 纯函数半边: 逐个类别取样, 覆盖 round-3 审查点名的全部 9 个 + 原表 6 个
  2520	    samples = [
