   456	
   457	def _is_primary_source_url(src: str) -> bool:
   458	    """C1 的机械判据：`scheme ∈ {http, https}` **且 hostname 非空**才算一手来源。
   459	    解析异常一律不算 URL —— 方向安全（不误判一手，材料落后续判据）。"""
   460	    if not _URL_RE.match(src):
   461	        return False
   462	    try:
   463	        parts = urlsplit(src)
   464	    except ValueError:
   465	        return False
   466	    return parts.scheme in ("http", "https") and bool(parts.hostname)
   467	
   468	
   469	_ROUND_RE = re.compile(r"(?:^|[^0-9A-Za-z])R(\d{1,4})_")
