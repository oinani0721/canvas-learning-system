  2522	        "\u200c",
  2523	        "\u200d",
  2524	        "\u2060",
  2525	        "\ufeff",
  2526	        "\u00ad",  # 原表六个
  2527	        "\u2063",
  2528	        "\u200e",
  2529	        "\u200f",
  2530	        "\u061c",
  2531	        "\u034f",  # round-3 新抓
  2532	        "\ufe0f",
  2533	        "\u2062",
  2534	        "\u180e",
  2535	        "\u202e",  # round-3 新抓
  2536	    ]
  2537	    for ch in samples:
  2538	        assert mod._strip_invisible(f"genera{ch}ted", "") == "generated", f"U+{ord(ch):04X} 未被按类别剥掉"
  2539	        assert mod._strip_invisible(f"by{ch}gpt", " ") == "by gpt", f"U+{ord(ch):04X}"
  2540	    # ⛔ 验伪锚: 可见字符不得被剥（否则「剥不可见」会滑成「剥一切」）
  2541	    assert mod._strip_invisible("generated by GPT-4", "") == "generated by GPT-4"
  2542	    assert mod._strip_invisible("由 GPT-4 生成", "") == "由 GPT-4 生成"
  2543	
