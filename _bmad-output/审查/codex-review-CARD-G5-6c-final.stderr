   732	def has_substantive_content(text: str) -> bool:
   733	    """这份材料有没有**实质正文** —— C3「空 / 空骨架」的唯一依据。
   734	
   735	    与 `dup_body` 刻意分家：这里回答「是不是只剩脚手架」，可以激进归一化
   736	    （剥列表符、丢纯结构行）；那里回答「是不是逐字相同」，必须逐字保真。
   737	    合用一个函数正是 Codex BLOCKER 的根因。
   738	    ⛔ 用三态视图：围栏**内容**行（哪怕长得像围栏标记，如 Markdown 围栏语法
   739	    速查里的 ``` 行）都算实质正文；只有状态机标记的分隔行不算
   740	    （round-3 自审 B3-3）。
   741	    """
   742	    for ln, kind in _classify_lines_typed(text)[0]:
   743	        if kind == "code":
   744	            if ln.strip():
   745	                return True  # 围栏内容 = 真实材料（含长得像围栏的行）
   746	            continue
   747	        if kind == "fence":
   748	            continue
   749	        if _HEADING_RE.match(ln):
   750	            # ⛔ 用户裁决（2026-09-02）：**标题里写了字就算实质正文**。
   751	            # 起因是量化取样时发现，`# 微积分基本定理的两种证法` 这种「只写了
   752	            # 标题、正文还没动笔」的日常笔记，在旧口径下是 `建议删 +
   753	            # confident=true` —— 那不是对抗构造，是真实使用场景。
   754	            # 论证与本卡「取消 frontmatter 白名单」逐字同构：标题可能是随手一个
   755	            # 字，也可能是这份材料唯一写下来的东西，引擎分不出，分不出就不该
   756	            # 替用户决定。它顺带关闭了 U+3164/U+2800 那条未闭合的 BLOCKER ——
   757	            # 隐形字符伪装成正常标题时，标题里仍然「有字」。
   758	            # ⚠️ 代价如实：C3 的可确定删除面明显收窄（10 件取样从 10 → 5）。
   759	            # 仍可确定删除的是「一个字都没写」的五种：0 字节 / 纯空行 /
   760	            # 纯分隔线 / 空标题模板（`# ` 后无内容）/ 只有引用符。
   761	            if ln.lstrip(" \t#").strip():
   762	                return True
   763	            continue
   764	        t = _LIST_PREFIX_RE.sub("", ln).strip()
   765	        if t and not _ONLY_STRUCT_RE.match(t):
   766	            return True
   767	    return False
