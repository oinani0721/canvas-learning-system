  2073	def test_long_model_name_and_punctuated_generation_claims_are_undigested(tmp_path):
  2074	    """⛔ round-2 审查 BLOCKER: 生成声明骨架的三条缝隙——
  2075	
  2076	    1. 中文骨架原写 `由[^。；！？\\n]{1,40}?生成`，**长度上界本身就是缝隙**：
  2077	       `本文由 openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01 生成`
  2078	       中间 65 字符，穿透后无正文被判 C3 确定删除；
  2079	    2. 英文骨架原写 `generated by \\S`（字面空格），`Generated by: GPT-4` 的
  2080	       `by` 后是冒号，不匹配；
  2081	    3. `Generated by<U+200B>GPT-4` 的零宽空格**不是** `str.isspace()` 认的空白，
  2082	       `ln.split()` 折叠不掉。护栏改走 `_norm_guard_line`（零宽→空格）。
  2083	    """
  2084	    mod = load_module()
  2085	    # 纯函数半边：上界去掉后，长度这一维不再是缝（但骨架另有边界，见 docstring）
  2086	    long_name = "openai-gpt-oss-120b-finetune-canvas-learning-system-v2026-09-01"
  2087	    assert len(long_name) > 40, "反例必须真的超过原上界，否则本门是死门"
  2088	    assert mod._GEN_CLAIM_CN_RE.search(f"本文由 {long_name} 生成")
  2089	    assert mod._GEN_CLAIM_EN_RE.search("generated by: gpt-4"), "by 后标点必须放行"
  2090	    assert mod._GEN_CLAIM_EN_RE.search("generated by llama-4"), "原空格形态不得连坐"
  2091	    assert not mod._GEN_CLAIM_EN_RE.search("generated byte order mark"), "`byte` 不是 `by` —— 词边界必须挡住"
  2092	    assert not mod._GEN_CLAIM_EN_RE.search("generated by"), "光一句没有主语不算断言"
  2093	    assert mod._norm_guard_line("Generated by\u200bGPT-4") == "generated by gpt-4", (
  2094	        "零宽必须换成空格而非删除，否则 by 与 GPT 粘连、词边界照样认不出"
  2095	    )
  2096	
  2097	    vault, out = base_vault(tmp_path)
  2098	    inbox = vault / "_待处理"
  2099	    mk(inbox / "长模型名.md", f"---\nnote: 本文由 {long_name} 生成\n---\n", age_days=9)
  2100	    mk(inbox / "英文冒号.md", "---\nnote: Generated by: GPT-4\n---\n", age_days=8)

