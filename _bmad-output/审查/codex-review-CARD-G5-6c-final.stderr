   874	
   875	def _norm_guard_line(ln: str) -> str:
   876	    """**护栏专用**归一：先把零宽字符换成空格，再走 `_norm_ai_line`。
   877	
   878	    ⛔ 刻意与 C2 判据用的 `_norm_ai_line` 分家，不是图省事：C2 命中意味着
   879	    「AI 自述 · 确定归档 · confident=true」，是**有后果的提名**，扩大它的命中面
   880	    必须是明写的决定；护栏只降 C6，宽一点的代价仅是少几条「建议删」。
   881	    两者混用等于让一次护栏加宽顺带扩大确定提名面。
   882	
   883	    ⚠️ **承重面如实声明**（round-2 负控 M-ZEROWIDTH 实测，别高估这一层）：
   884	    回退本函数后套件**一门都不红**，因为 `Generated by<ZWSP>GPT-4` 与
   885	    `本文由<ZWSP>X<ZWSP>生成` 在 `_norm_ai_line` 下**已经**命中骨架 ——
   886	    `_GEN_CLAIM_EN_RE` 的非词字符段会吃掉零宽（Cf 类不算词字符），
   887	    `_GEN_CLAIM_CN_RE` 的非句读字符类同样吃它。一条修法顺手覆盖了另一条。
   888	    本函数真正承重的只有 `raw_ai_marker`：零宽插在标记表项**中间**时
   889	    （`Generated by<ZWSP>AI Lab`、`由<ZWSP>AI<ZWSP>生成`），不剥零宽就匹配不到
   890	    表项，ai_suspect 信号哑火，材料改由靠后的 gen_claim 接住。
   891	    ⚠️ 所以它是一层**理由质量**而非安全底线：两种情况下材料都不会被删，
   892	    差别只在 `uncertain_reason` 说的是「疑似 AI 自述」还是「生成断言结构」。
   893	    留着它是因为前者对人更有用；但不要把它写成安全防线。
   894	    """
   895	    return _norm_ai_line(_strip_invisible(ln, " "))
