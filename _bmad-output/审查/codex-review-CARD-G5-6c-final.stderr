   858	def _guard_variants(ln: str) -> tuple[str, str]:
   859	    """护栏归一的**两种**零宽还原，都要试。
   860	
   861	    ⛔ round-3 审查 BLOCKER：上一版只做「零宽→空格」，那只对**词间**插入成立
   862	    （`by<ZWSP>GPT` → `by GPT`）。零宽插在**词内部**时（`genera<ZWSP>ted`），
   863	    换空格反而把关键词拆成 `genera ted`，骨架与标记表一起失效 —— 比不处理更糟。
   864	    两种还原互补，没有哪一种单独够用：
   865	      · 换空格：还原词间分隔（`by<ZWSP>GPT` → `by gpt`）；
   866	      · 直接删：还原词内断裂（`genera<ZWSP>ted` → `generated`）。
   867	    调用方对两个变体分别匹配，任一命中即算 —— 护栏宁可宽。
   868	    """
   869	    return (
   870	        _norm_ai_line(_strip_invisible(ln, " ")),
   871	        _norm_ai_line(_strip_invisible(ln, "")),
   872	    )
