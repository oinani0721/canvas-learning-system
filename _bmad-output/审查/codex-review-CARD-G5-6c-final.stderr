   202	def sha(p: pathlib.Path) -> str:
   203	    return hashlib.sha256(p.read_bytes()).hexdigest()
   204	
   205	
   206	def run_suite() -> tuple[int, set[str], str]:
   207	    r = subprocess.run(
   208	        PYTEST,
   209	        cwd=BACKEND,
   210	        capture_output=True,
   211	        text=True,
   212	        env={
   213	            "PATH": "/usr/bin:/bin",
   214	            "PYTHONDONTWRITEBYTECODE": "1",
   215	            "HOME": str(pathlib.Path.home()),
   216	            "LC_ALL": "C.UTF-8",
   217	        },
   218	    )
   219	    out = r.stdout + r.stderr
   220	    # ⛔ round-3 审查 MEDIUM：只认 `FAILED ` 会漏掉 `ERROR `（collection error /
   221	    # fixture 抛异常都走 ERROR）。变异若把模块改到 import 失败，套件全是 ERROR、
   222	    # 一条 FAILED 都没有，集合比对会判成「少红」还是「相等」全看运气 —— 两种都
   223	    # 不是我们要判的东西。两类一起收，才谈得上「实际失败集合」。
   224	    failed = {
   225	        ln.split("::")[1].split(" ")[0].strip()
   226	        for ln in out.splitlines()
   227	        if (ln.startswith("FAILED ") or ln.startswith("ERROR ")) and "::" in ln
   228	    }
   229	    tail = [
   230	        ln
   231	        for ln in out.splitlines()
   232	        if "passed" in ln or "failed" in ln or "error" in ln
   233	    ]
   234	    return r.returncode, failed, (tail[-1] if tail else "<no summary>")
   235	
   236	
   237	original = SRC.read_bytes()
   238	base_sha = sha(SRC)
   239	print(f"源码基线 sha256 = {base_sha}\n", flush=True)
   240	
   241	
   242	def _restore_on_signal(signum, _frame):
   243	    """⛔ 真事故（2026-09-02）：本脚本被 2 分钟超时 SIGTERM 杀掉时，`finally`
   244	    **没有执行** —— Python 默认信号处理器直接终止进程，不抛异常，源码被留在
   245	    M-PAIRS 变异态。原地改源码的脚本必须显式注册处理器才谈得上「一定还原」。
   246	    （能安全恢复靠的是上面那行基线 sha 已经打印出来 —— 有它，还原才有可验证
   247	    判据；没有它只能凭记忆猜该改回什么。）"""
   248	    SRC.write_bytes(original)
   249	    print(f"\n⛔ 收到信号 {signum}，已还原源码 sha256={sha(SRC)}", flush=True)
   250	    sys.exit(128 + signum)
   251	
   252	
   253	for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
   254	    signal.signal(_sig, _restore_on_signal)
   255	
   256	results: list[tuple[str, bool]] = []
   257	try:
   258	    for name, expected, layers in MUTATIONS:
   259	        text = original.decode("utf-8")
   260	        for old, new in layers:
   261	            n = text.count(old)
   262	            if n != 1:
   263	                raise SystemExit(f"[{name}] 变异锚点出现 {n} 次（须 1）：{old!r}")
   264	            text = text.replace(old, new)
   265	        SRC.write_text(text, encoding="utf-8")
   266	        if sha(SRC) == base_sha:
   267	            raise SystemExit(f"[{name}] 变异没有真的改到字节")
   268	
   269	        rc, failed, summary = run_suite()
   270	        SRC.write_bytes(original)
   271	        restored = sha(SRC)
   272	
   273	        # ⛔ round-3 审查 MEDIUM：`rc not in (0, 5)` 太松 —— rc=2（内部错误/用法
   274	        # 错误）、rc=3（内部异常）、rc=4（用法错误）都会被当成「红了」。真正表示
   275	        # 「跑完了且有测试失败」的只有 rc=1。
   276	        ok = failed == expected and rc == 1 and restored == base_sha
   277	        results.append((name, ok))
   278	        print(f"{'✅' if ok else '❌'} {name}")
   279	        print(f"   期望红: {sorted(expected)}")
   280	        print(f"   实际红: {sorted(failed)}")
   281	        if failed - expected:
   282	            print(f"   ⚠️ 多红（波及面比预期大）: {sorted(failed - expected)}")
   283	        if expected - failed:
   284	            print(f"   ⛔ 少红（该防线没有门在测）: {sorted(expected - failed)}")
   285	        print(
   286	            f"   rc={rc} | {summary} | 还原 sha "
   287	            f"{'一致' if restored == base_sha else '⛔不一致'}\n"
   288	        )
   289	finally:
   290	    SRC.write_bytes(original)
   291	    final = sha(SRC)
   292	    print(
   293	        f"finally 还原后 sha256 = {final} "
   294	        f"({'与基线逐字节相同' if final == base_sha else '⛔ 漂移'})"
   295	    )
   296	
   297	allok = (
   298	    all(ok for _, ok in results)
   299	    and sha(SRC) == base_sha
   300	    and len(results) == len(MUTATIONS)
   301	)
   302	print("\n" + "=" * 70)
   303	print(
   304	    f"G56C_NEGATIVE_CONTROL: {'PASS' if allok else 'FAIL'} "
   305	    f"（{sum(1 for _, ok in results if ok)}/{len(MUTATIONS)} 变异的实际失败集合等于预先声明集合）"
   306	)
   307	sys.exit(0 if allok else 1)

