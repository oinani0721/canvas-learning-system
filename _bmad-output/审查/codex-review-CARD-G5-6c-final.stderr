  1049	        norm = _norm_ai_line(ln)
  1050	        hits = [
  1051	            (pos, -len(nm), orig)
  1052	            for nm, orig in zip(_AI_MARKERS_NORM, AI_MARKERS)
  1053	            if (pos := _find_marker_pos(norm, nm)) >= 0
  1054	        ]
  1055	        if hits:
  1056	            _, _, marker = min(hits)
